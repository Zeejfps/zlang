// The game executable: `kotor/tools/ctxc run kotor -- --module end_m01aa` (docs/design/engine.md).
// The render backend is chosen here, by the directory added: lib/render_gl.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "kotor", root = "game" }
    build::add_sources{ &b, exe, dir = "lib/base" }
    build::add_sources{ &b, exe, dir = "lib/res" }
    build::add_sources{ &b, exe, dir = "lib/formats" }
    build::add_sources{ &b, exe, dir = "lib/tex" }
    build::add_sources{ &b, exe, dir = "lib/mdl" }
    build::add_sources{ &b, exe, dir = "lib/mdl_cache" }
    build::add_sources{ &b, exe, dir = "lib/mdl_render" }
    build::add_sources{ &b, exe, dir = "lib/material" }
    build::add_sources{ &b, exe, dir = "lib/walk" }
    build::add_sources{ &b, exe, dir = "lib/script" }
    build::add_sources{ &b, exe, dir = "lib/audio" }
    build::add_sources{ &b, exe, dir = "lib/video" }
    build::add_sources{ &b, exe, dir = "lib/gui" }
    build::add_sources{ &b, exe, dir = "lib/frontend" }
    build::add_sources{ &b, exe, dir = "lib/chargen" }
    build::add_sources{ &b, exe, dir = "lib/platform" }
    build::add_sources{ &b, exe, dir = "lib/render" }
    build::add_sources{ &b, exe, dir = "lib/render_gl" }
    build::add_sources{ &b, exe, dir = "lib/engine" }
    build::add_sources{ &b, exe, dir = "lib/save" }
    build::add_sources{ &b, exe, dir = "lib/rules" }
    build::add_sources{ &b, exe, dir = "lib/minigame" }
    build::add_sources{ &b, exe, dir = "lib/scene" }
    build::add_sources{ &b, exe, dir = "lib/vfx" }
    build::add_sources{ &b, exe, dir = "lib/dialog/core" }
    build::add_sources{ &b, exe, dir = "lib/dialog/view" }
    build::add_sources{ &b, exe, dir = "lib/dialog/panels" }
    build::add_sources{ &b, exe, dir = "lib/dialog/lipsync" }
    build::add_sources{ &b, exe, dir = "lib/hud" }
    build::add_sources{ &b, exe, dir = "lib/ingame" }
    build::add_sources{ &b, exe, dir = "lib/screens" }
    build::add_sources{ &b, exe, dir = "lib/pazaak" }
    build::add_sources{ &b, exe, dir = "tools/common" }
    // The unchecked operations (ctxlang/spec.md §13: `@cast`, `@slice`, pointer arithmetic, C's
    // declarations) are errors in the game's code, but for these directories: review for
    // memory safety looks here. The first two are the binding layers; the rest are game-side,
    // each for the reason beside it.
    build::deny_unchecked{ &b, exe, except = [
        "lib/platform",     // SDL2's binding: its extern fns, the event union, C's buffers as slices
        "lib/render_gl",    // OpenGL's binding: the loader's casts, the debug callback, vertex and uniform data as bytes
        "lib/base",         // the C heap behind heap::alloc, libm's functions, float bits, and le's reads after one bounds check
        "lib/script",       // the NCS VM: its stack through pointers, and its untagged Cell
        "lib/video",        // the Bink decoder's inner loops, and libm for its audio tables
        "lib/audio",        // the mixer's and the MP3 decoder's inner loops
    ] }
    build::optimize{ &b, exe, level = 2 }
    match build::os{ &b } {
        macos => {
            build::lib_path{ &b, exe, path = "/opt/homebrew/lib" }
            build::link{ &b, exe, lib = "SDL2" }
        }
        windows => { build::link{ &b, exe, lib = "SDL2" } }
        linux => { build::link{ &b, exe, lib = "SDL2" } }
    }
}
