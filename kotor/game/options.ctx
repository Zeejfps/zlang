// The command line (docs/design/engine.md, "Headless and logs"):
//
//   kotor --module end_m01aa [--game DIR] [--headless] [--frames N] [--dt S] [--input FILE]
//         [--screenshot-at FRAME:PATH]... [--screenshot-range FROM:TO:DIR] [--screenshot-loading DIR] [--log scripts,routines,events,actions,objects]
//         [--report routines] [--seed N] [--size WxH] [--no-render] [--speed N] [--mute] [--engine-only] [--load SAVE]
//         [--settings FILE] [--gfx]
//
// A window run takes its size, mode and graphics options from the settings file (docs/mechanics/graphics.md); --size
// overrides the size. A headless run leaves them at the defaults (so logs and pictures repeat) unless --gfx says to
// read the file.
namespace options {
    struct Shot { frame: u64, path: []u8 }

    struct Options {
        module: []u8,
        game: []u8,
        headless: bool,
        no_render: bool,        // the whole game loop, but a frame is drawn only for a screenshot or a save's picture
        engine_only: bool,      // just lib/engine's world loop: no scene, no conversations' view, no input script
        load: []u8,             // start from this save (a folder of ours, a path, or one of the install's) instead of a module or the front end
        mute: bool,             // the mixer skips the music and the effects (no one hears them); voice-overs still play
        speed: u32,             // world ticks per loop iteration (--no-render): the presentation catches up once per N
        frames: u64,            // 0: until quit
        dt: f32,                // fixed step (headless); 0: real time
        input: []u8,            // the scripted input file, "" none
        shots: [16]Shot,
        shot_count: usize,
        range_from: u64,        // --screenshot-range FROM:TO:DIR: every frame from FROM to TO is written to DIR/fNNNNN.png (tests of cuts and flashes)
        range_to: u64,
        range_dir: []u8,
        loading_dir: []u8,      // --screenshot-loading DIR: every loading-screen frame is written to DIR/lNNNN.png (drawn even with --no-render)
        log: []u8,
        saves: []u8,            // our saves directory (never the install's)
        report: bool,
        seed: u32,
        width: u32,
        height: u32,
        size_given: bool,       // --size: the window is that size, whatever the settings file says
        settings: []u8,         // the options file (the graphics options, the sound ...): ours, never the install's
        gfx: bool,              // a hidden run takes the graphics options from the settings file too (a picture of an option)
        run_script: []u8,       // a script to run once the module is entered (tests: --run-script k_act_mispaz)
    }

    fn defaults {} -> Options {
        return Options{
            module = "", game = "F:/Steam/steamapps/common/swkotor", headless = false, no_render = false, engine_only = false, mute = false, speed = 1, load = "",
            frames = 0, dt = 0.0, input = "", shots = [Shot{ frame = 0, path = "" }; 16], shot_count = 0, range_from = 0, range_to = 0, range_dir = "", loading_dir = "",
            log = "", saves = "kotor/out/saves", report = false, seed = 1, width = 1280, height = 720, run_script = "",
            size_given = false, settings = "kotor/out/kotor-settings.ini", gfx = false,
        }
    }

    fn parse { mut io: Io, args: Args } -> ?Options {
        let mut o = defaults{}
        let mut i: usize = 0
        while i < args.len {
            let a = args[i]
            let has = i + 1 < args.len
            if slice::eq_bytes{ a, b = "--module" } and has {
                i = i + 1
                o.module = args[i]
            } else if slice::eq_bytes{ a, b = "--game" } and has {
                i = i + 1
                o.game = args[i]
            } else if slice::eq_bytes{ a, b = "--headless" } {
                o.headless = true
            } else if slice::eq_bytes{ a, b = "--no-render" } {
                o.no_render = true
            } else if slice::eq_bytes{ a, b = "--mute" } {
                o.mute = true
            } else if slice::eq_bytes{ a, b = "--load" } and has {
                i = i + 1
                o.load = args[i]
            } else if slice::eq_bytes{ a, b = "--engine-only" } {
                o.engine_only = true
            } else if slice::eq_bytes{ a, b = "--speed" } and has {
                i = i + 1
                let n = @trunc(u32, text::scan_decimal{ s = args[i] })
                o.speed = if n > 1 { n } else { 1 }
            } else if slice::eq_bytes{ a, b = "--frames" } and has {
                i = i + 1
                o.frames = @as(u64, text::scan_decimal{ s = args[i] })
            } else if slice::eq_bytes{ a, b = "--dt" } and has {
                i = i + 1
                o.dt = text::scan_f32{ s = args[i] } ifnull { return usage{ &io } }
            } else if slice::eq_bytes{ a, b = "--input" } and has {
                i = i + 1
                o.input = args[i]
            } else if slice::eq_bytes{ a, b = "--screenshot-at" } and has {
                i = i + 1
                let colon = text::find_byte{ s = args[i], c = ':' } ifnull { return usage{ &io } }
                if o.shot_count < 16 {
                    o.shots[o.shot_count] = Shot{ frame = @as(u64, text::scan_decimal{ s = args[i][..colon] }), path = args[i][colon + 1..] }
                    o.shot_count = o.shot_count + 1
                }
            } else if slice::eq_bytes{ a, b = "--screenshot-range" } and has {
                i = i + 1
                let c1 = text::find_byte{ s = args[i], c = ':' } ifnull { return usage{ &io } }
                let rest = args[i][c1 + 1..]
                let c2 = text::find_byte{ s = rest, c = ':' } ifnull { return usage{ &io } }
                o.range_from = @as(u64, text::scan_decimal{ s = args[i][..c1] })
                o.range_to = @as(u64, text::scan_decimal{ s = rest[..c2] })
                o.range_dir = rest[c2 + 1..]
            } else if slice::eq_bytes{ a, b = "--screenshot-loading" } and has {
                i = i + 1
                o.loading_dir = args[i]
            } else if slice::eq_bytes{ a, b = "--saves" } and has {
                i = i + 1
                o.saves = args[i]
            } else if slice::eq_bytes{ a, b = "--log" } and has {
                i = i + 1
                o.log = args[i]
            } else if slice::eq_bytes{ a, b = "--report" } and has {
                i = i + 1
                o.report = true
            } else if slice::eq_bytes{ a, b = "--run-script" } and has {
                i = i + 1
                o.run_script = args[i]
            } else if slice::eq_bytes{ a, b = "--seed" } and has {
                i = i + 1
                o.seed = @trunc(u32, text::scan_decimal{ s = args[i] })
            } else if slice::eq_bytes{ a, b = "--size" } and has {
                i = i + 1
                let x = text::find_byte{ s = args[i], c = 'x' } ifnull { return usage{ &io } }
                o.width = @trunc(u32, text::scan_decimal{ s = args[i][..x] })
                o.height = @trunc(u32, text::scan_decimal{ s = args[i][x + 1..] })
                o.size_given = true
            } else if slice::eq_bytes{ a, b = "--settings" } and has {
                i = i + 1
                o.settings = args[i]
            } else if slice::eq_bytes{ a, b = "--gfx" } {
                o.gfx = true
            } else {
                return usage{ &io }
            }
            i = i + 1
        }
        // Nothing is drawn, so nothing needs a visible window or the display's pace.
        if o.no_render or o.engine_only { o.headless = true }
        if o.headless and o.dt <= 0.0 { o.dt = 1.0 / 30.0 }
        return o
    }

    fn usage { mut io: Io } -> ?Options {
        io::eprintln{ &io, s = "usage: kotor [--module M] [--game DIR] [--headless] [--no-render] [--speed N] [--mute] [--engine-only] [--load SAVE] [--frames N] [--dt S] [--input FILE] [--screenshot-at FRAME:PATH]... [--screenshot-range FROM:TO:DIR] [--screenshot-loading DIR] [--log LIST] [--report routines] [--seed N] [--size WxH] [--settings FILE] [--gfx] [--run-script NAME]" }
        return null
    }
}
