// The command line (docs/design/engine.md, "Headless and logs"):
//
//   kotor --module end_m01aa [--game DIR] [--headless] [--frames N] [--dt S] [--input FILE]
//         [--screenshot-at FRAME:PATH]... [--log scripts,routines,events,actions,objects]
//         [--report routines] [--seed N] [--size WxH] [--no-render]
namespace options {
    struct Shot { frame: u64, path: []u8 }

    struct Options {
        module: []u8,
        game: []u8,
        headless: bool,
        no_render: bool,
        frames: u64,            // 0: until quit
        dt: f32,                // fixed step (headless); 0: real time
        input: []u8,            // the scripted input file, "" none
        shots: [16]Shot,
        shot_count: usize,
        log: []u8,
        report: bool,
        seed: u32,
        width: u32,
        height: u32,
    }

    fn defaults {} -> Options {
        return Options{
            module = "end_m01aa", game = "F:/Steam/steamapps/common/swkotor", headless = false, no_render = false,
            frames = 0, dt = 0.0, input = "", shots = [Shot{ frame = 0, path = "" }; 16], shot_count = 0,
            log = "", report = false, seed = 1, width = 1280, height = 720,
        }
    }

    fn parse { mut io: Io, args: Args } -> ?Options {
        let mut o = defaults{}
        let mut i: usize = 0
        while i < args.len {
            let a = args[i]
            let has = i + 1 < args.len
            if slice::eq_bytes{ a, b = "--module" } and has {
                i = i + 1
                o.module = args[i]
            } else if slice::eq_bytes{ a, b = "--game" } and has {
                i = i + 1
                o.game = args[i]
            } else if slice::eq_bytes{ a, b = "--headless" } {
                o.headless = true
            } else if slice::eq_bytes{ a, b = "--no-render" } {
                o.no_render = true
            } else if slice::eq_bytes{ a, b = "--frames" } and has {
                i = i + 1
                o.frames = @as(u64, text::scan_decimal{ s = args[i] })
            } else if slice::eq_bytes{ a, b = "--dt" } and has {
                i = i + 1
                o.dt = text::scan_f32{ s = args[i] } ifnull { return usage{ &io } }
            } else if slice::eq_bytes{ a, b = "--input" } and has {
                i = i + 1
                o.input = args[i]
            } else if slice::eq_bytes{ a, b = "--screenshot-at" } and has {
                i = i + 1
                let colon = text::find_byte{ s = args[i], c = ':' } ifnull { return usage{ &io } }
                if o.shot_count < 16 {
                    o.shots[o.shot_count] = Shot{ frame = @as(u64, text::scan_decimal{ s = args[i][..colon] }), path = args[i][colon + 1..] }
                    o.shot_count = o.shot_count + 1
                }
            } else if slice::eq_bytes{ a, b = "--log" } and has {
                i = i + 1
                o.log = args[i]
            } else if slice::eq_bytes{ a, b = "--report" } and has {
                i = i + 1
                o.report = true
            } else if slice::eq_bytes{ a, b = "--seed" } and has {
                i = i + 1
                o.seed = @trunc(u32, text::scan_decimal{ s = args[i] })
            } else if slice::eq_bytes{ a, b = "--size" } and has {
                i = i + 1
                let x = text::find_byte{ s = args[i], c = 'x' } ifnull { return usage{ &io } }
                o.width = @trunc(u32, text::scan_decimal{ s = args[i][..x] })
                o.height = @trunc(u32, text::scan_decimal{ s = args[i][x + 1..] })
            } else {
                return usage{ &io }
            }
            i = i + 1
        }
        if o.headless and o.dt <= 0.0 { o.dt = 1.0 / 30.0 }
        return o
    }

    fn usage { mut io: Io } -> ?Options {
        io::eprintln{ &io, s = "usage: kotor [--module M] [--game DIR] [--headless] [--no-render] [--frames N] [--dt S] [--input FILE] [--screenshot-at FRAME:PATH]... [--log LIST] [--report routines] [--seed N] [--size WxH]" }
        return null
    }
}
