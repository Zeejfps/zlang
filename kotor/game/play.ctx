// The loop with a window (docs/design/engine.md, "The frame"): input, the world, the scene, the
// camera, the frame drawn; live, or headless with a fixed step, scripted input and screenshots.
namespace play {
    // One scripted input line, `FRAME WORD ARGS...`: the word and the rest of the line as text. Each
    // owner parses its own words' arguments (handle_scripted below, and one per owner file); nothing
    // central lists the words. `FRAME down KEY`, `FRAME up KEY` and for tests `FRAME warp TAG` (the
    // leader jumps next to the object), `FRAME use TAG` (the leader's default action on it) are play's.
    struct Scripted { frame: u64, word: []u8, rest: []u8 }

    fn run { mut sdl: sdl::Sdl, mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, mut mem: Mem, opts: options::Options } -> !i32 {
        try sdl::init{ &sdl, flags = sdl::INIT_VIDEO | sdl::INIT_EVENTS }
        defer sdl::quit{ &sdl }
        let scene_pages = mem::pages{ &mem, size = 805306368 } ifnull { return 1 }
        let mut scene_arena = arena::new{ buf = scene_pages }
        let device_pages = mem::pages{ &mem, size = 134217728 } ifnull { return 1 }
        let mut device_arena = arena::new{ buf = device_pages }
        let texture_scratch = mem::pages{ &mem, size = 100663296 } ifnull { return 1 }
        // The graphics options: a window run reads the options file (the size from --size if it is given); an offscreen run
        // keeps the defaults, so its logs and pictures repeat, unless --gfx asks for the file (a picture of an option).
        let mut live = frontend::load_settings{ fs = &w.fs, heap = w.heap, path = opts.settings }
        if opts.headless and not opts.gfx { display::use_default_graphics{ s = &live } }
        if opts.headless or opts.size_given {
            live.width = @as(i32, opts.width)
            live.height = @as(i32, opts.height)
            if opts.size_given and not opts.headless { live.window_mode = 0 }
            if opts.headless { live.window_mode = 0 }
        }
        let mut config = render::make_config{ title = "kotor", width = live.width, height = live.height, hidden = opts.headless }
        config.vsync = live.vsync
        let mut dev = try gpu::open(arena::Arena){ &sdl, realloc = arena::alloc, heap = &device_arena, config }
        defer gpu::close{ &dev, &sdl }
        let mut disp = display::make{ hidden = opts.headless, path = opts.settings }
        let first_change = display::apply{ d = &disp, &dev, &sdl, s = &live }
        disp.live = live
        if (first_change & display::CHANGED_TEXTURES) != 0 { mount_packs{ &w, quality = live.texture_quality } }
        if not opts.headless { display::report{ d = &disp, io = &w.io } }
        let mut frame = try render::make_frame(arena::Arena){ realloc = arena::alloc, heap = &device_arena, cap = render::default_capacity{} }
        // Sound: a device when there is a window; headless, the mixer runs on without one (as the
        // original does with no sound device, audio.md), so sounds still start and end.
        let mut adev: ?*mut audio::Device = null
        if not opts.headless {
            let opened = audio::open{ &sdl, rate = 44100, latency_ms = 60 } iferr err{ error } {
                _ = @fmt(&w.io, "kotor: no sound: {}\n", error)
                null
            }
            if opened != null { adev = try alloc::new(audio::Device, heap::Heap){ realloc = heap::alloc, heap = w.heap, value = opened } }
        }
        let rate: u32 = match adev { some{ value } => { value.rate } null => { 44100 } }
        let mixer = try mix::make(heap::Heap){ realloc = heap::alloc, heap = w.heap, rate, voices_2d = 24, voices_3d = 16 }
        speed::mute_unheard{ mixer, opts }
        // The loading screen (game/loading.ctx): up over every way into an area, behind which the area is assembled.
        let ld = try loading::make{ &w, &dev, scratch = texture_scratch, opts, scale = disp.live.gui_scale }
        let script = try read_script{ &w, path = opts.input }
        let mut next_line: usize = 0
        let mut frame_no: u64 = 0
        // --load SAVE: the game starts from that save, as the front end's Load Game would.
        if w.module == obj::INVALID and opts.load.len > 0 {
            let folder = save::find_save{ &w, game = opts.game, name = opts.load } ifnull {
                _ = @fmt(&w.io, "kotor: no save {}\n", opts.load)
                return 1
            }
            show_for_save{ ld, &w, &dev, &sdl, &frame, opts, folder }
            try save::load_game{ &w, &vm, engine, folder }
            loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 40 }
            arena::reset{ heap = w.scratch }
        }
        // No module named: the front end (movies, main menu) until New Game.
        if w.module == obj::INVALID {
            let chosen = try front_end{ &sdl, &w, &dev, &frame, mixer, adev, scratch = texture_scratch, opts, script, &next_line, &frame_no, &disp }
            ld.scale = disp.applied.gui_scale
            if chosen.len == 0 { return 0 }
            if chosen.len > 5 and slice::eq_bytes{ a = chosen[..5], b = "load:" } {
                show_for_save{ ld, &w, &dev, &sdl, &frame, opts, folder = chosen[5..] }
                try save::load_game{ &w, &vm, engine, folder = chosen[5..] }
            } else {
                // After Play in character creation, or New Game: the story hints and the module's picture.
                loading::show{ l = ld, &w, &dev, name = chosen, story = true }
                loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 3 }
                save::clear_store{ st = &w.gip }
                try modload::enter{ &w, name = chosen }
            }
            loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 40 }
            arena::reset{ heap = w.scratch }
        }
        // A module entered before the window (--module): the screen goes up over the rest of the start.
        if not loading::is_up{ l = ld } {
            let mo = world::object{ w = &w, id = w.module }
            if mo != null {
                if obj::module{ o = mo } is some{ value = m } {
                    let mut mname = m.name
                    loading::show{ l = ld, &w, &dev, name = resref::bytes{ r = &mname }, story = false }
                    loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 40 }
                }
            }
        }
        let mut sc = scene::make{ arena = &scene_arena, heap = w.heap, scratch = texture_scratch, rm = w.rm.* }
        let mut vx = vfx::make{}
        try scene::load_area{ &sc, &w, &dev }
        loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 75 }
        let mut camera = cam::new{}
        let mut test_camera: []u8 = ""       // `FRAME cam ...`: a camera for pictures (see place_test_camera)
        let mut camera_row: u32 = 0xFFFFFFFF    // the camerastyle.2da row the camera uses
        let mut control = ctl::new{}
        let ao = world::object{ w = &w, id = w.area }
        if ao != null {
            if obj::area{ o = ao } is some{ value = a } {
                cam::set_style{ c = &camera, t = w.tables.camerastyle, row = a.camera_style }
                ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = a.camera_style }
            }
        }
        let mut amb = ambience::make{ heap = w.heap, m = mixer }
        let mut dview = dlgview::make{ heap = w.heap, m = mixer }
        dlgview::attach{ v = &dview, w = &w }
        ambience::start_area{ a = &amb, &w }
        // HOOK(minigames): a minigame area has a run, its own stage and its own frames (game/minigame*.ctx).
        let mut mg_models = mdl_cache::new{ rm = w.rm.*, keep = w.mod_arena }
        _ = try mg_game::enter{ &w, models = &mg_models }
        let mut mg_stage = mg_game::make_stage{}
        let mut mg_mouse = mg_game::make_mouse{}
        // HOOK(ingame): the HUD and the in-game menus (docs/design/hud.md).
        let screen_now = gpu::screen_size{ dev }
        let ui = try ingame::make{ &w, &dev, mixer, scratch = texture_scratch, width = @as(i32, screen_now.width), height = @as(i32, screen_now.height), settings = opts.settings, gui_scale = disp.live.gui_scale }
        if ingame::options_front{ ui } is some{ value = fe } {
            fe.settings = disp.live
            display::tell{ d = &disp, fe }
        }
        if not opts.headless { _ = sdl::SDL_ShowCursor{ &sdl, toggle = 0 } }    // HOOK(ingame): the GUI draws the pointer
        ui.autopause = not opts.headless    // HOOK(ingame): a person is playing: the auto-pause options apply
        loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 90 }
        let silent = try alloc::resize(i16, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = slice::empty(i16){}, count = 44100 }
        let mut keys = ctl::no_keys{}
        let mut inputs = inject::new_inputs{}      // the scripted pointer and held modifiers
        let mut mouse_was_looking = false         // the mouse was turning the camera last frame (relative mode is on)
        let freq = sdl::counter_frequency{ &sdl }
        let mut last = sdl::counter{ &sdl }
        let mut quit = false
        let mut wipe = death::make{}            // the party wipe's slow motion, camera, box and fade (game/death.ctx)
        let mut want_save: []u8 = ""            // a save asked for this frame: its folder name
        let mut sw_module: [24]u8 = [0; 24]     // `savewhen MODULE NAME`: the save waits for the story to be in MODULE and quiet for 2 s
        let mut sw_name: [24]u8 = [0; 24]
        let mut sw_quest: [24]u8 = [0; 24]      // ... and the journal quest in it has reached this entry
        let mut sw_quest_len: usize = 0
        let mut sw_entry: i32 = 0
        let mut sw_module_len: usize = 0
        let mut sw_name_len: usize = 0
        let mut sw_quiet: u32 = 0
        let mut sw_on = false
        let mut want_load: []u8 = ""            // a load asked for: a folder (ours, then the install's)
        let mut real_total: f64 = 0.0
        let mut real_worst: f32 = 0.0
        let mut timed: u64 = 0
        let mut tenth_total: [10]f64 = [0.0; 10]       // the passes' wall time by tenth of a run of known length (--frames)
        let mut tenth_count: [10]u64 = [0; 10]
        let mut owed = speed::Owed{ dt = 0.0, clock_dt = 0.0 }    // --speed: the presentation's time to catch up
        let mut speed_blur: f32 = 0.0              // the Frame Buffer Effects option's speed blur while the leader is hasted, eased in and out
        let mut fxh = fxhud::make{}                 // the GPU Timing option's lines over the picture
        while not quit {
            frame_no = frame_no + 1
            if opts.frames > 0 and frame_no > opts.frames { break }
            keys.action = false
            ingame::begin_frame{ ui }    // HOOK(ingame)
            // 1. Input: the window's events, then the script's lines for this frame. A scripted key or click
            // is put on SDL's queue (game/inject.ctx) and read back at once, so it takes the path a real one does.
            if ld.quit { quit = true }
            pump_events{ &sdl, &w, &dev, ui, &dview, &mg_mouse, &keys, &quit, &want_save, &want_load, loading_up = loading::is_up{ l = ld }, &disp }
            while next_line < script.len and script[next_line].frame <= frame_no {
                let s = script[next_line]
                next_line = next_line + 1
                if inject::handle_scripted{ &sdl, inp = &inputs, word = s.word, rest = s.rest } {
                    pump_events{ &sdl, &w, &dev, ui, &dview, &mg_mouse, &keys, &quit, &want_save, &want_load, loading_up = loading::is_up{ l = ld }, &disp }
                    continue
                }
                if ci::eq{ a = s.word, b = "savewhen" } {
                    // `savewhen MODULE NAME [QUEST ENTRY]`: a save of the game, called NAME, once the story is in MODULE (and the
                    // journal's QUEST has reached ENTRY) with no conversation, no transition and no loading for 2 s: a checkpoint at an arrival that does not depend on how long the fights
                    // before it took (frames of a `save` line move whenever the dice or the timing do).
                    let mut sww = text::words{ s = s.rest }
                    let m = text::next_word{ words = &sww } ifnull ""
                    let n = text::next_word{ words = &sww } ifnull ""
                    sw_module_len = if m.len > 24 { 24 } else { m.len }
                    sw_name_len = if n.len > 24 { 24 } else { n.len }
                    slice::copy(u8){ dst = sw_module[..sw_module_len], src = m[..sw_module_len] }
                    slice::copy(u8){ dst = sw_name[..sw_name_len], src = n[..sw_name_len] }
                    let q = text::next_word{ words = &sww } ifnull ""
                    sw_quest_len = if q.len > 24 { 24 } else { q.len }
                    slice::copy(u8){ dst = sw_quest[..sw_quest_len], src = q[..sw_quest_len] }
                    sw_entry = @as(i32, text::scan_decimal{ s = text::next_word{ words = &sww } ifnull "0" })
                    sw_on = true
                    sw_quiet = 0
                    continue
                }
                if ci::eq{ a = s.word, b = "hoveron" } {
                    // `hoveron TAG [N]`: the pointer moves to a point of the object that the HUD's pick gives to it
                    // (ingame::click_point); a `mouse click` a frame or two later is then a click on the object.
                    let mut hw = text::words{ s = s.rest }
                    let tag = text::next_word{ words = &hw } ifnull ""
                    let nth = @as(i32, text::scan_decimal{ s = text::next_word{ words = &hw } ifnull "0" })
                    if ingame::click_point{ ui = ui.*, &w, tag, nth } is some{ value = at } {
                        inject::push_move{ &sdl, inp = &inputs, x = at[0], y = at[1] }
                    } else {
                        _ = @fmt(&w.io, "kotor: input script: hoveron {}: nothing of it can be picked on the screen\n", tag)
                    }
                    pump_events{ &sdl, &w, &dev, ui, &dview, &mg_mouse, &keys, &quit, &want_save, &want_load, loading_up = loading::is_up{ l = ld }, &disp }
                    continue
                }
                // One call per owner, in turn: the first that knows the word takes the line. A new owner adds
                // its call here (docs/testing.md, "Adding a scripted command").
                let handled = handle_scripted{ &w, &vm, engine, &keys, &want_save, &want_load, word = s.word, rest = s.rest } or
                    mg_game::handle_scripted{ m = &mg_mouse, word = s.word, rest = s.rest } or
                    handle_scripted_vfx{ &w, &test_camera, word = s.word, rest = s.rest } or
                    display::handle_scripted{ d = &disp, word = s.word, rest = s.rest } or
                    dlgview::handle_scripted{ v = &dview, w = &w, g = &ui.gui, word = s.word, rest = s.rest } or
                    ingame::handle_scripted{ ui, &w, &dev, word = s.word, rest = s.rest }    // HOOK(ingame)
                if not handled {
                    _ = @fmt(&w.io, "kotor: input script: no command '{}' in the line '{} {} {}'\n", s.word, s.frame, s.word, s.rest)
                    return 1
                }
            }
            // 1b. Graphics options changed by a scripted `gfx` word or in the options menu are made real before this frame is drawn.
            let mut reload_scene = false
            if disp.pending {
                disp.pending = false
                let mut s = disp.live
                let changed = display::apply{ d = &disp, &dev, &sdl, s = &s }
                disp.live = s
                options_changed{ &w, &dev, ui, &dview, &disp, ld, changed }
                reload_scene = reload_scene or (changed & display::CHANGED_TEXTURES) != 0
                if (changed & display::CHANGED_SIZE) != 0 and not opts.headless { display::report{ d = &disp, io = &w.io } }
            }
            if ingame::take_display_change{ ui } is some{ value = st } {
                let changed = display::apply{ d = &disp, &dev, &sdl, s = st }
                disp.live = st.*
                options_changed{ &w, &dev, ui, &dview, &disp, ld, changed }
                reload_scene = reload_scene or (changed & display::CHANGED_TEXTURES) != 0
            }
            sc.grass.on = disp.applied.grass     // the Grass option, every frame (a new area's scene starts with it on)
            sc.room_light = not disp.applied.fx_original and disp.applied.fx_room_light > 0     // the Room Light option, likewise
            // Another texture pack: the area's textures are loaded again from it, as a load does (the world stays).
            if reload_scene and w.transition == null {
                dlgview::leave{ v = &dview, w = &w, sc = &sc, g = &ui.gui }
                ambience::stop_area{ a = &amb }
                scene::release{ &sc, &dev }
                arena::reset{ heap = &scene_arena }
                vfx::reset{ v = &vx }
                sc = scene::make{ arena = &scene_arena, heap = w.heap, scratch = texture_scratch, rm = w.rm.* }
                try scene::load_area{ &sc, &w, &dev }
                ambience::start_area{ a = &amb, &w }
            }
            // The step: fixed when headless, measured otherwise.
            let now = sdl::counter{ &sdl }
            let real = @as(f32, @as(f64, now - last) / @as(f64, freq))
            last = now
            if timed > 0 {
                real_total = real_total + @as(f64, real)
                if real > real_worst { real_worst = real }
                if opts.frames > 0 and frame_no <= opts.frames {
                    // `real` is the previous pass's time: pass number frame_no - 1 of `frames`, counted from 0 as frame_no - 2.
                    let tenth = @as(usize, (frame_no - 2) * 10 / opts.frames)
                    tenth_total[tenth] = tenth_total[tenth] + @as(f64, real)
                    tenth_count[tenth] = tenth_count[tenth] + 1
                }
            }
            timed = timed + 1
            let mut dt = if opts.dt > 0.0 { opts.dt } else { math::min{ a = real, b = 0.25 } }
            // A load replaces the world's game, then the presentation starts over (as a transition).
            if want_load.len > 0 {
                let folder = save::find_save{ &w, game = opts.game, name = want_load }
                want_load = ""
                if folder == null {
                    _ = @fmt(&w.io, "kotor: no such save\n")
                } else {
                    show_for_save{ ld, &w, &dev, &sdl, &frame, opts, folder }
                    // As a transition: no conversation survives the world it ran in.
                    dlg::abort{ &w, &vm, engine }
                    dlgview::leave{ v = &dview, w = &w, sc = &sc, g = &ui.gui }
                    ambience::stop_area{ a = &amb }
                    scene::release{ &sc, &dev }
                    arena::reset{ heap = &scene_arena }
                    vfx::reset{ v = &vx }
                    death::abort{ d = &wipe, ui, &w }
                    clock::set_pause{ c = &w.clock, bit = clock::PAUSE_ENGINE, on = false }
                    save::load_game{ &w, &vm, engine, folder } iferr err{ error } {
                        _ = @fmt(&w.io, "kotor: load failed: {}\n", error)
                        return 1
                    }
                    loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 40 }
                    sc = scene::make{ arena = &scene_arena, heap = w.heap, scratch = texture_scratch, rm = w.rm.* }
                    try scene::load_area{ &sc, &w, &dev }
                    loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 80 }
                    last = sdl::counter{ &sdl }
                    camera = cam::new{}
                    let loaded_area = world::object{ w = &w, id = w.area }
                    if loaded_area != null {
                        if obj::area{ o = loaded_area } is some{ value = a } {
                            cam::set_style{ c = &camera, t = w.tables.camerastyle, row = a.camera_style }
                            ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = a.camera_style }
                        }
                    }
                    ambience::start_area{ a = &amb, &w }
                    // The new area fades in after 0.5 s over 1 s, unless its OnEnter script fades itself (gameloop.md 5.5 step 1).
                    outbox::post{ out = &w.out, note = outbox::Note::fade{ out = false, wait = 0.5, length = 1.0, color = math::vec3::zero{} } }
                }
            }
            // Headless the step is fixed, so the play time and the autosave timer follow the world's clock, not the wall's.
            let lived = if opts.dt > 0.0 { dt } else { real }
            w.played_seconds = w.played_seconds + @as(f64, lived)
            w.autosave_ms = w.autosave_ms + @as(f64, lived) * 1000.0
            // No saving between the party's fall and the main menu.
            if wipe.active { want_save = "" }
            // An autosave wanted by a transition or a script, once the area is in place.
            if w.autosave_due and w.transition == null and w.arrival == 0 and want_save.len == 0 and not wipe.active and not loading::is_up{ l = ld } {
                w.autosave_due = false
                want_save = "AUTOSAVE"
            }
            if sw_on {
                let mut here = false
                if world::object{ w = &w, id = w.module } is some{ value = mo } {
                    if obj::module{ o = mo } is some{ value = mm } {
                        let mut nm = mm.name
                        here = ci::eq{ a = resref::bytes{ r = &nm }, b = sw_module[..sw_module_len] }
                    }
                }
                if sw_quest_len > 0 and journal::state_of{ j = w.journal, tag = sw_quest[..sw_quest_len] } < sw_entry { here = false }
                if here and w.transition == null and w.arrival == 0 and not w.conversation.active and not w.conversation.pending and not loading::is_up{ l = ld } { sw_quiet = sw_quiet + 1 } else { sw_quiet = 0 }
                if sw_quiet >= 60 and want_save.len == 0 {
                    want_save = sw_name[..sw_name_len]
                    sw_on = false
                }
            }
            // HOOK(minigames): in a minigame area the frame is the minigame's, until a module change is pending.
            if mg_game::active{ w = &w } {
                // No saving in a minigame (modulesave.2da keeps none of them).
                want_save = ""
                w.autosave_due = false
                if mg_stage.ended { quit = true }
                let leaving = try mg_game::frame{ &sdl, &w, &vm, engine, &dev, &frame, &sc, stage = &mg_stage, &amb, mixer, adev, silent, rate, opts, keys, mouse = &mg_mouse, dt, frame_no, shot_heap = &scene_arena, dview = &dview, g = &ui.gui }
                if not leaving { continue }
            }
            // 3-6. The world. The party wipe's slow motion sets the game speed first (gameloop.md 6.6).
            death::step_slow{ d = &wipe, &w, dt }
            clock::advance{ c = &w.clock, seconds = dt }
            // The player doesn't walk while a conversation runs (re/dialogue.md 4.9).
            if w.conversation.active { keys = ctl::no_keys{} }
            ctl::update{ ctl = &control, &w, keys, yaw = camera.yaw, dt = w.clock.dt }
            world::tick{ &w, &vm, engine }
            fight::trace{ &w }
            // The whole party fallen: slow motion, the death camera, the "Your entire party has been killed." box and a
            // fade to black; answering the box or the end of the fade is the way to the main menu (game/death.ctx).
            if not wipe.active and w.arrival == 0 and w.transition == null and fight::party_fallen{ w = &w } {
                death::start{ d = &wipe, ui, &w, &dev }
            }
            // 7. The conversation's pump: the next line, the replies, the end.
            dlg::update{ &w, &vm, engine }
            // 6. A transition: the next module, and a new scene and sound for it.
            if w.transition != null {
                // The loading screen goes up over the change (gameloop.md 5.3: the client picks it, closes its panels and stops its sounds first).
                let mut target = resref::empty{}
                if w.transition is some{ value = t } { target = t.module }
                loading::show{ l = ld, &w, &dev, name = resref::bytes{ r = &target }, story = false }
                loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 3 }
                // A conversation doesn't cross a module change (its objects go).
                dlg::abort{ &w, &vm, engine }
                dlgview::leave{ v = &dview, w = &w, sc = &sc, g = &ui.gui }
                ambience::stop_area{ a = &amb }
                scene::release{ &sc, &dev }
                arena::reset{ heap = &scene_arena }
                vfx::reset{ v = &vx }
                let moved = modload::take_transition{ &w, &vm, engine } iferr err{ error } {
                    _ = @fmt(&w.io, "kotor: transition failed: {}\n", error)
                    return 1
                }
                if moved {
                    loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 40 }
                    sc = scene::make{ arena = &scene_arena, heap = w.heap, scratch = texture_scratch, rm = w.rm.* }
                    try scene::load_area{ &sc, &w, &dev }
                    loading::step{ l = ld, &w, &dev, &sdl, &frame, opts, percent = 80 }
                    last = sdl::counter{ &sdl }
                    camera = cam::new{}
                    let next_area = world::object{ w = &w, id = w.area }
                    if next_area != null {
                        if obj::area{ o = next_area } is some{ value = a } {
                            cam::set_style{ c = &camera, t = w.tables.camerastyle, row = a.camera_style }
                            ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = a.camera_style }
                        }
                    }
                    ambience::start_area{ a = &amb, &w }
                    // The new area fades in after 0.5 s over 1 s, unless its OnEnter script fades itself (gameloop.md 5.5 step 1).
                    outbox::post{ out = &w.out, note = outbox::Note::fade{ out = false, wait = 0.5, length = 1.0, color = math::vec3::zero{} } }
                    mg_stage = mg_game::make_stage{}
                    _ = try mg_game::enter{ &w, models = &mg_models }
                }
            }
            // 8. The outbox: sounds to the ambience (HOOK(gui): fades, movies, text).
            let notes = outbox::notes{ out = &w.out }
            let mut n: usize = 0
            let mut pazaak_asked: ?pz_game::Request = null    // HOOK(minigames)
            while n < notes.len {
                ambience::take{ a = &amb, &w, note = notes[n] }
                ingame::take{ ui, &w, note = notes[n] }    // HOOK(ingame)
                dlgview::take_note{ v = &dview, w = &w, g = &ui.gui, dev = &dev, note = notes[n] }
                vfx::take{ v = &vx, &sc, &w, &dev, note = notes[n] }
                if pz_game::request_of{ note = notes[n] } is some{ value = asked } { pazaak_asked = asked }
                n = n + 1
            }
            outbox::clear{ out = &w.out }
            // HOOK(minigames): a script asked for a game of pazaak; the visit takes over the frame (game/pazaak.ctx).
            if pazaak_asked is some{ value = asked } {
                if opts.headless {
                    try pz_game::visit_auto{ &w, &vm, engine, r = asked }
                } else if try pz_game::visit{ &sdl, &w, &vm, engine, &dev, &frame, ui, mixer, adev, r = asked, &disp } {
                    quit = true
                }
                last = sdl::counter{ &sdl }
            }
            // --speed N: the presentation below steps once per N ticks, or sooner when something needs it (game/speed.ctx).
            let fresh_input = next_line > 0 and script[next_line - 1].frame >= frame_no
            if not speed::due{ opts, frame_no, w = &w, fresh_input, shown = dview.up, busy = ingame::is_busy{ ui } or loading::is_up{ l = ld }, saving = want_save.len > 0 } {
                speed::owe{ &owed, dt, clock_dt = w.clock.dt }
                ingame::step_bot{ ui, &w }    // HOOK(ingame)
                arena::reset{ heap = w.scratch }
                continue
            }
            // The skipped ticks' time: the scene's animations and the mixer's voices advance by it before this tick's own
            // presentation starts anything new (a voice that starts now plays one tick, not N); the camera takes it with its step.
            if owed.dt > 0.0 {
                scene::sync{ &sc, &w, &dev, dt = owed.clock_dt }
                vfx::update{ v = &vx, &sc, &w, &dev, dt = owed.clock_dt }
                if adev == null { speed::mix_seconds{ mixer, silent, rate, seconds = owed.dt } }
            }
            let camera_dt = dt + owed.dt
            owed = speed::Owed{ dt = 0.0, clock_dt = 0.0 }
            // 9-10. Scene and camera (which snaps behind the leader again once it is placed).
            if w.arrival > 0 { camera.started = false }
            dlgview::pre_sync{ v = &dview, w = &w, sc = &sc, dev = &dev, g = &ui.gui, dt = w.clock.dt }
            scene::sync{ &sc, &w, &dev, dt = w.clock.dt }
            vfx::update{ v = &vx, &sc, &w, &dev, dt = w.clock.dt }
            dlgview::post_sync{ v = &dview, w = &w, sc = &sc, dt = w.clock.dt }
            let look_height = leader_height{ w = &w }
            // Combat mode: the combat camera's style (camerastyle.2da row 8) while the leader
            // fights, the area's otherwise (movement.md 2.1, 2.2).
            let wanted_row = camera_row_now{ w = &w }
            if wanted_row != camera_row {
                camera_row = wanted_row
                cam::set_style{ c = &camera, t = w.tables.camerastyle, row = wanted_row }
                ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = wanted_row }
            }
            // The mouse's share (Lookabout / Mouse Look, the screen edges): keys win over the edge.
            let mouse = ingame::camera_input{ ui }    // HOOK(ingame)
            if mouse.looking != mouse_was_looking {
                mouse_was_looking = mouse.looking
                if not opts.headless { sdl::set_relative_mouse{ &sdl, on = mouse.looking } iferr {} }
            }
            let swing_to = ingame::take_turn_to{ ui }    // HOOK(ingame)
            if swing_to != obj::INVALID { cam::turn_toward{ c = &camera, id = swing_to } }
            let key_turn = ctl::turn_input{ keys }
            // Free look: the mouse and the rotate keys turn the leader himself, the camera is his eyes.
            camera.freelook = mouse.freelook
            keys.freelook = mouse.freelook
            let mut cam_yaw = mouse.yaw_degrees
            if mouse.freelook {
                turn_leader{ &w, degrees = mouse.yaw_degrees + key_turn * cam::DPS * camera_dt }
                cam_yaw = 0.0
            }
            cam::update{ c = &camera, w = &w, sc = &sc, target = w.pc, look_height, turn = if mouse.freelook { 0.0 } else if key_turn != 0.0 { key_turn } else { mouse.edge }, mouse_degrees = cam_yaw, pitch_degrees = mouse.pitch_degrees, dt = camera_dt }
            dlgview::apply_camera{ v = &dview, w = &w, sc = &sc, camera = &camera }
            if test_camera.len > 0 { place_test_camera{ &w, spec = test_camera, &camera } }
            death::place_camera{ d = &wipe, c = &camera, w = &w, sc = &sc, dt = camera_dt }
            let pc = world::object{ w = &w, id = w.pc }
            let player_room = if pc != null { walkmap::room_at{ m = &w.walk, x = pc.position.x, y = pc.position.y, z = pc.position.z + 0.5 } } else { -1 }
            let room = dlgview::view_room{ v = &dview, w = &w, player_room }
            scene::update_visibility{ &sc, w = &w, room }
            ingame::update{ ui, &w, &dev, sc, camera, dt }    // HOOK(ingame)
            if ingame::wants_quit{ ui } { quit = true }    // HOOK(ingame)
            // The party wipe's box answered or its fade over: the options menu's Exit Game is the way out (the main menu).
            death::after_ui{ d = &wipe, ui, &w, fade_running = dlgpanel::fade_running{ p = dview.panels } }
            if death::is_over{ d = wipe } { quit = true }
            // The party selection screen was applied: its exit script (ShowPartySelectionGUI's), with no caller.
            if ingame::take_exit_script{ ui } is some{ value = exit_script } { _ = scripts::run{ &w, &vm, engine, name = exit_script, self = obj::INVALID } }    // HOOK(ingame)
            if ingame::take_script_request{ ui } is some{ value = script } { _ = scripts::run{ &w, &vm, engine, name = script, self = obj::INVALID } }    // HOOK(ingame)
            // The options menu's Save Game and Load Game (the menus have closed themselves).
            if ingame::take_save_request{ ui } is some{ value = n } { want_save = n }    // HOOK(ingame)
            if ingame::take_load_request{ ui } is some{ value = n } { want_load = n }    // HOOK(ingame)
            // 11. Sound at the camera.
            ambience::update{ a = &amb, &w, eye = camera.eye, forward = camera.dir, dt }
            match adev {
                some{ value } => { audio::update{ &sdl, dev = value, m = mixer } iferr {} }
                null => {
                    let frames = math::min{ a = @as(f32, rate) * dt, b = 22050.0 }
                    mix::render{ m = mixer, into = silent[..@as(usize, frames) * 2] }
                }
            }
            // The loading screen stays up while the new area's first ticks run behind it, until it is ready (a conversation
            // its scripts started is on screen with its first line), and is drawn in the scene's place meanwhile.
            if loading::is_up{ l = ld } {
                loading::tick{ l = ld }
                let line_up = dview.up and dview.seen_line == w.conversation.line.serial
                if loading::settled{ l = ld, &w, line_shown = line_up } {
                    if w.log.module {
                        world::prefix{ w = &w }
                        _ = @fmt(&w.io, "loading screen down after {} ticks (conversation {}, its line up {})\n", ld.ticks, w.conversation.active, line_up)
                    }
                    loading::hide{ l = ld }
                    last = sdl::counter{ &sdl }
                }
            }
            // 12. Render (--no-render: only for a picture someone takes).
            if loading::is_up{ l = ld } {
                loading::draw_frame{ l = ld, &w, &dev, &sdl, &frame, opts, present = false, picture_due = speed::picture_wanted{ opts, frame_no, saving = false } }
            } else if speed::picture_wanted{ opts, frame_no, saving = want_save.len > 0 } {
                let size = gpu::screen_size{ dev }
                render::begin_frame{ &frame, time = sc.time }
                let mut view = render::make_view{ camera = cam::render_camera{ c = &camera, aspect = @as(f32, size.width) / @as(f32, size.height) } }
                speed_blur = speed_blur + (math::max{ a = leader_haste{ w = &w }, b = disp.test_blur } - speed_blur) * math::min{ a = 1.0, b = dt * 4.0 }
                view.blur = speed_blur
                view.ambient = sc.ambient
                view.fog = sc.fog
                let vi = render::add_view{ &frame, view } ifnull { 0 }
                scene::update_light{ &sc, &w }
                scene::draw{ &sc, w = &w, &frame, view = vi }
                vfx::draw{ v = &vx, &sc, &frame, view = vi }
                dlgview::draw{ v = &dview, frame = &frame }
                ingame::draw{ ui, &w, &dev, &frame }    // HOOK(ingame)
                if disp.applied.fx_timing { fxhud::draw{ h = &fxh, &w, &dev, &frame } }
                gpu::submit{ &dev, frame = &frame } iferr err{ error } {
                    _ = @fmt(&w.io, "kotor: submit failed: {}\n", error)
                    return 1
                }
            }
            let mut s: usize = 0
            while s < opts.shot_count {
                if opts.shots[s].frame == frame_no {
                    try screenshot{ &w, &dev, heap = &scene_arena, path = opts.shots[s].path, frame_no }
                    _ = @fmt(&w.io, "  frame: {} draws, {} shadows, {} lights, {} emitters, {} particles\n", frame.draw_count, frame.shadow_count, frame.light_count, frame.emitter_count, frame.particle_count)
                    fxhud::log{ &w, dev }
                    if scene::light_of{ sc = &sc, id = w.pc } is some{ value = c } {
                        _ = @fmt(&w.io, "  leader's room light: +x {} {} {} -x {} {} {} +y {} {} {} -y {} {} {} +z {} {} {} -z {} {} {}\n",
                            c.pos_x.x, c.pos_x.y, c.pos_x.z, c.neg_x.x, c.neg_x.y, c.neg_x.z, c.pos_y.x, c.pos_y.y, c.pos_y.z,
                            c.neg_y.x, c.neg_y.y, c.neg_y.z, c.pos_z.x, c.pos_z.y, c.pos_z.z, c.neg_z.x, c.neg_z.y, c.neg_z.z)
                    }
                    let p = world::object{ w = &w, id = w.pc }
                    if p != null {
                        _ = @fmt(&w.io, "  leader at {} {} {} (room {}), camera at {} {} {} looking at {} {} {}, blur {}, ambient {} {} {}, dialogue fade {}\n", p.position.x, p.position.y, p.position.z,
                            room, camera.eye.x, camera.eye.y, camera.eye.z, camera.look.x, camera.look.y, camera.look.z, speed_blur, sc.ambient.x, sc.ambient.y, sc.ambient.z, dview.panels.fade_alpha)
                    }
                }
                s = s + 1
            }
            // --screenshot-range: every frame of a stretch, for finding the one that flashes.
            if opts.range_to > 0 and frame_no >= opts.range_from and frame_no <= opts.range_to {
                try screenshot_numbered{ &w, &dev, dir = opts.range_dir, letter = 'f', number = frame_no }
            }
            if want_save.len > 0 {
                let size = gpu::screen_size{ dev }
                let pixels = try alloc::resize(u8, arena::Arena){ realloc = arena::alloc, heap = &scene_arena, mem = slice::empty(u8){}, count = @as(usize, size.width) * @as(usize, size.height) * 4 }
                _ = gpu::read_screen{ &dev, into = pixels } iferr { size }
                save::save_named{ &w, name = want_save, screen = pixels, width = size.width, height = size.height } iferr err{ error } {
                    _ = @fmt(&w.io, "kotor: save failed: {}\n", error)
                }
                _ = alloc::resize(u8, arena::Arena){ realloc = arena::alloc, heap = &scene_arena, mem = pixels, count = 0 }
                want_save = ""
            }
            if not opts.headless {
                gpu::present{ &dev, &sdl }
                display::limit_frame{ d = &disp, &sdl, fps = disp.applied.frame_limit }
                display::rest{ d = &disp, &sdl }
            }
            arena::reset{ heap = w.scratch }
        }
        _ = @fmt(&w.io, "scene: {} rooms drawn of {}, {} objects drawn, {} visuals; textures {} loaded, {} missing\n",
            sc.drawn_rooms, sc.rooms.len, sc.drawn_objects, sc.visuals.len, sc.materials.loaded, sc.materials.missing)
        let missing = list::items{ list = sc.materials.missing_names }
        let mut mi: usize = 0
        while mi < missing.len {
            let mut name = missing[mi].name
            _ = @fmt(&w.io, "texture missing: {} ({})\n", resref::bytes{ r = &name }, missing[mi].use)
            mi = mi + 1
        }
        _ = @fmt(&w.io, "sound: {} sounds started\n", amb.started)
        _ = @fmt(&w.io, "vfx: {} effects started, {} wanted while the pool was full\n", vx.started, vx.dropped)
        if timed > 1 {
            _ = @fmt(&w.io, "frames: {}, {} ms each on average, {} ms the slowest\n", timed, @as(f32, real_total * 1000.0 / @as(f64, timed - 1)), real_worst * 1000.0)
        }
        // A run that gets slower as it goes (something piling up per tick) shows in its tenths: the smoke test's
        // report flags a last tenth over twice the first (tools/smoke/report.sh).
        if opts.frames >= 1000 and timed >= opts.frames {
            _ = @fmt(&w.io, "frame tenths (ms each):")
            let mut k: usize = 0
            while k < 10 {
                let each = if tenth_count[k] > 0 { tenth_total[k] * 1000.0 / @as(f64, tenth_count[k]) } else { 0.0 }
                _ = @fmt(&w.io, " {}", @as(f32, each))
                k = k + 1
            }
            _ = @fmt(&w.io, "\n")
        }
        report::summary{ &w, routines = opts.report }
        return 0
    }

    // The front end (docs/design/gui.md, "The front end"): start-up movies and the main menu
    // through lib/frontend until New Game (its module's name, in the heap) or Quit (""). Headless,
    // the input script's `FRAME newgame` stands for the New Game button.
    fn front_end {
        mut sdl: sdl::Sdl, mut w: world::World, mut dev: gpu::Device, mut frame: render::Frame, mixer: *mut mix::Mixer,
        adev: ?*mut audio::Device, scratch: alloc::Bytes, opts: options::Options, script: []Scripted,
        mut next_line: usize, mut frame_no: u64, mut disp: display::Display,
    } -> ![]u8 {
        let mut cache = material::new_cache{ heap = w.heap, scratch }
        defer material::free_cache{ &cache, &dev }
        let size = gpu::screen_size{ dev }
        let mut g = try gui::make{ heap = w.heap, rm = w.rm.*, cache = &cache, width = @as(i32, size.width), height = @as(i32, size.height) }
        defer gui::free{ &g }
        let table = w.tlk
        if table != null { gui::set_tlk{ &g, table = &table } }
        try gui::load_defaults{ &g, fs = &w.fs, &dev }
        gui::set_cursor_visible{ &g, visible = not opts.headless }
        gui::set_mixer{ &g, mixer }
        let mut fe = frontend::make{ fs = &w.fs, heap = w.heap, game = opts.game, config_path = opts.settings }
        frontend::set_own_saves{ &fe, dir = opts.saves }
        fe.settings = disp.live
        fe.settings.disable_movies = fe.settings.disable_movies or opts.headless
        display::tell{ d = &disp, fe = &fe }
        gui::set_screen{ &g, fs = &w.fs, &dev, width = @as(i32, size.width), height = @as(i32, size.height), scale = fe.settings.gui_scale }
        try frontend::begin{ &fe, &g, fs = &w.fs, &dev, &sdl, mixer }
        let freq = sdl::counter_frequency{ &sdl }
        let mut last = sdl::counter{ &sdl }
        let mut inputs = inject::new_inputs{}      // the scripted pointer and keys, for driving the menus in tests
        let mut chosen: []u8 = ""
        let mut done = false
        while not done {
            frame_no = frame_no + 1
            if opts.frames > 0 and frame_no > opts.frames { break }
            // The script's lines for this frame first: a scripted click is put on SDL's queue and read back below.
            let mut forced = false
            let mut forced_player: []u8 = ""            // `newgame FILE`: the player blueprint to start with (tests)
            while next_line < script.len and script[next_line].frame <= frame_no {
                let line = script[next_line]
                if ci::eq{ a = line.word, b = "newgame" } {
                    forced = true
                    forced_player = text::first_word{ s = line.rest }
                } else if inject::handle_scripted{ &sdl, inp = &inputs, word = line.word, rest = line.rest } {
                    // keys and the mouse, read back with this frame's events
                } else if display::handle_scripted{ d = &disp, word = line.word, rest = line.rest } {
                    // A `gfx` word: made real just below, with the changes the menu made.
                    fe.settings = disp.live
                    fe.display_pending = true
                }
                next_line = next_line + 1
            }
            while true {
                let polled = sdl::poll{ &sdl } ifnull { break }
                display::note_event{ d = &disp, ev = polled }
                if polled is quit | close { done = true }
                if polled is resized {
                    if display::on_resized{ d = &disp, &dev, &sdl } { front_resized{ &w, &dev, &g, &fe, &disp } }
                    continue
                }
                let ev = display::map_event{ d = &disp, ev = polled }
                _ = frontend::handle_event{ &fe, &g, ev, scale_x = 1.0, scale_y = 1.0 }
            }
            let now = sdl::counter{ &sdl }
            let real = @as(f32, @as(f64, now - last) / @as(f64, freq))
            last = now
            let dt = if opts.dt > 0.0 { opts.dt } else { math::min{ a = real, b = 0.25 } }
            match adev {
                some{ value } => { audio::update{ &sdl, dev = value, m = mixer } iferr {} }
                null => {}
            }
            gui::update{ &g, dt }
            let mut out = frontend::step{ &fe, &g, fs = &w.fs, &dev, &sdl, output = adev, mixer, dt }
            // An option of the Graphics panels (or a scripted `gfx` word) changed: the device follows at once, as the original's does.
            if frontend::take_display_change{ &fe } {
                disp.pending = false
                let changed = display::apply{ d = &disp, &dev, &sdl, s = &fe.settings }
                disp.live = fe.settings
                if (changed & (display::CHANGED_SIZE | display::CHANGED_UI_SCALE)) != 0 { front_resized{ &w, &dev, &g, &fe, &disp } }
                if (changed & display::CHANGED_TEXTURES) != 0 { mount_packs{ &w, quality = disp.applied.texture_quality } }
                display::tell{ d = &disp, fe = &fe }
                frontend::refresh_display_texts{ &fe, &g }
            }
            if forced {
                let blueprint = if forced_player.len > 0 {
                    fs::read_all(heap::Heap){ fs = &w.fs, heap = w.heap, realloc = heap::alloc, path = forced_player } iferr { slice::empty(u8){} }
                } else { slice::empty(u8){} }
                out = frontend::Outcome::new_game{ module = resref::truncate{ name = "end_m01aa" }, player = blueprint }
            }
            match out {
                running => {}
                new_game{ module, player } => {
                    // The character the player made (empty: the engine's default soldier).
                    try modload::set_player_blueprint{ &w, bytes = player }
                    let mut m = module
                    let name = resref::bytes{ r = &m }
                    let kept = try alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = slice::empty(u8){}, count = name.len }
                    slice::copy(u8){ dst = kept, src = name }
                    chosen = kept
                    done = true
                }
                load_game{ folder, folder_len } => {
                    let name = folder
                    let found = save::find_save{ &w, game = opts.game, name = name[..folder_len] }
                    if found != null {
                        // "load:" + the folder, for run to load instead of entering a module.
                        let tagged = try alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = slice::empty(u8){}, count = found.len + 5 }
                        slice::copy(u8){ dst = tagged[..5], src = "load:" }
                        slice::copy(u8){ dst = tagged[5..], src = found }
                        chosen = tagged
                    } else {
                        _ = @fmt(&w.io, "kotor: no save {}\n", name[..folder_len])
                        chosen = "end_m01aa"
                    }
                    done = true
                }
                quit => { done = true }
            }
            render::begin_frame{ &frame, time = 0.0 }
            frontend::draw{ &fe, &g, &frame, target = gpu::screen_size{ dev } }
            gpu::submit{ &dev, frame = &frame } iferr { done = true }
            let mut s: usize = 0
            while s < opts.shot_count {
                if opts.shots[s].frame == frame_no { try screenshot{ &w, &dev, heap = w.scratch, path = opts.shots[s].path, frame_no } }
                s = s + 1
            }
            if not opts.headless {
                gpu::present{ &dev, &sdl }
                display::limit_frame{ d = &disp, &sdl, fps = disp.applied.frame_limit }
                display::rest{ d = &disp, &sdl }
            }
        }
        frontend::leave{ &fe, &g, &dev, mixer }
        return chosen
    }

    // The render size or the GUI scale changed while the front end runs: its panels are placed again.
    fn front_resized { mut w: world::World, mut dev: gpu::Device, mut g: gui::Gui, mut fe: frontend::Front, disp: *display::Display } {
        gui::set_screen{ &g, fs = &w.fs, &dev, width = @as(i32, disp.render.width), height = @as(i32, disp.render.height), scale = disp.applied.gui_scale }
        display::tell{ d = disp, fe = &fe }
    }

    // Another texture pack for the Texture Quality option (the original mounts the packs again as the option changes, 0x005f14a0):
    // textures already loaded stay as they are until they are loaded again.
    fn mount_packs { mut w: world::World, quality: i32 } {
        let q = @as(u32, quality)
        if w.rm.quality == q { return }
        _ = @fmt(&w.io, "texture packs: quality {} (was {})\n", q, w.rm.quality)
        res::mount_texture_packs{ fs = &w.fs, rm = w.rm, quality = q } iferr err{ error } {
            _ = @fmt(&w.io, "kotor: texture packs: {}\n", error)
        }
    }

    // The render size or the GUI scale changed: the interface is laid out again at the new size.
    fn relayout_ui { mut w: world::World, mut dev: gpu::Device, ui: *mut ingame::Ingame, mut dview: dlgview::View, disp: *display::Display } {
        ingame::set_gui_scale{ ui, scale = disp.applied.gui_scale }
        ingame::relayout{ ui, &w, &dev, width = @as(i32, disp.render.width), height = @as(i32, disp.render.height) }
        dlgpanel::resize{ p = &dview.panels, g = &ui.gui, fs = &w.fs, &dev }
    }

    // The device agrees with new settings: the interface follows what changed, and the option screens show what is true.
    fn options_changed { mut w: world::World, mut dev: gpu::Device, ui: *mut ingame::Ingame, mut dview: dlgview::View, mut disp: display::Display, ld: *mut loading::Loading, changed: u32 } {
        ld.scale = disp.applied.gui_scale
        if (changed & (display::CHANGED_SIZE | display::CHANGED_UI_SCALE)) != 0 { relayout_ui{ &w, &dev, ui, &dview, &disp } }
        if (changed & display::CHANGED_TEXTURES) != 0 { mount_packs{ &w, quality = disp.applied.texture_quality } }
        if ingame::options_front{ ui } is some{ value = fe } {
            display::tell{ d = &disp, fe }
            frontend::refresh_display_texts{ fe, g = &ui.gui }
        }
    }

    // The speed blur's strength while the leader is hasted (Force Speed, Burst of Speed ...), else 0: what it eases toward.
    fn leader_haste { w: *world::World } -> f32 {
        let o = world::object{ w, id = w.pc } ifnull { return 0.0 }
        let f = fight::of{ o } ifnull { return 0.0 }
        // Faster than it walks: haste, Burst of Speed, Force Speed (the rules clamp the factor to 1.5).
        return if f.c.stats.speed_factor > 1.2 { 0.35 } else { 0.0 }
    }

    // How high above the leader's feet the camera looks (ours: a humanoid's head; the original
    // takes the HEAD_G node's height plus appearance.2da CameraHeightOffset).
    fn leader_height { w: *world::World } -> f32 {
        let o = world::object{ w, id = w.pc } ifnull { return 1.6 }
        let c = obj::creature{ o } ifnull { return 1.6 }
        let offset = twoda::get_float{ t = w.tables.appearance, row = @as(usize, c.appearance), column = "cameraheightoffset" } ifnull 0.0
        return 1.6 + offset
    }

    // Everything SDL has queued, each event offered in turn to the minigame, the conversation panels, the
    // interface and then the world's own keys; the first that takes it ends its trip.
    fn pump_events {
        mut sdl: sdl::Sdl, mut w: world::World, mut dev: gpu::Device, ui: *mut ingame::Ingame, mut dview: dlgview::View,
        mut mg_mouse: mg_game::Mouse, mut keys: ctl::Keys, mut quit: bool, mut want_save: []u8, mut want_load: []u8, loading_up: bool,
        mut disp: display::Display,
    } {
        while true {
            let polled = sdl::poll{ &sdl } ifnull { break }
            display::note_event{ d = &disp, ev = polled }
            // The window changed shape: the device follows the drawable, the interface the device.
            if polled is resized {
                if display::on_resized{ d = &disp, &dev, &sdl } { relayout_ui{ &w, &dev, ui, &dview, &disp } }
                continue
            }
            // Positions in render pixels (the window's units, a larger drawable, bars around a scaled picture undone).
            let e = display::map_event{ d = &disp, ev = polled }
            // Behind the loading screen nothing is clicked or typed (a key let go still lets go of the walk).
            if loading_up {
                if e is quit | close { quit = true }
                if e is key{ down, keycode } { if not down { apply_key{ keys = &keys, keycode, down = false, minigame = false } } }
                continue
            }
            // A key let go always lets go of the walk, whoever else sees the event (a menu opened while W
            // was down would otherwise keep the leader walking when it closes).
            if e is key{ down, keycode } {
                if not down { apply_key{ keys = &keys, keycode, down = false, minigame = mg_game::active{ w = &w } } }
            }
            // HOOK(minigames): a minigame has no HUD, menus or quick saves: the mouse and Escape are
            // its own, the other keys go straight to the game's keys.
            if mg_game::active{ w = &w } {
                if mg_game::handle_event{ m = &mg_mouse, ev = e } { continue }
                if e is key{ down, repeat, keycode } {
                    if not repeat { apply_key{ keys = &keys, keycode, down, minigame = true } }
                    continue
                }
            }
            if dlgview::handle_event{ v = &dview, g = &ui.gui, ev = e, scale_x = 1.0, scale_y = 1.0 } { continue }
            if ingame::handle_event{ ui, &w, &dev, ev = e, scale_x = 1.0, scale_y = 1.0 } { continue }    // HOOK(ingame)
            match e {
                quit | close => { quit = true }
                key{ down, repeat, keycode } => {
                    if down and not repeat and keycode == sdl::key::F1 + 3 { want_save = "QUICKSAVE" }
                    if down and not repeat and keycode == sdl::key::F1 + 4 { want_load = "000000 - QUICKSAVE" }
                    if not repeat { apply_key{ keys = &keys, keycode, down, minigame = false } }
                }
                else => {}
            }
        }
    }

    // The held keys the world reads each frame (keymap.2da's ICPC rows): W and S forward and back, Z and C
    // strafe, A and D turn the camera, B walks. The arrows, R and Space are a minigame's (ICMiniGame) and
    // nothing in the world's: there R runs the target's default action and Space pauses (lib/ingame).
    // Turns the leader on the spot by `degrees` (positive to the left), for free look.
    fn turn_leader { mut w: world::World, degrees: f32 } {
        let o = world::object{ w = &w, id = w.pc } ifnull { return }
        let a = math::radians{ degrees }
        let c = math::cosf{ x = a }
        let s = math::sinf{ x = a }
        world::set_orientation{ o, v = math::Vec3{ x = o.orientation.x * c - o.orientation.y * s, y = o.orientation.x * s + o.orientation.y * c, z = 0.0 } }
    }

    fn apply_key { mut keys: ctl::Keys, keycode: i32, down: bool, minigame: bool } {
        if keycode == 'w' or (minigame and keycode == sdl::key::UP) { keys.forward = down }
        else if keycode == 's' or (minigame and keycode == sdl::key::DOWN) { keys.back = down }
        else if keycode == 'z' { keys.strafe_left = down }
        else if keycode == 'c' { keys.strafe_right = down }
        else if keycode == 'a' or (minigame and keycode == sdl::key::LEFT) { keys.turn_left = down }
        else if keycode == 'd' or (minigame and keycode == sdl::key::RIGHT) { keys.turn_right = down }
        else if keycode == 'b' { keys.walk = down }
        else if minigame and (keycode == 'r' or keycode == sdl::key::SPACE) { if down { keys.action = true } }
    }

    // Play's own scripted words: keys, the leader's moves, saves and loads, and the conversation and
    // fight helpers below. True if `word` is one of them, else nothing happened.
    fn handle_scripted {
        mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, mut keys: ctl::Keys,
        mut want_save: []u8, mut want_load: []u8, word: []u8, rest: []u8,
    } -> bool {
        let arg = text::first_word{ s = rest }
        if ci::eq{ a = word, b = "warp" } or ci::eq{ a = word, b = "warpxy" } {
            if ci::eq{ a = word, b = "warp" } { warp_to{ &w, tag = arg } } else { warp_xy{ &w, at = arg } }
            // `warp TAG party`, `warpxy X,Y party`: the followers stand beside the leader too, as after a door.
            let mut words = text::words{ s = rest }
            _ = text::next_word{ &words }
            if ci::eq{ a = text::next_word{ &words } ifnull "", b = "party" } { gather_party{ &w } }
        }
        else if ci::eq{ a = word, b = "use" } { use_tagged{ &w, tag = arg } }
        else if ci::eq{ a = word, b = "attack" } { attack_tagged{ &w, tag = arg } }
        else if ci::eq{ a = word, b = "newgame" } {}    // the front end's (front_end above)
        else if ci::eq{ a = word, b = "talk" } { talk_to{ &w, &vm, engine, text = rest } }
        else if ci::eq{ a = word, b = "hush" } { dlg::abort{ &w, &vm, engine } }
        else if ci::eq{ a = word, b = "drop" } { drop_item{ &w, template = arg } }
        else if ci::eq{ a = word, b = "join" } { join_template{ &w, text = rest } }
        else if ci::eq{ a = word, b = "pick" } { pick_lock{ &w, tag = arg } }
        else if ci::eq{ a = word, b = "goto" } { goto_xy{ &w, at = arg } }
        else if ci::eq{ a = word, b = "cutatk" } { cut_attack{ &w, text = rest } }
        else if ci::eq{ a = word, b = "save" } { want_save = rest }
        else if ci::eq{ a = word, b = "load" } { want_load = rest }
        else { return false }
        return true
    }

    // The scripted words for pictures: `cam ...` and `fx ...` (place_test_camera and test_effect below).
    fn handle_scripted_vfx { mut w: world::World, mut test_camera: []u8, word: []u8, rest: []u8 } -> bool {
        if ci::eq{ a = word, b = "cam" } { test_camera = rest }
        else if ci::eq{ a = word, b = "fx" } { test_effect{ &w, text = rest } }
        else { return false }
        return true
    }

    // The input script (`FRAME WORD ARGS...` per line, # comments), in frame order.
    fn read_script { mut w: world::World, path: []u8 } -> ![]Scripted {
        if path.len == 0 { return slice::empty(Scripted){} }
        let bytes = try fs::read_all(heap::Heap){ fs = &w.fs, heap = w.heap, realloc = heap::alloc, path }
        let mut out = list::new(Scripted, heap::Heap){ realloc = heap::alloc, heap = w.heap }
        let mut lines = text::Lines{ data = bytes, pos = 0 }
        while true {
            let line = text::next_line{ &lines } ifnull { break }
            let mut words = text::Words{ s = line, pos = 0 }
            let f = text::next_word{ &words } ifnull { continue }
            if f.len == 0 or f[0] == '#' { continue }
            let word = text::next_word{ &words } ifnull { continue }
            try list::push{ list = &out, item = Scripted{ frame = @as(u64, text::scan_decimal{ s = f }), word, rest = text::rest{ words } } }
        }
        return list::items{ list = out }
    }

    // `FRAME cam duel TAGA TAGB [DISTANCE]`: the camera stands to the side of two tagged objects, looking
    // at the middle of them, every frame; `cam toward TAG` turns the follow camera so the object is
    // ahead of the leader (combat tests click on it); `cam at X,Y,Z X,Y,Z` stands at one point looking at the other;
    // `cam off` gives the camera back. For pictures of a fight.
    fn place_test_camera { mut w: world::World, spec: []u8, mut camera: cam::Camera } {
        let mut words = text::words{ s = spec }
        let kind = text::next_word{ &words } ifnull { return }
        let mut eye = camera.eye
        let mut look = camera.look
        if ci::eq{ a = kind, b = "duel" } {
            let a = world::object{ w = &w, id = tagged{ w = &w, word = text::next_word{ &words } ifnull "" } } ifnull { return }
            let b = world::object{ w = &w, id = tagged{ w = &w, word = text::next_word{ &words } ifnull "" } } ifnull { return }
            let far = text::scan_f32{ s = text::next_word{ &words } ifnull "" } ifnull 0.0
            let mid = math::Vec3{ x = (a.position.x + b.position.x) * 0.5, y = (a.position.y + b.position.y) * 0.5, z = (a.position.z + b.position.z) * 0.5 + 1.1 }
            let d = math::vec3::sub{ a = b.position, b = a.position }
            let side = math::vec3::normalize{ v = math::Vec3{ x = -d.y, y = d.x, z = 0.0 } }
            let reach = if far > 0.0 { far } else { math::max{ a = 4.0, b = math::vec3::length{ v = d } * 0.9 } }
            eye = math::Vec3{ x = mid.x + side.x * reach, y = mid.y + side.y * reach, z = mid.z + 0.4 }
            look = mid
        } else if ci::eq{ a = kind, b = "toward" } {
            // The follow camera turned so the object is straight ahead of the leader, as the player
            // turns it with the keys (the next frame's camera update places it).
            let t = world::object{ w = &w, id = tagged{ w = &w, word = text::next_word{ &words } ifnull "" } } ifnull { return }
            let pc = world::object{ w = &w, id = w.pc } ifnull { return }
            let dx = t.position.x - pc.position.x
            let dy = t.position.y - pc.position.y
            if dx * dx + dy * dy > 0.01 { camera.yaw = math::atan2f{ y = -dx, x = dy } }
            return
        } else if ci::eq{ a = kind, b = "at" } {
            let from = text::next_word{ &words } ifnull { return }
            let to = text::next_word{ &words } ifnull { return }
            eye = vec_of{ s = from }
            look = vec_of{ s = to }
        } else {
            return
        }
        camera.eye = eye
        camera.look = look
        camera.dir = math::vec3::normalize{ v = math::vec3::sub{ a = look, b = eye } }
        camera.up = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }
    }

    // `FRAME fx visual ROW TAG` plays visualeffects.2da effect ROW on the tagged object (`pc` for the
    // player's character); `fx at ROW X,Y,Z` at a point; `fx model MODEL TAG [HOOK]` an effect model
    // on an object's node; `fx cast SPELL TAG` a Force power's conjure and cast visuals. For looking
    // at effects (lib/vfx, docs/design/vfx.md).
    fn test_effect { mut w: world::World, text: []u8 } {
        let mut words = text::words{ s = text }
        let kind = text::next_word{ &words } ifnull { return }
        let first = text::next_word{ &words } ifnull { return }
        let second = text::next_word{ &words } ifnull ""
        if ci::eq{ a = kind, b = "visual" } {
            let id = tagged{ w = &w, word = second }
            fight::visual_effect{ &w, effect = @trunc(i32, text::scan_decimal{ s = first }), target = id, source = w.pc, position = math::vec3::zero{} }
        } else if ci::eq{ a = kind, b = "at" } {
            fight::visual_effect{ &w, effect = @trunc(i32, text::scan_decimal{ s = first }), target = obj::INVALID, source = w.pc, position = vec_of{ s = second } }
        } else if ci::eq{ a = kind, b = "model" } {
            let hook = text::next_word{ &words } ifnull "Impact"
            outbox::post{ out = &w.out, note = outbox::Note::effect_model{
                model = resref::truncate{ name = first }, object = tagged{ w = &w, word = second }, hook = resref::truncate{ name = hook },
                position = math::vec3::zero{}, life = 0.0,
            } }
        } else if ci::eq{ a = kind, b = "cast" } {
            let spell = @trunc(i32, text::scan_decimal{ s = first })
            let id = tagged{ w = &w, word = second }
            fight::spell_visuals{ &w, id, spell, cast = false }
            fight::spell_visuals{ &w, id, spell, cast = true }
        }
    }

    // The object a test script names: `pc` is the player's character, else a tag.
    fn tagged { mut w: world::World, word: []u8 } -> u32 {
        if ci::eq{ a = word, b = "pc" } { return w.pc }
        return world::object_by_tag{ w = &w, tag = word, nth = 0 }
    }

    // "x,y,z" as a point.
    fn vec_of { s: []u8 } -> math::Vec3 {
        let c1 = text::find_byte{ s, c = ',' } ifnull { return math::vec3::zero{} }
        let rest = s[c1 + 1..]
        let c2 = text::find_byte{ s = rest, c = ',' } ifnull { return math::vec3::zero{} }
        return math::Vec3{ x = text::scan_f32{ s = s[..c1] } ifnull 0.0, y = text::scan_f32{ s = rest[..c2] } ifnull 0.0, z = text::scan_f32{ s = rest[c2 + 1..] } ifnull 0.0 }
    }

    // `FRAME talk RESREF [TAG]`: starts conversation RESREF with the creature tagged TAG
    // (end_trask by default) as its owner, without the click and the walk up: the dialogue on its
    // own, for tests.
    fn talk_to { mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, text: []u8 } {
        let mut words = text::words{ s = text }
        let name = text::next_word{ &words } ifnull { return }
        let tag = text::next_word{ &words } ifnull "end_trask"
        let owner = world::object_by_tag{ w = &w, tag, nth = 0 }
        if owner == obj::INVALID { return }
        // A conversation already running is cut short.
        dlg::abort{ &w, &vm, engine }
        w.conversation.pending = false
        if not dlg::order{ &w } { return }
        if not dlg::start{ &w, &vm, engine, owner, other = w.pc, name = resref::truncate{ name }, private = false } {
            w.conversation.pending = false
        }
    }

    // Test helpers for scripted runs: jump the leader 1.5 m in front of a tagged object, facing
    // it; queue the leader's default action on it.
    fn warp_to { mut w: world::World, tag: []u8 } {
        let id = world::object_by_tag{ w = &w, tag, nth = 0 }
        let o = world::object{ w = &w, id } ifnull {
            _ = @fmt(&w.io, "warp: no {}\n", tag)
            return
        }
        let at = math::vec3::add_scaled{ a = o.position, b = o.orientation, s = 1.5 }
        let face = math::vec3::negate{ v = o.orientation }
        movement::place{ &w, id = w.pc, at }
        let pc = world::object{ w = &w, id = w.pc } ifnull { return }
        world::set_orientation{ o = pc, v = face }
        _ = @fmt(&w.io, "warp: to {} ({} {} {})\n", tag, pc.position.x, pc.position.y, pc.position.z)
    }

    // The followers onto their formation points beside the leader (a test jump across the area).
    fn gather_party { mut w: world::World } {
        let members = party::members{ w = &w }
        let mut k: usize = 1
        while k < members.len {
            let l = rt_party::formation_point{ w = &w, index = k }
            movement::place{ &w, id = members[k], at = l.position }
            if world::object{ w = &w, id = members[k] } is some{ value = o } { world::set_orientation{ o, v = obj::direction_of{ degrees = l.facing } } }
            k = k + 1
        }
    }

    // `FRAME warpxy X,Y`: the leader onto the walkmesh at (X, Y).
    fn warp_xy { mut w: world::World, at: []u8 } {
        let comma = text::find_byte{ s = at, c = ',' } ifnull { return }
        let x = text::scan_f32{ s = at[..comma] } ifnull { return }
        let y = text::scan_f32{ s = at[comma + 1..] } ifnull { return }
        let f = walkmap::floor_anywhere{ m = &w.walk, x, y }
        let z = if f != null { f.z } else { 0.0 }
        movement::place{ &w, id = w.pc, at = math::Vec3{ x, y, z } }
    }

    fn use_tagged { mut w: world::World, tag: []u8 } {
        let id = world::object_by_tag{ w = &w, tag, nth = 0 }
        let o = world::object{ w = &w, id } ifnull { return }
        let kind = match o.kind {
            door => { actions::Kind::open_door }
            placeable => { actions::Kind::use_object }
            else => { actions::Kind::dialog_object }
        }
        let mut a = actions::make{ kind }
        a.params[0] = actions::Param::object{ id }
        _ = actions::add{ &w, id = w.pc, action = a, force = false }
    }

    // `drop TEMPLATE`: an item 3 m in front of the leader on the ground, and the leader picks it up.
    fn drop_item { mut w: world::World, template: []u8 } {
        let me = world::object{ w = &w, id = w.pc } ifnull { return }
        let at = math::vec3::add_scaled{ a = me.position, b = me.orientation, s = 3.0 }
        let id = tmpl::spawn{ &w, kind = obj::Kind::item, template, position = at, orientation = me.orientation } iferr { return }
        let io = world::object{ w = &w, id } ifnull { return }
        io.area = me.area
        io.position = at
        let mut a = actions::make{ kind = actions::Kind::pickup_item }
        a.params[0] = actions::Param::object{ id }
        a.params[1] = actions::Param::object{ id = obj::INVALID }
        a.params[2] = actions::Param::int{ v = 0 }
        _ = actions::add{ &w, id = me.id, action = a, force = false }
    }

    // `cutatk ATTACKER TARGET ANIMATION RESULT DAMAGE` (tags): CutsceneAttack as the attacker.
    fn cut_attack { mut w: world::World, text: []u8 } {
        let mut words = text::words{ s = text }
        let attacker = text::next_word{ &words } ifnull { return }
        let target = text::next_word{ &words } ifnull { return }
        let animation = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "239" })
        let result = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "1" })
        let damage = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
        let from = world::object_by_tag{ w = &w, tag = attacker, nth = 0 }
        let to = world::object_by_tag{ w = &w, tag = target, nth = 0 }
        if from == obj::INVALID or to == obj::INVALID { return }
        let mut a = actions::make{ kind = actions::Kind::attack_object }
        a.params[0] = actions::Param::object{ id = to }
        a.params[1] = actions::Param::int{ v = 1 }
        a.params[2] = actions::Param::int{ v = 0 }
        a.params[3] = actions::Param::int{ v = 1 }
        a.params[4] = actions::Param::int{ v = animation }
        a.params[5] = actions::Param::int{ v = result }
        a.params[6] = actions::Param::int{ v = damage }
        // Ahead of a follower's endless follow order, which would hold the attack back for good.
        actions::clear_for_player{ &w, id = from }
        _ = actions::add{ &w, id = from, action = a, force = false }
    }

    // `goto X,Y`: the leader walks (runs) to the point.
    fn goto_xy { mut w: world::World, at: []u8 } {
        let comma = text::find_byte{ s = at, c = ',' } ifnull { return }
        let x = text::scan_f32{ s = at[..comma] } ifnull { return }
        let y = text::scan_f32{ s = at[comma + 1..] } ifnull { return }
        let lead = party::leader{ w = &w }
        let mut a = actions::make{ kind = actions::Kind::move_to_point }
        a.params[0] = actions::Param::vector{ v = math::Vec3{ x, y, z = 0.0 } }
        a.params[1] = actions::Param::int{ v = 1 }
        a.params[2] = actions::Param::float{ v = 0.5 }
        _ = actions::add{ &w, id = if lead == obj::INVALID { w.pc } else { lead }, action = a, force = false }
    }

    // `pick TAG`: the leader uses Security on the locked door or container (OPENLOCK).
    fn pick_lock { mut w: world::World, tag: []u8 } {
        let id = world::object_by_tag{ w = &w, tag, nth = 0 }
        if id == obj::INVALID { return }
        let lead = party::leader{ w = &w }
        let mut a = actions::make{ kind = actions::Kind::open_lock }
        a.params[0] = actions::Param::object{ id }
        a.params[1] = actions::Param::object{ id = obj::INVALID }
        a.params[2] = actions::Param::int{ v = 0 }
        _ = actions::add{ &w, id = if lead == obj::INVALID { w.pc } else { lead }, action = a, force = false }
    }

    // `join TEMPLATE [SLOT]`: the creature of that blueprint becomes available in the party table's slot
    // SLOT (1 by default; the game's own: 0 Bastila, 1 Canderous, 2 Carth, ...) and joins the party next to
    // the leader (what the party selection screen does on Done).
    fn join_template { mut w: world::World, text: []u8 } {
        let mut words = text::words{ s = text }
        let template = text::next_word{ &words } ifnull { return }
        let slot = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "1" })
        if not party::valid_slot{ n = slot } { return }
        let s = @as(usize, slot)
        w.party.available[s] = true
        w.party.selectable[s] = true
        w.party.templates[s] = resref::truncate{ name = template }
        _ = rt_party::bring_member{ &w, n = slot }
    }

    fn camera_row_now { w: *world::World } -> u32 {
        let lead = party::leader{ w }
        let id = if lead == obj::INVALID { w.pc } else { lead }
        if world::object{ w, id } is some{ value = o } {
            if obj::creature{ o } is some{ value = c } { if c.in_combat and not c.dead { return 8 } }
        }
        let ao = world::object{ w, id = w.area } ifnull { return 0 }
        let a = obj::area{ o = ao } ifnull { return 0 }
        return a.camera_style
    }

    // `attack TAG`: the leader attacks the nearest live object with that tag.
    fn attack_tagged { mut w: world::World, tag: []u8 } {
        let lead = party::leader{ w = &w }
        let me = world::object{ w = &w, id = if lead == obj::INVALID { w.pc } else { lead } } ifnull { return }
        let mut best = obj::INVALID
        let mut best_d: f32 = 1000000.0
        let mut nth: i32 = 0
        while nth < 64 {
            let id = world::object_by_tag{ w = &w, tag, nth }
            nth = nth + 1
            let o = world::object{ w = &w, id } ifnull { break }
            if obj::creature{ o } is some{ value = c } { if c.dead { continue } }
            let d = math::vec3::distance{ a = o.position, b = me.position }
            if d < best_d {
                best = id
                best_d = d
            }
        }
        if best == obj::INVALID { return }
        let mut a = actions::make{ kind = actions::Kind::attack_object }
        a.params[0] = actions::Param::object{ id = best }
        _ = actions::add{ &w, id = me.id, action = a, force = false }
    }

    // The loading screen for loading a save: its module's picture, chosen before the load reads the save.
    fn show_for_save {
        mut ld: loading::Loading, mut w: world::World, mut dev: gpu::Device, mut sdl: sdl::Sdl, mut frame: render::Frame,
        opts: options::Options, folder: []u8,
    } {
        let mut name: [24]u8
        let n = save::last_module{ &w, folder, into = name[..] }
        loading::show{ l = &ld, &w, &dev, name = name[..n], story = false }
        loading::step{ l = &ld, &w, &dev, &sdl, &frame, opts, percent = 3 }
    }

    // DIR/<letter>NNNNN.png: a frame of --screenshot-range ('f') or --screenshot-loading ('l'); nothing is
    // logged, there are hundreds.
    fn screenshot_numbered { mut w: world::World, mut dev: gpu::Device, dir: []u8, letter: u8, number: u64 } -> ! {
        let mut b = utf8::Builder(heap::Heap){ bytes = list::new(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap } }
        defer utf8::free{ &b }
        try @fmt(&b, "{}/", dir)
        try utf8::push_char{ &b, c = @as(u32, letter) }
        try utf8::push_uint{ &b, n = number, width = 5, zero = true }
        try @fmt(&b, ".png")
        let size = gpu::screen_size{ dev }
        // The heap, not the scene's arena: an arena gives nothing back, and hundreds of frames fill it.
        let pixels = try alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = slice::empty(u8){}, count = @as(usize, size.width) * @as(usize, size.height) * 4 }
        defer _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = pixels, count = 0 }
        _ = try gpu::read_screen{ &dev, into = pixels }
        gpu::shade_pixels{ dev, pixels }
        let image = png::Image{ width = size.width, height = size.height, rgba = pixels }
        try png::save{ fs = &w.fs, realloc = heap::alloc, heap = w.heap, path = utf8::view{ b }.bytes, image, alpha = false, bottom_up = false }
    }

    fn screenshot { mut w: world::World, mut dev: gpu::Device, mut heap: arena::Arena, path: []u8, frame_no: u64 } -> ! {
        let size = gpu::screen_size{ dev }
        let pixels = try alloc::resize(u8, arena::Arena){ realloc = arena::alloc, &heap, mem = slice::empty(u8){}, count = @as(usize, size.width) * @as(usize, size.height) * 4 }
        defer _ = alloc::resize(u8, arena::Arena){ realloc = arena::alloc, &heap, mem = pixels, count = 0 }
        _ = try gpu::read_screen{ &dev, into = pixels }
        gpu::shade_pixels{ dev, pixels }    // as the window shows it: the brightness curve is applied in present
        let image = png::Image{ width = size.width, height = size.height, rgba = pixels }
        try png::save{ fs = &w.fs, realloc = arena::alloc, &heap, path, image, alpha = false, bottom_up = false }
        _ = @fmt(&w.io, "frame {}: wrote {} ({}x{})\n", frame_no, path, size.width, size.height)
    }
}
