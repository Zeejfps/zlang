// The loop with a window (docs/design/engine.md, "The frame"): input, the world, the scene, the
// camera, the frame drawn; live, or headless with a fixed step, scripted input and screenshots.
namespace play {
    // One scripted input line: `FRAME down KEY`, `FRAME up KEY`, and for tests `FRAME warp TAG`
    // (the leader jumps next to the object) and `FRAME use TAG` (the leader's default action on it).
    enum Command: u8 { down, up, warp, use, newgame, ui }
    struct Scripted { frame: u64, command: Command, key: []u8 }

    fn run { mut sdl: sdl::Sdl, mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, mut mem: Mem, opts: options::Options } -> !i32 {
        try sdl::init{ &sdl, flags = sdl::INIT_VIDEO | sdl::INIT_EVENTS }
        defer sdl::quit{ &sdl }
        let scene_pages = mem::pages{ &mem, size = 805306368 } ifnull { return 1 }
        let mut scene_arena = arena::new{ buf = scene_pages }
        let device_pages = mem::pages{ &mem, size = 134217728 } ifnull { return 1 }
        let mut device_arena = arena::new{ buf = device_pages }
        let texture_scratch = mem::pages{ &mem, size = 100663296 } ifnull { return 1 }
        let config = render::make_config{ title = "kotor", width = @as(i32, opts.width), height = @as(i32, opts.height), hidden = opts.headless }
        let mut dev = try gpu::open(arena::Arena){ &sdl, realloc = arena::alloc, heap = &device_arena, config }
        defer gpu::close{ &dev, &sdl }
        let mut frame = try render::make_frame(arena::Arena){ realloc = arena::alloc, heap = &device_arena, cap = render::default_capacity{} }
        // Sound: a device when there is a window; headless, the mixer runs on without one (as the
        // original does with no sound device, audio.md), so sounds still start and end.
        let mut adev: ?*mut audio::Device = null
        if not opts.headless {
            let opened = audio::open{ &sdl, rate = 44100, latency_ms = 60 } iferr err{ error } {
                _ = @fmt(&w.io, "kotor: no sound: {}\n", error)
                null
            }
            if opened != null { adev = try alloc::new(audio::Device, heap::Heap){ realloc = heap::alloc, heap = w.heap, value = opened } }
        }
        let rate: u32 = match adev { some{ value } => { value.rate } null => { 44100 } }
        let mixer = try mix::make(heap::Heap){ realloc = heap::alloc, heap = w.heap, rate, voices_2d = 24, voices_3d = 16 }
        let script = try read_script{ &w, path = opts.input }
        let mut next_line: usize = 0
        let mut frame_no: u64 = 0
        // No module named: the front end (movies, main menu) until New Game.
        if w.module == obj::INVALID {
            let chosen = try front_end{ &sdl, &w, &dev, &frame, mixer, adev, scratch = texture_scratch, opts, script, &next_line, &frame_no }
            if chosen.len == 0 { return 0 }
            try modload::enter{ &w, name = chosen }
            arena::reset{ heap = w.scratch }
        }
        let mut sc = scene::make{ arena = &scene_arena, heap = w.heap, scratch = texture_scratch, rm = w.rm.* }
        try scene::load_area{ &sc, &w, &dev }
        let mut camera = cam::new{}
        let mut control = ctl::new{}
        let ao = world::object{ w = &w, id = w.area }
        if ao != null {
            if obj::area{ o = ao } is some{ value = a } {
                cam::set_style{ c = &camera, t = w.tables.camerastyle, row = a.camera_style }
                ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = a.camera_style }
            }
        }
        let mut amb = ambience::make{ heap = w.heap, m = mixer }
        ambience::start_area{ a = &amb, &w }
        // HOOK(ingame): the HUD and the in-game menus (docs/design/hud.md).
        let ui = try ingame::make{ &w, &dev, mixer, scratch = texture_scratch, width = @as(i32, opts.width), height = @as(i32, opts.height) }
        let silent = try alloc::resize(i16, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = slice::empty(i16){}, count = 44100 }
        let mut keys = ctl::no_keys{}
        let freq = sdl::counter_frequency{ &sdl }
        let mut last = sdl::counter{ &sdl }
        let mut quit = false
        while not quit {
            frame_no = frame_no + 1
            if opts.frames > 0 and frame_no > opts.frames { break }
            keys.action = false
            // 1. Input: the window's events, or the script's lines for this frame.
            while true {
                let e = sdl::poll{ &sdl } ifnull { break }
                if ingame::handle_event{ ui, ev = e, scale_x = 1.0, scale_y = 1.0 } { continue }    // HOOK(ingame)
                match e {
                    quit | close => { quit = true }
                    key{ down, repeat, keycode } => {
                        if not repeat { apply_key{ keys = &keys, keycode, down } }
                        if down and keycode == sdl::key::ESCAPE { quit = true }
                    }
                    else => {}
                }
            }
            while next_line < script.len and script[next_line].frame <= frame_no {
                let s = script[next_line]
                next_line = next_line + 1
                match s.command {
                    down => { apply_key{ keys = &keys, keycode = keycode_of{ name = s.key }, down = true } }
                    up => { apply_key{ keys = &keys, keycode = keycode_of{ name = s.key }, down = false } }
                    warp => { warp_to{ &w, tag = s.key } }
                    use => { use_tagged{ &w, tag = s.key } }
                    newgame => {}
                    ui => { ingame::run_command{ ui, &w, &dev, text = s.key } }    // HOOK(ingame)
                }
            }
            // The step: fixed when headless, measured otherwise.
            let now = sdl::counter{ &sdl }
            let real = @as(f32, @as(f64, now - last) / @as(f64, freq))
            last = now
            let dt = if opts.dt > 0.0 { opts.dt } else { math::min{ a = real, b = 0.25 } }
            // 3-6. The world.
            clock::advance{ c = &w.clock, seconds = dt }
            ctl::update{ ctl = &control, &w, keys, yaw = camera.yaw, dt = w.clock.dt }
            world::tick{ &w, &vm, engine }
            // 6. A transition: the next module, and a new scene and sound for it.
            if w.transition != null {
                ambience::stop_area{ a = &amb }
                scene::release{ &sc, &dev }
                arena::reset{ heap = &scene_arena }
                let moved = modload::take_transition{ &w, &vm, engine } iferr err{ error } {
                    _ = @fmt(&w.io, "kotor: transition failed: {}\n", error)
                    return 1
                }
                if moved {
                    sc = scene::make{ arena = &scene_arena, heap = w.heap, scratch = texture_scratch, rm = w.rm.* }
                    try scene::load_area{ &sc, &w, &dev }
                    camera = cam::new{}
                    let next_area = world::object{ w = &w, id = w.area }
                    if next_area != null {
                        if obj::area{ o = next_area } is some{ value = a } {
                            cam::set_style{ c = &camera, t = w.tables.camerastyle, row = a.camera_style }
                            ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = a.camera_style }
                        }
                    }
                    ambience::start_area{ a = &amb, &w }
                }
            }
            // 8. The outbox: sounds to the ambience (HOOK(gui): fades, movies, text).
            let notes = outbox::notes{ out = &w.out }
            let mut n: usize = 0
            while n < notes.len {
                ambience::take{ a = &amb, &w, note = notes[n] }
                n = n + 1
            }
            outbox::clear{ out = &w.out }
            // 9-10. Scene and camera (which snaps behind the leader again once it is placed).
            if w.arrival > 0 { camera.started = false }
            scene::sync{ &sc, &w, &dev, dt = w.clock.dt }
            let look_height = leader_height{ w = &w }
            cam::update{ c = &camera, w = &w, target = w.pc, look_height, turn = ctl::turn_input{ keys }, dt }
            let pc = world::object{ w = &w, id = w.pc }
            let room = if pc != null { walkmap::room_at{ m = &w.walk, x = pc.position.x, y = pc.position.y, z = pc.position.z + 0.5 } } else { -1 }
            scene::update_visibility{ &sc, w = &w, room }
            ingame::update{ ui, &w, &dev, camera, dt }    // HOOK(ingame)
            // 11. Sound at the camera.
            ambience::update{ a = &amb, &w, eye = camera.eye, forward = camera.dir, dt }
            match adev {
                some{ value } => { audio::update{ &sdl, dev = value, m = mixer } iferr {} }
                null => {
                    let frames = math::min{ a = @as(f32, rate) * dt, b = 22050.0 }
                    mix::render{ m = mixer, into = silent[..@as(usize, frames) * 2] }
                }
            }
            // 12. Render.
            let size = gpu::screen_size{ dev }
            render::begin_frame{ &frame, time = sc.time }
            let mut view = render::make_view{ camera = cam::render_camera{ c = &camera, aspect = @as(f32, size.width) / @as(f32, size.height) } }
            view.ambient = sc.ambient
            view.fog = sc.fog
            let vi = render::add_view{ &frame, view } ifnull { 0 }
            scene::draw{ &sc, w = &w, &frame, view = vi }
            ingame::draw{ ui, &w, &dev, &frame }    // HOOK(ingame)
            gpu::submit{ &dev, frame = &frame } iferr err{ error } {
                _ = @fmt(&w.io, "kotor: submit failed: {}\n", error)
                return 1
            }
            let mut s: usize = 0
            while s < opts.shot_count {
                if opts.shots[s].frame == frame_no { try screenshot{ &w, &dev, heap = &scene_arena, path = opts.shots[s].path, frame_no } }
                s = s + 1
            }
            if not opts.headless { gpu::present{ &dev, &sdl } }
            arena::reset{ heap = w.scratch }
        }
        _ = @fmt(&w.io, "scene: {} rooms drawn of {}, {} objects drawn, {} visuals; textures {} loaded, {} missing\n",
            sc.drawn_rooms, sc.rooms.len, sc.drawn_objects, sc.visuals.len, sc.materials.loaded, sc.materials.missing)
        _ = @fmt(&w.io, "sound: {} sounds started\n", amb.started)
        report::summary{ &w, routines = opts.report }
        return 0
    }

    // The front end (docs/design/gui.md, "The front end"): start-up movies and the main menu
    // through lib/frontend until New Game (its module's name, in the heap) or Quit (""). Headless,
    // the input script's `FRAME newgame` stands for the New Game button.
    fn front_end {
        mut sdl: sdl::Sdl, mut w: world::World, mut dev: gpu::Device, mut frame: render::Frame, mixer: *mut mix::Mixer,
        adev: ?*mut audio::Device, scratch: alloc::Bytes, opts: options::Options, script: []Scripted,
        mut next_line: usize, mut frame_no: u64,
    } -> ![]u8 {
        let mut cache = material::new_cache{ heap = w.heap, scratch }
        defer material::free_cache{ &cache, &dev }
        let mut g = try gui::make{ heap = w.heap, rm = w.rm.*, cache = &cache, width = @as(i32, opts.width), height = @as(i32, opts.height) }
        defer gui::free{ &g }
        let table = w.tlk
        if table != null { gui::set_tlk{ &g, table = &table } }
        try gui::load_defaults{ &g, fs = &w.fs, &dev }
        gui::set_cursor_visible{ &g, visible = not opts.headless }
        gui::set_mixer{ &g, mixer }
        let mut fe = frontend::make{ fs = &w.fs, heap = w.heap, game = opts.game, config_path = "kotor/out/kotor-settings.ini" }
        fe.settings.disable_movies = fe.settings.disable_movies or opts.headless
        gui::set_screen{ &g, fs = &w.fs, &dev, width = @as(i32, opts.width), height = @as(i32, opts.height), scale = fe.settings.gui_scale }
        try frontend::begin{ &fe, &g, fs = &w.fs, &dev, &sdl, mixer }
        let freq = sdl::counter_frequency{ &sdl }
        let mut last = sdl::counter{ &sdl }
        let mut chosen: []u8 = ""
        let mut done = false
        while not done {
            frame_no = frame_no + 1
            if opts.frames > 0 and frame_no > opts.frames { break }
            while true {
                let ev = sdl::poll{ &sdl } ifnull { break }
                if ev is quit | close { done = true }
                _ = frontend::handle_event{ &fe, &g, ev, scale_x = 1.0, scale_y = 1.0 }
            }
            let mut forced = false
            while next_line < script.len and script[next_line].frame <= frame_no {
                if script[next_line].command == Command::newgame { forced = true }
                next_line = next_line + 1
            }
            let now = sdl::counter{ &sdl }
            let real = @as(f32, @as(f64, now - last) / @as(f64, freq))
            last = now
            let dt = if opts.dt > 0.0 { opts.dt } else { math::min{ a = real, b = 0.25 } }
            match adev {
                some{ value } => { audio::update{ &sdl, dev = value, m = mixer } iferr {} }
                null => {}
            }
            gui::update{ &g, dt }
            let mut out = frontend::step{ &fe, &g, fs = &w.fs, &dev, &sdl, output = adev, mixer, dt }
            if forced { out = frontend::Outcome::new_game{ module = resref::truncate{ name = "end_m01aa" } } }
            match out {
                running => {}
                new_game{ module } => {
                    let mut m = module
                    let name = resref::bytes{ r = &m }
                    let kept = try alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = slice::empty(u8){}, count = name.len }
                    slice::copy(u8){ dst = kept, src = name }
                    chosen = kept
                    done = true
                }
                load_game{ folder, folder_len } => {
                    // HOOK(save): loading a game. Until then, a new game.
                    _ = @fmt(&w.io, "kotor: load game {}: not yet, starting a new game\n", folder[..folder_len])
                    chosen = "end_m01aa"
                    done = true
                }
                quit => { done = true }
            }
            render::begin_frame{ &frame, time = 0.0 }
            frontend::draw{ &fe, &g, &frame, target = gpu::screen_size{ dev } }
            gpu::submit{ &dev, frame = &frame } iferr { done = true }
            let mut s: usize = 0
            while s < opts.shot_count {
                if opts.shots[s].frame == frame_no { try screenshot{ &w, &dev, heap = w.scratch, path = opts.shots[s].path, frame_no } }
                s = s + 1
            }
            if not opts.headless { gpu::present{ &dev, &sdl } }
        }
        frontend::leave{ &fe, &g, &dev, mixer }
        return chosen
    }

    // How high above the leader's feet the camera looks (ours: a humanoid's head; the original
    // takes the HEAD_G node's height plus appearance.2da CameraHeightOffset).
    fn leader_height { w: *world::World } -> f32 {
        let o = world::object{ w, id = w.pc } ifnull { return 1.6 }
        let c = obj::creature{ o } ifnull { return 1.6 }
        let offset = twoda::get_float{ t = w.tables.appearance, row = @as(usize, c.appearance), column = "cameraheightoffset" } ifnull 0.0
        return 1.6 + offset
    }

    fn apply_key { mut keys: ctl::Keys, keycode: i32, down: bool } {
        if keycode == 'w' or keycode == sdl::key::UP { keys.forward = down }
        else if keycode == 's' or keycode == sdl::key::DOWN { keys.back = down }
        else if keycode == 'z' { keys.strafe_left = down }
        else if keycode == 'c' { keys.strafe_right = down }
        else if keycode == 'a' or keycode == sdl::key::LEFT { keys.turn_left = down }
        else if keycode == 'd' or keycode == sdl::key::RIGHT { keys.turn_right = down }
        else if keycode == 'r' or keycode == sdl::key::SPACE { if down { keys.action = true } }
    }

    // A key's SDL keycode by the name the input script uses (a letter, `up`, `space`, ...).
    fn keycode_of { name: []u8 } -> i32 {
        if name.len == 1 { return @as(i32, ascii::to_lower{ c = name[0] }) }
        if ci::eq{ a = name, b = "up" } { return sdl::key::UP }
        if ci::eq{ a = name, b = "down" } { return sdl::key::DOWN }
        if ci::eq{ a = name, b = "left" } { return sdl::key::LEFT }
        if ci::eq{ a = name, b = "right" } { return sdl::key::RIGHT }
        if ci::eq{ a = name, b = "space" } { return sdl::key::SPACE }
        if ci::eq{ a = name, b = "escape" } { return sdl::key::ESCAPE }
        return 0
    }

    // The input script (`FRAME down KEY` / `FRAME up KEY` per line, # comments), in frame order.
    fn read_script { mut w: world::World, path: []u8 } -> ![]Scripted {
        if path.len == 0 { return slice::empty(Scripted){} }
        let bytes = try fs::read_all(heap::Heap){ fs = &w.fs, heap = w.heap, realloc = heap::alloc, path }
        let mut out = list::new(Scripted, heap::Heap){ realloc = heap::alloc, heap = w.heap }
        let mut lines = text::Lines{ data = bytes, pos = 0 }
        while true {
            let line = text::next_line{ &lines } ifnull { break }
            let mut words = text::Words{ s = line, pos = 0 }
            let f = text::next_word{ &words } ifnull { continue }
            if f.len == 0 or f[0] == '#' { continue }
            let what = text::next_word{ &words } ifnull { continue }
            let command = if ci::eq{ a = what, b = "down" } { Command::down } else if ci::eq{ a = what, b = "warp" } { Command::warp }
                else if ci::eq{ a = what, b = "use" } { Command::use } else if ci::eq{ a = what, b = "newgame" } { Command::newgame }
                else if ci::eq{ a = what, b = "ui" } { Command::ui } else { Command::up }
            // `ui` takes the rest of the line (ingame::run_command); the others one word.
            let key = if command == Command::ui { text::rest{ words } } else { text::next_word{ &words } ifnull "" }
            try list::push{ list = &out, item = Scripted{ frame = @as(u64, text::scan_decimal{ s = f }), command, key } }
        }
        return list::items{ list = out }
    }

    // Test helpers for scripted runs: jump the leader 1.5 m in front of a tagged object, facing
    // it; queue the leader's default action on it.
    fn warp_to { mut w: world::World, tag: []u8 } {
        let id = world::object_by_tag{ w = &w, tag, nth = 0 }
        let o = world::object{ w = &w, id } ifnull {
            _ = @fmt(&w.io, "warp: no {}\n", tag)
            return
        }
        let at = math::vec3::add_scaled{ a = o.position, b = o.orientation, s = 1.5 }
        let face = math::vec3::negate{ v = o.orientation }
        movement::place{ &w, id = w.pc, at }
        let pc = world::object{ w = &w, id = w.pc } ifnull { return }
        world::set_orientation{ o = pc, v = face }
        _ = @fmt(&w.io, "warp: to {} ({} {} {})\n", tag, pc.position.x, pc.position.y, pc.position.z)
    }

    fn use_tagged { mut w: world::World, tag: []u8 } {
        let id = world::object_by_tag{ w = &w, tag, nth = 0 }
        let o = world::object{ w = &w, id } ifnull { return }
        let kind = match o.kind {
            door => { actions::Kind::open_door }
            placeable => { actions::Kind::use_object }
            else => { actions::Kind::dialog_object }
        }
        let mut a = actions::make{ kind }
        a.params[0] = actions::Param::object{ id }
        _ = actions::add{ &w, id = w.pc, action = a, force = false }
    }

    fn screenshot { mut w: world::World, mut dev: gpu::Device, mut heap: arena::Arena, path: []u8, frame_no: u64 } -> ! {
        let size = gpu::screen_size{ dev }
        let pixels = try alloc::resize(u8, arena::Arena){ realloc = arena::alloc, &heap, mem = slice::empty(u8){}, count = @as(usize, size.width) * @as(usize, size.height) * 4 }
        defer _ = alloc::resize(u8, arena::Arena){ realloc = arena::alloc, &heap, mem = pixels, count = 0 }
        _ = try gpu::read_screen{ &dev, into = pixels }
        let image = png::Image{ width = size.width, height = size.height, rgba = pixels }
        try png::save{ fs = &w.fs, realloc = arena::alloc, &heap, path, image, alpha = false, bottom_up = false }
        _ = @fmt(&w.io, "frame {}: wrote {} ({}x{})\n", frame_no, path, size.width, size.height)
    }
}
