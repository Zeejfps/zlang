// The loop with a window (docs/design/engine.md, "The frame"): input, the world, the scene, the
// camera, the frame drawn; live, or headless with a fixed step, scripted input and screenshots.
namespace play {
    // One scripted input line: `FRAME down KEY`, `FRAME up KEY`, and for tests `FRAME warp TAG`
    // (the leader jumps next to the object), `FRAME use TAG` (the leader's default action on it) and
    // `FRAME gunner` (a bot aims and fires the turret) and `FRAME mouse DX DY` (the mouse moves by
    // those counts, aiming the turret) and `FRAME pause` (Escape in a minigame: game/minigame_scene.ctx).
    enum Command: u8 { down, up, warp, warpxy, use, newgame, ui, save, load, attack, talk, hush, drop, gunner, mouse, pause }
    struct Scripted { frame: u64, command: Command, key: []u8 }

    fn run { mut sdl: sdl::Sdl, mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, mut mem: Mem, opts: options::Options } -> !i32 {
        try sdl::init{ &sdl, flags = sdl::INIT_VIDEO | sdl::INIT_EVENTS }
        defer sdl::quit{ &sdl }
        let scene_pages = mem::pages{ &mem, size = 805306368 } ifnull { return 1 }
        let mut scene_arena = arena::new{ buf = scene_pages }
        let device_pages = mem::pages{ &mem, size = 134217728 } ifnull { return 1 }
        let mut device_arena = arena::new{ buf = device_pages }
        let texture_scratch = mem::pages{ &mem, size = 100663296 } ifnull { return 1 }
        let config = render::make_config{ title = "kotor", width = @as(i32, opts.width), height = @as(i32, opts.height), hidden = opts.headless }
        let mut dev = try gpu::open(arena::Arena){ &sdl, realloc = arena::alloc, heap = &device_arena, config }
        defer gpu::close{ &dev, &sdl }
        let mut frame = try render::make_frame(arena::Arena){ realloc = arena::alloc, heap = &device_arena, cap = render::default_capacity{} }
        // Sound: a device when there is a window; headless, the mixer runs on without one (as the
        // original does with no sound device, audio.md), so sounds still start and end.
        let mut adev: ?*mut audio::Device = null
        if not opts.headless {
            let opened = audio::open{ &sdl, rate = 44100, latency_ms = 60 } iferr err{ error } {
                _ = @fmt(&w.io, "kotor: no sound: {}\n", error)
                null
            }
            if opened != null { adev = try alloc::new(audio::Device, heap::Heap){ realloc = heap::alloc, heap = w.heap, value = opened } }
        }
        let rate: u32 = match adev { some{ value } => { value.rate } null => { 44100 } }
        let mixer = try mix::make(heap::Heap){ realloc = heap::alloc, heap = w.heap, rate, voices_2d = 24, voices_3d = 16 }
        let script = try read_script{ &w, path = opts.input }
        let mut next_line: usize = 0
        let mut frame_no: u64 = 0
        // No module named: the front end (movies, main menu) until New Game.
        if w.module == obj::INVALID {
            let chosen = try front_end{ &sdl, &w, &dev, &frame, mixer, adev, scratch = texture_scratch, opts, script, &next_line, &frame_no }
            if chosen.len == 0 { return 0 }
            if chosen.len > 5 and slice::eq_bytes{ a = chosen[..5], b = "load:" } {
                try save::load_game{ &w, &vm, engine, folder = chosen[5..] }
            } else {
                save::clear_store{ st = &w.gip }
                try modload::enter{ &w, name = chosen }
            }
            arena::reset{ heap = w.scratch }
        }
        let mut sc = scene::make{ arena = &scene_arena, heap = w.heap, scratch = texture_scratch, rm = w.rm.* }
        try scene::load_area{ &sc, &w, &dev }
        let mut camera = cam::new{}
        let mut camera_row: u32 = 0xFFFFFFFF    // the camerastyle.2da row the camera uses
        let mut control = ctl::new{}
        let ao = world::object{ w = &w, id = w.area }
        if ao != null {
            if obj::area{ o = ao } is some{ value = a } {
                cam::set_style{ c = &camera, t = w.tables.camerastyle, row = a.camera_style }
                ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = a.camera_style }
            }
        }
        let mut amb = ambience::make{ heap = w.heap, m = mixer }
        let mut dview = dlgview::make{ heap = w.heap, m = mixer }
        dlgview::attach{ v = &dview, w = &w }
        ambience::start_area{ a = &amb, &w }
        // HOOK(minigames): a minigame area has a run, its own stage and its own frames (game/minigame*.ctx).
        let mut mg_models = mdl_cache::new{ rm = w.rm.*, keep = w.mod_arena }
        _ = try mg_game::enter{ &w, models = &mg_models }
        let mut mg_stage = mg_game::make_stage{}
        let mut mg_mouse = mg_game::make_mouse{}
        // HOOK(ingame): the HUD and the in-game menus (docs/design/hud.md).
        let ui = try ingame::make{ &w, &dev, mixer, scratch = texture_scratch, width = @as(i32, opts.width), height = @as(i32, opts.height) }
        if not opts.headless { _ = sdl::SDL_ShowCursor{ &sdl, toggle = 0 } }    // HOOK(ingame): the GUI draws the pointer
        let silent = try alloc::resize(i16, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = slice::empty(i16){}, count = 44100 }
        let mut keys = ctl::no_keys{}
        let freq = sdl::counter_frequency{ &sdl }
        let mut last = sdl::counter{ &sdl }
        let mut quit = false
        let mut game_over = false
        let mut want_save: []u8 = ""            // a save asked for this frame: its folder name
        let mut want_load: []u8 = ""            // a load asked for: a folder (ours, then the install's)
        let mut real_total: f64 = 0.0
        let mut real_worst: f32 = 0.0
        let mut timed: u64 = 0
        while not quit {
            frame_no = frame_no + 1
            if opts.frames > 0 and frame_no > opts.frames { break }
            keys.action = false
            ingame::begin_frame{ ui }    // HOOK(ingame)
            // 1. Input: the window's events, or the script's lines for this frame.
            while true {
                let e = sdl::poll{ &sdl } ifnull { break }
                // HOOK(minigames): a minigame has no HUD, menus or quick saves: the mouse and Escape are
                // its own, the other keys go straight to the game's keys.
                if mg_game::active{ w = &w } {
                    if mg_game::handle_event{ m = &mg_mouse, ev = e } { continue }
                    if e is key{ down, repeat, keycode } {
                        if not repeat { apply_key{ keys = &keys, keycode, down } }
                        continue
                    }
                }
                if dlgview::handle_event{ v = &dview, g = &ui.gui, ev = e, scale_x = 1.0, scale_y = 1.0 } { continue }
                if ingame::handle_event{ ui, &w, &dev, ev = e, scale_x = 1.0, scale_y = 1.0 } { continue }    // HOOK(ingame)
                match e {
                    quit | close => { quit = true }
                    key{ down, repeat, keycode } => {
                        if down and not repeat and keycode == sdl::key::F1 + 3 { want_save = "QUICKSAVE" }
                        if down and not repeat and keycode == sdl::key::F1 + 4 { want_load = "000000 - QUICKSAVE" }
                        if not repeat { apply_key{ keys = &keys, keycode, down } }
                    }
                    else => {}
                }
            }
            while next_line < script.len and script[next_line].frame <= frame_no {
                let s = script[next_line]
                next_line = next_line + 1
                match s.command {
                    down => { apply_key{ keys = &keys, keycode = keycode_of{ name = s.key }, down = true } }
                    up => { apply_key{ keys = &keys, keycode = keycode_of{ name = s.key }, down = false } }
                    warp => { warp_to{ &w, tag = s.key } }
                    warpxy => { warp_xy{ &w, at = s.key } }
                    use => { use_tagged{ &w, tag = s.key } }
                    attack => { attack_tagged{ &w, tag = s.key } }
                    newgame => {}
                    gunner => { mg_mouse.auto = true }
                    pause => { mg_mouse.paused = not mg_mouse.paused }
                    mouse => {
                        let mut words = text::words{ s = s.key }
                        mg_mouse.dx = mg_mouse.dx + @trunc(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
                        mg_mouse.dy = mg_mouse.dy + @trunc(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
                    }
                    talk => { talk_to{ &w, &vm, engine, text = s.key } }
                    hush => { dlg::abort{ &w, &vm, engine } }
                    drop => { drop_item{ &w, template = s.key } }
                    ui => {
                        if not dlgview::run_command{ v = &dview, w = &w, g = &ui.gui, text = s.key } { ingame::run_command{ ui, &w, &dev, text = s.key } }    // HOOK(ingame)
                    }
                    save => { want_save = s.key }
                    load => { want_load = s.key }
                }
            }
            // The step: fixed when headless, measured otherwise.
            let now = sdl::counter{ &sdl }
            let real = @as(f32, @as(f64, now - last) / @as(f64, freq))
            last = now
            if timed > 0 {
                real_total = real_total + @as(f64, real)
                if real > real_worst { real_worst = real }
            }
            timed = timed + 1
            let dt = if opts.dt > 0.0 { opts.dt } else { math::min{ a = real, b = 0.25 } }
            // A load replaces the world's game, then the presentation starts over (as a transition).
            if want_load.len > 0 {
                let folder = save::find_save{ &w, game = opts.game, name = want_load }
                want_load = ""
                if folder == null {
                    _ = @fmt(&w.io, "kotor: no such save\n")
                } else {
                    // As a transition: no conversation survives the world it ran in.
                    dlg::abort{ &w, &vm, engine }
                    dlgview::leave{ v = &dview, w = &w, sc = &sc, g = &ui.gui }
                    ambience::stop_area{ a = &amb }
                    scene::release{ &sc, &dev }
                    arena::reset{ heap = &scene_arena }
                    game_over = false
                    clock::set_pause{ c = &w.clock, bit = clock::PAUSE_ENGINE, on = false }
                    save::load_game{ &w, &vm, engine, folder } iferr err{ error } {
                        _ = @fmt(&w.io, "kotor: load failed: {}\n", error)
                        return 1
                    }
                    sc = scene::make{ arena = &scene_arena, heap = w.heap, scratch = texture_scratch, rm = w.rm.* }
                    try scene::load_area{ &sc, &w, &dev }
                    camera = cam::new{}
                    let loaded_area = world::object{ w = &w, id = w.area }
                    if loaded_area != null {
                        if obj::area{ o = loaded_area } is some{ value = a } {
                            cam::set_style{ c = &camera, t = w.tables.camerastyle, row = a.camera_style }
                            ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = a.camera_style }
                        }
                    }
                    ambience::start_area{ a = &amb, &w }
                }
            }
            w.played_seconds = w.played_seconds + @as(f64, real)
            w.autosave_ms = w.autosave_ms + @as(f64, real) * 1000.0
            // An autosave wanted by a transition or a script, once the area is in place.
            if w.autosave_due and w.transition == null and w.arrival == 0 and want_save.len == 0 {
                w.autosave_due = false
                want_save = "AUTOSAVE"
            }
            // HOOK(minigames): in a minigame area the frame is the minigame's, until a module change is pending.
            if mg_game::active{ w = &w } {
                // No saving in a minigame (modulesave.2da keeps none of them).
                want_save = ""
                w.autosave_due = false
                if mg_stage.ended { quit = true }
                let leaving = try mg_game::frame{ &sdl, &w, &vm, engine, &dev, &frame, &sc, stage = &mg_stage, &amb, mixer, adev, silent, rate, opts, keys, mouse = &mg_mouse, dt, frame_no, shot_heap = &scene_arena, dview = &dview, g = &ui.gui }
                if not leaving { continue }
            }
            // 3-6. The world.
            clock::advance{ c = &w.clock, seconds = dt }
            // The player doesn't walk while a conversation runs (re/dialogue.md 4.9).
            if w.conversation.active { keys = ctl::no_keys{} }
            ctl::update{ ctl = &control, &w, keys, yaw = camera.yaw, dt = w.clock.dt }
            world::tick{ &w, &vm, engine }
            // The whole party fallen: the game is over (ours: the world stops, the options menu's
            // Load Game is the way on; the original's death camera and panel are not built).
            if not game_over and w.arrival == 0 and w.transition == null and fight::party_fallen{ w = &w } {
                game_over = true
                clock::set_pause{ c = &w.clock, bit = clock::PAUSE_ENGINE, on = true }
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "kotor: {}\n", world::string_by_strref{ w = &w, strref = 42351 })
            }
            // 7. The conversation's pump: the next line, the replies, the end.
            dlg::update{ &w, &vm, engine }
            // 6. A transition: the next module, and a new scene and sound for it.
            if w.transition != null {
                // A conversation doesn't cross a module change (its objects go).
                dlg::abort{ &w, &vm, engine }
                dlgview::leave{ v = &dview, w = &w, sc = &sc, g = &ui.gui }
                ambience::stop_area{ a = &amb }
                scene::release{ &sc, &dev }
                arena::reset{ heap = &scene_arena }
                let moved = modload::take_transition{ &w, &vm, engine } iferr err{ error } {
                    _ = @fmt(&w.io, "kotor: transition failed: {}\n", error)
                    return 1
                }
                if moved {
                    sc = scene::make{ arena = &scene_arena, heap = w.heap, scratch = texture_scratch, rm = w.rm.* }
                    try scene::load_area{ &sc, &w, &dev }
                    camera = cam::new{}
                    let next_area = world::object{ w = &w, id = w.area }
                    if next_area != null {
                        if obj::area{ o = next_area } is some{ value = a } {
                            cam::set_style{ c = &camera, t = w.tables.camerastyle, row = a.camera_style }
                            ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = a.camera_style }
                        }
                    }
                    ambience::start_area{ a = &amb, &w }
                    mg_stage = mg_game::make_stage{}
                    _ = try mg_game::enter{ &w, models = &mg_models }
                }
            }
            // 8. The outbox: sounds to the ambience (HOOK(gui): fades, movies, text).
            let notes = outbox::notes{ out = &w.out }
            let mut n: usize = 0
            let mut pazaak_asked: ?pz_game::Request = null    // HOOK(minigames)
            while n < notes.len {
                ambience::take{ a = &amb, &w, note = notes[n] }
                ingame::take{ ui, &w, note = notes[n] }    // HOOK(ingame)
                dlgview::take_note{ v = &dview, w = &w, g = &ui.gui, dev = &dev, note = notes[n] }
                if pz_game::request_of{ note = notes[n] } is some{ value = asked } { pazaak_asked = asked }
                n = n + 1
            }
            outbox::clear{ out = &w.out }
            // HOOK(minigames): a script asked for a game of pazaak; the visit takes over the frame (game/pazaak.ctx).
            if pazaak_asked is some{ value = asked } {
                if opts.headless {
                    try pz_game::visit_auto{ &w, &vm, engine, r = asked }
                } else if try pz_game::visit{ &sdl, &w, &vm, engine, &dev, &frame, ui, mixer, adev, r = asked } {
                    quit = true
                }
                last = sdl::counter{ &sdl }
            }
            // 9-10. Scene and camera (which snaps behind the leader again once it is placed).
            if w.arrival > 0 { camera.started = false }
            dlgview::pre_sync{ v = &dview, w = &w, sc = &sc, dev = &dev, g = &ui.gui, dt = w.clock.dt }
            scene::sync{ &sc, &w, &dev, dt = w.clock.dt }
            dlgview::post_sync{ v = &dview, w = &w, sc = &sc, dt = w.clock.dt }
            let look_height = leader_height{ w = &w }
            // Combat mode: the combat camera's style (camerastyle.2da row 8) while the leader
            // fights, the area's otherwise (movement.md 2.1, 2.2).
            let wanted_row = camera_row_now{ w = &w }
            if wanted_row != camera_row {
                camera_row = wanted_row
                cam::set_style{ c = &camera, t = w.tables.camerastyle, row = wanted_row }
                ctl::set_style{ ctl = &control, t = w.tables.camerastyle, row = wanted_row }
            }
            cam::update{ c = &camera, w = &w, sc = &sc, target = w.pc, look_height, turn = ctl::turn_input{ keys }, dt }
            dlgview::apply_camera{ v = &dview, w = &w, sc = &sc, camera = &camera }
            let pc = world::object{ w = &w, id = w.pc }
            let player_room = if pc != null { walkmap::room_at{ m = &w.walk, x = pc.position.x, y = pc.position.y, z = pc.position.z + 0.5 } } else { -1 }
            let room = dlgview::view_room{ v = &dview, w = &w, player_room }
            scene::update_visibility{ &sc, w = &w, room }
            ingame::update{ ui, &w, &dev, sc, camera, dt }    // HOOK(ingame)
            if ingame::wants_quit{ ui } { quit = true }    // HOOK(ingame)
            // The options menu's Save Game and Load Game (the menus have closed themselves).
            if ingame::take_save_request{ ui } is some{ value = n } { want_save = n }    // HOOK(ingame)
            if ingame::take_load_request{ ui } is some{ value = n } { want_load = n }    // HOOK(ingame)
            // 11. Sound at the camera.
            ambience::update{ a = &amb, &w, eye = camera.eye, forward = camera.dir, dt }
            match adev {
                some{ value } => { audio::update{ &sdl, dev = value, m = mixer } iferr {} }
                null => {
                    let frames = math::min{ a = @as(f32, rate) * dt, b = 22050.0 }
                    mix::render{ m = mixer, into = silent[..@as(usize, frames) * 2] }
                }
            }
            // 12. Render.
            let size = gpu::screen_size{ dev }
            render::begin_frame{ &frame, time = sc.time }
            let mut view = render::make_view{ camera = cam::render_camera{ c = &camera, aspect = @as(f32, size.width) / @as(f32, size.height) } }
            view.ambient = sc.ambient
            view.fog = sc.fog
            let vi = render::add_view{ &frame, view } ifnull { 0 }
            scene::draw{ &sc, w = &w, &frame, view = vi }
            dlgview::draw{ v = &dview, frame = &frame }
            ingame::draw{ ui, &w, &dev, &frame }    // HOOK(ingame)
            gpu::submit{ &dev, frame = &frame } iferr err{ error } {
                _ = @fmt(&w.io, "kotor: submit failed: {}\n", error)
                return 1
            }
            let mut s: usize = 0
            while s < opts.shot_count {
                if opts.shots[s].frame == frame_no {
                    try screenshot{ &w, &dev, heap = &scene_arena, path = opts.shots[s].path, frame_no }
                    let p = world::object{ w = &w, id = w.pc }
                    if p != null {
                        _ = @fmt(&w.io, "  leader at {} {} {} (room {}), camera at {} {} {} looking at {} {} {}\n", p.position.x, p.position.y, p.position.z,
                            room, camera.eye.x, camera.eye.y, camera.eye.z, camera.look.x, camera.look.y, camera.look.z)
                    }
                }
                s = s + 1
            }
            if want_save.len > 0 {
                let size = gpu::screen_size{ dev }
                let pixels = try alloc::resize(u8, arena::Arena){ realloc = arena::alloc, heap = &scene_arena, mem = slice::empty(u8){}, count = @as(usize, size.width) * @as(usize, size.height) * 4 }
                _ = gpu::read_screen{ &dev, into = pixels } iferr { size }
                save::save_named{ &w, name = want_save, screen = pixels, width = size.width, height = size.height } iferr err{ error } {
                    _ = @fmt(&w.io, "kotor: save failed: {}\n", error)
                }
                _ = alloc::resize(u8, arena::Arena){ realloc = arena::alloc, heap = &scene_arena, mem = pixels, count = 0 }
                want_save = ""
            }
            if not opts.headless { gpu::present{ &dev, &sdl } }
            arena::reset{ heap = w.scratch }
        }
        _ = @fmt(&w.io, "scene: {} rooms drawn of {}, {} objects drawn, {} visuals; textures {} loaded, {} missing\n",
            sc.drawn_rooms, sc.rooms.len, sc.drawn_objects, sc.visuals.len, sc.materials.loaded, sc.materials.missing)
        _ = @fmt(&w.io, "sound: {} sounds started\n", amb.started)
        if timed > 1 {
            _ = @fmt(&w.io, "frames: {}, {} ms each on average, {} ms the slowest\n", timed, @as(f32, real_total * 1000.0 / @as(f64, timed - 1)), real_worst * 1000.0)
        }
        report::summary{ &w, routines = opts.report }
        return 0
    }

    // The front end (docs/design/gui.md, "The front end"): start-up movies and the main menu
    // through lib/frontend until New Game (its module's name, in the heap) or Quit (""). Headless,
    // the input script's `FRAME newgame` stands for the New Game button.
    fn front_end {
        mut sdl: sdl::Sdl, mut w: world::World, mut dev: gpu::Device, mut frame: render::Frame, mixer: *mut mix::Mixer,
        adev: ?*mut audio::Device, scratch: alloc::Bytes, opts: options::Options, script: []Scripted,
        mut next_line: usize, mut frame_no: u64,
    } -> ![]u8 {
        let mut cache = material::new_cache{ heap = w.heap, scratch }
        defer material::free_cache{ &cache, &dev }
        let mut g = try gui::make{ heap = w.heap, rm = w.rm.*, cache = &cache, width = @as(i32, opts.width), height = @as(i32, opts.height) }
        defer gui::free{ &g }
        let table = w.tlk
        if table != null { gui::set_tlk{ &g, table = &table } }
        try gui::load_defaults{ &g, fs = &w.fs, &dev }
        gui::set_cursor_visible{ &g, visible = not opts.headless }
        gui::set_mixer{ &g, mixer }
        let mut fe = frontend::make{ fs = &w.fs, heap = w.heap, game = opts.game, config_path = "kotor/out/kotor-settings.ini" }
        frontend::set_own_saves{ &fe, dir = opts.saves }
        fe.settings.disable_movies = fe.settings.disable_movies or opts.headless
        gui::set_screen{ &g, fs = &w.fs, &dev, width = @as(i32, opts.width), height = @as(i32, opts.height), scale = fe.settings.gui_scale }
        try frontend::begin{ &fe, &g, fs = &w.fs, &dev, &sdl, mixer }
        let freq = sdl::counter_frequency{ &sdl }
        let mut last = sdl::counter{ &sdl }
        let mut chosen: []u8 = ""
        let mut done = false
        while not done {
            frame_no = frame_no + 1
            if opts.frames > 0 and frame_no > opts.frames { break }
            while true {
                let ev = sdl::poll{ &sdl } ifnull { break }
                if ev is quit | close { done = true }
                _ = frontend::handle_event{ &fe, &g, ev, scale_x = 1.0, scale_y = 1.0 }
            }
            let mut forced = false
            let mut forced_player: []u8 = ""            // `newgame FILE`: the player blueprint to start with (tests)
            while next_line < script.len and script[next_line].frame <= frame_no {
                if script[next_line].command == Command::newgame {
                    forced = true
                    forced_player = script[next_line].key
                }
                next_line = next_line + 1
            }
            let now = sdl::counter{ &sdl }
            let real = @as(f32, @as(f64, now - last) / @as(f64, freq))
            last = now
            let dt = if opts.dt > 0.0 { opts.dt } else { math::min{ a = real, b = 0.25 } }
            match adev {
                some{ value } => { audio::update{ &sdl, dev = value, m = mixer } iferr {} }
                null => {}
            }
            gui::update{ &g, dt }
            let mut out = frontend::step{ &fe, &g, fs = &w.fs, &dev, &sdl, output = adev, mixer, dt }
            if forced {
                let blueprint = if forced_player.len > 0 {
                    fs::read_all(heap::Heap){ fs = &w.fs, heap = w.heap, realloc = heap::alloc, path = forced_player } iferr { slice::empty(u8){} }
                } else { slice::empty(u8){} }
                out = frontend::Outcome::new_game{ module = resref::truncate{ name = "end_m01aa" }, player = blueprint }
            }
            match out {
                running => {}
                new_game{ module, player } => {
                    // The character the player made (empty: the engine's default soldier).
                    try modload::set_player_blueprint{ &w, bytes = player }
                    let mut m = module
                    let name = resref::bytes{ r = &m }
                    let kept = try alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = slice::empty(u8){}, count = name.len }
                    slice::copy(u8){ dst = kept, src = name }
                    chosen = kept
                    done = true
                }
                load_game{ folder, folder_len } => {
                    let name = folder
                    let found = save::find_save{ &w, game = opts.game, name = name[..folder_len] }
                    if found != null {
                        // "load:" + the folder, for run to load instead of entering a module.
                        let tagged = try alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap, mem = slice::empty(u8){}, count = found.len + 5 }
                        slice::copy(u8){ dst = tagged[..5], src = "load:" }
                        slice::copy(u8){ dst = tagged[5..], src = found }
                        chosen = tagged
                    } else {
                        _ = @fmt(&w.io, "kotor: no save {}\n", name[..folder_len])
                        chosen = "end_m01aa"
                    }
                    done = true
                }
                quit => { done = true }
            }
            render::begin_frame{ &frame, time = 0.0 }
            frontend::draw{ &fe, &g, &frame, target = gpu::screen_size{ dev } }
            gpu::submit{ &dev, frame = &frame } iferr { done = true }
            let mut s: usize = 0
            while s < opts.shot_count {
                if opts.shots[s].frame == frame_no { try screenshot{ &w, &dev, heap = w.scratch, path = opts.shots[s].path, frame_no } }
                s = s + 1
            }
            if not opts.headless { gpu::present{ &dev, &sdl } }
        }
        frontend::leave{ &fe, &g, &dev, mixer }
        return chosen
    }

    // How high above the leader's feet the camera looks (ours: a humanoid's head; the original
    // takes the HEAD_G node's height plus appearance.2da CameraHeightOffset).
    fn leader_height { w: *world::World } -> f32 {
        let o = world::object{ w, id = w.pc } ifnull { return 1.6 }
        let c = obj::creature{ o } ifnull { return 1.6 }
        let offset = twoda::get_float{ t = w.tables.appearance, row = @as(usize, c.appearance), column = "cameraheightoffset" } ifnull 0.0
        return 1.6 + offset
    }

    fn apply_key { mut keys: ctl::Keys, keycode: i32, down: bool } {
        if keycode == 'w' or keycode == sdl::key::UP { keys.forward = down }
        else if keycode == 's' or keycode == sdl::key::DOWN { keys.back = down }
        else if keycode == 'z' { keys.strafe_left = down }
        else if keycode == 'c' { keys.strafe_right = down }
        else if keycode == 'a' or keycode == sdl::key::LEFT { keys.turn_left = down }
        else if keycode == 'd' or keycode == sdl::key::RIGHT { keys.turn_right = down }
        else if keycode == 'r' or keycode == sdl::key::SPACE { if down { keys.action = true } }
    }

    // A key's SDL keycode by the name the input script uses (a letter, `up`, `space`, ...).
    fn keycode_of { name: []u8 } -> i32 {
        if name.len == 1 { return @as(i32, ascii::to_lower{ c = name[0] }) }
        if ci::eq{ a = name, b = "up" } { return sdl::key::UP }
        if ci::eq{ a = name, b = "down" } { return sdl::key::DOWN }
        if ci::eq{ a = name, b = "left" } { return sdl::key::LEFT }
        if ci::eq{ a = name, b = "right" } { return sdl::key::RIGHT }
        if ci::eq{ a = name, b = "space" } { return sdl::key::SPACE }
        if ci::eq{ a = name, b = "escape" } { return sdl::key::ESCAPE }
        return 0
    }

    // The input script (`FRAME down KEY` / `FRAME up KEY` per line, # comments), in frame order.
    fn read_script { mut w: world::World, path: []u8 } -> ![]Scripted {
        if path.len == 0 { return slice::empty(Scripted){} }
        let bytes = try fs::read_all(heap::Heap){ fs = &w.fs, heap = w.heap, realloc = heap::alloc, path }
        let mut out = list::new(Scripted, heap::Heap){ realloc = heap::alloc, heap = w.heap }
        let mut lines = text::Lines{ data = bytes, pos = 0 }
        while true {
            let line = text::next_line{ &lines } ifnull { break }
            let mut words = text::Words{ s = line, pos = 0 }
            let f = text::next_word{ &words } ifnull { continue }
            if f.len == 0 or f[0] == '#' { continue }
            let what = text::next_word{ &words } ifnull { continue }
            let command = if ci::eq{ a = what, b = "down" } { Command::down } else if ci::eq{ a = what, b = "warp" } { Command::warp } else if ci::eq{ a = what, b = "warpxy" } { Command::warpxy }
                else if ci::eq{ a = what, b = "use" } { Command::use } else if ci::eq{ a = what, b = "newgame" } { Command::newgame }
                else if ci::eq{ a = what, b = "ui" } { Command::ui } else if ci::eq{ a = what, b = "save" } { Command::save } else if ci::eq{ a = what, b = "talk" } { Command::talk }
                else if ci::eq{ a = what, b = "load" } { Command::load } else if ci::eq{ a = what, b = "attack" } { Command::attack }
                else if ci::eq{ a = what, b = "hush" } { Command::hush } else if ci::eq{ a = what, b = "drop" } { Command::drop }
                else if ci::eq{ a = what, b = "gunner" } { Command::gunner } else if ci::eq{ a = what, b = "mouse" } { Command::mouse } else if ci::eq{ a = what, b = "pause" } { Command::pause } else { Command::up }
            // `ui`, `talk`, `load` and `save` take the rest of the line; the others one word.
            let key = if command == Command::ui or command == Command::load or command == Command::save or command == Command::talk or command == Command::mouse { text::rest{ words } } else { text::next_word{ &words } ifnull "" }
            try list::push{ list = &out, item = Scripted{ frame = @as(u64, text::scan_decimal{ s = f }), command, key } }
        }
        return list::items{ list = out }
    }

    // `FRAME talk RESREF [TAG]`: starts conversation RESREF with the creature tagged TAG
    // (end_trask by default) as its owner, without the click and the walk up: the dialogue on its
    // own, for tests.
    fn talk_to { mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, text: []u8 } {
        let mut words = text::words{ s = text }
        let name = text::next_word{ &words } ifnull { return }
        let tag = text::next_word{ &words } ifnull "end_trask"
        let owner = world::object_by_tag{ w = &w, tag, nth = 0 }
        if owner == obj::INVALID { return }
        // A conversation already running is cut short.
        dlg::abort{ &w, &vm, engine }
        w.conversation.pending = false
        if not dlg::order{ &w } { return }
        if not dlg::start{ &w, &vm, engine, owner, other = w.pc, name = resref::truncate{ name }, private = false } {
            w.conversation.pending = false
        }
    }

    // Test helpers for scripted runs: jump the leader 1.5 m in front of a tagged object, facing
    // it; queue the leader's default action on it.
    fn warp_to { mut w: world::World, tag: []u8 } {
        let id = world::object_by_tag{ w = &w, tag, nth = 0 }
        let o = world::object{ w = &w, id } ifnull {
            _ = @fmt(&w.io, "warp: no {}\n", tag)
            return
        }
        let at = math::vec3::add_scaled{ a = o.position, b = o.orientation, s = 1.5 }
        let face = math::vec3::negate{ v = o.orientation }
        movement::place{ &w, id = w.pc, at }
        let pc = world::object{ w = &w, id = w.pc } ifnull { return }
        world::set_orientation{ o = pc, v = face }
        _ = @fmt(&w.io, "warp: to {} ({} {} {})\n", tag, pc.position.x, pc.position.y, pc.position.z)
    }

    // `FRAME warpxy X,Y`: the leader onto the walkmesh at (X, Y).
    fn warp_xy { mut w: world::World, at: []u8 } {
        let comma = text::find_byte{ s = at, c = ',' } ifnull { return }
        let x = text::scan_f32{ s = at[..comma] } ifnull { return }
        let y = text::scan_f32{ s = at[comma + 1..] } ifnull { return }
        let f = walkmap::floor_anywhere{ m = &w.walk, x, y }
        let z = if f != null { f.z } else { 0.0 }
        movement::place{ &w, id = w.pc, at = math::Vec3{ x, y, z } }
    }

    fn use_tagged { mut w: world::World, tag: []u8 } {
        let id = world::object_by_tag{ w = &w, tag, nth = 0 }
        let o = world::object{ w = &w, id } ifnull { return }
        let kind = match o.kind {
            door => { actions::Kind::open_door }
            placeable => { actions::Kind::use_object }
            else => { actions::Kind::dialog_object }
        }
        let mut a = actions::make{ kind }
        a.params[0] = actions::Param::object{ id }
        _ = actions::add{ &w, id = w.pc, action = a, force = false }
    }

    // `drop TEMPLATE`: an item 3 m in front of the leader on the ground, and the leader picks it up.
    fn drop_item { mut w: world::World, template: []u8 } {
        let me = world::object{ w = &w, id = w.pc } ifnull { return }
        let at = math::vec3::add_scaled{ a = me.position, b = me.orientation, s = 3.0 }
        let id = tmpl::spawn{ &w, kind = obj::Kind::item, template, position = at, orientation = me.orientation } iferr { return }
        let io = world::object{ w = &w, id } ifnull { return }
        io.area = me.area
        io.position = at
        let mut a = actions::make{ kind = actions::Kind::pickup_item }
        a.params[0] = actions::Param::object{ id }
        a.params[1] = actions::Param::object{ id = obj::INVALID }
        a.params[2] = actions::Param::int{ v = 0 }
        _ = actions::add{ &w, id = me.id, action = a, force = false }
    }

    fn camera_row_now { w: *world::World } -> u32 {
        let lead = party::leader{ w }
        let id = if lead == obj::INVALID { w.pc } else { lead }
        if world::object{ w, id } is some{ value = o } {
            if obj::creature{ o } is some{ value = c } { if c.in_combat and not c.dead { return 8 } }
        }
        let ao = world::object{ w, id = w.area } ifnull { return 0 }
        let a = obj::area{ o = ao } ifnull { return 0 }
        return a.camera_style
    }

    // `attack TAG`: the leader attacks the nearest live object with that tag.
    fn attack_tagged { mut w: world::World, tag: []u8 } {
        let lead = party::leader{ w = &w }
        let me = world::object{ w = &w, id = if lead == obj::INVALID { w.pc } else { lead } } ifnull { return }
        let mut best = obj::INVALID
        let mut best_d: f32 = 1000000.0
        let mut nth: i32 = 0
        while nth < 64 {
            let id = world::object_by_tag{ w = &w, tag, nth }
            nth = nth + 1
            let o = world::object{ w = &w, id } ifnull { break }
            if obj::creature{ o } is some{ value = c } { if c.dead { continue } }
            let d = math::vec3::distance{ a = o.position, b = me.position }
            if d < best_d {
                best = id
                best_d = d
            }
        }
        if best == obj::INVALID { return }
        let mut a = actions::make{ kind = actions::Kind::attack_object }
        a.params[0] = actions::Param::object{ id = best }
        _ = actions::add{ &w, id = me.id, action = a, force = false }
    }

    fn screenshot { mut w: world::World, mut dev: gpu::Device, mut heap: arena::Arena, path: []u8, frame_no: u64 } -> ! {
        let size = gpu::screen_size{ dev }
        let pixels = try alloc::resize(u8, arena::Arena){ realloc = arena::alloc, &heap, mem = slice::empty(u8){}, count = @as(usize, size.width) * @as(usize, size.height) * 4 }
        defer _ = alloc::resize(u8, arena::Arena){ realloc = arena::alloc, &heap, mem = pixels, count = 0 }
        _ = try gpu::read_screen{ &dev, into = pixels }
        let image = png::Image{ width = size.width, height = size.height, rgba = pixels }
        try png::save{ fs = &w.fs, realloc = arena::alloc, &heap, path, image, alpha = false, bottom_up = false }
        _ = @fmt(&w.io, "frame {}: wrote {} ({}x{})\n", frame_no, path, size.width, size.height)
    }
}
