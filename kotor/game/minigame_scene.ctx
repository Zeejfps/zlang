// The picture of a minigame (game/minigame.ctx is the logic): the models of the run's objects as
// scene parts, the camera on the player's `camerahook`, and a whole frame in place of the
// ordinary one.
//
// An item is one model instance on the stage. The run's objects bring their models (a race's
// bike and HUD, a turret's cockpit, a fighter); the turret's gun models hang on the vehicle's
// `gunbank<id>` nodes; bullets take an item each when they are first fired (a few models, many
// shots), and every item with emitters keeps its particles.
namespace mg_game {
    const MAX_ITEMS: usize = 256
    // The speed blur's strength per unit of the run's ratio. Ours: the original's blur is a
    // feedback of the last frames (ratio = how much of them stays), ours a radial blur whose
    // strength 0.35 is the haste's; the script default 0.75 gives about that.
    const BLUR_SCALE: f32 = 0.5

    enum ItemKind: u8 { model, gun, bullet }

    // A model instance of a run object: a scene part, and the object it belongs to.
    struct Item {
        part: usize, object: u32, kind: ItemKind,
        rotating: bool,                 // turns with the aim (a turret's cockpit)
        camera: bool,                   // the camera sits at its `camerahook`
        visible: bool,
        bank: i32,                      // a gun: which bank
        parent: i32,                    // a gun: the item it hangs on, at node `node`
        node: i32,
        slot: i32,                      // a bullet: its place in the run's list
        serial: u32,                    // a bullet: the shot it shows
        exploding: bool,
        name: resref::ResRef,
        instance: math::Mat4,           // where the model stands this frame
        emitting: []mut gui3d::Emitting,
    }

    // `ended`: a script called EndGame (the Hawk was lost); the loop stops, there being no end-game
    // screen or start screen to go back to yet. `pause_panel`: the `pause` banner while paused, 0
    // when not shown. `blur`: the speed blur drawn now, easing toward what the run asks for.
    struct Stage { ready: bool, items: []mut Item, count: usize, anims: []mut Anim, music_started: bool, relative_mouse: bool, ended: bool, paused: bool, pause_panel: u32, blur: f32 }

    fn make_stage {} -> Stage {
        return Stage{ ready = false, items = slice::empty(Item){}, count = 0, anims = slice::empty(Anim){}, music_started = false, relative_mouse = false, ended = false, paused = false, pause_panel = 0, blur = 0.0 }
    }

    // Whether the world is in a minigame area with a run.
    fn active { w: *world::World } -> bool { return w.minigame != null }

    // What the player does with the mouse and the fire keys between frames, whether Escape has
    // paused the game, and whether a gunner (turret) or racer (swoop) bot plays (headless tests:
    // `FRAME gunner` or `FRAME racer` in the input script). `reverse_y`: the Reverse Minigame YAxis
    // option (play.ctx sets it from the options each frame).
    struct Mouse { dx: i32, dy: i32, fire_key: bool, fire_button: bool, auto: bool, paused: bool, reverse_y: bool }

    fn make_mouse {} -> Mouse { return Mouse{ dx = 0, dy = 0, fire_key = false, fire_button = false, auto = false, paused = false, reverse_y = false } }

    // The input script's lines for a minigame (play.ctx hands each line to every owner in turn):
    // `gunner`, `mouse DX DY` (the mouse moves by those counts) and `pause`. True if `word` is one.
    fn handle_scripted { mut m: Mouse, word: []u8, rest: []u8 } -> bool {
        if ci::eq{ a = word, b = "gunner" } or ci::eq{ a = word, b = "racer" } { m.auto = true }
        else if ci::eq{ a = word, b = "pause" } { m.paused = not m.paused }
        else if ci::eq{ a = word, b = "mouse" } {
            let mut words = text::words{ s = rest }
            m.dx = m.dx + @trunc(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            m.dy = m.dy + @trunc(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
        } else { return false }
        return true
    }

    // Takes the events that are the turret's: relative mouse motion, the left button and the fire
    // key held. True if it used the event.
    fn handle_event { mut m: Mouse, ev: sdl::Event } -> bool {
        match ev {
            mouse_motion{ dx, dy } => {
                m.dx = m.dx + dx
                m.dy = m.dy + dy
                return true
            }
            mouse_button{ down, button } => {
                if button == 1 {
                    m.fire_button = down
                    return true
                }
            }
            key{ down, repeat, keycode } => {
                // the key still goes to the game's keys; this only remembers it is held
                if keycode == sdl::key::SPACE { m.fire_key = down }
                // Escape pauses and resumes (the original's PauseMinigame, which is its Pause: the banner shows)
                if keycode == sdl::key::ESCAPE {
                    if down and not repeat { m.paused = not m.paused }
                    return true
                }
            }
            else => {}
        }
        return false
    }

    // ---- building the stage

    // Loads `name` as a part of the stage with its particle emitters; its item index, or null if
    // there is no such model.
    fn add_item {
        mut stage: Stage, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device,
        name: []u8, object: u32, kind: ItemKind, rotating: bool,
    } -> !?usize {
        if stage.count >= MAX_ITEMS { return null }
        let loaded = try scene::load_model{ &sc, &w, &dev, name, body_texture = "", envmap = "", hide_null = false }
        if loaded == null { return null }
        let part = try scene::add_part{ &sc, loaded, parent = -1, hook = "" }
        let model = scene::loaded_at{ sc = &sc, i = loaded }.model
        let emitting = try alloc::resize(gui3d::Emitting, arena::Arena){ realloc = arena::alloc, heap = sc.arena, mem = slice::empty(gui3d::Emitting){}, count = model.emitters.len }
        let mut e: usize = 0
        while e < emitting.len {
            emitting[e] = try gui3d::make_emitting{ fs = &w.fs, dev = &dev, heap = sc.arena, mats = &sc.materials, rm = w.rm.*, model, index = @as(u32, e) }
            // The objects there before the first picture run 10 s ahead in it, as every emitter on the
            // original's scene list does (docs/re/particles.md, "Which emitters run").
            emitting[e].warm = not stage.ready
            e = e + 1
        }
        let i = stage.count
        stage.anims[i] = make_anim{}
        if scene::binding_for{ &sc, &w, model, source = null, name = "ready" } is some{ value = b } {
            start_layer{ a = &stage.anims[i], layer = make_layer{ name = "ready", binding = b, looping = true }, queue = false, overlay = false }
        }
        stage.items[i] = Item{
            part, object, kind, rotating, camera = false, visible = true, bank = -1, parent = -1, node = -1, slot = -1, serial = 0,
            exploding = false, name = resref::truncate{ name }, instance = math::mat4::identity{}, emitting,
        }
        stage.count = i + 1
        return i
    }

    // The model items of one object, then its gun models on their banks' nodes.
    fn add_object {
        mut stage: Stage, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, run: *mg::Run, n: usize,
    } -> ! {
        let o = run.objs[n]
        let first = stage.count
        if o.kind == mg::ObjKind::obstacle {
            let mut name = o.name
            _ = try add_item{ &stage, &sc, &w, &dev, name = resref::bytes{ r = &name }, object = mg::id_of{ n }, kind = ItemKind::model, rotating = false }
            return
        }
        let f = if o.kind == mg::ObjKind::player { &run.area.player } else { &run.area.enemies[o.index] }
        let mut k: usize = 0
        while k < f.model_count {
            let mut name = f.models[k].name
            _ = try add_item{ &stage, &sc, &w, &dev, name = resref::bytes{ r = &name }, object = mg::id_of{ n }, kind = ItemKind::model, rotating = f.models[k].rotating }
            k = k + 1
        }
        // a turret's camera model is its own field, turning with the aim if the area says so
        if o.kind == mg::ObjKind::player and not resref::is_empty{ r = f.camera } {
            let mut name = f.camera
            let at = try add_item{ &stage, &sc, &w, &dev, name = resref::bytes{ r = &name }, object = mg::id_of{ n }, kind = ItemKind::model, rotating = f.camera_rotate }
            if at is some{ value = i } { stage.items[i].camera = true }
        }
        if o.kind == mg::ObjKind::player and run.area.kind == mg::SWOOP {
            let mut i = first
            while i < stage.count {
                let model = scene::loaded_at{ sc = &sc, i = scene::part_at{ sc = &sc, i = stage.items[i].part }.loaded }.model
                if mdl::find_node{ model, name = "camerahook" } != null {
                    stage.items[i].camera = true
                    break
                }
                i = i + 1
            }
        }
        // guns
        let mut b: usize = 0
        while b < f.bank_count and n < run.gears.len {
            if run.gears[n].banks[b].ready and not resref::is_empty{ r = f.banks[b].gun_model } {
                // the vehicle's model that has the node gunbank<id>
                let mut host: i32 = -1
                let mut node: i32 = -1
                let mut i = first
                while i < stage.count and host < 0 {
                    if stage.items[i].kind == ItemKind::model {
                        let model = scene::loaded_at{ sc = &sc, i = scene::part_at{ sc = &sc, i = stage.items[i].part }.loaded }.model
                        if mg::find_numbered{ model, prefix = "gunbank", n = f.banks[b].id } is some{ value = nd } {
                            host = @as(i32, i)
                            node = @as(i32, nd)
                        }
                    }
                    i = i + 1
                }
                if host >= 0 {
                    let mut name = f.banks[b].gun_model
                    let at = try add_item{ &stage, &sc, &w, &dev, name = resref::bytes{ r = &name }, object = mg::id_of{ n }, kind = ItemKind::gun, rotating = stage.items[@as(usize, host)].rotating }
                    if at is some{ value = gi } {
                        stage.items[gi].bank = @as(i32, b)
                        stage.items[gi].parent = host
                        stage.items[gi].node = node
                    }
                }
            }
            b = b + 1
        }
    }

    // Loads the models of every object of the run into the scene as parts.
    fn build_stage { mut stage: Stage, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device } -> ! {
        let run = w.minigame ifnull { return }
        stage.count = 0
        stage.items = try alloc::resize(Item, arena::Arena){ realloc = arena::alloc, heap = w.mod_arena, mem = slice::empty(Item){}, count = MAX_ITEMS }
        stage.anims = try alloc::resize(Anim, arena::Arena){ realloc = arena::alloc, heap = w.mod_arena, mem = slice::empty(Anim){}, count = MAX_ITEMS }
        let mut n: usize = 0
        while n < run.count {
            try add_object{ &stage, &sc, &w, &dev, run, n }
            n = n + 1
        }
        stage.ready = true
    }

    // The item that shows bullet `slot` with model `name`, made when the shot is first seen.
    fn bullet_item { mut stage: Stage, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, slot: usize, name: resref::ResRef } -> !?usize {
        let mut i: usize = 0
        while i < stage.count {
            if stage.items[i].kind == ItemKind::bullet and stage.items[i].slot == @as(i32, slot) and resref::eq{ a = stage.items[i].name, b = name } { return i }
            i = i + 1
        }
        let mut copy = name
        let at = try add_item{ &stage, &sc, &w, &dev, name = resref::bytes{ r = &copy }, object = 0, kind = ItemKind::bullet, rotating = false }
        if at is some{ value = k } {
            stage.items[k].slot = @as(i32, slot)
            stage.items[k].visible = false
        }
        return at
    }

    // ---- placing

    // Where a bullet stands: its model's +Y along its way.
    fn bullet_matrix { b: *mg::Bullet } -> math::Mat4 {
        let y = b.direction
        let up = if math::abs{ x = y.z } > 0.95 { math::Vec3{ x = 1.0, y = 0.0, z = 0.0 } } else { math::Vec3{ x = 0.0, y = 0.0, z = 1.0 } }
        let x = math::vec3::normalize{ v = math::vec3::cross{ a = y, b = up } }
        let z = math::vec3::cross{ a = x, b = y }
        let mut m = math::mat4::identity{}
        m.m[0] = x.x
        m.m[1] = x.y
        m.m[2] = x.z
        m.m[4] = y.x
        m.m[5] = y.y
        m.m[6] = y.z
        m.m[8] = z.x
        m.m[9] = z.y
        m.m[10] = z.z
        m.m[12] = b.position.x
        m.m[13] = b.position.y
        m.m[14] = b.position.z
        return m
    }

    // The transform of every visible item this frame, parents first.
    fn place_items { mut stage: Stage, sc: *scene::Scene, run: *mg::Run } {
        let mut i: usize = 0
        while i < stage.count {
            let it = &stage.items[i]
            i = i + 1
            if not it.visible { continue }
            if it.kind == ItemKind::model {
                let n = mg::slot_of{ run, id = it.object } ifnull { continue }
                it.instance = mg::part_matrix{ run, n, rotating = it.rotating }
            } else if it.kind == ItemKind::gun {
                let parent = &stage.items[@as(usize, it.parent)]
                let pp = scene::part_at{ sc, i = parent.part }
                it.instance = math::mat4::mul{ a = parent.instance, b = pp.pose.world[@as(usize, it.node)] }
            } else {
                it.instance = bullet_matrix{ b = &run.bullets[@as(usize, it.slot)] }
            }
        }
    }

    // The camera of the run: the player's camera model's `camerahook`, through the ARE's lens.
    fn camera_of { run: *mg::Run, sc: *scene::Scene, stage: *Stage, aspect: f32 } -> render::Camera {
        let area = run.area
        let mut world_view = math::mat4::identity{}
        let mut i: usize = 0
        while i < stage.count {
            if stage.items[i].camera {
                let p = scene::part_at{ sc, i = stage.items[i].part }
                let model = scene::loaded_at{ sc, i = p.loaded }.model
                let hook = mdl::find_node{ model, name = "camerahook" } ifnull { 0 }
                world_view = math::mat4::mul{ a = stage.items[i].instance, b = p.pose.world[hook] }
                break
            }
            i = i + 1
        }
        let eye = math::mat4::get_translation{ m = world_view }
        let view = math::mat4::inverse_affine{ m = world_view }
        return render::Camera{
            view,
            proj = math::mat4::perspective{ fovy = math::radians{ degrees = area.fov }, aspect, near = area.near_clip, far = area.far_clip },
            eye,
        }
    }

    // ---- drawing

    // Adds the draws, lights and particles of every visible item.
    fn draw_stage { sc: *scene::Scene, mut stage: Stage, mut frame: render::Frame, view: u32 } {
        let mut i: usize = 0
        while i < stage.count {
            let it = &stage.items[i]
            i = i + 1
            if not it.visible { continue }
            let p = scene::part_at{ sc, i = it.part }
            let l = scene::loaded_at{ sc, i = p.loaded }
            scene::add_lights{ &frame, model = l.model, pose = p.pose, instance = it.instance }
            _ = mdl_render::add_draws{ &frame, view, model = l.model, pose = p.pose, g = l.gpu, transform = it.instance, materials = l.materials, time = sc.time }
            let mut e: usize = 0
            while e < it.emitting.len {
                let em = &it.emitting[e]
                let emitter = &l.model.emitters[e]
                e = e + 1
                let n = gui3d::fill_particles{ em, e = emitter, props = p.pose.emitters[e - 1] }
                if n == 0 { continue }
                let node_world = math::mat4::mul{ a = it.instance, b = p.pose.world[emitter.node] }
                let look = gui3d::look_of{ e = emitter, world = node_world }
                render::add_emitter{ &frame, emitter = render::Emitter{
                    view, texture = em.texture, blend = look.blend, grid_x = emitter.x_grid, grid_y = emitter.y_grid,
                    facing = look.facing, axis = look.axis, transform = node_world, first = 0, count = 0, effect = true,
                    fog = true, sort = @as(i32, emitter.render_order),
                }, particles = em.out[..@as(usize, n)] }
            }
        }
    }

    // The player's controls from the game's keys, the mouse and, for a test, the gunner bot.
    fn read_input { keys: ctl::Keys, mut mouse: Mouse, run: *mg::Run } -> mg::Input {
        let left = keys.turn_left or keys.strafe_left
        let right = keys.turn_right or keys.strafe_right
        let mut input = mg::Input{
            x = (if right { 1.0 } else { 0.0 }) - (if left { 1.0 } else { 0.0 }),
            y = (if keys.forward { 1.0 } else { 0.0 }) - (if keys.back { 1.0 } else { 0.0 }),
            fire = keys.action or mouse.fire_key or mouse.fire_button, aim_x = @as(f32, mouse.dx), aim_y = @as(f32, mouse.dy),
        }
        mouse.dx = 0
        mouse.dy = 0
        // Reverse Minigame YAxis turns the vertical axis over, the keys' and the mouse's alike
        // (client options +8 bit 3; only the turret has a vertical axis).
        if mouse.reverse_y {
            input.y = -input.y
            input.aim_y = -input.aim_y
        }
        if mouse.auto {
            input = if run.area.kind == mg::TURRET { mg::gunner_input{ run } } else { mg::racer_input{ run } }
        }
        return input
    }

    // ---- animations

    // Starts and stops the animations the scripts asked for, shows the bullets, then advances
    // every item's pose and particles.
    fn advance_stage {
        mut stage: Stage, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, run: *mut mg::Run, dt: f32,
    } -> ! {
        while true {
            let r = mg::take_request{ run } ifnull { break }
            let mut i: usize = 0
            while i < stage.count {
                let it = &stage.items[i]
                let mine = if r.gun >= 0 { it.kind == ItemKind::gun and it.bank == r.gun and it.object == r.object } else { it.kind == ItemKind::model and it.object == r.object }
                if mine {
                    if r.remove {
                        remove_layer{ a = &stage.anims[i], name = r.name[..r.name_len] }
                    } else {
                        let p = scene::part_at{ sc = &sc, i = it.part }
                        let model = scene::loaded_at{ sc = &sc, i = p.loaded }.model
                        if scene::binding_for{ &sc, &w, model, source = null, name = r.name[..r.name_len] } is some{ value = b } {
                            start_layer{ a = &stage.anims[i], layer = make_layer{ name = r.name[..r.name_len], binding = b, looping = r.looping }, queue = r.queue, overlay = r.overlay }
                        }
                    }
                }
                i = i + 1
            }
        }
        // what is shown: objects until they are removed, guns with them, bullets while they fly or burst
        let mut i: usize = 0
        while i < stage.count {
            let it = &stage.items[i]
            if it.kind != ItemKind::bullet {
                if mg::slot_of{ run, id = it.object } is some{ value = n } { it.visible = not run.objs[n].removed }
            }
            i = i + 1
        }
        let mut s: usize = 0
        while s < mg::MAX_BULLETS {
            let bl = run.bullets[s]
            let mut k: usize = 0
            while k < stage.count {
                if stage.items[k].kind == ItemKind::bullet and stage.items[k].slot == @as(i32, s) { stage.items[k].visible = false }
                k = k + 1
            }
            if bl.live and not resref::is_empty{ r = bl.model } {
                let at = try bullet_item{ &stage, &sc, &w, &dev, slot = s, name = bl.model }
                if at is some{ value = k2 } {
                    let it = &stage.items[k2]
                    it.visible = true
                    let p = scene::part_at{ sc = &sc, i = it.part }
                    let model = scene::loaded_at{ sc = &sc, i = p.loaded }.model
                    if it.serial != bl.serial {
                        // a new shot in a used slot: start over
                        it.serial = bl.serial
                        it.exploding = false
                        stage.anims[k2] = make_anim{}
                        if scene::binding_for{ &sc, &w, model, source = null, name = "ready" } is some{ value = b } {
                            start_layer{ a = &stage.anims[k2], layer = make_layer{ name = "ready", binding = b, looping = true }, queue = false, overlay = false }
                        }
                        let mut e: usize = 0
                        while e < it.emitting.len {
                            gui3d::restart{ em = &it.emitting[e] }
                            e = e + 1
                        }
                    }
                    if bl.exploding and not it.exploding {
                        it.exploding = true
                        if scene::binding_for{ &sc, &w, model, source = null, name = "explode" } is some{ value = b } {
                            start_layer{ a = &stage.anims[k2], layer = make_layer{ name = "explode", binding = b, looping = false }, queue = false, overlay = false }
                        }
                    }
                }
            }
            s = s + 1
        }
        i = 0
        while i < stage.count {
            let it = &stage.items[i]
            if it.visible {
                let p = scene::part_at{ sc = &sc, i = it.part }
                let model = scene::loaded_at{ sc = &sc, i = p.loaded }.model
                pose_anim{ a = &stage.anims[i], model, pose = p.pose, dt }
                let mut e: usize = 0
                while e < it.emitting.len {
                    let world = math::mat4::mul{ a = it.instance, b = p.pose.world[model.emitters[e].node] }
                    if gui3d::targeted{ e = &model.emitters[e] } { it.emitting[e].aim = gui3d::target_of{ model, e = &model.emitters[e], pose_world = p.pose.world, instance = it.instance } }
                    if it.emitting[e].warm {
                        it.emitting[e].warm = false
                        let mut k: u32 = 0
                        while k < 100 {
                            gui3d::step_emitting{ em = &it.emitting[e], e = &model.emitters[e], props = p.pose.emitters[e], dt = gui3d::MAX_STEP, world, owner = math::mat4::get_translation{ m = it.instance }, ground = gui3d::no_contact }
                            k = k + 1
                        }
                    }
                    gui3d::step_emitting{ em = &it.emitting[e], e = &model.emitters[e], props = p.pose.emitters[e], dt = math::min{ a = dt, b = gui3d::MAX_STEP }, world, owner = math::mat4::get_translation{ m = it.instance }, ground = gui3d::no_contact }
                    e = e + 1
                }
            }
            i = i + 1
        }
    }

    // ---- sound

    // Starts the sounds the run raised: its shots, hits and explosions, one-shot waves through the
    // ambience's cache. Fighters' are heard from where they are.
    fn play_sounds { mut run: mg::Run, mut amb: ambience::Ambience, mut w: world::World, mixer: *mut mix::Mixer } {
        while true {
            let s = mg::take_sound{ &run } ifnull { break }
            let bytes = ambience::wave{ a = &amb, &w, name = s.name }
            if bytes.len == 0 { continue }
            let p = if s.positional {
                mix::sound_3d{ group = mix::Group::sfx, volume = s.volume, position = s.position, min_distance = 60.0, max_distance = 900.0 }
            } else {
                mix::sound_2d{ group = mix::Group::sfx, volume = s.volume }
            }
            _ = mix::play{ m = mixer, bytes, p } iferr { mix::Handle{ slot = 0, id = 0 } }
            amb.started = amb.started + 1
        }
    }

    // The area's own music (the ARE's `Music`, a file of streammusic), looping.
    fn start_music { mut stage: Stage, run: *mg::Run, mut amb: ambience::Ambience, mut w: world::World, mixer: *mut mix::Mixer } {
        if stage.music_started { return }
        stage.music_started = true
        let mut name = run.area.music
        if resref::is_empty{ r = name } { return }
        let bytes = ambience::read_stream{ a = &amb, &w, name = resref::bytes{ r = &name } }
        if bytes.len == 0 { return }
        let mut p = mix::sound_2d{ group = mix::Group::music, volume = 0.5 }
        p.looping = true
        _ = mix::play{ m = mixer, bytes, p } iferr { mix::Handle{ slot = 0, id = 0 } }
        amb.started = amb.started + 1
    }

    // ---- pause

    // Pauses or resumes: time stands still, the sounds hold, and the `pause` banner shows as the
    // player's pause shows it (PauseMinigame is handled as Pause, `HandleInputAction` 0x00621210
    // case 0xfd). The turret gives the pointer back while paused (the original stops recentring it).
    fn set_paused { mut stage: Stage, mut sdl: sdl::Sdl, mut w: world::World, mut dev: gpu::Device, mut g: gui::Gui, mixer: *mut mix::Mixer, on: bool } {
        stage.paused = on
        mix::set_group_paused{ m = mixer, group = mix::Group::sfx, paused = on }
        mix::set_group_paused{ m = mixer, group = mix::Group::music, paused = on }
        if stage.relative_mouse { sdl::set_relative_mouse{ &sdl, on = not on } iferr {} }
        if on and stage.pause_panel == 0 {
            let p = gui::open{ &g, fs = &w.fs, &dev, name = "pause", mode = gui::Mode::placed, modal = false } iferr { 0 }
            stage.pause_panel = p
            let pp = gui::find_panel{ &g, id = p } ifnull { return }
            pp.x = (g.ui_w - pp.w) / 2
            pp.y = g.ui_h / 6
            gui::place{ &g, p = pp }
            gui::set_strref{ &g, panel = p, tag = "LBL_PAUSEREASON", strref = ingame::REASON_PAUSED } iferr {}
        } else if not on and stage.pause_panel != 0 {
            gui::close{ &g, id = stage.pause_panel }
            stage.pause_panel = 0
        }
    }

    // One whole frame of a minigame, in place of the ordinary frame (game/play.ctx calls it where
    // the step begins): the world, the run and its scripts, the sound, the picture. Returns true
    // when a module change is pending: nothing was drawn and the ordinary frame must go on.
    fn frame {
        mut sdl: sdl::Sdl, mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, mut dev: gpu::Device, mut frame: render::Frame,
        mut sc: scene::Scene, mut stage: Stage, mut amb: ambience::Ambience, mixer: *mut mix::Mixer, adev: ?*mut audio::Device,
        silent: []mut i16, rate: u32, opts: options::Options, keys: ctl::Keys, mut mouse: Mouse, dt: f32, frame_no: u64, shot_heap: *mut arena::Arena,
        mut dview: dlgview::View, mut g: gui::Gui, mut disp: display::Display,
    } -> !bool {
        // paused: time stands still, the picture stays, the sounds hold
        let dt = if mouse.paused { 0.0 } else { dt }
        if mouse.paused != stage.paused { set_paused{ &stage, &sdl, &w, &dev, &g, mixer, on = mouse.paused } }
        clock::advance{ c = &w.clock, seconds = dt }
        world::tick{ &w, &vm, engine }
        let run = w.minigame ifnull { return true }
        if not stage.ready {
            try build_stage{ &stage, &sc, &w, &dev }
            // a turret is aimed with the mouse: it is held in the window and only moves the aim
            if run.area.kind == mg::TURRET and not opts.headless {
                sdl::set_relative_mouse{ &sdl, on = true } iferr {}
                stage.relative_mouse = true
            }
            start_music{ &stage, run, &amb, &w, mixer }
        }
        run.input = read_input{ keys, &mouse, run }
        if mouse.paused { run.input = mg::Input{ x = 0.0, y = 0.0, fire = false, aim_x = 0.0, aim_y = 0.0 } }
        step{ &w, &vm, engine, dt }
        if w.transition != null {
            if stage.paused {
                mouse.paused = false
                set_paused{ &stage, &sdl, &w, &dev, &g, mixer, on = false }
            }
            if stage.relative_mouse {
                sdl::set_relative_mouse{ &sdl, on = false } iferr {}
                stage.relative_mouse = false
            }
            return true
        }
        let notes = outbox::notes{ out = &w.out }
        let mut n: usize = 0
        while n < notes.len {
            ambience::take{ a = &amb, &w, note = notes[n] }
            dlgview::take_note{ v = &dview, w = &w, g = &g, dev = &dev, note = notes[n] }    // fades
            if notes[n] is end_game{ show_gui } { stage.ended = true }
            n = n + 1
        }
        outbox::clear{ out = &w.out }
        play_sounds{ run, &amb, &w, mixer }
        scene::sync{ &sc, &w, &dev, dt }
        dlgview::pre_sync{ v = &dview, w = &w, sc = &sc, dev = &dev, g = &g, dt }    // steps the fade
        // The stage shows the run's objects only: no creature stands in a turret or on a bike's
        // track (the engine still has a player character in the area, the original has none).
        let visuals = list::items{ list = sc.visuals }
        let mut v: usize = 0
        while v < visuals.len {
            visuals[v].alive = false
            v = v + 1
        }
        try advance_stage{ &stage, &sc, &w, &dev, run, dt }
        place_items{ &stage, sc = &sc, run }
        let size = gpu::screen_size{ dev }
        let aspect = @as(f32, size.width) / @as(f32, size.height)
        let cam = camera_of{ run, sc = &sc, stage = &stage, aspect }
        let facing = math::mat4::transform_dir{ m = math::mat4::inverse_affine{ m = cam.view }, v = math::Vec3{ x = 0.0, y = 0.0, z = -1.0 } }
        ambience::update{ a = &amb, &w, eye = cam.eye, forward = math::vec3::normalize{ v = facing }, dt }
        match adev {
            some{ value } => { audio::update{ &sdl, dev = value, m = mixer } iferr {} }
            null => {
                let frames = math::min{ a = @as(f32, rate) * dt, b = 22050.0 }
                mix::render{ m = mixer, into = silent[..@as(usize, frames) * 2] }
            }
        }
        if speed::picture_wanted{ opts, frame_no, saving = false } {
            render::begin_frame{ &frame, time = sc.time }
            let mut view = render::make_view{ camera = cam }
            // SWMG_SetSpeedBlurEffect: the renderer's speed blur (0x0044f0a0 on, 0x0044f0b0 off,
            // 0x0044f130 the ratio), drawn as the haste's radial blur (the Frame Buffer Effects
            // option, as there) at the run's ratio, eased in and out as the haste's is.
            let want = if run.blur_on { math::clamp{ x = run.blur_ratio, lo = 0.0, hi = 1.0 } * BLUR_SCALE } else { 0.0 }
            stage.blur = stage.blur + (want - stage.blur) * math::min{ a = 1.0, b = dt * 4.0 }
            view.blur = stage.blur
            view.ambient = sc.ambient
            view.fog = sc.fog
            let vi = render::add_view{ &frame, view } ifnull { 0 }
            scene::draw{ &sc, w = &w, &frame, view = vi }
            draw_stage{ sc = &sc, &stage, &frame, view = vi }
            dlgview::draw{ v = &dview, frame = &frame }
            if stage.pause_panel != 0 { gui::draw_lone_panel{ &g, &frame, id = stage.pause_panel } }
            gpu::submit{ &dev, frame = &frame } iferr err{ error } {
                _ = @fmt(&w.io, "kotor: submit failed: {}\n", error)
                return true
            }
        }
        let mut s: usize = 0
        while s < opts.shot_count {
            if opts.shots[s].frame == frame_no { try play::screenshot{ &w, &dev, heap = shot_heap, path = opts.shots[s].path, frame_no } }
            s = s + 1
        }
        if not opts.headless {
            gpu::present{ &dev, &sdl }
            display::limit_frame{ d = &disp, &sdl, fps = disp.applied.frame_limit }
            display::rest{ d = &disp, &sdl }
        }
        arena::reset{ heap = w.scratch }
        return false
    }
}
