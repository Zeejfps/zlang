// The input script's keyboard and mouse words (docs/testing.md, "Scripted input"). Each one puts
// the SDL event a person's hand would make on SDL's own queue, and the game loop reads it back
// out with every other event, so a scripted key or click goes through the same handlers as a real
// one: the conversation panels, the HUD and menus, then the world's keys.
//
//   FRAME key NAME                   a tap: down, then up (down w / up w, keydown / keyup: one half each)
//   FRAME mouse move X Y             the pointer to window pixel (X, Y)
//   FRAME mouse down [left|right] [X Y]    a button goes down (at the pointer, or after moving to X Y)
//   FRAME mouse up [left|right]            ... and up
//   FRAME mouse click [X Y] [left|right]   move, down, up
//   FRAME mouse wheel DY             the wheel, positive away from the user
//   FRAME ui move X Y | ui click X Y | ui key NAME | ui type TEXT      the older spellings of the above
//
// NAME is a letter or digit, up down left right space tab escape return backspace, f1..f12, ctrl,
// shift, caps (modifier keys set the modifier bits of the keys after them).
namespace inject {
    // Where the scripted pointer is and what is held, as a person's mouse and keyboard remember.
    struct Inputs { x: i32, y: i32, buttons: u32, mods: u16 }

    fn new_inputs {} -> Inputs { return Inputs{ x = 0, y = 0, buttons = 0, mods = 0 } }

    // An SDL keycode by the name scripts use; 0 for an unknown one.
    fn key_of { name: []u8 } -> i32 {
        if name.len == 1 { return @as(i32, ascii::to_lower{ c = name[0] }) }
        if ci::eq{ a = name, b = "escape" } or ci::eq{ a = name, b = "esc" } { return sdl::key::ESCAPE }
        if ci::eq{ a = name, b = "return" } or ci::eq{ a = name, b = "enter" } { return sdl::key::RETURN }
        if ci::eq{ a = name, b = "space" } { return sdl::key::SPACE }
        if ci::eq{ a = name, b = "tab" } { return sdl::key::TAB }
        if ci::eq{ a = name, b = "backspace" } { return sdl::key::BACKSPACE }
        if ci::eq{ a = name, b = "up" } { return sdl::key::UP }
        if ci::eq{ a = name, b = "down" } { return sdl::key::DOWN }
        if ci::eq{ a = name, b = "left" } { return sdl::key::LEFT }
        if ci::eq{ a = name, b = "right" } { return sdl::key::RIGHT }
        if ci::eq{ a = name, b = "ctrl" } { return sdl::key::LCTRL }
        if ci::eq{ a = name, b = "shift" } { return sdl::key::LSHIFT }
        if ci::eq{ a = name, b = "caps" } { return sdl::key::CAPSLOCK }
        if (name[0] == 'f' or name[0] == 'F') and name.len <= 3 {
            let n = @as(i32, text::scan_decimal{ s = name[1..] })
            if n >= 1 and n <= 12 { return sdl::key::F1 + n - 1 }
        }
        return 0
    }

    // The modifier bit a key sets while it is held; 0 for the other keys.
    fn mod_of { code: i32 } -> u16 {
        if code == sdl::key::LSHIFT { return sdl::KMOD_LSHIFT }
        if code == sdl::key::LCTRL { return sdl::KMOD_LCTRL }
        return 0
    }

    fn push_key { mut sdl: sdl::Sdl, mut inp: Inputs, code: i32, down: bool } {
        let bit = mod_of{ code }
        if down { inp.mods = inp.mods | bit } else { inp.mods = inp.mods - (inp.mods & bit) }
        _ = sdl::push{ &sdl, ev = sdl::Event::key{ down, repeat = false, scancode = 0, keycode = code, mods = inp.mods } }
    }

    fn push_move { mut sdl: sdl::Sdl, mut inp: Inputs, x: i32, y: i32 } {
        _ = sdl::push{ &sdl, ev = sdl::Event::mouse_motion{ x, y, dx = x - inp.x, dy = y - inp.y, buttons = inp.buttons } }
        inp.x = x
        inp.y = y
    }

    fn push_button { mut sdl: sdl::Sdl, mut inp: Inputs, button: u8, down: bool } {
        let bit: u32 = @as(u32, button)
        if down { inp.buttons = inp.buttons | bit } else { inp.buttons = inp.buttons - (inp.buttons & bit) }
        _ = sdl::push{ &sdl, ev = sdl::Event::mouse_button{ down, button, clicks = 1, x = inp.x, y = inp.y } }
    }

    fn button_of { word: []u8 } -> u8 {
        if ci::eq{ a = word, b = "right" } { return sdl::BUTTON_RIGHT }
        if ci::eq{ a = word, b = "middle" } { return sdl::BUTTON_MIDDLE }
        return sdl::BUTTON_LEFT
    }

    // The scripted line `word rest`; true when it was one of these words (events were pushed, and
    // the loop should read them now so the lines after this one see their effect).
    fn handle_scripted { mut sdl: sdl::Sdl, mut inp: Inputs, word: []u8, rest: []u8 } -> bool {
        let mut words = text::words{ s = rest }
        if ci::eq{ a = word, b = "ui" } {
            // The older spellings, same events.
            let cmd = text::next_word{ &words } ifnull { return false }
            if ci::eq{ a = cmd, b = "move" } or ci::eq{ a = cmd, b = "click" } or ci::eq{ a = cmd, b = "key" } or ci::eq{ a = cmd, b = "type" } {
                return handle_scripted{ &sdl, &inp, word = cmd, rest = text::rest{ words } }
            }
            return false
        }
        if ci::eq{ a = word, b = "key" } or ci::eq{ a = word, b = "keydown" } or ci::eq{ a = word, b = "down" } or ci::eq{ a = word, b = "keyup" } or ci::eq{ a = word, b = "up" } {
            let name = text::next_word{ &words } ifnull { return true }
            let code = key_of{ name }
            if code == 0 { return true }
            let tap = ci::eq{ a = word, b = "key" }
            if tap or ci::eq{ a = word, b = "keydown" } or ci::eq{ a = word, b = "down" } { push_key{ &sdl, &inp, code, down = true } }
            if tap or ci::eq{ a = word, b = "keyup" } or ci::eq{ a = word, b = "up" } { push_key{ &sdl, &inp, code, down = false } }
            return true
        }
        if ci::eq{ a = word, b = "type" } {
            // Typed text for a focused edit box, in the pieces the platform delivers.
            let typed = text::rest{ words }
            let mut at: usize = 0
            while at < typed.len {
                let n = if typed.len - at > 32 { 32 } else { typed.len - at }
                let mut piece: [32]u8
                slice::copy(u8){ dst = piece[..n], src = typed[at..at + n] }
                _ = sdl::push{ &sdl, ev = sdl::Event::text{ bytes = piece, len = n } }
                at = at + n
            }
            return true
        }
        if ci::eq{ a = word, b = "move" } or ci::eq{ a = word, b = "click" } {
            // The older `ui move X Y`, `ui click X Y`.
            let x = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            let y = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            push_move{ &sdl, &inp, x, y }
            if ci::eq{ a = word, b = "click" } {
                push_button{ &sdl, &inp, button = sdl::BUTTON_LEFT, down = true }
                push_button{ &sdl, &inp, button = sdl::BUTTON_LEFT, down = false }
            }
            return true
        }
        if not ci::eq{ a = word, b = "mouse" } { return false }
        let cmd = text::next_word{ &words } ifnull { return false }
        // `mouse DX DY` (numbers first) is a minigame's own word: the mouse moves by those counts.
        let ours = ci::eq{ a = cmd, b = "move" } or ci::eq{ a = cmd, b = "down" } or ci::eq{ a = cmd, b = "up" } or ci::eq{ a = cmd, b = "click" } or ci::eq{ a = cmd, b = "wheel" }
        if not ours { return false }
        if ci::eq{ a = cmd, b = "wheel" } {
            let dy = @as(f32, @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "1" }))
            _ = sdl::push{ &sdl, ev = sdl::Event::mouse_wheel{ dx = 0.0, dy } }
            return true
        }
        // The rest of the words: an optional button name and an optional X Y.
        let mut button = sdl::BUTTON_LEFT
        let mut moved = false
        let mut x = inp.x
        let mut y = inp.y
        while true {
            let a = text::next_word{ &words } ifnull { break }
            if a.len > 0 and (a[0] >= '0' and a[0] <= '9') {
                x = @as(i32, text::scan_decimal{ s = a })
                y = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
                moved = true
            } else {
                button = button_of{ word = a }
            }
        }
        if ci::eq{ a = cmd, b = "move" } or moved { push_move{ &sdl, &inp, x, y } }
        if ci::eq{ a = cmd, b = "down" } or ci::eq{ a = cmd, b = "click" } { push_button{ &sdl, &inp, button, down = true } }
        if ci::eq{ a = cmd, b = "up" } or ci::eq{ a = cmd, b = "click" } { push_button{ &sdl, &inp, button, down = false } }
        return true
    }
}
