// The build program for bink2png: `kotor/tools/ctxc run kotor/tools/bink2png -- MOVIE --from N --to M`.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "bink2png", root = "." }
    build::add_sources{ &b, exe, dir = "../../lib/base" }
    build::add_sources{ &b, exe, dir = "../../lib/video" }
    build::optimize{ &b, exe, level = 2 }
}
