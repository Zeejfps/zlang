// Real models through the seam, the way the game draws them: lib/mdl_cache loads a model and its
// supermodels, lib/mdl_render uploads its meshes and turns a pose into draws, lib/material gives
// each mesh its material. What is left here is for framing and lighting test pictures.
namespace kmodels {
    error no_model{ name: []u8 }

    // A model on the GPU: its meshes and a material for each (by Model.meshes index).
    struct Loaded { gpu: mdl_render::Gpu, materials: []mut render::Material, count: usize }

    // Uploads a model's meshes and makes their materials (`envmap`: an appearance.2da override,
    // "" for none).
    fn upload {
        mut dev: gpu::Device, mut cache: material::Cache, mut fs: Fs, rm: res::Manager, mut heap: arena::Arena,
        model: *mdl::Model, envmap: []u8,
    } -> !Loaded {
        let g = try mdl_render::upload{ &dev, realloc = arena::alloc, &heap, model }
        let materials = try alloc::resize(render::Material, arena::Arena){ realloc = arena::alloc, &heap, mem = slice::empty(render::Material){}, count = model.meshes.len }
        let mut count: usize = 0
        let mut i: usize = 0
        while i < model.meshes.len {
            let m = model.meshes[i]
            materials[i] = mdl_render::base_material{ mesh = m }
            if g.meshes[i] != null {
                let mut mat = material::for_mesh{ &cache, &fs, &dev, rm, desc = material::MeshDesc{
                    diffuse = m.textures[0], lightmap = m.textures[1], lightmapped = m.lightmapped,
                    transparency_hint = m.transparency_hint, alpha = 1.0, self_illum = math::vec3::zero{}, envmap,
                } }
                mat.sort = materials[i].sort
                materials[i] = mat
                count = count + 1
            }
            i = i + 1
        }
        return Loaded{ gpu = g, materials, count }
    }

    // Adds a posed model's draws to `view` through mdl_render; returns the index of its first draw.
    fn draw {
        mut frame: render::Frame, view: u32, model: *mdl::Model, pose: mdl_anim::Pose, parts: Loaded,
        instance: math::Mat4, palette: []mut math::Mat4,
    } -> u32 {
        let first = frame.draw_count
        _ = mdl_render::add_draws{ &frame, view, model, pose, g = parts.gpu, transform = instance, materials = parts.materials, time = frame.time }
        return first
    }

    // The model's lights as frame lights.
    fn add_lights { mut frame: render::Frame, model: *mdl::Model, pose: mdl_anim::Pose, instance: math::Mat4 } {
        let mut i: usize = 0
        while i < model.lights.len {
            let l = model.lights[i]
            let p = pose.lights[i]
            let at = math::mat4::transform_point{ m = math::mat4::mul{ a = instance, b = pose.world[l.node] }, p = math::vec3::zero{} }
            if not l.ambient_only and p.radius > 0.0 {
                render::add_light{ &frame, light = render::Light{ position = at, color = math::vec3::scale{ v = p.color, s = p.multiplier }, radius = p.radius } }
            }
            i = i + 1
        }
    }

    // The posed bounds of the meshes that draw, under `instance`, merged into `box`, for framing
    // a camera: rigid vertices through their node, skinned ones through their palette too.
    fn bounds { model: *mdl::Model, pose: mdl_anim::Pose, parts: Loaded, instance: math::Mat4, box: math::Aabb, palette: []mut math::Mat4 } -> math::Aabb {
        let mut out = box
        let mut i: usize = 0
        while i < model.meshes.len {
            let mesh = &model.meshes[i]
            let drawn = i < parts.gpu.meshes.len and parts.gpu.meshes[i] != null
            i = i + 1
            if not drawn or mesh.saber != null { continue }
            let w = math::mat4::mul{ a = instance, b = pose.world[mesh.node] }
            let n = mdl_anim::skin_palette{ model, mesh, pose, out = palette }
            let skin = mesh.skin
            let mut v: usize = 0
            while v < @as(usize, mesh.vertex_count) {
                let mut p = math::Vec3{ x = mesh.positions[v * 3], y = mesh.positions[v * 3 + 1], z = mesh.positions[v * 3 + 2] }
                if skin != null and n > 0 {
                    let mut q = math::vec3::zero{}
                    let mut k: usize = 0
                    while k < 4 {
                        let weight = skin.weights[v * 4 + k]
                        let slot = @as(usize, skin.bones[v * 4 + k])
                        if weight > 0.0 and slot < n { q = math::vec3::add_scaled{ a = q, b = math::mat4::transform_point{ m = palette[slot], p }, s = weight } }
                        k = k + 1
                    }
                    p = q
                }
                out = math::aabb::extend{ b = out, p = math::mat4::transform_point{ m = w, p } }
                v = v + 1
            }
        }
        return out
    }
}
