// A font's metrics from its TXI text (docs/formats/txi-render.md, Fonts), as render::Font wants
// them. Only the font keywords; data-core's TXI parser will replace this once it has the
// coordinate blocks.
namespace fonttxi {
    error not_a_font                         // no numchars, or blocks shorter than it
    error too_many_glyphs{ n: u32 }

    struct Metrics { count: u32, height: f32, baseline: f32, spacing: f32 }

    // Fills `glyphs` (at least numchars long) from the TXI text; returns the metrics in texels.
    fn read { text: []u8, glyphs: []mut render::Glyph } -> !Metrics {
        let mut m = Metrics{ count = 0, height = 0.0, baseline = 0.0, spacing = 0.0 }
        let mut uls: u32 = 0
        let mut lrs: u32 = 0
        let mut cur = Lines{ text, at = 0 }
        while true {
            let line = next_line{ &cur } ifnull { break }
            let key = word{ line, n = 0 }
            if same_word{ a = key, b = "numchars" } {
                m.count = @as(u32, number{ line } )
                if @as(usize, m.count) > glyphs.len { return too_many_glyphs{ n = m.count } }
            } else if same_word{ a = key, b = "fontheight" } {
                m.height = number{ line } * 100.0
            } else if same_word{ a = key, b = "baselineheight" } {
                m.baseline = number{ line } * 100.0
            } else if same_word{ a = key, b = "spacingr" } {
                m.spacing = number{ line } * 100.0
            } else if same_word{ a = key, b = "upperleftcoords" } or same_word{ a = key, b = "lowerrightcoords" } {
                let upper = same_word{ a = key, b = "upperleftcoords" }
                let n = @as(u32, number{ line })
                let mut k: u32 = 0
                while k < n {
                    let row = next_line{ &cur } ifnull { break }
                    if @as(usize, k) < glyphs.len {
                        let u = parse{ w = word{ line = row, n = 0 } }
                        let v = parse{ w = word{ line = row, n = 1 } }
                        if upper {
                            glyphs[k].u0 = math::clamp{ x = u, lo = 0.0, hi = 1.0 }
                            glyphs[k].v0 = math::clamp{ x = v, lo = 0.0, hi = 1.0 }
                        } else {
                            glyphs[k].u1 = math::clamp{ x = u, lo = 0.0, hi = 1.0 }
                            glyphs[k].v1 = math::clamp{ x = v, lo = 0.0, hi = 1.0 }
                        }
                    }
                    k = k + 1
                }
                if upper { uls = k } else { lrs = k }
            }
        }
        if m.count == 0 or uls < m.count or lrs < m.count { return not_a_font }
        return m
    }

    struct Lines { text: []u8, at: usize }

    // The next non-blank line, without its line end.
    fn next_line { mut cur: Lines } -> ?[]u8 {
        while cur.at < cur.text.len {
            let start = cur.at
            while cur.at < cur.text.len and cur.text[cur.at] != '\n' { cur.at = cur.at + 1 }
            let mut end = cur.at
            if cur.at < cur.text.len { cur.at = cur.at + 1 }
            while end > start and (cur.text[end - 1] == '\r' or cur.text[end - 1] == ' ' or cur.text[end - 1] == '\t') { end = end - 1 }
            if end > start { return cur.text[start..end] }
        }
        return null
    }

    // The n-th word of a line, split at spaces and tabs ("" past the last).
    fn word { line: []u8, n: u32 } -> []u8 {
        let mut i: usize = 0
        let mut k: u32 = 0
        while i < line.len {
            while i < line.len and (line[i] == ' ' or line[i] == '\t') { i = i + 1 }
            let start = i
            while i < line.len and line[i] != ' ' and line[i] != '\t' { i = i + 1 }
            if start < i {
                if k == n { return line[start..i] }
                k = k + 1
            }
        }
        return ""
    }

    fn number { line: []u8 } -> f32 { return parse{ w = word{ line, n = 1 } } }

    fn parse { w: []u8 } -> f32 {
        let s = utf8::from{ bytes = w } iferr { return 0.0 }
        return utf8::parse_f32{ s } ifnull { 0.0 }
    }

    fn same_word { a: []u8, b: []u8 } -> bool {
        if a.len != b.len { return false }
        let mut i: usize = 0
        while i < a.len {
            if ascii::to_lower{ c = a[i] } != b[i] { return false }
            i = i + 1
        }
        return true
    }
}

// The top level of a TPC's first image and its TXI text, for fonts until lib/tex lands: enough
// for single-image grey, RGB, RGBA, DXT1 and DXT5 files (docs/formats/tpc.md).
namespace tpcfont {
    error short
    error unsupported

    struct Image { format: render::PixelFormat, width: u32, height: u32, pixels: []u8, txi: []u8 }

    fn read { bytes: []u8 } -> !Image {
        if bytes.len < 128 { return short }
        let data_size = le32{ b = bytes, at = 0 }
        let width = @as(u32, bytes[8]) | (@as(u32, bytes[9]) << 8)
        let height = @as(u32, bytes[10]) | (@as(u32, bytes[11]) << 8)
        let encoding = bytes[12]
        let levels = @as(u32, bytes[13])
        let format = if data_size != 0 {
            if encoding == 2 { render::PixelFormat::dxt1 } else if encoding == 4 { render::PixelFormat::dxt5 } else { return unsupported }
        } else {
            if encoding == 1 { render::PixelFormat::grey8 } else if encoding == 2 { render::PixelFormat::rgb8 } else if encoding == 4 { render::PixelFormat::rgba8 } else { return unsupported }
        }
        if height == 6 * width { return unsupported }
        let mut chain: usize = 0
        let mut k: u32 = 0
        while k < (if levels > 0 { levels } else { 1 }) {
            let w = if (width >> k) > 0 { width >> k } else { 1 }
            let h = if (height >> k) > 0 { height >> k } else { 1 }
            chain = chain + render::level_size{ format, width = w, height = h }
            k = k + 1
        }
        let top = render::level_size{ format, width, height }
        if data_size != 0 and levels == 1 and @as(usize, data_size) > top { return unsupported }     // a flipbook
        if 128 + chain > bytes.len { return short }
        return Image{ format, width, height, pixels = bytes[128..128 + top], txi = bytes[128 + chain..] }
    }

    fn le32 { b: []u8, at: usize } -> u32 {
        return @as(u32, b[at]) | (@as(u32, b[at + 1]) << 8) | (@as(u32, b[at + 2]) << 16) | (@as(u32, b[at + 3]) << 24)
    }
}
