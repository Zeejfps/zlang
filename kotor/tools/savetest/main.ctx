// savetest: reads the install's save (savenfo.res, PARTYTABLE.res, GLOBALVARS.res, Screen.tga)
// through lib/save into a fresh world, writes each back, re-parses what it wrote and checks the
// round trip. The install's saves are the player's own and change as they play, so nothing here
// expects a particular save's values: what is read is checked against the file's own fields, and
// what is written back has to be the original's file field for field. Any manual save works with
// --save. Output files go to --out (default kotor/out/savetest).
//
//   savetest [--game DIR] [--save DIR] [--out DIR]
const DEFAULT_SAVE: []u8 = "F:/Steam/steamapps/common/swkotor/saves/000002 - Game1"

struct Report { checks: u32, failures: u32 }

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, args: Args } -> i32 {
    let mut game: []u8 = "F:/Steam/steamapps/common/swkotor"
    let mut save_dir: []u8 = DEFAULT_SAVE
    let mut out_dir: []u8 = "kotor/out/savetest"
    let mut i: usize = 0
    while i < args.len {
        let a = args[i]
        let has = i + 1 < args.len
        if slice::eq_bytes{ a, b = "--game" } and has { i = i + 1; game = args[i] }
        else if slice::eq_bytes{ a, b = "--save" } and has { i = i + 1; save_dir = args[i] }
        else if slice::eq_bytes{ a, b = "--out" } and has { i = i + 1; out_dir = args[i] }
        else {
            io::eprintln{ &io, s = "usage: savetest [--game DIR] [--save DIR] [--out DIR]" }
            return 2
        }
        i = i + 1
    }
    let mut h = heap::new{ &mem }
    let module_pages = mem::pages{ &mem, size = 67108864 } ifnull { return 1 }
    let scratch_pages = mem::pages{ &mem, size = 33554432 } ifnull { return 1 }
    let mut module_arena = arena::new{ buf = module_pages }
    let mut scratch = arena::new{ buf = scratch_pages }
    let mut rm = res::open{ &fs, heap = &h, game } iferr err{ error } {
        _ = @fmt(&io, "savetest: no game data at {}: {}\n", game, error)
        io::flush{ &io }
        return 1
    }
    let failures = run{ &io, &fs, &h, &rm, &module_arena, &scratch, save_dir, out_dir } iferr err{ error } {
        _ = @fmt(&io, "savetest: failed: {}\n", error)
        io::flush{ &io }
        return 1
    }
    io::flush{ &io }
    return if failures == 0 { 0 } else { 1 }
}

fn run {
    mut io: Io, mut fs: Fs, mut h: heap::Heap, mut rm: res::Manager, mut module_arena: arena::Arena,
    mut scratch: arena::Arena, save_dir: []u8, out_dir: []u8,
} -> !u32 {
    let w = try world::make{ fs, io, heap = &h, rm = &rm, module_arena = &module_arena, scratch = &scratch, seed = 1, saves = out_dir }
    fs::make_dir{ &fs, path = out_dir } iferr {}
    let mut r = Report{ checks = 0, failures = 0 }
    try test_info{ &io, &fs, &h, &r, save_dir, out_dir }
    try test_globals{ &io, &fs, &h, &r, w, save_dir, out_dir }
    try test_party{ &io, &fs, &h, &r, w, save_dir, out_dir }
    try test_screenshot{ &io, &fs, &h, &r, save_dir, out_dir }
    test_clock{ &io, &r, w }
    _ = @fmt(&io, "savetest: {} checks, {} failed\n", r.checks, r.failures)
    return r.failures
}

// A load moves the calendar and leaves the world clock's counter alone, and an elapsed time taken
// from a stamp in the future is 0 (a clock discontinuity must never underflow).
fn test_clock { mut io: Io, mut r: Report, w: *mut world::World } {
    check{ &io, &r, ok = clock::elapsed_since{ now = 10, then = 4 } == 6, what = "elapsed_since: 10 since 4" }
    check{ &io, &r, ok = clock::elapsed_since{ now = 4, then = 10 } == 0, what = "elapsed_since: a stamp in the future is 0" }
    check{ &io, &r, ok = clock::elapsed_since{ now = 0, then = 1 } == 0, what = "elapsed_since: from 1 at time 0" }
    let mut c = clock::new{}
    c.now_us = 123456789
    let before = c.now_us
    let per_day = clock::ms_per_day{ c }
    let saved = 450438 * per_day + 7 * 60000
    clock::set_calendar{ c = &c, at = saved }
    check{ &io, &r, ok = c.now_us == before, what = "set_calendar leaves the counter alone" }
    check{ &io, &r, ok = clock::calendar_ms{ c } + clock::now_ms{ c } == saved, what = "set_calendar: the calendar now reads the save's time" }
    // A save older than the counter's age (a hand-made one) starts the calendar at 0, no panic.
    clock::set_calendar{ c = &c, at = 5 }
    check{ &io, &r, ok = c.now_us == before and clock::calendar_ms{ c } == 0, what = "set_calendar: a time before the counter's age" }
}

fn check { mut io: Io, mut r: Report, ok: bool, what: []u8 } {
    r.checks = r.checks + 1
    if not ok {
        r.failures = r.failures + 1
        _ = @fmt(&io, "FAIL: {}\n", what)
    }
}

fn read_file { mut fs: Fs, mut h: heap::Heap, dir: []u8, name: []u8 } -> !alloc::Bytes {
    let path = try path::join(heap::Heap){ realloc = heap::alloc, heap = &h, dir, name }
    return try fs::read_all{ &fs, heap = &h, realloc = heap::alloc, path }
}

fn write_file { mut fs: Fs, mut h: heap::Heap, dir: []u8, name: []u8, bytes: []u8 } -> ! {
    let path = try path::join(heap::Heap){ realloc = heap::alloc, heap = &h, dir, name }
    _ = try fs::write_all{ &fs, path, bytes }
}

// Whether two files have the same top-level fields, in the same order, with the same types.
fn same_shape { a: *gff::Doc, b: *gff::Doc } -> bool {
    let fa = gff::fields_of{ doc = a.*, s = gff::ROOT }
    let fb = gff::fields_of{ doc = b.*, s = gff::ROOT }
    if fa.len != fb.len { return false }
    let mut i: usize = 0
    while i < fa.len {
        if not slice::eq_bytes{ a = gff::label_of{ doc = a.*, f = fa[i] }, b = gff::label_of{ doc = b.*, f = fb[i] } } { return false }
        if gff::kind_of{ doc = a.*, f = fa[i] } != gff::kind_of{ doc = b.*, f = fb[i] } { return false }
        i = i + 1
    }
    return true
}

// How many fields differ between struct sa of a and struct sb of b: a field one side lacks, or
// holds with another type or value (floats by bits), a struct id, a list's length; structs and
// lists are compared field by field. Labels in `skip` are left to the caller. The first few
// differences are printed as PARENT/LABEL.
fn count_differences { mut io: Io, a: *gff::Doc, sa: u32, b: *gff::Doc, sb: u32, parent: []u8, skip: [][]u8, mut shown: u32 } -> usize {
    let mut n: usize = 0
    if gff::struct_id{ doc = a.*, s = sa } != gff::struct_id{ doc = b.*, s = sb } {
        n = n + 1
        note_difference{ &io, &shown, parent, label = "(struct id)" }
    }
    let fb = gff::fields_of{ doc = b.*, s = sb }
    let mut i: usize = 0
    while i < fb.len {
        let label = gff::label_of{ doc = b.*, f = fb[i] }
        i = i + 1
        if not is_skipped{ skip, label } and gff::find{ doc = a.*, s = sa, label } == null {
            n = n + 1
            note_difference{ &io, &shown, parent, label }
        }
    }
    let fa = gff::fields_of{ doc = a.*, s = sa }
    i = 0
    while i < fa.len {
        let f = fa[i]
        i = i + 1
        let label = gff::label_of{ doc = a.*, f }
        if is_skipped{ skip, label } { continue }
        let g = gff::find{ doc = b.*, s = sb, label } ifnull {
            n = n + 1
            note_difference{ &io, &shown, parent, label }
            continue
        }
        if gff::kind_of{ doc = a.*, f } != gff::kind_of{ doc = b.*, f = g } {
            n = n + 1
            note_difference{ &io, &shown, parent, label }
            continue
        }
        match gff::value{ doc = a.*, f } {
            structure{ index } => {
                let other = if gff::value{ doc = b.*, f = g } is structure{ index = j } { j } else { 0 }
                n = n + count_differences{ &io, a, sa = index, b, sb = other, parent = label, skip, &shown }
            }
            list{ items } => {
                let other = if gff::value{ doc = b.*, f = g } is list{ items = j } { j } else { slice::empty(u32){} }
                if items.len != other.len {
                    n = n + 1
                    note_difference{ &io, &shown, parent, label }
                } else {
                    let mut k: usize = 0
                    while k < items.len {
                        n = n + count_differences{ &io, a, sa = items[k], b, sb = other[k], parent = label, skip, &shown }
                        k = k + 1
                    }
                }
            }
            else => {
                if not same_leaf{ a, fa = f, b, fb = g } {
                    n = n + 1
                    note_difference{ &io, &shown, parent, label }
                }
            }
        }
    }
    return n
}

fn note_difference { mut io: Io, mut shown: u32, parent: []u8, label: []u8 } {
    shown = shown + 1
    if shown <= 12 { _ = @fmt(&io, "  differs: {}/{}\n", parent, label) }
}

fn is_skipped { skip: [][]u8, label: []u8 } -> bool {
    let mut i: usize = 0
    while i < skip.len {
        if slice::eq_bytes{ a = skip[i], b = label } { return true }
        i = i + 1
    }
    return false
}

// Two fields of the same type hold the same value: the inline 4 bytes, or the stored bytes.
fn same_leaf { a: *gff::Doc, fa: u32, b: *gff::Doc, fb: u32 } -> bool {
    if gff::is_inline{ kind = a.fields[fa].kind } { return a.fields[fa].raw == b.fields[fb].raw }
    return slice::eq_bytes{ a = stored_bytes{ doc = a, f = fa }, b = stored_bytes{ doc = b, f = fb } }
}

fn stored_bytes { doc: *gff::Doc, f: u32 } -> []u8 {
    let d = @as(usize, doc.fields[f].raw)
    let fd = doc.data
    let n: usize = match doc.fields[f].kind {
        dword64 | int64 | double => { 8 }
        orientation => { 16 }
        vector => { 12 }
        exostring | void | locstring => { 4 + @as(usize, le::get_u32{ data = fd, at = d } iferr 0) }
        resref => { 1 + @as(usize, le::get_u8{ data = fd, at = d } iferr 0) }
        else => { 0 }
    }
    if d + n > fd.len { return "" }
    return fd[d..d + n]
}

fn list_len { doc: *gff::Doc, s: u32, label: []u8 } -> usize {
    return (gff::get_list{ doc = doc.*, s, label } ifnull slice::empty(u32){}).len
}

// ---- savenfo.res

fn same_info { a: save::Info, b: save::Info } -> bool {
    if not slice::eq_bytes{ a = a.area_name, b = b.area_name } { return false }
    if not slice::eq_bytes{ a = a.last_module, b = b.last_module } { return false }
    if not slice::eq_bytes{ a = a.save_name, b = b.save_name } { return false }
    if a.time_played != b.time_played or a.cheat_used != b.cheat_used or a.autosave != b.autosave { return false }
    if a.gameplay_hint != b.gameplay_hint or a.story_hint != b.story_hint { return false }
    if a.portrait_count != b.portrait_count { return false }
    let mut i: usize = 0
    while i < a.portrait_count {
        if not resref::eq{ a = a.portraits[i], b = b.portraits[i] } { return false }
        i = i + 1
    }
    return true
}

fn test_info { mut io: Io, mut fs: Fs, mut h: heap::Heap, mut r: Report, save_dir: []u8, out_dir: []u8 } -> ! {
    let data = try read_file{ &fs, &h, dir = save_dir, name = "savenfo.res" }
    let doc = try gff::parse{ data, realloc = heap::alloc, heap = &h }
    let info = save::read_info{ doc = &doc }
    _ = @fmt(&io, "savenfo: \"{}\" module {} played {}s name \"{}\" portraits {} hints {} {}\n", info.area_name, info.last_module, info.time_played, info.save_name, info.portrait_count, info.gameplay_hint, info.story_hint)
    // The install's saves are the player's own and change as they play, so the expected values
    // come from the files: each field as its own label and type hold it, and the time played is
    // the party table's PT_PLAYEDSECONDS (DoSaveGame writes both from the same clock).
    let root = gff::ROOT
    check{ &io, &r, ok = info.area_name.len > 0 and slice::eq_bytes{ a = info.area_name, b = gff::get_string{ doc, s = root, label = "AREANAME" } ifnull "" }, what = "info: area name" }
    check{ &io, &r, ok = info.last_module.len > 0 and slice::eq_bytes{ a = info.last_module, b = gff::get_string{ doc, s = root, label = "LASTMODULE" } ifnull "" }, what = "info: last module" }
    let party_data = try read_file{ &fs, &h, dir = save_dir, name = "PARTYTABLE.res" }
    let party_doc = try gff::parse{ data = party_data, realloc = heap::alloc, heap = &h }
    let played = gff::get_dword{ doc = party_doc, s = root, label = "PT_PLAYEDSECONDS" } ifnull 0
    check{ &io, &r, ok = info.time_played > 0 and info.time_played == (gff::get_dword{ doc, s = root, label = "TIMEPLAYED" } ifnull 0) and info.time_played == played, what = "info: time played (TIMEPLAYED, as PT_PLAYEDSECONDS)" }
    check{ &io, &r, ok = slice::eq_bytes{ a = info.save_name, b = gff::get_string{ doc, s = root, label = "SAVEGAMENAME" } ifnull "" }, what = "info: save name" }
    let mut portraits_ok = info.portrait_count > 0
    let mut p: usize = 0
    while p < 3 {
        let label: []u8 = if p == 0 { "PORTRAIT0" } else if p == 1 { "PORTRAIT1" } else { "PORTRAIT2" }
        let in_file = gff::get_resref{ doc, s = root, label }
        if p < info.portrait_count { portraits_ok = portraits_ok and in_file != null and resref::matches{ r = info.portraits[p], name = gff::get_resref{ doc, s = root, label } ifnull "" } }
        else { portraits_ok = portraits_ok and in_file == null }
        p = p + 1
    }
    check{ &io, &r, ok = portraits_ok, what = "info: portraits" }
    check{ &io, &r, ok = info.cheat_used == ((gff::get_byte{ doc, s = root, label = "CHEATUSED" } ifnull 0) != 0) and info.autosave == ((gff::get_byte{ doc, s = root, label = "PCAUTOSAVE" } ifnull 0) != 0), what = "info: flags" }
    check{ &io, &r, ok = info.gameplay_hint == (gff::get_byte{ doc, s = root, label = "GAMEPLAYHINT" } ifnull 255) and info.story_hint == (gff::get_byte{ doc, s = root, label = "STORYHINT" } ifnull 255), what = "info: the load screen's hint counters" }

    let bytes = try save::write_info{ realloc = heap::alloc, heap = &h, info }
    try write_file{ &fs, &h, dir = out_dir, name = "savenfo.res", bytes }
    let doc2 = try gff::parse{ data = bytes, realloc = heap::alloc, heap = &h }
    check{ &io, &r, ok = same_info{ a = info, b = save::read_info{ doc = &doc2 } }, what = "info: round trip" }
    check{ &io, &r, ok = same_shape{ a = &doc, b = &doc2 }, what = "info: same fields as the install's, in order" }
    let mut shown: u32 = 0
    let differing = count_differences{ &io, a = &doc, sa = root, b = &doc2, sb = root, parent = "savenfo", skip = slice::empty([]u8){}, &shown }
    check{ &io, &r, ok = differing == 0, what = "info: the install's file written back, every field as it was" }

    // A transition autosave: PCAUTOSAVE, no SAVEGAMENAME.
    let mut auto = info
    auto.autosave = true
    auto.save_name = ""
    auto.cheat_used = true
    let bytes3 = try save::write_info{ realloc = heap::alloc, heap = &h, info = auto }
    let doc3 = try gff::parse{ data = bytes3, realloc = heap::alloc, heap = &h }
    check{ &io, &r, ok = same_info{ a = auto, b = save::read_info{ doc = &doc3 } }, what = "info: autosave round trip" }
    check{ &io, &r, ok = gff::get_string{ doc = doc3, s = gff::ROOT, label = "SAVEGAMENAME" } == null, what = "info: autosave has no SAVEGAMENAME" }
}

// ---- GLOBALVARS.res

// The global whose value is packed n-th of its kind in a GLOBALVARS file (the file's name order).
fn nth_global { g: *globals::Globals, doc: *gff::Doc, kind: globals::Type, n: usize } -> ?*mut globals::Global {
    let label: []u8 = match kind {
        boolean => { "CatBoolean" }
        number => { "CatNumber" }
        location => { "CatLocation" }
        string => { "CatString" }
    }
    let names = gff::get_list{ doc = doc.*, s = gff::ROOT, label } ifnull { return null }
    if n >= names.len { return null }
    let name = gff::get_string{ doc = doc.*, s = names[n], label = "Name" } ifnull { return null }
    return globals::find{ g, name, kind }
}

fn near { a: f32, b: f32 } -> bool { return math::abs{ x = a - b } < 0.01 }

// How many globals differ between two catalogues.
fn globals_differing { a: *globals::Globals, b: *globals::Globals } -> usize {
    if a.all.len != b.all.len { return a.all.len + b.all.len + 1 }
    let mut bad: usize = 0
    let mut i: usize = 0
    while i < a.all.len {
        let x = list::at{ list = a.all, i }
        let y = list::at{ list = b.all, i }
        let same = x.kind == y.kind and slice::eq_bytes{ a = x.name, b = y.name } and match x.kind {
            string => { slice::eq_bytes{ a = x.text, b = y.text } }
            location => {
                near{ a = x.location.position.x, b = y.location.position.x } and near{ a = x.location.position.y, b = y.location.position.y }
                    and near{ a = x.location.position.z, b = y.location.position.z } and near{ a = x.location.facing, b = y.location.facing }
            }
            else => { x.number == y.number }
        }
        if not same { bad = bad + 1 }
        i = i + 1
    }
    return bad
}

fn names_missing { g: *globals::Globals, doc: *gff::Doc, label: []u8 } -> usize {
    let names = gff::get_list{ doc = doc.*, s = gff::ROOT, label } ifnull slice::empty(u32){}
    let mut missing: usize = 0
    let mut i: usize = 0
    while i < names.len {
        let name = gff::get_string{ doc = doc.*, s = names[i], label = "Name" } ifnull ""
        if map::get{ m = g.by_name, key = name } == null { missing = missing + 1 }
        i = i + 1
    }
    return missing
}

// How many globals are away from their start value (`numeric`: booleans and numbers only).
fn count_set { g: *globals::Globals, numeric: bool } -> usize {
    let mut n: usize = 0
    let mut i: usize = 0
    while i < g.all.len {
        let p = list::at{ list = g.all, i }
        let set = match p.kind {
            string => { not numeric and p.text.len != 0 }
            location => { not numeric and (p.location.facing != 0.0 or p.location.position.x != 0.0) }
            else => { p.number != 0 }
        }
        if set { n = n + 1 }
        i = i + 1
    }
    return n
}

// The file's locations (position, and the facing its orientation vector gives) and strings that
// the catalogue doesn't hold as stored.
fn locations_and_strings_differing { g: *globals::Globals, doc: *gff::Doc } -> usize {
    let mut bad: usize = 0
    let names = gff::get_list{ doc = doc.*, s = gff::ROOT, label = "CatLocation" } ifnull slice::empty(u32){}
    let slots = gff::get_void{ doc = doc.*, s = gff::ROOT, label = "ValLocation" } ifnull ""
    let mut k: usize = 0
    while k < names.len and 24 * (k + 1) <= slots.len {
        let name = gff::get_string{ doc = doc.*, s = names[k], label = "Name" } ifnull ""
        let v = globals::location{ g, name }
        let x = le::get_f32{ data = slots, at = 24 * k } iferr 0.0
        let y = le::get_f32{ data = slots, at = 24 * k + 4 } iferr 0.0
        let z = le::get_f32{ data = slots, at = 24 * k + 8 } iferr 0.0
        let ox = le::get_f32{ data = slots, at = 24 * k + 12 } iferr 0.0
        let oy = le::get_f32{ data = slots, at = 24 * k + 16 } iferr 0.0
        let mut same = near{ a = v.position.x, b = x } and near{ a = v.position.y, b = y } and near{ a = v.position.z, b = z }
        if ox != 0.0 or oy != 0.0 {
            let rad = math::radians{ degrees = v.facing }
            same = same and near{ a = math::cosf{ x = rad }, b = ox } and near{ a = math::sinf{ x = rad }, b = oy }
        }
        if not same { bad = bad + 1 }
        k = k + 1
    }
    let string_names = gff::get_list{ doc = doc.*, s = gff::ROOT, label = "CatString" } ifnull slice::empty(u32){}
    let strings = gff::get_list{ doc = doc.*, s = gff::ROOT, label = "ValString" } ifnull slice::empty(u32){}
    k = 0
    while k < string_names.len and k < strings.len {
        let name = gff::get_string{ doc = doc.*, s = string_names[k], label = "Name" } ifnull ""
        let text = gff::get_string{ doc = doc.*, s = strings[k], label = "String" } ifnull ""
        if not slice::eq_bytes{ a = globals::string{ g, name }, b = text } { bad = bad + 1 }
        k = k + 1
    }
    return bad
}

// Location slots (24 bytes: position, orientation x, y, z) whose floats differ by 0.001 or more.
fn location_slots_differing { a: []u8, b: []u8 } -> usize {
    if a.len != b.len { return a.len / 24 + 1 }
    let mut bad: usize = 0
    let mut slot: usize = 0
    while 24 * (slot + 1) <= a.len {
        let mut same = true
        let mut k: usize = 0
        while k < 6 {
            let at = 24 * slot + 4 * k
            let x = le::get_f32{ data = a, at } iferr 0.0
            let y = le::get_f32{ data = b, at } iferr 0.0
            if math::abs{ x = x - y } >= 0.001 { same = false }
            k = k + 1
        }
        if not same { bad = bad + 1 }
        slot = slot + 1
    }
    return bad
}

fn test_globals { mut io: Io, mut fs: Fs, mut h: heap::Heap, mut r: Report, w: *mut world::World, save_dir: []u8, out_dir: []u8 } -> ! {
    let data = try read_file{ &fs, &h, dir = save_dir, name = "GLOBALVARS.res" }
    let doc = try gff::parse{ data, realloc = heap::alloc, heap = &h }
    let g = &w.globals
    let all = list::items{ list = g.all }
    let n_bool = save::count_globals{ all, kind = globals::Type::boolean }
    let n_number = save::count_globals{ all, kind = globals::Type::number }
    let n_loc = save::count_globals{ all, kind = globals::Type::location }
    let n_str = save::count_globals{ all, kind = globals::Type::string }
    _ = @fmt(&io, "globals: catalogue {} booleans, {} numbers, {} locations, {} strings; file has {} / {} / {} / {}\n", n_bool, n_number, n_loc, n_str, list_len{ doc = &doc, s = gff::ROOT, label = "CatBoolean" }, list_len{ doc = &doc, s = gff::ROOT, label = "CatNumber" }, list_len{ doc = &doc, s = gff::ROOT, label = "CatLocation" }, list_len{ doc = &doc, s = gff::ROOT, label = "CatString" })
    let unknown = names_missing{ g, doc = &doc, label = "CatBoolean" } + names_missing{ g, doc = &doc, label = "CatNumber" }
        + names_missing{ g, doc = &doc, label = "CatLocation" } + names_missing{ g, doc = &doc, label = "CatString" }
    check{ &io, &r, ok = unknown == 0, what = "globals: every saved name is in the catalogue" }

    try save::read_globals{ g, doc = &doc }
    // The file's own packed values say how many booleans and numbers (signed bytes) are set, which
    // the catalogue has to match; its locations and strings have to read as stored.
    let file_bools = gff::get_void{ doc = doc, s = gff::ROOT, label = "ValBoolean" } ifnull ""
    let file_numbers = gff::get_void{ doc = doc, s = gff::ROOT, label = "ValNumber" } ifnull ""
    let mut expected: usize = 0
    let mut k: usize = 0
    while k < file_bools.len {
        let mut bit: u8 = 0x80
        while bit != 0 {
            if (file_bools[k] & bit) != 0 { expected = expected + 1 }
            bit = bit >> 1
        }
        k = k + 1
    }
    k = 0
    while k < file_numbers.len {
        if file_numbers[k] != 0 { expected = expected + 1 }
        k = k + 1
    }
    _ = @fmt(&io, "globals: after loading the install's save {} booleans and numbers are non-default (the file's packed values set {})\n", count_set{ g, numeric = true }, expected)
    check{ &io, &r, ok = count_set{ g, numeric = true } == expected, what = "globals: the install's save loads with as many booleans and numbers set as its packed values say" }
    check{ &io, &r, ok = locations_and_strings_differing{ g, doc = &doc } == 0, what = "globals: the install's locations and strings load as stored" }

    // Written straight back, the file is the install's: the same names in the same order, the
    // same packed bytes, the same location slots (to float rounding; the facing goes through
    // degrees and back).
    let back = try save::write_globals{ realloc = heap::alloc, heap = &h, g }
    let back_doc = try gff::parse{ data = back, realloc = heap::alloc, heap = &h }
    let mut shown: u32 = 0
    let skip: [1][]u8 = ["ValLocation"]
    let differing = count_differences{ &io, a = &doc, sa = gff::ROOT, b = &back_doc, sb = gff::ROOT, parent = "globals", skip = skip[..], &shown }
    let slots_differing = location_slots_differing{ a = gff::get_void{ doc, s = gff::ROOT, label = "ValLocation" } ifnull "", b = gff::get_void{ doc = back_doc, s = gff::ROOT, label = "ValLocation" } ifnull "" }
    _ = @fmt(&io, "globals: written back, {} fields and {} location slots differ from the install's\n", differing, slots_differing)
    check{ &io, &r, ok = differing == 0 and slots_differing == 0, what = "globals: the install's file written back, every value as it was" }

    // Give the round trip something to carry: a boolean in the first byte, one in the second, the
    // last one, signed numbers, a string, locations.
    let b0 = nth_global{ g, doc = &back_doc, kind = globals::Type::boolean, n = 0 } ifnull { return }
    let b12 = nth_global{ g, doc = &back_doc, kind = globals::Type::boolean, n = 12 } ifnull { return }
    let blast = nth_global{ g, doc = &back_doc, kind = globals::Type::boolean, n = n_bool - 1 } ifnull { return }
    b0.number = 1
    b12.number = 1
    blast.number = 1
    let n0 = nth_global{ g, doc = &back_doc, kind = globals::Type::number, n = 0 } ifnull { return }
    let n1 = nth_global{ g, doc = &back_doc, kind = globals::Type::number, n = 1 } ifnull { return }
    let n2 = nth_global{ g, doc = &back_doc, kind = globals::Type::number, n = 2 } ifnull { return }
    n0.number = -5
    n1.number = 127
    n2.number = -128
    let s0 = nth_global{ g, doc = &back_doc, kind = globals::Type::string, n = 0 } ifnull { return }
    try globals::set_string{ g, name = s0.name, value = "hello, save" }
    let l0 = nth_global{ g, doc = &back_doc, kind = globals::Type::location, n = 0 } ifnull { return }
    let l1 = nth_global{ g, doc = &back_doc, kind = globals::Type::location, n = 1 } ifnull { return }
    globals::set_location{ g, name = l0.name, value = values::Location{ position = math::Vec3{ x = 1.0, y = 2.0, z = 3.0 }, facing = 90.0, area = obj::INVALID } }
    globals::set_location{ g, name = l1.name, value = values::Location{ position = math::Vec3{ x = 4.5, y = -6.0, z = 7.25 }, facing = 270.0, area = obj::INVALID } }

    let bytes = try save::write_globals{ realloc = heap::alloc, heap = &h, g }
    try write_file{ &fs, &h, dir = out_dir, name = "GLOBALVARS.res", bytes }
    let doc2 = try gff::parse{ data = bytes, realloc = heap::alloc, heap = &h }
    _ = @fmt(&io, "globals: wrote {} bytes (the install's file is {})\n", bytes.len, data.len)
    check{ &io, &r, ok = same_shape{ a = &doc, b = &doc2 }, what = "globals: same fields as the install's, in order" }
    check{ &io, &r, ok = list_len{ doc = &doc2, s = gff::ROOT, label = "CatBoolean" } == n_bool and list_len{ doc = &doc2, s = gff::ROOT, label = "CatNumber" } == n_number
        and list_len{ doc = &doc2, s = gff::ROOT, label = "CatLocation" } == n_loc and list_len{ doc = &doc2, s = gff::ROOT, label = "ValString" } == n_str, what = "globals: list sizes" }

    // The packed layout.
    let vb = gff::get_void{ doc = doc2, s = gff::ROOT, label = "ValBoolean" } ifnull ""
    let vn = gff::get_void{ doc = doc2, s = gff::ROOT, label = "ValNumber" } ifnull ""
    let vl = gff::get_void{ doc = doc2, s = gff::ROOT, label = "ValLocation" } ifnull ""
    check{ &io, &r, ok = vb.len == n_bool / 8 + 1 and vn.len == n_number and vl.len == 2400, what = "globals: packed sizes (count / 8 + 1, count, 2400)" }
    if vb.len > 1 and vn.len > 2 and vl.len == 2400 {
        // Booleans 0, 12 and the last were set on top of the install's: those bits join its bytes
        // and every other bit stays as it was.
        let top: u8 = 0x80
        let last_byte = (n_bool - 1) >> 3
        let last_bit = top >> @trunc(u8, (n_bool - 1) & 7)
        let mut msb_first = vb.len == file_bools.len
        let mut q: usize = 0
        while msb_first and q < vb.len {
            let mut want = file_bools[q]
            if q == 0 { want = want | 0x80 }
            if q == 1 { want = want | 0x08 }
            if q == last_byte { want = want | last_bit }
            msb_first = vb[q] == want
            q = q + 1
        }
        check{ &io, &r, ok = msb_first, what = "globals: booleans are most significant bit first" }
        check{ &io, &r, ok = vn[0] == 0xFB and vn[1] == 127 and vn[2] == 0x80 and vn.len == file_numbers.len and slice::eq_bytes{ a = vn[3..], b = file_numbers[3..] }, what = "globals: numbers are signed bytes" }
        let x = le::get_f32{ data = vl, at = 0 } iferr 0.0
        let oy = le::get_f32{ data = vl, at = 16 } iferr 0.0
        let x1 = le::get_f32{ data = vl, at = 24 } iferr 0.0
        check{ &io, &r, ok = near{ a = x, b = 1.0 } and near{ a = oy, b = 1.0 } and near{ a = x1, b = 4.5 }, what = "globals: location slots hold position and orientation" }
        let mut rest_zero = true
        let mut k: usize = 24 * n_loc
        while k < vl.len {
            if vl[k] != 0 { rest_zero = false }
            k = k + 1
        }
        check{ &io, &r, ok = rest_zero, what = "globals: the unused location slots are zero" }
    }

    // Back into a fresh catalogue: every value as it was.
    let mut g2 = try globals::make{ heap = &h, table = w.tables.globalcat }
    try save::read_globals{ g = &g2, doc = &doc2 }
    let bad = globals_differing{ a = g, b = &g2 }
    check{ &io, &r, ok = bad == 0, what = "globals: round trip" }
    check{ &io, &r, ok = globals::number{ g = &g2, name = n0.name } == -5 and globals::number{ g = &g2, name = n2.name } == -128 and globals::boolean{ g = &g2, name = blast.name }
        and slice::eq_bytes{ a = globals::string{ g = &g2, name = s0.name }, b = "hello, save" }, what = "globals: values by name" }
    _ = @fmt(&io, "globals: round trip differs in {} of {}\n", bad, g.all.len)
}

// ---- PARTYTABLE.res

// Whether the party holds what a party table says, read field by field from the file: the purse,
// the XP pool, solo mode, each of the nine NPC slots' availability and selectability, and the
// members (NPC slots, in order) with the leader among them (-1: the PC leads).
fn party_matches { w: *world::World, doc: *gff::Doc } -> bool {
    let root = gff::ROOT
    if @as(i64, w.party.gold) != (gff::get_number{ doc = doc.*, s = root, label = "PT_GOLD" } ifnull -1) { return false }
    if @as(i64, w.party.xp_pool) != (gff::get_number{ doc = doc.*, s = root, label = "PT_XP_POOL" } ifnull -1) { return false }
    if w.party.solo != ((gff::get_number{ doc = doc.*, s = root, label = "PT_SOLOMODE" } ifnull 0) != 0) { return false }
    let avail = gff::get_list{ doc = doc.*, s = root, label = "PT_AVAIL_NPCS" } ifnull slice::empty(u32){}
    if avail.len != 9 { return false }
    let mut k: usize = 0
    while k < 9 {
        if w.party.available[k] != ((gff::get_number{ doc = doc.*, s = avail[k], label = "PT_NPC_AVAIL" } ifnull 0) != 0) { return false }
        if w.party.selectable[k] != ((gff::get_number{ doc = doc.*, s = avail[k], label = "PT_NPC_SELECT" } ifnull 0) != 0) { return false }
        k = k + 1
    }
    let members = gff::get_list{ doc = doc.*, s = root, label = "PT_MEMBERS" } ifnull slice::empty(u32){}
    if w.party.saved_count != members.len or @as(i64, members.len) != (gff::get_number{ doc = doc.*, s = root, label = "PT_NUM_MEMBERS" } ifnull -1) { return false }
    let mut leader: i32 = -1
    k = 0
    while k < members.len {
        let id = gff::get_number{ doc = doc.*, s = members[k], label = "PT_MEMBER_ID" } ifnull -1
        if @as(i64, w.party.saved_slots[k]) != id { return false }
        if (gff::get_number{ doc = doc.*, s = members[k], label = "PT_IS_LEADER" } ifnull 0) != 0 { leader = w.party.saved_slots[k] }
        k = k + 1
    }
    return w.party.saved_leader == leader
}

fn test_party { mut io: Io, mut fs: Fs, mut h: heap::Heap, mut r: Report, w: *mut world::World, save_dir: []u8, out_dir: []u8 } -> ! {
    let data = try read_file{ &fs, &h, dir = save_dir, name = "PARTYTABLE.res" }
    let doc = try gff::parse{ data, realloc = heap::alloc, heap = &h }
    try save::read_party_table{ w, doc = &doc }
    _ = @fmt(&io, "party: gold {} solo {} member slots {} leader slot {}\n", w.party.gold, w.party.solo, w.party.saved_count, w.party.saved_leader)
    check{ &io, &r, ok = party_matches{ w, doc = &doc }, what = "party: read the install's table" }

    // The loader spawns each listed slot's creature and puts the party together, the leader first
    // (the PC when no NPC leads); here, made-up ids.
    let pc: u32 = 0x7FFFFFFF
    let played = gff::get_dword{ doc, s = gff::ROOT, label = "PT_PLAYEDSECONDS" } ifnull 0
    if w.party.saved_leader >= 0 {
        let slot = @as(usize, w.party.saved_leader)
        w.party.npcs[slot] = 0x7F000100 + @as(u32, slot)
        _ = party::add{ w, id = w.party.npcs[slot] }
    }
    _ = party::add{ w, id = pc }
    let mut m: usize = 0
    while m < w.party.saved_count {
        let slot = @as(usize, w.party.saved_slots[m])
        if w.party.saved_slots[m] != w.party.saved_leader {
            w.party.npcs[slot] = 0x7F000100 + @as(u32, slot)
            _ = party::add{ w, id = w.party.npcs[slot] }
        }
        m = m + 1
    }
    let bytes = try save::write_party_table{ realloc = heap::alloc, heap = &h, w, played_seconds = played }
    try write_file{ &fs, &h, dir = out_dir, name = "PARTYTABLE.res", bytes }
    let doc2 = try gff::parse{ data = bytes, realloc = heap::alloc, heap = &h }
    _ = @fmt(&io, "party: wrote {} bytes (the install's file is {}, with its message logs)\n", bytes.len, data.len)
    check{ &io, &r, ok = same_shape{ a = &doc, b = &doc2 }, what = "party: same fields as the install's, in order" }
    let items = twoda::rows{ t = w.tables.baseitems }
    check{ &io, &r, ok = list_len{ doc = &doc2, s = gff::ROOT, label = "PT_COST_MULT_LIS" } == items and items == list_len{ doc = &doc, s = gff::ROOT, label = "PT_COST_MULT_LIS" }, what = "party: one cost multiplier per baseitems row, as the install's" }
    // The Messages logs come back as they were read (combat.md 10.1): both lists, in order, colours kept.
    let fb_a = gff::get_list{ doc = doc, s = gff::ROOT, label = "PT_FB_MSG_LIST" } ifnull slice::empty(u32){}
    let fb_b = gff::get_list{ doc = doc2, s = gff::ROOT, label = "PT_FB_MSG_LIST" } ifnull slice::empty(u32){}
    let mut same_fb = fb_a.len == fb_b.len and fb_a.len > 0
    let mut fi: usize = 0
    while same_fb and fi < fb_a.len {
        let ta = gff::get_string{ doc = doc, s = fb_a[fi], label = "PT_FB_MSG_MSG" } ifnull ""
        let tb = gff::get_string{ doc = doc2, s = fb_b[fi], label = "PT_FB_MSG_MSG" } ifnull ""
        let ca = gff::get_number{ doc = doc, s = fb_a[fi], label = "PT_FB_MSG_COLOR" } ifnull 9
        let cb = gff::get_number{ doc = doc2, s = fb_b[fi], label = "PT_FB_MSG_COLOR" } ifnull 9
        if ta.len > 0 { same_fb = slice::eq_bytes{ a = ta, b = tb } and ca == cb }
        fi = fi + 1
    }
    _ = @fmt(&io, "party: {} feedback and {} dialogue lines kept\n", fb_b.len, list_len{ doc = &doc2, s = gff::ROOT, label = "PT_DLG_MSG_LIST" })
    check{ &io, &r, ok = same_fb and list_len{ doc = &doc2, s = gff::ROOT, label = "PT_DLG_MSG_LIST" } == list_len{ doc = &doc, s = gff::ROOT, label = "PT_DLG_MSG_LIST" }, what = "party: the message logs round-trip" }
    check{ &io, &r, ok = list_len{ doc = &doc2, s = gff::ROOT, label = "PT_AVAIL_NPCS" } == 9 and list_len{ doc = &doc2, s = gff::ROOT, label = "PT_PAZSIDELIST" } == 10 and list_len{ doc = &doc2, s = gff::ROOT, label = "PT_MEMBERS" } == w.party.saved_count, what = "party: list sizes" }
    let cards = gff::get_list{ doc = doc2, s = gff::ROOT, label = "PT_PAZAAKCARDS" } ifnull slice::empty(u32){}
    check{ &io, &r, ok = cards.len == 19 and gff::get_int{ doc = doc2, s = cards[0], label = "PT_PAZAAKCOUNT" } != null and gff::get_int{ doc = doc2, s = cards[17], label = "PT_PAZAAKCOUNT" } != null and gff::get_byte{ doc = doc2, s = cards[18], label = "PT_PAZAAKCOUNT" } != null, what = "party: pazaak is 18 INTs and a BYTE" }
    check{ &io, &r, ok = played > 0 and (gff::get_dword{ doc = doc2, s = gff::ROOT, label = "PT_PLAYEDSECONDS" } ifnull 0) == played, what = "party: seconds played" }
    // Everything the install's table holds comes back as it was: the members, the purse, the
    // galaxy map, pazaak, the tutorial bits, the logs, the cost multipliers, the journal.
    let mut shown: u32 = 0
    let differing = count_differences{ &io, a = &doc, sa = gff::ROOT, b = &doc2, sb = gff::ROOT, parent = "party", skip = slice::empty([]u8){}, &shown }
    _ = @fmt(&io, "party: written back, {} fields differ from the install's\n", differing)
    check{ &io, &r, ok = differing == 0, what = "party: the install's table written back, every field as it was" }

    w.party = party::new{}
    try save::read_party_table{ w, doc = &doc2 }
    check{ &io, &r, ok = party_matches{ w, doc = &doc }, what = "party: round trip" }

    // Another party: an NPC leads and a second follows; solo, a bigger purse, other slots open.
    w.party = party::new{}
    w.party.gold = 12345
    w.party.xp_pool = -3
    w.party.solo = true
    w.party.available[3] = true
    w.party.available[5] = true
    w.party.selectable[0] = true
    w.party.selectable[3] = true
    w.party.selectable[5] = false
    w.party.npcs[3] = 0x7F000103
    w.party.npcs[5] = 0x7F000105
    _ = party::add{ w, id = 0x7F000103 }
    _ = party::add{ w, id = 0x7F000105 }
    _ = party::add{ w, id = pc }
    let bytes2 = try save::write_party_table{ realloc = heap::alloc, heap = &h, w, played_seconds = 7 }
    let doc3 = try gff::parse{ data = bytes2, realloc = heap::alloc, heap = &h }
    w.party = party::new{}
    try save::read_party_table{ w, doc = &doc3 }
    check{ &io, &r, ok = w.party.gold == 12345 and w.party.xp_pool == -3 and w.party.solo and w.party.available[3] and w.party.available[5] and not w.party.available[0], what = "party: second table, purse and availability" }
    check{ &io, &r, ok = w.party.selectable[3] and not w.party.selectable[5] and w.party.selectable[0], what = "party: second table, selectable" }
    check{ &io, &r, ok = w.party.saved_count == 2 and w.party.saved_slots[0] == 3 and w.party.saved_slots[1] == 5 and w.party.saved_leader == 3, what = "party: second table, members and leader" }
}

// ---- Screen.tga

fn test_screenshot { mut io: Io, mut fs: Fs, mut h: heap::Heap, mut r: Report, save_dir: []u8, out_dir: []u8 } -> ! {
    // The install's own thumbnail, as the screen the game would have read: thumbnailing it at its
    // own size has to give it back.
    let orig = try read_file{ &fs, &h, dir = save_dir, name = "Screen.tga" }
    check{ &io, &r, ok = orig.len == 18 + 256 * 256 * 3, what = "screenshot: the install's Screen.tga is 18 + 256 * 256 * 3 bytes" }
    if orig.len == 18 + 256 * 256 * 3 {
        let rgba = try alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = &h, mem = slice::empty(u8){}, count = 256 * 256 * 4 }
        let mut row: usize = 0
        while row < 256 {
            let mut x: usize = 0
            while x < 256 {
                let from = 18 + (row * 256 + x) * 3
                let to = ((255 - row) * 256 + x) * 4
                rgba[to] = orig[from + 2]
                rgba[to + 1] = orig[from + 1]
                rgba[to + 2] = orig[from]
                rgba[to + 3] = 255
                x = x + 1
            }
            row = row + 1
        }
        let tga = try save::write_screenshot{ realloc = heap::alloc, heap = &h, rgba, width = 256, height = 256 }
        try write_file{ &fs, &h, dir = out_dir, name = "Screen.tga", bytes = tga }
        check{ &io, &r, ok = tga.len == orig.len and slice::eq_bytes{ a = tga[..18], b = orig[..18] }, what = "screenshot: header is the install's" }
        check{ &io, &r, ok = slice::eq_bytes{ a = tga, b = orig }, what = "screenshot: 256 x 256 in, the install's file out, byte for byte" }
    }

    // A wide screen in four colours: red top left, green top right, blue bottom left, white
    // bottom right; the file runs bottom up.
    let sw: u32 = 1280
    let sh: u32 = 720
    let screen = try alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = &h, mem = slice::empty(u8){}, count = 1280 * 720 * 4 }
    let mut y: usize = 0
    while y < 720 {
        let mut x: usize = 0
        while x < 1280 {
            let p = (y * 1280 + x) * 4
            let right = x >= 640
            let bottom = y >= 360
            screen[p] = if bottom and not right { 0 } else if not bottom and right { 0 } else { 255 }
            screen[p + 1] = if bottom and not right { 0 } else if not bottom and not right { 0 } else { 255 }
            screen[p + 2] = if bottom { 255 } else { 0 }
            screen[p + 3] = 255
            x = x + 1
        }
        y = y + 1
    }
    let tga = try save::write_screenshot{ realloc = heap::alloc, heap = &h, rgba = screen, width = sw, height = sh }
    // Pixel (x, y) of the thumbnail, from the top, as blue, green, red.
    let top_left = 18 + ((255 - 10) * 256 + 10) * 3
    let top_right = 18 + ((255 - 10) * 256 + 245) * 3
    let bottom_left = 18 + ((255 - 245) * 256 + 10) * 3
    let bottom_right = 18 + ((255 - 245) * 256 + 245) * 3
    check{ &io, &r, ok = tga.len == 18 + 256 * 256 * 3 and tga[0] == 0 and tga[2] == 2 and tga[13] == 1 and tga[15] == 1 and tga[16] == 24, what = "screenshot: header of a 256 x 256, 24-bit, type 2 TGA" }
    check{ &io, &r, ok = tga[top_left] == 0 and tga[top_left + 1] == 0 and tga[top_left + 2] == 255, what = "screenshot: top left is red" }
    check{ &io, &r, ok = tga[top_right] == 0 and tga[top_right + 1] == 255 and tga[top_right + 2] == 0, what = "screenshot: top right is green" }
    check{ &io, &r, ok = tga[bottom_left] == 255 and tga[bottom_left + 1] == 0 and tga[bottom_left + 2] == 0, what = "screenshot: bottom left is blue" }
    check{ &io, &r, ok = tga[bottom_right] == 255 and tga[bottom_right + 1] == 255 and tga[bottom_right + 2] == 255, what = "screenshot: bottom right is white" }
    try write_file{ &fs, &h, dir = out_dir, name = "Screen_wide.tga", bytes = tga }

    // A screen smaller than the thumbnail is stretched, and nothing is read out of range.
    let tiny = [10, 20, 30, 255, 40, 50, 60, 255]
    let up = try save::write_screenshot{ realloc = heap::alloc, heap = &h, rgba = tiny[..], width = 2, height = 1 }
    check{ &io, &r, ok = up.len == 18 + 256 * 256 * 3 and up[18] == 30 and up[18 + 255 * 3] == 60, what = "screenshot: a 2 x 1 screen is stretched" }
    let bad = match save::write_screenshot{ realloc = heap::alloc, heap = &h, rgba = tiny[..], width = 4, height = 4 } {
        ok => { false }
        save::bad_screenshot => { true }
        else => { false }
    }
    check{ &io, &r, ok = bad, what = "screenshot: too few pixels is an error" }
}
