// The build program for movietest: `kotor/tools/ctxc run kotor/tools/movietest -- NAME [--at S ...]`.
//
// Only the libraries a movie needs: the decoder, the mixer and its device, the render seam with the
// GL backend, and the player itself (lib/frontend/movie, not the rest of lib/frontend).
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "movietest", root = "." }
    build::add_sources{ &b, exe, dir = "../../lib/base" }
    build::add_sources{ &b, exe, dir = "../../lib/video" }
    build::add_sources{ &b, exe, dir = "../../lib/audio" }
    build::add_sources{ &b, exe, dir = "../../lib/platform" }
    build::add_sources{ &b, exe, dir = "../../lib/render" }
    build::add_sources{ &b, exe, dir = "../../lib/render_gl" }
    build::add_sources{ &b, exe, dir = "../../lib/frontend/movie" }
    build::add_sources{ &b, exe, dir = "../common" }
    build::optimize{ &b, exe, level = 2 }
    match build::os{ &b } {
        macos => {
            build::lib_path{ &b, exe, path = "/opt/homebrew/lib" }
            build::link{ &b, exe, lib = "SDL2" }
        }
        windows => { build::link{ &b, exe, lib = "SDL2" } }
        linux => { build::link{ &b, exe, lib = "SDL2" } }
    }
}
