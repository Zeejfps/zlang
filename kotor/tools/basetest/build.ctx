// Unit checks for lib/base: `kotor/tools/ctxc run kotor/tools/basetest`. Exits 1 on any failure.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "basetest", root = "." }
    build::add_sources{ &b, exe, dir = "../../lib/base" }
    build::add_sources{ &b, exe, dir = "../common" }
}
