// The build program for texcheck: `kotor/tools/ctxc run kotor/tools/texcheck -- [DIR] [options]`.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "texcheck", root = "." }
    build::add_sources{ &b, exe, dir = "../../lib/base" }
    build::add_sources{ &b, exe, dir = "../../lib/tex" }
    build::optimize{ &b, exe, level = 2 }
}
