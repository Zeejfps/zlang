// resls: list and extract the game's resources through lib/res's resource manager.
//   kotor/tools/ctxc run kotor/tools/resls -- [--game DIR] [--module NAME] ...
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "resls", root = "." }
    build::add_sources{ &b, exe, dir = "../../lib/base" }
    build::add_sources{ &b, exe, dir = "../../lib/res" }
    build::add_sources{ &b, exe, dir = "../../lib/formats" }
    build::add_sources{ &b, exe, dir = "../common" }
}
