// ncsrun: runs NCS scripts on the stub engine (lib/script/nwstub.ctx) and reports how they end.
//
//   kotor/tools/ctxc run kotor/tools/ncsrun -- [OPTIONS]            every script in the game
//   kotor/tools/ctxc run kotor/tools/ncsrun -- PATH... [OPTIONS]    .ncs files, or directories of them
//
// Without paths, the scripts come through the resource manager (lib/res): every NCS the global
// search finds, then each module's own (its _s.rim or .mod), mounting the modules one by one;
// each content runs once, however many places hold it.
//
// Each script runs from its entry as object nwstub::SELF; then the actions it handed to
// AssignCommand, DelayCommand and ActionDoCommand run, oldest first, with those they hand on in
// turn (up to --actions per script). A run ends normally or faults; faults are counted in three
// classes: the VM's own (the bytecode did something the VM refuses), a routine's (its arguments
// weren't what the prototype says, which only scripts compiled against an older nwscript.nss
// do), and the instruction budget (a script that runs away on the stub's results). The time is
// the runs' alone (not reading or decoding files), at -O2.
//
// Options: --game DIR (F:/Steam/steamapps/common/swkotor), -v (each run's routine calls and how
// it ends), --results (a line per run, for tools/py/ncsvmtest.py), --execute (with paths: the
// stub's ExecuteScript runs any script the paths name, nested), --actions N (32), --show N
// (faults listed per class, 20), --repeat N (run every script N times, for timing), --budget N
// (instructions per run; the game's is 131072).

struct Options {
    game: []u8,
    verbose: bool,
    results: bool,
    execute: bool,
    actions: usize,
    show: u64,
    repeat: u32,
    budget: u32,
}

const DEFAULT_GAME: []u8 = "F:/Steam/steamapps/common/swkotor"

// How runs ended.
struct Tally {
    runs: u64,
    ok: u64,
    vm: u64,                    // VM faults
    routine: u64,               // routine faults
    budget: u64,                // ran out of instructions
    kinds: [24]u64,             // VM faults by nwvm::FaultKind
}

struct Report {
    scripts: Tally,
    actions: Tally,
    shown: Tally,               // faults printed so far, by class
    files: u64,                 // scripts found
    unique: u64,                // scripts run: distinct contents
    failed: u64,                // couldn't be read or decoded
    ticks: u64,                 // counter ticks spent running
}

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, mut sdl: sdl::Sdl, args: Args } -> i32 {
    let base = mem::pages{ &mem, size = 268435456 } ifnull { return out_of_memory{ &io } }
    let mut keep = arena::new{ buf = base }                    // for the whole run
    let scratch = mem::pages{ &mem, size = 134217728 } ifnull { return out_of_memory{ &io } }
    let mut work = arena::new{ buf = scratch }                 // one script at a time
    let mut opts = Options{
        game = DEFAULT_GAME, verbose = false, results = false, execute = false, actions = 32, show = 20, repeat = 1,
        budget = nwvm::LIMITS.budget,
    }
    let mut paths = list::new([]u8, arena::Arena){ realloc = arena::alloc, heap = &keep }
    let mut i: usize = 0
    while i < args.len {
        let a = args[i]
        if slice::eq_bytes{ a, b = "-v" } {
            opts.verbose = true
        } else if slice::eq_bytes{ a, b = "--results" } {
            opts.results = true
        } else if slice::eq_bytes{ a, b = "--execute" } {
            opts.execute = true
        } else if slice::eq_bytes{ a, b = "--game" } {
            if i + 1 >= args.len { return usage{ &io } }
            opts.game = args[i + 1]
            i = i + 1
        } else if slice::eq_bytes{ a, b = "--actions" } or slice::eq_bytes{ a, b = "--show" } or
            slice::eq_bytes{ a, b = "--repeat" } or slice::eq_bytes{ a, b = "--budget" } {
            if i + 1 >= args.len { return usage{ &io } }
            let text = utf8::from{ bytes = args[i + 1] } iferr { return usage{ &io } }
            let n = utf8::parse_u64{ s = text } ifnull { return usage{ &io } }
            if slice::eq_bytes{ a, b = "--actions" } { opts.actions = @as(usize, n) }
            else if slice::eq_bytes{ a, b = "--show" } { opts.show = n }
            else if slice::eq_bytes{ a, b = "--repeat" } { opts.repeat = @trunc(u32, n) }
            else { opts.budget = @trunc(u32, n) }
            i = i + 1
        } else if a.len > 0 and a[0] == '-' {
            return usage{ &io }
        } else {
            list::push{ list = &paths, item = a } iferr { return out_of_memory{ &io } }
        }
        i = i + 1
    }

    let mut limits = nwvm::LIMITS
    limits.budget = opts.budget
    let mut vm = nwvm::new(arena::Arena){ realloc = arena::alloc, heap = &keep, limits } iferr { return out_of_memory{ &io } }
    let log = if opts.verbose {
        arena::alloc{ heap = &keep, mem = slice::empty(u8){}, new = 1048576, align = 1 } ifnull { return out_of_memory{ &io } }
    } else {
        slice::empty(u8){}
    }
    let mut stub = nwstub::new{ heap = &work, actions = opts.actions, log }
    let stub_at = &stub
    let engine = nwstub::call{ &stub, _ }
    let mut report = Report{
        scripts = no_tally{}, actions = no_tally{}, shown = no_tally{}, files = 0, unique = 0, failed = 0, ticks = 0,
    }

    if opts.execute and paths.len > 0 {
        stub.scripts = preload{ &io, &fs, &keep, paths = list::items{ list = paths } } ifnull { return out_of_memory{ &io } }
    }
    let code = if paths.len > 0 {
        from_paths{ &io, &fs, &sdl, &vm, &work, &keep, &report, stub = stub_at, opts, engine, paths = list::items{ list = paths } }
    } else {
        from_game{ &io, &fs, &mem, &sdl, &vm, &work, &keep, &report, stub = stub_at, opts, engine }
    }
    if code != 0 { return code }

    let seconds = @as(f64, report.ticks) / @as(f64, sdl::counter_frequency{ &sdl })
    _ = @fmt(&io, "\nscripts: {} found, {} distinct run, {} failed to load\n", report.files, report.unique, report.failed)
    summary{ &io, what = "script runs", t = report.scripts }
    summary{ &io, what = "action runs", t = report.actions }
    _ = @fmt(&io, "dropped actions (over --actions): {}\n", stub.dropped)
    _ = @fmt(&io, "routine calls: {}\n", stub.calls)
    let rate = if seconds > 0.0 { @as(f64, vm.total) / seconds / 1000000.0 } else { 0.0 }
    _ = @fmt(&io, "instructions: {} in {} ms: {} million instructions per second\n",
        vm.total, @as(u64, seconds * 1000.0), @as(u64, rate * 10.0) / 10)
    io::flush{ &io }
    return if report.scripts.vm + report.actions.vm > 0 { 1 } else { 0 }
}


fn no_tally {} -> Tally {
    return Tally{ runs = 0, ok = 0, vm = 0, routine = 0, budget = 0, kinds = [0; 24] }
}

// --execute: every script the paths name, decoded and kept, for the stub's ExecuteScript.
fn preload { mut io: Io, mut fs: Fs, mut keep: arena::Arena, paths: [][]u8 } -> ?[]nwvm::Program {
    let mut programs = list::new(nwvm::Program, arena::Arena){ realloc = arena::alloc, heap = &keep }
    let mut i: usize = 0
    while i < paths.len {
        let p = paths[i]
        i = i + 1
        if ends_with{ s = p, suffix = ".sit" } { continue }
        let mut files = list::new([]u8, arena::Arena){ realloc = arena::alloc, heap = &keep }
        if ends_with{ s = p, suffix = ".ncs" } {
            list::push{ list = &files, item = p } iferr { return null }
        } else {
            let names = fs::list{ &fs, heap = &keep, realloc = arena::alloc, path = p } iferr { continue }
            let mut k: usize = 0
            while k < names.len {
                if ends_with{ s = names[k], suffix = ".ncs" } {
                    let joined = join{ heap = &keep, dir = p, name = names[k] } ifnull { return null }
                    list::push{ list = &files, item = joined } iferr { return null }
                }
                k = k + 1
            }
        }
        let mut k: usize = 0
        while k < files.len {
            let path = list::items{ list = files }[k]
            k = k + 1
            let bytes = fs::read_all{ &fs, heap = &keep, realloc = arena::alloc, path } iferr { continue }
            let program = nwvm::load(arena::Arena){ realloc = arena::alloc, heap = &keep, name = script_name{ path }, bytes } iferr { continue }
            list::push{ list = &programs, item = program } iferr { return null }
        }
    }
    return list::items{ list = programs }
}

// Every .ncs file given, or found in a directory given, in name order.
fn from_paths {
    mut io: Io, mut fs: Fs, mut sdl: sdl::Sdl, mut vm: nwvm::Vm, mut work: arena::Arena, mut keep: arena::Arena,
    mut report: Report, stub: *mut nwstub::Stub, opts: Options, engine: nwvm::Engine, paths: [][]u8,
} -> i32 {
    let mut i: usize = 0
    while i < paths.len {
        let p = paths[i]
        i = i + 1
        if ends_with{ s = p, suffix = ".ncs" } {
            from_file{ &io, &fs, &sdl, &vm, &work, &report, stub, opts, engine, path = p }
            continue
        }
        if ends_with{ s = p, suffix = ".sit" } {
            from_situation{ &io, &fs, &sdl, &vm, &work, &report, stub, opts, engine, path = p }
            continue
        }
        let names = fs::list{ &fs, heap = &keep, realloc = arena::alloc, path = p } iferr err{ error } {
            _ = @fmt(&io, "ncsrun: {}: {}\n", p, error)
            return 1
        }
        let mut k: usize = 0
        while k < names.len {
            if ends_with{ s = names[k], suffix = ".ncs" } {
                let joined = join{ heap = &keep, dir = p, name = names[k] } ifnull { return out_of_memory{ &io } }
                from_file{ &io, &fs, &sdl, &vm, &work, &report, stub, opts, engine, path = joined }
            }
            k = k + 1
        }
    }
    return 0
}

fn from_file {
    mut io: Io, mut fs: Fs, mut sdl: sdl::Sdl, mut vm: nwvm::Vm, mut work: arena::Arena, mut report: Report,
    stub: *mut nwstub::Stub, opts: Options, engine: nwvm::Engine, path: []u8,
} {
    nwstub::clear{ stub }
    arena::reset{ heap = &work }
    report.files = report.files + 1
    let bytes = fs::read_all{ &fs, heap = &work, realloc = arena::alloc, path } iferr err{ error } {
        _ = @fmt(&io, "{}: {}\n", path, error)
        report.failed = report.failed + 1
        return
    }
    run_script{ &io, &sdl, &vm, &work, &report, stub, opts, engine, name = script_name{ path }, bytes }
}

error bad_situation{ at: usize }

// A saved game's action (tools/py/ncssituations.py writes NAME.sit and NAME.ncs): rebuilt with
// nwvm::make_situation, checked to give back the fields it was made from, and resumed.
fn from_situation {
    mut io: Io, mut fs: Fs, mut sdl: sdl::Sdl, mut vm: nwvm::Vm, mut work: arena::Arena, mut report: Report,
    stub: *mut nwstub::Stub, opts: Options, engine: nwvm::Engine, path: []u8,
} {
    nwstub::clear{ stub }
    arena::reset{ heap = &work }
    report.files = report.files + 1
    let name = script_name{ path }
    load_situation{ &io, &fs, &sdl, &vm, &work, &report, stub, opts, engine, path, name } iferr err{ error } {
        _ = @fmt(&io, "{}: {}\n", path, error)
        report.failed = report.failed + 1
    }
}

fn load_situation {
    mut io: Io, mut fs: Fs, mut sdl: sdl::Sdl, mut vm: nwvm::Vm, mut work: arena::Arena, mut report: Report,
    stub: *mut nwstub::Stub, opts: Options, engine: nwvm::Engine, path: []u8, name: []u8,
} -> ! {
    let data = try fs::read_all{ &fs, heap = &work, realloc = arena::alloc, path }
    let code_path = copy{ heap = &work, b = path } ifnull { return alloc::out_of_memory }
    slice::copy(u8){ dst = code_path[code_path.len - 3..], src = "ncs" }
    let bytes = try fs::read_all{ &fs, heap = &work, realloc = arena::alloc, path = code_path }
    let program = try nwvm::load(arena::Arena){ realloc = arena::alloc, heap = &work, name, bytes }
    let mut r = le::reader{ data }
    let ip = try le::read_u32{ &r }
    let bp = try le::read_u32{ &r }
    let stack_size = try le::read_u32{ &r }
    let n = @as(usize, try le::read_u32{ &r })
    let cells = try alloc::resize(nwvm::SavedCell, arena::Arena){ realloc = arena::alloc, heap = &work, mem = slice::empty(nwvm::SavedCell){}, count = n }
    let mut k: usize = 0
    while k < n {
        let tag = try le::read_u8{ &r }
        let v = try le::read_u32{ &r }
        cells[k] = if tag == nwvm::INT { nwvm::SavedCell::int{ v = ncs::i32_of_bits{ bits = v } } }
            else if tag == nwvm::FLOAT { nwvm::SavedCell::float{ v = ncs::f32_of_bits{ bits = v } } }
            else if tag == nwvm::OBJECT { nwvm::SavedCell::object{ id = v } }
            else if tag == nwvm::STRING {
                let at = r.pos
                if not le::fits{ data, at, want = @as(usize, v) } { return bad_situation{ at } }
                r.pos = at + @as(usize, v)
                nwvm::SavedCell::string{ s = data[at..at + @as(usize, v)] }
            }
            else if tag >= nwvm::EFFECT and tag <= nwvm::TALENT { nwvm::SavedCell::engine{ kind = @as(nwvm::EngineType, tag - nwvm::EFFECT), handle = v } }
            else { return bad_situation{ at = r.pos } }
        k = k + 1
    }
    let s = try nwvm::make_situation(arena::Arena){
        realloc = arena::alloc, heap = &work, program = &program, instruction_ptr = ip, base_pointer = bp, stack_size, cells,
    }
    // It must give back what it was made from, as a save would write it again.
    if nwvm::instruction_ptr{ situation = s } != ip or s.bp != bp or s.stack_size != stack_size or s.types.len != n {
        return bad_situation{ at = 0 }
    }
    k = 0
    while k < n {
        if not same_cell{ a = nwvm::saved_cell{ situation = s, i = k }, b = cells[k] } { return bad_situation{ at = k } }
        k = k + 1
    }
    report.unique = report.unique + 1
    if opts.verbose { _ = @fmt(&io, "{}: {} cells, BP {}, resuming at {}\n", name, n, bp, ip) }
    let mut line: [512]u8
    let t0 = sdl::counter{ &sdl }
    let done = nwvm::resume{ &vm, situation = s, self = nwstub::SELF, engine }
    report.ticks = report.ticks + (sdl::counter{ &sdl } - t0)
    flush_log{ &io, stub }
    let fine = match done { ok => { true } err => { false } }
    if opts.results { result{ &io, name, what = "action", vm, ok = fine, value = null } }
    tally{ &io, t = &report.actions, shown = &report.shown, vm, ok = fine, opts, line = line[..] }
}

fn same_cell { a: nwvm::SavedCell, b: nwvm::SavedCell } -> bool {
    return match a {
        int{ v = x } => { match b { int{ v } => { v == x } else => { false } } }
        float{ v = x } => { match b { float{ v } => { ncs::bits_of_f32{ f = v } == ncs::bits_of_f32{ f = x } } else => { false } } }
        string{ s = x } => { match b { string{ s } => { slice::eq_bytes{ a = s, b = x } } else => { false } } }
        object{ id = x } => { match b { object{ id } => { id == x } else => { false } } }
        engine{ kind = j, handle = x } => { match b { engine{ kind, handle } => { kind == j and handle == x } else => { false } } }
    }
}

// Every script in the game through the resource manager: the global search's, then each
// module's own. Each distinct content runs once.
fn from_game {
    mut io: Io, mut fs: Fs, mut mem: Mem, mut sdl: sdl::Sdl, mut vm: nwvm::Vm, mut work: arena::Arena,
    mut keep: arena::Arena, mut report: Report, stub: *mut nwstub::Stub, opts: Options, engine: nwvm::Engine,
} -> i32 {
    let mut h = heap::new{ &mem }
    let mut rm = res::open{ &fs, heap = &h, game = opts.game } iferr err{ error } {
        _ = @fmt(&io, "ncsrun: can't open the game at {}: {}\n", opts.game, error)
        return 1
    }
    defer res::close{ &fs, &rm }
    let mut seen = map::new(u64, u8, arena::Arena){ realloc = arena::alloc, heap = &keep, hash = map::hash_u64, eq = map::eq_u64 }

    // The global search's scripts, then each module's: modules/ holds <m>.rim and <m>_s.rim, or
    // <m>.mod.
    from_search{ &io, &fs, &sdl, &vm, &work, &report, &seen, &h, rm, stub, opts, engine, module = false } iferr { return out_of_memory{ &io } }
    let names = fs::list{ &fs, heap = &keep, realloc = arena::alloc, path = rm.dirs.modules } iferr err{ error } {
        _ = @fmt(&io, "ncsrun: {}: {}\n", rm.dirs.modules, error)
        return 1
    }
    let mut k: usize = 0
    while k < names.len {
        let n = names[k]
        k = k + 1
        let module = if ends_with{ s = n, suffix = "_s.rim" } or ends_with{ s = n, suffix = "_S.rim" } { n[..n.len - 6] }
            else if ends_with{ s = n, suffix = ".rim" } or ends_with{ s = n, suffix = ".mod" } { n[..n.len - 4] }
            else { continue }
        // modules/ lists each module up to three times (.rim, _s.rim, .mod): mount it once.
        if k >= 2 and same_module{ a = names[k - 2], b = module } { continue }
        res::mount_module{ &fs, &rm, name = module, save = "" } iferr err{ error } {
            _ = @fmt(&io, "ncsrun: can't mount module {}: {}\n", module, error)
            continue
        }
        from_search{ &io, &fs, &sdl, &vm, &work, &report, &seen, &h, rm, stub, opts, engine, module = true } iferr { return out_of_memory{ &io } }
    }
    res::unmount_module{ &fs, &rm }
    return 0
}

// Whether directory entry `a` belongs to module `b`.
fn same_module { a: []u8, b: []u8 } -> bool {
    if a.len < b.len { return false }
    if not ascii_eq{ a = a[..b.len], b } { return false }
    let rest = a[b.len..]
    return ascii_eq{ a = rest, b = ".rim" } or ascii_eq{ a = rest, b = "_s.rim" } or ascii_eq{ a = rest, b = ".mod" }
}

fn ascii_eq { a: []u8, b: []u8 } -> bool {
    if a.len != b.len { return false }
    let mut i: usize = 0
    while i < a.len {
        if ascii::to_lower{ c = a[i] } != ascii::to_lower{ c = b[i] } { return false }
        i = i + 1
    }
    return true
}

// The scripts the search finds now: with `module`, only those in the module's own archives.
fn from_search {
    mut io: Io, mut fs: Fs, mut sdl: sdl::Sdl, mut vm: nwvm::Vm, mut work: arena::Arena, mut report: Report,
    mut seen: map::Map(u64, u8, arena::Arena), mut h: heap::Heap, rm: res::Manager, stub: *mut nwstub::Stub,
    opts: Options, engine: nwvm::Engine, module: bool,
} -> ! {
    let found = try res::list_type{ rm, kind = restype::Type::ncs, realloc = heap::alloc, heap = &h }
    defer _ = alloc::resize(res::Found, heap::Heap){ realloc = heap::alloc, heap = &h, mem = found, count = 0 }
    let mut i: usize = 0
    while i < found.len {
        let f = found[i]
        i = i + 1
        let in_module = f.loc.class == res::Class::rim or f.loc.class == res::Class::erf2
        if module != in_module { continue }
        report.files = report.files + 1
        nwstub::clear{ stub }
        arena::reset{ heap = &work }
        let bytes = res::read{ &fs, rm, loc = f.loc, realloc = arena::alloc, heap = &work } iferr err{ error } {
            _ = @fmt(&io, "{}.ncs: {}\n", resref::bytes{ r = &f.name }, error)
            report.failed = report.failed + 1
            continue
        }
        let key = map::hash_bytes{ key = bytes } ^ @as(u64, bytes.len)
        if map::has{ m = seen, key } { continue }
        try map::put{ m = &seen, key, value = 1 }
        // The program views its name: a copy that lives as long as the script's arena.
        let name = copy{ heap = &work, b = resref::bytes{ r = &f.name } } ifnull { return alloc::out_of_memory }
        run_script{ &io, &sdl, &vm, &work, &report, stub, opts, engine, name, bytes }
    }
}

// Decodes one script, runs it and its actions, and counts how each run ends.
fn run_script {
    mut io: Io, mut sdl: sdl::Sdl, mut vm: nwvm::Vm, mut work: arena::Arena, mut report: Report,
    stub: *mut nwstub::Stub, opts: Options, engine: nwvm::Engine, name: []u8, bytes: []u8,
} {
    let program = nwvm::load(arena::Arena){ realloc = arena::alloc, heap = &work, name, bytes } iferr err{ error } {
        _ = @fmt(&io, "{}: {}\n", name, error)
        report.failed = report.failed + 1
        return
    }
    report.unique = report.unique + 1
    let mut line: [512]u8
    let mut r: u32 = 0
    while r < opts.repeat {
        r = r + 1
        nwstub::clear{ stub }
        if opts.verbose { _ = @fmt(&io, "{}:\n", name) }
        let t0 = sdl::counter{ &sdl }
        let ran = nwvm::run{ &vm, program = &program, self = nwstub::SELF, engine }
        report.ticks = report.ticks + (sdl::counter{ &sdl } - t0)
        flush_log{ &io, stub }
        let ok = match ran { ok => { true } err => { false } }
        if opts.results { result{ &io, name, what = "script", vm, ok, value = ran iferr { null } } }
        tally{ &io, t = &report.scripts, shown = &report.shown, vm, ok, opts, line = line[..] }
        // The actions it handed on, and theirs, oldest first.
        while true {
            let s = nwstub::next_action{ stub } ifnull { break }
            if opts.verbose { _ = @fmt(&io, "  action at {}:\n", nwvm::Hex{ n = s.program.at[s.resume] }) }
            let t1 = sdl::counter{ &sdl }
            let done = nwvm::resume{ &vm, situation = s, self = nwstub::SELF, engine }
            report.ticks = report.ticks + (sdl::counter{ &sdl } - t1)
            flush_log{ &io, stub }
            let fine = match done { ok => { true } err => { false } }
            if opts.results { result{ &io, name, what = "action", vm, ok = fine, value = null } }
            tally{ &io, t = &report.actions, shown = &report.shown, vm, ok = fine, opts, line = line[..] }
        }
    }
}

// With -v: the routine calls the stub logged.
fn flush_log { mut io: Io, stub: *mut nwstub::Stub } {
    if stub.log.len > 0 {
        io::write{ &io, to = io::Stream::out, bytes = stub.log.buf[..stub.log.len] }
        stub.log.len = 0
    }
}

// Counts one run's end, and prints its fault if it is among the first --show of its class (or
// with -v).
fn tally { mut io: Io, mut t: Tally, mut shown: Tally, vm: nwvm::Vm, ok: bool, opts: Options, line: []mut u8 } {
    t.runs = t.runs + 1
    if ok {
        t.ok = t.ok + 1
        if opts.verbose { _ = @fmt(&io, "  ended normally\n") }
        return
    }
    let f = vm.fault
    let mut print = opts.verbose
    if f.kind == nwvm::FaultKind::budget {
        t.budget = t.budget + 1
        shown.budget = shown.budget + 1
        print = print or shown.budget <= opts.show
    } else if f.routine >= 0 {
        t.routine = t.routine + 1
        shown.routine = shown.routine + 1
        print = print or shown.routine <= opts.show
    } else {
        t.vm = t.vm + 1
        t.kinds[@as(usize, f.kind)] = t.kinds[@as(usize, f.kind)] + 1
        shown.vm = shown.vm + 1
        print = print or shown.vm <= opts.show
    }
    if print {
        let text = nwvm::describe{ f, into = line }
        _ = @fmt(&io, "  fault: {}\n", text)
    }
}

// --results: one line per run, for tests (tools/py/ncsvmtest.py): RESULT, the name, script or
// action, then `ok` and the int the run left (or `none`), or `fault` and the fault's kind.
fn result { mut io: Io, name: []u8, what: []u8, vm: nwvm::Vm, ok: bool, value: ?i32 } {
    if not ok {
        _ = @fmt(&io, "RESULT\t{}\t{}\tfault\t{}\n", name, what, nwvm::kind_id{ kind = vm.fault.kind })
    } else if value != null {
        _ = @fmt(&io, "RESULT\t{}\t{}\tok\t{}\n", name, what, value)
    } else {
        _ = @fmt(&io, "RESULT\t{}\t{}\tok\tnone\n", name, what)
    }
}

fn summary { mut io: Io, what: []u8, t: Tally } {
    _ = @fmt(&io, "{}: {}: ended normally {}, VM faults {}, routine faults {}, out of budget {}\n",
        what, t.runs, t.ok, t.vm, t.routine, t.budget)
    let mut k: usize = 0
    while k < t.kinds.len {
        if t.kinds[k] > 0 {
            _ = @fmt(&io, "    {}: {}\n", nwvm::kind_name{ kind = @as(nwvm::FaultKind, @as(u8, k)) }, t.kinds[k])
        }
        k = k + 1
    }
}

// "dir/k_foo.ncs" -> "k_foo", and a situation's "dir/NAME.sit" -> "NAME"
fn script_name { path: []u8 } -> []u8 {
    let mut start: usize = 0
    let mut i: usize = 0
    while i < path.len {
        if path[i] == '/' or path[i] == '\\' { start = i + 1 }
        i = i + 1
    }
    let end = if ends_with{ s = path, suffix = ".ncs" } or ends_with{ s = path, suffix = ".sit" } { path.len - 4 } else { path.len }
    return path[start..end]
}

fn ends_with { s: []u8, suffix: []u8 } -> bool {
    return s.len >= suffix.len and slice::eq_bytes{ a = s[s.len - suffix.len..], b = suffix }
}

fn join { mut heap: arena::Arena, dir: []u8, name: []u8 } -> ?[]u8 {
    let out = arena::alloc{ &heap, mem = slice::empty(u8){}, new = dir.len + 1 + name.len, align = 1 } ifnull { return null }
    slice::copy(u8){ dst = out[..dir.len], src = dir }
    out[dir.len] = '/'
    slice::copy(u8){ dst = out[dir.len + 1..], src = name }
    return out
}

fn copy { mut heap: arena::Arena, b: []u8 } -> ?[]mut u8 {
    let out = arena::alloc{ &heap, mem = slice::empty(u8){}, new = b.len, align = 1 } ifnull { return null }
    slice::copy(u8){ dst = out, src = b }
    return out
}

fn usage { mut io: Io } -> i32 {
    io::eprintln{ &io, s = "usage: ncsrun [PATH...] [--game DIR] [-v] [--results] [--execute] [--actions N] [--show N] [--repeat N] [--budget N]" }
    return 2
}

fn out_of_memory { mut io: Io } -> i32 {
    io::eprintln{ &io, s = "ncsrun: out of memory" }
    return 1
}

namespace out {
    #write
    fn put_text { mut io: Io, s: strlit } { io::write{ &io, to = io::Stream::out, bytes = s.bytes } }
    #write
    fn put_bytes { mut io: Io, b: []u8 } { io::write{ &io, to = io::Stream::out, bytes = b } }
    #write
    fn put_mut_bytes { mut io: Io, b: []mut u8 } { io::write{ &io, to = io::Stream::out, bytes = b } }
    #write
    fn put_i32 { mut io: Io, n: i32 } { io::print_i64{ &io, n } }
    #write
    fn put_i64 { mut io: Io, n: i64 } { io::print_i64{ &io, n } }
    #write
    fn put_u32 { mut io: Io, n: u32 } { io::print_u64{ &io, n } }
    #write
    fn put_u64 { mut io: Io, n: u64 } { io::print_u64{ &io, n } }
    #write
    fn put_usize { mut io: Io, n: usize } { io::print_u64{ &io, n } }
    #write
    fn put_f64 { mut io: Io, n: f64 } { io::print_f64{ &io, n } }
    #write
    fn put_hex { mut io: Io, h: nwvm::Hex } {
        let mut buf: [16]u8
        let mut t = nwvm::Text{ buf = buf[..], len = 0 }
        nwvm::text_hex{ &t, h }
        io::write{ &io, to = io::Stream::out, bytes = buf[..t.len] }
    }
}
