// enginetest: lib/engine alone, headless and without rendering, for routine and script work
// that shouldn't wait for the scene to build: `kotor/tools/ctxc run kotor/tools/enginetest --
// --module end_m01aa --frames 300 --log routines --report routines`.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "enginetest", root = "." }
    build::add_sources{ &b, exe, dir = "../../lib/base" }
    build::add_sources{ &b, exe, dir = "../../lib/res" }
    build::add_sources{ &b, exe, dir = "../../lib/formats" }
    build::add_sources{ &b, exe, dir = "../../lib/mdl" }
    build::add_sources{ &b, exe, dir = "../../lib/walk" }
    build::add_sources{ &b, exe, dir = "../../lib/script" }
    build::add_sources{ &b, exe, dir = "../../lib/engine" }
    build::add_sources{ &b, exe, dir = "../../lib/dialog/core" }
    build::add_sources{ &b, exe, dir = "../../lib/save" }
    build::add_sources{ &b, exe, dir = "../../lib/rules" }
    build::add_sources{ &b, exe, dir = "../common" }
    build::optimize{ &b, exe, level = 2 }
}
