// The build program for pazaaksim: `kotor/tools/ctxc run kotor/tools/pazaaksim -- --games 2000`.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "pazaaksim", root = "." }
    build::add_sources{ &b, exe, dir = "../../lib/base" }
    build::add_sources{ &b, exe, dir = "../../lib/res" }
    build::add_sources{ &b, exe, dir = "../../lib/formats" }
    build::add_sources{ &b, exe, dir = "../../lib/pazaak/core" }
    build::optimize{ &b, exe, level = 2 }
}
