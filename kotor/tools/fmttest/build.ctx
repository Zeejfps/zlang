// Unit checks for lib/formats and lib/res on hand-made inputs and a few known resources:
// `kotor/tools/ctxc run kotor/tools/fmttest -- [--game DIR]`. Exits 1 on any failure.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "fmttest", root = "." }
    build::add_sources{ &b, exe, dir = "../../lib/base" }
    build::add_sources{ &b, exe, dir = "../../lib/res" }
    build::add_sources{ &b, exe, dir = "../../lib/formats" }
    build::add_sources{ &b, exe, dir = "../common" }
}
