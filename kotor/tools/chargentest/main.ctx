// menutest: drives the front end headless with a script of commands and writes PNGs of what
// it shows, to look at. Each argument after the options is one command:
//
//   kotor/tools/ctxc run kotor/tools/menutest -- shot:menu click:BTN_OPTIONS shot:options click:BTN_GRAPHICS shot:gfx
//
//   shot:NAME     one frame, saved as kotor/out/gui/menu_NAME.png
//   wait:N        N frames of 1/30 s
//   click:TAG     the pointer to the control tagged TAG on the top screen, pressed and released
//   move:TAG      the pointer onto it
//   key:CHARS     d u l r e x (down up left right enter escape), one key press each
//   slide:TAG:V   press at fraction V (0..100) along a slider
//   size:WxH      the window size (before the first command)
//
// Options: --movies (play the start-up movies; otherwise skipped), --game DIR, --out DIR.
// After each command that makes the front end say something other than "running", the outcome
// is printed (new game, load game, quit).

const DEFAULT_GAME: []u8 = "F:/Steam/steamapps/common/swkotor"

struct Options { game: []u8, out: []u8, movies: bool, audio: bool, first: usize }

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, mut sdl: sdl::Sdl, args: Args } -> i32 {
    let mut o = Options{ game = DEFAULT_GAME, out = "kotor/out/gui", movies = false, audio = false, first = args.len }
    let mut i: usize = 0
    while i < args.len {
        if slice::eq_bytes{ a = args[i], b = "--movies" } {
            o.movies = true
        } else if slice::eq_bytes{ a = args[i], b = "--audio" } {
            o.audio = true
        } else if slice::eq_bytes{ a = args[i], b = "--game" } and i + 1 < args.len {
            i = i + 1
            o.game = args[i]
        } else if slice::eq_bytes{ a = args[i], b = "--out" } and i + 1 < args.len {
            i = i + 1
            o.out = args[i]
        } else {
            o.first = i
            break
        }
        i = i + 1
    }
    let pages = mem::pages{ &mem, size = 536870912 } ifnull { return 1 }
    let scratch = mem::pages{ &mem, size = 134217728 } ifnull { return 1 }
    let mut heap = arena::new{ buf = pages }
    let mut h = heap::new{ &mem }
    run{ &io, &fs, &sdl, &heap, &h, scratch, o, args } iferr err{ error } {
        _ = @fmt(&io, "menutest: failed: {}\n", error)
        match error {
            gpu::shader_failed{ log } => { _ = @fmt(&io, "{}\n", log) }
            sdl::failed => { _ = @fmt(&io, "SDL: {}\n", sdl::last_error{ &sdl }) }
            else => {}
        }
        io::flush{ &io }
        return 1
    }
    io::flush{ &io }
    return 0
}

fn run {
    mut io: Io, mut fs: Fs, mut sdl: sdl::Sdl, mut heap: arena::Arena, mut h: heap::Heap, scratch: alloc::Bytes,
    o: Options, args: Args,
} -> ! {
    try sdl::init{ &sdl, flags = sdl::INIT_VIDEO | sdl::INIT_EVENTS }
    defer sdl::quit{ &sdl }
    let mut width: i32 = 800
    let mut height: i32 = 600
    let mut config = render::make_config{ title = "menutest", width, height, hidden = true }
    config.debug = true
    let mut dev = try gpu::open{ &sdl, realloc = arena::alloc, &heap, config }
    defer gpu::close{ &dev, &sdl }
    let mut frame = try render::make_frame(arena::Arena){ realloc = arena::alloc, &heap, cap = render::default_capacity{} }
    let mut rm = try res::open{ &fs, heap = &h, game = o.game }
    defer res::close{ &fs, &rm }
    let mut cache = material::new_cache{ heap = &h, scratch }
    defer material::free_cache{ &cache, &dev }
    let mut path_buf: [512]u8
    let tlk_path = frontend::join_path{ into = path_buf[..], a = o.game, b = "dialog.tlk", c = "" }
    let table = try tlk::load{ &fs, realloc = heap::alloc, heap = &h, path = tlk_path }
    defer tlk::free{ t = table, realloc = heap::alloc, heap = &h }
    let mut g = try gui::make{ heap = &h, rm, cache = &cache, width, height }
    defer gui::free{ &g }
    gui::set_tlk{ &g, table = &table }
    try gui::load_defaults{ &g, &fs, &dev }
    gui::set_cursor_visible{ &g, visible = false }
    make_dir{ &fs, path = o.out }

    let mut fe = frontend::make{ &fs, heap = &h, game = o.game, config_path = "kotor/out/menutest-settings.ini" }
    fe.settings.disable_movies = not o.movies
    // With --audio there is a mixer (no device): the GUI's sounds and the menu's music play into
    // it and it is rendered each frame, so a failing sound shows in its error count.
    let mut mixer: ?*mut mix::Mixer = null
    if o.audio {
        let m = try mix::make(heap::Heap){ realloc = heap::alloc, heap = &h, rate = 44100, voices_2d = 24, voices_3d = 16 }
        mixer = m
        gui::set_mixer{ &g, mixer = m }
    }
    fe.audio_clock = false
    try frontend::begin{ &fe, &g, &fs, &dev, &sdl, mixer }

    let mut k = o.first
    while k < args.len {
        let cmd = args[k]
        let mut colon: usize = 0
        while colon < cmd.len and cmd[colon] != ':' { colon = colon + 1 }
        let name = cmd[..colon]
        let arg: []u8 = if colon < cmd.len { cmd[colon + 1..] } else { "" }
        if slice::eq_bytes{ a = name, b = "size" } {
            let mut x: usize = 0
            while x < arg.len and arg[x] != 'x' { x = x + 1 }
            width = number{ s = arg[..x] }
            height = number{ s = arg[x + 1..] }
            try gpu::resize{ &dev, width = @as(u32, width), height = @as(u32, height) }
            gui::set_screen{ &g, &fs, &dev, width, height, scale = fe.settings.gui_scale }
        } else if slice::eq_bytes{ a = name, b = "scale" } {
            fe.settings.gui_scale = @as(f32, number{ s = arg }) / 10.0
            gui::set_screen{ &g, &fs, &dev, width, height, scale = fe.settings.gui_scale }
        } else if slice::eq_bytes{ a = name, b = "tip" } {
            // tip:TAG:text sets the tooltip of a control on the top screen
            let mut c4: usize = 0
            while c4 < arg.len and arg[c4] != ':' { c4 = c4 + 1 }
            if c4 < arg.len { try gui::set_tooltip{ &g, panel = current_panel{ &fe }, tag = arg[..c4], text = arg[c4 + 1..] } }
        } else if slice::eq_bytes{ a = name, b = "wait" } {
            let mut n = number{ s = arg }
            while n > 0 {
                try one_frame{ &io, &fs, &sdl, &dev, &frame, &g, &fe, mixer }
                n = n - 1
            }
        } else if slice::eq_bytes{ a = name, b = "shot" } {
            try one_frame{ &io, &fs, &sdl, &dev, &frame, &g, &fe, mixer }
            let mut file: [80]u8
            let pre: []u8 = "menu_"
            let mut n = frontend::copy_into{ dst = file[..], src = pre }
            n = n + frontend::copy_into{ dst = file[n..], src = arg }
            n = n + frontend::copy_into{ dst = file[n..], src = ".png" }
            try save_screen{ &io, &fs, &dev, &heap, dir = o.out, name = file[..n] }
        } else if slice::eq_bytes{ a = name, b = "loading" } {
            let id = try frontend::show_loading{ &fe, &g, &fs, &dev, name = arg, story = false, saving = false }
            frontend::set_loading_progress{ &g, panel = id, percent = 40 }
        } else if slice::eq_bytes{ a = name, b = "msgbox" } {
            _ = try gui::message_box{ &g, &fs, &dev, text = arg, cancel = true }
        } else if slice::eq_bytes{ a = name, b = "savename" } {
            let id = try gui::open{ &g, &fs, &dev, name = "savename", mode = gui::Mode::dialog, modal = true }
            gui::make_edit{ &g, panel = id, tag = "EDITBOX" }
            try gui::set_text{ &g, panel = id, tag = "EDITBOX", text = "Quicksave 1" }
            gui::set_focus{ &g, panel = id, tag = "EDITBOX" }
        } else if slice::eq_bytes{ a = name, b = "type" } {
            _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::text{ bytes = [0; 32], len = 0 }, scale_x = 1.0, scale_y = 1.0 }
            let mut tb: [32]u8 = [0; 32]
            let n = frontend::copy_into{ dst = tb[..], src = arg }
            _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::text{ bytes = tb, len = n }, scale_x = 1.0, scale_y = 1.0 }
        } else if slice::eq_bytes{ a = name, b = "key" } {
            let mut c: usize = 0
            while c < arg.len {
                let kc: i32 = if arg[c] == 'd' { sdl::key::DOWN } else if arg[c] == 'u' { sdl::key::UP } else if arg[c] == 'l' { sdl::key::LEFT } else if arg[c] == 'r' { sdl::key::RIGHT } else if arg[c] == 'e' { sdl::key::RETURN } else { sdl::key::ESCAPE }
                _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::key{ down = true, repeat = false, scancode = 0, keycode = kc, mods = 0 }, scale_x = 1.0, scale_y = 1.0 }
                try one_frame{ &io, &fs, &sdl, &dev, &frame, &g, &fe, mixer }
                c = c + 1
            }
        } else if slice::eq_bytes{ a = name, b = "click" } or slice::eq_bytes{ a = name, b = "move" } {
            let r = gui::control_rect{ &g, panel = current_panel{ &fe }, tag = arg }
            if r == null {
                _ = @fmt(&io, "no control {} on the top screen\n", arg)
            } else {
                let cx = @as(i32, r.x + r.w / 2.0)
                let cy = @as(i32, r.y + r.h / 2.0)
                _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::mouse_motion{ x = cx, y = cy, dx = 0, dy = 0, buttons = 0 }, scale_x = 1.0, scale_y = 1.0 }
                if slice::eq_bytes{ a = name, b = "click" } {
                    _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::mouse_button{ down = true, button = sdl::BUTTON_LEFT, clicks = 1, x = cx, y = cy }, scale_x = 1.0, scale_y = 1.0 }
                    _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::mouse_button{ down = false, button = sdl::BUTTON_LEFT, clicks = 1, x = cx, y = cy }, scale_x = 1.0, scale_y = 1.0 }
                }
                try one_frame{ &io, &fs, &sdl, &dev, &frame, &g, &fe, mixer }
            }
        } else if slice::eq_bytes{ a = name, b = "row" } {
            // row:TAG:N clicks row N of list TAG
            let mut c3: usize = 0
            while c3 < arg.len and arg[c3] != ':' { c3 = c3 + 1 }
            let tag = arg[..c3]
            let n = if c3 < arg.len { number{ s = arg[c3 + 1..] } } else { 0 }
            let r = gui::row_rect{ &g, panel = current_panel{ &fe }, tag, row = n }
            if r == null {
                _ = @fmt(&io, "no row {} in {}\n", n, tag)
            } else {
                let x = @as(i32, r.x + r.w / 2.0)
                let y = @as(i32, r.y + r.h / 2.0)
                _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::mouse_motion{ x, y, dx = 0, dy = 0, buttons = 0 }, scale_x = 1.0, scale_y = 1.0 }
                _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::mouse_button{ down = true, button = sdl::BUTTON_LEFT, clicks = 1, x, y }, scale_x = 1.0, scale_y = 1.0 }
                _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::mouse_button{ down = false, button = sdl::BUTTON_LEFT, clicks = 1, x, y }, scale_x = 1.0, scale_y = 1.0 }
                try one_frame{ &io, &fs, &sdl, &dev, &frame, &g, &fe, mixer }
            }
        } else if slice::eq_bytes{ a = name, b = "slide" } {
            let mut c2: usize = 0
            while c2 < arg.len and arg[c2] != ':' { c2 = c2 + 1 }
            let tag = arg[..c2]
            let frac = if c2 < arg.len { number{ s = arg[c2 + 1..] } } else { 50 }
            let r = gui::control_rect{ &g, panel = current_panel{ &fe }, tag }
            if r != null {
                let x = @as(i32, r.x + r.w * @as(f32, frac) / 100.0)
                let y = @as(i32, r.y + r.h / 2.0)
                _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::mouse_motion{ x, y, dx = 0, dy = 0, buttons = 0 }, scale_x = 1.0, scale_y = 1.0 }
                _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::mouse_button{ down = true, button = sdl::BUTTON_LEFT, clicks = 1, x, y }, scale_x = 1.0, scale_y = 1.0 }
                _ = frontend::handle_event{ &fe, &g, ev = sdl::Event::mouse_button{ down = false, button = sdl::BUTTON_LEFT, clicks = 1, x, y }, scale_x = 1.0, scale_y = 1.0 }
                try one_frame{ &io, &fs, &sdl, &dev, &frame, &g, &fe, mixer }
            }
        } else {
            _ = @fmt(&io, "unknown command {}\n", cmd)
        }
        k = k + 1
    }
    _ = @fmt(&io, "settings: {}x{} music {} gamma {} difficulty {}\n", fe.settings.width, fe.settings.height, fe.settings.music, fe.settings.gamma, fe.settings.difficulty)
    let mx2 = mixer
    if mx2 != null { _ = @fmt(&io, "mixer errors: {}\n", mx2.errors) }
}

fn number { s: []u8 } -> i32 {
    let mut n: i32 = 0
    let mut i: usize = 0
    while i < s.len {
        if s[i] >= '0' and s[i] <= '9' { n = n * 10 + @as(i32, s[i] - '0') }
        i = i + 1
    }
    return n
}

// step, draw, submit; prints an outcome that isn't "running".
fn one_frame {
    mut io: Io, mut fs: Fs, mut sdl: sdl::Sdl, mut dev: gpu::Device, mut frame: render::Frame, mut g: gui::Gui, mut fe: frontend::Front,
    mixer: ?*mut mix::Mixer,
} -> ! {
    gui::update{ &g, dt = 1.0 / 30.0 }
    let mx = mixer
    if mx != null {
        let mut pcm: [1470]i16
        mix::render{ m = mx, into = pcm[..] }
    }
    let out = frontend::step{ &fe, &g, &fs, &dev, &sdl, output = null, mixer, dt = 1.0 / 30.0 }
    match out {
        running => {}
        new_game{ module } => { _ = @fmt(&io, "outcome: new game in {}\n", resref::bytes{ r = &module }) }
        load_game{ folder, folder_len } => { _ = @fmt(&io, "outcome: load game {}\n", folder[..folder_len]) }
        quit => { _ = @fmt(&io, "outcome: quit\n") }
    }
    render::begin_frame{ &frame, time = 0.0 }
    frontend::draw{ &fe, &g, &frame, target = gpu::screen_size{ dev } }
    try gpu::submit{ &dev, frame = &frame }
}

fn save_screen { mut io: Io, mut fs: Fs, mut dev: gpu::Device, mut heap: arena::Arena, dir: []u8, name: []u8 } -> ! {
    let size = gpu::screen_size{ dev }
    let pixels = try alloc::resize(u8, arena::Arena){ realloc = arena::alloc, &heap, mem = slice::empty(u8){}, count = @as(usize, size.width) * @as(usize, size.height) * 4 }
    defer _ = alloc::resize(u8, arena::Arena){ realloc = arena::alloc, &heap, mem = pixels, count = 0 }
    _ = try gpu::read_screen{ &dev, into = pixels }
    let mut path_buf: [512]u8
    let path = frontend::join_path{ into = path_buf[..], a = dir, b = name, c = "" }
    let image = png::Image{ width = size.width, height = size.height, rgba = pixels }
    try png::save{ &fs, realloc = arena::alloc, &heap, path, image, alpha = false, bottom_up = false }
    _ = @fmt(&io, "wrote {} ({}x{})\n", path, size.width, size.height)
}

fn make_dir { mut fs: Fs, path: []u8 } {
    let mut i: usize = 1
    while i <= path.len {
        if i == path.len or path[i] == '/' {
            fs::make_dir{ &fs, path = path[..i] } iferr {}
        }
        i = i + 1
    }
}

// The panel commands act on: character generation's top panel while it runs, else the front end's.
fn current_panel { fe: *frontend::Front } -> u32 {
    let cg = fe.cg
    if cg != null { return chargen::top_panel{ st = cg } }
    return frontend::top_panel{ fe }
}

namespace mt_out {
    #write
    fn put_cstring { mut io: Io, s: c::String } { io::write{ &io, to = io::Stream::out, bytes = c::bytes{ s } } }
}
