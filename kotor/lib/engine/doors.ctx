// Doors and placeables being used (docs/re/actions.md 1.4, 3.5, 3.6): the approach pattern
// (walk to the use point, then act), opening and closing doors, using placeables.
namespace doors {
    // How close the actor stands to act (ours, from GetUseRange: radius + 0.75).
    const USE_EXTRA: f32 = 0.75

    // Where an actor stands to use `target`, and how near it must be (actions.md 1.4).
    struct UsePoint { point: math::Vec3, range: f32 }

    fn use_point { w: *world::World, actor: *obj::Object, target: *obj::Object } -> UsePoint {
        let mut radius: f32 = 0.5
        if obj::creature{ o = actor } is some{ value = c } { radius = c.perspace }
        if target.kind == obj::Kind::door {
            // The nearer of the door's two sides.
            let n = target.orientation
            let a = math::vec3::add_scaled{ a = target.position, b = n, s = 1.0 }
            let b = math::vec3::add_scaled{ a = target.position, b = n, s = -1.0 }
            let da = math::vec3::distance{ a, b = actor.position }
            let db = math::vec3::distance{ a = b, b = actor.position }
            return UsePoint{ point = if da < db { a } else { b }, range = radius + USE_EXTRA }
        }
        if target.kind == obj::Kind::creature {
            let mut other: f32 = 0.5
            if obj::creature{ o = target } is some{ value = c } { other = c.perspace }
            return UsePoint{ point = target.position, range = radius + other + 0.3 }
        }
        return UsePoint{ point = target.position, range = radius + USE_EXTRA + 0.5 }
    }

    fn distance_2d { a: math::Vec3, b: math::Vec3 } -> f32 {
        let dx = a.x - b.x
        let dy = a.y - b.y
        return math::sqrtf{ x = dx * dx + dy * dy }
    }

    // For a creature out of range of `target`: queues, in front, a move to the use point, a
    // turn to face the target and a copy of `a` (actions.md 1.4), and says so. Non-creatures act
    // from where they are.
    fn approach { mut w: world::World, id: u32, target: u32, a: *mut actions::Action } -> bool {
        return approach_within{ &w, id, target, a, extra = 0.0 }
    }

    // The same with the stopping range widened by `extra` (a player's talk order stops 1 m beyond the
    // use range: DIALOGOBJECT's approach mode 1, actions.md 3.12).
    fn approach_within { mut w: world::World, id: u32, target: u32, a: *mut actions::Action, extra: f32 } -> bool {
        let actor = world::object{ w = &w, id } ifnull { return false }
        if actor.kind != obj::Kind::creature { return false }
        let t = world::object{ w = &w, id = target } ifnull { return false }
        let mut up = use_point{ w = &w, actor, target = t }
        up.range = up.range + extra
        if distance_2d{ a = actor.position, b = up.point } <= up.range + 0.1 or a.phase > 0 { return false }
        let mut copy = a.*
        copy.phase = 1
        copy.has_started = false
        actions::add_front{ &w, id, action = copy }
        let mut face = actions::make{ kind = actions::Kind::face_object }
        face.params[0] = actions::Param::object{ id = target }
        actions::add_front{ &w, id, action = face }
        let mut move = actions::make{ kind = actions::Kind::move_to_point }
        move.params[0] = actions::Param::vector{ v = up.point }
        move.params[1] = actions::Param::int{ v = 1 }
        move.params[2] = actions::Param::float{ v = up.range }
        actions::add_front{ &w, id, action = move }
        // The parameters now belong to the copy.
        a.params = [actions::Param::none; 8]
        return true
    }

    // OPENDOOR (actions.md 3.6): param 0 the door.
    fn open_door { mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, id: u32, a: *mut actions::Action } -> actions::Status {
        let target = actions::object_param{ a, i = 0 }
        let o = world::object{ w = &w, id = target } ifnull { return actions::Status::failed }
        let d = obj::door{ o } ifnull { return actions::Status::failed }
        // A click on an area-transition door always runs the transition for the party leader,
        // whatever state the door is in (an NPC may have opened it already).
        let transition = id == w.pc and modload::link_of{ o } != null
        if d.state != obj::DoorState::closed and not transition { return actions::Status::done }
        if approach{ &w, id, target, a } { return actions::Status::done }
        if transition {
            events::post{ &w, delay_ms = 0, caller = id, target, payload = events::Payload::script{ e = events::script_event{ kind = events::CLICKED, object = id } } }
            return actions::Status::done
        }
        if d.state != obj::DoorState::closed { return actions::Status::done }
        // A locked door opens to its key (UseKeyOnObject); otherwise the actor is told it is locked.
        if d.locked and not use_key{ &w, who = id, target } {
            tell{ &w, who = id, strref = FEEDBACK_LOCKED }
            events::post{ &w, delay_ms = 0, caller = id, target, payload = events::Payload::script{ e = events::script_event{ kind = events::FAIL_TO_OPEN, object = id } } }
            return actions::Status::failed
        }
        set_door_state{ &w, id = target, state = obj::DoorState::open1 }
        events::post{ &w, delay_ms = 0, caller = id, target, payload = events::Payload::script{ e = events::script_event{ kind = events::OPEN, object = id } } }
        return actions::Status::done
    }

    // CLOSEDOOR: param 0 the door.
    fn close_door { mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, id: u32, a: *mut actions::Action } -> actions::Status {
        let target = actions::object_param{ a, i = 0 }
        let o = world::object{ w = &w, id = target } ifnull { return actions::Status::failed }
        let d = obj::door{ o } ifnull { return actions::Status::failed }
        if d.state == obj::DoorState::closed { return actions::Status::done }
        if approach{ &w, id, target, a } { return actions::Status::done }
        set_door_state{ &w, id = target, state = obj::DoorState::closed }
        events::post{ &w, delay_ms = 0, caller = id, target, payload = events::Payload::script{ e = events::script_event{ kind = events::CLOSE, object = id } } }
        return actions::Status::done
    }

    // USEOBJECT (actions.md 3.5): param 0 the placeable (or door: open it).
    fn use_object { mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, id: u32, a: *mut actions::Action } -> actions::Status {
        let target = actions::object_param{ a, i = 0 }
        let o = world::object{ w = &w, id = target } ifnull { return actions::Status::failed }
        if o.kind == obj::Kind::door { return open_door{ &w, &vm, engine, id, a } }
        let p = obj::placeable{ o } ifnull { return actions::Status::failed }
        if not p.useable { return actions::Status::failed }
        if approach{ &w, id, target, a } { return actions::Status::done }
        // A locked container opens to its key; else the actor is told it is locked and OnUsed still runs (3.5).
        if p.has_inventory and p.locked and not use_key{ &w, who = id, target } {
            tell{ &w, who = id, strref = FEEDBACK_LOCKED }
        }
        // A container the party opens shows its contents (actions.md 3.5): OnOpen, not OnUsed.
        if p.has_inventory and not p.locked and (id == w.pc or id == w.player or party::is_member{ w = &w, id }) {
            _ = container::open{ &w, placeable = target, user = id }
            return actions::Status::done
        }
        events::post{ &w, delay_ms = 0, caller = id, target, payload = events::Payload::script{ e = events::script_event{ kind = events::USED, object = id } } }
        return actions::Status::done
    }

    // OPENLOCK (actions.md 3.7): params 0 the door or placeable, 1 a security spike (or OBJECT_INVALID),
    // 2 unused. Walk up, work at the lock for 1.5 s (unlockdr/unlockcntr), then, in the original's order:
    // the key if the user carries it (UseKeyOnObject), "cannot be opened through conventional means" for
    // a lock that wants one, else the Security check against the lock's DC. Success unlocks it (UNLOCKED)
    // and the user opens it (a door opens, a container is used); failure leaves it locked and the
    // roll is the only thing said.
    fn open_lock { mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, id: u32, a: *mut actions::Action } -> actions::Status {
        let target = actions::object_param{ a, i = 0 }
        let o = world::object{ w = &w, id = target } ifnull { return actions::Status::failed }
        let me = world::object{ w = &w, id } ifnull { return actions::Status::failed }
        let lock = lock_of{ o } ifnull { return actions::Status::failed }
        if approach{ &w, id, target, a } { return actions::Status::done }
        let now = clock::now_ms{ c = w.clock }
        if a.phase < 2 {
            a.phase = 2
            a.started = now
            let dir = math::vec3::sub{ a = o.position, b = me.position }
            if dir.x * dir.x + dir.y * dir.y > 0.0001 { world::set_orientation{ o = me, v = math::Vec3{ x = dir.x, y = dir.y, z = 0.0 } } }
            world::set_animation{ o = me, id = animname::ROW_BASE + (if o.kind == obj::Kind::door { @as(u32, 47) } else { @as(u32, 48) }), speed = 1.0 }
            return actions::Status::running
        }
        // The player's own character is heard picking the lock a quarter second in (actions.md 3.9).
        if a.phase == 2 and clock::elapsed_since{ now, then = a.started } >= 250 {
            a.phase = 3
            if is_player_side{ w = &w, id } {
                outbox::post{ out = &w.out, note = outbox::Note::play_sound{ name = resref::truncate{ name = "gui_lockpick" }, object = id, position = me.position, positional = false } }
            }
        }
        if clock::elapsed_since{ now, then = a.started } < 1500 { return actions::Status::running }
        world::set_animation{ o = me, id = obj::ANIM_STAND, speed = 1.0 }
        let mut opens = use_key{ &w, who = id, target }
        if not opens {
            if lock.key_required {
                tell{ &w, who = id, strref = FEEDBACK_NO_KEY }
                events::post{ &w, delay_ms = 0, caller = id, target, payload = events::Payload::script{ e = events::script_event{ kind = events::FAIL_TO_OPEN, object = id } } }
                return actions::Status::done
            }
            opens = rt_act::unlock_attempt{ &w, who = id, target, spike_bonus = 0 }
        }
        if not opens { return actions::Status::done }
        // Unlocked: the user goes on to open it.
        let mut next = actions::make{ kind = if o.kind == obj::Kind::door { actions::Kind::open_door } else { actions::Kind::use_object } }
        next.params[0] = actions::Param::object{ id = target }
        actions::add_front{ &w, id, action = next }
        return actions::Status::done
    }

    // LOCK (actions.md 3.7): params 0 the door or placeable. The mirror of OPENLOCK: walk up, work at
    // the lock for 1.5 s, then its key (UseKeyOnObject) or a Security check against CloseLockDC locks
    // it (Locked = 1, LOCKED from the user); a key-only lock without the key fails to lock (feedback
    // 15). An open door is closed first.
    fn lock_object { mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, id: u32, a: *mut actions::Action } -> actions::Status {
        let target = actions::object_param{ a, i = 0 }
        let o = world::object{ w = &w, id = target } ifnull { return actions::Status::failed }
        let me = world::object{ w = &w, id } ifnull { return actions::Status::failed }
        let lock = lock_of{ o } ifnull { return actions::Status::failed }
        if lock.locked { return actions::Status::done }
        if approach{ &w, id, target, a } { return actions::Status::done }
        if obj::door{ o } is some{ value = d } {
            if d.state != obj::DoorState::closed {
                set_door_state{ &w, id = target, state = obj::DoorState::closed }
                events::post{ &w, delay_ms = 0, caller = id, target, payload = events::Payload::script{ e = events::script_event{ kind = events::CLOSE, object = id } } }
            }
        }
        let now = clock::now_ms{ c = w.clock }
        if a.phase < 2 {
            a.phase = 2
            a.started = now
            let dir = math::vec3::sub{ a = o.position, b = me.position }
            if dir.x * dir.x + dir.y * dir.y > 0.0001 { world::set_orientation{ o = me, v = math::Vec3{ x = dir.x, y = dir.y, z = 0.0 } } }
            world::set_animation{ o = me, id = animname::ROW_BASE + (if o.kind == obj::Kind::door { @as(u32, 47) } else { @as(u32, 48) }), speed = 1.0 }
            return actions::Status::running
        }
        if clock::elapsed_since{ now, then = a.started } < 1500 { return actions::Status::running }
        world::set_animation{ o = me, id = obj::ANIM_STAND, speed = 1.0 }
        let mut done = has_key{ &w, who = id, key = lock.key }
        if not done {
            if lock.key_required {
                tell{ &w, who = id, strref = FEEDBACK_NO_KEY }
                return actions::Status::done
            }
            let c = obj::creature{ o = me } ifnull { return actions::Status::failed }
            let f = c.fighter ifnull { return actions::Status::failed }
            let check = rules::open_lock_check{ tables = w.rules, c = &f.c, lock_dc = lock.close_dc, spike_bonus = 0, in_combat = c.in_combat, rng = &w.dice }
            say_roll{ &w, me, target = o, check, in_combat = c.in_combat }
            done = check.success
        }
        if not done { return actions::Status::done }
        set_locked{ o, locked = true }
        events::post{ &w, delay_ms = 0, caller = id, target, payload = events::Payload::script{ e = events::script_event{ kind = events::LOCKED, object = id } } }
        return actions::Status::done
    }

    // Whether creature `who` (or the party's bag it shares) carries an item tagged `key`.
    fn has_key { mut w: world::World, who: u32, key: []u8 } -> bool {
        if key.len == 0 { return false }
        let me = world::object{ w = &w, id = who } ifnull { return false }
        let ids = rt_item::inventory_of{ &w, o = me }
        let mut k: usize = 0
        while k < ids.len {
            if world::object{ w = &w, id = ids[k] } is some{ value = it } { if ci::eq{ a = it.tag, b = key } { return true } }
            k = k + 1
        }
        return false
    }

    // ---- locks (actions.md 3.6, 3.7)

    // dialog.tlk lines the original shows for the lock actions (feedbacktext messages 13 to 16).
    const FEEDBACK_LOCKED: u32 = 1439       // "Locked"
    const FEEDBACK_NOT_LOCKED: u32 = 1430   // "That object is not locked."
    const FEEDBACK_NO_KEY: u32 = 1431       // "This object cannot be opened through conventional means."
    const FEEDBACK_USED_KEY: u32 = 1432     // "You used a key."

    // What a door's or placeable's lock holds, for the code that treats the two alike.
    struct Lock { locked: bool, key_required: bool, key: []u8, dc: i32, close_dc: i32, lockable: bool, auto_remove_key: bool }

    fn lock_of { o: *obj::Object } -> ?Lock {
        if o.ext is door{ d } {
            return Lock{ locked = d.locked, key_required = d.key_required, key = d.key, dc = @as(i32, d.open_dc), close_dc = @as(i32, d.close_dc), lockable = d.lockable, auto_remove_key = d.auto_remove_key }
        }
        if o.ext is placeable{ p } {
            return Lock{ locked = p.locked, key_required = p.key_required, key = p.key, dc = @as(i32, p.open_dc), close_dc = @as(i32, p.close_dc), lockable = p.lockable, auto_remove_key = p.auto_remove_key }
        }
        return null
    }

    fn set_locked { o: *obj::Object, locked: bool } {
        if o.ext is door{ d } { d.locked = locked } else if o.ext is placeable{ p } { p.locked = locked }
    }

    // Whether `id` is one of the player's party, whose screen the feedback goes to.
    fn is_player_side { w: *world::World, id: u32 } -> bool {
        return id == w.pc or id == w.player or party::is_member{ w, id }
    }

    // A line of dialog.tlk text on the HUD's feedback log, when the one who acted is the player's.
    fn tell { mut w: world::World, who: u32, strref: u32 } {
        if not is_player_side{ w = &w, id = who } { return }
        outbox::post{ out = &w.out, note = outbox::Note::feedback{ strref, text = outbox::keep_text{ out = &w.out, s = "" } } }
    }

    // The roll of a Security check as the original's combat log words it (dialog.tlk 1405, "<CUSTOM0>
    // attempts <CUSTOM1> on <CUSTOM2> : *<CUSTOM3>* : (<CUSTOM4> <CUSTOM5> <CUSTOM6> = <CUSTOM7><CUSTOM8>)"):
    // "Leia Tana attempts Security on Door : *success* : (Take 20 + 5 = 25 vs. DC 1)". Said to the player
    // when the one who rolled is the player's.
    fn say_roll { mut w: world::World, me: *obj::Object, target: *obj::Object, check: rules::SkillCheck, in_combat: bool } {
        say_skill_roll{ &w, me, target, check, in_combat, what = 329 }
    }

    // The same line for another use of a skill, named by dialog.tlk `what` (the trap actions name
    // theirs: 1529 "Disable Mine", 1531 "Recover Mine", 1530 "Set Mine", 1532 "Examine Mine").
    fn say_skill_roll { mut w: world::World, me: *obj::Object, target: *obj::Object, check: rules::SkillCheck, in_combat: bool, what: u32 } {
        if not is_player_side{ w = &w, id = me.id } { return }
        let mut b = utf8::Builder(heap::Heap){ bytes = list::new(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap } }
        defer list::free{ list = &b.bytes }
        let template = world::string_by_strref{ w = &w, strref = 1405 }
        let mut i: usize = 0
        while i < template.len {
            if i + 9 <= template.len and template[i] == 60 and template[i + 8] == 62 and slice::eq_bytes{ a = template[i..i + 7], b = "<CUSTOM" } {
                let hole = template[i + 7]
                i = i + 9
                if hole == 48 { _ = @fmt(&b, "{}", name_text{ w = &w, o = me }) }
                else if hole == 49 { _ = @fmt(&b, "{}", world::string_by_strref{ w = &w, strref = what }) }
                else if hole == 50 { _ = @fmt(&b, "{}", name_text{ w = &w, o = target }) }
                else if hole == 51 { _ = @fmt(&b, "{}", world::string_by_strref{ w = &w, strref = result_strref{ check, in_combat } }) }
                else if hole == 52 {
                    if in_combat { _ = @fmt(&b, "{}", check.roll) } else { _ = @fmt(&b, "{}", world::string_by_strref{ w = &w, strref = 1409 }) }
                }
                else if hole == 53 { _ = @fmt(&b, "+") }
                else if hole == 54 { _ = @fmt(&b, "{}", check.total - check.roll) }
                else if hole == 55 { _ = @fmt(&b, "{}", check.total) }
                else if hole == 56 { _ = @fmt(&b, " {} DC {}", world::string_by_strref{ w = &w, strref = 1395 }, check.dc) }
                continue
            }
            _ = list::push{ list = &b.bytes, item = template[i] }
            i = i + 1
        }
        let line = utf8::view{ b }
        outbox::post{ out = &w.out, note = outbox::Note::feedback{ strref = 0xFFFFFFFF, text = outbox::keep_text{ out = &w.out, s = line.bytes } } }
    }

    // The word for a Security check's outcome: success, failure, or (taking 20 against a DC of 60 or
    // more, which nothing can beat) "success not possible" (AIActionOpenLock's result codes 1, 3, 5).
    fn result_strref { check: rules::SkillCheck, in_combat: bool } -> u32 {
        if check.success { return 1392 }
        if not in_combat and check.dc >= 60 { return 1397 }
        return 1393
    }

    // An object's name as the player reads it.
    fn name_text { w: *world::World, o: *obj::Object } -> []u8 {
        if o.name.strref != 0xFFFFFFFF {
            let text = world::string_by_strref{ w, strref = o.name.strref }
            if text.len > 0 { return text }
        }
        return o.name.text
    }

    // CSWSCreature::UseKeyOnObject (0x004f0b20) for opening: true when the lock is open already, or the
    // creature (or the party's bag it shares) carries an item tagged with the lock's KeyName, in which
    // case the lock is opened and the creature told it used a key; with AutoRemoveKey the key goes.
    fn use_key { mut w: world::World, who: u32, target: u32 } -> bool {
        let o = world::object{ w = &w, id = target } ifnull { return false }
        let lock = lock_of{ o } ifnull { return false }
        if not lock.locked { return true }
        if lock.key.len == 0 { return false }
        let me = world::object{ w = &w, id = who } ifnull { return false }
        let ids = rt_item::inventory_of{ &w, o = me }
        let mut k: usize = 0
        while k < ids.len {
            let it = world::object{ w = &w, id = ids[k] }
            k = k + 1
            if it == null or not ci::eq{ a = it.tag, b = lock.key } { continue }
            set_locked{ o, locked = false }
            tell{ &w, who, strref = FEEDBACK_USED_KEY }
            if lock.auto_remove_key { world::destroy{ &w, id = ids[k - 1] } }
            return true
        }
        return false
    }

    // A door's state: its walkmesh blocks only while closed; the scene animates the change.
    fn set_door_state { mut w: world::World, id: u32, state: obj::DoorState } {
        let o = world::object{ w = &w, id } ifnull { return }
        let d = obj::door{ o } ifnull { return }
        d.state = state
        walkmap::set_active{ m = &w.walk, index = d.walk, active = state == obj::DoorState::closed }
        o.dirty = o.dirty | obj::DIRTY_ANIMATION
        if w.log.objects {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "door {} ({}) -> {}\n", id, o.tag, @as(u32, state))
        }
    }
}
