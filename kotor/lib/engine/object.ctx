// Game objects: the common header every object has, its kind's own data, and the table that
// finds an object by id (docs/design/engine.md, "Objects"; docs/re/objects.md).
//
//   let o = world::object{ w = &w, id } ifnull { ... }          // ?*mut obj::Object
//   let c = obj::creature{ o } ifnull { ... }                   // its creature data, if it is one
//
// Objects live one by one in the session heap, so a *mut Object stays valid until the object is
// destroyed (world::sweep). Code that keeps one across a script run looks the id up again.
namespace obj {
    // The id no object has (OBJECT_INVALID).
    const INVALID: u32 = 0x7F000000
    // Player characters count down from here (objects.md, Ids).
    const FIRST_CHARACTER: u32 = 0x7FFFFFFF

    enum Kind: u8 { module, area, creature, item, trigger, placeable, door, aoe, waypoint, encounter, store, sound }

    // The script's OBJECT_TYPE_* for a kind (objects.md, Object types); 0 for the module and area.
    fn object_type { kind: Kind } -> i32 {
        match kind {
            creature => { return 1 }
            item => { return 2 }
            trigger => { return 4 }
            door => { return 8 }
            aoe => { return 16 }
            waypoint => { return 32 }
            placeable => { return 64 }
            store => { return 128 }
            encounter => { return 256 }
            sound => { return 512 }
            module | area => { return 0 }
        }
    }

    // Every kind's script hooks, one enum: each kind fills the slots it has (objects.md, Script
    // slots; the module's 15 from the IFO, the area's 4 from the ARE).
    enum Slot: u8 {
        heartbeat, notice, spell_at, attacked, damaged, disturbed, end_round, dialogue, spawn,
        rested, death, user_defined, blocked, end_dialogue,
        open, closed, lock, unlock, used, click, fail_to_open, enter, exit, trap_triggered, disarm,
        melee_attacked, inv_disturbed, exhausted, open_store,
        mod_load, mod_start, client_enter, client_leave, activate_item, acquire_item,
        unacquire_item, player_death, player_dying, spawn_button, player_rest, player_level_up,
        equip_item,
    }
    const SLOT_COUNT: usize = 42

    // Dirty bits the scene reads (objects.md, `+0x1fc`).
    const DIRTY_ANIMATION: u32 = 1
    const DIRTY_POSITION: u32 = 2
    const DIRTY_ORIENTATION: u32 = 4

    // Internal animation ids (objects.md `+0xd4`; movement.md 3.6). The scene maps them to model
    // animation names (lib/scene/animname.ctx).
    const ANIM_STAND: u32 = 10000
    const ANIM_READY: u32 = 10001
    const ANIM_WALK: u32 = 10002
    const ANIM_WALK_BACK: u32 = 10003
    const ANIM_RUN: u32 = 10004
    const ANIM_DEAD: u32 = 10006
    const ANIM_STEALTH_WALK: u32 = 10133   // walk and run in stealth mode

    // A display name: a dialog.tlk strref (0xFFFFFFFF none) or text of its own (heap).
    struct Name { strref: u32, text: []mut u8 }

    // KOTOR's local variables (SWVarTable): 96 booleans, 8 numbers (gff-save.md).
    struct Locals { bools: [3]u32, numbers: [8]u8 }

    // What event scripts ask about, recorded on the object before its slot runs (engine.md,
    // "The common header"). Add fields as routines need them; event delivery sets them.
    struct Context {
        entering: u32 = INVALID,  // GetEnteringObject (area, trigger, encounter)
        exiting: u32 = INVALID,   // GetExitingObject
        user_event: i32 = 0,      // GetUserDefinedEventNumber
        last_opened_by: u32 = INVALID,
        last_closed_by: u32 = INVALID,
        last_used_by: u32 = INVALID,
        last_locked_by: u32 = INVALID,
        last_unlocked_by: u32 = INVALID,
        last_perceived: u32 = INVALID,
        perceived_seen: bool = false,
        perceived_heard: bool = false,
        perceived_vanished: bool = false,
        perceived_inaudible: bool = false,
        last_attacker: u32 = INVALID,
        last_damager: u32 = INVALID,
        last_speaker: u32 = INVALID,
        last_disturbed: u32 = INVALID,
        disturb_type: i32 = 0,    // GetInventoryDisturbType: 0 added, 1 removed, 2 stolen (last_disturbed is the item)
        run_script_var: i32 = 0,  // ExecuteScript's nScriptVar, read by GetRunScriptVar
        clicked_by: u32 = INVALID,
        blocker: u32 = INVALID,   // OnBlocked: GetBlockingDoor
        listen_pattern: i32 = -1, // GetListenPatternNumber: the SetListenPattern number that matched, -1 none
        // Force powers (fight::cast_spell): the caster's own cast while its impact script runs,
        // and on the target the last power cast at it (OnSpellCastAt).
        spell_id: i32 = -1,       // GetSpellId (-1 none)
        spell_target: u32 = INVALID, // GetSpellTargetObject
        spell_location: math::Vec3 = math::vec3::zero{}, // GetSpellTargetLocation
        last_spell: i32 = -1,     // GetLastSpell
        last_spell_caster: u32 = INVALID, // GetLastSpellCaster
        last_spell_harmful: bool = false, // GetLastSpellHarmful
        // Appended by routines/combat.ctx and objects.ctx. The event that sets each belongs to the code
        // that posts it (path finding, the module's player death, trap loading); the getters read them.
        found_enemy: u32 = INVALID, // GetFoundEnemyCreature: the hostile a pathfind stopped at (k_def_pathfail01)
        last_player_died: u32 = INVALID, // GetLastPlayerDied, on the module: the party member whose death ran OnPlrDeath
        trap_type: i32 = -1,      // GetTrapBaseType: the traps.2da row of the trap on a door, placeable or trigger, -1 none
    }

    // The header every object has (objects.md, CSWSObject members).
    struct Object {
        id: u32,
        kind: Kind,
        tag: []mut u8,                        // lower-cased, as SetTag does; heap
        template: resref::ResRef,           // the blueprint it came from
        name: Name,
        area: u32,
        position: math::Vec3,
        orientation: math::Vec3,            // unit facing vector, z = 0
        scripts: [42]resref::ResRef,        // by Slot; empty: none
        locals: Locals,
        actions: list::List(actions::Action, heap::Heap),
        action_group: u16,                  // the group of the last action added
        commandable: bool,
        hp: i32,
        hp_max: i32,
        hardness: i32,                      // a door's or placeable's UTD Hardness: taken off every weapon hit (combat.md 6.6)
        hp_temp: i32,
        plot: bool,
        min_one_hp: bool,
        animation: u32,                     // internal animation id; 10000 stands
        anim_speed: f32,                    // the playback rate of `animation`
        anim_cycles: f32,                   // walk and run only: cycles a second the ground speed asks for (world::set_gait); 0 plays at anim_speed
        dirty: u32,
        ai_level: i32,                      // 0..4; -1: not updated
        conversation: resref::ResRef,
        faction: u32,
        ctx: Context,
        destroyed: bool,
        ext: Ext,
    }

    union Ext {
        none,
        module{ m: *mut Module },
        area{ a: *mut Area },
        creature{ c: *mut Creature },
        item{ i: *mut Item },
        trigger{ t: *mut Trigger },
        placeable{ p: *mut Placeable },
        door{ d: *mut Door },
        waypoint{ wp: *mut Waypoint },
        sound{ s: *mut Sound },
        encounter{ e: *mut Encounter },
        store{ st: *mut Store },
        aoe{ a: *mut Aoe },
    }

    // Equipment slots (inventory.md: the UTC Equip_ItemList struct id is 1 << slot).
    const SLOT_HEAD: usize = 0
    const SLOT_BODY: usize = 1
    const SLOT_HANDS: usize = 3
    const SLOT_RIGHT_WEAPON: usize = 4
    const SLOT_LEFT_WEAPON: usize = 5
    const SLOT_LEFT_ARM: usize = 7
    const SLOT_RIGHT_ARM: usize = 8
    const SLOT_IMPLANT: usize = 9
    const SLOT_BELT: usize = 10
    const SLOT_CLAW1: usize = 14
    const SLOT_CLAW2: usize = 15
    const SLOT_CLAW3: usize = 16
    const SLOT_HIDE: usize = 17
    const EQUIP_SLOTS: usize = 20

    struct Creature {
        appearance: u32 = 0,                // appearance.2da row
        gender: u32 = 0,
        race: u32 = 6,
        subrace: u32 = 0,
        body_variation: u8 = 0,
        texture_variation: u8 = 1,
        portrait: u32 = 0,
        soundset: u32 = 0xFFFFFFFF,
        is_pc: bool = false,
        movement_rate: u32 = 7,             // creaturespeed.2da row (7, DEFAULT, resolved through appearance.2da MOVERATE on read)
        walk_rate: f32 = 1.7,               // m/s (creaturespeed.2da, movement.md 3.1)
        run_rate: f32 = 5.4,
        perspace: f32 = 0.35,               // appearance.2da PERSPACE
        creperspace: f32 = 0.4,
        camspace: f32 = 0.4,                // appearance.2da CAMERASPACE, else CREPERSPACE: the circle the chase camera stays out of
        height: f32 = 1.6,
        equipped: [20]u32 = [INVALID; 20],  // item ids by equipment slot; INVALID: empty
        inventory: list::List(u32, heap::Heap),
        // Placeholder stats until lib/rules (HOOK(rules): stats: rules::Creature).
        abilities: [6]u8 = [10; 6],
        hit_dice: u32 = 1,
        disguise: u32 = 0,                  // an EffectDisguise's appearance.2da row (0: none): what the creature looks like
        classes: [3]u32 = [0; 3],
        class_levels: [3]u32 = [0; 3],
        good_evil: u32 = 50,
        perception_range: u32 = 11,
        // AI timers (gameloop.md 2.4).
        spawn_fired: bool = false,
        last_heartbeat: u64 = 0,            // world ms
        heartbeat_interval: u32 = 3000,     // ms: 3000 + rand() % 1200
        // Movement (movement.md 3).
        speed: f32 = 0.0,                   // current speed, m/s: drives walk/run animation
        speed_factor: f32 = 1.0,            // GetSpeedFactor's f_prev: 1 when the creature is made (0x004cfcb0), so its first move starts at full speed
        follow_speed: f32 = 0.0,            // a follower's smoothed speed, m/s (UpdateFollowLeader's +0x48): picks its walk or run cycle and sets the cycle's pace
        path: list::List(math::Vec3, heap::Heap),   // waypoints still to walk
        path_next: usize = 0,
        path_goal: math::Vec3 = math::vec3::zero{}, // where the path was planned to
        path_adjusted: bool = false,                // the path ends at the nearest reachable point of an unreachable goal
        // The creature a move is walking round (CPathfindInformation +0x244..+0x268, movement.md 4.9; lib/engine/crowd.ctx):
        avoided: u32 = INVALID,                     // the one it last made a detour for (+0x254)
        avoided_at: math::Vec3 = math::vec3::zero{}, // where that one stood then (+0x258)
        avoid_side: bool = false,                   // the side of the next detour (+0x244)
        blocked_steps: u32 = 0,                     // blocked steps since the path was planned (+0x268): six end the move
        moving: bool = false,
        in_combat: bool = false,            // the server's combat state (SetCombatState 0x004f2610, +0x4e0): 8 s from the last hostile act
        // The combat's reason (+0xac0): true for 1, put into combat by being attacked (it stays until combat is
        // left), false for 2, attacking or reacting. Meaningful only while in_combat (fight::is_attacked).
        combat_attacked: bool = false,
        // The client creature's combat mode (CSWCCreature +0x440 bit 0, SetCombatMode 0x00610a10): the leader's
        // drives the HUD's combat bar, the combat camera and reticle, hostile-only Q / E; hud::update_combat_modes.
        combat_mode: bool = false,
        dead: bool = false,
        triggers: list::List(u32, heap::Heap),      // the triggers it stands in
        // Perception (gameloop.md 2.4): who it sees and hears, its ranges, the full pass's timer.
        perceived: list::List(Perceived, heap::Heap),
        sight_range: f32 = 0.0,                     // 0 until first computed
        hearing_range: f32 = 0.0,
        last_perception: u64 = 0,
        // Appended by routines/creature.ctx and items.ctx.
        xp: u32 = 0,                        // GetXP/SetXP (stats +0x68)
        gold: u32 = 0,                      // GetGold (UTC Gold); the party purse is HOOK(party)
        inv_cursor: usize = 0,              // GetFirstItemInInventory/GetNextItemInInventory
        listening: bool = false,            // SetListening
        listen_text: [4][32]u8 = [[0; 32]; 4], // SetListenPattern: up to four patterns
        listen_len: [4]u8 = [0; 4],
        listen_number: [4]i32 = [0; 4],
        listen_count: u8 = 0,
        destroyable: bool = true,           // SetIsDestroyable (the caller's corpse fades or stays)
        raiseable: bool = true,
        selectable_dead: bool = false,
        // Appended by routines/combat.ctx: what the combat queries answer until the combat rules
        // (lib/rules) keep them (HOOK(rules)).
        attack_target: u32 = INVALID,       // GetAttackTarget (CSWSCreature +0x504)
        attempted_target: u32 = INVALID,    // GetAttemptedAttackTarget (+0x50c)
        attacked_by: u32 = INVALID,         // "going to be attacked by" (+0x520): set on the player's character or the leader by AddAttackActions
        clicked_target: u32 = INVALID,      // the player's attack order on another than the attempted target (+0x510, set by the attack input 0x005254c0; read by fight::can_engage)
        combat_message: u32 = 48208,        // the party member's combat message (client party record +0x84, 0x006345e0): what the bar shows while it is the leader (hud)
        last_hostile_actor: u32 = INVALID,  // GetLastHostileActor
        last_hostile_target: u32 = INVALID, // GetLastHostileTarget
        last_attack_action: i32 = 65535,    // GetLastAttackAction (ACTION_*; +0x544)
        last_force_power: i32 = -1,         // GetLastForcePowerUsed (spells.2da row, -1 none)
        last_combat_feat: i32 = -1,         // GetLastCombatFeatUsed (feat.2da row, -1 none)
        last_attack_result: i32 = 0,        // GetLastAttackResult (ATTACK_RESULT_*)
        force_power_ok: bool = false,       // GetWasForcePowerSuccessful
        ai_style: i32 = 0,                  // GetNPCAIStyle (NPC_AISTYLE_*)
        party_ai_style: i32 = 0,            // GetPartyAIStyle, kept on the player's character (the party table is HOOK(party))
        fighter: ?*mut fight::Fighter = null, // the rules creature and the combat round (heap; lib/engine/fight.ctx)
        blocked_ms: u64 = 0,                // when a closed door last sent it PATH_BLOCKED (movement.ctx)
        // Appended by routines/effects.ctx.
        fx_cursor: usize = 0,               // GetFirstEffect/GetNextEffect: the next index into the rules' effect list
        // Appended by routines/creature.ctx and actions.ctx.
        head: i32 = -1,                     // DuplicateHeadAppearance: a heads.2da row to show instead of the appearance's own, -1 none
        stealth: bool = false,              // stealth mode is on (lib/engine/stealth.ctx)
        stealth_rolls: stealth::Rolls = stealth::Rolls{ .. }, // its stealth and awareness rolls, its stealth-XP countdown
        // Appended by traps.ctx.
        trap_search_ms: u64 = 0,            // when it last looked for traps (DoTrapDetection's timer)
    }

    // One creature another perceives (gameloop.md 2.4).
    struct Perceived { id: u32, seen: bool, heard: bool }

    struct Item {
        base: u32 = 0,                      // baseitems.2da row
        model_variation: u32 = 1,
        body_variation: u32 = 1,
        texture_variation: u32 = 1,
        stack: u32 = 1,
        charges: u32 = 0,
        possessor: u32 = obj::INVALID,
        identified: bool = true,
        equipped_slot: i32 = -1,            // -1: not equipped
        non_equippable: bool = false,       // SetItemNonEquippable: the equip checks refuse it
        rules: ?*mut rules::Item = null,    // the item as the rules see it (heap; fight::read_item)
        droppable: bool = false,            // Dropable: it goes into the body bag when its owner dies
        infinite: bool = false,             // a store's stock that never runs out (item flag bit 2)
        fresh: bool = false,                // the party got it and has not looked at it yet (item flag bit 7, "new")
        spent_props: u32 = 0,               // properties (by index) whose per-minute use is spent: Useable 0 until it recharges
        spent_at_ms: u64 = 0,               // the world time (w.clock) of that use
    }

    enum DoorState: u8 { closed, open1, open2, destroyed }

    struct Door {
        appearance: u32,                    // genericdoors.2da row
        state: DoorState,
        locked: bool,
        lockable: bool,
        key_required: bool,
        key: []mut u8,                          // the key item's tag
        open_dc: u32,                       // OpenLockDC: the Security skill's difficulty to pick it
        close_dc: u32,                      // CloseLockDC
        auto_remove_key: bool,              // AutoRemoveKey: the key is taken from whoever opens it
        linked_to: []mut u8,
        linked_to_module: resref::ResRef,
        linked_flags: u8,                   // 0 none, 1 door, 2 waypoint
        transition_name: Name,
        static: bool,
        walk: i32,                          // index of its placed walkmesh in walkmap, -1 none
        model: resref::ResRef,              // genericdoors modelname
    }

    struct Placeable {
        appearance: u32 = 0,                // placeables.2da row
        open: bool = false,
        on: bool = false,                   // active (`on`/`off` animations)
        useable: bool = false,
        has_inventory: bool = false,
        party_interact: bool = false,
        static: bool = false,
        locked: bool = false,
        lockable: bool = false,
        key_required: bool = false,         // only its key opens it; Security cannot
        key: []mut u8,
        open_dc: u32 = 0,                   // OpenLockDC / CloseLockDC, as on a door
        close_dc: u32 = 0,
        auto_remove_key: bool = false,
        inventory: list::List(u32, heap::Heap),
        walk: i32 = -1,
        model: resref::ResRef = resref::empty{}, // placeables modelname
        anim: u32 = obj::ANIM_STAND,        // the placeable's own animation state (10073..)
        die_when_empty: bool = false,       // DieWhenEmpty: a body bag vanishes once it is emptied
        user: u32 = obj::INVALID,           // who has the container open (OBJECT_INVALID: nobody)
        opening: bool = false,              // the party's USEOBJECT is waiting for the lid (+0x450, actions.md 3.5)
        opening_until: u64 = 0,             // world ms when that wait ends (the presentation lengthens it)
    }

    struct Trigger {
        polygon: []mut math::Vec3,              // area space; heap
        trigger_type: u32,                  // 0 generic, 1 transition, 2 trap
        linked_to: []mut u8,
        linked_to_module: resref::ResRef,
        linked_flags: u8,
        transition_name: Name,
        inside: list::List(u32, heap::Heap),
        trap: traps::Trap,                  // a trap trigger's trap (traps.ctx)
    }

    struct Waypoint { has_map_note: bool, map_note_enabled: bool, map_note: Name }

    struct Sound {
        active: bool = false,
        continuous: bool = false,
        looping: bool = false,
        positional: bool = false,
        random: bool = false,
        random_position: bool = false,
        interval: u32 = 0,                  // ms
        interval_variation: u32 = 0,
        volume: u32 = 127,                  // 0..127
        volume_variation: u32 = 0,
        pitch_variation: f32 = 0.0,
        elevation: f32 = 0.0,
        min_distance: f32 = 1.0,
        max_distance: f32 = 10.0,
        random_range_x: f32 = 0.0,
        random_range_y: f32 = 0.0,
        priority: u32 = 0,                  // prioritygroups.2da row
        sounds: []mut resref::ResRef,           // heap
        fixed_variance: f32 = 0.0,          // SoundObjectSetFixedVariance: a constant pitch multiplier, 0 none
    }

    // An encounter (UTE + the GIT's polygon and spawn points): creatures it spawns when the party
    // walks in (ours, simplified: once, RecCreatures of them, at the spawn points in turn).
    struct Encounter {
        active: bool,
        polygon: []mut math::Vec3,          // area space; heap
        spawn_points: []mut math::Vec4,     // x, y, z, facing (radians); heap
        creatures: []mut resref::ResRef,    // what it spawns; heap
        max_creatures: u32,
        rec_creatures: u32,
        player_only: bool,
        spawned: bool,
    }

    // A merchant (UTM; docs/re/party-items-saves.md 5.8): the percentages of an item's value it
    // charges (markup) and pays (markdown), the bonuses its last OpenStore gave, which pages it
    // offers (BuySellFlag bit 0: sells, bit 1: buys) and its stock.
    struct Store {
        markup: i32,
        markdown: i32,
        bonus_markup: i32,
        bonus_markdown: i32,
        buy_sell: u8,
        stock: list::List(u32, heap::Heap), // item ids, ascending by value as the original loads them
    }

    struct Aoe { creator: u32, radius: f32 }

    // The area's grass (ARE Grass_*): quads of one texture's four quarters, `density` of them per square metre of
    // walkmesh whose surface material has the grass flag, each `quad_size` metres across. `prob` is the chance of
    // each quarter: lower left, lower right, upper left, upper right. Empty `texture`: none.
    struct Grass { texture: resref::ResRef, density: f32, quad_size: f32, prob: [4]f32, wind: i32 }

    struct Area {
        resref: resref::ResRef = resref::empty{},
        name: Name,
        music_day: i32 = 0,
        music_night: i32 = 0,
        music_battle: i32 = 0,
        music_delay: i32 = 0,               // ms
        ambient_day: i32 = 0,
        ambient_night: i32 = 0,
        ambient_day_volume: i32 = 0,
        ambient_night_volume: i32 = 0,
        env_audio: i32 = 0,
        camera_style: u32 = 0,              // camerastyle.2da row
        restrict_mode: u32 = 0,
        no_rest: bool = false,              // ARE NoRest (area +0xb0): the player may not rest here
        unescapable: bool = false,
        is_night: bool = false,
        dyn_ambient: u32 = 0,               // DynAmbientColor, 0x00BBGGRR
        sun_ambient: u32 = 0,
        sun_diffuse: u32 = 0,
        fog_on: bool = false,
        fog_near: f32 = 99.0,
        fog_far: f32 = 100.0,
        fog_color: u32 = 0,
        grass: Grass = obj::Grass{ texture = resref::empty{}, density = 0.0, quad_size = 1.0, prob = [0.25; 4], wind = 0 },
        shadow_opacity: u32 = 128,          // ShadowOpacity, 0..255: how dark creatures' shadows are
        load_screen: u32 = 0,
        last_heartbeat: u64 = 0,
        transition_token: u8 = 0,           // gameloop.md 5.2
        transition_pending: u8 = 0,
        // The stealth XP bonus (a script-side system: the scripts set all of it, AwardStealthXP pays
        // the current amount to the party and switches it off).
        stealth_xp_max: i32 = 0,
        stealth_xp_current: i32 = 0,
        stealth_xp_decrement: i32 = 0,
        stealth_xp_enabled: bool = false,
        flags: u32 = 0,                     // ARE Flags: 1 interior, 2 underground, 4 natural
        listen_mod: i32 = 0,                // ARE ModListenCheck: added to hearing a creature that hides
        minigame: ?*mut mg::Area = null,        // the ARE's MiniGame struct (lib/minigame); null for every other area. Module memory
    }

    struct Module {
        name: resref::ResRef,               // the module's resref (end_m01aa)
        area_name: resref::ResRef,
        entry_position: math::Vec3,
        entry_direction: math::Vec3,
        min_per_hour: u32,
        dawn_hour: u32,
        dusk_hour: u32,
        xp_scale: u32,
        vo_id: []mut u8,
        last_heartbeat: u64,
    }

    // The kind's data, if `o` is that kind.
    fn creature { o: *Object } -> ?*mut Creature {
        if o.ext is creature{ c } { return c }
        return null
    }
    fn door { o: *Object } -> ?*mut Door {
        if o.ext is door{ d } { return d }
        return null
    }
    fn placeable { o: *Object } -> ?*mut Placeable {
        if o.ext is placeable{ p } { return p }
        return null
    }
    fn trigger { o: *Object } -> ?*mut Trigger {
        if o.ext is trigger{ t } { return t }
        return null
    }
    fn item { o: *Object } -> ?*mut Item {
        if o.ext is item{ i } { return i }
        return null
    }
    fn store { o: *Object } -> ?*mut Store {
        if o.ext is store{ st } { return st }
        return null
    }
    fn waypoint { o: *Object } -> ?*mut Waypoint {
        if o.ext is waypoint{ wp } { return wp }
        return null
    }
    fn encounter { o: *Object } -> ?*mut Encounter {
        if o.ext is encounter{ e } { return e }
        return null
    }
    fn sound { o: *Object } -> ?*mut Sound {
        if o.ext is sound{ s } { return s }
        return null
    }
    fn area { o: *Object } -> ?*mut Area {
        if o.ext is area{ a } { return a }
        return null
    }
    fn module { o: *Object } -> ?*mut Module {
        if o.ext is module{ m } { return m }
        return null
    }

    // The script hook for a slot.
    fn script { o: *Object, slot: Slot } -> resref::ResRef { return o.scripts[@as(usize, slot)] }

    fn set_script { o: *mut Object, slot: Slot, name: resref::ResRef } { o.scripts[@as(usize, slot)] = name }

    // GetFacing: degrees counter-clockwise from +x, 0..360.
    fn facing_degrees { o: *Object } -> f32 {
        let mut d = math::degrees{ radians = math::atan2f{ y = o.orientation.y, x = o.orientation.x } }
        if d < 0.0 { d = d + 360.0 }
        return d
    }

    // The facing vector for a heading in degrees (SetFacing, GetFacing's inverse).
    fn direction_of { degrees: f32 } -> math::Vec3 {
        let r = math::radians{ degrees }
        return math::Vec3{ x = math::cosf{ x = r }, y = math::sinf{ x = r }, z = 0.0 }
    }

    // A door's or placeable's Bearing (radians counter-clockwise from +Y) as a facing vector.
    fn direction_of_bearing { bearing: f32 } -> math::Vec3 {
        return math::Vec3{ x = -math::sinf{ x = bearing }, y = math::cosf{ x = bearing }, z = 0.0 }
    }

    // The rotation about Z that turns a model (facing +Y) to face along `orientation`.
    fn model_yaw { orientation: math::Vec3 } -> f32 {
        return math::atan2f{ y = orientation.y, x = orientation.x } - math::PI * 0.5
    }

    // Local booleans and numbers (GetLocalBoolean/Number). Index out of range: false / 0.
    fn local_bool { l: Locals, index: i32 } -> bool {
        if index < 0 or index >= 96 { return false }
        let i = @as(usize, index)
        return (l.bools[i / 32] >> @as(u32, i % 32)) & 1 != 0
    }
    fn set_local_bool { mut l: Locals, index: i32, value: bool } {
        if index < 0 or index >= 96 { return }
        let i = @as(usize, index)
        let bit: u32 = 1 << @as(u32, i % 32)
        if value { l.bools[i / 32] = l.bools[i / 32] | bit } else { l.bools[i / 32] = l.bools[i / 32] & ~bit }
    }
    fn local_number { l: Locals, index: i32 } -> i32 {
        if index < 0 or index >= 8 { return 0 }
        return @as(i32, l.numbers[@as(usize, index)])
    }
    fn set_local_number { mut l: Locals, index: i32, value: i32 } {
        if index < 0 or index >= 8 { return }
        l.numbers[@as(usize, index)] = @trunc(u8, value)
    }

    // ---- the id table

    struct Table {
        by_id: map::Map(u32, *mut Object, heap::Heap),
        all: list::List(*mut Object, heap::Heap),    // creation order; destroyed ones removed by sweep
        next_low: u32,
        next_high: u32,
    }

    fn new_table { heap: *mut heap::Heap } -> Table {
        return Table{
            by_id = map::new(u32, *mut Object, heap::Heap){ realloc = heap::alloc, heap, hash = map::hash_u32, eq = map::eq_u32 },
            all = list::new(*mut Object, heap::Heap){ realloc = heap::alloc, heap },
            next_low = 1,
            next_high = FIRST_CHARACTER,
        }
    }

    // A fresh id: low for ordinary objects, high (counting down) for player characters.
    fn next_id { mut t: Table, character: bool } -> u32 {
        if character {
            let id = t.next_high
            t.next_high = t.next_high - 1
            return id
        }
        let id = t.next_low
        t.next_low = t.next_low + 1
        return id
    }

    // A lower-cased heap copy of `s`.
    fn copy_lower { mut heap: heap::Heap, s: []u8 } -> ![]mut u8 {
        let out = try alloc::make(u8, heap::Heap){ realloc = heap::alloc, &heap, count = s.len }
        let mut i: usize = 0
        while i < s.len {
            out[i] = ascii::to_lower{ c = s[i] }
            i = i + 1
        }
        return out
    }

    // A heap copy of `s`.
    fn copy_bytes { mut heap: heap::Heap, s: []u8 } -> ![]mut u8 {
        let out = try alloc::make(u8, heap::Heap){ realloc = heap::alloc, &heap, count = s.len }
        slice::copy(u8){ dst = out, src = s }
        return out
    }

    fn free_bytes { mut heap: heap::Heap, s: []mut u8 } {
        if s.len == 0 { return }
        _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, &heap, mem = s, count = 0 }
    }

    // A new object of `kind` with id `id` and no kind data yet: everything at the defaults the
    // constructors give (objects.md: commandable, AI level 0, animation 10000).
    fn make { heap: *mut heap::Heap, id: u32, kind: Kind } -> Object {
        return Object{
            id, kind, tag = slice::empty(u8){}, template = resref::empty{},
            name = Name{ strref = 0xFFFFFFFF, text = slice::empty(u8){} },
            area = INVALID, position = math::vec3::zero{}, orientation = math::Vec3{ x = 0.0, y = 1.0, z = 0.0 },
            scripts = [resref::empty{}; 42], locals = Locals{ bools = [0; 3], numbers = [0; 8] },
            actions = list::new(actions::Action, heap::Heap){ realloc = heap::alloc, heap },
            action_group = 0, commandable = true, hp = 1, hp_max = 1, hardness = 0, hp_temp = 0, plot = false,
            min_one_hp = false, animation = ANIM_STAND, anim_speed = 1.0, anim_cycles = 0.0, dirty = 7,
            ai_level = 0, conversation = resref::empty{}, faction = 0, ctx = Context{ .. },
            destroyed = false, ext = Ext::none,
        }
    }

    // The creature data's defaults.
    fn make_creature { heap: *mut heap::Heap } -> Creature {
        return Creature{
            inventory = list::new(u32, heap::Heap){ realloc = heap::alloc, heap },
            path = list::new(math::Vec3, heap::Heap){ realloc = heap::alloc, heap },
            triggers = list::new(u32, heap::Heap){ realloc = heap::alloc, heap },
            perceived = list::new(Perceived, heap::Heap){ realloc = heap::alloc, heap },
            ..
        }
    }
}
