// What a fight tells the presentation (docs/design/vfx.md): a ranged attack's bolt leaves and
// arrives, a hit's impact effect, the sounds of shots, swings and hits. Nothing here changes the
// fight: the notes go to the outbox and lib/vfx and the mixer make something of them.
namespace fight {
    // A bolt's flight takes about 23.8 ms per metre of distance (combat.md 3.3, ReaxnDelay; med).
    const BOLT_MS_PER_M: f32 = 23.8
    const MIN_FLIGHT_MS: i32 = 40
    const MAX_FLIGHT_MS: i32 = 1500

    // Visual effect ids the combat uses (visualeffects.2da labels).
    const VFX_BLASTER_DEFLECTION: i32 = 4023
    const VFX_BLASTER_IMPACT: i32 = 4024
    const VFX_SPARKS_LIGHTSABER: i32 = 4004
    const VFX_SPARKS_PARRY_METAL: i32 = 4011

    // How long a bolt from `o` takes to reach `t`.
    fn bolt_ms { o: *obj::Object, t: *obj::Object } -> i32 {
        let dx = t.position.x - o.position.x
        let dy = t.position.y - o.position.y
        let ms = @as(i32, math::sqrtf{ x = dx * dx + dy * dy } * BOLT_MS_PER_M)
        return if ms < MIN_FLIGHT_MS { MIN_FLIGHT_MS } else if ms > MAX_FLIGHT_MS { MAX_FLIGHT_MS } else { ms }
    }

    // The item in one of the creature's weapon hands (hand 1 is the left; a missing left hand
    // shoots from the right).
    fn hand_item { c: *obj::Creature, hand: i32 } -> u32 {
        if hand == 1 and c.equipped[obj::SLOT_LEFT_WEAPON] != obj::INVALID { return c.equipped[obj::SLOT_LEFT_WEAPON] }
        return c.equipped[obj::SLOT_RIGHT_WEAPON]
    }

    // The ammunitiontypes.2da row of a ranged weapon (0 none).
    fn ammo_of { w: *world::World, item: u32 } -> i32 {
        let io = world::object{ w, id = item } ifnull { return 0 }
        let it = obj::item{ o = io } ifnull { return 0 }
        return twoda::get_int{ t = w.tables.baseitems, row = @as(usize, it.base), column = "ammunitiontype" } ifnull 0
    }

    // Plays a sound resource at a point (the mixer finds it by name).
    fn say { mut w: world::World, name: []u8, at: math::Vec3, source: u32 } {
        if name.len == 0 or name.len > 16 { return }
        if w.log.trace {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "sound {} for {}\n", name, source)
        }
        outbox::post{ out = &w.out, note = outbox::Note::play_sound{ name = resref::truncate{ name }, object = source, position = at, positional = true } }
    }

    fn chest_of { o: *obj::Object } -> math::Vec3 {
        return math::Vec3{ x = o.position.x, y = o.position.y, z = o.position.z + 1.2 }
    }

    // A bolt leaves the weapon at its shot time: the shot note for the bolt and muzzle flash,
    // the weapon's firing sound.
    fn fire_shot { mut w: world::World, id: u32, imp: *Impact, power: bool } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let ammo = ammo_of{ w = &w, item = hand_item{ c, hand = imp.hand } }
        if ammo <= 0 { return }
        let result = if imp.attack { imp.result } else { rules::outcome::MISS }
        outbox::post{ out = &w.out, note = outbox::Note::shot{
            attacker = id, target = imp.target, ammo, power, hand = imp.hand, flight_ms = imp.at_ms - imp.fire_ms, result,
        } }
        let sound = twoda::get_string{ t = w.tables.ammunitiontypes, row = @as(usize, ammo), column = if power { "shotsound1" } else { "shotsound0" } } ifnull ""
        say{ &w, name = sound, at = chest_of{ o }, source = id }
    }

    // A visualeffects.2da effect on an object, or at a point when `target` is OBJECT_INVALID: the
    // note for lib/vfx and the row's impact sound. Scripts' EffectVisualEffect, a power's cast and
    // impact, a grenade's blast all come here.
    fn visual_effect { mut w: world::World, effect: i32, target: u32, source: u32, position: math::Vec3 } {
        outbox::post{ out = &w.out, note = outbox::Note::visual{ effect, target, source, position } }
        let mut digits: [12]u8
        let mut d: usize = 0
        let mut x = if effect < 0 { 0 } else { effect }
        if x == 0 { digits[0] = '0'; d = 1 }
        while x > 0 and d < 12 { digits[d] = @trunc(u8, '0' + @as(u32, x % 10)); x = x / 10; d = d + 1 }
        let mut label: [12]u8
        let mut n: usize = 0
        while d > 0 { d = d - 1; label[n] = digits[d]; n = n + 1 }
        let row = twoda::find_row{ t = w.tables.visualeffects, label = label[..n] } ifnull { return }
        let sound = twoda::get_string{ t = w.tables.visualeffects, row, column = "soundimpact" } ifnull ""
        let mut at = position
        if world::object{ w = &w, id = target } is some{ value = o } { at = chest_of{ o } }
        say{ &w, name = sound, at, source = target }
    }

    // A Force power's visuals as it is conjured (`cast` false) or cast (spells.2da: the
    // conj*/cast* head, hand and ground models), on the caster's head, hands and feet.
    fn spell_visuals { mut w: world::World, id: u32, spell: i32, cast: bool } {
        let o = world::object{ w = &w, id } ifnull { return }
        let head: []u8 = if cast { "castheadvisual" } else { "conjheadvisual" }
        let hand: []u8 = if cast { "casthandvisual" } else { "conjhandvisual" }
        let ground: []u8 = if cast { "castgrndvisual" } else { "conjgrndvisual" }
        let columns: [3][]u8 = [head, hand, ground]
        let hooks: [3][]u8 = ["headhook", "handconjure", ""]
        let mut k: usize = 0
        while k < 3 {
            let model = twoda::get_string{ t = w.tables.spells, row = @as(usize, spell), column = columns[k] } ifnull ""
            if model.len > 0 and model.len <= 16 and not ci::eq{ a = model, b = "****" } {
                outbox::post{ out = &w.out, note = outbox::Note::effect_model{
                    model = resref::truncate{ name = model }, object = if hooks[k].len > 0 { id } else { obj::INVALID }, hook = resref::truncate{ name = hooks[k] },
                    position = o.position, life = 0.0,
                } }
            }
            k = k + 1
        }
    }

    // The first damagehitvisual.2da effect of a damage type that did damage (ranged column).
    fn ranged_hit_effect { w: *world::World, damage: *rules::DamageRoll } -> i32 {
        let mut slot: usize = 0
        while slot < 15 {
            if damage.slots[slot] > 0 {
                let v = twoda::get_int{ t = w.tables.damagehitvisual, row = slot, column = "rangedeffect" } ifnull 0
                if v > 0 { return v }
            }
            slot = slot + 1
        }
        return 0
    }

    // A bolt arrives: the impact effect and sound on a hit, the deflection effect on a bolt
    // that was knocked away. (A miss flew on; lib/vfx ends it where it hits.)
    fn land_ranged_fx { mut w: world::World, id: u32, imp: *Impact, power: bool } {
        let t = world::object{ w = &w, id = imp.target } ifnull { return }
        if not imp.attack { return }
        if imp.hit {
            let mut effect = ranged_hit_effect{ w = &w, damage = &imp.damage }
            if effect == 0 and imp.damage.total > 0 { effect = VFX_BLASTER_IMPACT }
            if effect > 0 { visual_effect{ &w, effect, target = imp.target, source = id, position = math::vec3::zero{} } }
            let o = world::object{ w = &w, id } ifnull { return }
            let c = obj::creature{ o } ifnull { return }
            let ammo = ammo_of{ w = &w, item = hand_item{ c, hand = imp.hand } }
            if ammo > 0 {
                let sound = twoda::get_string{ t = w.tables.ammunitiontypes, row = @as(usize, ammo), column = if power { "impactsound1" } else { "impactsound0" } } ifnull ""
                say{ &w, name = sound, at = chest_of{ o = t }, source = imp.target }
            }
        } else if imp.result == rules::outcome::DEFLECTED or imp.result == rules::outcome::RETURNED {
            visual_effect{ &w, effect = VFX_BLASTER_DEFLECTION, target = imp.target, source = id, position = math::vec3::zero{} }
        }
    }

    // The creature's appearancesndset.2da row (appearance.soundapptype), -1 if it has none.
    fn sound_type_of { w: *world::World, c: *obj::Creature } -> i32 {
        return twoda::get_int{ t = w.tables.appearance, row = @as(usize, c.appearance), column = "soundapptype" } ifnull -1
    }

    // weaponsounds.2da's column for the material a hit lands on: the worn armour's type, else the
    // creature's own (appearancesndset.2da: droids "armor", beasts "leather"), else leather (cloth
    // and leather share their sounds).
    fn hit_column { w: *world::World, t: *obj::Object, into: []mut u8 } -> []u8 {
        let mut kind: []u8 = "leather"
        if obj::creature{ o = t } is some{ value = tc } {
            let st = sound_type_of{ w, c = tc }
            if st >= 0 {
                let own = twoda::get_string{ t = w.tables.appearancesndset, row = @as(usize, st), column = "armortype" } ifnull ""
                if own.len > 0 and own.len < 12 { kind = own }
            }
            if world::object{ w, id = tc.equipped[obj::SLOT_BODY] } is some{ value = armor } {
                if obj::item{ o = armor } is some{ value = it } {
                    let s = twoda::get_string{ t = w.tables.baseitems, row = @as(usize, it.base), column = "armortype" } ifnull ""
                    if s.len > 0 and s.len < 12 { kind = s }
                }
            }
        }
        let mut n: usize = 0
        while n < kind.len { into[n] = kind[n]; n = n + 1 }
        into[n] = '0'
        return into[..n + 1]
    }

    // weaponsounds.2da's row for the attacker's weapon: its material type; with none, the
    // creature's own weapon sounds (appearancesndset.2da, 0 unarmed).
    fn weapon_sound_row { w: *world::World, c: *obj::Creature } -> usize {
        let item = c.equipped[obj::SLOT_RIGHT_WEAPON]
        if world::object{ w, id = item } is some{ value = io } {
            if obj::item{ o = io } is some{ value = it } {
                return @as(usize, twoda::get_int{ t = w.tables.baseitems, row = @as(usize, it.base), column = "weaponmattype" } ifnull 0)
            }
        }
        let st = sound_type_of{ w, c }
        if st < 0 { return 0 }
        return @as(usize, twoda::get_int{ t = w.tables.appearancesndset, row = @as(usize, st), column = "weapon" } ifnull 0)
    }

    // A melee attack lands: the weapon's hit sound on the target's material, or the parry sound
    // when the blow was turned.
    fn land_melee_fx { mut w: world::World, id: u32, imp: *Impact } {
        let t = world::object{ w = &w, id = imp.target } ifnull { return }
        if not imp.attack { return }
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let row = weapon_sound_row{ w = &w, c }
        let mut col: [16]u8
        // A blow that missed was turned by the defender's weapon: sparks where the blades meet
        // (blue for a lightsaber, metal sparks for two plain blades), and the clash of two sabers.
        let mut parried = false
        let mut clash = false
        if not imp.hit and obj::creature{ o = t } is some{ value = tc } {
            parried = holds_weapon{ w = &w, c = tc } and holds_weapon{ w = &w, c }
            clash = parried and row == 1 and weapon_sound_row{ w = &w, c = tc } == 1
        }
        let column: []u8 = if imp.hit { hit_column{ w = &w, t, into = col[..] } } else if clash { "clash0" } else { "parry0" }
        let sound = twoda::get_string{ t = w.tables.weaponsounds, row, column } ifnull ""
        say{ &w, name = sound, at = chest_of{ o = t }, source = imp.target }
        if parried {
            let mid = math::vec3::lerp{ a = chest_of{ o }, b = chest_of{ o = t }, t = 0.5 }
            let effect = if row == 1 or weapon_sound_row{ w = &w, c = obj::creature{ o = t } ifnull c } == 1 { VFX_SPARKS_LIGHTSABER } else { VFX_SPARKS_PARRY_METAL }
            visual_effect{ &w, effect, target = obj::INVALID, source = id, position = mid }
        }
    }

    // Whether the creature holds a weapon in its right hand.
    fn holds_weapon { w: *world::World, c: *obj::Creature } -> bool {
        return world::object{ w, id = c.equipped[obj::SLOT_RIGHT_WEAPON] } != null
    }

    // A lightsaber lights or goes out: the item's powerup or powerdown sound (baseitems.2da).
    fn saber_sound { mut w: world::World, id: u32, lit: bool } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let item = world::object{ w = &w, id = hand_item{ c, hand = 0 } } ifnull { return }
        let it = obj::item{ o = item } ifnull { return }
        let sound = twoda::get_string{ t = w.tables.baseitems, row = @as(usize, it.base), column = if lit { "powerupsnd" } else { "powerdownsnd" } } ifnull ""
        say{ &w, name = sound, at = chest_of{ o }, source = id }
    }

    // The surface material under a point (surfacemat.2da row), 0 off the walkmesh.
    fn surface_at { w: *world::World, at: math::Vec3 } -> u32 {
        let f = walkmap::floor{ m = &w.walk, x = at.x, y = at.y, z = at.z } ifnull { return 0 }
        let rooms = list::items{ list = w.walk.rooms }
        if f.room < 0 or @as(usize, f.room) >= rooms.len { return 0 }
        let mesh = rooms[@as(usize, f.room)].mesh ifnull { return 0 }
        if @as(usize, f.face) >= mesh.materials.len { return 0 }
        return mesh.materials[@as(usize, f.face)]
    }

    // An event of a creature's animation (the model's own: `Swingshort`, `Swinglong`, `Swingtwirl`
    // a weapon whooshes, `snd_hitground` a body lands): its sound from weaponsounds.2da and
    // appearancesndset.2da, at the creature.
    fn animation_event { mut w: world::World, id: u32, name: []u8 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        if ci::starts_with{ s = name, prefix = "swing" } {
            let base: []u8 = if ci::eq{ a = name, b = "swinglong" } { "swinglong" } else if ci::eq{ a = name, b = "swingtwirl" } { "swingtwirl" } else { "swingshort" }
            let mut col: [16]u8
            let mut n: usize = 0
            while n < base.len { col[n] = base[n]; n = n + 1 }
            col[n] = @trunc(u8, '0' + @wrap_add(@wrap_mul(id, 2654435761), @trunc(u32, w.clock.frame)) / 7 % 3)      // not the world's dice: sound must not change the game
            let sound = twoda::get_string{ t = w.tables.weaponsounds, row = weapon_sound_row{ w = &w, c }, column = col[..n + 1] } ifnull ""
            say{ &w, name = sound, at = chest_of{ o }, source = id }
        } else if ci::eq{ a = name, b = "snd_hitground" } {
            // dirt, hard ground, metal or water by the surface it lands on.
            let st = sound_type_of{ w = &w, c }
            if st < 0 { return }
            let surface = surface_at{ w = &w, at = o.position }
            let column: []u8 = if surface == 10 { "fallmetal" } else if surface == 1 or surface == 3 or surface == 12 or surface == 13 or surface == 14 { "falldirt" } else if surface == 6 or surface == 17 { "fallwater" } else { "fallhard" }
            let sound = twoda::get_string{ t = w.tables.appearancesndset, row = @as(usize, st), column } ifnull ""
            say{ &w, name = sound, at = o.position, source = id }
        }
    }
}
