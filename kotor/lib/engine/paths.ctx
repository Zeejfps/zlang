// Path planning for server-side moves (docs/re/movement.md 4.3-4.7): the straight walk when it is clear;
// otherwise, in an area with a PTH graph, the original's path-point planner (CSWSArea::PlotPathPointRoute
// 0x004c2200): an unsafe start or goal moved to the nearest safe spot within 2 m, the path points nearest them found
// in growing windows, the graph searched depth first with a deepening cost bound, then string pulling (skip route
// points while the straight walk past them is clear; ours, in place of the original's three straightening passes and
// corner rounding). Without PTH points or a route, the farthest clear point along the straight line (the original's
// fallback, 4.3 step 6).
namespace paths {
    // Whether a creature can walk straight from `a` to `b` on the walkmesh.
    fn clear { w: *world::World, a: math::Vec3, b: math::Vec3 } -> bool {
        return walkmap::step_to{ m = &w.walk, from = a, to = b } != null
    }

    // The same from a place that is only being tried as a goal: one inside a blocking footprint does not count.
    fn clear_from_goal { w: *world::World, a: math::Vec3, b: math::Vec3 } -> bool {
        return walkmap::step_to_strict{ m = &w.walk, from = a, to = b } != null
    }

    fn point_at { w: *world::World, g: pth::Graph, i: u32, near_z: f32 } -> math::Vec3 {
        let p = g.points[@as(usize, i)]
        let mut z = near_z
        let f = walkmap::floor{ m = &w.walk, x = p.x, y = p.y, z = near_z + 2.0 }
        if f != null { z = f.z }
        return math::Vec3{ x = p.x, y = p.y, z }
    }

    const NO_Z: f32 = -1000000.0
    const FAR: f32 = 1000000000.0

    // Whether the graph edge between points `a` and `b` runs into an active placeable. The points' heights
    // (a floor lookup each) are found once per route, in `zs`.
    fn meets_placeable { mut w: world::World, g: pth::Graph, zs: []mut f32, a: usize, b: usize, near_z: f32 } -> bool {
        if zs[a] == NO_Z { zs[a] = point_at{ w = &w, g, i = @as(u32, a), near_z }.z }
        if zs[b] == NO_Z { zs[b] = point_at{ w = &w, g, i = @as(u32, b), near_z }.z }
        let pa = g.points[a]
        let pb = g.points[b]
        return walkmap::meets_placeable{ m = &w.walk, from = math::Vec3{ x = pa.x, y = pa.y, z = zs[a] }, to = math::Vec3{ x = pb.x, y = pb.y, z = zs[b] } }
    }

    // The path point nearest `at` that a straight walk from it reaches (CSWSArea::FindNearestPathPoint 0x004bd770): a
    // square window of +-10 m round it, grown by 10 m at a time up to 50 times; in each, the nearest of the points that
    // the smaller windows did not hold whose walk is clear wins. So a nearer point in a corner of the next window loses
    // to one in this window. The original walks the points in their x order and stops at the window's right edge (every
    // PTH in the game is sorted by x); here every point is looked at, with the same result.
    const WINDOW: f32 = 10.0
    const WINDOWS: u32 = 50

    fn nearest_point { mut w: world::World, g: pth::Graph, at: math::Vec3, goal: bool } -> ?u32 {
        let n = g.points.len
        let tried = alloc::resize(bool, arena::Arena){ realloc = arena::alloc, heap = w.scratch, mem = slice::empty(bool){}, count = n } iferr { return null }
        let mut k: u32 = 0
        while k < WINDOWS {
            let half = WINDOW * @as(f32, k + 1)
            // The previous window, less its last centimetre: its points were looked at already.
            let inner = if k == 0 { -1.0 } else { WINDOW * @as(f32, k) - 0.01 }
            let mut i: usize = 0
            while i < n {
                let p = g.points[i]
                let dx = p.x - at.x
                let dy = p.y - at.y
                let outside = dx < -half or dx > half or dy < -half or dy > half
                let seen = inner > 0.0 and dx > -inner and dx < inner and dy > -inner and dy < inner
                tried[i] = outside or seen
                i = i + 1
            }
            // This window's points, nearest first, until one is in a clear walk.
            while true {
                let mut best: i32 = -1
                let mut best_d: f32 = FAR
                i = 0
                while i < n {
                    if not tried[i] {
                        let p = g.points[i]
                        let d = (p.x - at.x) * (p.x - at.x) + (p.y - at.y) * (p.y - at.y)
                        if d < best_d {
                            best = @as(i32, i)
                            best_d = d
                        }
                    }
                    i = i + 1
                }
                if best < 0 { break }
                let b = @as(u32, best)
                let p = point_at{ w = &w, g, i = b, near_z = at.z }
                if (if goal { clear_from_goal{ w = &w, a = at, b = p } } else { clear{ w = &w, a = at, b = p } }) { return b }
                tried[@as(usize, best)] = true
            }
            k = k + 1
        }
        return null
    }

    // A route for creature `id` from `from` to `goal` into `out` (the points to walk to, the goal last); false when even
    // the fallback has nowhere to go. Scratch memory for the search comes from w.scratch. `adjusted` says the route ends
    // at another point than the goal asked for (the nearest safe spot, when nobody can stand on the goal).
    fn plan { mut w: world::World, id: u32, from: math::Vec3, goal: math::Vec3, out: *mut list::List(math::Vec3, heap::Heap), adjusted: *mut bool } -> bool {
        adjusted.* = false
        list::clear{ list = out }
        if clear{ w = &w, a = from, b = goal } {
            list::push{ list = out, item = goal } iferr { return false }
            return true
        }
        let g = w.paths
        if g != null and g.points.len > 0 {
            if route{ &w, id, g, from, goal_asked = goal, out, adjusted } { return true }
        }
        // The farthest clear point along the straight line, by bisection.
        let mut lo: f32 = 0.0
        let mut hi: f32 = 1.0
        let mut k: u32 = 0
        while k < 12 {
            let mid = (lo + hi) * 0.5
            let p = math::vec3::lerp{ a = from, b = goal, t = mid }
            if clear{ w = &w, a = from, b = p } { lo = mid } else { hi = mid }
            k = k + 1
        }
        if lo < 0.01 { return false }
        list::push{ list = out, item = math::vec3::lerp{ a = from, b = goal, t = lo } } iferr { return false }
        return true
    }

    // Whether creature `id` may stand at `p` (IsPositionSafe 0x004be5e0, as movement::safe_spot tests it).
    fn is_safe { w: *world::World, id: u32, p: math::Vec3 } -> bool {
        return movement::safe_spot{ w, id, at = p, radius = 0.0, need_line = false } != null
    }

    fn route { mut w: world::World, id: u32, g: pth::Graph, from: math::Vec3, goal_asked: math::Vec3, out: *mut list::List(math::Vec3, heap::Heap), adjusted: *mut bool } -> bool {
        // An unsafe start or goal is replaced by the nearest safe spot within 2 m that a straight walk from it reaches
        // (state 1; FindNearestSafePosition 0x004be860); the creature is moved to its new start. None: they stay.
        let mut start = from
        if not is_safe{ w = &w, id, p = from } {
            if movement::safe_spot{ w = &w, id, at = from, radius = 2.0, need_line = true } is some{ value = p } {
                start = p
                if movement::distance_2d{ a = p, b = from } > 0.0001 { movement::place{ &w, id, at = p } }
            }
        }
        let mut goal = goal_asked
        if not is_safe{ w = &w, id, p = goal } {
            if movement::safe_spot{ w = &w, id, at = goal, radius = 2.0, need_line = true } is some{ value = p } {
                goal = p
                adjusted.* = movement::distance_2d{ a = p, b = goal_asked } > 0.0001
            }
        }
        let s = nearest_point{ w = &w, g, at = start, goal = false } ifnull {
            if w.log.actions { _ = @fmt(&w.io, "route: no clear path point near the start ({} points)\n", g.points.len) }
            return false
        }
        let t = nearest_point{ w = &w, g, at = goal, goal = true } ifnull {
            if w.log.actions { _ = @fmt(&w.io, "route: no clear path point near the goal {} {} {} from {} {} {} ({} points)\n", goal.x, goal.y, goal.z, start.x, start.y, start.z, g.points.len) }
            return false
        }
        let mut chain = list::new(u32, arena::Arena){ realloc = arena::alloc, heap = w.scratch }
        if s == t {
            list::push{ list = &chain, item = s } iferr { return false }
        } else if not search{ &w, id, g, s, t, d = movement::distance_2d{ a = start, b = goal }, near_z = start.z, chain = &chain } {
            if w.log.actions { _ = @fmt(&w.io, "route: no way through the path points from {} to {}\n", s, t) }
            return false
        }
        let ids = list::items{ list = chain }
        let mut raw = list::new(math::Vec3, arena::Arena){ realloc = arena::alloc, heap = w.scratch }
        let mut j: usize = 0
        while j < ids.len {
            list::push{ list = &raw, item = point_at{ w = &w, g, i = ids[j], near_z = start.z } } iferr { return false }
            j = j + 1
        }
        list::push{ list = &raw, item = goal } iferr { return false }
        // String pulling: from where we are, go to the farthest point the straight walk reaches.
        let pts = list::items{ list = raw }
        let mut here = start
        let mut next: usize = 0
        while next < pts.len {
            let mut far = pts.len - 1
            while far > next and not clear{ w = &w, a = here, b = pts[far] } { far = far - 1 }
            list::push{ list = out, item = pts[far] } iferr { return false }
            here = pts[far]
            next = far + 1
        }
        return true
    }

    // The graph search between the path points `s` and `t` (state 4, CSWSArea::PathPointSearch 0x004c0b30): depth first
    // from s, each branch cut when its cost so far plus the straight distance to t passes the bound, or when the point
    // was reached before at no more cost (the visited table, kept from pass to pass); the bound is d/2 + 10 in the
    // first pass (d the start-to-goal distance) and grows by d/4 a pass. A pass that expands 4096 points ends the
    // search (the original runs out of planner calls); so does one that cut no branch for the bound, which a bigger
    // bound cannot help (ours: the original tries again until its 100 calls are used). The route goes to `chain`.
    const EXPANSIONS: u32 = 4096
    const PASSES: u32 = 1000

    struct Search {
        g: pth::Graph,
        goal: u32,
        best_g: []mut f32,      // the visited table: the cost a point was reached at
        best_left: []mut f32,   // and the bound left there
        zs: []mut f32,
        near_z: f32,
        expanded: u32,
        overflow: bool,
        cut: bool,
        mover: u32,
    }

    fn search { mut w: world::World, id: u32, g: pth::Graph, s: u32, t: u32, d: f32, near_z: f32, chain: *mut list::List(u32, arena::Arena) } -> bool {
        let n = g.points.len
        let best_g = alloc::resize(f32, arena::Arena){ realloc = arena::alloc, heap = w.scratch, mem = slice::empty(f32){}, count = n } iferr { return false }
        let best_left = alloc::resize(f32, arena::Arena){ realloc = arena::alloc, heap = w.scratch, mem = slice::empty(f32){}, count = n } iferr { return false }
        let zs = alloc::resize(f32, arena::Arena){ realloc = arena::alloc, heap = w.scratch, mem = slice::empty(f32){}, count = n } iferr { return false }
        let mut i: usize = 0
        while i < n {
            best_g[i] = FAR
            best_left[i] = -FAR
            zs[i] = NO_Z
            i = i + 1
        }
        let mut st = Search{ g, goal = t, best_g, best_left, zs, near_z, expanded = 0, overflow = false, cut = false, mover = id }
        // Ours: a start and goal on the same spot would not grow the bound.
        let grow = math::max{ a = d * 0.25, b = 0.5 }
        let mut bound = d * 0.25 + 10.0
        let mut pass: u32 = 0
        while pass < PASSES {
            pass = pass + 1
            bound = bound + grow
            st.expanded = 0
            st.overflow = false
            st.cut = false
            list::clear{ list = chain }
            if expand{ &w, &st, node = s, cost = 0.0, left = bound, chain } { return true }
            if st.overflow or not st.cut { return false }
        }
        return false
    }

    fn expand { mut w: world::World, mut st: Search, node: u32, cost: f32, left: f32, chain: *mut list::List(u32, arena::Arena) } -> bool {
        list::push{ list = chain, item = node } iferr { return false }
        let depth = chain.len
        if node == st.goal { return true }
        let p = st.g.points[@as(usize, node)]
        let q = st.g.points[@as(usize, st.goal)]
        let h = math::sqrtf{ x = (p.x - q.x) * (p.x - q.x) + (p.y - q.y) * (p.y - q.y) }
        let k = @as(usize, node)
        if h > left or (st.best_g[k] < FAR and (st.best_g[k] < cost or left <= st.best_left[k])) {
            if h > left { st.cut = true }
            chain.len = depth - 1
            return false
        }
        st.expanded = st.expanded + 1
        if st.expanded >= EXPANSIONS { st.overflow = true }
        // The successors (GetPathPointSuccessors 0x004bdb00): each link not crossed by a placeable's walkmesh, its
        // cost the link's length, or the dog-leg round a creature standing on it; nearest to the goal first.
        let links = pth::links_of{ g = st.g, point = node }
        let mut to: [32]u32
        let mut price: [32]f32
        let mut near: [32]f32
        let mut count: usize = 0
        let mut j: usize = 0
        while j < links.len and count < 32 {
            let b = links[j]
            j = j + 1
            if b == node or @as(usize, b) >= st.g.points.len { continue }
            let pb = st.g.points[@as(usize, b)]
            if walkmap::placeable_near{ m = &w.walk, ax = p.x, ay = p.y, bx = pb.x, by = pb.y } {
                if meets_placeable{ w = &w, g = st.g, zs = st.zs, a = k, b = @as(usize, b), near_z = st.near_z } { continue }
            }
            let c = link_cost{ w = &w, mover = st.mover, a = p, b = pb, z = st.near_z }
            let hb = math::sqrtf{ x = (pb.x - q.x) * (pb.x - q.x) + (pb.y - q.y) * (pb.y - q.y) }
            // Insertion by the distance to the goal.
            let mut at = count
            while at > 0 and near[at - 1] > hb {
                to[at] = to[at - 1]
                price[at] = price[at - 1]
                near[at] = near[at - 1]
                at = at - 1
            }
            to[at] = b
            price[at] = c
            near[at] = hb
            count = count + 1
        }
        st.best_g[k] = cost
        st.best_left[k] = left
        j = 0
        while j < count and not st.overflow {
            if expand{ &w, &st, node = to[j], cost = cost + price[j], left = left - price[j], chain } { return true }
            j = j + 1
        }
        chain.len = depth - 1
        return false
    }

    // A link's cost: its length, or, when a creature's circle is across it, the length of the dog-leg past that creature
    // (both PERSPACEs out from its centre, to the link's left).
    fn link_cost { w: *world::World, mover: u32, a: pth::Point, b: pth::Point, z: f32 } -> f32 {
        let dx = b.x - a.x
        let dy = b.y - a.y
        let len = math::sqrtf{ x = dx * dx + dy * dy }
        let o = world::object{ w, id = mover } ifnull { return len }
        let c = obj::creature{ o } ifnull { return len }
        let hit = crowd::first_blocker{ w, o, c, from = math::Vec3{ x = a.x, y = a.y, z }, to = math::Vec3{ x = b.x, y = b.y, z }, skip = obj::INVALID, skip2 = obj::INVALID, pushable = false } ifnull { return len }
        let other = world::object{ w, id = hit.id } ifnull { return len }
        let oc = obj::creature{ o = other } ifnull { return len }
        if len < 0.000001 { return len }
        let off = oc.perspace + c.perspace
        let vx = other.position.x - dy / len * off
        let vy = other.position.y + dx / len * off
        return math::sqrtf{ x = (vx - a.x) * (vx - a.x) + (vy - a.y) * (vy - a.y) } + math::sqrtf{ x = (b.x - vx) * (b.x - vx) + (b.y - vy) * (b.y - vy) }
    }
}
