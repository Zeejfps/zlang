// Notes from the world to the presentation (docs/design/engine.md, "The outbox"): what the
// original sends the client as messages. Routines and world code append; the game loop drains
// them each frame to the scene, audio, GUI or dialogue. lib/engine never calls those itself.
namespace outbox {
    enum Music: u8 { day, night, battle }

    union Note {
        play_sound{ name: resref::ResRef, object: u32, position: math::Vec3, positional: bool },
        sound_object{ id: u32, play: bool, volume: i32 },
        music{ kind: Music, play: bool },
        music_row{ kind: Music, row: i32 },
        ambient{ play: bool },
        fade{ out: bool, wait: f32, length: f32, color: math::Vec3 },
        movie{ name: resref::ResRef },
        bark{ speaker: u32, strref: u32, text: Text, sound: resref::ResRef },
        feedback{ strref: u32, text: Text },
        hud_notice{ kind: i32 },                    // a HUD notification icon lights for a few seconds (hud::NOTE_*: 1 credits, 7 item received, 8 item lost, ...)
        post_string{ text: Text, x: i32, y: i32, life: f32 },
        no_clicks{ seconds: f32 },
        conversation{ owner: u32, speaker: u32, dialog: resref::ResRef },
        rumble{ pattern: i32 },
        // Appended by routines/presentation.ctx and misc.ctx. The area's music rows live on the
        // obj::Area (routines update them first); these say what the presentation should do about it.
        //   music: the background track (kind day or night: the one for the time of day) or the
        //   battle track starts (play) or stops; music_row: a row changed, replay if it is playing.
        ambient_row{ night: bool },                         // the day or night ambient bed's row or volume changed
        sound_fade{ id: u32, seconds: f32 },                // SoundObjectFadeAndStop
        room_animation{ room: Text, animation: i32 },       // PlayRoomAnimation: loops on the LYT room of that name
        lightsaber{ id: u32, forced: bool, powered: bool, transition: bool },   // SetLightsaberPowered
        tutorial{ window: i32 },                            // ShowTutorialWindow
        end_game{ show_gui: bool },                         // EndGame: the credits and the end-game panel
        open_store{ store: u32, customer: u32, markup: i32, markdown: i32 },   // OpenStore, bonuses clamped to +-100
        upgrade_screen{ item: u32 },                        // ShowUpgradeScreen (OBJECT_INVALID: pick one)
        open_container{ placeable: u32, user: u32 },        // a container the party opened (container::open): the loot panel
        level_up{ who: u32 },                               // ShowLevelUpGUI: the level-up panels for the player character
        galaxy_map{ planet: i32 },                          // ShowGalaxyMap: the map with that planet selected
        // PlayPazaak: the opponent's pazaakdecks.2da row (negative: random), the script to run after, the
        // wager limit (already clamped to the gold), the tutorial, the opponent creature
        // ShowPartySelectionGUI: the script to run when the screen closes (empty: none) and the NPC
        // slots forced into the party (-1 none); the available slots are in w.party.
        party_selection{ exit_script: resref::ResRef, force1: i32, force2: i32 },
        pazaak{ deck: i32, end_script: resref::ResRef, max_wager: i32, tutorial: bool, opponent: u32 },
        // Appended by routines/presentation.ctx. None of these screens exists yet; the routines keep
        // the state their getters answer from (World.credits_running, ...) and say what to show.
        //   area_effect: PlayVisualAreaEffect: visualeffects.2da row `effect` plays at a point of the area
        //   credits: StartCreditSequence (the world's credits_running is true until the credits end: the
        //     presentation clears it, and IsCreditSequenceInProgress then answers false)
        //   queue_movie / play_movie_queue: QueueMovie adds to the queue, PlayMovieQueue plays it in order
        //     (with separate_skips, Escape skips only the movie on screen)
        //   music_volume: SetMusicVolume, 0.0 to 1.0, for the music channel
        area_effect{ effect: i32, position: math::Vec3, area: u32 },
        credits{ transparent: bool },
        queue_movie{ name: resref::ResRef, skippable: bool },
        play_movie_queue{ separate_skips: bool },
        music_volume{ volume: f32 },
        // Combat and effects for lib/vfx (docs/design/vfx.md).
        //   shot: a ranged attack fires one bolt: from the attacker's weapon `hand` (0 right, 1 left) to
        //     the target, arriving `flight_ms` later; `ammo` is the ammunitiontypes.2da row, `power` the
        //     power-blast model; `result` is rules::outcome (a miss flies on past the target)
        //   visual: visualeffects.2da row `effect` (the VFX_* id) plays on `target` at its impact node,
        //     or at `position` when `target` is OBJECT_INVALID; `source` is the caster (for beams)
        shot{ attacker: u32, target: u32, ammo: i32, power: bool, hand: i32, flight_ms: i32, result: i32 },
        visual{ effect: i32, target: u32, source: u32, position: math::Vec3 },
        //   visual_hold / visual_release: a duration visual (visualeffects.2da Type_FD D: a stun's stars, a
        //     speed streak) stays on `target` until it is released
        //   beam / beam_end: a beam of visualeffects.2da id `style` from the effector's body node `part` (0 hand,
        //     1 chest, 2 head) to `target`, for `seconds`
        beam{ style: i32, source: u32, target: u32, part: i32, seconds: f32 },
        beam_end{ style: i32, target: u32 },
        //   saber_leg: a thrown lightsaber (the item `item`) flies from a point to a point in `flight_ms`
        saber_leg{ item: u32, from: math::Vec3, to: math::Vec3, flight_ms: i32 },
        visual_hold{ effect: i32, target: u32 },
        visual_release{ effect: i32, target: u32 },
        //   effect_model: an effect model by name (a power's cast visual in spells.2da) riding the
        //     node `hook` of `object` for `life` seconds (0: its animation's length), or at
        //     `position` when `object` is OBJECT_INVALID
        effect_model{ model: resref::ResRef, object: u32, hook: resref::ResRef, position: math::Vec3, life: f32 },
    }

    // Text copied into the outbox's buffer, valid until the outbox is drained.
    struct Text { at: usize, len: usize }

    struct Outbox {
        notes: list::List(Note, heap::Heap),
        text: list::List(u8, heap::Heap),
        dropped: u32,
    }

    fn new { heap: *mut heap::Heap } -> Outbox {
        return Outbox{
            notes = list::new(Note, heap::Heap){ realloc = heap::alloc, heap },
            text = list::new(u8, heap::Heap){ realloc = heap::alloc, heap },
            dropped = 0,
        }
    }

    fn post { mut out: Outbox, note: Note } {
        list::push{ list = &out.notes, item = note } iferr { out.dropped = out.dropped + 1 }
    }

    // Copies `s` into the buffer for a note's text field.
    fn keep_text { mut out: Outbox, s: []u8 } -> Text {
        let at = out.text.len
        let mut i: usize = 0
        while i < s.len {
            list::push{ list = &out.text, item = s[i] } iferr { return Text{ at, len = i } }
            i = i + 1
        }
        return Text{ at, len = s.len }
    }

    fn text_of { out: *Outbox, t: Text } -> []u8 {
        let all = list::items{ list = out.text }
        if t.at + t.len > all.len { return slice::empty(u8){} }
        return all[t.at..t.at + t.len]
    }

    fn notes { out: *Outbox } -> []mut Note { return list::items{ list = out.notes } }

    // Forgets every note, after the presentation took them.
    fn clear { mut out: Outbox } {
        list::clear{ list = &out.notes }
        list::clear{ list = &out.text }
    }
}
