// Creatures moving on the walkmesh (docs/re/movement.md 3, 5): server-side moves along a path
// (MOVETOPOINT and the approaches), placing objects on the floor, and the trigger bookkeeping
// every move does (which volumes a creature left or entered).
namespace movement {
    // A move gives up after this many blocked steps in a row (movement.md 3.4).
    const GIVE_UP: u32 = 6

    // Puts an object at `at`, its z on the floor under it when there is one.
    fn place { mut w: world::World, id: u32, at: math::Vec3 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let mut p = at
        let f = walkmap::floor{ m = &w.walk, x = at.x, y = at.y, z = at.z + 0.5 }
        if f != null { p.z = f.z }
        let from = o.position
        world::set_position{ o, p }
        if o.kind == obj::Kind::creature { cross_volumes{ &w, id, from, to = p } }
    }

    // Where creature `id` can stand at or near `at` (CSWSArea::FindNearestSafePosition 0x004be860, movement.md 4.8): the
    // point itself (z from the floor) when it is safe; else square rings round it of half-size 1, 1 + PERSPACE, ... while
    // below `radius` (so a radius of 1 or less tries the point alone), sampled every PERSPACE, the rows below and above
    // first, then the columns at the sides; the first safe sample wins. With `need_line` the sample must also be a straight
    // walk from the point (dropped when the point itself is off the floor or inside a placed walkmesh). Null when none is.
    // Safe (IsPositionSafe 0x004be5e0): on the floor, outside every active door's and placeable's walkmesh, and clear of
    // every other living creature by both CREPERSPACEs + 0.01 (ours: walls within PERSPACE are not tested, as no walk of
    // ours tests them).
    fn safe_spot { w: *world::World, id: u32, at: math::Vec3, radius: f32, need_line: bool } -> ?math::Vec3 {
        let o = world::object{ w, id } ifnull { return null }
        let c = obj::creature{ o } ifnull { return at }
        let step = math::max{ a = c.perspace, b = 0.1 }
        let mut start = at
        let f = walkmap::floor{ m = &w.walk, x = at.x, y = at.y, z = at.z + 0.5 }
        if f != null { start.z = f.z }
        if f != null and spot_is_safe{ w, o, c, p = start } { return start }
        let line = need_line and f != null and not walkmap::blocked{ m = &w.walk, x = start.x, y = start.y, z = start.z }
        let mut r: f32 = 1.0
        while r < radius {
            let mut x = at.x - r
            while x <= at.x + r {
                if try_spot{ w, o, c, x, y = at.y - r, from = start, line } is some{ value = p } { return p }
                if try_spot{ w, o, c, x, y = at.y + r, from = start, line } is some{ value = p } { return p }
                x = x + step
            }
            let mut y = at.y - r + step
            while y <= at.y + r - step {
                if try_spot{ w, o, c, x = at.x - r, y, from = start, line } is some{ value = p } { return p }
                if try_spot{ w, o, c, x = at.x + r, y, from = start, line } is some{ value = p } { return p }
                y = y + step
            }
            r = r + step
        }
        return null
    }

    fn try_spot { w: *world::World, o: *obj::Object, c: *obj::Creature, x: f32, y: f32, from: math::Vec3, line: bool } -> ?math::Vec3 {
        let f = walkmap::floor{ m = &w.walk, x, y, z = from.z + 0.5 } ifnull { return null }
        let p = math::Vec3{ x, y, z = f.z }
        if not spot_is_safe{ w, o, c, p } { return null }
        if line and not paths::clear{ w, a = p, b = from } { return null }
        return p
    }

    fn spot_is_safe { w: *world::World, o: *obj::Object, c: *obj::Creature, p: math::Vec3 } -> bool {
        if walkmap::blocked{ m = &w.walk, x = p.x, y = p.y, z = p.z } { return false }
        let all = list::items{ list = w.objects.all }
        let mut i: usize = 0
        while i < all.len {
            let other = all[i]
            i = i + 1
            if other.id == o.id or other.destroyed or other.kind != obj::Kind::creature or other.area != o.area { continue }
            let oc = obj::creature{ o = other } ifnull { continue }
            if oc.dead { continue }
            let dz = other.position.z - p.z
            if distance_2d{ a = other.position, b = p } < c.creperspace + oc.creperspace + 0.01 and dz < 2.0 and dz > -2.0 { return false }
        }
        return true
    }

    // Stops a creature's walk: path cleared, speed 0.
    fn stop { mut w: world::World, id: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        list::clear{ list = &c.path }
        c.path_next = 0
        c.moving = false
        c.speed = 0.0
        c.follow_speed = 0.0
    }

    // MOVETOPOINT (actions.md 3.1): params 0 the point, 1 run (int), 2 range, 3 the target object
    // (the point follows it), 4 timeout seconds (0 none), 5 force (int: a script's ActionForceMoveTo*, whose timeout
    // jumps to the goal; any other move gives up when its timeout runs out), 6 a follower's move (int: FOLLOWLEADER's). The path comes from lib/engine/paths.ctx
    // and is planned again when the goal moves 2 m or more (movement.md 3.2 step 12).
    fn move_to_point { mut w: world::World, id: u32, a: *mut actions::Action } -> actions::Status {
        let o = world::object{ w = &w, id } ifnull { return actions::Status::failed }
        let c = obj::creature{ o } ifnull { return actions::Status::failed }
        let mut goal = actions::vector_param{ a, i = 0 }
        let target = actions::object_param{ a, i = 3 }
        // A party member following the leader (FOLLOWLEADER, movement.md 6.2) goes to its formation point, which
        // moves with the leader's trail, and sets its own pace each frame: no acceleration ramp, no braking, and the
        // gait follows the pace. It is not done while the leader moves.
        let follower = actions::int_param{ a, i = 6 } != 0 and target != obj::INVALID
        let mut lead_speed: f32 = 0.0
        if target != obj::INVALID {
            let t = world::object{ w = &w, id = target } ifnull { return actions::Status::failed }
            goal = t.position
            if follower {
                if obj::creature{ o = t } is some{ value = lc } { lead_speed = lc.speed }
                if trail::formation_point{ w = &w, id } is some{ value = f } { goal = f }
            }
        }
        let run = actions::int_param{ a, i = 1 } != 0 and not stealth::walk_only{ c }
        let range = math::max{ a = actions::float_param{ a, i = 2 }, b = 0.1 }
        let timeout = actions::float_param{ a, i = 4 }
        let now = clock::now_ms{ c = w.clock }
        if timeout > 0.0 and @as(f32, clock::elapsed_since{ now, then = a.started }) > timeout * 1000.0 {
            // Force moves jump when they time out (movement.md 3.2, step 4). A combat approach that carries a timeout
            // of its own only gives up: it jumped to its target through whatever stood between (a locked door, a
            // wall of the walkmesh), 6 s after it began.
            stop{ &w, id }
            if actions::int_param{ a, i = 5 } == 0 {
                world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
                return actions::Status::failed
            }
            // The jump (0x004edba0): JUMPTOOBJECT to the target (the nearest safe spot within 20 m), else JUMPTOPOINT with a
            // 1 m search, which takes the point only if nobody stands there: else the creature stays and the move is over.
            let spot = if target != obj::INVALID { safe_spot{ w = &w, id, at = goal, radius = 20.0, need_line = true } }
                else { safe_spot{ w = &w, id, at = goal, radius = 1.0, need_line = true } }
            if spot is some{ value = p } { place{ &w, id, at = p } }
            let back = world::object{ w = &w, id } ifnull { return actions::Status::done }
            world::set_animation{ o = back, id = obj::ANIM_STAND, speed = 1.0 }
            return actions::Status::done
        }
        // A creature that may not move (an entangled, stunned, paralysed or sleeping one; one of creaturespeed's
        // Immobile row) fails the move (AIActionMoveToPoint 0x0051f4f0 step 5: AI state mask bit 2).
        if not can_move{ c } {
            stop{ &w, id }
            world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
            return actions::Status::failed
        }
        if distance_2d{ a = o.position, b = goal } <= range and not (follower and lead_speed > 0.1) {
            stop{ &w, id }
            world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
            return actions::Status::done
        }
        let dt_ms = w.clock.dt * 1000.0
        if dt_ms <= 0.0 { return actions::Status::running }
        // A path to the nearest reachable point of a goal that cannot be stood on ends there: arrived.
        if c.path_adjusted and c.path.len > 0 and c.path_next >= c.path.len and distance_2d{ a = c.path_goal, b = goal } < 2.0 {
            stop{ &w, id }
            world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
            return actions::Status::done
        }
        if c.path.len == 0 or c.path_next >= c.path.len or distance_2d{ a = c.path_goal, b = goal } >= 2.0 {
            c.path_next = 0
            c.path_goal = goal
            let planned = if follower { trail::route{ &w, id, from = o.position, goal, out = &c.path, adjusted = &c.path_adjusted } }
                else { paths::plan{ &w, from = o.position, goal, out = &c.path, adjusted = &c.path_adjusted } }
            if not planned {
                if w.log.actions {
                    world::prefix{ w = &w }
                    _ = @fmt(&w.io, "move {}: no route from {} {} to {} {} (try {})\n", id, o.position.x, o.position.y, goal.x, goal.y, a.phase + 1)
                }
                a.phase = a.phase + 1
                if a.phase >= GIVE_UP {
                    stop{ &w, id }
                    world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
                    return actions::Status::failed
                }
                return actions::Status::running
            }
        } else if follower and not c.path_adjusted {
            // The formation point drifts with the leader: the path's end goes with it until it has moved 2 m.
            list::items{ list = c.path }[c.path.len - 1] = goal
        }
        c.moving = true
        let scale = fight::speed_scale{ o }
        let rate = (if run { c.run_rate } else { c.walk_rate }) * scale
        let mut pace = Pace{ speed = 0.0, base = 0.0 }
        let mut s: f32 = 0.0
        if follower {
            let to_go = math::max{ a = remaining{ from = o.position, path = list::items{ list = c.path }, next = c.path_next } - range, b = 0.0 }
            pace = follow_pace{ c, lead_speed, to_go, scale }
            if stealth::walk_only{ c } {
                pace.speed = math::min{ a = pace.speed, b = c.walk_rate * scale }
                pace.base = math::min{ a = pace.base, b = c.walk_rate * scale }
            }
            s = pace.speed * dt_ms / 1000.0
        } else {
            // Acceleration and braking (movement.md 3.3): f rises to 1 over a second, and falls with
            // the square root of what is left over the last half second's worth of path.
            let left = remaining{ from = o.position, path = list::items{ list = c.path }, next = c.path_next } - range
            let brake = 0.5 * rate
            let mut f: f32 = 1.0
            if left < brake {
                f = if left / brake < 0.01 { 0.1 } else { math::sqrtf{ x = math::max{ a = left, b = 0.0 } / brake } }
                f = f - dt_ms / 1000.0
            }
            if c.speed_factor < 1.0 { f = math::min{ a = f, b = c.speed_factor + dt_ms / 1000.0 } }
            f = math::max{ a = f, b = 0.1 }
            s = dt_ms * (f + c.speed_factor) * rate * 0.5 / 1000.0
            c.speed_factor = f
            c.speed = s / (dt_ms / 1000.0)
            world::set_gait{ o, id = gait_of{ c, run }, cycles = gait_cycles{ w = &w, c, run, speed = c.speed, drive = false } }
        }
        // Along the path's points (StepAlongPath, movement.md 3.4).
        let from = o.position
        let mut here = o.position
        while s > 0.0001 and c.path_next < c.path.len {
            let p = list::items{ list = c.path }[c.path_next]
            let d = distance_2d{ a = here, b = p }
            let last = c.path_next + 1 == c.path.len
            // The range counts from the goal only: a path that ends short of it (the planner's
            // farthest clear point) is walked to its end, so the next plan fails instead of
            // stopping `range` short of the same point again and again.
            let ends_at_goal = distance_2d{ a = p, b = goal } < 0.05
            let stop_at = if last and ends_at_goal { math::max{ a = d - range + 0.05, b = 0.0 } } else { d }
            let mut step = math::min{ a = s, b = stop_at }
            if d < 0.0001 {
                c.path_next = c.path_next + 1
                continue
            }
            let mut to = math::Vec3{ x = here.x + (p.x - here.x) / d * step, y = here.y + (p.y - here.y) / d * step, z = here.z }
            let mut floor_z = walkmap::step_to{ m = &w.walk, from = here, to }
            // A seam between two rooms' walkmeshes can be a few centimetres wide: the planner's samples
            // (every SAMPLE) step over it, but a step that lands, or samples, inside it fails. A creature
            // standing at a seam's edge then never moves again, and plans afresh every frame for ever. So a
            // step that fails is tried again as one planner sample long (up to the path point), across the gap.
            if floor_z == null and stop_at > 0.0 {
                let leap = math::min{ a = walkmap::SAMPLE, b = stop_at }
                let far = math::Vec3{ x = here.x + (p.x - here.x) / d * leap, y = here.y + (p.y - here.y) / d * leap, z = here.z }
                floor_z = walkmap::step_across{ m = &w.walk, from = here, to = far }
                if floor_z != null {
                    to = far
                    step = leap
                }
            }
            let z = floor_z ifnull {
                // Blocked by a closed door: its OnBlocked script may open it (movement.md 4.9).
                let door_blocks = tell_door_blocked{ &w, id, at = to }
                if door_blocks and timeout <= 0.0 {
                    // The step failed (CheckStepCollision): the move is over, whatever the script
                    // queues (open the door) runs next and a follower's follow action tries again.
                    stop{ &w, id }
                    world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
                    return actions::Status::failed
                }
                // Blocked: plan again next frame, give up after six times in a row. A move with a
                // timeout (a script's ActionForceMoveToObject leading the party through doors)
                // waits for the door its OnBlocked script is opening instead: the timeout is its
                // way out, else Bastila's eight legs on Dantooine all fail at the first door.
                if w.log.actions {
                    world::prefix{ w = &w }
                    _ = @fmt(&w.io, "move {}: blocked at {} {} going to {} {} (goal {} {}, try {})\n", id, here.x, here.y, p.x, p.y, goal.x, goal.y, a.phase + 1)
                }
                c.path_next = c.path.len
                if not door_blocks { a.phase = a.phase + 1 }
                if a.phase >= GIVE_UP {
                    stop{ &w, id }
                    world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
                    return actions::Status::failed
                }
                break
            }
            a.phase = 0
            world::set_orientation{ o, v = math::Vec3{ x = p.x - here.x, y = p.y - here.y, z = 0.0 } }
            here = math::Vec3{ x = to.x, y = to.y, z }
            s = s - step
            if step >= stop_at { c.path_next = c.path_next + 1 }
            if last and step >= stop_at { break }
        }
        world::set_position{ o, p = here }
        cross_volumes{ &w, id, from, to = here }
        if follower { settle_follow_gait{ &w, o, c, moved = distance_2d{ a = from, b = here }, dt = dt_ms / 1000.0, pace, scale } }
        return actions::Status::running
    }

    // Whether the creature may move: its AI state mask's bit 2, which the crowd-control states, Entangle and
    // creaturespeed's Immobile row (SetMovementRate 0x005a5680) clear (rules.md, AI state mask).
    fn can_move { c: *obj::Creature } -> bool {
        if c.movement_rate == 1 { return false }
        let f = c.fighter ifnull { return true }
        if not f.loaded { return true }
        return rules::can_move{ c = &f.c }
    }

    // The pace of a party member following the leader (CSWSCreature::UpdateFollowLeader, movement.md 6.2). `to_go` is
    // how far the member still has to walk to where it will stand (the original's distance from its place
    // on the leader's trail to the follow point; ours: the path to the leader less the follow range).
    // Far (4 m): run after a standing leader, or at the leader's own speed if that is more than the
    // run rate. Near: the leader's speed while it moves; while it stands, whatever pace the member
    // has, at least 0.9 of the walk rate. Then by the distance: under 1 m it slows to 0.9, up to 15 m it
    // hurries at 1.2, beyond that 1.5. `base` is the pace before that factor: the smoothed speed (and so
    // the animation) never exceeds it.
    struct Pace { speed: f32, base: f32 }

    const FOLLOW_CATCH_UP: f32 = 4.0

    fn follow_pace { c: *obj::Creature, lead_speed: f32, to_go: f32, scale: f32 } -> Pace {
        let run = c.run_rate * scale
        let walk = c.walk_rate * scale
        let moving = lead_speed > 0.1
        let mut base: f32 = 0.0
        if to_go >= FOLLOW_CATCH_UP {
            base = if moving { math::max{ a = lead_speed, b = run } } else { run }
        } else if moving {
            base = lead_speed
        } else {
            base = if c.follow_speed <= walk * 0.9 { walk * 0.9 } else { c.follow_speed }
        }
        let factor: f32 = if to_go * to_go <= 1.0 { 0.9 } else if to_go * to_go <= 225.0 { 1.2 } else { 1.5 }
        return Pace{ speed = base * factor, base }
    }

    // After a follower's step: its smoothed speed (the mean of the speed it just made and the last one,
    // 0 under 1 cm/s, never above the pace's base) picks the cycle: walk below 0.6 of the run rate, run from
    // there (CSWCCreature's party follower animation, movement.md 3.6); the cycle plays at that speed
    // over the appearance's DriveAnimWalk or DriveAnimRun.
    fn settle_follow_gait { mut w: world::World, o: *mut obj::Object, c: *mut obj::Creature, moved: f32, dt: f32, pace: Pace, scale: f32 } {
        let made = moved / dt
        c.speed = made
        let mut smooth = if made > 0.0000001 { (c.follow_speed + made) * 0.5 } else { made }
        if smooth < 0.01 { smooth = 0.0 }
        smooth = math::min{ a = smooth, b = pace.base }
        c.follow_speed = smooth
        if smooth <= 0.0 {
            world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
            return
        }
        // A 5 % band round the line (ours): a follower whose pace flips between 0.9 and 1.2 of the leader's, right on
        // the line, would otherwise change cycles every other frame.
        let line = c.run_rate * scale * 0.6 * (if o.animation == obj::ANIM_RUN { 0.95 } else { 1.05 })
        let run = smooth >= line and not stealth::walk_only{ c }
        world::set_gait{ o, id = gait_of{ c, run }, cycles = gait_cycles{ w = &w, c, run, speed = smooth, drive = true } }
    }

    // A step that a closed door's walkmesh stopped: the nearest closed door within reach of the
    // step sends the mover PATH_BLOCKED (caller the door, GetBlockingDoor), at most once a second
    // (CheckStepCollision: the OnBlocked script runs on every blocked step in the original; ours
    // is throttled so it can open the door before the next try).
    fn tell_door_blocked { mut w: world::World, id: u32, at: math::Vec3 } -> bool {
        let o = world::object{ w = &w, id } ifnull { return false }
        let c = obj::creature{ o } ifnull { return false }
        let now = clock::now_ms{ c = w.clock }
        let all = list::items{ list = w.objects.all }
        let mut best = obj::INVALID
        let mut best_d: f32 = 2.2
        let mut i: usize = 0
        while i < all.len {
            let d = all[i]
            i = i + 1
            if d.destroyed or d.kind != obj::Kind::door or d.area != o.area { continue }
            let door = obj::door{ o = d } ifnull { continue }
            if door.state != obj::DoorState::closed or door.static { continue }
            let dist = distance_2d{ a = d.position, b = at }
            if dist < best_d {
                best = d.id
                best_d = dist
            }
        }
        if best == obj::INVALID { return false }
        // Told at most once a second; the move fails every time it is stopped by a closed door.
        if c.blocked_ms != 0 and clock::elapsed_since{ now, then = c.blocked_ms } < 1000 { return true }
        c.blocked_ms = if now == 0 { 1 } else { now }
        events::post{ &w, delay_ms = 0, caller = best, target = id, payload = events::Payload::script{ e = events::script_event{ kind = events::PATH_BLOCKED, object = best } } }
        return true
    }

    // How many walk or run cycles a second a creature moving at `speed` m/s makes: the appearance's WALKDIST
    // or RUNDIST is the ground one cycle covers (metres, not m/s), so the feet keep up with the ground when
    // the cycle plays at speed / dist cycles a second (CSWCCreature::UpdateMovementAnimation,
    // movement.md 3.6). The playback rate is that times the cycle's length, which the scene knows
    // (visual::cycle_rate); 0 when the appearance has no distance.
    //
    // A creature that something drives by its speed (the leader under the keys, a follower: `drive`) plays
    // the cycle over the appearance's DriveAnimWalk or DriveAnimRun, which are 2 and 4 when the row has
    // none; one that walks a planned path (MOVETOPOINT), over WALKDIST or RUNDIST. The rows say the same
    // for the humanoids; they differ for the Envirosuit (0.75 and 1.25 against 1.2 and 2.3).
    // The walk or run cycle's id: in stealth both become the stealth walk (SetAnimation 0x004f0d70, movement.md 3.6).
    fn gait_of { c: *obj::Creature, run: bool } -> u32 {
        if c.stealth { return obj::ANIM_STEALTH_WALK }
        return if run { obj::ANIM_RUN } else { obj::ANIM_WALK }
    }

    fn gait_cycles { w: *world::World, c: *obj::Creature, run: bool, speed: f32, drive: bool } -> f32 {
        let row = @as(usize, if c.disguise != 0 { c.disguise } else { c.appearance })
        let mut dist = twoda::get_float{ t = w.tables.appearance, row, column = if drive { if run { "driveanimrun" } else { "driveanimwalk" } } else { if run { "rundist" } else { "walkdist" } } } ifnull 0.0
        if drive and dist == 0.0 { dist = if run { 4.0 } else { 2.0 } }
        if dist < 0.1 { return 0.0 }
        return speed / dist
    }

    fn distance_2d { a: math::Vec3, b: math::Vec3 } -> f32 {
        let dx = a.x - b.x
        let dy = a.y - b.y
        return math::sqrtf{ x = dx * dx + dy * dy }
    }

    // What is left of a path from `from`: to its next point, then point to point.
    fn remaining { from: math::Vec3, path: []math::Vec3, next: usize } -> f32 {
        let mut total: f32 = 0.0
        let mut here = from
        let mut i = next
        while i < path.len {
            total = total + distance_2d{ a = here, b = path[i] }
            here = path[i]
            i = i + 1
        }
        return total
    }

    // Whether (x, y) is inside a polygon seen from above (even-odd rule).
    fn inside_polygon { poly: []math::Vec3, x: f32, y: f32 } -> bool {
        if poly.len < 3 { return false }
        let mut inside = false
        let mut j = poly.len - 1
        let mut i: usize = 0
        while i < poly.len {
            let a = poly[i]
            let b = poly[j]
            if (a.y > y) != (b.y > y) {
                let cx = a.x + (y - a.y) * (b.x - a.x) / (b.y - a.y)
                if x < cx { inside = not inside }
            }
            j = i
            i = i + 1
        }
        return inside
    }

    // After a creature moved from `from` to `to`: OBJECT_EXIT to the triggers it left and
    // OBJECT_ENTER to those it entered (movement.md 5.1; the crossing of a whole volume between
    // two samples is milestone 2's).
    fn cross_volumes { mut w: world::World, id: u32, from: math::Vec3, to: math::Vec3 } {
        // An encounter's spawn grows the object list (and may move it): re-read it for each object.
        let count = w.objects.all.len
        let mut i: usize = 0
        while i < count and i < w.objects.all.len {
            let o = list::items{ list = w.objects.all }[i]
            i = i + 1
            if o.destroyed { continue }
            if obj::encounter{ o } is some{ value = e } {
                if id == w.pc and e.active and not e.spawned and inside_polygon{ poly = e.polygon, x = to.x, y = to.y } {
                    encounter_spawn{ &w, id = o.id }
                    events::post{ &w, delay_ms = 0, caller = id, target = o.id, payload = events::Payload::script{ e = events::script_event{ kind = events::OBJECT_ENTER, object = id } } }
                }
                continue
            }
            // The party leader walking through an open transition door raises CLICKED on it
            // (movement.md 5.1: a transition door's volume); other doors have none.
            if id == w.pc and o.kind == obj::Kind::door {
                if obj::door{ o } is some{ value = door } {
                    if door.state != obj::DoorState::closed and modload::link_of{ o } != null {
                        if distance_2d{ a = o.position, b = to } < 0.7 and distance_2d{ a = o.position, b = from } >= 0.7 {
                            events::post{ &w, delay_ms = 0, caller = id, target = o.id, payload = events::Payload::script{ e = events::script_event{ kind = events::CLICKED, object = id } } }
                        }
                    }
                }
                continue
            }
            let t = obj::trigger{ o } ifnull { continue }
            let now_in = in_trigger{ o, t, at = to }
            let was_in = contains{ l = &t.inside, id }
            if now_in and not was_in {
                list::push{ list = &t.inside, item = id } iferr {}
                events::post{ &w, delay_ms = 0, caller = id, target = o.id, payload = events::Payload::script{ e = events::script_event{ kind = events::OBJECT_ENTER, object = id } } }
            } else if was_in and not now_in {
                remove{ l = &t.inside, id }
                events::post{ &w, delay_ms = 0, caller = id, target = o.id, payload = events::Payload::script{ e = events::script_event{ kind = events::OBJECT_EXIT, object = id } } }
            }
        }
    }

    // Whether `at` is inside a trigger. A trap is stepped on within a metre of its centre, not
    // over its outline (movement.md 5.1).
    fn in_trigger { o: *obj::Object, t: *mut obj::Trigger, at: math::Vec3 } -> bool {
        if t.trigger_type == traps::TRIGGER_TYPE { return traps::is_within{ o, at } }
        return inside_polygon{ poly = t.polygon, x = at.x, y = at.y }
    }

    // A creature put where a loaded save had it: it is already inside the triggers around it, so
    // their lists take it without an OBJECT_ENTER (movement.md 5.1, the save-loading case of
    // UpdateVolumesAtPosition: it sends no events while the game is loading; the creature's
    // volume list is not saved, but this recomputes it).
    fn settle_volumes { mut w: world::World, id: u32 } {
        let me = world::object{ w = &w, id } ifnull { return }
        let at = me.position
        let count = w.objects.all.len
        let mut i: usize = 0
        while i < count and i < w.objects.all.len {
            let o = list::items{ list = w.objects.all }[i]
            i = i + 1
            if o.destroyed { continue }
            let t = obj::trigger{ o } ifnull { continue }
            let now_in = in_trigger{ o, t, at }
            let was_in = contains{ l = &t.inside, id }
            if now_in and not was_in {
                list::push{ list = &t.inside, item = id } iferr {}
            } else if was_in and not now_in {
                remove{ l = &t.inside, id }
            }
        }
    }

    // `place` for a creature a loaded save put back: the same floor snap, no trigger events.
    fn place_loaded { mut w: world::World, id: u32, at: math::Vec3 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let mut p = at
        let f = walkmap::floor{ m = &w.walk, x = at.x, y = at.y, z = at.z + 0.5 }
        if f != null { p.z = f.z }
        world::set_position{ o, p }
        settle_volumes{ &w, id }
    }

    // An encounter's creatures (ours, simplified: RecCreatures of them, at most MaxCreatures, the
    // list in turn at the spawn points in turn, once).
    fn encounter_spawn { mut w: world::World, id: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let e = obj::encounter{ o } ifnull { return }
        e.spawned = true
        if e.creatures.len == 0 { return }
        let n = @as(usize, math::max{ a = 1.0, b = math::min{ a = @as(f32, e.rec_creatures), b = @as(f32, e.max_creatures) } })
        let mut i: usize = 0
        while i < n {
            let oo = world::object{ w = &w, id } ifnull { return }
            let e2 = obj::encounter{ o = oo } ifnull { return }
            let mut at = oo.position
            let mut facing: f32 = 0.0
            if e2.spawn_points.len > 0 {
                let p = e2.spawn_points[i % e2.spawn_points.len]
                at = math::Vec3{ x = p.x, y = p.y, z = p.z }
                facing = p.w
            }
            let mut name = e2.creatures[i % e2.creatures.len]
            let template = resref::bytes{ r = &name }
            let made = tmpl::spawn{ &w, kind = obj::Kind::creature, template, position = at, orientation = obj::direction_of_bearing{ bearing = facing } } iferr { obj::INVALID }
            if made != obj::INVALID {
                place{ &w, id = made, at }
                let c = world::object{ w = &w, id = made }
                if c != null { c.ai_level = 1 }
            }
            i = i + 1
        }
    }

    fn contains { l: *list::List(u32, heap::Heap), id: u32 } -> bool {
        let items = list::items{ list = l.* }
        let mut i: usize = 0
        while i < items.len {
            if items[i] == id { return true }
            i = i + 1
        }
        return false
    }

    fn remove { l: *mut list::List(u32, heap::Heap), id: u32 } {
        let items = list::items{ list = l.* }
        let mut j: usize = 0
        let mut i: usize = 0
        while i < items.len {
            if items[i] != id {
                items[j] = items[i]
                j = j + 1
            }
            i = i + 1
        }
        l.len = j
    }
}
