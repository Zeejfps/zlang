// Perception (docs/re/gameloop.md 2.4): which creatures each creature sees and hears, and the
// ON_PERCEPTION events (script event 1) when that changes. Two passes, as the original: the
// party is checked on every update (timer A, whose last run the original never stores), and
// everyone in range every 4 s out of combat, 0.2 s in combat (timer B).
//
// A creature is seen within its sight range with a clear line between the two at eye height,
// heard within its hearing range. Ranges: the PC ranges.2da row 12 (PercepRngPlayer); others the
// UTC's PerceptionRange row, 11 meaning appearance.2da PERCEPTIONDIST (itself a ranges row).
// A creature in stealth mode is seen and heard only when the viewer wins stealth.ctx's contests
// (party members never hide from each other).
namespace perception {
    const FULL_PASS_MS: u64 = 4000
    const COMBAT_PASS_MS: u64 = 200
    const EYE: f32 = 1.5

    // Event payload bits in ScriptEvent.ints[0] (ours): what changed.
    const SEEN: i32 = 1
    const HEARD: i32 = 2
    const VANISHED: i32 = 4
    const INAUDIBLE: i32 = 8

    fn ranges_of { mut w: world::World, c: *mut obj::Creature } {
        let mut row: usize = 12
        if not c.is_pc {
            row = @as(usize, c.perception_range)
            if row == 11 {
                let dist = twoda::get_int{ t = w.tables.appearance, row = @as(usize, c.appearance), column = "perceptiondist" }
                row = if dist != null and dist >= 0 { @as(usize, dist) } else { 11 }
            }
        }
        c.sight_range = twoda::get_float{ t = w.tables.ranges, row, column = "primaryrange" } ifnull 20.0
        c.hearing_range = twoda::get_float{ t = w.tables.ranges, row, column = "secondaryrange" } ifnull 20.0
    }

    // One creature's perception step, from its AI update.
    fn update { mut w: world::World, id: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        if c.dead { return }
        if c.sight_range <= 0.0 { ranges_of{ &w, c } }
        stealth::reroll{ &w, id }
        let now = clock::now_ms{ c = w.clock }
        let period = if c.in_combat { COMBAT_PASS_MS } else { FULL_PASS_MS }
        let full = c.last_perception == 0 or clock::elapsed_since{ now, then = c.last_perception } >= period
        if full { c.last_perception = if now == 0 { 1 } else { now } }
        let all = list::items{ list = w.objects.all }
        let mut i: usize = 0
        while i < all.len {
            let t = all[i]
            i = i + 1
            if t.id == id or t.destroyed or t.kind != obj::Kind::creature or t.area != o.area { continue }
            if not full and not party::is_member{ w = &w, id = t.id } { continue }
            check{ &w, viewer = id, target = t.id }
        }
        // The party pass also forgets creatures that are gone.
        if full { forget_gone{ &w, id } }
    }

    // Whether `viewer` sees and hears `target` now, and the events for what changed.
    fn check { mut w: world::World, viewer: u32, target: u32 } {
        let v = world::object{ w = &w, id = viewer } ifnull { return }
        let vc = obj::creature{ o = v } ifnull { return }
        let t = world::object{ w = &w, id = target } ifnull { return }
        let tc = obj::creature{ o = t } ifnull { return }
        let d = math::vec3::distance{ a = v.position, b = t.position }
        // Party members always see and hear each other, whatever the range, line or stealth
        // (0x00502ac0, the client party's test after the contests).
        let both_party = party::is_member{ w = &w, id = viewer } and party::is_member{ w = &w, id = target }
        let mut heard = both_party or (d <= vc.hearing_range and not tc.dead)
        let mut seen = both_party or (d <= vc.sight_range and clear_line{ w = &w, a = v.position, b = t.position })
        let hidden = tc.stealth and not both_party
        if hidden {
            if seen { seen = stealth::spots{ &w, viewer, target } }
            if heard { heard = stealth::hears{ &w, viewer, target } }
        }
        let entries = list::items{ list = vc.perceived }
        let mut k: usize = 0
        while k < entries.len and entries[k].id != target { k = k + 1 }
        let had = k < entries.len
        let was_seen = had and entries[k].seen
        let was_heard = had and entries[k].heard
        if seen == was_seen and heard == was_heard { return }
        let mut change: i32 = 0
        if seen and not was_seen { change = change | SEEN }
        if heard and not was_heard { change = change | HEARD }
        if was_seen and not seen { change = change | VANISHED }
        if was_heard and not heard { change = change | INAUDIBLE }
        if had {
            entries[k].seen = seen
            entries[k].heard = heard
            if not seen and not heard { remove_at{ l = &vc.perceived, at = k } }
        } else {
            list::push{ list = &vc.perceived, item = obj::Perceived{ id = target, seen, heard } } iferr {}
        }
        if seen and not was_seen {
            stealth::noticed{ &w, viewer, target }
            if hidden { fight_log::spotted{ &w, viewer, target } }
        }
        if hidden and w.log.actions and ((seen and not was_seen) or (heard and not was_heard)) {
            world::prefix{ w = &w }
            let how: []u8 = if seen and not was_seen { "sees" } else { "hears" }
            _ = @fmt(&w.io, "stealth: {} ({}) {} {} ({}) hiding\n", v.tag, viewer, how, t.tag, target)
        }
        let mut e = events::script_event{ kind = events::PERCEPTION, object = target }
        e.ints[0] = change
        events::post{ &w, delay_ms = 0, caller = target, target = viewer, payload = events::Payload::script{ e } }
    }

    // A clear line between two creatures' eyes (CSWSArea::ClearLineOfSight 0x0050c330): through the
    // rooms' walkmeshes, whose faces stop it when their surface material has LineOfSight = 1
    // (surfacemat.2da; Transparent, Door and Trigger let it through), and through the placed
    // walkmeshes of the area's doors and placeables, where any face nobody can walk on stops it.
    // A closed door is such a mesh (its closed DWK), an open one no longer is; the original tests
    // the walkmesh of the door's current state, so an opened or bashed door lets sight through.
    // This is the server's line: perception, the AI's target choice and ranged attacks.
    fn clear_line { w: *world::World, a: math::Vec3, b: math::Vec3 } -> bool {
        return is_line_clear{ w, a, b, solids = true, ignore = obj::INVALID }
    }

    // The client's line from the leader to something it might target (CSWCCreature::GetIsTargetVisible
    // 0x00617ad0): the rooms' walkmeshes and the closed doors stop it, a placeable does not, and
    // the target's own mesh (a door seen from afar) is not in the way.
    fn is_sight_clear { w: *world::World, a: math::Vec3, b: math::Vec3, ignore: u32 } -> bool {
        return is_line_clear{ w, a, b, solids = false, ignore }
    }

    // What stops a line: `what` 0 for nothing, 1 for a face of a room's walkmesh (`index` the room, `material` the
    // face's surface), 2 for a door's or placeable's walkmesh (`index` its place in walk.placed); `t` how far along.
    struct Block { what: u32, index: usize, face: u32, material: u32, t: f32 }

    // `solids` lets the placeables' meshes stop the line too; `ignore` is an object whose mesh does not.
    fn is_line_clear { w: *world::World, a: math::Vec3, b: math::Vec3, solids: bool, ignore: u32 } -> bool {
        return find_block{ w, a, b, solids, ignore }.what == 0
    }

    // The first thing between two creatures' eyes (EYE above each foot), rooms before placed meshes.
    fn find_block { w: *world::World, a: math::Vec3, b: math::Vec3, solids: bool, ignore: u32 } -> Block {
        let mut none = Block{ what = 0, index = 0, face = 0, material = 0, t = 0.0 }
        let from = math::Vec3{ x = a.x, y = a.y, z = a.z + EYE }
        let to = math::Vec3{ x = b.x, y = b.y, z = b.z + EYE }
        let d = math::vec3::sub{ a = to, b = from }
        let len = math::vec3::length{ v = d }
        if len < 0.01 { return none }
        let ray = math::ray::make{ origin = from, dir = math::vec3::scale{ v = d, s = 1.0 / len } }
        let mut blocks: [64]bool
        let mut m: usize = 0
        while m < 64 {
            blocks[m] = m < w.walk.sees.len and w.walk.sees[m]
            m = m + 1
        }
        let rooms = list::items{ list = w.walk.rooms }
        let mut i: usize = 0
        while i < rooms.len {
            let mesh = rooms[i].mesh
            i = i + 1
            if mesh == null { continue }
            if bwm::cast_ray{ w = mesh, ray, max_t = len, stops = blocks[..] } is some{ value = hit } {
                return Block{ what = 1, index = i - 1, face = hit.face, material = mesh.materials[@as(usize, hit.face)], t = hit.t }
            }
        }
        let placed = placed_block{ w, from, to, ray, len, solids, ignore }
        if placed >= 0 { none.what = 2; none.index = @as(usize, placed) }
        return none
    }

    // The first active placed walkmesh (a closed door, a placeable that is still there) with a face
    // that stops the segment, the faces a creature cannot stand on; its place in walk.placed, or -1.
    fn placed_block { w: *world::World, from: math::Vec3, to: math::Vec3, ray: math::Ray, len: f32, solids: bool, ignore: u32 } -> i32 {
        let placed = list::items{ list = w.walk.placed }
        let boxes = list::items{ list = w.walk.boxes }
        if placed.len == 0 { return -1 }
        let lo = math::vec3::min{ a = from, b = to }
        let hi = math::vec3::max{ a = from, b = to }
        let mut stops: [64]bool
        let mut m: usize = 0
        while m < 64 {
            stops[m] = m >= w.walk.walkable.len or not w.walk.walkable[m]
            m = m + 1
        }
        let mut i: usize = 0
        while i < placed.len {
            let p = &placed[i]
            let box = boxes[i]
            i = i + 1
            if not p.active or p.owner == ignore { continue }
            // The mesh's bounds against the segment's (most doors and crates are far from it).
            if box.hi.x < lo.x or box.lo.x > hi.x or box.hi.y < lo.y or box.lo.y > hi.y or box.hi.z < lo.z or box.lo.z > hi.z { continue }
            let owner = world::object{ w, id = p.owner } ifnull { continue }
            if not solids and owner.kind != obj::Kind::door { continue }
            if bwm::cast_ray{ w = p.mesh, ray, max_t = len, stops = stops[..] } != null { return @as(i32, i - 1) }
        }
        return -1
    }

    // Whether `viewer` could see `target` this instant: within its sight range with a clear line, and
    // not in stealth mode unless the perception list says it was spotted (FUN_004f1fd0, the check the
    // original's GetIsSelectableTarget falls back on when the list has not caught up).
    fn sees_now { w: *world::World, viewer: u32, target: u32 } -> bool {
        let v = world::object{ w, id = viewer } ifnull { return false }
        let vc = obj::creature{ o = v } ifnull { return false }
        let t = world::object{ w, id = target } ifnull { return false }
        let tc = obj::creature{ o = t } ifnull { return false }
        if v.area != t.area or math::vec3::distance{ a = v.position, b = t.position } > vc.sight_range { return false }
        if not clear_line{ w, a = v.position, b = t.position } { return false }
        let hidden = tc.stealth and not (party::is_member{ w, id = viewer } and party::is_member{ w, id = target })
        if not hidden { return true }
        return entry_of{ w, viewer, target } is some{ value = e } and e.seen
    }

    // Drops perceived creatures that were destroyed (the original's vanish on its full pass).
    fn forget_gone { mut w: world::World, id: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let mut k: usize = 0
        while k < c.perceived.len {
            let entry = list::items{ list = c.perceived }[k]
            if world::is_valid{ w = &w, id = entry.id } {
                k = k + 1
                continue
            }
            remove_at{ l = &c.perceived, at = k }
        }
    }

    fn remove_at { l: *mut list::List(obj::Perceived, heap::Heap), at: usize } {
        let items = list::items{ list = l.* }
        let mut i = at + 1
        while i < items.len {
            items[i - 1] = items[i]
            i = i + 1
        }
        l.len = l.len - 1
    }

    // What `viewer` knows of `target` (GetObjectSeen, GetObjectHeard).
    fn entry_of { w: *world::World, viewer: u32, target: u32 } -> ?obj::Perceived {
        let v = world::object{ w, id = viewer } ifnull { return null }
        let c = obj::creature{ o = v } ifnull { return null }
        let entries = list::items{ list = c.perceived }
        let mut k: usize = 0
        while k < entries.len {
            if entries[k].id == target { return entries[k] }
            k = k + 1
        }
        return null
    }
}
