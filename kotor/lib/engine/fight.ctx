// Fighting (docs/re/combat.md): each creature's rules state (lib/rules), its combat round and
// combat state, the attack action, what the rules' events do to the world (hit points, death,
// crowd control), and the kill's experience. The rules answer the numbers; this file runs the
// round's timing, the animations, the scripts and the consequences.
//
//   fight::update{ &w, id }                         // every frame for a creature (ai::update_creature)
//   ATTACKOBJECT (actions::Kind::attack_object) -> fight::attack_object
//   fight::apply{ &w, target, e = effect }          // an effect (scripts, attacks), events drained
namespace fight {
    const ROUND_MS: i32 = 3000                  // a combat round (3.1)
    const DIE_MS: i32 = 3000                    // the die animation (2.97 s in the humanoid skeleton, 2.63 s a creature's) plays out before `dead`
    const CUTSCENE_READY_MS: i32 = 6000         // a designer's attack leaves the weapon up this long (ours)
    const COMBAT_MS: i32 = 8000                 // in combat this long after the last hostile act (3.6)
    const MAX_IMPACTS: usize = 12               // ranged animations fire up to 12 shots
    const NO_ROW: i32 = -1

    // Animation ids of animations.2da rows (animname::ROW_BASE + row; bit 16 alternates so the
    // same row plays again).
    const ROW_DIE: i32 = 80
    const ROW_DEAD: i32 = 81
    const ROW_DIE1: i32 = 82
    const ROW_DEAD1: i32 = 83
    const ROW_GETUP: i32 = 381
    const ROW_GETUP1: i32 = 382
    const ROW_CDIE: i32 = 274
    const ROW_CDEAD: i32 = 275
    const ROW_CREADY: i32 = 278

    // One impact of a round: when it lands, on whom, what the rules decided (3.3).
    struct Impact {
        at_ms: i32,                     // when it lands (a ranged shot: after its bolt's flight)
        fire_ms: i32,                   // ranged: when the bolt leaves the weapon
        hand: i32,                      // ranged: 0 right hand, 1 left (weapondischarge.2da switchmask)
        target: u32,
        attack: bool,                   // carries an attack (a ranged shot may be only visual)
        hit: bool,
        result: i32,                    // rules::outcome
        killing: bool,
        ranged: bool,
        reaction: i32,                  // the target's animations.2da reaction row, NO_ROW none
        cutscene: bool,
        damage: rules::DamageRoll,      // a hit's damage (the DAMAGE effects are made at impact)
        nfx: i32,
        fx: [rules::MAX_COMBAT_FX]rules::CombatEffect,
    }

    struct Round {
        started: bool,
        timer_ms: i32,
        length_ms: i32,
        target: u32,
        anim_row: i32,                  // the attack animation (animations.2da row)
        anim_ms: i32,                   // until then the attack animation plays
        count: usize,
        fired: usize,                   // impacts landed
        shots: usize,                   // bolts fired
        cutscene: bool,                 // a designer's round (CutsceneAttack): no OnEndRound, no combat
        feat: i32,                      // the combat feat of the round's attacks (0 none)
        impacts: [MAX_IMPACTS]Impact,
    }

    // CutsceneAttack's orders (combat.md 3.1 bCutscene, 4.1 step 5): the animation row, the result
    // and the damage the designer fixed.
    struct Forced { on: bool, animation: i32, result: i32, damage: i32 }

    fn not_forced {} -> Forced { return Forced{ on = false, animation = NO_ROW, result = 0, damage = -1 } }

    // A creature thrown back by a Force push or knocked down (fight_state.ctx): the slide and how
    // long the fall, the lying and the get-up last.
    struct Knock { active: bool, t_ms: i32, move_ms: i32, total_ms: i32, from: math::Vec3, to: math::Vec3 }

    // A creature's fighting state: the rules creature, its round, how long it stays in combat.
    struct Fighter {
        c: rules::Creature,
        round: Round,
        loaded: bool,                   // the rules creature came from a GFF
        combat_ms: i32,                 // time left in combat; 0 out of combat
        react_ms: i32,                  // a reaction animation plays this much longer
        variant: u32,                   // alternates animation ids so a row can replay
        killer: u32,                    // GetLastKiller
        last_damage: i32,               // GetTotalDamageDealt
        damage_types: [15]i32,          // GetDamageDealtByType: the last hit's damage by type slot
        file_hp: i32,                   // the GFF's CurrentHitPoints, adopted by equip_loaded
        has_file_hp: bool,
        dying_ms: i32,                  // > 0: the die animation plays, then dead
        voice_ms: i32,                  // > 0: it has just grunted
        ready_ms: i32,                  // > 0: a cutscene attack was just made, so the weapon stays up
        knock: Knock,
    }

    fn no_impact {} -> Impact {
        let mut fx: [rules::MAX_COMBAT_FX]rules::CombatEffect
        let mut damage: rules::DamageRoll
        return Impact{ at_ms = 0, fire_ms = 0, hand = 0, target = obj::INVALID, attack = false, hit = false, result = 0, killing = false, ranged = false, reaction = NO_ROW, cutscene = false, damage, nfx = 0, fx }
    }

    fn no_round {} -> Round {
        return Round{ started = false, timer_ms = 0, length_ms = 0, target = obj::INVALID, anim_row = NO_ROW, anim_ms = 0, count = 0, fired = 0, shots = 0, cutscene = false, feat = 0, impacts = [no_impact{}; MAX_IMPACTS] }
    }

    fn new_fighter { heap: *mut heap::Heap } -> !*mut Fighter {
        let mut c: rules::Creature
        c.loaded_hp = -1
        let f = Fighter{ c, round = no_round{}, loaded = false, combat_ms = 0, react_ms = 0, variant = 0, killer = obj::INVALID, last_damage = 0, damage_types = [0; 15], file_hp = 0, has_file_hp = false, dying_ms = 0, voice_ms = 0, ready_ms = 0, knock = no_knock{} }
        return try alloc::new(Fighter, heap::Heap){ realloc = heap::alloc, heap, value = f }
    }

    fn free_fighter { heap: *mut heap::Heap, f: *mut Fighter } {
        _ = alloc::resize(Fighter, heap::Heap){ realloc = heap::alloc, heap, mem = @slice(f, 1), count = 0 }
    }

    fn of { o: *obj::Object } -> ?*mut Fighter {
        let c = obj::creature{ o } ifnull { return null }
        return c.fighter
    }

    // ---- time and the rules' environment

    // World time as the effects keep it: the calendar day and the ms of that day.
    fn time_now { w: *world::World } -> rules::Time {
        let per_day = clock::ms_per_day{ c = w.clock }
        let at = clock::calendar_ms{ c = w.clock } + clock::now_ms{ c = w.clock }
        return rules::Time{ day = @trunc(u32, at / per_day), ms = @trunc(u32, at % per_day) }
    }

    fn env_of { w: *world::World, o: *obj::Object } -> rules::Env {
        return rules::Env{ tables = w.rules, now = time_now{ w }, hp = o.hp }
    }

    // The engine's facts the rules read from the creature (rules.md, "Data the library owns").
    fn sync_flags { w: *world::World, o: *obj::Object, f: *mut Fighter } {
        let c = obj::creature{ o } ifnull { return }
        f.c.is_pc = c.is_pc
        f.c.pc_rules = o.id == w.player
        f.c.plot = o.plot
        f.c.min1hp = o.min_one_hp
        f.c.party = party::is_member{ w, id = o.id }
        f.c.down = f.c.party and o.hp < 1
    }

    // ---- reading

    // A creature's rules state from its GFF struct (a UTC root, a saved creature, a player
    // entry): only a struct that has the stats (a GIT instance does not).
    fn read_creature { mut w: world::World, o: *mut obj::Object, c: *mut obj::Creature, doc: *gff::Doc, s: u32 } {
        if gff::get_list{ doc = doc.*, s, label = "ClassList" } == null { return }
        let f = c.fighter ifnull { return }
        rules::read_creature{ tables = w.rules, doc, s, out = &f.c }
        let cur = gff::get_number{ doc = doc.*, s, label = "CurrentHitPoints" }
        f.has_file_hp = cur != null
        f.file_hp = @trunc(i32, cur ifnull 0)
        // A saved creature's effects (rules::read_creature leaves them to the engine).
        save::read_effect_list{ doc, s, c = &f.c }
        f.loaded = true
    }

    // Rules numbers for a creature no GFF describes (the default player): its engine fields,
    // one level of its first class, then the derived stats.
    fn default_stats { mut w: world::World, o: *mut obj::Object, c: *mut obj::Creature } {
        let f = c.fighter ifnull { return }
        f.c.race = @as(i32, c.race)
        f.c.gender = @as(i32, c.gender)
        f.c.appearance = @as(i32, c.appearance)
        f.c.faction = @as(i32, o.faction)
        let mut k: usize = 0
        while k < 6 {
            f.c.abil[k] = @as(i32, c.abilities[k])
            k = k + 1
        }
        f.c.hp_base = o.hp_max
        f.c.good_evil = @as(i32, c.good_evil)
        f.c.nclasses = 1
        f.c.classes[0] = rules::ClassSlot{ class = @as(i32, c.classes[0]), level = @as(i32, if c.class_levels[0] > 0 { c.class_levels[0] } else { 1 }) }
        k = 1
        while k < rules::MAX_CLASSES {
            f.c.classes[k] = rules::ClassSlot{ class = -1, level = 0 }
            k = k + 1
        }
        // The player's hit points come from its level history (rules.md: pc_rules): one level.
        let mut rec: rules::LevelRecord
        rec.class = f.c.classes[0].class
        rec.hp = o.hp_max
        rec.ability = -1
        f.c.nhistory = 1
        f.c.history[0] = rec
        f.c.loaded_hp = o.hp
        f.loaded = true
        sync_flags{ w = &w, o, f }
        // Its class's first-level feats (weapon proficiencies: without them it can equip nothing).
        _ = rules::grant_class_feats{ tables = w.rules, c = &f.c, class = f.c.classes[0].class, class_level = 1 }
        rules::recompute{ tables = w.rules, c = &f.c }
        if f.c.stats.max_hp > 0 {
            o.hp_max = f.c.stats.max_hp
            o.hp = o.hp_max
        }
    }

    fn read_item { mut w: world::World, i: *mut obj::Item, doc: *gff::Doc, s: u32 } -> ! {
        if i.rules == null {
            let mut blank: rules::Item
            i.rules = try alloc::new(rules::Item, heap::Heap){ realloc = heap::alloc, heap = w.heap, value = blank }
        }
        let ri = i.rules ifnull { return }
        rules::read_item{ tables = w.rules, doc, s, out = ri }
    }

    // After a creature's items are read: what it wears goes into the rules (equip while loading),
    // then the maximum hit points come from the rules.
    fn equip_loaded { mut w: world::World, o: *mut obj::Object, c: *mut obj::Creature } {
        let f = c.fighter ifnull { return }
        if not f.loaded { return }
        sync_flags{ w = &w, o, f }
        let mut k: usize = 0
        while k < obj::EQUIP_SLOTS {
            let id = c.equipped[k]
            let slot = k
            k = k + 1
            if id == obj::INVALID { continue }
            let mask = @as(u32, 1) << @trunc(u32, slot)
            let held = rules::equipped_item{ c = &f.c, mask }
            if held != null { continue }
            let io = world::object{ w = &w, id } ifnull { continue }
            let it = obj::item{ o = io } ifnull { continue }
            let ri = it.rules ifnull { continue }
            rules::clear_events{ ev = &w.rev }
            _ = rules::equip{ env = env_of{ w = &w, o }, c = &f.c, slot = mask, id, item = ri, loading = true, rng = &w.dice, ev = &w.rev }
        }
        rules::clear_events{ ev = &w.rev }
        rules::recompute{ tables = w.rules, c = &f.c }
        if f.c.stats.max_hp > 0 {
            o.hp_max = f.c.stats.max_hp
            // The files keep CurrentHitPoints relative to the base hit points (HitPoints): the
            // level and CON bonus on top is not in it (ours, from the install's save: Bandon
            // 10/40/10 at full health, the player 0/10/-6 at 4). So the current hit points are
            // CurrentHitPoints + (max - base); save::put_rules_creature writes them back that way.
            if f.has_file_hp {
                o.hp = f.file_hp + (o.hp_max - f.c.hp_base)
                f.has_file_hp = false
            }
            if o.hp > o.hp_max { o.hp = o.hp_max }
        }
        // A saved corpse is dead again (GetDead: hit points below 1, 8.1); its destroy event
        // comes back with the module's event queue.
        if o.hp < 1 and not c.is_pc and not c.dead {
            c.dead = true
            o.animation = animname::ROW_BASE + @as(u32, if is_beast{ w = &w, c } { ROW_CDEAD } else { ROW_DEAD })
        }
    }

    // ---- effects

    // Applies one effect to an object's rules state and does what the rules say (the events).
    fn apply { mut w: world::World, target: u32, e: rules::Effect } -> rules::ApplyResult {
        let mut g = rules::fx::make_group{ e }
        return apply_group{ &w, target, g = &g }
    }

    fn apply_group { mut w: world::World, target: u32, g: *rules::EffectGroup } -> rules::ApplyResult {
        let mut none: rules::ApplyResult
        let o = world::object{ w = &w, id = target } ifnull { return none }
        let f = of{ o } ifnull { return none }
        sync_flags{ w = &w, o, f }
        rules::clear_events{ ev = &w.rev }
        let res = rules::apply_group{ env = env_of{ w = &w, o }, c = &f.c, g = g.*, rng = &w.dice, ev = &w.rev }
        drain{ &w, id = target }
        return res
    }

    // The rules' events about creature `id`, in order (rules.md, "Events the engine drains").
    fn drain { mut w: world::World, id: u32 } {
        let evs = w.rev
        rules::clear_events{ ev = &w.rev }
        let mut i: i32 = 0
        while i < evs.len {
            handle{ &w, id, e = evs.items[@as(usize, i)] }
            i = i + 1
        }
    }

    fn handle { mut w: world::World, id: u32, e: rules::Event } {
        let o = world::object{ w = &w, id } ifnull { return }
        let k = e.kind
        if k == rules::ev::HEAL_HP {
            o.hp = o.hp + e.a
            if o.hp > o.hp_max { o.hp = o.hp_max }
        } else if k == rules::ev::DAMAGE_HP {
            take_damage{ &w, id, amount = e.a, types = e.b, who = e.who }
        } else if k == rules::ev::DEATH {
            died{ &w, id, killer = e.who, melee = e.a != 0 }
        } else if k == rules::ev::RESURRECT {
            o.hp = e.a
            if obj::creature{ o } is some{ value = c } { c.dead = false }
            // One lying on the floor gets up with the get-up of the way it fell (getupdead after die
            // and dead, getupdead1 after die1 and dead1; animations.2da rows 381, 382).
            let row = row_of_animation{ id = o.animation }
            let lying = row == ROW_DIE or row == ROW_DEAD or row == ROW_DIE1 or row == ROW_DEAD1
            if lying and of{ o } is some{ value = f } {
                f.dying_ms = 0
                f.react_ms = GETUP_MS
                play_row{ &w, o, row = if row == ROW_DIE1 or row == ROW_DEAD1 { ROW_GETUP1 } else { ROW_GETUP } }
            } else {
                world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
            }
        } else if k == rules::ev::MAX_HP_CHANGED {
            o.hp = o.hp + (e.b - e.a)
            o.hp_max = e.b
            if o.hp < 1 { lethal_check{ &w, id, who = obj::INVALID, melee = false } }
        } else if k == rules::ev::CLEAR_ACTIONS or k == rules::ev::COMBAT_ROUND_ABORT {
            actions::clear_all{ &w, id }
            end_round{ &w, id, script = false }
        } else if k == rules::ev::COMMANDABLE {
            o.commandable = e.a != 0
        } else if k == rules::ev::VISUAL_ON {
            // A duration visual stays until its effect leaves; the others play once.
            if e.b == 0 and is_duration_visual{ w = &w, effect = e.a } { hold_visual{ &w, effect = e.a, target = id } }
            else { visual_effect{ &w, effect = e.a, target = id, source = e.who, position = math::vec3::zero{} } }
        } else if k == rules::ev::VISUAL_OFF {
            outbox::post{ out = &w.out, note = outbox::Note::visual_release{ effect = e.a, target = id } }
        } else if k == rules::ev::STATE {
            state_changed{ &w, id, after = e.a, before = e.b }
        } else if k == rules::ev::FORCE_PUSH {
            push_creature{ &w, id }
        } else if k == rules::ev::KNOCKDOWN {
            knock_down{ &w, id }
        } else if k == rules::ev::FEEDBACK {
            if w.log.combat {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "feedback {} ({}) to {}\n", e.a, e.b, id)
            }
        }
    }

    // ---- hit points, death (6.6, 6.7, 8)

    fn take_damage { mut w: world::World, id: u32, amount: i32, types: i32, who: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let f = c.fighter ifnull { return }
        if c.dead or f.c.down { return }
        o.hp = o.hp - amount
        if o.min_one_hp and o.hp < 1 { o.hp = 1 }
        f.last_damage = amount
        fight_log::damaged{ &w, target = id, amount, who }
        f.damage_types = [0; 15]
        let mut slot: u32 = 0
        while slot < 15 {
            if (types >> slot) & 1 != 0 { f.damage_types[@as(usize, slot)] = amount }
            slot = slot + 1
        }
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "{} takes {} damage from {}: {}/{}\n", id, amount, who, o.hp, o.hp_max)
        }
        if who != obj::INVALID and who != id {
            o.ctx.last_damager = who
            c.last_hostile_actor = who
            enter_combat{ &w, id, other = who }
        }
        // OnDamaged, unless it is the player character (the main one, whoever leads: +0x9d4) or
        // the hit left it dead or down (6.6 step 5).
        if id != w.player and o.hp >= 1 {
            events::post{ &w, delay_ms = 0, caller = who, target = id, payload = events::Payload::script{ e = events::script_event{ kind = events::DAMAGED, object = who } } }
        }
        if amount > 0 and o.hp > 0 { bark{ &w, id, first = VOICE_PAIN, count = 2, chance_in = 2, quiet = true } }
        lethal_check{ &w, id, who, melee = true }
    }

    // A creature now dead, or a party member now down, gets the death effect (6.6 step 7).
    fn lethal_check { mut w: world::World, id: u32, who: u32, melee: bool } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let f = c.fighter ifnull { return }
        sync_flags{ w = &w, o, f }
        if not rules::is_dead{ c = &f.c, hp = o.hp } and not rules::is_downed_party_member{ c = &f.c, hp = o.hp } { return }
        let mut d = rules::fx::make_death{ spectacular = false, feedback = true }
        d.ints[0] = if melee { 1 } else { 0 }
        rules::fx::set_creator{ e = &d, creator = who, spell_id = -1 }
        rules::clear_events{ ev = &w.rev }
        let res = rules::apply_effect{ env = env_of{ w = &w, o }, c = &f.c, e = d, rng = &w.dice, ev = &w.rev }
        _ = res
        drain{ &w, id }
    }

    // The death effect took hold (8.2): the round ends, OnDeath runs, the body falls and is
    // destroyed later; a party member only goes down.
    fn died { mut w: world::World, id: u32, killer: u32, melee: bool } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let f = c.fighter ifnull { return }
        if c.dead { return }
        if o.plot { return }
        if o.min_one_hp {
            o.hp = 1
            return
        }
        actions::clear_all{ &w, id }
        end_round{ &w, id, script = false }
        let back = world::object{ w = &w, id } ifnull { return }
        let bc = obj::creature{ o = back } ifnull { return }
        f.killer = killer
        f.combat_ms = 0
        bc.in_combat = false
        bc.attack_target = obj::INVALID
        clear_attackers{ &w, id }
        // OnApplyDeath picks one of the two ways to fall at random (animation states 3 and 4, 8.2).
        let second = not is_beast{ w = &w, c = bc } and world::random{ &w } % 2 == 1
        play_row{ &w, o = back, row = if is_beast{ w = &w, c = bc } { ROW_CDIE } else if second { ROW_DIE1 } else { ROW_DIE } }
        bark{ &w, id, first = VOICE_DEAD, count = 1, chance_in = 1, quiet = false }
        f.dying_ms = DIE_MS
        if f.c.party {
            // A party member goes down: never dead (8.1); it gets up when the fight is over. The
            // module's OnPlayerDeath runs (GetLastPlayerDied, 8.2).
            if w.log.combat {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "{} is down\n", id)
            }
            if world::object{ w = &w, id = w.module } is some{ value = mo } {
                mo.ctx.last_player_died = id
                events::post{ &w, delay_ms = 0, caller = id, target = w.module, payload = events::Payload::script{ e = events::script_event{ kind = events::DEATH, object = killer } } }
            }
            // "Party Member Down" auto-pause, while another member is up (8.2).
            if first_member_up{ w = &w } != obj::INVALID { autopause::request{ &w, reason = autopause::PARTY_MEMBER_DOWN } }
            // The one the player controls went down: control passes to the next member who is up
            // (0x005edf80 -> 0x005f7960).
            if id == party::leader{ w = &w } {
                let next = first_member_up{ w = &w }
                if next != obj::INVALID {
                    party::set_leader{ &w, id = next }
                    w.pc = next
                    w.target = obj::INVALID
                }
            }
            return
        }
        bc.dead = true
        if back.hp > rules::DEATH_HP { back.hp = rules::DEATH_HP }
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "{} ({}) dies, killed by {}\n", id, back.tag, killer)
        }
        award_kill_xp{ &w, victim = id, killer }
        events::post{ &w, delay_ms = 0, caller = killer, target = id, payload = events::Payload::script{ e = events::script_event{ kind = events::DEATH, object = killer } } }
        if bc.destroyable {
            let delay = twoda::get_int{ t = w.tables.appearance, row = @as(usize, bc.appearance), column = "destroyobjectdelay" } ifnull 3
            events::post{ &w, delay_ms = @as(u64, @as(u32, if delay > 0 { delay } else { 3 })) * 1000 + 2000, caller = id, target = id, payload = events::Payload::destroy }
        }
    }

    // Damage to a door or placeable (combat.md 6.6 step 2, 8.2): hit points down unless plot,
    // OnDamaged; at 0 a door is bashed open (and plot from then on), a placeable dies (OnDeath,
    // destroyed 2 s later). The attacker stops.
    fn damage_object { mut w: world::World, id: u32, amount: i32, who: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        if o.plot or o.hp < 1 or amount <= 0 { return }
        o.hp = o.hp - amount
        o.ctx.last_damager = who
        fight_log::damaged{ &w, target = id, amount, who }
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "{} ({}) takes {} damage from {}: {}/{}\n", id, o.tag, amount, who, o.hp, o.hp_max)
        }
        events::post{ &w, delay_ms = 0, caller = who, target = id, payload = events::Payload::script{ e = events::script_event{ kind = events::DAMAGED, object = who } } }
        if o.hp >= 1 { return }
        if o.kind == obj::Kind::door {
            doors::set_door_state{ &w, id, state = obj::DoorState::open1 }
            let back = world::object{ w = &w, id } ifnull { return }
            back.plot = true
        } else {
            events::post{ &w, delay_ms = 2000, caller = id, target = id, payload = events::Payload::destroy }
        }
        events::post{ &w, delay_ms = 0, caller = who, target = id, payload = events::Payload::script{ e = events::script_event{ kind = events::DEATH, object = who } } }
        actions::clear_all{ &w, id = who }
        if world::object{ w = &w, id = who } is some{ value = a } {
            if obj::creature{ o = a } is some{ value = ac } { if ac.attack_target == id { ac.attack_target = obj::INVALID } }
        }
    }

    // Everyone who was attacking `id` stops (ClearAttackersInArea, 3.6).
    fn clear_attackers { mut w: world::World, id: u32 } {
        let all = list::items{ list = w.objects.all }
        let mut i: usize = 0
        while i < all.len {
            let o = all[i]
            i = i + 1
            if o.kind != obj::Kind::creature or o.area != w.area { continue }
            let c = obj::creature{ o } ifnull { continue }
            if c.attack_target == id { c.attack_target = obj::INVALID }
            if c.attempted_target == id { c.attempted_target = obj::INVALID }
        }
    }

    // AwardKillXP (8.3): a hostile non-party victim gives the party its kill value.
    fn award_kill_xp { mut w: world::World, victim: u32, killer: u32 } {
        let o = world::object{ w = &w, id = victim } ifnull { return }
        let f = of{ o } ifnull { return }
        if victim == w.player or f.c.party { return }
        let pc = world::object{ w = &w, id = w.player } ifnull { return }
        let rep = world::standing{ w = &w, from = pc.faction, toward = o.faction }
        if not rules::awards_kill_xp{ victim_in_party = false, victim_dying = false, reputation = rep } { return }
        let members = party::members{ w = &w }
        let mut level: i32 = 0
        let mut size: i32 = 0
        let mut k: usize = 0
        while k < members.len {
            let m = world::object{ w = &w, id = members[k] }
            k = k + 1
            if m == null { continue }
            let mf = of{ o = m } ifnull { continue }
            level = level + mf.c.stats.level
            size = size + 1
        }
        if size == 0 { return }
        let xp = rules::kill_xp_value{ tables = w.rules, victim = &f.c, party_level = level / size, party_size = size }
        if xp <= 0 { return }
        k = 0
        while k < members.len {
            let m = world::object{ w = &w, id = members[k] }
            k = k + 1
            if m == null { continue }
            let mf = of{ o = m } ifnull { continue }
            let given = rules::add_experience{ tables = w.rules, c = &mf.c, xp, percent_xp = 100 }
            if obj::creature{ o = m } is some{ value = mc } { mc.xp = @as(u32, mf.c.xp) }
            _ = given
        }
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "{} XP for killing {}\n", xp, victim)
        }
        fight_log::killed{ &w, victim, killer, xp }
    }

    // ---- combat state (3.6)

    // Both sides of a hostile act are in combat for the next 8 s.
    fn enter_combat { mut w: world::World, id: u32, other: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        if obj::creature{ o } is some{ value = c } {
            if c.dead { return }
            let was = c.in_combat
            c.in_combat = true
            if c.fighter is some{ value = f } { f.combat_ms = COMBAT_MS }
            if not was { bark{ &w, id, first = VOICE_BATTLE, count = 6, chance_in = 1, quiet = false } }
        }
        _ = other
    }

    // ---- animations

    // Appearance model types S and L are creatures (no weapons, the `c` animation set).
    fn is_beast { w: *world::World, c: *obj::Creature } -> bool {
        let t = twoda::get_string{ t = w.tables.appearance, row = @as(usize, c.appearance), column = "modeltype" } ifnull "B"
        return t.len > 0 and (t[0] == 'S' or t[0] == 's' or t[0] == 'L' or t[0] == 'l')
    }

    fn wield_of { w: *world::World, item: u32 } -> i32 {
        let io = world::object{ w, id = item } ifnull { return 0 }
        let it = obj::item{ o = io } ifnull { return 0 }
        return twoda::get_int{ t = w.tables.baseitems, row = @as(usize, it.base), column = "weaponwield" } ifnull 0
    }

    fn is_ranged_item { w: *world::World, item: u32 } -> bool {
        let io = world::object{ w, id = item } ifnull { return false }
        let it = obj::item{ o = io } ifnull { return false }
        return (twoda::get_int{ t = w.tables.baseitems, row = @as(usize, it.base), column = "rangedweapon" } ifnull 0) != 0
    }

    // The creature's combat stance (the digit of the animation names, models-usage.md; ours where
    // the client's choice was not read, combat.md 12): 0 a creature model, 1 stun baton, 2 one
    // melee weapon, 3 two-handed or double, 4 two melee weapons, 5 pistol, 6 two pistols, 7 rifle
    // or heavy weapon, 8 bare hands.
    fn stance { w: *world::World, c: *obj::Creature } -> i32 {
        if is_beast{ w, c } { return 0 }
        let right = wield_of{ w, item = c.equipped[obj::SLOT_RIGHT_WEAPON] }
        let left = wield_of{ w, item = c.equipped[obj::SLOT_LEFT_WEAPON] }
        if right == 0 { return 8 }
        if right == 1 { return 1 }
        if right == 2 { return if left == 2 or left == 1 { 4 } else { 2 } }
        if right == 3 { return 3 }
        if right == 4 { return if left == 4 { 6 } else { 5 } }
        return 7
    }

    fn is_ranged_stance { s: i32 } -> bool { return s >= 5 and s <= 7 }

    // The ready stance of a stance (g<n>r1, creadyr).
    fn ready_row { s: i32 } -> i32 {
        if s == 0 { return ROW_CREADY }
        let rows: [9]i32 = [278, 92, 133, 174, 215, 223, 237, 245, 249]
        return rows[@as(usize, s)]
    }

    // An attack animation row: melee duels (c sets) when both sides fight in melee, the general
    // attacks (g sets) otherwise; ranged b sets.
    fn attack_row { mut w: world::World, s: i32, duel: bool, ranged_beast: bool } -> i32 {
        let pick = world::random{ &w }
        if s == 0 {
            if ranged_beast { return if pick % 2 == 0 { 288 } else { 289 } }
            return if pick % 2 == 0 { 276 } else { 277 }
        }
        if s == 1 { return if pick % 2 == 0 { 87 } else { 88 } }
        if s == 2 { return if duel { 94 + @as(i32, pick % 5) } else if pick % 2 == 0 { 122 } else { 123 } }
        if s == 3 { return if duel { 135 + @as(i32, pick % 5) } else if pick % 2 == 0 { 163 } else { 164 } }
        if s == 4 { return if duel { 176 + @as(i32, pick % 5) } else if pick % 2 == 0 { 204 } else { 205 } }
        if s == 5 { return if pick % 2 == 0 { 217 } else { 218 } }
        if s == 6 { return if pick % 2 == 0 { 231 } else { 232 } }
        if s == 7 { return if pick % 2 == 0 { 239 } else { 240 } }
        return if pick % 2 == 0 { 247 } else { 248 }
    }

    fn play_row { mut w: world::World, o: *mut obj::Object, row: i32 } {
        if row < 0 { return }
        let mut flip: u32 = 0
        if of{ o } is some{ value = ff } {
            ff.variant = ff.variant ^ 1
            flip = ff.variant
        }
        world::set_animation{ o, id = animname::ROW_BASE + (flip << 16) + @as(u32, row), speed = 1.0 }
    }

    fn row_of_animation { id: u32 } -> i32 {
        if id < animname::ROW_BASE { return NO_ROW }
        return @as(i32, (id - animname::ROW_BASE) & 0xFFFF)
    }

    // The column `<prefix><n>` of combatanimations.2da's row for an attack animation, as an int.
    fn combat_cell { w: *world::World, row: i32, prefix: []u8, n: i32 } -> ?i32 {
        let mut label: [8]u8
        let mut len: usize = 0
        let mut v = row
        let mut digits: [6]u8
        let mut d: usize = 0
        if v == 0 { digits[0] = '0'; d = 1 }
        while v > 0 and d < 6 { digits[d] = @trunc(u8, '0' + @as(u32, v % 10)); v = v / 10; d = d + 1 }
        while d > 0 { d = d - 1; label[len] = digits[d]; len = len + 1 }
        let r = twoda::find_row{ t = w.tables.combatanimations, label = label[..len] } ifnull { return null }
        let mut col: [16]u8
        let mut cl: usize = 0
        while cl < prefix.len { col[cl] = prefix[cl]; cl = cl + 1 }
        col[cl] = @trunc(u8, '0' + @as(u32, n))
        cl = cl + 1
        return twoda::get_int{ t = w.tables.combatanimations, row = r, column = col[..cl] }
    }

    // ---- the round (3.1 - 3.5)

    fn in_reach { w: *world::World, o: *obj::Object, t: *obj::Object, ranged: bool } -> bool {
        let d = doors::distance_2d{ a = o.position, b = t.position }
        return d <= reach{ w, o, t, ranged } + 0.5
    }

    // How near the attacker must stand (actions.md 3.13 step 4): melee both personal spaces + 0.7,
    // ranged the weapon's maxattackrange (30 when 0), less a margin.
    fn reach { w: *world::World, o: *obj::Object, t: *obj::Object, ranged: bool } -> f32 {
        let mut mine: f32 = 0.5
        let mut theirs: f32 = 0.5
        if obj::creature{ o } is some{ value = c } {
            mine = c.perspace
            if ranged {
                let mut range: f32 = 0.0
                if world::object{ w, id = c.equipped[obj::SLOT_RIGHT_WEAPON] } is some{ value = iv } {
                    if obj::item{ o = iv } is some{ value = it } {
                        range = twoda::get_float{ t = w.tables.baseitems, row = @as(usize, it.base), column = "maxattackrange" } ifnull 0.0
                    }
                }
                if range <= 0.0 { range = 30.0 }
                return math::min{ a = range, b = 15.0 }
            }
        }
        if obj::creature{ o = t } is some{ value = tc } { theirs = tc.perspace }
        if t.kind != obj::Kind::creature { theirs = 1.0 }
        return mine + theirs + 0.7
    }

    // ATTACKOBJECT (actions.md 3.13, combat.md 3.1): param 0 the target, 1 passive. Walks into
    // reach, then starts one round and is done; the next round comes from OnEndRound's AI (or,
    // for the player's own creature, from end_round).
    fn attack_object { mut w: world::World, id: u32, a: *mut actions::Action } -> actions::Status {
        let o = world::object{ w = &w, id } ifnull { return actions::Status::failed }
        let c = obj::creature{ o } ifnull { return actions::Status::failed }
        let target = actions::object_param{ a, i = 0 }
        if target == id or c.dead { return actions::Status::failed }
        let t = world::object{ w = &w, id = target } ifnull { return actions::Status::done }
        if t.area != o.area { return actions::Status::done }
        if obj::creature{ o = t } is some{ value = tc } {
            if tc.dead { return actions::Status::done }
            let tf = tc.fighter ifnull { return actions::Status::done }
            if tf.c.down { return actions::Status::done }
        }
        let f = c.fighter ifnull { return actions::Status::failed }
        // A party member who is down does nothing (AIActionAttackObject step 2).
        sync_flags{ w = &w, o, f }
        if f.c.down { return actions::Status::failed }
        if actions::int_param{ a, i = 3 } != 0 {
            // A cutscene attack (params 3 flag, 4 animation row, 5 result, 6 damage): the round
            // starts at once with the designer's numbers.
            f.round = no_round{}
            let forced = Forced{ on = true, animation = actions::int_param{ a, i = 4 }, result = actions::int_param{ a, i = 5 }, damage = actions::int_param{ a, i = 6 } }
            start_round{ &w, id, target, s = stance{ w = &w, c }, ranged_in = false, feat = 0, forced }
            return actions::Status::done
        }
        if not rules::can_attack{ c = &f.c } { return actions::Status::failed }
        c.attempted_target = target
        if f.round.started { return actions::Status::running }
        let s = stance{ w = &w, c }
        let ranged = is_ranged_stance{ s } or (s == 0 and is_ranged_item{ w = &w, item = c.equipped[obj::SLOT_RIGHT_WEAPON] })
        if not in_reach{ w = &w, o, t, ranged } {
            if actions::int_param{ a, i = 1 } != 0 { return actions::Status::failed }
            if a.phase >= 40 { return actions::Status::failed }
            // Approach: a move in front of a copy of this action (actions.md 3.13).
            let mut copy = a.*
            copy.phase = a.phase + 1
            copy.has_started = false
            actions::add_front{ &w, id, action = copy }
            let mut move = actions::make{ kind = actions::Kind::move_to_point }
            move.params[0] = actions::Param::vector{ v = t.position }
            move.params[1] = actions::Param::int{ v = 1 }
            move.params[2] = actions::Param::float{ v = reach{ w = &w, o, t, ranged } }
            move.params[3] = actions::Param::object{ id = target }
            move.params[4] = actions::Param::float{ v = 6.0 }
            actions::add_front{ &w, id, action = move }
            a.params = [actions::Param::none; 8]
            return actions::Status::done
        }
        start_round{ &w, id, target, s, ranged_in = ranged, feat = actions::int_param{ a, i = 2 }, forced = not_forced{} }
        return actions::Status::done
    }

    // StartCombatRound and the attacks of the round resolved at once (3.1, 3.3): the impacts
    // land later, at their hit times.
    fn start_round { mut w: world::World, id: u32, target: u32, s: i32, ranged_in: bool, feat: i32, forced: Forced } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let f = c.fighter ifnull { return }
        let t = world::object{ w = &w, id = target } ifnull { return }
        sync_flags{ w = &w, o, f }
        // The defender as the rules see it: a creature's own, or for a door or placeable a plain
        // stand-in (AC 10; the rules' target_object rules apply).
        let mut stand_in: rules::Creature
        stand_in.loaded_hp = -1
        stand_in.abil = [10; 6]
        let mut def: *mut rules::Creature = &stand_in
        let mut ts: i32 = 8
        let mut is_object = false
        if obj::creature{ o = t } is some{ value = tc } {
            let tf = tc.fighter ifnull { return }
            sync_flags{ w = &w, o = t, f = tf }
            ts = stance{ w = &w, c = tc }
            def = &tf.c
        } else {
            if t.kind != obj::Kind::door and t.kind != obj::Kind::placeable { return }
            rules::recompute{ tables = w.rules, c = &stand_in }
            is_object = true
        }
        // Face the target.
        let dir = math::vec3::sub{ a = t.position, b = o.position }
        if dir.x * dir.x + dir.y * dir.y > 0.0001 { world::set_orientation{ o, v = math::Vec3{ x = dir.x, y = dir.y, z = 0.0 } } }
        // A cutscene attack names its animation: it is ranged when weapondischarge.2da times it.
        let mut ranged = ranged_in
        if forced.on {
            let mut probe: [12]u8
            ranged = discharge_row{ w = &w, appearance = c.appearance, row = forced.animation, into = probe[..] } != null
        }
        let flight_ms: i32 = if ranged { bolt_ms{ o, t } } else { 0 }
        let duel = not ranged and not is_ranged_stance{ s = ts } and s != 8 and ts != 8
        let row = if forced.on { forced.animation } else { attack_row{ &w, s, duel, ranged_beast = ranged and s == 0 } }
        f.round = no_round{}
        f.round.cutscene = forced.on
        f.round.feat = if feat > 0 { feat } else { 0 }
        if forced.on { f.ready_ms = CUTSCENE_READY_MS }
        f.round.started = true
        f.round.length_ms = ROUND_MS
        f.round.target = target
        f.round.anim_row = row
        c.attack_target = target
        c.last_hostile_target = target
        c.last_attack_action = 3
        if not forced.on {
            enter_combat{ &w, id, other = target }
            enter_combat{ &w, id = target, other = id }
        }
        // The situation the rules need (combat.ctx AttackSituation).
        let mut sit = rules::make_situation{}
        let dx = t.position.x - o.position.x
        let dy = t.position.y - o.position.y
        sit.dist2 = dx * dx + dy * dy
        let seen = perception::entry_of{ w = &w, viewer = target, target = id }
        sit.defender_sees = seen != null
        let len = math::sqrtf{ x = sit.dist2 }
        sit.facing_cos = if len > 0.001 { -(t.orientation.x * dx + t.orientation.y * dy) / len } else { 1.0 }
        sit.facing_dot = t.orientation.x * o.orientation.x + t.orientation.y * o.orientation.y
        sit.defender_hp = t.hp
        sit.attacker_id = id
        sit.target_object = is_object
        sit.target_plot = is_object and t.plot
        if forced.on {
            sit.forced = true
            sit.forced_result = forced.result
            sit.forced_damage = if forced.damage < 0 { 0 } else { forced.damage }
        }
        let counts = rules::attack_counts{ tables = w.rules, c = &f.c, combat_feat = feat }
        c.last_combat_feat = if feat > 0 { feat } else { -1 }
        let total = @as(usize, if counts.total > 0 { counts.total } else { 1 })
        // When the attacks land: melee hit times from combatanimations.2da (hit1..3), ranged shots
        // from weapondischarge.2da, spread over the attacks at random (3.3).
        let mut times: [MAX_IMPACTS]i32 = [0; MAX_IMPACTS]
        let mut hands: [MAX_IMPACTS]i32 = [0; MAX_IMPACTS]
        let mut carries: [MAX_IMPACTS]bool = [false; MAX_IMPACTS]
        let mut n: usize = 0
        if ranged {
            let mut label: [12]u8
            let lr = discharge_row{ w = &w, appearance = c.appearance, row, into = label[..] }
            let lrow = lr ifnull 0
            let shots = if lr != null { twoda::get_int{ t = w.tables.weapondischarge, row = lrow, column = "shots" } ifnull 1 } else { 1 }
            let mut left = total
            let mut u: i32 = 0
            while u < shots and n < MAX_IMPACTS {
                let mut col: [8]u8 = ['s', 'h', 'o', 't', '0', '0', 0, 0]
                let mut cl: usize = 4
                if u + 1 >= 10 { col[cl] = '1'; cl = cl + 1; col[cl] = @trunc(u8, '0' + @as(u32, u + 1 - 10)) } else { col[cl] = @trunc(u8, '0' + @as(u32, u + 1)) }
                cl = cl + 1
                times[n] = if lr != null { twoda::get_int{ t = w.tables.weapondischarge, row = lrow, column = col[..cl] } ifnull 500 } else { 500 }
                if lr != null {
                    // switchmask: one digit per shot, 1 the on-hand weapon and 0 the off-hand one.
                    let mask = twoda::get_string{ t = w.tables.weapondischarge, row = lrow, column = "switchmask" } ifnull ""
                    if @as(usize, u) < mask.len and mask[@as(usize, u)] == '0' { hands[n] = 1 }
                }
                let remaining = @as(u32, shots - u)
                carries[n] = left > 0 and (world::random{ &w } % remaining) < @as(u32, left)
                if forced.on { carries[n] = u + 1 == shots }            // the designer's one hit: on the last shot
                if carries[n] { left = left - 1 }
                n = n + 1
                u = u + 1
            }
            if n == 0 {
                times[0] = 500
                carries[0] = true
                n = 1
            }
        } else {
            let hit1 = combat_cell{ w = &w, row, prefix = "hit", n = 1 } ifnull 500
            while n < total and n < MAX_IMPACTS {
                times[n] = combat_cell{ w = &w, row, prefix = "hit", n = @as(i32, n) + 1 } ifnull (hit1 + @as(i32, n) * 250)
                carries[n] = true
                n = n + 1
            }
        }
        // Resolve the attacks in order (the rules draw every die).
        let mut attack: i32 = 0
        let mut k: usize = 0
        while k < n {
            let mut imp = no_impact{}
            imp.at_ms = times[k] + flight_ms
            imp.fire_ms = times[k]
            imp.hand = hands[k]
            imp.target = target
            imp.ranged = ranged
            imp.cutscene = forced.on
            imp.attack = carries[k]
            if carries[k] {
                rules::clear_events{ ev = &w.rev }
                let res = rules::resolve_attack{ tables = w.rules, rng = &w.dice, atk = &f.c, def, ev = &w.rev, sit = &sit, attack_index = attack, combat_feat = feat, simulate = false }
                drain{ &w, id = target }
                imp.hit = res.hit
                imp.result = res.roll.result
                imp.killing = res.killing_blow
                imp.damage = res.damage
                imp.nfx = res.effects.len
                imp.fx = res.effects.items
                // The target's reaction (3.3): damage on a hit, else a parry (melee) or a dodge.
                let column: []u8 = if res.hit { "damage" } else if ranged { "dodge" } else { "parry" }
                imp.reaction = combat_cell{ w = &w, row, prefix = column, n = ts } ifnull NO_ROW
                attack = attack + 1
                c.last_attack_result = res.roll.result
                if w.log.combat {
                    world::prefix{ w = &w }
                    _ = @fmt(&w.io, "  attack {}: d20 {} total {} vs {} result {} damage {} at {} ms\n", attack, res.roll.d20, res.roll.attack_total, res.roll.attack_total + res.roll.missed_by, res.roll.result, res.damage.total, times[k])
                }
            }
            f.round.impacts[k] = imp
            k = k + 1
        }
        f.round.count = n
        // The attack animation plays until a little after the last impact.
        let last = times[if n > 0 { n - 1 } else { 0 }]
        f.round.anim_ms = if last + 600 < ROUND_MS - 200 { last + 600 } else { ROUND_MS - 200 }
        play_row{ &w, o, row }
        if not forced.on { bark{ &w, id, first = VOICE_ATTACK, count = 3, chance_in = 2, quiet = true } }
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "{} attacks {}: {} attacks, animation {}\n", id, target, attack, row)
        }
    }

    // weapondischarge.2da's row for an attack animation: `<appearance>_<row>` first, then `<row>`.
    fn discharge_row { w: *world::World, appearance: u32, row: i32, into: []mut u8 } -> ?usize {
        let mut n = put_number{ into, at = 0, v = @as(u32, appearance) }
        into[n] = '_'
        n = n + 1
        n = put_number{ into, at = n, v = @as(u32, row) }
        let specific = twoda::find_row{ t = w.tables.weapondischarge, label = into[..n] }
        if specific != null { return specific }
        let m = put_number{ into, at = 0, v = @as(u32, row) }
        return twoda::find_row{ t = w.tables.weapondischarge, label = into[..m] }
    }

    fn put_number { into: []mut u8, at: usize, v: u32 } -> usize {
        let mut digits: [10]u8
        let mut d: usize = 0
        let mut x = v
        if x == 0 { digits[0] = '0'; d = 1 }
        while x > 0 { digits[d] = @trunc(u8, '0' + x % 10); x = x / 10; d = d + 1 }
        let mut n = at
        while d > 0 and n < into.len { d = d - 1; into[n] = digits[d]; n = n + 1 }
        return n
    }

    // One impact lands (6.5): OnAttacked for the target, then the attack's effects (the damage
    // first), the reaction animation.
    fn land { mut w: world::World, id: u32, imp: *Impact } {
        let t = world::object{ w = &w, id = imp.target } ifnull { return }
        if t.kind == obj::Kind::door or t.kind == obj::Kind::placeable {
            if imp.attack { fight_log::attack{ &w, attacker = id, imp } }
            if imp.attack and imp.hit { damage_object{ &w, id = imp.target, amount = imp.damage.total, who = id } }
            return
        }
        let tc = obj::creature{ o = t } ifnull { return }
        if tc.dead { return }
        if not imp.attack { return }
        fight_log::attack{ &w, attacker = id, imp }
        if imp.ranged { land_ranged_fx{ &w, id, imp, power = false } } else { land_melee_fx{ &w, id, imp } }
        if imp.result == rules::outcome::CRITICAL { bark{ &w, id, first = VOICE_CRITICAL, count = 1, chance_in = 1, quiet = false } }
        t.ctx.last_attacker = id
        tc.last_hostile_actor = id
        if not imp.cutscene { enter_combat{ &w, id = imp.target, other = id } }
        // OnAttacked for every creature hit that is up, the player's own too (the creature event
        // handler 0x004fece0, event 15, has no player test): the leader's k_hen_attacked01 shouts
        // GEN_I_WAS_ATTACKED, which is how the companions join a fight on the leader.
        let downed = if tc.fighter is some{ value = tf } { tf.c.down } else { false }
        if not downed {
            events::post{ &w, delay_ms = 0, caller = id, target = imp.target, payload = events::Payload::script{ e = events::script_event{ kind = events::MELEE_ATTACKED, object = id } } }
        }
        // The damage first (rules.md: make_damage_effects, applied before the attack's other effects).
        if imp.hit {
            let dmg = rules::make_damage_effects{ roll = &imp.damage, creator = id }
            let mut d: i32 = 0
            while d < dmg.len {
                _ = apply{ &w, target = imp.target, e = dmg.items[@as(usize, d)] }
                d = d + 1
            }
        }
        let mut k: i32 = 0
        while k < imp.nfx {
            let ce = imp.fx[@as(usize, k)]
            k = k + 1
            _ = apply{ &w, target = if ce.to_attacker { id } else { imp.target }, e = ce.effect }
        }
        let back = world::object{ w = &w, id = imp.target } ifnull { return }
        let bc = obj::creature{ o = back } ifnull { return }
        if bc.dead { return }
        let bf = bc.fighter ifnull { return }
        if bf.round.started and bf.round.anim_ms > bf.round.timer_ms { return }      // busy attacking
        if imp.reaction >= 0 and not bf.c.down {
            play_row{ &w, o = back, row = imp.reaction }
            bf.react_ms = 900
        }
    }

    // EndCombatRound (3.5): OnEndRound runs (the AI's next move); the player's own creature
    // attacks again while its target lives and nothing else is queued (ours: the client's
    // auto-attack was not read).
    fn end_round { mut w: world::World, id: u32, script: bool } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let f = c.fighter ifnull { return }
        if not f.round.started { return }
        let target = f.round.target
        let cutscene_round = f.round.cutscene
        f.round.started = false
        f.round.count = 0
        if c.dead or f.c.down { return }
        let mut target_alive = false
        if world::object{ w = &w, id = target } is some{ value = tv } {
            if tv.kind == obj::Kind::door or tv.kind == obj::Kind::placeable { target_alive = tv.hp >= 1 and not tv.plot }
            if obj::creature{ o = tv } is some{ value = tc } {
                target_alive = not tc.dead
                if tc.fighter is some{ value = tf } { if tf.c.down { target_alive = false } }
            }
        }
        if not target_alive {
            c.attack_target = obj::INVALID
            if c.attempted_target == target { c.attempted_target = obj::INVALID }
        }
        if not script or cutscene_round { return }
        if w.log.combat {
            world::prefix{ w = &w }
            let state: []u8 = if target_alive { "alive" } else { "gone" }
            _ = @fmt(&w.io, "{} ends its round (target {} {})\n", id, target, state)
        }
        if id == party::leader{ w = &w } { autopause::request{ &w, reason = autopause::END_OF_ROUND } }
        if id == party::leader{ w = &w } { continue_fight{ &w, id, target, target_alive } }
        events::post{ &w, delay_ms = 0, caller = id, target = id, payload = events::Payload::script{ e = events::script_event{ kind = events::END_COMBAT_ROUND, object = target } } }
    }

    // What the leader does when its round ends (EndCombatRound calls 0x005b6980 for the client
    // party's leader, after OnEndRound): while its hostile target lives and nothing else waits, it
    // attacks it again (a plain attack); when the target died, it takes the nearest enemy it sees
    // within its attack range + 2 m (0x004f2de0, the range 0x004ffad0), which becomes the HUD's
    // target too (0x005edd70), and its waiting attacks turn on it (UpdateAttackTargetForAllActions);
    // with no such enemy it stands down.
    fn continue_fight { mut w: world::World, id: u32, target: u32, target_alive: bool } {
        let o = world::object{ w = &w, id } ifnull { return }
        if target_alive {
            let t = world::object{ w = &w, id = target } ifnull { return }
            if t.kind != obj::Kind::creature { return }
            if world::standing{ w = &w, from = o.faction, toward = t.faction } >= 11 { return }
            if o.actions.len > 0 { return }
            let mut a = actions::make{ kind = actions::Kind::attack_object }
            a.params[0] = actions::Param::object{ id = target }
            _ = actions::add{ &w, id, action = a, force = false }
            return
        }
        let next = nearest_enemy{ w = &w, o, range = retarget_range{ w = &w, o } }
        if next == obj::INVALID { return }
        // The waiting attacks on the dead turn on the new target; with none waiting, one is made.
        let mut turned = false
        let q = list::items{ list = o.actions }
        let mut i: usize = 0
        while i < q.len {
            if q[i].kind == actions::Kind::attack_object and actions::object_param{ a = &q[i], i = 0 } == target {
                q[i].params[0] = actions::Param::object{ id = next }
                turned = true
            }
            i = i + 1
        }
        if world::object{ w = &w, id } is some{ value = back } {
            if obj::creature{ o = back } is some{ value = c } { c.attempted_target = next }
        }
        if w.target == target or w.target == obj::INVALID { w.target = next }
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "{} turns on {}\n", id, next)
        }
        if turned or o.actions.len > 0 { return }
        let mut a = actions::make{ kind = actions::Kind::attack_object }
        a.params[0] = actions::Param::object{ id = next }
        _ = actions::add{ &w, id, action = a, force = false }
    }

    // GetMaxAttackRange + 2 m (0x004ffad0): a ranged weapon's maxattackrange (30 when 0), else the
    // melee reach (both personal spaces + 0.7) + 0.5.
    fn retarget_range { w: *world::World, o: *obj::Object } -> f32 {
        let c = obj::creature{ o } ifnull { return 2.0 }
        let s = stance{ w, c }
        if is_ranged_stance{ s } or (s == 0 and is_ranged_item{ w, item = c.equipped[obj::SLOT_RIGHT_WEAPON] }) {
            let mut range: f32 = 0.0
            if world::object{ w, id = c.equipped[obj::SLOT_RIGHT_WEAPON] } is some{ value = iv } {
                if obj::item{ o = iv } is some{ value = it } {
                    range = twoda::get_float{ t = w.tables.baseitems, row = @as(usize, it.base), column = "maxattackrange" } ifnull 0.0
                }
            }
            if range <= 0.0 { range = 30.0 }
            return range + 2.0
        }
        return c.perspace * 2.0 + 0.7 + 0.5 + 2.0
    }

    // The nearest living, standing creature hostile to `o` that it sees, within `range` metres
    // between their edges (0x004f2de0, the line-of-sight test left to the perception's seen bit).
    fn nearest_enemy { w: *world::World, o: *obj::Object, range: f32 } -> u32 {
        let me = obj::creature{ o } ifnull { return obj::INVALID }
        let all = list::items{ list = w.objects.all }
        let mut best = obj::INVALID
        let mut best_d = range
        let mut i: usize = 0
        while i < all.len {
            let t = all[i]
            i = i + 1
            if t.id == o.id or t.destroyed or t.kind != obj::Kind::creature or t.area != o.area { continue }
            let tc = obj::creature{ o = t } ifnull { continue }
            if tc.dead or is_down{ w, id = t.id } { continue }
            if world::standing{ w, from = o.faction, toward = t.faction } >= 11 { continue }
            let seen = perception::entry_of{ w, viewer = o.id, target = t.id } ifnull { continue }
            if not seen.seen { continue }
            let d = doors::distance_2d{ a = o.position, b = t.position } - me.perspace - tc.perspace
            if d < best_d {
                best_d = d
                best = t.id
            }
        }
        return best
    }

    // ---- every frame

    fn update { mut w: world::World, id: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let f = c.fighter ifnull { return }
        let dt = @as(i32, w.clock.dt * 1000.0)
        if dt <= 0 { return }
        // The Force pool of a party member refills at 1 % a second out of combat and not at all in
        // combat (regeneration.2da; rules.md 3.8: CSWSCreature::AIUpdate).
        if f.loaded and not c.dead and f.c.stats.max_fp > 0 and f.c.fp < f.c.stats.max_fp {
            f.c.party = party::is_member{ w = &w, id }
            let gain = rules::regenerate_pools{ tables = w.rules, c = &f.c, dt_ms = dt, in_combat = c.in_combat, alive = o.hp > 0 }
            if gain > 0 { o.hp = if o.hp + gain > o.hp_max { o.hp_max } else { o.hp + gain } }
        }
        // The effects' timers (UpdateEffectList): regeneration, poison, expiry.
        if f.c.nfx > 0 and not c.dead {
            sync_flags{ w = &w, o, f }
            rules::clear_events{ ev = &w.rev }
            rules::update_effects{ env = env_of{ w = &w, o }, c = &f.c, rng = &w.dice, ev = &w.rev }
            drain{ &w, id }
        }
        let o2 = world::object{ w = &w, id } ifnull { return }
        let c2 = obj::creature{ o = o2 } ifnull { return }
        // Dying: the die animation, then the body lies dead.
        if f.dying_ms > 0 {
            f.dying_ms = f.dying_ms - dt
            if f.dying_ms <= 0 { play_row{ &w, o = o2, row = if is_beast{ w = &w, c = c2 } { ROW_CDEAD } else if row_of_animation{ id = o2.animation } == ROW_DIE1 { ROW_DEAD1 } else { ROW_DEAD } } }
            return
        }
        if c2.dead { return }
        // Thrown or knocked down: nothing else moves the creature until it is up.
        if f.knock.active {
            step_knock{ &w, o = o2, c = c2, f, dt }
            return
        }
        // A downed party member lies still; update_party gets it up when the fight is over.
        sync_flags{ w = &w, o = o2, f }
        if f.c.down { return }
        // The round: impacts at their times, the end after 3 s.
        if f.round.started {
            f.round.timer_ms = f.round.timer_ms + dt
            // Bolts leave the weapon at their shot times and land after their flight.
            while f.round.shots < f.round.count and f.round.impacts[f.round.shots].fire_ms <= f.round.timer_ms {
                let shot = f.round.impacts[f.round.shots]
                f.round.shots = f.round.shots + 1
                if shot.ranged { fire_shot{ &w, id, imp = &shot, power = false } }
            }
            while f.round.fired < f.round.count and f.round.impacts[f.round.fired].at_ms <= f.round.timer_ms {
                let imp = f.round.impacts[f.round.fired]
                f.round.fired = f.round.fired + 1
                land{ &w, id, imp = &imp }
                if not f.round.started { break }
            }
            if f.round.started and f.round.timer_ms >= f.round.length_ms {
                end_round{ &w, id, script = true }
            }
        }
        let o3 = world::object{ w = &w, id } ifnull { return }
        let c3 = obj::creature{ o = o3 } ifnull { return }
        if c3.dead { return }
        // Held in a crowd-control state: its looping animation (a stunned creature keeps its stance).
        if f.c.stats.state != 0 {
            let row = state_row{ beast = is_beast{ w = &w, c = c3 }, state = f.c.stats.state }
            if row >= 0 and row_of_animation{ id = o3.animation } != row { world::set_animation{ o = o3, id = animname::ROW_BASE + @as(u32, row), speed = 1.0 } }
            if row >= 0 { return }
        }
        // Combat state times out 8 s after the last hostile act.
        if f.combat_ms > 0 {
            f.combat_ms = f.combat_ms - dt
            if f.combat_ms <= 0 and not f.round.started {
                f.combat_ms = 0
                c3.in_combat = false
                c3.attack_target = obj::INVALID
            }
        }
        if f.react_ms > 0 { f.react_ms = f.react_ms - dt }
        if f.voice_ms > 0 { f.voice_ms = f.voice_ms - dt }
        if f.ready_ms > 0 { f.ready_ms = f.ready_ms - dt }
        // Back to the ready stance (in combat) or standing when an attack or reaction is over.
        let busy = (f.round.started and f.round.timer_ms < f.round.anim_ms) or action_holds_animation{ o = o3 }
        if not busy and f.react_ms <= 0 and not c3.moving and row_of_animation{ id = o3.animation } >= 0 {
            if c3.in_combat or f.ready_ms > 0 { play_ready{ &w, o = o3, c = c3 } } else { world::set_animation{ o = o3, id = obj::ANIM_STAND, speed = 1.0 } }
        } else if c3.in_combat and not c3.moving and o3.animation == obj::ANIM_STAND {
            play_ready{ &w, o = o3, c = c3 }
        }
    }

    // Whether the head of the queue plays an animations.2da row of its own, which this must not
    // end as it ends an attack's: OPENLOCK and LOCK kneel at the lock for 1.5 s (doors.ctx).
    fn action_holds_animation { o: *obj::Object } -> bool {
        if o.actions.len == 0 { return false }
        let head = list::items{ list = o.actions }[0]
        return (head.kind == actions::Kind::open_lock or head.kind == actions::Kind::lock) and head.phase >= 2
    }

    fn play_ready { mut w: world::World, o: *mut obj::Object, c: *obj::Creature } {
        let row = ready_row{ s = stance{ w = &w, c } }
        if row_of_animation{ id = o.animation } == row { return }
        world::set_animation{ o, id = animname::ROW_BASE + @as(u32, row), speed = 1.0 }
    }

    // ---- the party's downed members (UpdatePartyDeath 0x004b6da0, once per tick)

    // The clocks of UpdatePartyDeath: the once-a-second scan for hostiles, and how long the party
    // has had someone down with no hostile creature seeing any member.
    struct PartyWatch { scan_ms: i32, calm_ms: i32 }

    fn new_party_watch {} -> PartyWatch { return PartyWatch{ scan_ms = 0, calm_ms = 0 } }

    // Whether a party member is down (GetIsDying: in the party, hit points below 1).
    fn is_down { w: *world::World, id: u32 } -> bool {
        let o = world::object{ w, id } ifnull { return false }
        if o.kind != obj::Kind::creature { return false }
        return o.hp < 1 and party::is_member{ w, id }
    }

    // Whether a creature is still getting up off the floor (the get-up of a revival).
    fn getting_up { w: *world::World, id: u32 } -> bool {
        let o = world::object{ w, id } ifnull { return false }
        let f = of{ o } ifnull { return false }
        if f.react_ms <= 0 { return false }
        let row = row_of_animation{ id = o.animation }
        return row == ROW_GETUP or row == ROW_GETUP1
    }

    fn first_member_up { w: *world::World } -> u32 {
        let members = party::members{ w }
        let mut k: usize = 0
        while k < members.len {
            if not is_down{ w, id = members[k] } { return members[k] }
            k = k + 1
        }
        return obj::INVALID
    }

    // Whether a living creature outside the party, hostile to the party, sees one of its members
    // (CSWSCreature::IsPerceivingPartyMember: a seen perception entry of a party member).
    fn hostile_sees_party { w: *world::World } -> bool {
        let pc = world::object{ w, id = party::leader{ w } } ifnull { return false }
        let all = list::items{ list = w.objects.all }
        let mut i: usize = 0
        while i < all.len {
            let o = all[i]
            i = i + 1
            if o.kind != obj::Kind::creature or o.area != w.area or o.destroyed { continue }
            let c = obj::creature{ o } ifnull { continue }
            if c.dead or party::is_member{ w, id = o.id } { continue }
            if world::standing{ w, from = o.faction, toward = pc.faction } >= 11 { continue }
            let seen = list::items{ list = c.perceived }
            let mut k: usize = 0
            while k < seen.len {
                if seen[k].seen and party::is_member{ w, id = seen[k].id } { return true }
                k = k + 1
            }
        }
        return false
    }

    // The movement-rate factor the creature's speed effects give (Burst of Speed and the other
    // hastes above 1, Slow and the speed decreases below; the rules clamp it to 0.125 .. 1.5).
    fn speed_scale { o: *obj::Object } -> f32 {
        let f = of{ o } ifnull { return 1.0 }
        if not f.loaded { return 1.0 }
        return f.c.stats.speed_factor
    }

    // While a member is down, once 5 s pass with no hostile creature seeing any member (checked
    // once a second), every downed member gets up with 1 hit point (a RESURRECTION effect). The
    // whole party down is the end of the game (play's party_fallen).
    fn update_party { mut w: world::World } {
        let dt = @as(i32, w.clock.dt * 1000.0)
        if dt <= 0 or w.transition != null or w.arrival > 0 { return }
        let mut ids: [3]u32 = [obj::INVALID; 3]
        let members = party::members{ w = &w }
        let n = if members.len < 3 { members.len } else { 3 }
        let mut k: usize = 0
        let mut any = false
        let mut all = n > 0
        while k < n {
            ids[k] = members[k]
            if is_down{ w = &w, id = ids[k] } { any = true } else { all = false }
            k = k + 1
        }
        if all { return }
        if not any {
            w.party_watch.calm_ms = 0
            return
        }
        w.party_watch.scan_ms = w.party_watch.scan_ms + dt
        if w.party_watch.scan_ms > 1000 {
            w.party_watch.scan_ms = 0
            if hostile_sees_party{ w = &w } {
                w.party_watch.calm_ms = 0
                return
            }
        }
        w.party_watch.calm_ms = w.party_watch.calm_ms + dt
        if w.party_watch.calm_ms <= 5000 { return }
        w.party_watch.calm_ms = 0
        k = 0
        while k < n {
            let id = ids[k]
            k = k + 1
            if not is_down{ w = &w, id } { continue }
            let mut e = rules::fx::make_resurrection{}
            rules::fx::set_creator{ e = &e, creator = id, spell_id = -1 }
            _ = apply{ &w, target = id, e }
            if world::object{ w = &w, id } is some{ value = o } {
                if of{ o } is some{ value = f } {
                    f.dying_ms = 0
                    sync_flags{ w = &w, o, f }
                }
            }
            if w.log.combat {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "{} gets up\n", id)
            }
        }
    }

    // ---- Force powers (actions.md 3.13, rules.md "Force powers")

    // CSWSCreature::GetSpellRange (actions.md 3.13): ranges.2da's PrimaryRange of the spell's Range
    // letter (P and T touch 2.25, S 10, M 15, L 28, W the short weapon range) plus the caster's
    // personal space and the target's, each less 0.1.
    fn spell_range { w: *world::World, spell: i32, caster: *obj::Object, target: u32 } -> f32 {
        let r = twoda::get_string{ t = w.tables.spells, row = @as(usize, spell), column = "range" } ifnull ""
        let row: usize = if r.len == 0 { 1 } else if r[0] == 'P' or r[0] == 'T' { 1 } else if r[0] == 'S' { 2 } else if r[0] == 'M' { 3 } else if r[0] == 'L' { 4 } else if r[0] == 'W' { 5 } else { 2 }
        let base = twoda::get_float{ t = w.tables.ranges, row, column = "primaryrange" } ifnull 10.0
        let mut mine: f32 = 0.0
        if obj::creature{ o = caster } is some{ value = c } { mine = c.perspace - 0.1 }
        let mut theirs: f32 = 0.0
        if world::object{ w, id = target } is some{ value = t } {
            if obj::creature{ o = t } is some{ value = tc } { theirs = tc.perspace - 0.1 }
        }
        return base + mine + theirs
    }

    // The animation rows of a spells.2da conjure or cast animation name (ours: the client's
    // mapping was not read): hand and self cast out with the first set, dark the second, up the
    // third, throw the sabre throw.
    fn cast_row { name: []u8, looping: bool } -> i32 {
        if name.len == 0 { return NO_ROW }
        if ci::eq{ a = name, b = "dark" } { return if looping { 65 } else { 64 } }
        if ci::eq{ a = name, b = "up" } { return if looping { 67 } else { 66 } }
        if ci::eq{ a = name, b = "throw" } { return if looping { 70 } else { 69 } }
        return if looping { 63 } else { 62 }
    }

    // CASTSPELL (0xf, actions.md 3.13): params 0 spell, 1 target, 2 location, 3 cheat, 4 instant,
    // 5 feat talent, 6 item. Walks into the power's range, faces the target and conjures (phase 1,
    // `conj` ms). At the end of the conjuration the Force points are paid (item and feat talents pay
    // nothing; an entangled caster loses them and the cast breaks), the cast animation starts and
    // the impact script runs at once: nothing of the Force powers flies (spells.2da Proj is 0 for
    // them; only grenades have a flight), so the effect lands at that moment and the cast animation
    // plays out after it (phase 2, `cast` ms), then the catch time (phase 3).
    fn cast_spell { mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, id: u32, a: *mut actions::Action } -> actions::Status {
        let o = world::object{ w = &w, id } ifnull { return actions::Status::failed }
        let spell = actions::int_param{ a, i = 0 }
        let target = actions::object_param{ a, i = 1 }
        let mut at = actions::vector_param{ a, i = 2 }
        if target != obj::INVALID {
            let t = world::object{ w = &w, id = target } ifnull { return actions::Status::failed }
            at = t.position
        }
        let now = clock::now_ms{ c = w.clock }
        let free = actions::int_param{ a, i = 3 } != 0 or actions::int_param{ a, i = 5 } != 0 or actions::object_param{ a, i = 6 } != obj::INVALID
        if a.phase == 0 {
            // In range first (creatures walk; others cast from where they are).
            if o.kind == obj::Kind::creature and target != id {
                let range = spell_range{ w = &w, spell, caster = o, target }
                if doors::distance_2d{ a = o.position, b = at } > range + 0.5 {
                    if a.serial > 0 and a.started + 20000 < now { return actions::Status::failed }
                    let mut copy = a.*
                    copy.has_started = true
                    actions::add_front{ &w, id, action = copy }
                    let mut move = actions::make{ kind = actions::Kind::move_to_point }
                    move.params[0] = actions::Param::vector{ v = at }
                    move.params[1] = actions::Param::int{ v = 1 }
                    move.params[2] = actions::Param::float{ v = range }
                    move.params[3] = actions::Param::object{ id = target }
                    move.params[4] = actions::Param::float{ v = 8.0 }
                    actions::add_front{ &w, id, action = move }
                    a.params = [actions::Param::none; 8]
                    return actions::Status::done
                }
            }
            // The action fails at once when the caster is dead or its equipment forbids the power
            // (the Force points are paid later, at the end of the conjuration).
            if of{ o } is some{ value = f } {
                sync_flags{ w = &w, o, f }
                let alive = if obj::creature{ o } is some{ value = c } { not c.dead } else { true }
                let reason = rules::can_cast_spell{ tables = w.rules, c = &f.c, spell, alive, from_item = free }
                if reason != rules::cast::OK and reason != rules::cast::ENTANGLED {
                    if w.log.combat {
                        world::prefix{ w = &w }
                        _ = @fmt(&w.io, "{} cannot cast {}: reason {}\n", id, spell, reason)
                    }
                    return actions::Status::failed
                }
            }
            // An item's ability needs the item (it is spent at the impact, below).
            let used = actions::object_param{ a, i = 6 }
            if used != obj::INVALID and not world::is_valid{ w = &w, id = used } { return actions::Status::failed }
            let dir = math::vec3::sub{ a = at, b = o.position }
            if dir.x * dir.x + dir.y * dir.y > 0.0001 { world::set_orientation{ o, v = math::Vec3{ x = dir.x, y = dir.y, z = 0.0 } } }
            if obj::creature{ o } is some{ value = c } {
                if target != obj::INVALID and target != id {
                    c.last_hostile_target = target
                    if world::object{ w = &w, id = target } is some{ value = t } {
                        if t.kind == obj::Kind::creature and world::standing{ w = &w, from = o.faction, toward = t.faction } <= 10 {
                            enter_combat{ &w, id, other = target }
                            enter_combat{ &w, id = target, other = id }
                        }
                    }
                }
                c.last_force_power = spell
            }
            if used != obj::INVALID {
                play_item_use{ &w, o, item = used, near = doors::distance_2d{ a = o.position, b = at } < 10.0 }
            } else {
                let conj = twoda::get_string{ t = w.tables.spells, row = @as(usize, spell), column = "conjanim" } ifnull ""
                play_row{ &w, o, row = cast_row{ name = conj, looping = true } }
            }
            spell_visuals{ &w, id, spell, cast = false }
            a.phase = 1
            a.started = now
            if w.log.combat {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "{} conjures {} at {}\n", id, spell, target)
            }
        }
        let times = rules::spell_phase_times{ tables = w.rules, spell }
        let instant = actions::int_param{ a, i = 4 } != 0
        // An item's ability has its own timing by kind of item (actions.md 3.13, ITEMCASTSPELL): the
        // impact lands part way through a 1.5 s action, and the item's use is spent with it.
        let used_item = actions::object_param{ a, i = 6 }
        let by_item = used_item != obj::INVALID
        let item_ms = item_cast_ms{ w = &w, item = used_item, near = doors::distance_2d{ a = o.position, b = at } < 10.0 }
        let conj_ms = if instant or by_item { 0 } else { @as(u64, @as(u32, if times.conj_ms > 0 { times.conj_ms } else { 0 })) }
        let cast_ms = if instant { 0 } else if by_item { item_ms.impact } else { @as(u64, @as(u32, if times.cast_ms > 0 { times.cast_ms } else { 0 })) }
        let catch_ms = if instant { 0 } else if by_item { item_ms.total - item_ms.impact } else { @as(u64, @as(u32, if times.catch_ms > 0 { times.catch_ms } else { 0 })) }
        let elapsed = clock::elapsed_since{ now, then = a.started }
        if a.phase == 1 {
            if elapsed < conj_ms { return actions::Status::running }
            // The first frame past the conjuration: pay, then cast and let the power land.
            if of{ o } is some{ value = f } {
                sync_flags{ w = &w, o, f }
                let alive = if obj::creature{ o } is some{ value = c } { not c.dead } else { true }
                let start = rules::begin_cast{ tables = w.rules, c = &f.c, spell, alive, from_item = free }
                if start.reason != rules::cast::OK and start.reason != rules::cast::ENTANGLED {
                    if w.log.combat {
                        world::prefix{ w = &w }
                        _ = @fmt(&w.io, "{} cannot pay for {}: reason {}\n", id, spell, start.reason)
                    }
                    return actions::Status::failed
                }
                if w.log.combat and start.paid {
                    world::prefix{ w = &w }
                    _ = @fmt(&w.io, "{} pays {} Force points for {} ({} left)\n", id, rules::force_point_cost{ tables = w.rules, c = &f.c, spell }, spell, f.c.fp)
                }
                if start.interrupted { return actions::Status::failed }
            }
            if not by_item {
                let anim = twoda::get_string{ t = w.tables.spells, row = @as(usize, spell), column = "castanim" } ifnull ""
                let back = world::object{ w = &w, id } ifnull { return actions::Status::failed }
                play_row{ &w, o = back, row = cast_row{ name = anim, looping = false } }
            }
            spell_visuals{ &w, id, spell, cast = true }
            if w.log.combat {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "{} casts {} at {}\n", id, spell, target)
            }
            // A Force power lands as the cast animation starts (an item's ability a moment later, below).
            if not by_item { impact{ &w, &vm, engine, id, spell, target, at } }
            a.phase = 2
        }
        if a.phase == 2 {
            if elapsed < conj_ms + cast_ms { return actions::Status::running }
            if by_item {
                impact{ &w, &vm, engine, id, spell, target, at }
                rt_item::spend_use{ &w, item = used_item, spell }
            }
            a.phase = 3
        }
        if elapsed < conj_ms + cast_ms + catch_ms { return actions::Status::running }
        // The cast was a combat round: OnEndRound gets the AI's next move; the player's own
        // creature goes on with the fight.
        if world::object{ w = &w, id } is some{ value = done_o } {
            if obj::creature{ o = done_o } is some{ value = c } {
                if c.in_combat and not c.dead and id != w.pc {
                    events::post{ &w, delay_ms = 0, caller = id, target = id, payload = events::Payload::script{ e = events::script_event{ kind = events::END_COMBAT_ROUND, object = target } } }
                }
                if c.in_combat { play_ready{ &w, o = done_o, c } } else { world::set_animation{ o = done_o, id = obj::ANIM_STAND, speed = 1.0 } }
                if id == party::leader{ w = &w } and done_o.actions.len == 0 and is_live_enemy{ w = &w, who = done_o, target } {
                    resume_attack{ &w, id, target }
                }
            }
        }
        return actions::Status::done
    }

    // Whether `target` is a live creature hostile to `who`.
    fn is_live_enemy { w: *world::World, who: *obj::Object, target: u32 } -> bool {
        let t = world::object{ w, id = target } ifnull { return false }
        let tc = obj::creature{ o = t } ifnull { return false }
        if tc.dead { return false }
        if tc.fighter is some{ value = tf } { if tf.c.down { return false } }
        return world::standing{ w, from = who.faction, toward = t.faction } <= 10
    }

    // After a cast the player's creature turns back to the fight (the original's client keeps an
    // attack on the target going; ours: the combat round of the cast ends, then the attack).
    fn resume_attack { mut w: world::World, id: u32, target: u32 } {
        let mut a = actions::make{ kind = actions::Kind::attack_object }
        a.params[0] = actions::Param::object{ id = target }
        _ = actions::add{ &w, id, action = a, force = false }
    }

    struct ItemTimes { impact: u64, total: u64 }

    // When an item's ability lands and when its action ends, by the base item's ItemType (actions.md 3.13,
    // AIActionItemCastSpell): grenades 700 ms (800 when thrown from 10 m or more) of 1.5 s, droid utility
    // devices 300 of 1.5 s, forearm shields 600 of 1 s, stims, repair kits and medpacs 750 of 1.5 s, the
    // squad recovery kit 750 of 1.5 s; the rest land at once.
    fn item_cast_ms { w: *world::World, item: u32, near: bool } -> ItemTimes {
        let kind = rt_item::item_type_of{ w, id = item }
        if kind == 6 { return ItemTimes{ impact = if near { 700 } else { 800 }, total = 1500 } }
        if kind == 12 { return ItemTimes{ impact = 300, total = 1500 } }
        if kind == 20 { return ItemTimes{ impact = 600, total = 1000 } }
        if kind == 25 or kind == 26 or kind == 45 or kind == 47 { return ItemTimes{ impact = 750, total = 1500 } }
        return ItemTimes{ impact = 1, total = 1500 }
    }

    // The animation of using an item: the injection for stims, repair kits and medpacs, the throw
    // for a grenade (the short one from under 10 m), the device's activation for the rest.
    fn play_item_use { mut w: world::World, o: *mut obj::Object, item: u32, near: bool } {
        let kind = rt_item::item_type_of{ w = &w, id = item }
        if kind == 6 { play_row{ &w, o, row = if near { 57 } else { 58 } }; return }
        if kind == 25 or kind == 26 or kind == 45 { world::set_animation{ o, id = 10070, speed = 1.0 }; return }
        world::set_animation{ o, id = 10127, speed = 1.0 }
    }

    // The impact: the power's script (spells.2da impactscript) as the caster, with the spell
    // context set on it and the target told who cast what at it.
    fn impact { mut w: world::World, mut vm: nwvm::Vm, engine: nwvm::Engine, id: u32, spell: i32, target: u32, at: math::Vec3 } {
        let name = twoda::get_string{ t = w.tables.spells, row = @as(usize, spell), column = "impactscript" } ifnull ""
        if world::object{ w = &w, id = target } is some{ value = t } {
            t.ctx.last_spell = spell
            t.ctx.last_spell_caster = id
        }
        let o = world::object{ w = &w, id } ifnull { return }
        o.ctx.spell_id = spell
        o.ctx.spell_target = target
        o.ctx.spell_location = at
        if name.len > 0 and not ci::eq{ a = name, b = "****" } {
            _ = scripts::run{ &w, &vm, engine, name = resref::truncate{ name }, self = id }
        }
        if world::object{ w = &w, id } is some{ value = back } {
            back.ctx.spell_id = -1
            back.ctx.spell_target = obj::INVALID
        }
    }

    // ---- the end

    // Whether the whole party is down or dead (the original's death camera and "Your entire party
    // has been killed", strref 42351; combat.md 12 leaves the code unread).
    fn party_fallen { w: *world::World } -> bool {
        let members = party::members{ w }
        if members.len == 0 { return false }
        let mut k: usize = 0
        while k < members.len {
            let o = world::object{ w, id = members[k] } ifnull { return false }
            k = k + 1
            let c = obj::creature{ o } ifnull { return false }
            if c.dead { continue }
            let f = c.fighter ifnull { return false }
            if not f.c.down and o.hp >= 1 { return false }
        }
        return true
    }

    // SpawnBodyBag (combat.md 8.4): a dead creature being destroyed leaves a placeable with what
    // it drops (its own droppable items, carried or worn) when it has any, or when its
    // bodybag.2da row is a corpse; the row is the creature's appearance's BODY_BAG.
    fn spawn_body_bag { mut w: world::World, id: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        if not c.dead or party::is_member{ w = &w, id } { return }
        // What drops.
        let mut drops: [64]u32 = [obj::INVALID; 64]
        let mut n: usize = 0
        let carried = list::items{ list = c.inventory }
        let mut k: usize = 0
        while k < carried.len and n < 64 {
            if droppable{ w = &w, item = carried[k] } {
                drops[n] = carried[k]
                n = n + 1
            }
            k = k + 1
        }
        k = 0
        while k < obj::EQUIP_SLOTS and n < 64 {
            let item = c.equipped[k]
            if item != obj::INVALID and droppable{ w = &w, item } {
                drops[n] = item
                n = n + 1
                c.equipped[k] = obj::INVALID
            }
            k = k + 1
        }
        let row = twoda::get_int{ t = w.tables.appearance, row = @as(usize, c.appearance), column = "body_bag" } ifnull 0
        let corpse = (twoda::get_int{ t = w.tables.bodybag, row = @as(usize, row), column = "corpse" } ifnull 0) != 0
        if n == 0 and not corpse { return }
        let look = twoda::get_int{ t = w.tables.bodybag, row = @as(usize, row), column = "appearance" } ifnull 0
        let name = twoda::get_int{ t = w.tables.bodybag, row = @as(usize, row), column = "name" } ifnull 38151
        let at = o.position
        let facing = o.orientation
        let bag = world::add_object{ &w, kind = obj::Kind::placeable, id = 0, character = false } iferr { return }
        bag.area = w.area
        bag.position = at
        world::set_orientation{ o = bag, v = facing }
        world::set_name{ &w, name = &bag.name, strref = @as(u32, name), text = "" } iferr {}
        bag.plot = not corpse
        let bag_id = bag.id
        if obj::placeable{ o = bag } is some{ value = p } {
            p.appearance = @as(u32, look)
            p.useable = true
            p.has_inventory = true
            let model = twoda::get_string{ t = w.tables.placeables, row = @as(usize, look), column = "modelname" } ifnull ""
            p.model = resref::truncate{ name = model }
            k = 0
            while k < n {
                let item = drops[k]
                k = k + 1
                list::push{ list = &p.inventory, item } iferr { continue }
                if world::object{ w = &w, id = item } is some{ value = io } {
                    if obj::item{ o = io } is some{ value = it } {
                        it.possessor = bag_id
                        it.equipped_slot = -1
                    }
                }
            }
        }
        // Its items are the bag's now: the creature lets go of them.
        if world::object{ w = &w, id } is some{ value = back } {
            if obj::creature{ o = back } is some{ value = bc } {
                let mut keep = list::new(u32, heap::Heap){ realloc = heap::alloc, heap = w.heap }
                let own = list::items{ list = bc.inventory }
                k = 0
                while k < own.len {
                    if not droppable{ w = &w, item = own[k] } { list::push{ list = &keep, item = own[k] } iferr {} }
                    k = k + 1
                }
                list::free{ list = &bc.inventory }
                bc.inventory = keep
            }
        }
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "{} leaves a body bag {} with {} items\n", id, bag_id, n)
        }
    }

    fn droppable { w: *world::World, item: u32 } -> bool {
        let io = world::object{ w, id = item } ifnull { return false }
        let it = obj::item{ o = io } ifnull { return false }
        return it.droppable
    }

    // A creature stops fighting (surrender, CancelCombat): its round ends without OnEndRound, its
    // actions and targets are cleared, it leaves combat; with `others` everyone attacking it stops.
    fn stop_fighting { mut w: world::World, id: u32, others: bool } {
        end_round{ &w, id, script = false }
        actions::clear_all{ &w, id }
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        c.in_combat = false
        c.attack_target = obj::INVALID
        c.attempted_target = obj::INVALID
        if c.fighter is some{ value = f } { f.combat_ms = 0 }
        if others { clear_attackers{ &w, id } }
    }
}
