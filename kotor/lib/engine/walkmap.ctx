// The area's walkable surface (docs/re/movement.md 3.5): one walkmesh per LYT room, in LYT order
// (the order GetRoomAtPoint tries them), plus the placed walkmeshes of doors (DWK) and
// placeables (PWK) that block while they are active. Walkmeshes live in module memory.
//
//   let f = walkmap::floor{ m = &w.walk, x, y, z } ifnull { ... }       // Floor{ room, face, z }
//   let z = walkmap::step_to{ m = &w.walk, from, to } ifnull { blocked }
namespace walkmap {
    // How far up a floor may be from where a creature stands and still be stepped onto, and how
    // far down it may drop (ours: the original follows face adjacency instead, movement.md 3.5).
    const STEP_UP: f32 = 0.6
    const STEP_DOWN: f32 = 1.5
    // Spacing of the samples along a step.
    const SAMPLE: f32 = 0.15

    struct Room { name: resref::ResRef, position: math::Vec3, mesh: ?bwm::Walkmesh }

    struct Placed { owner: u32, mesh: bwm::Walkmesh, active: bool, door: bool }

    // The bounds of a placed walkmesh's vertices: a point or a step far from them cannot meet any of its faces.
    struct Box { lo: math::Vec3, hi: math::Vec3 }

    struct Map {
        rooms: list::List(Room, heap::Heap),
        placed: list::List(Placed, heap::Heap),
        boxes: list::List(Box, heap::Heap),     // one per placed walkmesh, in the same order
        walkable: []mut bool,               // by surface material: surfacemat.2da Walk
        sees: []mut bool,                   // by surface material: surfacemat.2da LineOfSight; true means a face of it blocks sight
        grass: []mut bool,                  // by surface material: surfacemat.2da Grass (grass is drawn on it, lib/scene/grass.ctx)
    }

    struct Floor { room: i32, face: u32, z: f32 }

    fn empty { heap: *mut heap::Heap } -> Map {
        return Map{
            rooms = list::new(Room, heap::Heap){ realloc = heap::alloc, heap },
            placed = list::new(Placed, heap::Heap){ realloc = heap::alloc, heap },
            boxes = list::new(Box, heap::Heap){ realloc = heap::alloc, heap },
            walkable = slice::empty(bool){}, sees = slice::empty(bool){}, grass = slice::empty(bool){},
        }
    }

    // The material tables from surfacemat.2da (kept in the session heap).
    fn load_materials { mut m: Map, heap: *mut heap::Heap, table: twoda::Table } -> ! {
        let n = twoda::rows{ t = table }
        m.walkable = try alloc::resize(bool, heap::Heap){ realloc = heap::alloc, heap, mem = slice::empty(bool){}, count = n }
        m.sees = try alloc::resize(bool, heap::Heap){ realloc = heap::alloc, heap, mem = slice::empty(bool){}, count = n }
        m.grass = try alloc::resize(bool, heap::Heap){ realloc = heap::alloc, heap, mem = slice::empty(bool){}, count = n }
        let mut i: usize = 0
        while i < n {
            m.walkable[i] = (twoda::get_int{ t = table, row = i, column = "walk" } ifnull 0) != 0
            m.sees[i] = (twoda::get_int{ t = table, row = i, column = "lineofsight" } ifnull 1) != 0
            m.grass[i] = (twoda::get_int{ t = table, row = i, column = "grass" } ifnull 0) != 0
            i = i + 1
        }
    }

    // Forgets the rooms and placed walkmeshes (their memory is the module arena's).
    fn clear { mut m: Map } {
        list::clear{ list = &m.rooms }
        list::clear{ list = &m.placed }
        list::clear{ list = &m.boxes }
    }

    fn add_room { mut m: Map, room: Room } -> ! { try list::push{ list = &m.rooms, item = room } }

    // Adds a placed walkmesh (already in area space); its index.
    fn add_placed { mut m: Map, placed: Placed } -> !i32 {
        try list::push{ list = &m.boxes, item = box_of{ mesh = &placed.mesh } }
        list::push{ list = &m.placed, item = placed } iferr err{ error } {
            m.boxes.len = m.boxes.len - 1
            return error
        }
        return @as(i32, m.placed.len - 1)
    }

    fn box_of { mesh: *bwm::Walkmesh } -> Box {
        let mut lo = math::Vec3{ x = 1000000000.0, y = 1000000000.0, z = 1000000000.0 }
        let mut hi = math::Vec3{ x = -1000000000.0, y = -1000000000.0, z = -1000000000.0 }
        let mut i: usize = 0
        while i < mesh.vertices.len {
            let v = mesh.vertices[i]
            lo = math::Vec3{ x = math::min{ a = lo.x, b = v.x }, y = math::min{ a = lo.y, b = v.y }, z = math::min{ a = lo.z, b = v.z } }
            hi = math::Vec3{ x = math::max{ a = hi.x, b = v.x }, y = math::max{ a = hi.y, b = v.y }, z = math::max{ a = hi.z, b = v.z } }
            i = i + 1
        }
        return Box{ lo, hi }
    }

    fn set_active { mut m: Map, index: i32, active: bool } {
        if index < 0 or @as(usize, index) >= m.placed.len { return }
        list::items{ list = m.placed }[@as(usize, index)].active = active
    }

    // The highest walkable floor under (x, y) no higher than z + STEP_UP, searching the rooms in
    // LYT order (the first room with a floor there wins, as GetRoomAtPoint).
    fn floor { m: *Map, x: f32, y: f32, z: f32 } -> ?Floor {
        let rooms = list::items{ list = m.rooms }
        let mut best: ?Floor = null
        let mut i: usize = 0
        while i < rooms.len {
            let mesh = rooms[i].mesh
            i = i + 1
            if mesh == null { continue }
            let f = bwm::find_face_under{ w = mesh, x, y, z, step = STEP_UP, walkable = m.walkable } ifnull { continue }
            let better = match best { null => { true } some{ value } => { f.z > value.z } }
            if better { best = Floor{ room = @as(i32, i - 1), face = f.face, z = f.z } }
        }
        return best
    }

    // Any floor at all under (x, y), from high up: for placing objects whose z is unknown.
    fn floor_anywhere { m: *Map, x: f32, y: f32 } -> ?Floor { return floor{ m, x, y, z = 1000.0 } }

    // The height under (x, y) near z, or null off the walkmesh.
    fn height { m: *Map, x: f32, y: f32, z: f32 } -> ?f32 {
        let f = floor{ m, x, y, z } ifnull { return null }
        return f.z
    }

    // The room index (LYT order) under (x, y), -1 for none.
    fn room_at { m: *Map, x: f32, y: f32, z: f32 } -> i32 {
        let f = floor{ m, x, y, z } ifnull { return -1 }
        return f.room
    }

    // Whether an active placed walkmesh (a closed door, a placeable) has a face that doesn't let
    // anyone walk over (x, y) at about height z.
    fn blocked { m: *Map, x: f32, y: f32, z: f32 } -> bool {
        let placed = list::items{ list = m.placed }
        let boxes = list::items{ list = m.boxes }
        let mut i: usize = 0
        while i < placed.len {
            let p = &placed[i]
            let b = boxes[i]
            i = i + 1
            if not p.active { continue }
            // over_blocking_face's own tests, on the whole mesh's bounds first (most are far away).
            if x < b.lo.x - BOX_SLACK or x > b.hi.x + BOX_SLACK or y < b.lo.y - BOX_SLACK or y > b.hi.y + BOX_SLACK { continue }
            if b.hi.z < z - 0.5 or b.lo.z > z + 2.0 { continue }
            if over_blocking_face{ w = &p.mesh, walkable = m.walkable, x, y, z, mesh_lo = b.lo.z, mesh_hi = b.hi.z } { return true }
        }
        return false
    }

    // More than the face test's own slack (bwm EDGE_SLACK), so a bounds test never rejects what it would accept.
    const BOX_SLACK: f32 = 0.01

    // The original sweeps a door's or placeable's walkmesh through all heights (TestSegmentAgainstObjects, movement.md 4.4),
    // so a face blocks by where it stands on the floor plan; the heights count for the mesh as a whole (mesh_lo, mesh_hi):
    // a closed Star Forge door is a box that reaches from below the floor to above a head, and none of its flat faces is
    // within a walker's height (a per-face test let everyone through it).
    fn over_blocking_face { w: *bwm::Walkmesh, walkable: []bool, x: f32, y: f32, z: f32, mesh_lo: f32, mesh_hi: f32 } -> bool {
        if mesh_hi < z - 0.5 or mesh_lo > z + 2.0 { return false }
        let mut f: usize = 0
        while f < w.faces.len {
            let face = f
            f = f + 1
            if w.flat[face] { continue }
            let mat = w.materials[face]
            if mat < walkable.len and walkable[mat] { continue }
            let c = bwm::face_corners{ w = w.*, face }
            if bwm::is_over_triangle{ c, x, y } { return true }
        }
        return false
    }

    // Walks the straight segment from `from` to `to` (x, y; z follows the floor): the floor
    // height at `to`, or null if the walk leaves the walkmesh, climbs or drops too far, or meets
    // a blocking placed walkmesh.
    fn step_to { m: *Map, from: math::Vec3, to: math::Vec3 } -> ?f32 {
        return walk_segment{ m, from, to, spacing = SAMPLE, bridge = false }
    }

    // Whether the bounds of any active placeable's walkmesh (not a door's) meet those of the segment from (ax, ay)
    // to (bx, by): the cheap first question before meets_placeable's.
    fn placeable_near { m: *Map, ax: f32, ay: f32, bx: f32, by: f32 } -> bool {
        let placed = list::items{ list = m.placed }
        let boxes = list::items{ list = m.boxes }
        let lo_x = math::min{ a = ax, b = bx } - BOX_SLACK
        let hi_x = math::max{ a = ax, b = bx } + BOX_SLACK
        let lo_y = math::min{ a = ay, b = by } - BOX_SLACK
        let hi_y = math::max{ a = ay, b = by } + BOX_SLACK
        let mut b: usize = 0
        while b < placed.len {
            let box = boxes[b]
            if placed[b].active and not placed[b].door and box.hi.x >= lo_x and box.lo.x <= hi_x and box.hi.y >= lo_y and box.lo.y <= hi_y { return true }
            b = b + 1
        }
        return false
    }

    // Whether a straight walk from `from` to `to` meets an active placeable's walkmesh (a door's is left out: a
    // closed door is opened by whoever walks into it, movement.md 4.9, so a route may go through one). The
    // planner asks it of each edge of the path graph, which was authored without the placeables a script
    // creates later (Calo Nord's landspeeders on the camp road), and so would run a route into them. The same
    // blocking test as step_to's, at the same samples, but the floor is looked up only where a sample lies
    // inside a placeable's bounds, so an edge in the open costs one pass over the placed walkmeshes.
    fn meets_placeable { m: *Map, from: math::Vec3, to: math::Vec3 } -> bool {
        let placed = list::items{ list = m.placed }
        let boxes = list::items{ list = m.boxes }
        let lo_x = math::min{ a = from.x, b = to.x } - BOX_SLACK
        let hi_x = math::max{ a = from.x, b = to.x } + BOX_SLACK
        let lo_y = math::min{ a = from.y, b = to.y } - BOX_SLACK
        let hi_y = math::max{ a = from.y, b = to.y } + BOX_SLACK
        let mut near: [48]u32
        let mut near_count: usize = 0
        let mut b: usize = 0
        while b < placed.len {
            let box = boxes[b]
            if placed[b].active and not placed[b].door and box.hi.x >= lo_x and box.lo.x <= hi_x and box.hi.y >= lo_y and box.lo.y <= hi_y {
                // Past 48 near ones the rest are not asked (a crowd of placeables along one edge): the
                // mover's own steps still stop at them.
                if near_count < 48 {
                    near[near_count] = @as(u32, b)
                    near_count = near_count + 1
                }
            }
            b = b + 1
        }
        if near_count == 0 { return false }
        let dx = to.x - from.x
        let dy = to.y - from.y
        let len = math::sqrtf{ x = dx * dx + dy * dy }
        let n = if len <= SAMPLE { 1 } else { @as(u32, math::ceilf{ x = len / SAMPLE }) }
        let mut i: u32 = 0
        while i <= n {
            let t = @as(f32, i) / @as(f32, n)
            let x = from.x + dx * t
            let y = from.y + dy * t
            let mut inside = false
            let mut k: usize = 0
            while k < near_count {
                let box = boxes[@as(usize, near[k])]
                if x >= box.lo.x - BOX_SLACK and x <= box.hi.x + BOX_SLACK and y >= box.lo.y - BOX_SLACK and y <= box.hi.y + BOX_SLACK { inside = true }
                k = k + 1
            }
            if inside {
                // The height the mover would be at: the floor under the sample, else the straight line's.
                let hint = from.z + (to.z - from.z) * t
                let found = floor{ m, x, y, z = hint }
                let z = if found != null { found.z } else { hint }
                k = 0
                while k < near_count {
                    if over_blocking_face{ w = &placed[@as(usize, near[k])].mesh, walkable = m.walkable, x, y, z, mesh_lo = boxes[@as(usize, near[k])].lo.z, mesh_hi = boxes[@as(usize, near[k])].hi.z } { return true }
                    k = k + 1
                }
            }
            i = i + 1
        }
        return false
    }

    // A short step across a seam: the walkmeshes of two rooms can leave a gap of a few centimetres
    // between them, which a creature standing at its edge cannot enter and so never leaves (step_to
    // samples every SAMPLE and finds the gap with a short step but not with a long one). Like step_to,
    // with the samples a fifth as far apart, and a sample over no floor at all let by when a
    // floor follows: the far end must have one, and nothing may block on the way.
    fn step_across { m: *Map, from: math::Vec3, to: math::Vec3 } -> ?f32 {
        return walk_segment{ m, from, to, spacing = SAMPLE * 0.2, bridge = true }
    }

    fn walk_segment { m: *Map, from: math::Vec3, to: math::Vec3, spacing: f32, bridge: bool } -> ?f32 {
        let dx = to.x - from.x
        let dy = to.y - from.y
        let len = math::sqrtf{ x = dx * dx + dy * dy }
        let n = if len <= spacing { 1 } else { @as(u32, math::ceilf{ x = len / spacing }) }
        // The placed walkmeshes whose bounds the whole step can touch: the only ones its samples are
        // tested against (a long step in the open meets none).
        let placed = list::items{ list = m.placed }
        let boxes = list::items{ list = m.boxes }
        let lo_x = math::min{ a = from.x, b = to.x } - BOX_SLACK
        let hi_x = math::max{ a = from.x, b = to.x } + BOX_SLACK
        let lo_y = math::min{ a = from.y, b = to.y } - BOX_SLACK
        let hi_y = math::max{ a = from.y, b = to.y } + BOX_SLACK
        let mut near: [48]u32
        let mut near_count: usize = 0
        let mut too_many = false
        let mut b: usize = 0
        while b < placed.len {
            let box = boxes[b]
            if placed[b].active and box.hi.x >= lo_x and box.lo.x <= hi_x and box.hi.y >= lo_y and box.lo.y <= hi_y {
                if near_count < 48 {
                    near[near_count] = @as(u32, b)
                    near_count = near_count + 1
                } else {
                    too_many = true
                }
            }
            b = b + 1
        }
        let mut z = from.z
        let mut i: u32 = 1
        while i <= n {
            let t = @as(f32, i) / @as(f32, n)
            let x = from.x + dx * t
            let y = from.y + dy * t
            let found = floor{ m, x, y, z }
            let mut here_z = z
            if found != null {
                if found.z < z - STEP_DOWN { return null }
                here_z = found.z
            } else if not bridge or i == n {
                return null
            }
            if too_many {
                if blocked{ m, x, y, z = here_z } { return null }
            } else {
                let mut k: usize = 0
                while k < near_count {
                    if over_blocking_face{ w = &placed[@as(usize, near[k])].mesh, walkable = m.walkable, x, y, z = here_z, mesh_lo = boxes[@as(usize, near[k])].lo.z, mesh_hi = boxes[@as(usize, near[k])].hi.z } { return null }
                    k = k + 1
                }
            }
            z = here_z
            i = i + 1
        }
        return z
    }
}
