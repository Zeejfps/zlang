// Throw Lightsaber and its advanced form (EffectLightsaberThrow, rules.md 1.3; the apply handler
// 0x004de600): the caster's saber flies to up to three targets in turn and back, hitting each one when
// it arrives for one d6 per two levels of the caster, and always hitting. The handler schedules a
// damage effect and the saber's impact visual per target at the time the saber reaches it.
namespace fight {
    // The saber's speed in the air (ours: the original scales the whole trip to the power's cast time).
    const SABER_MS_PER_M: f32 = 75.0
    // The visualeffects.2da rows of the thrown saber's flight and its impact (VFX_IMP_MIRV_IMPACT).
    const VFX_SABER_IMPACT: i32 = 6001

    struct SaberThrow { active: bool, t_ms: i32, end_ms: i32, count: i32, target: [3]u32, hit_ms: [3]i32, hit: [3]bool, legs: i32 }

    fn no_saber {} -> SaberThrow {
        return SaberThrow{ active = false, t_ms = 0, end_ms = 0, count = 0, target = [obj::INVALID; 3], hit_ms = [0; 3], hit = [false; 3], legs = 0 }
    }

    // The effect has just been applied to the caster: work out when the saber reaches each target.
    fn start_saber_throw { mut w: world::World, id: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let f = c.fighter ifnull { return }
        let e = newest_effect{ f, kind = rules::fx::LIGHTSABER_THROW } ifnull { return }
        // The saber is in the right hand, or nothing flies.
        if c.equipped[obj::SLOT_RIGHT_WEAPON] == obj::INVALID { return }
        let mut s = no_saber{}
        let mut here = o.position
        let mut ms: f32 = 0.0
        let mut k: usize = 0
        while k < 3 {
            let tid = e.objects[k]
            k = k + 1
            let to = world::object{ w = &w, id = tid } ifnull { continue }
            ms = ms + doors::distance_2d{ a = here, b = to.position } * SABER_MS_PER_M
            s.target[@as(usize, s.count)] = tid
            s.hit_ms[@as(usize, s.count)] = @as(i32, ms)
            s.count = s.count + 1
            here = to.position
        }
        if s.count == 0 { return }
        s.end_ms = @as(i32, ms + doors::distance_2d{ a = here, b = o.position } * SABER_MS_PER_M)
        s.active = true
        f.saber = s
    }

    // A tick of the flight: whoever the saber has reached is hit.
    fn step_saber { mut w: world::World, o: *mut obj::Object, f: *mut Fighter, dt: i32 } {
        let s = &f.saber
        let held = (obj::creature{ o } ifnull { return }).equipped[obj::SLOT_RIGHT_WEAPON]
        // Each leg of the flight starts when the one before it ends: out to the targets, then back.
        while s.legs <= s.count {
            let leg = @as(usize, s.legs)
            let start = if s.legs == 0 { 0 } else { s.hit_ms[leg - 1] }
            if start > s.t_ms + dt { break }
            let end = if s.legs < s.count { s.hit_ms[leg] } else { s.end_ms }
            let mut from = o.position
            if s.legs > 0 { if world::object{ w = &w, id = s.target[leg - 1] } is some{ value = fo } { from = fo.position } }
            let mut to = o.position
            if s.legs < s.count { if world::object{ w = &w, id = s.target[leg] } is some{ value = to_o } { to = to_o.position } }
            let item = held
            outbox::post{ out = &w.out, note = outbox::Note::saber_leg{ item, from = math::Vec3{ x = from.x, y = from.y, z = from.z + 1.0 }, to = math::Vec3{ x = to.x, y = to.y, z = to.z + 1.0 }, flight_ms = end - start } }
            s.legs = s.legs + 1
        }
        s.t_ms = s.t_ms + dt
        let mut k: i32 = 0
        while k < s.count {
            let i = @as(usize, k)
            k = k + 1
            if s.hit[i] or s.hit_ms[i] > s.t_ms { continue }
            s.hit[i] = true
            let tid = s.target[i]
            let t = world::object{ w = &w, id = tid } ifnull { continue }
            visual_effect{ &w, effect = VFX_SABER_IMPACT, target = tid, source = o.id, position = t.position }
            let half = f.c.stats.level / 2
            let dice = if half < 1 { 1 } else { half }
            let amount = rules::roll_dice{ rng = &w.dice, count = dice, sides = 6 }
            let mut e = rules::fx::make_damage{ amount, types = rules::dmg::BLASTER, power = 0 }
            rules::fx::set_creator{ e = &e, creator = o.id, spell_id = -1 }
            _ = apply{ &w, target = tid, e }
            if w.log.combat {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "{}'s saber hits {} for {}\n", o.id, tid, amount)
            }
        }
        if s.t_ms >= s.end_ms { s.active = false }
    }
}
