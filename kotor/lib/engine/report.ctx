// The end-of-run report: script runs, faults, events, objects, and (with --report routines) the
// routines scripts called that no category implements, most-called first.
namespace report {
    fn summary { mut w: world::World, routines: bool } {
        _ = @fmt(&w.io, "run: {} frames, {} s of world time; {} script runs, {} faults, {} events, {} objects made, {} live\n",
            w.clock.frame, clock::now_ms{ c = w.clock } / 1000, w.stats.script_runs, w.stats.faults, w.stats.events,
            w.stats.objects_made, w.objects.all.len)
        let mut implemented: u32 = 0
        let mut missing: u32 = 0
        let mut i: usize = 0
        while i < 772 {
            if w.stats.calls[i] > 0 {
                if w.stats.missing[i] == 0 { implemented = implemented + 1 } else { missing = missing + 1 }
            }
            i = i + 1
        }
        _ = @fmt(&w.io, "routines called: {} implemented, {} missing\n", implemented, missing)
        party_fights{ &w }
        if not routines { return }
        stuck{ &w }
        // Missing routines by calls, most first (a selection sort over a copy of the counts).
        let mut counts = w.stats.missing
        while true {
            let mut best: usize = 772
            let mut j: usize = 0
            while j < 772 {
                if counts[j] > 0 and (best == 772 or counts[j] > counts[best]) { best = j }
                j = j + 1
            }
            if best == 772 { break }
            _ = @fmt(&w.io, "  missing {} {} x{}\n", best, nwscript::ROUTINES[best].name, counts[best])
            counts[best] = 0
        }
    }

    // A member of the party who made no attack round while the others made this many since it joined has sat out
    // the fights (a run of the Endar Spire where Trask watched; docs/testing.md, "Companions in a fight").
    const IDLE_AFTER_ROUNDS: u32 = 10

    // `party attack rounds: NAME N, ...` for the party at the end of the run, and a `companion idle:` line for each
    // member who sat out IDLE_AFTER_ROUNDS or more of the others' rounds.
    fn party_fights { mut w: world::World } {
        let team = party::members{ w = &w }
        if team.len < 2 { return }
        _ = @fmt(&w.io, "party attack rounds:")
        let mut i: usize = 0
        while i < team.len {
            if world::object{ w = &w, id = team[i] } is some{ value = o } {
                if obj::creature{ o } is some{ value = c } {
                    let mut name: []u8 = o.tag
                    if name.len == 0 { name = "player" }
                    if i > 0 { _ = @fmt(&w.io, ",") }
                    _ = @fmt(&w.io, " {} {}", name, w.stats.member_rounds[party::stat_slot{ w = &w, id = team[i] }])
                }
            }
            i = i + 1
        }
        _ = @fmt(&w.io, "\n")
        i = 0
        while i < team.len {
            if world::object{ w = &w, id = team[i] } is some{ value = o } {
                if obj::creature{ o } is some{ value = c } {
                    let slot = party::stat_slot{ w = &w, id = team[i] }
                    let own = w.stats.member_rounds[slot] - w.stats.member_joined_own[slot]
                    let others = w.stats.party_rounds - w.stats.member_joined[slot] - own
                    let mut name: []u8 = o.tag
                    if name.len == 0 { name = "player" }
                    if own == 0 and others >= IDLE_AFTER_ROUNDS { _ = @fmt(&w.io, "companion idle: {} made no attack round while the rest of the party made {} since it joined\n", name, others) }
                }
            }
            i = i + 1
        }
    }

    // Actions at the head of a queue that began more than STUCK_MS ago and are of a kind that should
    // soon be over (a walk, a door, a pick-up...), one line each: `stuck ID TAG ACTION-KIND SECONDS at X Y` (the same line, same place, a while later: stuck).
    // The kinds that run until told otherwise (random walk, follow, wait, dialogue, attack, ...) are not listed.
    const STUCK_MS: u64 = 20000

    fn stuck { mut w: world::World } {
        let now = clock::now_ms{ c = w.clock }
        let all = list::items{ list = w.objects.all }
        let mut i: usize = 0
        while i < all.len {
            let o = all[i]
            i = i + 1
            if o.destroyed or o.actions.len == 0 { continue }
            let a = list::items{ list = o.actions }[0]
            if not a.has_started or clock::elapsed_since{ now, then = a.started } < STUCK_MS { continue }
            let short = match a.kind {
                move_to_point | open_door | close_door | open_lock | lock | use_object | pickup_item | give_item | take_item | face_object | face_point | move_away_from_location | equip_item | unequip_item | drop_item => { true }
                else => { false }
            }
            if not short { continue }
            _ = @fmt(&w.io, "stuck {} {} {} {} at {} {}\n", o.id, o.tag, @as(u32, a.kind), clock::elapsed_since{ now, then = a.started } / 1000, o.position.x, o.position.y)
        }
    }
}
