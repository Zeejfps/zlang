// Routines: the player and the party (docs/re/party-items-saves.md, 3): who the party is, which
// companions exist (the NPC slots of party.ctx: available, selectable, in the party), and solo mode.
//
// An available slot keeps no creature while it is out of the area, as the original keeps only
// AVAILNPC<n>.utc: the party table remembers the blueprint (w.party.templates), and
// SpawnAvailableNPC makes the creature then, linking it to the slot (w.party.npcs). So
// AddAvailableNPCByTemplate only checks that the UTC exists; it spawns nothing, and nothing of the
// area is disturbed. A module change destroys the creatures; the slots stay available. When saves
// exist, SaveNPCState and the transitions write the creature's state where the blueprint is now.
// The purse is shared (party::add_gold): a joining NPC's own gold is merged into it.
namespace rt_party {
    fn run { mut w: world::World, mut vm: nwvm::Vm, routine: u16, argc: u8 } -> !bool {
        match routine {
            nwscript::GetFirstPC => { try nwvm::push_object{ &vm, id = if world::is_valid{ w = &w, id = w.player } { w.player } else { obj::INVALID } } }
            nwscript::GetNextPC => { try nwvm::push_object{ &vm, id = obj::INVALID } }
            nwscript::GetIsPC => { try get_is_pc{ &w, &vm, argc } }
            nwscript::GetPartyMemberByIndex => { try get_party_member_by_index{ &w, &vm, argc } }
            nwscript::IsObjectPartyMember => { try is_object_party_member{ &w, &vm, argc } }
            nwscript::GetPartyMemberCount => { try nwvm::push_int{ &vm, v = @as(i32, w.party.count) } }
            nwscript::GetPCSpeaker => { try nwvm::push_object{ &vm, id = w.player } }
            // ---- the party table
            nwscript::AddPartyMember => { try add_party_member{ &w, &vm, argc } }
            nwscript::RemovePartyMember => { try remove_party_member{ &w, &vm, argc } }
            nwscript::AddAvailableNPCByTemplate => { try add_available_by_template{ &w, &vm, argc } }
            nwscript::AddAvailableNPCByObject => { try add_available_by_object{ &w, &vm, argc } }
            nwscript::RemoveAvailableNPC => { try remove_available_npc{ &w, &vm, argc } }
            nwscript::IsAvailableCreature => { try is_available_creature{ &w, &vm, argc } }
            nwscript::SpawnAvailableNPC => { try spawn_available_npc{ &w, &vm, argc } }
            nwscript::SetAvailableNPCId => { try set_available_npc_id{ &w, &vm, argc } }
            nwscript::GetNPCSelectability => { try get_npc_selectability{ &w, &vm, argc } }
            nwscript::SetNPCSelectability => { try set_npc_selectability{ &w, &vm, argc } }
            nwscript::SaveNPCState => { try save_npc_state{ &w, &vm, argc } }
            nwscript::SwitchPlayerCharacter => { try switch_player_character{ &w, &vm, argc } }
            nwscript::SetSoloMode => { try set_solo_mode{ &w, &vm, argc } }
            nwscript::AddToParty => { try pc_party{ &w, &vm, argc, routine } }
            nwscript::RemoveFromParty => { try pc_party{ &w, &vm, argc, routine } }
            else => { return false }
        }
        return true
    }

    fn flag { b: bool } -> i32 { return if b { 1 } else { 0 } }

    // void AddToParty(object oPC, object oPartyLeader), void RemoveFromParty(object oPC): NWN's
    // multiplayer party, "only for two PCs" (nwscript.nss). There is one player character and its
    // companions are the party table's, so there is no party of PCs to join or leave: the arguments go
    // and nothing changes. (k_ptar_jandro20x passes a droid, k_psta_partyleav the PC.)
    fn pc_party { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16 } -> ! {
        _ = try nwarg::object{ &vm, routine, argc, i = 0 }
        if routine == nwscript::AddToParty { _ = try nwarg::object{ &vm, routine, argc, i = 1 } }
    }

    // The server player keeps two creatures (CSWSPlayer): +0x38, the player's character, set at
    // login and by SwitchPlayerCharacter only; +0x28, the creature the player controls, which the
    // client's leader switch (Tab, a portrait: CSWCParty::SetLeader 0x00635480 -> 0x00561c40)
    // moves to the new leader. GetFirstPC (0x0053c920 -> 0x004b4c50) and GetPCSpeaker
    // (0x0053c9c0) read +0x38: the main character, whoever leads. GetIsPC (0x0053f1c0, a client
    // object whose +0x28 is the creature) is true for the controlled creature only. Scripts rely
    // on it: the Endar Spire's door 2 (k_pend_door18) takes GetFirstPC, gives the lead back with
    // SetPartyLeader(NPC_PLAYER) and starts its cutscene with that creature, which must be the
    // main character even when Trask opened the door; a trigger's GetIsPC(GetEnteringObject())
    // fires for Trask when he leads.
    fn get_is_pc { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetIsPC, argc, i = 0 }
        try nwvm::push_int{ &vm, v = if id == w.pc and world::is_valid{ w = &w, id } { 1 } else { 0 } }
    }

    fn get_party_member_by_index { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let i = try nwarg::int{ &vm, routine = nwscript::GetPartyMemberByIndex, argc, i = 0 }
        let id = if i >= 0 and @as(usize, i) < w.party.count { w.party.members[@as(usize, i)] } else { obj::INVALID }
        try nwvm::push_object{ &vm, id = if world::is_valid{ w = &w, id } { id } else { obj::INVALID } }
    }

    fn is_object_party_member { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::IsObjectPartyMember, argc, i = 0 }
        try nwvm::push_int{ &vm, v = if party::is_member{ w = &w, id } and world::is_valid{ w = &w, id } { 1 } else { 0 } }
    }

    // ---- joining the party

    // A creature that joins the party takes the player's side (the faction of the PC), and its
    // own credits go to the shared purse (MergeCreatureIntoParty; its items stay with it until the
    // party inventory is shared).
    fn join_party_side { mut w: world::World, o: *mut obj::Object, c: *mut obj::Creature } {
        party::add_gold{ &w, n = @as(i64, c.gold) }
        c.gold = 0
        let pc = world::object{ w = &w, id = w.pc } ifnull { return }
        o.faction = pc.faction
    }

    // A slot that becomes available holds a new companion: what was kept of the one before (its
    // AVAILNPC<n> file, its link) is let go, or SpawnAvailableNPC would bring the old creature back
    // (the Endar Spire's Trask held slot 0 until Bastila took it over on Taris; the AddAvailableNPC
    // routines write the new creature's file, 0x00564300).
    fn forget_slot_state { mut w: world::World, s: usize } {
        let mut buf: [16]u8
        save::remove{ st = &w.gip, name = save::npc_name{ slot = s, into = buf[..] }, kind = save::KIND_UTC }
        if not party::is_member{ w = &w, id = w.party.npcs[s] } { w.party.npcs[s] = obj::INVALID }
    }

    // AddAvailableNPCByObject (0x00564300): refuses a slot that is available, a bad slot or a
    // creature that is not there. Only the blueprint is kept; the creature is not linked.
    fn make_available_from { mut w: world::World, n: i32, id: u32 } -> bool {
        if not party::valid_slot{ n } { return false }
        let s = @as(usize, n)
        if w.party.available[s] { return false }
        let o = world::object{ w = &w, id } ifnull { return false }
        let c = obj::creature{ o } ifnull { return false }
        if resref::is_empty{ r = o.template } { return false }
        forget_slot_state{ &w, s }
        w.party.available[s] = true
        w.party.selectable[s] = true
        w.party.templates[s] = o.template
        set_joining_xp{ &w, s, level = @as(i32, c.hit_dice) }
        join_party_side{ &w, o, c }
        return true
    }

    // JoiningXP (AddAvailableNPCByObject 0x00564300, re/party-items-saves.md 3.4): what a recruit of this level lacks of the
    // XP its level implies once its share of the party's pool is counted; SpawnAvailableNPC catches it up.
    fn set_joining_xp { mut w: world::World, s: usize, level: i32 } {
        w.party.joining_xp[s] = rules::joining_xp{ tables = w.rules, level, pool = w.party.xp_pool, percent_xp = rules::npc_percent_xp{ tables = w.rules, row = @as(i32, s) } }
    }

    // The level of a UTC: its classes' levels added.
    fn utc_level { doc: *gff::Doc } -> i32 {
        let classes = gff::get_list{ doc = doc.*, s = gff::ROOT, label = "ClassList" } ifnull slice::empty(u32){}
        let mut levels: i64 = 0
        let mut k: usize = 0
        while k < classes.len {
            levels = levels + (gff::get_number{ doc = doc.*, s = classes[k], label = "ClassLevel" } ifnull 1)
            k = k + 1
        }
        return @trunc(i32, levels)
    }

    // int AddAvailableNPCByObject(int nNPC, object oCreature)
    fn add_available_by_object { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::AddAvailableNPCByObject
        let n = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let id = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        try nwvm::push_int{ &vm, v = flag{ b = make_available_from{ &w, n, id } } }
    }

    // int AddAvailableNPCByTemplate(int nNPC, string sTemplate): the UTC has to exist.
    fn add_available_by_template { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::AddAvailableNPCByTemplate
        let n = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let template = try nwarg::string{ &vm, routine = r, argc, i = 1 }
        let mut ok = false
        if party::valid_slot{ n } and template.len > 0 and not w.party.available[@as(usize, n)] {
            let found = world::read_gff{ &w, name = template, kind = restype::Type::utc } iferr { null }
            if found is some{ value = doc } {
                let s = @as(usize, n)
                forget_slot_state{ &w, s }
                w.party.available[s] = true
                w.party.selectable[s] = true
                w.party.templates[s] = resref::truncate{ name = template }
                set_joining_xp{ &w, s, level = utc_level{ doc = &doc } }
                ok = true
            }
        }
        try nwvm::push_int{ &vm, v = flag{ b = ok } }
    }

    // int RemoveAvailableNPC(int nNPC): only the flag goes (the creature and the membership stay).
    fn remove_available_npc { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let n = try nwarg::int{ &vm, routine = nwscript::RemoveAvailableNPC, argc, i = 0 }
        let mut ok = false
        if party::valid_slot{ n } and w.party.available[@as(usize, n)] {
            w.party.available[@as(usize, n)] = false
            ok = true
        }
        try nwvm::push_int{ &vm, v = flag{ b = ok } }
    }

    // int IsAvailableCreature(int nNPC)
    fn is_available_creature { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let n = try nwarg::int{ &vm, routine = nwscript::IsAvailableCreature, argc, i = 0 }
        try nwvm::push_int{ &vm, v = flag{ b = party::valid_slot{ n } and w.party.available[@as(usize, n)] } }
    }

    // int GetNPCSelectability(int nNPC): -1 for a slot that is not available (0x005637c0).
    fn get_npc_selectability { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let n = try nwarg::int{ &vm, routine = nwscript::GetNPCSelectability, argc, i = 0 }
        let v = if party::valid_slot{ n } and w.party.available[@as(usize, n)] { flag{ b = w.party.selectable[@as(usize, n)] } } else { -1 }
        try nwvm::push_int{ &vm, v }
    }

    // void SetNPCSelectability(int nNPC, int nSelectability): available slots only.
    fn set_npc_selectability { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let n = try nwarg::int{ &vm, routine = nwscript::SetNPCSelectability, argc, i = 0 }
        let on = try nwarg::int{ &vm, routine = nwscript::SetNPCSelectability, argc, i = 1 }
        if party::valid_slot{ n } and w.party.available[@as(usize, n)] { w.party.selectable[@as(usize, n)] = on != 0 }
    }

    // void SaveNPCState(int nNPC): the creature's state is written to AVAILNPC<n> when saves
    // exist; until then the blueprint is all an available slot keeps.
    fn save_npc_state { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        _ = try nwarg::int{ &vm, routine = nwscript::SaveNPCState, argc, i = 0 }
    }

    // int SwitchPlayerCharacter(int nNPC): the player plays a companion (the Leviathan's prison break: Mission or
    // whoever the player chose slips out of her cell), or, with -1, the character comes back.
    fn switch_player_character { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let n = try nwarg::int{ &vm, routine = nwscript::SwitchPlayerCharacter, argc, i = 0 }
        let ok = try switch_player{ &w, n }
        try nwvm::push_int{ &vm, v = flag{ b = ok } }
    }

    // CSWPartyTable::SwitchPlayerCharacter (0x005667c0, re/party-items-saves.md 3.5). To an NPC (available, and not the
    // character already): the player's own character is put aside as "pc" (park_player; an NPC that was the character is kept
    // as its AVAILNPC file and despawned), the NPC is taken or made at the character's place, becomes the player's character
    // and the only one in the party; the others in the party are kept the same way and despawned (the script spawns them again
    // and AddPartyMember's them). Back to the PC (-1, while an NPC is): the NPC is kept and despawned, the PC made again at
    // its place. AddPartyMember and RemovePartyMember refuse while an NPC is the character. The party's inventory goes with
    // the player.
    fn switch_player { mut w: world::World, n: i32 } -> !bool {
        party::prune{ &w }
        let cur = w.party.controlled
        if n == cur or n < -1 or n >= @as(i32, party::SLOTS) { return false }
        if n < 0 and not save::has_parked_player{ w = &w } { return false }
        if n >= 0 and not w.party.available[@as(usize, n)] { return false }
        let from = world::object{ w = &w, id = w.player } ifnull { return false }
        let at = from.position
        let facing = from.orientation
        let old = w.player
        // The new character, before the old one goes.
        let mut next = obj::INVALID
        if n >= 0 {
            let s = @as(usize, n)
            next = spawn_available{ &w, n, l = values::Location{ position = at, facing = obj::facing_degrees{ o = from }, area = w.area } }
            if next == obj::INVALID { return false }
            // The slot's creature may have been another member of the party: it is the character now.
            if party::is_member{ w = &w, id = next } { release_member{ &w, id = next } }
            w.party.npcs[s] = next
        }
        // The old character goes: the PC is put aside, an NPC is kept as its AVAILNPC file and despawned.
        if cur < 0 {
            try save::park_player{ &w }
        } else {
            try save::save_npc{ &w, slot = @as(usize, cur) }
            if obj::creature{ o = from } is some{ value = fc } { fc.is_pc = false }
            w.party.npcs[@as(usize, cur)] = obj::INVALID
        }
        // Every other member is kept and despawned.
        let mem = party::members{ w = &w }
        let mut k: usize = 0
        while k < mem.len {
            let id = mem[k]
            k = k + 1
            if id == old or id == next { continue }
            let slot = party::slot_of{ w = &w, id }
            if slot >= 0 {
                try save::save_npc{ &w, slot = @as(usize, slot) }
                w.party.npcs[@as(usize, slot)] = obj::INVALID
            }
            world::destroy{ &w, id }
        }
        // The old character's equipment goes with it (the file keeps it; the objects come back with the character).
        if cur < 0 and obj::creature{ o = from } is some{ value = pcc } {
            let mut e: usize = 0
            while e < pcc.equipped.len {
                if pcc.equipped[e] != obj::INVALID { world::destroy{ &w, id = pcc.equipped[e] } }
                e = e + 1
            }
        }
        world::destroy{ &w, id = old }
        if n < 0 {
            next = (try save::pc_from_store{ &w, at, facing }) ifnull { return false }
            w.party.npcs[@as(usize, cur)] = obj::INVALID
        }
        let no = world::object{ w = &w, id = next } ifnull { return false }
        let nc = obj::creature{ o = no } ifnull { return false }
        w.party.count = 0
        w.party.members = [obj::INVALID; 3]
        _ = party::add{ &w, id = next }
        w.party.solo = false
        w.player = next
        w.pc = next
        w.party.controlled = n
        nc.is_pc = true
        no.ai_level = 4
        no.commandable = true
        actions::clear_all{ &w, id = next }
        // The party's items belong to the new character.
        let bag = list::items{ list = w.bag }
        let mut b: usize = 0
        while b < bag.len {
            if world::object{ w = &w, id = bag[b] } is some{ value = bo } {
                if obj::item{ o = bo } is some{ value = bi } { bi.possessor = next }
            }
            b = b + 1
        }
        world::prefix{ w = &w }
        _ = @fmt(&w.io, "SwitchPlayerCharacter {}: the player is {} ({})\n", n, next, no.tag)
        return true
    }

    // void SetSoloMode(int bActivate) (0x00547ce0, SetSoloMode 0x00565500): the flag; turning it off
    // takes the party out of stealth. What it changes in play is the party's scripts' (k_ai_master
    // keeps companions from following the leader while GetSoloMode answers TRUE).
    fn set_solo_mode { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let on = try nwarg::int{ &vm, routine = nwscript::SetSoloMode, argc, i = 0 }
        stealth::set_solo{ &w, on = on != 0 }
    }

    // ---- creatures of the slots

    // void SetAvailableNPCId(int nNPC, object oidNPC): links a creature that already exists (one
    // of the module's) to an available slot.
    fn set_available_npc_id { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::SetAvailableNPCId
        let n = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let id = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        if not party::valid_slot{ n } or not w.party.available[@as(usize, n)] { return }
        let o = world::object{ w = &w, id } ifnull { return }
        if obj::creature{ o } == null { return }
        w.party.npcs[@as(usize, n)] = id
    }

    // The creature of an available slot, put in the area at `l` (GetNPCObject then the placing of
    // SpawnAvailableNPC, 0x00565130): the one linked already, else made from the blueprint. Its
    // actions are cleared, it stands on the walkmesh at the spot, and it is the player's friend.
    // OBJECT_INVALID for a slot that is not available or has no blueprint.
    fn spawn_available { mut w: world::World, n: i32, l: values::Location } -> u32 {
        party::prune{ &w }
        if not party::valid_slot{ n } { return obj::INVALID }
        let s = @as(usize, n)
        if not w.party.available[s] { return obj::INVALID }
        let facing = obj::direction_of{ degrees = l.facing }
        let mut id = w.party.npcs[s]
        let made = not world::is_valid{ w = &w, id }
        if made {
            // The companion as it was last kept (AVAILNPC<n>), else its blueprint.
            let kept = save::npc_from_store{ &w, slot = s } iferr { null }
            if kept is some{ value = k } { id = k }
        }
        if not world::is_valid{ w = &w, id } {
            if resref::is_empty{ r = w.party.templates[s] } { return obj::INVALID }
            let mut blueprint = w.party.templates[s]
            id = tmpl::spawn{ &w, kind = obj::Kind::creature, template = resref::bytes{ r = &blueprint }, position = l.position, orientation = facing } iferr err{ error } {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "SpawnAvailableNPC {}: {}\n", n, error)
                return obj::INVALID
            }
            w.party.npcs[s] = id
        }
        let o = world::object{ w = &w, id } ifnull { return obj::INVALID }
        let c = obj::creature{ o } ifnull { return obj::INVALID }
        // A companion made here runs its OnSpawn on its first update, as the original's does:
        // GetNPCObject (0x00564700) builds a new creature (spawn flag +0x34c clear) and reads
        // AVAILNPC<n> with LoadFromTemplate, which leaves CreatnScrptFird unread. That OnSpawn
        // (k_hen_spawn01, Trask's k_pdan_trask_9) sets the listen patterns; without it a member
        // brought by the party selection never heard the leader's GEN_I_WAS_ATTACKED and sat
        // out every fight it was not ordered into. One already in the world keeps its flag.
        if made { c.spawn_fired = false }
        o.area = w.area
        o.commandable = true
        actions::clear_all{ &w, id }
        movement::place{ &w, id, at = l.position }
        world::set_orientation{ o, v = facing }
        if o.ai_level < 1 { o.ai_level = 1 }
        let pc = world::object{ w = &w, id = w.pc }
        if pc != null { o.faction = pc.faction }
        catch_up_xp{ &w, o, c, n }
        return id
    }

    // The XP catch-up of SpawnAvailableNPC (0x00565130, re/party-items-saves.md 3.4): a companion that has earned less than
    // its share of the XP the party earned while it was away takes the difference (scaled by its PercentXP again, as an award
    // is), and with "Auto Level Up NPCs" on takes the levels that allows.
    fn catch_up_xp { mut w: world::World, o: *mut obj::Object, c: *mut obj::Creature, n: i32 } {
        let f = fight::of{ o } ifnull { return }
        if not f.loaded { return }
        let share = rules::npc_percent_xp{ tables = w.rules, row = n }
        let give = rules::catch_up_xp{ tables = w.rules, xp = f.c.xp, joining = w.party.joining_xp[@as(usize, n)], pool = w.party.xp_pool, percent_xp = share }
        if give <= 0 { return }
        _ = rules::add_experience{ tables = w.rules, c = &f.c, xp = give, percent_xp = share }
        c.xp = @as(u32, f.c.xp)
        if w.rules.settings.auto_level { _ = levelup::auto_level{ &w, id = o.id } }
    }

    // object SpawnAvailableNPC(int nNPC, location lPosition)
    fn spawn_available_npc { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::SpawnAvailableNPC
        let n = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let h = try nwarg::engine{ &vm, routine = r, argc, i = 1, kind = nwvm::EngineType::location }
        let l = values::location{ s = &w.values, handle = h }
        try nwvm::push_object{ &vm, id = spawn_available{ &w, n, l } }
    }

    // ---- membership

    // AddPartyMember (0x00565620): the slot is available, the creature is there and is not the
    // creature of another slot, and the party (the player and two) has room. A member already in
    // is a success. The creature is linked to the slot, becomes player-controlled (AI level 4) and
    // joins the player's side.
    fn join_party { mut w: world::World, n: i32, id: u32 } -> bool {
        party::prune{ &w }
        if w.party.controlled >= 0 or not party::valid_slot{ n } { return false }
        let s = @as(usize, n)
        if not w.party.available[s] { return false }
        let o = world::object{ w = &w, id } ifnull { return false }
        let c = obj::creature{ o } ifnull { return false }
        let other = party::slot_of{ w = &w, id }
        if other >= 0 and other != n { return false }
        // Whoever else the slot was linked to is let go.
        let linked = w.party.npcs[s]
        if linked != id and party::is_member{ w = &w, id = linked } { release_member{ &w, id = linked } }
        if not party::is_member{ w = &w, id } {
            // The first companion to join a player who is hiding puts the party in solo mode, so
            // the stealth goes on (AddPartyMember 0x00565620).
            let alone = w.party.count <= 1
            if not party::add{ &w, id } { return false }
            join_party_side{ &w, o, c }
            if alone and stealth::is_on{ w = &w, id = w.player } { w.party.solo = true }
        }
        w.party.npcs[s] = id
        o.ai_level = 4
        return true
    }

    // A creature that leaves the party stays where it is, as an ordinary creature again (AI level
    // 2, nothing queued: it was following the leader).
    fn release_member { mut w: world::World, id: u32 } {
        party::remove{ &w, id }
        // No one left to leave behind: solo mode ends (RemovePartyMember 0x00565560).
        if w.party.count <= 1 { w.party.solo = false }
        let o = world::object{ w = &w, id } ifnull { return }
        o.ai_level = 2
        actions::clear_all{ &w, id }
    }

    // int AddPartyMember(int nNPC, object oCreature)
    fn add_party_member { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::AddPartyMember
        let n = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let id = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        try nwvm::push_int{ &vm, v = flag{ b = join_party{ &w, n, id } } }
    }

    // int RemovePartyMember(int nNPC): the slot's creature, if it is in the party.
    fn remove_party_member { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let n = try nwarg::int{ &vm, routine = nwscript::RemovePartyMember, argc, i = 0 }
        party::prune{ &w }
        let mut ok = false
        if w.party.controlled < 0 and party::valid_slot{ n } and w.party.available[@as(usize, n)] {
            let id = w.party.npcs[@as(usize, n)]
            if party::is_member{ w = &w, id } {
                release_member{ &w, id }
                ok = true
            }
        }
        try nwvm::push_int{ &vm, v = flag{ b = ok } }
    }

    // ---- the party selection screen's apply step (party-items-saves.md 3.8)

    // Where the `index`-th member (1, 2) stands: behind the leader, one to each side, on the
    // walkmesh (the leader's own spot when the point is off it).
    fn formation_point { w: *world::World, index: usize } -> values::Location {
        let lead = world::object{ w, id = party::leader{ w } } ifnull { return values::no_location{} }
        let face = lead.orientation
        let side: f32 = if index % 2 == 1 { -1.0 } else { 1.0 }
        let at = math::Vec3{
            x = lead.position.x - face.x * 1.5 + face.y * side * 1.0,
            y = lead.position.y - face.y * 1.5 - face.x * side * 1.0,
            z = lead.position.z,
        }
        let f = walkmap::floor{ m = &w.walk, x = at.x, y = at.y, z = at.z + 0.5 }
        let degrees = math::degrees{ radians = math::atan2f{ y = face.y, x = face.x } }
        return values::Location{ position = if f != null { at } else { lead.position }, facing = degrees, area = lead.area }
    }

    // A companion joining the party from the selection screen: made (or fetched) at its formation
    // point next to the leader, joined and put under the player's control. OBJECT_INVALID when the
    // slot is not available or has nothing to make it from.
    fn bring_member { mut w: world::World, n: i32 } -> u32 {
        party::prune{ &w }
        if not party::valid_slot{ n } { return obj::INVALID }
        let l = formation_point{ w = &w, index = w.party.count }
        let id = spawn_available{ &w, n, l }
        if id == obj::INVALID { return obj::INVALID }
        if not join_party{ &w, n, id } { return obj::INVALID }
        if world::object{ w = &w, id } is some{ value = o } {
            world::set_orientation{ o, v = obj::direction_of{ degrees = l.facing } }
        }
        return id
    }

    // A member the selection screen put back: out of the party, standing where it is.
    fn dismiss_member { mut w: world::World, n: i32 } {
        party::prune{ &w }
        if not party::valid_slot{ n } { return }
        let id = w.party.npcs[@as(usize, n)]
        if party::is_member{ w = &w, id } { release_member{ &w, id } }
    }
}
