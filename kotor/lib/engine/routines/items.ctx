// Routines: items and gold. Creating an item in an inventory, looking through inventories,
// equipping (as queued EQUIPITEM / UNEQUIPITEM actions, lib/engine/equip.ctx), stack sizes and credits (docs/re/
// party-items-saves.md, 5.5 and 5.6). Until the party table exists (HOOK(party)) every creature,
// the player included, keeps its own inventory and purse.
namespace rt_item {
    fn run { mut w: world::World, mut vm: nwvm::Vm, routine: u16, argc: u8 } -> !bool {
        match routine {
            nwscript::CreateItemOnObject => { try create_item_on_object{ &w, &vm, argc } }
            nwscript::GetItemInSlot => { try get_item_in_slot{ &w, &vm, argc } }
            nwscript::GetFirstItemInInventory => { try get_first_item_in_inventory{ &w, &vm, argc } }
            nwscript::GetNextItemInInventory => { try get_next_item_in_inventory{ &w, &vm, argc } }
            nwscript::GetItemPossessedBy => { try get_item_possessed_by{ &w, &vm, argc } }
            nwscript::GetItemPossessor => { try get_item_possessor{ &w, &vm, argc } }
            nwscript::GetBaseItemType => { try get_base_item_type{ &w, &vm, argc } }
            nwscript::GetItemStackSize => { try get_item_stack_size{ &w, &vm, argc } }
            nwscript::SetItemStackSize => { try set_item_stack_size{ &w, &vm, argc } }
            nwscript::GiveGoldToCreature => { try give_gold_to_creature{ &w, &vm, argc } }
            nwscript::TakeGoldFromCreature => { try take_gold_from_creature{ &w, &vm, argc } }
            nwscript::GetGold => { try get_gold{ &w, &vm, argc } }
            nwscript::ActionEquipItem => { try action_equip_item{ &w, &vm, argc } }
            nwscript::ActionPickUpItem => { try action_pickup_item{ &w, &vm, argc } }
            nwscript::ActionUnequipItem => { try action_unequip_item{ &w, &vm, argc } }
            nwscript::ActionEquipMostEffectiveArmor => { try action_equip_most_effective_armor{ &w, &vm } }
            nwscript::GetItemACValue => { try get_item_ac_value{ &w, &vm, argc } }
            nwscript::GetWeaponRanged => { try get_weapon_ranged{ &w, &vm, argc } }
            nwscript::GetItemHasItemProperty => { try get_item_has_item_property{ &w, &vm, argc } }
            nwscript::ChangeItemCost => { try change_item_cost{ &w, &vm, argc } }
            else => { return false }
        }
        return true
    }

    // baseitems.2da's ItemType of the credits item, which becomes gold wherever it is put.
    const ITEM_TYPE_CREDITS: i32 = 23
    const MAX_GOLD: u32 = 999999999

    // GetFirstItemInInventory's cursor on a placeable lives in World's heartbeat map (which keys
    // doors, placeables and triggers by id) under the id with this bit set, which no object has;
    // a creature has the field `inv_cursor`.
    const CURSOR_KEY: u32 = 0x40000000

    // ---- inventories

    // The ids an object's inventory holds: the party's shared inventory for the player character
    // and the party's members (w.bag), a creature's own list otherwise, a placeable's container
    // (party::inventory_of); nothing for the rest.
    fn inventory_of { mut w: world::World, o: *obj::Object } -> []mut u32 {
        let l = party::inventory_of{ &w, id = o.id } ifnull { return slice::empty(u32){} }
        return list::items{ list = l.* }
    }

    fn holds_items { o: *obj::Object } -> bool { return o.ext is creature | placeable | store }

    // Puts `item` in the inventory of `o`; an item in the party's inventory belongs to the player
    // character (possessor w.player), in any other to its holder.
    fn add_to_inventory { mut w: world::World, o: *mut obj::Object, item: u32 } -> bool {
        let l = party::inventory_of{ &w, id = o.id } ifnull { return false }
        list::push{ list = l, item } iferr { return false }
        if world::object{ w = &w, id = item } is some{ value = io } {
            if obj::item{ o = io } is some{ value = it } {
                it.possessor = if o.id == w.player or party::is_member{ w = &w, id = o.id } { w.player } else { o.id }
            }
        }
        return true
    }

    // Using an item's ability: the module hears OnActivateItem (what GetItemActivated, GetItemActivator
    // and GetItemActivatedTarget answer to it; the Endar Spire's tutorial waits for a medpac).
    fn signal_activation { mut w: world::World, who: u32, item: u32, target: u32 } {
        w.last_activated = item
        w.last_activator = who
        w.last_activated_target = target
        let e = events::script_event{ kind = events::ACTIVATE_ITEM, object = item }
        events::post{ &w, delay_ms = 0, caller = who, target = w.module, payload = events::Payload::script{ e } }
    }

    // The Security bonus of a security spike (property 37, ThievesTools: "+10 bonus to security skill";
    // the bonus cost table's row is the value), 0 for an item that is not one.
    fn spike_bonus_of { w: *world::World, id: u32 } -> i32 {
        let io = world::object{ w, id } ifnull { return 0 }
        let it = obj::item{ o = io } ifnull { return 0 }
        let ri = it.rules ifnull { return 0 }
        let mut k: usize = 0
        while k < @as(usize, ri.nprops) {
            let p = ri.props[k]
            k = k + 1
            if @as(i32, p.name) == rules::ip::THIEVES_TOOLS and rules::prop_active{ item = ri, p = &p } { return @as(i32, p.cost_value) }
        }
        return 0
    }

    // One unit of the item is used up (a spike): the stack is one smaller, the last one goes, and the
    // party is told "Lost Item".
    fn use_up_one { mut w: world::World, item: u32 } {
        let io = world::object{ w = &w, id = item } ifnull { return }
        let it = obj::item{ o = io } ifnull { return }
        if it.stack > 1 {
            it.stack = it.stack - 1
            if it.rules is some{ value = ri } { ri.stack = @as(i32, it.stack) }
            return
        }
        notices::item_lost{ &w, who = it.possessor, item }
        forget_item{ &w, item }
        world::destroy{ &w, id = item }
    }

    // The spell of the item's first active CastSpell property (its ability), -1 when it has none.
    fn ability_of { w: *world::World, id: u32 } -> i32 {
        let io = world::object{ w, id } ifnull { return -1 }
        let it = obj::item{ o = io } ifnull { return -1 }
        let ri = it.rules ifnull { return -1 }
        let mut k: usize = 0
        while k < @as(usize, ri.nprops) {
            let p = ri.props[k]
            k = k + 1
            if @as(i32, p.name) == rules::ip::CAST_SPELL and rules::prop_active{ item = ri, p = &p } { return @as(i32, p.subtype) }
        }
        return -1
    }

    // Puts `item` in the inventory of `o`, joining a stack of the same blueprint that has room for
    // all of it (AddItem with merge, party-items-saves.md 5.2: same base item, variations, charges,
    // blueprint). The id of the item that now holds it; INVALID when it could not be added.
    fn add_merged { mut w: world::World, o: *mut obj::Object, item: u32 } -> u32 {
        let io = world::object{ w = &w, id = item } ifnull { return obj::INVALID }
        let it = obj::item{ o = io } ifnull { return obj::INVALID }
        let most = max_stack{ w = &w, base = it.base }
        if most > 1 {
            let ids = inventory_of{ &w, o }
            let mut k: usize = 0
            while k < ids.len {
                let other = world::object{ w = &w, id = ids[k] }
                k = k + 1
                if other == null or other.id == item or other.plot != io.plot or not resref::eq{ a = other.template, b = io.template } { continue }
                let oi = obj::item{ o = other } ifnull { continue }
                if oi.base != it.base or oi.model_variation != it.model_variation or oi.charges != it.charges { continue }
                if oi.stack + it.stack > most { continue }
                oi.stack = oi.stack + it.stack
                if oi.rules is some{ value = ri } { ri.stack = @as(i32, oi.stack) }
                world::destroy{ &w, id = item }
                return other.id
            }
        }
        if not add_to_inventory{ &w, o, item } { return obj::INVALID }
        return item
    }

    // Takes `item` out of the inventory; false if it was not there.
    fn remove_from_inventory { mut w: world::World, o: *mut obj::Object, item: u32 } -> bool {
        let l = party::inventory_of{ &w, id = o.id } ifnull { return false }
        let ids = list::items{ list = l.* }
        let mut at: usize = 0
        while at < ids.len and ids[at] != item { at = at + 1 }
        if at == ids.len { return false }
        while at + 1 < ids.len {
            ids[at] = ids[at + 1]
            at = at + 1
        }
        l.len = l.len - 1
        return true
    }

    // Drops the ids of destroyed objects from an inventory.
    fn purge_dead { mut w: world::World, o: *obj::Object } {
        let l = party::inventory_of{ &w, id = o.id } ifnull { return }
        let ids = list::items{ list = l.* }
        let mut i: usize = 0
        let mut j: usize = 0
        while i < ids.len {
            if world::is_valid{ w = &w, id = ids[i] } {
                ids[j] = ids[i]
                j = j + 1
            }
            i = i + 1
        }
        l.len = j
    }

    // An item that is about to be destroyed leaves the inventory and the equipment that hold it.
    // Call it before world::destroy marks the object (HOOK: the destroy event does not yet); until
    // then the inventories skip the ids of dead objects (purge_dead).
    fn forget_item { mut w: world::World, item: u32 } {
        let io = world::object{ w = &w, id = item } ifnull { return }
        let it = obj::item{ o = io } ifnull { return }
        let holder = world::object{ w = &w, id = it.possessor } ifnull { return }
        if holder.destroyed { return }          // going too (a module being left)
        if it.equipped_slot >= 0 and it.equipped_slot < @as(i32, obj::EQUIP_SLOTS) {
            _ = equip::unequip_item{ &w, id = holder.id, slot = @as(usize, it.equipped_slot) }
        }
        _ = remove_from_inventory{ &w, o = holder, item }
    }

    // The item's use of `spell` is spent as the cast begins (party-items-saves.md 5.10): a single-use
    // property (iprp_chargecost row 1: medpacs, stims, grenades) takes one from the stack and the
    // item goes with the last one; an "n charges per use" row (2..6) takes 7 - row charges. Uses per
    // day and per minute are not counted, so those items stay free (HOOK: the property's UsesPerDay
    // is read but never spent).
    fn spend_use { mut w: world::World, item: u32, spell: i32 } {
        let io = world::object{ w = &w, id = item } ifnull { return }
        let it = obj::item{ o = io } ifnull { return }
        let ri = it.rules ifnull { return }
        let mut k: usize = 0
        while k < @as(usize, ri.nprops) {
            let p = ri.props[k]
            k = k + 1
            if @as(i32, p.name) != rules::ip::CAST_SPELL or @as(i32, p.subtype) != spell or not rules::prop_active{ item = ri, p = &p } { continue }
            if p.cost_value == 1 {
                if it.stack > 1 {
                    it.stack = it.stack - 1
                    ri.stack = @as(i32, it.stack)
                } else {
                    // The last of the stack: DECREMENT_STACKSIZE destroys it, and the party is told.
                    notices::item_lost{ &w, who = it.possessor, item }
                    forget_item{ &w, item }
                    world::destroy{ &w, id = item }
                }
            } else if p.cost_value >= 2 and p.cost_value <= 6 {
                let spent = @as(u32, 7 - p.cost_value)
                it.charges = if it.charges > spent { it.charges - spent } else { 0 }
                ri.charges = @as(i32, it.charges)
            }
            return
        }
    }

    fn cursor_of { w: *world::World, o: *obj::Object } -> usize {
        if o.ext is creature{ c } { return c.inv_cursor }
        return @as(usize, map::get{ m = w.heartbeats, key = CURSOR_KEY | o.id } ifnull 0)
    }

    fn set_cursor { mut w: world::World, o: *mut obj::Object, at: usize } {
        if o.ext is creature{ c } {
            c.inv_cursor = at
            return
        }
        map::put{ m = &w.heartbeats, key = CURSOR_KEY | o.id, value = @as(u64, at) } iferr {}
    }

    // The item at the cursor or after it, the cursor moved past it; OBJECT_INVALID at the end.
    fn step_cursor { mut w: world::World, o: *mut obj::Object } -> u32 {
        let ids = inventory_of{ &w, o }
        let mut at = cursor_of{ w = &w, o }
        while at < ids.len {
            let id = ids[at]
            at = at + 1
            if world::is_valid{ w = &w, id } {
                set_cursor{ &w, o, at }
                return id
            }
        }
        set_cursor{ &w, o, at }
        return obj::INVALID
    }

    // object GetFirstItemInInventory(object oTarget = OBJECT_SELF)
    fn get_first_item_in_inventory { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetFirstItemInInventory, argc, i = 0 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_object{ &vm, id = obj::INVALID }
            return
        }
        purge_dead{ &w, o }
        set_cursor{ &w, o, at = 0 }
        try nwvm::push_object{ &vm, id = step_cursor{ &w, o } }
    }

    // object GetNextItemInInventory(object oTarget = OBJECT_SELF)
    fn get_next_item_in_inventory { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetNextItemInInventory, argc, i = 0 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_object{ &vm, id = obj::INVALID }
            return
        }
        try nwvm::push_object{ &vm, id = step_cursor{ &w, o } }
    }

    // object GetItemPossessedBy(object oCreature, string sItemTag): carried, not equipped.
    fn get_item_possessed_by { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetItemPossessedBy, argc, i = 0 }
        let tag = try nwarg::string{ &vm, routine = nwscript::GetItemPossessedBy, argc, i = 1 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_object{ &vm, id = obj::INVALID }
            return
        }
        let ids = inventory_of{ &w, o }
        let mut found = obj::INVALID
        let mut k: usize = 0
        while k < ids.len {
            let it = world::object{ w = &w, id = ids[k] }
            k = k + 1
            if it != null and ci::eq{ a = it.tag, b = tag } {
                found = it.id
                break
            }
        }
        try nwvm::push_object{ &vm, id = found }
    }

    // object GetItemPossessor(object oItem)
    fn get_item_possessor { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetItemPossessor, argc, i = 0 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_object{ &vm, id = obj::INVALID }
            return
        }
        let it = obj::item{ o } ifnull {
            try nwvm::push_object{ &vm, id = obj::INVALID }
            return
        }
        try nwvm::push_object{ &vm, id = if world::is_valid{ w = &w, id = it.possessor } { it.possessor } else { obj::INVALID } }
    }

    // object GetItemInSlot(int nInventorySlot, object oCreature = OBJECT_SELF)
    fn get_item_in_slot { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let slot = try nwarg::int{ &vm, routine = nwscript::GetItemInSlot, argc, i = 0 }
        let id = try nwarg::object{ &vm, routine = nwscript::GetItemInSlot, argc, i = 1 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_object{ &vm, id = obj::INVALID }
            return
        }
        let c = obj::creature{ o } ifnull {
            try nwvm::push_object{ &vm, id = obj::INVALID }
            return
        }
        if slot < 0 or slot >= @as(i32, obj::EQUIP_SLOTS) {
            try nwvm::push_object{ &vm, id = obj::INVALID }
            return
        }
        let item = c.equipped[@as(usize, slot)]
        try nwvm::push_object{ &vm, id = if world::is_valid{ w = &w, id = item } { item } else { obj::INVALID } }
    }

    // ---- item records

    // How many of a base item fit in one stack (baseitems.2da Stacking, at least 1).
    fn max_stack { w: *world::World, base: u32 } -> u32 {
        let n = twoda::get_int{ t = w.tables.baseitems, row = @as(usize, base), column = "stacking" } ifnull 1
        return if n < 1 { 1 } else { @as(u32, n) }
    }

    // The item's base item ItemType (baseitems.2da), 0 when it is not an item.
    fn item_type_of { w: *world::World, id: u32 } -> i32 {
        let io = world::object{ w, id } ifnull { return 0 }
        let it = obj::item{ o = io } ifnull { return 0 }
        return twoda::get_int{ t = w.tables.baseitems, row = @as(usize, it.base), column = "itemtype" } ifnull 0
    }

    fn is_credits { w: *world::World, base: u32 } -> bool {
        let t = twoda::get_int{ t = w.tables.baseitems, row = @as(usize, base), column = "itemtype" } ifnull 0
        return t == ITEM_TYPE_CREDITS
    }

    // int GetBaseItemType(object oItem)
    fn get_base_item_type { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetBaseItemType, argc, i = 0 }
        let none = nwconst::BASE_ITEM_INVALID
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = none }
            return
        }
        let it = obj::item{ o } ifnull {
            try nwvm::push_int{ &vm, v = none }
            return
        }
        try nwvm::push_int{ &vm, v = @as(i32, it.base) }
    }

    // int GetItemStackSize(object oItem)
    fn get_item_stack_size { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetItemStackSize, argc, i = 0 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        let it = obj::item{ o } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        try nwvm::push_int{ &vm, v = @as(i32, it.stack) }
    }

    // void SetItemStackSize(object oItem, int nStackSize): clamped to 1..the base item's maximum.
    fn set_item_stack_size { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::SetItemStackSize, argc, i = 0 }
        let n = try nwarg::int{ &vm, routine = nwscript::SetItemStackSize, argc, i = 1 }
        let o = world::object{ w = &w, id } ifnull { return }
        let it = obj::item{ o } ifnull { return }
        let most = max_stack{ w = &w, base = it.base }
        it.stack = if n < 1 { 1 } else if @as(u32, n) > most { most } else { @as(u32, n) }
    }

    // ---- creating items

    // An item made from `template` in `target`'s inventory, as AcquireItem does it: the stack is
    // clamped to what the base item allows and merged into a stack of the same template with
    // room; credits become gold. Returns the item that holds the new ones (OBJECT_INVALID when
    // nothing was made, and for credits).
    fn create_item { mut w: world::World, template: []u8, target: u32, stack: i32 } -> u32 {
        let holder = world::object{ w = &w, id = target } ifnull { return obj::INVALID }
        if not holds_items{ o = holder } or stack < 1 { return obj::INVALID }
        let id = tmpl::spawn_item{ &w, template, possessor = target } iferr { return obj::INVALID }
        let o = world::object{ w = &w, id } ifnull { return obj::INVALID }
        let it = obj::item{ o } ifnull { return id }
        let most = max_stack{ w = &w, base = it.base }
        it.stack = if @as(u32, stack) > most { most } else { @as(u32, stack) }
        let party_holder = target == w.player or party::is_member{ w = &w, id = target }
        if is_credits{ w = &w, base = it.base } {
            // The party's credits are the purse (party-items-saves.md 3.6).
            if party_holder {
                party::add_gold{ &w, n = @as(i64, it.stack) }
            } else if obj::creature{ o = holder } is some{ value = c } {
                c.gold = add_gold{ have = c.gold, n = @as(i64, it.stack) }
            }
            world::destroy{ &w, id }
            return obj::INVALID
        }
        // A pazaak card the party finds is counted, not kept (5.9).
        if party_holder and rt_mg::take_card{ &w, base = it.base, variation = it.model_variation, stack = it.stack } {
            world::destroy{ &w, id }
            return obj::INVALID
        }
        if most > 1 {
            let ids = inventory_of{ &w, o = holder }
            let mut k: usize = 0
            while k < ids.len {
                let other = world::object{ w = &w, id = ids[k] }
                k = k + 1
                if other == null or not resref::eq{ a = other.template, b = o.template } { continue }
                let oi = obj::item{ o = other } ifnull { continue }
                if oi.stack >= most { continue }
                let room = most - oi.stack
                if it.stack <= room {
                    oi.stack = oi.stack + it.stack
                    world::destroy{ &w, id }
                    return other.id
                }
                oi.stack = most
                it.stack = it.stack - room
            }
        }
        if not add_to_inventory{ &w, o = holder, item = id } {
            world::destroy{ &w, id }
            return obj::INVALID
        }
        return id
    }

    // object CreateItemOnObject(string sItemTemplate, object oTarget = OBJECT_SELF, int nStackSize = 1)
    fn create_item_on_object { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::CreateItemOnObject
        let template = try nwarg::string{ &vm, routine = r, argc, i = 0 }
        let target = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let stack = try nwarg::int{ &vm, routine = r, argc, i = 2 }
        let id = create_item{ &w, template, target, stack }
        // AcquireItem with feedback: the party is told ("Acquired Item: ...", the HUD's icon).
        if id != obj::INVALID {
            notices::item_gained{ &w, who = target, item = id }
            if notices::is_party{ w = &w, id = target } { xfer::mark_new{ &w, item = id } }
        } else if stack > 0 and template.len >= 11 and ci::eq{ a = template[..11], b = "g_i_credits" } {
            notices::credits_changed{ &w, who = target, n = @as(i64, stack) }
        }
        try nwvm::push_object{ &vm, id }
    }

    // ---- gold

    fn add_gold { have: u32, n: i64 } -> u32 {
        let total = @as(i64, have) + n
        if total < 0 { return 0 }
        if total > @as(i64, MAX_GOLD) { return MAX_GOLD }
        return @trunc(u32, total)
    }

    // void GiveGoldToCreature(object oCreature, int nGP)
    fn give_gold_to_creature { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GiveGoldToCreature, argc, i = 0 }
        let n = try nwarg::int{ &vm, routine = nwscript::GiveGoldToCreature, argc, i = 1 }
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        // The party has one purse (party-items-saves.md, 3.6); anyone else keeps their own.
        if party::is_member{ w = &w, id } {
            party::add_gold{ &w, n = @as(i64, n) }
            notices::credits_changed{ &w, who = id, n = @as(i64, n) }       // feedback and the HUD's credits icon
            return
        }
        c.gold = add_gold{ have = c.gold, n = @as(i64, n) }
    }

    // void TakeGoldFromCreature(int nAmount, object oCreatureToTakeFrom, int bDestroy = FALSE):
    // at most what the creature has; unless destroyed it goes to the caller, as gold to a
    // creature and as a credits item to a placeable.
    fn take_gold_from_creature { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::TakeGoldFromCreature
        let n = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let id = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let destroy = try nwarg::int{ &vm, routine = r, argc, i = 2 }
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let shared = party::is_member{ w = &w, id }
        let have: u32 = if shared { @as(u32, w.party.gold) } else { c.gold }
        let amount: u32 = if n < 1 { 0 } else if @as(u32, n) > have { have } else { @as(u32, n) }
        if amount == 0 { return }
        if shared {
            party::add_gold{ &w, n = 0 - @as(i64, amount) }
            notices::credits_changed{ &w, who = id, n = 0 - @as(i64, amount) }
        } else { c.gold = c.gold - amount }
        if destroy != 0 { return }
        let me = nwvm::self_object{ vm }
        let caller = world::object{ w = &w, id = me } ifnull { return }
        if obj::creature{ o = caller } is some{ value = cc } {
            if party::is_member{ w = &w, id = me } {
                party::add_gold{ &w, n = @as(i64, amount) }
                notices::credits_changed{ &w, who = me, n = @as(i64, amount) }
            } else {
                cc.gold = add_gold{ have = cc.gold, n = @as(i64, amount) }
            }
        } else if obj::placeable{ o = caller } != null {
            _ = create_item{ &w, template = "g_i_credits001", target = me, stack = @as(i32, amount) }
        }
    }

    // int GetGold(object oTarget = OBJECT_SELF): a creature's purse; a placeable's is its first
    // credits item's stack.
    fn get_gold { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetGold, argc, i = 0 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        if obj::creature{ o } is some{ value = c } {
            try nwvm::push_int{ &vm, v = if party::is_member{ w = &w, id } { w.party.gold } else { @as(i32, c.gold) } }
            return
        }
        let ids = inventory_of{ &w, o }
        let mut k: usize = 0
        while k < ids.len {
            let other = world::object{ w = &w, id = ids[k] }
            k = k + 1
            if other == null { continue }
            let it = obj::item{ o = other } ifnull { continue }
            if is_credits{ w = &w, base = it.base } {
                try nwvm::push_int{ &vm, v = @as(i32, it.stack) }
                return
            }
        }
        try nwvm::push_int{ &vm, v = 0 }
    }

    // ---- equipping (equip.ctx keeps the inventory and the rules together)

    // void ActionEquipItem(object oItem, int nInventorySlot, int bInstant = FALSE): the EQUIPITEM
    // action is queued behind what the creature is doing (actions.md 3.8; bInstant only rides along),
    // and a slot the item already fills queues nothing (AddEquipItemActions).
    fn action_equip_item { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::ActionEquipItem
        let item = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let slot = try nwarg::int{ &vm, routine = r, argc, i = 1 }
        let instant = try nwarg::int{ &vm, routine = r, argc, i = 2 }
        let me = nwvm::self_object{ vm }
        if slot < 0 or slot >= @as(i32, obj::EQUIP_SLOTS) or not world::is_valid{ w = &w, id = item } { return }
        if equip::slot_of_item{ w = &w, id = me, item } == slot { return }
        let mut a = actions::make{ kind = actions::Kind::equip_item }
        a.params[0] = actions::Param::object{ id = item }
        a.params[1] = actions::Param::int{ v = slot }
        a.params[2] = actions::Param::int{ v = instant }
        _ = actions::add{ &w, id = me, action = a, force = false }
    }

    // void ActionPickUpItem(object oItem): the PICKUPITEM action (the item on the ground).
    fn action_pickup_item { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let item = try nwarg::object{ &vm, routine = nwscript::ActionPickUpItem, argc, i = 0 }
        if not world::is_valid{ w = &w, id = item } { return }
        let mut a = actions::make{ kind = actions::Kind::pickup_item }
        a.params[0] = actions::Param::object{ id = item }
        a.params[1] = actions::Param::object{ id = obj::INVALID }
        a.params[2] = actions::Param::int{ v = 0 }
        _ = actions::add{ &w, id = nwvm::self_object{ vm }, action = a, force = false }
    }

    // void ActionUnequipItem(object oItem, int bInstant = FALSE)
    fn action_unequip_item { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::ActionUnequipItem
        let item = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let instant = try nwarg::int{ &vm, routine = r, argc, i = 1 }
        let me = nwvm::self_object{ vm }
        if equip::slot_of_item{ w = &w, id = me, item } < 0 { return }
        let mut a = actions::make{ kind = actions::Kind::unequip_item }
        a.params[0] = actions::Param::object{ id = item }
        a.params[1] = actions::Param::int{ v = instant }
        _ = actions::add{ &w, id = me, action = a, force = false }
    }

    // ---- armour and weapons as items

    // The base item row of an item object (null for anything else).
    fn base_row_of { w: *world::World, item: u32 } -> ?*rules::BaseItemRow {
        let io = world::object{ w, id = item } ifnull { return null }
        let it = obj::item{ o = io } ifnull { return null }
        return rules::get_baseitem{ tables = w.rules, row = @as(i32, it.base) }
    }

    // int GetItemACValue(object oItem): the armour's base AC; 0 for anything that is none.
    fn get_item_ac_value { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetItemACValue, argc, i = 0 }
        let row = base_row_of{ w = &w, item = id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        try nwvm::push_int{ &vm, v = if row.base_ac > 0 { row.base_ac } else { 0 } }
    }

    // int GetWeaponRanged(object oItem)
    fn get_weapon_ranged { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetWeaponRanged, argc, i = 0 }
        let row = base_row_of{ w = &w, item = id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        try nwvm::push_int{ &vm, v = if row.ranged { 1 } else { 0 } }
    }

    // int GetItemHasItemProperty(object oItem, int nProperty): an active property of that type.
    fn get_item_has_item_property { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetItemHasItemProperty, argc, i = 0 }
        let name = try nwarg::int{ &vm, routine = nwscript::GetItemHasItemProperty, argc, i = 1 }
        let mut has = 0
        if world::object{ w = &w, id } is some{ value = io } {
            if obj::item{ o = io } is some{ value = it } {
                if it.rules is some{ value = ri } {
                    if rules::has_property{ item = ri, name } { has = 1 }
                }
            }
        }
        try nwvm::push_int{ &vm, v = has }
    }

    // void ActionEquipMostEffectiveArmor(): the carried armour with the highest base AC that the
    // creature may wear and that beats the armour it has on; queued as an EQUIPITEM action.
    fn action_equip_most_effective_armor { mut w: world::World, mut vm: nwvm::Vm } -> ! {
        let me = nwvm::self_object{ vm }
        let o = world::object{ w = &w, id = me } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let mut best_ac: i32 = 0
        if base_row_of{ w = &w, item = c.equipped[obj::SLOT_BODY] } is some{ value = worn } { best_ac = worn.base_ac }
        let mut best = obj::INVALID
        let ids = inventory_of{ &w, o }
        let mut k: usize = 0
        while k < ids.len {
            let item = ids[k]
            k = k + 1
            let row = base_row_of{ w = &w, item } ifnull { continue }
            if (row.equip_slots & 2) == 0 or row.base_ac <= best_ac { continue }
            if not equip::may_equip{ w = &w, id = me, item, mask = 2 } { continue }
            best = item
            best_ac = row.base_ac
        }
        if best == obj::INVALID { return }
        let mut a = actions::make{ kind = actions::Kind::equip_item }
        a.params[0] = actions::Param::object{ id = best }
        a.params[1] = actions::Param::int{ v = @as(i32, obj::SLOT_BODY) }
        a.params[2] = actions::Param::int{ v = 0 }
        _ = actions::add{ &w, id = me, action = a, force = false }
    }

    // void ChangeItemCost(string sItem, float fCostMultiplier): the template's base item learns the
    // multiplier, so every item of that base item costs it from now on (party-items-saves.md 5.5;
    // it is the party's, PT_COST_MULT_LIST). Nothing prices items yet, so it only keeps the number.
    fn change_item_cost { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::ChangeItemCost
        let template = try nwarg::string{ &vm, routine = r, argc, i = 0 }
        let mult = try nwarg::float{ &vm, routine = r, argc, i = 1 }
        let doc = try world::read_gff{ &w, name = template, kind = restype::Type::uti } ifnull { return }
        let base = gff::get_number{ doc, s = gff::ROOT, label = "BaseItem" } ifnull { return }
        if base < 0 or base >= @as(i64, w.party.cost_mult.len) { return }
        w.party.cost_mult[@as(usize, base)] = mult
    }
}
