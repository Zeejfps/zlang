// Routines that queue actions on OBJECT_SELF (docs/re/actions.md 2) and the ones that act at
// once on an object's queue, facing or animation.
namespace rt_act {
    fn run { mut w: world::World, mut vm: nwvm::Vm, routine: u16, argc: u8 } -> !bool {
        if routine == nwscript::ClearAllActions { actions::clear_all{ &w, id = nwvm::self_object{ vm } } }
        else if routine == nwscript::ActionDoCommand { try action_do_command{ &w, &vm, argc } }
        else if routine == nwscript::ActionWait { try action_wait{ &w, &vm, argc } }
        else if routine == nwscript::ActionPlayAnimation { try action_play_animation{ &w, &vm, argc } }
        else if routine == nwscript::PlayAnimation { try play_animation{ &w, &vm, argc } }
        else if routine == nwscript::ActionMoveToObject { try move_to_object{ &w, &vm, argc, routine, force = false } }
        else if routine == nwscript::ActionForceMoveToObject { try move_to_object{ &w, &vm, argc, routine, force = true } }
        else if routine == nwscript::ActionMoveToLocation { try move_to_location{ &w, &vm, argc, routine, force = false } }
        else if routine == nwscript::ActionForceMoveToLocation { try move_to_location{ &w, &vm, argc, routine, force = true } }
        else if routine == nwscript::ActionJumpToObject { try jump_to_object{ &w, &vm, argc, routine, queue = true } }
        else if routine == nwscript::JumpToObject { try jump_to_object{ &w, &vm, argc, routine, queue = false } }
        else if routine == nwscript::ActionJumpToLocation { try jump_to_location{ &w, &vm, argc, routine, queue = true } }
        else if routine == nwscript::JumpToLocation { try jump_to_location{ &w, &vm, argc, routine, queue = false } }
        else if routine == nwscript::SetFacing { try set_facing{ &w, &vm, argc } }
        else if routine == nwscript::SetFacingPoint { try set_facing_point{ &w, &vm, argc } }
        else if routine == nwscript::ActionOpenDoor { try door_action{ &w, &vm, argc, routine, kind = actions::Kind::open_door } }
        else if routine == nwscript::ActionCloseDoor { try door_action{ &w, &vm, argc, routine, kind = actions::Kind::close_door } }
        else if routine == nwscript::ActionStartConversation { try action_start_conversation{ &w, &vm, argc } }
        else if routine == nwscript::ActionRandomWalk { _ = actions::add{ &w, id = self_of{ vm = &vm }, action = actions::make{ kind = actions::Kind::random_walk }, force = false } }
        else if routine == nwscript::ActionForceFollowObject { try force_follow{ &w, &vm, argc } }
        else if routine == nwscript::ActionInteractObject { try door_action{ &w, &vm, argc, routine, kind = actions::Kind::use_object } }
        else if routine == nwscript::ActionUseSkill { try action_use_skill{ &w, &vm, argc } }
        else if routine == nwscript::DoDoorAction { try do_door_action{ &w, &vm, argc } }
        else if routine == nwscript::GetIsDoorActionPossible { try get_is_door_action_possible{ &w, &vm, argc } }
        else { return false }
        return true
    }

    fn self_of { vm: *nwvm::Vm } -> u32 { return nwvm::self_object{ vm = vm.* } }

    // void ActionDoCommand(action aActionToDo): dropped on a non-commandable object.
    fn action_do_command { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let s = try scripts::take_situation{ &w, &vm }
        let mut a = actions::make{ kind = actions::Kind::do_command }
        a.params[0] = actions::Param::situation{ s }
        _ = actions::add{ &w, id = self_of{ vm = &vm }, action = a, force = false }
    }

    fn action_wait { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let seconds = try nwarg::float{ &vm, routine = nwscript::ActionWait, argc, i = 0 }
        let mut a = actions::make{ kind = actions::Kind::wait }
        a.params[0] = actions::Param::float{ v = seconds }
        _ = actions::add{ &w, id = self_of{ vm = &vm }, action = a, force = false }
    }

    // void ActionPlayAnimation(int nAnimation, float fSpeed = 1.0, float fDurationSeconds = 0.0)
    fn action_play_animation { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::ActionPlayAnimation
        let constant = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let speed = try nwarg::float{ &vm, routine = r, argc, i = 1 }
        let duration = try nwarg::float{ &vm, routine = r, argc, i = 2 }
        let me = self_of{ vm = &vm }
        let o = world::object{ w = &w, id = me } ifnull { return }
        let id = animname::from_script{ constant, kind = o.kind }
        if duration < 0.0 and constant >= 0 and constant <= 32 {
            // A negative duration loops the animation at once, without queuing (actions.md 3.9).
            world::set_animation{ o, id, speed }
            return
        }
        let mut a = actions::make{ kind = actions::Kind::play_animation }
        a.params[0] = actions::Param::int{ v = @as(i32, id) }
        a.params[1] = actions::Param::float{ v = speed }
        a.params[2] = actions::Param::float{ v = duration }
        _ = actions::add{ &w, id = me, action = a, force = false }
    }

    // void PlayAnimation(int nAnimation, float fSpeed = 1.0, float fSeconds = 0.0): at once, as the
    // front of the queue (ours: the original plays it on the object directly).
    fn play_animation { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::PlayAnimation
        let constant = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let speed = try nwarg::float{ &vm, routine = r, argc, i = 1 }
        let seconds = try nwarg::float{ &vm, routine = r, argc, i = 2 }
        let me = self_of{ vm = &vm }
        let o = world::object{ w = &w, id = me } ifnull { return }
        let id = animname::from_script{ constant, kind = o.kind }
        if seconds < 0.0 or o.kind != obj::Kind::creature {
            world::set_animation{ o, id, speed }
            if obj::placeable{ o } is some{ value = p } { p.anim = id }
            return
        }
        let mut a = actions::make{ kind = actions::Kind::play_animation }
        a.params[0] = actions::Param::int{ v = @as(i32, id) }
        a.params[1] = actions::Param::float{ v = speed }
        a.params[2] = actions::Param::float{ v = seconds }
        actions::add_front{ &w, id = me, action = a }
    }

    // ActionMoveToObject(object oMoveTo, int bRun = FALSE, float fRange = 1.0);
    // ActionForceMoveToObject(object oMoveTo, int bRun = FALSE, float fRange = 1.0, float fTimeout = 30.0)
    fn move_to_object { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16, force: bool } -> ! {
        let target = try nwarg::object{ &vm, routine, argc, i = 0 }
        let run = try nwarg::int{ &vm, routine, argc, i = 1 }
        let range = try nwarg::float{ &vm, routine, argc, i = 2 }
        let timeout = if force { try nwarg::float{ &vm, routine, argc, i = 3 } } else { 0.0 }
        let t = world::object{ w = &w, id = target } ifnull { return }
        let mut a = actions::make{ kind = actions::Kind::move_to_point }
        a.params[0] = actions::Param::vector{ v = t.position }
        a.params[1] = actions::Param::int{ v = run }
        a.params[2] = actions::Param::float{ v = range }
        a.params[3] = actions::Param::object{ id = target }
        a.params[4] = actions::Param::float{ v = timeout }
        _ = actions::add{ &w, id = self_of{ vm = &vm }, action = a, force = false }
    }

    // ActionMoveToLocation(location lDestination, int bRun = FALSE);
    // ActionForceMoveToLocation(location lDestination, int bRun = FALSE, float fTimeout = 30.0):
    // both queue on a non-commandable object (actions.md 1.6).
    fn move_to_location { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16, force: bool } -> ! {
        let h = try nwarg::engine{ &vm, routine, argc, i = 0, kind = nwvm::EngineType::location }
        let run = try nwarg::int{ &vm, routine, argc, i = 1 }
        let timeout = if force { try nwarg::float{ &vm, routine, argc, i = 2 } } else { 0.0 }
        let l = values::location{ s = &w.values, handle = h }
        let mut a = actions::make{ kind = actions::Kind::move_to_point }
        a.params[0] = actions::Param::vector{ v = l.position }
        a.params[1] = actions::Param::int{ v = run }
        a.params[2] = actions::Param::float{ v = 0.1 }
        a.params[4] = actions::Param::float{ v = timeout }
        _ = actions::add{ &w, id = self_of{ vm = &vm }, action = a, force = true }
    }

    // (Action)JumpToObject(object oToJumpTo, int bWalkStraightLineToPoint = TRUE)
    fn jump_to_object { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16, queue: bool } -> ! {
        let target = try nwarg::object{ &vm, routine, argc, i = 0 }
        if argc > 1 { _ = try nwarg::int{ &vm, routine, argc, i = 1 } }
        let mut a = actions::make{ kind = actions::Kind::jump_to_object }
        a.params[0] = actions::Param::object{ id = target }
        let me = self_of{ vm = &vm }
        if queue { _ = actions::add{ &w, id = me, action = a, force = false } } else {
            actions::clear_all{ &w, id = me }
            actions::add_front{ &w, id = me, action = a }
        }
    }

    // (Action)JumpToLocation(location lLocation)
    fn jump_to_location { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16, queue: bool } -> ! {
        let h = try nwarg::engine{ &vm, routine, argc, i = 0, kind = nwvm::EngineType::location }
        let l = values::location{ s = &w.values, handle = h }
        let mut a = actions::make{ kind = actions::Kind::jump_to_point }
        a.params[0] = actions::Param::vector{ v = l.position }
        a.params[1] = actions::Param::float{ v = l.facing }
        let me = self_of{ vm = &vm }
        if queue { _ = actions::add{ &w, id = me, action = a, force = false } } else {
            actions::clear_all{ &w, id = me }
            actions::add_front{ &w, id = me, action = a }
        }
    }

    // void SetFacing(float fDirection): degrees counter-clockwise from east, at once.
    fn set_facing { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let degrees = try nwarg::float{ &vm, routine = nwscript::SetFacing, argc, i = 0 }
        let o = world::object{ w = &w, id = self_of{ vm = &vm } } ifnull { return }
        world::set_orientation{ o, v = obj::direction_of{ degrees } }
    }

    // void SetFacingPoint(vector vTarget)
    fn set_facing_point { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let v = try nwarg::vector{ &vm, routine = nwscript::SetFacingPoint, argc, i = 0 }
        let o = world::object{ w = &w, id = self_of{ vm = &vm } } ifnull { return }
        world::set_orientation{ o, v = math::Vec3{ x = v.x - o.position.x, y = v.y - o.position.y, z = 0.0 } }
    }

    // void ActionOpenDoor(object oDoor), ActionCloseDoor(object oDoor)
    fn door_action { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16, kind: actions::Kind } -> ! {
        let door = try nwarg::object{ &vm, routine, argc, i = 0 }
        let mut a = actions::make{ kind }
        a.params[0] = actions::Param::object{ id = door }
        _ = actions::add{ &w, id = self_of{ vm = &vm }, action = a, force = false }
    }

    // void ActionForceFollowObject(object oFollow, float fFollowDistance = 0.0): queues even on a
    // non-commandable object (actions.md 1.6).
    fn force_follow { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::ActionForceFollowObject
        let target = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let dist = try nwarg::float{ &vm, routine = r, argc, i = 1 }
        let mut a = actions::make{ kind = actions::Kind::follow }
        a.params[0] = actions::Param::object{ id = target }
        a.params[1] = actions::Param::float{ v = dist }
        _ = actions::add{ &w, id = self_of{ vm = &vm }, action = a, force = true }
    }

    // void ActionStartConversation(object oObjectToConverse, string sDialogResRef = "",
    //   int bPrivateConversation = FALSE, int nConversationType = 0, int bIgnoreStartRange = FALSE,
    //   string sNameObjectToIgnore1..6 = "", int bUseLeader = FALSE)
    fn action_start_conversation { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::ActionStartConversation
        let with = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let dialog = try nwarg::string{ &vm, routine = r, argc, i = 1 }
        let mut i: usize = 2
        let count = @as(usize, nwscript::ROUTINES[@as(usize, r)].count)
        while i < count {
            match nwscript::PARAMS[@as(usize, nwscript::ROUTINES[@as(usize, r)].first) + i].kind {
                int => { _ = try nwarg::int{ &vm, routine = r, argc, i } }
                string => { _ = try nwarg::string{ &vm, routine = r, argc, i } }
                else => {}
            }
            i = i + 1
        }
        // Only when no conversation is ordered or running, from a commandable OBJECT_SELF (2.2).
        let me = world::object{ w = &w, id = self_of{ vm = &vm } } ifnull { return }
        if not me.commandable or not dlg::order{ &w } { return }
        let mut a = actions::make{ kind = actions::Kind::dialog_object }
        a.params[0] = actions::Param::object{ id = with }
        if dialog.len > 0 { a.params[1] = actions::Param::string{ s = try obj::copy_bytes{ heap = w.heap, s = dialog } } }
        _ = actions::add{ &w, id = self_of{ vm = &vm }, action = a, force = false }
    }

    // ---- skills and doors

    // DOOR_ACTION_*.
    const DOOR_OPEN: i32 = 0
    const DOOR_UNLOCK: i32 = 1
    const DOOR_BASH: i32 = 2
    const DOOR_IGNORE: i32 = 3
    const DOOR_KNOCK: i32 = 4

    // Whether `who` can do `action` to the door now (actions.md 2: open, unlock with Security, bash
    // as an attack, knock as a cast): open needs it closed and not locked; unlock a locked door that
    // wants no key and a creature that has the Security skill; bash a closed door that is not plot
    // and still has hit points. Knock has no power to cast it with here, so it is never possible.
    fn door_possible { mut w: world::World, who: u32, door: u32, action: i32 } -> bool {
        let o = world::object{ w = &w, id = door } ifnull { return false }
        let d = obj::door{ o } ifnull { return false }
        if action == DOOR_OPEN { return d.state == obj::DoorState::closed and not d.locked }
        if action == DOOR_IGNORE { return true }
        if action == DOOR_BASH { return d.state == obj::DoorState::closed and not o.plot and o.hp > 0 and not d.static }
        if action == DOOR_UNLOCK {
            if not d.locked or d.key_required { return false }
            let me = world::object{ w = &w, id = who } ifnull { return false }
            let f = fight::of{ o = me } ifnull { return false }
            return rt_talent::has_skill{ w = &w, f, skill = rules::skill::SECURITY }
        }
        return false
    }

    // int GetIsDoorActionPossible(object oTargetDoor, int nDoorAction), by the caller.
    fn get_is_door_action_possible { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::GetIsDoorActionPossible
        let door = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let action = try nwarg::int{ &vm, routine = r, argc, i = 1 }
        let yes = door_possible{ &w, who = self_of{ vm = &vm }, door, action }
        try nwvm::push_int{ &vm, v = if yes { 1 } else { 0 } }
    }

    // void DoDoorAction(object oTargetDoor, int nDoorAction): open queues OPENDOOR, bash an attack on
    // the door (combat.md 6.6 breaks it open), unlock is a Security check at once (as ActionUnlockObject
    // is here: the original walks there first); what is not possible does nothing.
    fn do_door_action { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::DoDoorAction
        let door = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let action = try nwarg::int{ &vm, routine = r, argc, i = 1 }
        let me = self_of{ vm = &vm }
        if not door_possible{ &w, who = me, door, action } { return }
        if action == DOOR_UNLOCK {
            // OPENLOCK in front of what the creature was doing (walk up, Security, then open).
            let mut u = actions::make{ kind = actions::Kind::open_lock }
            u.params[0] = actions::Param::object{ id = door }
            u.params[1] = actions::Param::object{ id = obj::INVALID }
            u.params[2] = actions::Param::int{ v = 0 }
            actions::add_front{ &w, id = me, action = u }
            return
        }
        if action != DOOR_OPEN and action != DOOR_BASH { return }        // ignore does nothing, knock cannot be possible
        let mut a = actions::make{ kind = if action == DOOR_BASH { actions::Kind::attack_object } else { actions::Kind::open_door } }
        a.params[0] = actions::Param::object{ id = door }
        if action == DOOR_BASH { a.params[1] = actions::Param::int{ v = 0 } }
        // In front of what the creature was doing: this is how OnBlocked frees a follower's way.
        actions::add_front{ &w, id = me, action = a }
    }

    // The Security skill on a locked door or placeable: the skill roll against the lock's DC
    // (rules::open_lock_check; no key, no spike). Success unlocks it and tells it UNLOCKED from `who`.
    fn unlock_with_security { mut w: world::World, who: u32, target: u32 } -> bool {
        return unlock_attempt{ &w, who, target, spike_bonus = 0 }
    }

    fn who_is_party { w: *world::World, id: u32 } -> bool { return id == w.pc or id == w.player or party::is_member{ w, id } }

    // The same with a security spike's bonus.
    fn unlock_attempt { mut w: world::World, who: u32, target: u32, spike_bonus: i32 } -> bool {
        let t = world::object{ w = &w, id = target } ifnull { return false }
        let me = world::object{ w = &w, id = who } ifnull { return false }
        let c = obj::creature{ o = me } ifnull { return false }
        let f = c.fighter ifnull { return false }
        let mut dc: i32 = 0
        if t.ext is door{ d } {
            if not d.locked or d.key_required { return false }
            dc = @as(i32, d.open_dc)
        } else if t.ext is placeable{ p } {
            if not p.locked or p.key_required { return false }
            dc = @as(i32, p.open_dc)
        } else { return false }
        let mut check = rules::open_lock_check{ tables = w.rules, c = &f.c, lock_dc = dc, spike_bonus, in_combat = c.in_combat, rng = &w.dice }
        // A security spike in the party's bag helps when the roll alone falls short: the weakest that
        // makes it succeed is used up (the original has the player name the spike when queueing OPENLOCK;
        // which one a player would pick, and when, was not traced, so this is ours).
        let mut spike_item = obj::INVALID
        if not check.success and spike_bonus == 0 and who_is_party{ w = &w, id = who } {
            let mut best: i32 = 1000
            let ids = list::items{ list = w.bag }
            let mut k: usize = 0
            while k < ids.len {
                let b = rt_item::spike_bonus_of{ w = &w, id = ids[k] }
                if b > 0 and b < best and check.total + b >= check.dc and world::is_valid{ w = &w, id = ids[k] } {
                    best = b
                    spike_item = ids[k]
                }
                k = k + 1
            }
            if spike_item != obj::INVALID {
                check = rules::make_check{ total = check.total + best, roll = check.roll, dc = check.dc }
                rt_item::use_up_one{ &w, item = spike_item }
            }
        }
        if w.log.actions {
            let sk = rules::skill::SECURITY
            let mode: []u8 = if c.in_combat { "d20" } else { "take-20" }
            let verdict: []u8 = if check.success { "unlocked" } else { "failed" }
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "security: {} on {} ({}): ranks {} key-ability {} feat {} spike {} + {} {} = {} against DC {}: {}\n", me.tag, t.tag, t.id, f.c.skills[@as(usize, sk)],
                f.c.stats.abil_mod[@as(usize, w.rules.skills[@as(usize, sk)].key_ability)], rules::skill_feat_bonus{ c = &f.c, skill = sk }, spike_bonus,
                mode, check.roll, check.total, check.dc, verdict)
        }
        doors::say_roll{ &w, me, target = t, check, in_combat = c.in_combat }
        if not check.success { return false }
        if t.ext is door{ d } { d.locked = false } else if t.ext is placeable{ p } { p.locked = false }
        events::post{ &w, delay_ms = 0, caller = who, target, payload = events::Payload::script{ e = events::script_event{ kind = events::UNLOCKED, object = who } } }
        return true
    }

    // void ActionUseSkill(int nSkill, object oTarget, int nSubSkill = 0, object oItemUsed = OBJECT_INVALID)
    // (actions.md 3.13, UseSkill 0x004fbe40): a skill the creature does not have does nothing. Stealth
    // toggles stealth mode (kept on the creature; perception does not read it yet), Security opens the
    // target's lock (unlock_with_security). Demolitions queues a trap action on the target (subskill
    // 100 FLAGTRAP, 101 RECOVERTRAP, 102 EXAMINETRAP, else DISABLETRAP; disable and recover refuse a
    // trap that is not disarmable: AddTrapActions 0x004f9da0). Treat Injury (HEAL: medpacs and poisons
    // are not modelled) is not done; the rest are not usable on a target.
    fn action_use_skill { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::ActionUseSkill
        let skill = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let target = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let sub = try nwarg::int{ &vm, routine = r, argc, i = 2 }
        _ = try nwarg::object{ &vm, routine = r, argc, i = 3 }
        let me = self_of{ vm = &vm }
        let o = world::object{ w = &w, id = me } ifnull { return }
        if not o.commandable { return }
        let c = obj::creature{ o } ifnull { return }
        let f = c.fighter ifnull { return }
        if not rt_talent::has_skill{ w = &w, f, skill } { return }
        if skill == rules::skill::STEALTH {
            c.stealth = not c.stealth
        } else if skill == rules::skill::SECURITY {
            _ = unlock_with_security{ &w, who = me, target }
        } else if skill == rules::skill::DEMOLITIONS {
            let t = world::object{ w = &w, id = target } ifnull { return }
            let trap = traps::of{ o = t } ifnull { return }
            let kind = if sub == 100 { actions::Kind::flag_trap } else if sub == 101 { actions::Kind::recover_trap } else if sub == 102 { actions::Kind::examine_trap } else { actions::Kind::disable_trap }
            if (kind == actions::Kind::disable_trap or kind == actions::Kind::recover_trap) and not trap.disarmable { return }
            let mut a = actions::make{ kind }
            a.params[0] = actions::Param::object{ id = target }
            _ = actions::add{ &w, id = me, action = a, force = false }
        } else if w.log.actions {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "ActionUseSkill {} on {}: not implemented\n", skill, target)
        }
    }
}
