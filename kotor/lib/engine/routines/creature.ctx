// Routines: what a creature is and has (race, gender, class, abilities, skills, feats, powers,
// saves, armour class, Force points, hit points, plot and death flags), who likes whom (factions
// and repute.2da), what it is listening for, its alignment and experience, and the nearest-creature
// search. The numbers are the rules creature's (fight::Fighter.c, lib/rules) once it has been read;
// a creature without one answers from the placeholder fields on obj::Creature.
namespace rt_crea {
    fn run { mut w: world::World, mut vm: nwvm::Vm, routine: u16, argc: u8 } -> !bool {
        match routine {
            nwscript::GetRacialType => { try get_creature_field{ &w, &vm, argc, routine, none = nwconst::RACIAL_TYPE_INVALID } }
            nwscript::GetSubRace => { try get_creature_field{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetGender => { try get_creature_field{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetHitDice => { try get_creature_field{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetGoodEvilValue => { try get_creature_field{ &w, &vm, argc, routine, none = -1 } }
            nwscript::GetAlignmentGoodEvil => { try get_creature_field{ &w, &vm, argc, routine, none = -1 } }
            nwscript::GetXP => { try get_creature_field{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetCreatureSize => { try get_creature_field{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetAppearanceType => { try get_creature_field{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetIsDead => { try get_creature_field{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetIsListening => { try get_creature_field{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetIsEncounterCreature => { try get_creature_field{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetClassByPosition => { try get_class_stat{ &w, &vm, argc, routine, none = nwconst::CLASS_TYPE_INVALID } }
            nwscript::GetLevelByPosition => { try get_class_stat{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetLevelByClass => { try get_class_stat{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetHasSkill => { try get_class_stat{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetSkillRank => { try get_class_stat{ &w, &vm, argc, routine, none = -1 } }
            nwscript::GetHasFeat => { try get_class_stat{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetHasSpell => { try get_class_stat{ &w, &vm, argc, routine, none = 0 } }
            nwscript::GetAbilityScore => { try get_ability_score{ &w, &vm, argc } }
            nwscript::GetAbilityModifier => { try get_ability_modifier{ &w, &vm, argc } }
            nwscript::GetCurrentForcePoints => { try get_force_points{ &w, &vm, argc, routine } }
            nwscript::GetMaxForcePoints => { try get_force_points{ &w, &vm, argc, routine } }
            nwscript::GetAC => { try get_armour_class{ &w, &vm, argc } }
            nwscript::GetFortitudeSavingThrow => { try get_base_save{ &w, &vm, argc, routine } }
            nwscript::GetReflexSavingThrow => { try get_base_save{ &w, &vm, argc, routine } }
            nwscript::GetWillSavingThrow => { try get_base_save{ &w, &vm, argc, routine } }
            nwscript::FortitudeSave => { try saving_throw_routine{ &w, &vm, argc, routine } }
            nwscript::ReflexSave => { try saving_throw_routine{ &w, &vm, argc, routine } }
            nwscript::WillSave => { try saving_throw_routine{ &w, &vm, argc, routine } }
            nwscript::GetReflexAdjustedDamage => { try get_reflex_adjusted_damage{ &w, &vm, argc } }
            nwscript::GetSpellSaveDC => { try get_spell_save_dc{ &w, &vm } }
            nwscript::GetCasterLevel => { try get_caster_level{ &w, &vm, argc } }
            nwscript::ResistForce => { try resist_force{ &w, &vm, argc } }
            nwscript::GetChallengeRating => { try get_challenge_rating{ &w, &vm, argc } }
            nwscript::GetCurrentHitPoints => { try get_object_field{ &w, &vm, argc, routine } }
            nwscript::GetMaxHitPoints => { try get_object_field{ &w, &vm, argc, routine } }
            nwscript::GetPlotFlag => { try get_object_field{ &w, &vm, argc, routine } }
            nwscript::GetMinOneHP => { try get_object_field{ &w, &vm, argc, routine } }
            nwscript::SetMaxHitPoints => { try set_object_field{ &w, &vm, argc, routine } }
            nwscript::SetPlotFlag => { try set_object_field{ &w, &vm, argc, routine } }
            nwscript::SetMinOneHP => { try set_object_field{ &w, &vm, argc, routine } }
            nwscript::SetIsDestroyable => { try set_is_destroyable{ &w, &vm, argc } }
            nwscript::GetStandardFaction => { try get_standard_faction{ &w, &vm, argc } }
            nwscript::ChangeToStandardFaction => { try change_to_standard_faction{ &w, &vm, argc } }
            nwscript::GetFactionEqual => { try get_faction_equal{ &w, &vm, argc } }
            nwscript::GetIsEnemy => { try get_reputation_test{ &w, &vm, argc, routine } }
            nwscript::GetIsFriend => { try get_reputation_test{ &w, &vm, argc, routine } }
            nwscript::GetIsNeutral => { try get_reputation_test{ &w, &vm, argc, routine } }
            nwscript::GetFactionAverageReputation => { try get_faction_average_reputation{ &w, &vm, argc } }
            nwscript::GetCreatureMovmentType => { try get_creature_movement_type{ &w, &vm, argc } }
            nwscript::AddMultiClass => { try add_multi_class{ &w, &vm, argc } }
            nwscript::DuplicateHeadAppearance => { try duplicate_head_appearance{ &w, &vm, argc } }
            nwscript::SetListenPattern => { try set_listen_pattern{ &w, &vm, argc } }
            nwscript::SetListening => { try set_listening{ &w, &vm, argc } }
            nwscript::GetNearestCreature => { try get_nearest_creature{ &w, &vm, argc } }
            nwscript::GetSoloMode => { try nwvm::push_int{ &vm, v = 0 } }
            nwscript::AdjustAlignment => { try adjust_alignment{ &w, &vm, argc } }
            nwscript::SetGoodEvilValue => { try set_good_evil_value{ &w, &vm, argc } }
            nwscript::GiveXPToCreature => { try give_xp_to_creature{ &w, &vm, argc } }
            nwscript::SetXP => { try set_xp{ &w, &vm, argc } }
            nwscript::GetName => { try get_name{ &w, &vm, argc } }
            else => { return false }
        }
        return true
    }

    fn creature_of { w: *world::World, id: u32 } -> ?*mut obj::Creature {
        let o = world::object{ w, id } ifnull { return null }
        return obj::creature{ o }
    }

    fn flag { b: bool } -> i32 { return if b { 1 } else { 0 } }

    // The creature's rules state once it has been read (stats, feats, powers, effects); null for a
    // creature that never had one.
    fn rules_of { c: *obj::Creature } -> ?*mut fight::Fighter {
        let f = c.fighter ifnull { return null }
        if not f.loaded { return null }
        return f
    }

    // The creature's rules state by object id, for any kind of object.
    fn fighter_of { w: *world::World, id: u32 } -> ?*mut fight::Fighter {
        let c = creature_of{ w, id } ifnull { return null }
        return rules_of{ c }
    }

    // ---- the fields of a creature

    fn race_of { c: *obj::Creature } -> i32 {
        if rules_of{ c } is some{ value = f } { return f.c.race }
        return @as(i32, c.race)
    }

    fn subrace_of { c: *obj::Creature } -> i32 {
        if rules_of{ c } is some{ value = f } { return f.c.subrace }
        return @as(i32, c.subrace)
    }

    fn gender_of { c: *obj::Creature } -> i32 {
        if rules_of{ c } is some{ value = f } { return f.c.gender }
        return @as(i32, c.gender)
    }

    // The total level.
    fn hit_dice_of { c: *obj::Creature } -> i32 {
        if rules_of{ c } is some{ value = f } {
            if f.c.stats.level > 0 { return f.c.stats.level }
        }
        return @as(i32, c.hit_dice)
    }

    // 0 (dark) .. 100 (light).
    fn good_evil_of { c: *obj::Creature } -> i32 {
        if rules_of{ c } is some{ value = f } { return f.c.good_evil }
        return @as(i32, c.good_evil)
    }

    fn xp_of { c: *obj::Creature } -> i32 {
        if rules_of{ c } is some{ value = f } { return f.c.xp }
        return @as(i32, c.xp)
    }

    // The `int GetX(object oCreature)` routines that read one field of the creature's record;
    // `none` is what a missing or non-creature object gives.
    fn get_creature_field { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16, none: i32 } -> ! {
        let id = try nwarg::object{ &vm, routine, argc, i = 0 }
        let c = creature_of{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = none }
            return
        }
        let v: i32 = match routine {
            nwscript::GetRacialType => { race_of{ c } }
            nwscript::GetSubRace => { subrace_of{ c } }
            nwscript::GetGender => { gender_of{ c } }
            nwscript::GetHitDice => { hit_dice_of{ c } }
            nwscript::GetGoodEvilValue => { good_evil_of{ c } }
            nwscript::GetAlignmentGoodEvil => { rules::alignment_group{ good_evil = good_evil_of{ c } } }
            nwscript::GetXP => { xp_of{ c } }
            nwscript::GetCreatureSize => { size_of{ w = &w, c } }
            nwscript::GetAppearanceType => { @as(i32, c.appearance) }
            nwscript::GetIsDead => { flag{ b = c.dead } }
            nwscript::GetIsListening => { flag{ b = c.listening } }
            else => { 0 }               // GetIsEncounterCreature: ours are never spawned by an encounter
        }
        try nwvm::push_int{ &vm, v }
    }

    // CREATURE_SIZE_*: the rules' size (appearance.2da's category), medium without them.
    fn size_of { w: *world::World, c: *obj::Creature } -> i32 {
        if rules_of{ c } is some{ value = f } { return f.c.stats.size }
        return rules::size_of_appearance{ tables = w.rules, appearance = @as(i32, c.appearance) }
    }

    // ---- classes, skills, feats and powers

    // The `int GetX(int n, object oCreature = OBJECT_SELF)` routines about classes, skills,
    // feats and spells. A creature has up to three classes (position 1..3). Skills, feats and
    // powers are the rules creature's; one without it has none.
    fn get_class_stat { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16, none: i32 } -> ! {
        let n = try nwarg::int{ &vm, routine, argc, i = 0 }
        let id = try nwarg::object{ &vm, routine, argc, i = 1 }
        let c = creature_of{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = none }
            return
        }
        let mut v = none
        if rules_of{ c } is some{ value = f } {
            v = rules_class_stat{ w = &w, f, routine, n, none }
        } else if routine == nwscript::GetClassByPosition {
            if n >= 1 and n <= 3 and c.class_levels[@as(usize, n - 1)] > 0 { v = @as(i32, c.classes[@as(usize, n - 1)]) }
        } else if routine == nwscript::GetLevelByPosition {
            if n >= 1 and n <= 3 { v = @as(i32, c.class_levels[@as(usize, n - 1)]) }
        } else if routine == nwscript::GetLevelByClass {
            let mut k: usize = 0
            v = 0
            while k < 3 {
                if c.class_levels[k] > 0 and @as(i32, c.classes[k]) == n { v = v + @as(i32, c.class_levels[k]) }
                k = k + 1
            }
        } else if routine == nwscript::GetSkillRank {
            v = 0
        }
        try nwvm::push_int{ &vm, v }
    }

    fn rules_class_stat { w: *world::World, f: *fight::Fighter, routine: u16, n: i32, none: i32 } -> i32 {
        if routine == nwscript::GetClassByPosition {
            if n >= 1 and n <= f.c.nclasses and n <= 3 and f.c.classes[@as(usize, n - 1)].level > 0 { return f.c.classes[@as(usize, n - 1)].class }
            return none
        }
        if routine == nwscript::GetLevelByPosition {
            if n >= 1 and n <= f.c.nclasses and n <= 3 { return f.c.classes[@as(usize, n - 1)].level }
            return 0
        }
        if routine == nwscript::GetLevelByClass { return rules::class_level{ c = &f.c, class = n } }
        if routine == nwscript::GetSkillRank {
            // skills.2da: the ranks, the effects, the key ability, the feat line; 0 for an untrained
            // skill that needs training, -1 for no such skill.
            if n < 0 or n >= @as(i32, rules::NUM_SKILLS) { return -1 }
            return rules::skill_rank{ tables = w.rules, c = &f.c, skill = n, vs = rules::no_versus{}, base_only = false }
        }
        if routine == nwscript::GetHasSkill { return flag{ b = rt_talent::has_skill{ w, f, skill = n } } }
        if routine == nwscript::GetHasFeat { return flag{ b = rules::has_feat{ c = &f.c, feat = n } } }
        return flag{ b = rules::knows_power{ c = &f.c, spell = n } }               // GetHasSpell
    }

    // ---- abilities

    // int GetAbilityScore(object oCreature, int nAbilityType): 0 STR .. 5 CHA, with the effects.
    fn get_ability_score { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::GetAbilityScore
        let id = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let kind = try nwarg::int{ &vm, routine = r, argc, i = 1 }
        let c = creature_of{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        try nwvm::push_int{ &vm, v = ability_score{ c, kind } }
    }

    fn ability_score { c: *obj::Creature, kind: i32 } -> i32 {
        if kind < 0 or kind >= 6 { return 0 }
        if rules_of{ c } is some{ value = f } { return f.c.stats.abil[@as(usize, kind)] }
        return @as(i32, c.abilities[@as(usize, kind)])
    }

    // int GetAbilityModifier(int nAbility, object oCreature = OBJECT_SELF)
    fn get_ability_modifier { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::GetAbilityModifier
        let kind = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let id = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let c = creature_of{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        if kind < 0 or kind >= 6 {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        if rules_of{ c } is some{ value = f } {
            try nwvm::push_int{ &vm, v = f.c.stats.abil_mod[@as(usize, kind)] }
            return
        }
        try nwvm::push_int{ &vm, v = rules::ability_modifier{ score = ability_score{ c, kind } } }
    }

    // ---- Force points, armour class, saves

    // int GetCurrentForcePoints(object oObject = OBJECT_SELF) (the pool and the temporary pool),
    // int GetMaxForcePoints(object oObject = OBJECT_SELF)
    fn get_force_points { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16 } -> ! {
        let id = try nwarg::object{ &vm, routine, argc, i = 0 }
        let f = fighter_of{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        try nwvm::push_int{ &vm, v = if routine == nwscript::GetCurrentForcePoints { f.c.fp + f.c.temp_fp } else { f.c.stats.max_fp } }
    }

    // int GetAC(object oObject, int nForFutureUse = 0): a creature's armour class (the sheet's: the
    // armour, shield, natural, class, deflection, dodge and capped DEX pieces), 0 for a door,
    // placeable or item, -1 for anything else.
    fn get_armour_class { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetAC, argc, i = 0 }
        _ = try nwarg::int{ &vm, routine = nwscript::GetAC, argc, i = 1 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = -1 }
            return
        }
        if obj::creature{ o } is some{ value = c } {
            if rules_of{ c } is some{ value = f } {
                try nwvm::push_int{ &vm, v = rules::armor_class_sheet{ tables = w.rules, c = &f.c } }
            } else {
                try nwvm::push_int{ &vm, v = 10 }
            }
            return
        }
        try nwvm::push_int{ &vm, v = if o.kind == obj::Kind::door or o.kind == obj::Kind::placeable or o.kind == obj::Kind::item { 0 } else { -1 } }
    }

    // int GetFortitudeSavingThrow / GetReflexSavingThrow / GetWillSavingThrow(object oTarget): the
    // base value, without the effects (rules.md 2.1).
    fn get_base_save { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16 } -> ! {
        let id = try nwarg::object{ &vm, routine, argc, i = 0 }
        let f = fighter_of{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        let which: usize = if routine == nwscript::GetFortitudeSavingThrow { 0 } else if routine == nwscript::GetReflexSavingThrow { 1 } else { 2 }
        try nwvm::push_int{ &vm, v = f.c.stats.save_base[which] }
    }

    // Whether the script's caller is casting a Force power or special ability now (death saves are
    // then blocked by death immunity, rules.md 2.2): its spell id is a spells.2da UserType 1 or 2.
    fn casting_power { w: *world::World, me: u32 } -> bool {
        let o = world::object{ w, id = me } ifnull { return false }
        let row = rules::get_spell{ tables = w.rules, row = o.ctx.spell_id } ifnull { return false }
        return row.user_type == 1 or row.user_type == 2
    }

    // A save roll of creature `id`: 0 failed, 1 passed, 2 immune (0 for anything that is not a
    // creature with stats). `which`: rules::save::FORT, REFLEX or WILL.
    fn roll_save { mut w: world::World, id: u32, which: i32, dc: i32, save_type: i32, versus: u32, me: u32 } -> i32 {
        let f = fighter_of{ w = &w, id } ifnull { return 0 }
        let mut vs = rules::no_versus{}
        if fighter_of{ w = &w, id = versus } is some{ value = vf } { vs = rules::versus_creature{ c = &vf.c } }
        let power = casting_power{ w = &w, me }
        let res = rules::saving_throw{ c = &f.c, which, dc, save_type, vs, force_power = power, rng = &w.dice }
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "save {} of {} vs DC {}: d20 {} + {} + {} = {}\n", which, id, dc, res.roll, res.bonus, res.base, res.result)
        }
        return res.result
    }

    // int FortitudeSave / ReflexSave / WillSave(object oCreature, int nDC, int nSaveType = 0,
    //     object oSaveVersus = OBJECT_SELF)
    fn saving_throw_routine { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16 } -> ! {
        let id = try nwarg::object{ &vm, routine, argc, i = 0 }
        let dc = try nwarg::int{ &vm, routine, argc, i = 1 }
        let save_type = try nwarg::int{ &vm, routine, argc, i = 2 }
        let versus = try nwarg::object{ &vm, routine, argc, i = 3 }
        let which = if routine == nwscript::FortitudeSave { rules::save::FORT } else if routine == nwscript::ReflexSave { rules::save::REFLEX } else { rules::save::WILL }
        try nwvm::push_int{ &vm, v = roll_save{ &w, id, which, dc, save_type, versus, me = nwvm::self_object{ vm } } }
    }

    // int GetReflexAdjustedDamage(int nDamage, object oTarget, int nDC, int nSaveType = 0,
    //     object oSaveVersus = OBJECT_SELF): a passed reflex save halves the damage, an immune
    // target takes none (KOTOR has no evasion feat).
    fn get_reflex_adjusted_damage { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::GetReflexAdjustedDamage
        let damage = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let id = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let dc = try nwarg::int{ &vm, routine = r, argc, i = 2 }
        let save_type = try nwarg::int{ &vm, routine = r, argc, i = 3 }
        let versus = try nwarg::object{ &vm, routine = r, argc, i = 4 }
        let result = roll_save{ &w, id, which = rules::save::REFLEX, dc, save_type, versus, me = nwvm::self_object{ vm } }
        try nwvm::push_int{ &vm, v = if result == 1 { damage / 2 } else if result == 2 { 0 } else { damage } }
    }

    // ---- Force powers: the DC, the caster level, resistance

    // int GetSpellSaveDC(): 5 + the caster's level + WIS and CHA modifiers + Force Focus, for the
    // creature running the script; 14 without a caster (rules.md 3.5).
    fn get_spell_save_dc { mut w: world::World, mut vm: nwvm::Vm } -> ! {
        let f = fighter_of{ w = &w, id = nwvm::self_object{ vm } } ifnull {
            try nwvm::push_int{ &vm, v = rules::DC_NO_CASTER }
            return
        }
        try nwvm::push_int{ &vm, v = rules::force_power_dc{ c = &f.c } }
    }

    // int GetCasterLevel(object oCreature): the creature's total level.
    fn get_caster_level { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetCasterLevel, argc, i = 0 }
        let c = creature_of{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        try nwvm::push_int{ &vm, v = hit_dice_of{ c } }
    }

    // int ResistForce(object oSource, object oTarget): TRUE when the target's Force resistance or a
    // spell immunity turned the caster's power (the script's current spell) away (rules.md 3.6).
    fn resist_force { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::ResistForce
        let source = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let target = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let tf = fighter_of{ w = &w, id = target } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        let so = world::object{ w = &w, id = source } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        let mut level = 10
        if obj::creature{ o = so } is some{ value = sc } { level = hit_dice_of{ c = sc } }
        let me = world::object{ w = &w, id = nwvm::self_object{ vm } }
        let mut spell = -1
        if me != null { spell = me.ctx.spell_id }
        let res = rules::resist_force{ tables = w.rules, target = &tf.c, spell, caster_level = level, rng = &w.dice }
        try nwvm::push_int{ &vm, v = flag{ b = res != rules::resist::NONE } }
    }

    // float GetChallengeRating(object oCreature)
    fn get_challenge_rating { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetChallengeRating, argc, i = 0 }
        let f = fighter_of{ w = &w, id } ifnull {
            try nwvm::push_float{ &vm, v = 0.0 }
            return
        }
        try nwvm::push_float{ &vm, v = f.c.challenge }
    }

    // The `int GetX(object oObject = OBJECT_SELF)` routines on the common header, which every
    // kind has (doors and placeables have hit points and plot flags too).
    fn get_object_field { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16 } -> ! {
        let id = try nwarg::object{ &vm, routine, argc, i = 0 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        let v: i32 = match routine {
            nwscript::GetCurrentHitPoints => { o.hp + o.hp_temp }
            nwscript::GetMaxHitPoints => { o.hp_max }
            nwscript::GetPlotFlag => { flag{ b = o.plot } }
            else => { flag{ b = o.min_one_hp } }       // GetMinOneHP
        }
        try nwvm::push_int{ &vm, v }
    }

    // void SetMaxHitPoints(object, int), SetPlotFlag(object, int), SetMinOneHP(object, int).
    // SetMaxHitPoints sets the current points too (nwscript.nss).
    fn set_object_field { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16 } -> ! {
        let id = try nwarg::object{ &vm, routine, argc, i = 0 }
        let n = try nwarg::int{ &vm, routine, argc, i = 1 }
        let o = world::object{ w = &w, id } ifnull { return }
        if routine == nwscript::SetMaxHitPoints {
            if n < 1 { return }
            o.hp_max = n
            o.hp = n
        } else if routine == nwscript::SetPlotFlag {
            o.plot = n != 0
        } else {
            o.min_one_hp = n != 0
        }
    }

    // void SetIsDestroyable(int bDestroyable, int bRaiseable = TRUE, int bSelectableWhenDead = FALSE):
    // about OBJECT_SELF; recorded for the death handling (HOOK(rules)).
    fn set_is_destroyable { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::SetIsDestroyable
        let destroyable = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let raiseable = try nwarg::int{ &vm, routine = r, argc, i = 1 }
        let selectable = try nwarg::int{ &vm, routine = r, argc, i = 2 }
        let c = creature_of{ w = &w, id = nwvm::self_object{ vm } } ifnull { return }
        c.destroyable = destroyable != 0
        c.raiseable = raiseable != 0
        c.selectable_dead = selectable != 0
    }

    // ---- factions

    // repute.2da has one row per standard faction (0 is the player's) and, after the label, one
    // column per faction from 1. A cell is how the row's faction feels about the column's.
    const STANDARD_FACTIONS: u32 = 21

    // repute.2da parsed into the frame's scratch memory; null when it cannot be read.
    // (World could cache it once: see the report.)
    fn repute_table { mut w: world::World } -> ?twoda::Table {
        let found = world::read_scratch{ &w, name = "repute", kind = restype::Type::twoda } iferr { return null }
        let bytes = found ifnull { return null }
        let t = twoda::parse{ data = bytes, realloc = arena::alloc, heap = w.scratch } iferr { return null }
        return t
    }

    // How faction `from` feels about faction `toward`, 0..100: 100 for itself, and 50 (neutral)
    // for a faction the table lacks (custom ones, until repute.fac is read). The table has no
    // column for the player, so what the player's row says about `from` stands for it.
    fn standing { t: ?twoda::Table, from: u32, toward: u32 } -> i32 {
        if from == toward { return 100 }
        let table = t ifnull { return 50 }
        if from >= STANDARD_FACTIONS or toward >= STANDARD_FACTIONS { return 50 }
        let mut row = @as(usize, from)
        let mut col = @as(usize, toward)
        if toward == 0 {
            row = 0
            col = @as(usize, from)
        }
        return twoda::get_int_at{ t = table, row, col } ifnull 50
    }

    // int GetStandardFaction(object oObject)
    fn get_standard_faction { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetStandardFaction, argc, i = 0 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = nwconst::INVALID_STANDARD_FACTION }
            return
        }
        try nwvm::push_int{ &vm, v = if o.faction < STANDARD_FACTIONS { @as(i32, o.faction) } else { nwconst::INVALID_STANDARD_FACTION } }
    }

    // void ChangeToStandardFaction(object oCreatureToChange, int nStandardFaction)
    fn change_to_standard_faction { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::ChangeToStandardFaction
        let id = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let faction = try nwarg::int{ &vm, routine = r, argc, i = 1 }
        let o = world::object{ w = &w, id } ifnull { return }
        if obj::creature{ o } == null or faction < 0 or faction >= @as(i32, STANDARD_FACTIONS) { return }
        o.faction = @as(u32, faction)
    }

    // int GetFactionEqual(object oFirstObject, object oSecondObject = OBJECT_SELF)
    fn get_faction_equal { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::GetFactionEqual
        let a = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let b = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let oa = world::object{ w = &w, id = a } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        let ob = world::object{ w = &w, id = b } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        try nwvm::push_int{ &vm, v = flag{ b = oa.faction == ob.faction } }
    }

    // int GetIsEnemy / GetIsFriend / GetIsNeutral(object oTarget, object oSource = OBJECT_SELF):
    // what oSource's faction feels about oTarget's: enemy up to 10, friend from 90 (the game's
    // thresholds, 0x00537ce0), neutral between. An object that is not there is none of them.
    fn get_reputation_test { mut w: world::World, mut vm: nwvm::Vm, argc: u8, routine: u16 } -> ! {
        let target = try nwarg::object{ &vm, routine, argc, i = 0 }
        let source = try nwarg::object{ &vm, routine, argc, i = 1 }
        let ot = world::object{ w = &w, id = target } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        let os = world::object{ w = &w, id = source } ifnull {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        let rep = if ot.id == os.id { 100 } else { world::standing{ w = &w, from = os.faction, toward = ot.faction } }
        let yes = if routine == nwscript::GetIsEnemy { rep <= 10 }
            else if routine == nwscript::GetIsFriend { rep >= 90 }
            else { rep > 10 and rep < 90 }
        try nwvm::push_int{ &vm, v = flag{ b = yes } }
    }

    // int GetFactionAverageReputation(object oSourceFactionMember, object oTarget): 0..100, how the
    // source's faction feels about the target (the NWN average of each member's own feeling; there
    // are no personal standings here, so it is the faction row, as GetIsEnemy reads it), -1 when
    // either is not there.
    fn get_faction_average_reputation { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::GetFactionAverageReputation
        let source = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let target = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let os = world::object{ w = &w, id = source } ifnull {
            try nwvm::push_int{ &vm, v = -1 }
            return
        }
        let ot = world::object{ w = &w, id = target } ifnull {
            try nwvm::push_int{ &vm, v = -1 }
            return
        }
        try nwvm::push_int{ &vm, v = world::standing{ w = &w, from = os.faction, toward = ot.faction } }
    }

    // int GetCreatureMovmentType(object oidCreature): the creaturespeed.2da row (MOVEMENT_SPEED_*) of
    // the creature's rate: the player's own character is 0 (PC_Movement), any other the row whose
    // 2daname is its appearance's moverate (Normal, 4, when the table has none), and an object that
    // is not a creature is MOVEMENT_SPEED_IMMOBILE (1). Effects that slow or hold it do not show.
    fn get_creature_movement_type { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetCreatureMovmentType, argc, i = 0 }
        let c = creature_of{ w = &w, id } ifnull {
            try nwvm::push_int{ &vm, v = 1 }
            return
        }
        if c.is_pc {
            try nwvm::push_int{ &vm, v = 0 }
            return
        }
        let rate = twoda::get_string{ t = w.tables.appearance, row = @as(usize, c.appearance), column = "moverate" } ifnull "NORM"
        let speeds = w.tables.creaturespeed
        let n = twoda::rows{ t = speeds }
        let mut i: usize = 0
        while i < n {
            let name = twoda::get_string{ t = speeds, row = i, column = "2daname" } ifnull ""
            if ci::eq{ a = name, b = rate } {
                try nwvm::push_int{ &vm, v = @as(i32, i) }
                return
            }
            i = i + 1
        }
        try nwvm::push_int{ &vm, v = 4 }
    }

    // void AddMultiClass(int nClassType, object oSource): a new class on the creature, at level 0
    // (the class of the next level-up: k_pdan_makejedi calls it, then raises the level; ShowLevelUpGUI).
    // The rules' creature gets the slot, and the placeholder class list the class; both hide a class
    // of level 0 from GetClassByPosition and GetLevelByClass until it has a level. Nothing happens for
    // an unknown class, a class it has, or a third slot (LevelUp's limit, rules.md).
    fn add_multi_class { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::AddMultiClass
        let class = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let id = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let c = creature_of{ w = &w, id } ifnull { return }
        let f = c.fighter ifnull { return }
        if rules::get_class{ tables = w.rules, row = class } == null { return }
        if rules::class_slot_of{ c = &f.c, class } >= 0 { return }
        if f.c.nclasses >= rules::MAX_LEVEL_CLASSES { return }
        let at = @as(usize, f.c.nclasses)
        f.c.classes[at] = rules::ClassSlot{ class, level = 0 }
        f.c.nclasses = f.c.nclasses + 1
        if at < 3 { c.classes[at] = @as(u32, class) }
    }

    // void DuplicateHeadAppearance(object oidCreatureToChange, object oidCreatureToMatch): the first
    // gets the second's head (its heads.2da row: its own if it was given one, else its appearance's
    // normalhead). The row is kept on the creature (head); scene/visual.ctx builds a head from the
    // appearance only so far and should prefer a head of 0 or more.
    fn duplicate_head_appearance { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::DuplicateHeadAppearance
        let change = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let match_with = try nwarg::object{ &vm, routine = r, argc, i = 1 }
        let a = creature_of{ w = &w, id = change } ifnull { return }
        let b = creature_of{ w = &w, id = match_with } ifnull { return }
        a.head = if b.head >= 0 { b.head }
            else { twoda::get_int{ t = w.tables.appearance, row = @as(usize, b.appearance), column = "normalhead" } ifnull -1 }
    }

    // ---- listening

    // void SetListenPattern(object oObject, string sPattern, int nNumber = 0): remembered on the
    // creature (up to four patterns; one already there takes the new number). Nothing says what
    // was heard yet, so it only records.
    fn set_listen_pattern { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::SetListenPattern
        let id = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let pattern = try nwarg::string{ &vm, routine = r, argc, i = 1 }
        let number = try nwarg::int{ &vm, routine = r, argc, i = 2 }
        let c = creature_of{ w = &w, id } ifnull { return }
        let n = if pattern.len < 32 { pattern.len } else { 32 }
        let mut slot: usize = @as(usize, c.listen_count)
        let mut k: usize = 0
        while k < @as(usize, c.listen_count) {
            if @as(usize, c.listen_len[k]) == n and ci::eq{ a = c.listen_text[k][0..n], b = pattern[0..n] } { slot = k }
            k = k + 1
        }
        if slot >= 4 { slot = 3 }
        if slot == @as(usize, c.listen_count) { c.listen_count = c.listen_count + 1 }
        k = 0
        while k < n {
            c.listen_text[slot][k] = pattern[k]
            k = k + 1
        }
        c.listen_len[slot] = @trunc(u8, n)
        c.listen_number[slot] = number
    }

    // void SetListening(object oObject, int bValue)
    fn set_listening { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::SetListening, argc, i = 0 }
        let on = try nwarg::int{ &vm, routine = nwscript::SetListening, argc, i = 1 }
        let c = creature_of{ w = &w, id } ifnull { return }
        c.listening = on != 0
    }

    // ---- alignment and experience

    // The creature's good-evil value (0 dark .. 100 light) set, in the rules creature and on the
    // object, and the light or dark mastery bonuses put on or taken off as it crosses 100 or 0.
    fn set_alignment { mut w: world::World, id: u32, to: i32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let v = if to < 0 { 0 } else if to > 100 { 100 } else { to }
        c.good_evil = @as(u32, v)
        if rules_of{ c } is some{ value = f } {
            f.c.good_evil = v
            fight::sync_flags{ w = &w, o, f }
            rules::clear_events{ ev = &w.rev }
            rules::update_alignment_mastery{ env = fight::env_of{ w = &w, o }, c = &f.c, ids = &w.fx_ids, rng = &w.dice, ev = &w.rev }
            fight::drain{ &w, id }
        }
    }

    // void AdjustAlignment(object oSubject, int nAlignment, int nShift): good is 100, evil 0.
    // Light shifts up, dark down, neutral towards 50 and no further.
    fn adjust_alignment { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::AdjustAlignment
        let id = try nwarg::object{ &vm, routine = r, argc, i = 0 }
        let alignment = try nwarg::int{ &vm, routine = r, argc, i = 1 }
        let shift = try nwarg::int{ &vm, routine = r, argc, i = 2 }
        let c = creature_of{ w = &w, id } ifnull { return }
        let now = good_evil_of{ c }
        let mut v = now
        if alignment == nwconst::ALIGNMENT_LIGHT_SIDE { v = now + shift }
        else if alignment == nwconst::ALIGNMENT_DARK_SIDE { v = now - shift }
        else if alignment == nwconst::ALIGNMENT_NEUTRAL {
            if now > 50 { v = if now - shift < 50 { 50 } else { now - shift } }
            else if now < 50 { v = if now + shift > 50 { 50 } else { now + shift } }
        }
        set_alignment{ &w, id, to = v }
    }

    // void SetGoodEvilValue(object oCreature, int nAlignment)
    fn set_good_evil_value { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::SetGoodEvilValue, argc, i = 0 }
        let to = try nwarg::int{ &vm, routine = nwscript::SetGoodEvilValue, argc, i = 1 }
        set_alignment{ &w, id, to }
    }

    // XP to the party (CSWPartyTable::AddExperience, rules.md 4.2): the pool takes all of it; each
    // member is credited its share (npc.2da PercentXP: 80 for a companion, 100 for the player) of it
    // times the general XP percentage, rounded up (rules::add_experience), in the rules creature
    // and on the object. Levelling is the level-up screen's.
    fn give_party_xp { mut w: world::World, amount: i32 } {
        if amount <= 0 { return }
        let pool = @as(i64, w.party.xp_pool) + @as(i64, amount)
        w.party.xp_pool = if pool > 2000000000 { 2000000000 } else { @trunc(i32, pool) }
        let members = party::members{ w = &w }
        let mut i: usize = 0
        while i < members.len {
            let id = members[i]
            i = i + 1
            let c = creature_of{ w = &w, id } ifnull { continue }
            let slot = party::slot_of{ w = &w, id }
            let share = rules::npc_percent_xp{ tables = w.rules, row = slot }
            if rules_of{ c } is some{ value = f } {
                _ = rules::add_experience{ tables = w.rules, c = &f.c, xp = amount, percent_xp = share }
                c.xp = @as(u32, f.c.xp)
            } else {
                let got = rules::scale_experience{ tables = w.rules, xp = amount, percent_xp = share }
                let total = @as(i64, c.xp) + @as(i64, got)
                c.xp = if total > 4000000000 { 4000000000 } else { @trunc(u32, total) }
            }
        }
        levelup::after_xp{ &w }
    }

    // void GiveXPToCreature(object oCreature, int nXpAmount): the creature only has to be one; the
    // amount goes to the whole party (GiveXPToCreature, 0x0053e750).
    fn give_xp_to_creature { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GiveXPToCreature, argc, i = 0 }
        let amount = try nwarg::int{ &vm, routine = nwscript::GiveXPToCreature, argc, i = 1 }
        if creature_of{ w = &w, id } == null { return }
        give_party_xp{ &w, amount }
    }

    // void SetXP(object oCreature, int nXpAmount): XP never goes down ("Cannot reduce XP",
    // SetExperience 0x005af480).
    fn set_xp { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::SetXP, argc, i = 0 }
        let amount = try nwarg::int{ &vm, routine = nwscript::SetXP, argc, i = 1 }
        let c = creature_of{ w = &w, id } ifnull { return }
        if amount <= xp_of{ c } { return }
        c.xp = @as(u32, amount)
        if rules_of{ c } is some{ value = f } { f.c.xp = amount }
    }

    // ---- names

    // string GetName(object oObject): the dialog.tlk text of a strref name, else the name's own
    // text. An area's name is the ARE's.
    fn get_name { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let id = try nwarg::object{ &vm, routine = nwscript::GetName, argc, i = 0 }
        let o = world::object{ w = &w, id } ifnull {
            try nwvm::push_string{ &vm, s = "" }
            return
        }
        let mut name = o.name
        if obj::area{ o } is some{ value = a } { name = a.name }
        if name.strref != 0xFFFFFFFF {
            let text = world::string_by_strref{ w = &w, strref = name.strref }
            if text.len > 0 {
                try nwvm::push_string{ &vm, s = text }
                return
            }
        }
        try nwvm::push_string{ &vm, s = name.text }
    }

    // ---- the nearest creature

    // Whether creature `o` meets one CREATURE_TYPE_* criterion (-1 and unknown types: all do).
    // Perception criteria read lib/engine/perception.ctx; no creature has a spell effect yet
    // (effects are not kept: rt_fx, HOOK(rules)).
    fn meets { w: *world::World, repute: ?twoda::Table, from: *obj::Object, o: *obj::Object, c: *obj::Creature, t: i32, v: i32 } -> bool {
        match t {
            nwconst::CREATURE_TYPE_RACIAL_TYPE => { return @as(i32, c.race) == v }
            nwconst::CREATURE_TYPE_PLAYER_CHAR => {
                let pc = o.id == w.pc or c.is_pc
                return if v == nwconst::PLAYER_CHAR_IS_PC { pc } else { not pc }
            }
            nwconst::CREATURE_TYPE_CLASS => {
                let mut k: usize = 0
                while k < 3 {
                    if c.class_levels[k] > 0 and @as(i32, c.classes[k]) == v { return true }
                    k = k + 1
                }
                return false
            }
            nwconst::CREATURE_TYPE_REPUTATION => {
                let rep = world::standing{ w, from = from.faction, toward = o.faction }
                if v == nwconst::REPUTATION_TYPE_FRIEND { return rep >= 90 }
                if v == nwconst::REPUTATION_TYPE_ENEMY { return rep <= 10 }
                return rep > 10 and rep < 90
            }
            nwconst::CREATURE_TYPE_IS_ALIVE => { return if v != 0 { is_alive{ w, o, c } } else { not is_alive{ w, o, c } } }
            nwconst::CREATURE_TYPE_HAS_SPELL_EFFECT => { return false }
            nwconst::CREATURE_TYPE_DOES_NOT_HAVE_SPELL_EFFECT => { return true }
            nwconst::CREATURE_TYPE_PERCEPTION => {
                let e = perception::entry_of{ w, viewer = from.id, target = o.id }
                let seen = e != null and e.seen
                let heard = e != null and e.heard
                match v {
                    nwconst::PERCEPTION_SEEN_AND_HEARD => { return seen and heard }
                    nwconst::PERCEPTION_NOT_SEEN_AND_NOT_HEARD => { return not seen and not heard }
                    nwconst::PERCEPTION_HEARD_AND_NOT_SEEN => { return heard and not seen }
                    nwconst::PERCEPTION_SEEN_AND_NOT_HEARD => { return seen and not heard }
                    nwconst::PERCEPTION_NOT_HEARD => { return not heard }
                    nwconst::PERCEPTION_HEARD => { return heard }
                    nwconst::PERCEPTION_NOT_SEEN => { return not seen }
                    nwconst::PERCEPTION_SEEN => { return seen }
                    else => { return true }
                }
            }
            else => { return true }
        }
    }

    // Neither dead nor a party member who is down (GetDead, GetIsDying): what GetNearestCreature
    // returns unless CREATURE_TYPE_IS_ALIVE asks otherwise (0x0054b550 tests both after the criteria),
    // so the AI does not pick a downed companion as its target.
    fn is_alive { w: *world::World, o: *obj::Object, c: *obj::Creature } -> bool {
        if c.dead { return false }
        return not (o.hp < 1 and party::is_member{ w, id = o.id })
    }

    // object GetNearestCreature(int nFirstCriteriaType, int nFirstCriteriaValue,
    //     object oTarget = OBJECT_SELF, int nNth = 1, int nSecondCriteriaType = -1,
    //     int nSecondCriteriaValue = -1, int nThirdCriteriaType = -1, int nThirdCriteriaValue = -1)
    // The nth nearest creature (other than oTarget) in oTarget's area meeting every criterion.
    fn get_nearest_creature { mut w: world::World, mut vm: nwvm::Vm, argc: u8 } -> ! {
        let r = nwscript::GetNearestCreature
        let t1 = try nwarg::int{ &vm, routine = r, argc, i = 0 }
        let v1 = try nwarg::int{ &vm, routine = r, argc, i = 1 }
        let target = try nwarg::object{ &vm, routine = r, argc, i = 2 }
        let nth = try nwarg::int{ &vm, routine = r, argc, i = 3 }
        let t2 = try nwarg::int{ &vm, routine = r, argc, i = 4 }
        let v2 = try nwarg::int{ &vm, routine = r, argc, i = 5 }
        let t3 = try nwarg::int{ &vm, routine = r, argc, i = 6 }
        let v3 = try nwarg::int{ &vm, routine = r, argc, i = 7 }
        let from = world::object{ w = &w, id = target } ifnull {
            try nwvm::push_object{ &vm, id = obj::INVALID }
            return
        }
        let wants_reputation = t1 == nwconst::CREATURE_TYPE_REPUTATION or t2 == nwconst::CREATURE_TYPE_REPUTATION
            or t3 == nwconst::CREATURE_TYPE_REPUTATION
        let repute: ?twoda::Table = if wants_reputation { repute_table{ &w } } else { null }
        let asks_alive = t1 == nwconst::CREATURE_TYPE_IS_ALIVE or t2 == nwconst::CREATURE_TYPE_IS_ALIVE
            or t3 == nwconst::CREATURE_TYPE_IS_ALIVE
        let all = list::items{ list = w.objects.all }
        let mut last: f32 = -1.0
        let mut last_id: u32 = 0
        let mut k: i32 = 0
        while k < nth {
            let mut best = obj::INVALID
            let mut best_d: f32 = 1000000000.0
            let mut i: usize = 0
            while i < all.len {
                let o = all[i]
                i = i + 1
                if o.destroyed or o.id == from.id or o.area != from.area { continue }
                let c = obj::creature{ o } ifnull { continue }
                if not meets{ w = &w, repute, from, o, c, t = t1, v = v1 } { continue }
                if not meets{ w = &w, repute, from, o, c, t = t2, v = v2 } { continue }
                if not meets{ w = &w, repute, from, o, c, t = t3, v = v3 } { continue }
                if not asks_alive and not is_alive{ w = &w, o, c } { continue }
                let d = rt_obj::distance{ a = o.position, b = from.position, flat = false }
                // Strictly after the previous pick in (distance, id) order.
                if d < last or (d == last and o.id <= last_id) { continue }
                if d < best_d or (d == best_d and o.id < best) {
                    best = o.id
                    best_d = d
                }
            }
            if best == obj::INVALID {
                try nwvm::push_object{ &vm, id = obj::INVALID }
                return
            }
            last = best_d
            last_id = best
            k = k + 1
        }
        try nwvm::push_object{ &vm, id = if nth < 1 { obj::INVALID } else { last_id } }
    }
}
