// The engine as the NWScript VM sees it (docs/design/engine.md, "Routines: many hands, one
// dispatcher"): `call` is the nwvm::Engine, bound once to the world; `dispatch` calls the
// category file that implements the routine, found by asking each in turn the first time it is
// called. One file per category, one namespace per file (rt_*), each with
//
//   fn run { mut w: world::World, mut vm: nwvm::Vm, routine: u16, argc: u8 } -> !bool
//
// returning false for routines it doesn't have. To add a category, add its `run` to
// `categories`; to add a routine, add it to its category's `run` (see engine.md for the
// checklist).
namespace routines {
    // A category file's `run`.
    type Category = fn{ mut w: world::World, mut vm: nwvm::Vm, routine: u16, argc: u8 } -> !bool

    // The nwvm::Engine: `let engine = routines::call{ w = world_ptr, _ }`.
    fn call { mut w: world::World, mut vm: nwvm::Vm, call: nwvm::Call } -> nwvm::Reply {
        match call {
            action{ routine, argc } => {
                dispatch{ &w, &vm, routine, argc } iferr { return nwvm::Reply::failed }
                return nwvm::Reply::done
            }
            equal{ kind, a, b } => { return nwvm::Reply::equal{ same = values::equal{ s = &w.values, kind, a, b } } }
        }
    }

    fn dispatch { mut w: world::World, mut vm: nwvm::Vm, routine: u16, argc: u8 } -> ! {
        if routine >= nwscript::COUNT {
            nwvm::fail{ &vm, why = "no such routine" }
            return nwvm::underflow
        }
        let r = @as(usize, routine)
        w.stats.calls[r] = w.stats.calls[r] + 1
        let sp = vm.sp
        let done = try categories{ &w, &vm, routine, argc }
        if not done {
            w.stats.missing[r] = w.stats.missing[r] + 1
            try nwstub::fallback{ &vm, routine, argc }
        }
        if w.log.routines { log_call{ &w, vm = &vm, routine, argc, sp, done } }
        check_balance{ &w, vm = &vm, routine, argc, sp }
    }

    // Every handler must leave the stack as the prototype says: the arguments the script passed
    // gone, the result pushed. A handler that doesn't misaligns the script's stack silently, so
    // it is reported (once per routine) as a bug of that category.
    fn check_balance { mut w: world::World, vm: *nwvm::Vm, routine: u16, argc: u8, sp: u32 } {
        let r = nwscript::ROUTINES[@as(usize, routine)]
        let mut args: u32 = 0
        let mut i: usize = 0
        while i < @as(usize, argc) and i < @as(usize, r.count) {
            args = args + cells_of{ t = nwscript::PARAMS[@as(usize, r.first) + i].kind }
            i = i + 1
        }
        let want = @as(i64, sp) - @as(i64, args) + @as(i64, cells_of{ t = r.ret })
        if @as(i64, vm.sp) == want { return }
        let k = @as(usize, routine)
        if w.stats.unbalanced[k] { return }
        w.stats.unbalanced[k] = true
        world::prefix{ w = &w }
        _ = @fmt(&w.io, "BUG: routine {} left {} stack cells, wanted {}\n", r.name, @as(i64, vm.sp) - @as(i64, sp), want - @as(i64, sp))
    }

    fn cells_of { t: nwscript::Type } -> u32 {
        match t {
            void | action => { return 0 }
            vector => { return 3 }
            else => { return 1 }
        }
    }

    // The category file that implements the routine. Its first call asks each in turn, and
    // w.routes keeps the one that took it (or `none`) for its later calls.
    fn categories { mut w: world::World, mut vm: nwvm::Vm, routine: u16, argc: u8 } -> !bool {
        let r = @as(usize, routine)
        let known = w.routes[r]
        if known != null { return known{ &w, &vm, routine, argc } }
        // Add a new category file's `run` here.
        let all: [21]Category = [
            rt_core::run, rt_vars::run, rt_obj::run, rt_cmd::run, rt_act::run, rt_party::run,
            rt_pres::run, rt_perc::run, rt_time::run, rt_mod::run, rt_galaxy::run, rt_crea::run,
            rt_item::run, rt_fx::run, rt_fight::run, rt_dlg::run, rt_talent::run, rt_combat::run,
            rt_misc::run, rt_mg::run, rt_swmg::run,
        ]
        let mut i: usize = 0
        while i < all.len {
            if try all[i]{ &w, &vm, routine, argc } {
                w.routes[r] = all[i]
                return true
            }
            i = i + 1
        }
        w.routes[r] = none
        return false
    }

    // The category of the routines no file implements.
    fn none {} -> !bool { return false }

    // `routine Name/argc -> result` (the result as the routine left it on the stack).
    fn log_call { mut w: world::World, vm: *nwvm::Vm, routine: u16, argc: u8, sp: u32, done: bool } {
        let r = nwscript::ROUTINES[@as(usize, routine)]
        world::prefix{ w = &w }
        let mark: []u8 = if done { "" } else { " (missing)" }
        if vm.sp == 0 or r.ret == nwscript::Type::void {
            _ = @fmt(&w.io, "routine {}/{}{}\n", r.name, argc, mark)
            return
        }
        let top = vm.sp - 1
        let t = vm.types[@as(usize, top)]
        let v = vm.vals[@as(usize, top)]
        if t == nwvm::INT { _ = @fmt(&w.io, "routine {}/{} -> {}{}\n", r.name, argc, v.i, mark) }
        else if t == nwvm::FLOAT { _ = @fmt(&w.io, "routine {}/{} -> {}{}\n", r.name, argc, v.f, mark) }
        else if t == nwvm::OBJECT { _ = @fmt(&w.io, "routine {}/{} -> object {}{}\n", r.name, argc, v.u, mark) }
        else if t == nwvm::STRING {
            let s = vm.strs[@as(usize, v.u)]
            _ = @fmt(&w.io, "routine {}/{} -> \"{}\"{}\n", r.name, argc, s, mark)
        } else { _ = @fmt(&w.io, "routine {}/{} -> handle {}{}\n", r.name, argc, v.u, mark) }
    }
}
