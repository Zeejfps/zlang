// Which engine logs are on, and the line prefix they share: `[frame seconds] `. Lines go to
// standard output through tools/common's @fmt writers for Io.
//
//   if w.log.scripts { elog::prefix{ w = &w }; _ = @fmt(&w.io, "script {} self={}\n", name, self) }
namespace elog {
    struct Log {
        scripts: bool = false,  // each script run and its result, faults always
        routines: bool = false, // each routine call
        events: bool = false,   // each event delivered
        actions: bool = false,  // each action started and ended
        objects: bool = false,  // objects made and destroyed
        module: bool = true,    // module loading
        combat: bool = false,   // rounds, damage, deaths
        dialog: bool = false,   // each conversation node shown, reply chosen, script run (lib/dialog)
        trace: bool = false,    // every fighting creature's action, animation, hit points and target, every few frames; the vfx (not in `all`)
        gait: bool = false,     // every frame, a walking or running creature's speed, cycle rate and place (lib/scene/visual.ctx; not in `all`)
        sound: bool = false,    // the mixer's steals and refusals, sound-device underruns, a summary at the end (lib/scene/ambience.ctx; not in `all`)
        shadows: bool = false,  // every drawn frame, how the enhanced view's shadows were drawn: maps or volumes, which lights (game/play.ctx; not in `all`)
    }

    // Turns on the logs a comma-separated list names (`scripts,routines`, `all`).
    fn enable { mut l: Log, list: []u8 } {
        let mut start: usize = 0
        let mut i: usize = 0
        while i <= list.len {
            if i == list.len or list[i] == ',' {
                let word = list[start..i]
                let all = ci::eq{ a = word, b = "all" }
                if all or ci::eq{ a = word, b = "scripts" } { l.scripts = true }
                if all or ci::eq{ a = word, b = "routines" } { l.routines = true }
                if all or ci::eq{ a = word, b = "events" } { l.events = true }
                if all or ci::eq{ a = word, b = "actions" } { l.actions = true }
                if all or ci::eq{ a = word, b = "objects" } { l.objects = true }
                if all or ci::eq{ a = word, b = "combat" } { l.combat = true }
                if all or ci::eq{ a = word, b = "dialog" } { l.dialog = true }
                if ci::eq{ a = word, b = "trace" } { l.trace = true }
                if ci::eq{ a = word, b = "gait" } { l.gait = true }
                if ci::eq{ a = word, b = "sound" } { l.sound = true }
                if ci::eq{ a = word, b = "shadows" } { l.shadows = true }
                start = i + 1
            }
            i = i + 1
        }
    }
}
