// Internal animation ids (objects.md `+0xd4`: 10000 stand, 10002 walk, ...) and the model
// animation names they play. The client's own table (0x0069f650) hasn't been read; this one is
// ours, from the meaning of each id (actions.md 3.9's routine mapping, movement.md 3.6) and the
// names in animations.2da (models-usage.md, Animation names). Creature models of type S and L use
// the `c` prefix (cpause1, cwalk), which `name_for` adds.
namespace animname {
    struct Entry { id: u32, name: []u8, looping: bool }

    // Ids from here on name an animations.2da row (id - ROW_BASE, low 16 bits; bit 16 only makes a
    // replay of the same row a new id): the combat animations fight.ctx picks.
    const ROW_BASE: u32 = 0x100000

    fn is_row { id: u32 } -> bool { return id >= ROW_BASE }
    fn row_of { id: u32 } -> usize { return @as(usize, (id - ROW_BASE) & 0xFFFF) }

    const TABLE: [54]Entry = [
        Entry{ id = 10000, name = "pause1", looping = true },
        Entry{ id = 10001, name = "pause1", looping = true },
        Entry{ id = 10002, name = "walk", looping = true },
        Entry{ id = 10003, name = "walk", looping = true },
        Entry{ id = 10004, name = "run", looping = true },
        Entry{ id = 10006, name = "dead", looping = true },
        Entry{ id = 10023, name = "spasm", looping = true },
        Entry{ id = 10028, name = "taunt", looping = false },
        Entry{ id = 10029, name = "greeting", looping = false },
        Entry{ id = 10030, name = "listen", looping = true },
        Entry{ id = 10032, name = "meditate", looping = true },
        Entry{ id = 10033, name = "meditate", looping = true },
        Entry{ id = 10034, name = "salute", looping = false },
        Entry{ id = 10035, name = "bow", looping = false },
        Entry{ id = 10038, name = "tlknorm", looping = true },
        Entry{ id = 10039, name = "tlkplead", looping = true },
        Entry{ id = 10040, name = "tlkforce", looping = true },
        Entry{ id = 10041, name = "tlklaugh", looping = true },
        Entry{ id = 10042, name = "tlksad", looping = true },
        Entry{ id = 10044, name = "victory", looping = false },
        Entry{ id = 10052, name = "pause2", looping = true },
        Entry{ id = 10053, name = "hturnl", looping = false },
        Entry{ id = 10054, name = "hturnr", looping = false },
        Entry{ id = 10055, name = "pausesh", looping = false },
        Entry{ id = 10056, name = "pausebrd", looping = false },
        Entry{ id = 10057, name = "pausetrd", looping = true },
        Entry{ id = 10058, name = "pausedrnk", looping = true },
        Entry{ id = 10059, name = "getfromgnd", looping = false },
        Entry{ id = 10060, name = "getfromcntr", looping = false },
        Entry{ id = 10070, name = "inject", looping = false },
        Entry{ id = 10073, name = "on", looping = false },
        Entry{ id = 10074, name = "off", looping = false },
        Entry{ id = 10075, name = "open", looping = false },
        Entry{ id = 10076, name = "close", looping = false },
        // A placeable's ANIMATION_PLACEABLE_ANIMLOOP01..10 (204..213, from_script): the Star Map's
        // dome plays animloop01, a computer's screen another.
        Entry{ id = 10106, name = "animloop01", looping = true },
        Entry{ id = 10107, name = "animloop02", looping = true },
        Entry{ id = 10108, name = "animloop03", looping = true },
        Entry{ id = 10110, name = "animloop04", looping = true },
        Entry{ id = 10111, name = "animloop05", looping = true },
        Entry{ id = 10112, name = "animloop06", looping = true },
        Entry{ id = 10113, name = "animloop07", looping = true },
        Entry{ id = 10114, name = "animloop08", looping = true },
        Entry{ id = 10115, name = "animloop09", looping = true },
        Entry{ id = 10116, name = "animloop10", looping = true },
        Entry{ id = 10118, name = "ready", looping = false },
        Entry{ id = 10120, name = "flirt", looping = true },
        Entry{ id = 10121, name = "usecomp", looping = false },
        Entry{ id = 10122, name = "dance", looping = true },
        Entry{ id = 10123, name = "dance1", looping = true },
        Entry{ id = 10124, name = "horror", looping = true },
        Entry{ id = 10125, name = "usecomplp", looping = true },
        Entry{ id = 10127, name = "activate", looping = false },
        Entry{ id = 10137, name = "sleep", looping = true },
        Entry{ id = 10151, name = "pause3", looping = true },
    ]

    fn find { id: u32 } -> ?Entry {
        let mut i: usize = 0
        while i < TABLE.len {
            if TABLE[i].id == id { return TABLE[i] }
            i = i + 1
        }
        return null
    }

    // The model animation an internal id plays ("" for none), and whether it loops.
    fn name_of { id: u32 } -> []u8 {
        let e = find{ id } ifnull { return "" }
        return e.name
    }

    // The model animation an id plays when the table above lacks it: a conversation's AnimList
    // numbers (re/dialogue.md 8.1), 10000 + a row of animations.2da, and the cutscene models'
    // `cutNNN`, `cutNNNw`, `cutNNNl`, `cutNNNwl` for 1000..1127, 1200.., 1400.., 1600..; a small
    // number is a row of animations.2da itself. Written into `into` (at least 12 bytes);
    // "" for none.
    fn name_in { w: *world::World, id: u32, into: []mut u8 } -> []u8 {
        let known = name_of{ id }
        if known.len > 0 { return known }
        if id >= 1000 and id < 1728 {
            let block = (id - 1000) / 200
            let within = (id - 1000) % 200
            if within >= 128 { return "" }
            let n = within + 1
            into[0] = 'c'
            into[1] = 'u'
            into[2] = 't'
            into[3] = @trunc(u8, '0' + (n / 100) % 10)
            into[4] = @trunc(u8, '0' + (n / 10) % 10)
            into[5] = @trunc(u8, '0' + n % 10)
            let mut len: usize = 6
            // Blocks: 0 once, 1 `w` once, 2 `l` loops, 3 `wl` loops (the cutscene numbers 1000 to 1727).
            if block == 1 or block == 3 { into[len] = 'w'; len = len + 1 }
            if block == 2 or block == 3 { into[len] = 'l'; len = len + 1 }
            return into[..len]
        }
        let row: u32 = if id >= 10000 { id - 10000 } else { id }
        if id >= 10000 or id < 400 {
            let n = twoda::get_string{ t = w.tables.animations, row = @as(usize, row), column = "name" } ifnull { return "" }
            if n.len == 0 or n[0] == '*' or n.len > 30 { return "" }
            let mut i: usize = 0
            while i < n.len and i < into.len {
                into[i] = n[i]
                i = i + 1
            }
            return into[..i]
        }
        return ""
    }

    // Whether the animation `name_in` names loops: the cutscene ones by their suffix, the rest by
    // animations.2da's `looping` (a table entry above by its own flag).
    fn loops_in { w: *world::World, id: u32 } -> bool {
        if find{ id } != null { return loops{ id } }
        if id >= 1000 and id < 1728 { return (id - 1000) / 200 >= 2 }
        let row: u32 = if id >= 10000 { id - 10000 } else { id }
        let v = twoda::get_int{ t = w.tables.animations, row = @as(usize, row), column = "looping" } ifnull { return false }
        return v != 0
    }

    fn loops { id: u32 } -> bool {
        let e = find{ id } ifnull { return true }
        return e.looping
    }

    // Plays once and ends (animations.2da FireForget), as PLAYANIMATION times it.
    fn is_fire_forget { w: *world::World, id: u32 } -> bool { return not loops{ id } }

    // A script's ANIMATION_* constant as the internal id it plays on a creature (actions.md 3.9;
    // `0x00540550`), placeables 200..213 as theirs; anything else as it is.
    fn from_script { constant: i32, kind: obj::Kind } -> u32 {
        if kind == obj::Kind::placeable {
            if constant >= 200 and constant <= 203 { return @as(u32, 10073 + constant - 200) }
            if constant >= 204 and constant <= 206 { return @as(u32, 10106 + constant - 204) }
            if constant >= 207 and constant <= 213 { return @as(u32, 10110 + constant - 207) }
            return 10000
        }
        if kind != obj::Kind::creature { return @as(u32, constant) }
        let ids: [33]u32 = [10000, 10052, 10030, 10032, 10033, 10038, 10039, 10040, 10041, 10042,
            10059, 10060, 10057, 10058, 10120, 10121, 10122, 10123, 10124, 10118, 10118, 10023,
            10137, 10139, 10151, 10152, 10006, 10154, 10155, 10160, 10156, 10163, 10164]
        if constant >= 0 and constant < 33 { return ids[@as(usize, constant)] }
        let high: [21]u32 = [10053, 10054, 10055, 10056, 10034, 10035, 10029, 10028, 10044, 10044,
            10044, 10000, 10070, 10125, 10126, 10127, 10150, 10129, 10130, 10142, 10159]
        if constant >= 100 and constant <= 120 { return high[@as(usize, constant - 100)] }
        return 10000
    }
}
