// Energy shields (rules.md 1.13, CSWSEffectListHandler::OnApplyForceShield 0x004df540): the
// forearm bands, the droid shields and the plot shields. EffectForceShield(row) names a row of
// forceshields.2da; applying it
//   1. takes off the shield the creature already wears (everything under that effect's id),
//   2. adds a VISUALEFFECT child for the aura (VisualEffectDef, or the VisualEffect_0N of the first
//      Appearance_0N equal to the creature's appearance) and
//   3. adds a limited DAMAGE_RESISTANCE child: int0 DamageFlags (the types it stops), int1
//      Resistance (300: any one hit), int2 Amount (the points it holds), int3 VulnerFlags (ion:
//      drains the points twice as fast),
// and keeps the FORCE_SHIELD effect itself as the marker the shot code looks for. The children
// have the shield's id and duration, so the shield ends when the points are used up (the
// resistance removes its whole id, apply_damage_resistance), when its time runs out, or on death.
// Removing it needs no handler of its own (rules.md 1.3).
namespace rules {
    // One row of forceshields.2da, with the aura already chosen for the creature's appearance.
    // DefaultRadius and Permanent are dead columns; Radius_0N is read only by the client's bolt
    // drawing (0x006501b0, how far short of the target a stopped bolt ends), not by the rules.
    struct ShieldRow {
        valid: bool,
        visual: i32,            // visualeffects.2da label of the aura
        damage_flags: i32,
        vulner_flags: i32,
        resistance: i32,
        amount: i32,
    }

    // The row `row` for a creature of `appearance`; not valid for a row the table lacks.
    fn read_shield_row { tables: *Tables, row: i32, appearance: i32 } -> ShieldRow {
        let t = raw_table{ tables, which = Tab::forceshields }
        let mut out: ShieldRow
        if row < 0 or @as(usize, row) >= twoda::rows{ t } { return out }
        let r = @as(usize, row)
        let apps: [4][]u8 = ["appearance_01", "appearance_02", "appearance_03", "appearance_04"]
        let auras: [4][]u8 = ["visualeffect_01", "visualeffect_02", "visualeffect_03", "visualeffect_04"]
        let mut aura: []u8 = "visualeffectdef"
        let mut k: usize = 0
        while k < 4 {
            let a = cell_int{ t, row = r, col = apps[k], dflt = -1 }
            if a >= 0 and a == appearance {
                aura = auras[k]
                break
            }
            k = k + 1
        }
        out.valid = true
        out.visual = cell_int{ t, row = r, col = aura, dflt = 0 }
        out.damage_flags = cell_int{ t, row = r, col = "damageflags", dflt = 0 }
        out.vulner_flags = cell_int{ t, row = r, col = "vulnerflags", dflt = 0 }
        out.resistance = cell_int{ t, row = r, col = "resistance", dflt = 0 }
        out.amount = cell_int{ t, row = r, col = "amount", dflt = 0 }
        return out
    }

    // The forceshields.2da row of the first FORCE_SHIELD effect, 0 when there is none: the client's
    // helper (0x00616890) that the shot code, the hit sound and the shield replacement ask. Row 0
    // (a droid's weakest shield) therefore looks like no shield to all three.
    fn force_shield_row { c: *Creature } -> i32 {
        let mut i: usize = 0
        while i < @as(usize, c.nfx) {
            if c.fx[i].kind == fx::FORCE_SHIELD { return c.fx[i].ints[0] }
            i = i + 1
        }
        return 0
    }

    // Whether the creature wears a shield the shot code can see (force_shield_row != 0).
    fn has_force_shield { c: *Creature } -> bool { return force_shield_row{ c } != 0 }

    // Whether the ammunition type's ShieldHit column (ammunitiontypes.2da) says its bolts strike a shield.
    fn ammunition_hits_shields { tables: *Tables, ammo_type: i32 } -> bool {
        if ammo_type <= 0 { return false }
        let t = raw_table{ tables, which = Tab::ammunitiontypes }
        return cell_int{ t, row = @as(usize, ammo_type), col = "shieldhit", dflt = 0 } != 0
    }

    // GetCanDeflectProjectile's shield branch (0x005b78e0), for a bolt that missed: a defender who is
    // not a Jedi guarding himself (a Jedi Defense feat, not debilitated, not dying) and wears a shield
    // (row != 0) absorbs it when the shooter's weapon in that hand fires ammunition with ShieldHit set.
    // The result is attack result 10: the bolt flies to the target and does nothing.
    fn shield_absorbs_miss { tables: *Tables, atk: *Creature, def: *Creature, off_hand: bool, defender_hp: i32 } -> bool {
        let guarding = has_feat{ c = def, feat = feat::JEDI_DEFENSE } or has_feat{ c = def, feat = feat::ADVANCED_JEDI_DEFENSE } or
            has_feat{ c = def, feat = feat::MASTER_JEDI_DEFENSE }
        if guarding and not is_debilitated{ c = def } and defender_hp >= 1 { return false }
        if not has_force_shield{ c = def } { return false }
        let weapon = equipped_item{ c = atk, mask = if off_hand { slot::LEFT } else { slot::RIGHT } } ifnull { return false }
        let bi = get_baseitem{ tables, row = weapon.base_item } ifnull { return false }
        return ammunition_hits_shields{ tables, ammo_type = bi.ammo_type }
    }

    // A child of the shield as CGameEffectFromParent makes it: the parent's id, duration kind and
    // length, subtype and spell, not exposed to scripts; its creator is the creature wearing the
    // shield (`owner`), not the caster (0x004df540).
    fn make_shield_child { parent: *Effect, kind: i32, owner: u32 } -> Effect {
        let mut e = fx::make_effect{ kind }
        e.id = parent.id
        e.dur = parent.dur
        e.sub = parent.sub
        e.duration = parent.duration
        e.expire = parent.expire
        e.creator = owner
        e.spell_id = parent.spell_id
        e.exposed = false
        return e
    }

    // The part of OnApplyForceShield that happens before the shield joins the list: the old shield
    // goes and the two children are applied. The caller keeps `e` as usual.
    fn apply_force_shield { env: Env, mut c: Creature, e: *Effect, mut rng: Rng, mut ev: Events } {
        // Only a shield with a nonzero row counts as worn (force_shield_row); the new one is not in the
        // list yet, so this is always an earlier one.
        if has_force_shield{ c = &c } {
            let mut i: usize = 0
            while i < @as(usize, c.nfx) {
                if c.fx[i].kind == fx::FORCE_SHIELD {
                    _ = remove_by_id_quiet{ c = &c, id = c.fx[i].id, ev = &ev }
                    break
                }
                i = i + 1
            }
        }
        let row = read_shield_row{ tables = env.tables, row = e.ints[0], appearance = c.appearance }
        let mut aura = make_shield_child{ parent = e, kind = fx::VISUALEFFECT, owner = env.self_id }
        aura.ints[0] = row.visual
        _ = apply_leaf{ env, c = &c, e0 = aura, rng = &rng, ev = &ev }
        let mut guard = make_shield_child{ parent = e, kind = fx::DAMAGE_RESISTANCE, owner = env.self_id }
        guard.sub = sub::MAGICAL
        guard.ints[0] = row.damage_flags
        guard.ints[1] = row.resistance
        guard.ints[2] = row.amount
        guard.ints[3] = row.vulner_flags
        _ = apply_leaf{ env, c = &c, e0 = guard, rng = &rng, ev = &ev }
    }
}
