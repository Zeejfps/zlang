// Beams (EffectBeam, visualeffects.2da rows with Type_FD D whose duration effect is an engine-programmed
// beam, progfx 608..621): Force lightning, drain life, the droid powers, the Force storm's arcs, the rays.
// The original (docs/re/render-gui.md, the 600s) loads the code's model, hangs it on the source's node and
// its far end, the `fx_ref` reference nodes under its Lightning emitters, on the target's `impact` node, and
// plays `cast01`; the Lightning emitters draw the bolt from one to the other (gui3d lightning.ctx). Ours: a
// `follow` effect on the source whose Lightning emitters aim at the target (Fx.aim_object).
namespace vfx {
    // The model of a beam code (0x006a0680).
    fn beam_model { code: i32 } -> []u8 {
        if code == 608 { return "v_lightns_dur" }
        if code == 609 { return "v_lightnx_dur" }
        if code == 610 { return "v_drddisab_dur" }
        if code == 611 { return "v_drdkill_dur" }
        if code == 612 { return "v_deathfld_dur" }
        if code == 613 { return "v_drain_dur" }
        if code == 614 { return "v_flame_dur" }
        if code == 615 { return "v_stunray_dur" }
        if code == 616 { return "v_coldray_dur" }
        if code == 617 { return "v_ionray01_dur" }
        if code == 618 { return "v_ionray02_dur" }
        if code == 619 { return "v_fstorm_dur" }
        if code == 620 { return "v_drdstun_dur" }
        if code == 621 { return "v_fshock_dur" }
        return ""
    }

    // The node of the effector the beam leaves from (BODY_NODE_HAND 0, CHEST 1, HEAD 2; the original's
    // selector: 0 handconjure, 1 impact, 2 headconjure).
    fn beam_hook { part: i32 } -> []u8 {
        if part == 1 { return "impact" }
        if part == 2 { return "headconjure" }
        return "handconjure"
    }

    fn start_beam {
        mut v: Vfx, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device,
        style: i32, source: u32, target: u32, part: i32, seconds: f32,
    } {
        let t = w.tables.visualeffects
        let row = effect_row{ t, effect = style } ifnull { return }
        let model = beam_model{ code = progfx_code{ t, row, column = "progfx_duration" } }
        if model.len == 0 { return }
        let life = if seconds > 0.05 { seconds } else { 1.0 }
        let got = acquire{ &v, &sc, &w, &dev, name = model } iferr { null }
        let slot = got ifnull { return }
        let f = &v.fx[slot]
        f.object = source
        f.which = 0
        let hook = beam_hook{ part }
        let mut i: usize = 0
        while i < hook.len {
            f.hook[i] = hook[i]
            i = i + 1
        }
        f.hook_len = hook.len
        // Only `cast01`, which the beam models lack: their `impact` would shrink the bolt to nothing in a
        // tenth of a second.
        begin{ &v, &sc, &w, slot, anim = "cast01", life, kind = Kind::follow, looping = false, strict = true }
        f.matrix = follow_matrix{ sc = &sc, w = &w, f }
        f.aim_object = target
        f.beam = style
    }

    // Ends the beams `style` at `target` (the effect was removed before its time).
    fn end_beams { mut v: Vfx, style: i32, target: u32 } {
        let mut i: usize = 0
        while i < MAX_FX {
            let f = &v.fx[i]
            i = i + 1
            if f.live and f.beam == style and f.aim_object == target { f.life = f.age }
        }
    }
}
