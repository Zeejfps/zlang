// From the outbox's notes to effects: a ranged attack's bolt and muzzle flash, a visualeffects.2da
// row on an object or at a point. The sounds that go with them are the engine's (play_sound notes).
namespace vfx {
    // How far past a target a bolt that missed flies when nothing stops it, and the least it
    // flies on.
    const MISS_RANGE: f32 = 30.0
    const MISS_PAST: f32 = 2.0

    // visualeffects.2da / damagehitvisual ids used as combat's own.
    const VFX_BLASTER_IMPACT_GROUND: i32 = 4032

    // The row of visualeffects.2da whose label is the id `effect`.
    fn effect_row { t: twoda::Table, effect: i32 } -> ?usize {
        let mut digits: [12]u8
        let mut d: usize = 0
        let mut x = if effect < 0 { 0 } else { effect }
        if x == 0 { digits[0] = '0'; d = 1 }
        while x > 0 and d < 12 { digits[d] = @trunc(u8, '0' + @as(u32, x % 10)); x = x / 10; d = d + 1 }
        let mut label: [12]u8
        let mut n: usize = 0
        while d > 0 { d = d - 1; label[n] = digits[d]; n = n + 1 }
        return twoda::find_row{ t, label = label[..n] }
    }

    // The model a visual effect shows when it hits: the impact node's, else the root's.
    fn effect_model { t: twoda::Table, row: usize } -> []u8 {
        let columns: [6][]u8 = ["imp_impact_node", "imp_root_m_node", "imp_headcon_node", "imp_root_s_node", "imp_root_l_node", "imp_root_h_node"]
        let mut c: usize = 0
        while c < 6 {
            let m = twoda::get_string{ t, row, column = columns[c] } ifnull ""
            if m.len > 0 { return m }
            c = c + 1
        }
        return ""
    }

    // The node an effect's model hangs on: blaster hits strike the front of the chest
    // (`impact_bolt`), a deflection starts at `DeflectHook`, everything else at `Impact`.
    fn effect_hook { effect: i32 } -> []u8 {
        if effect == 4024 or effect == 4033 { return "impact_bolt" }
        if effect == 4023 { return "DeflectHook" }
        return "Impact"
    }

    // A visualeffects.2da row playing on an object (riding its node) for the effect model's animation.
    fn visual_on {
        mut v: Vfx, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, effect: i32, object: u32,
    } {
        let row = effect_row{ t = w.tables.visualeffects, effect } ifnull { return }
        let model = effect_model{ t = w.tables.visualeffects, row }
        if model.len == 0 { return }
        _ = spawn_follow{ &v, &sc, &w, &dev, model, object, hook = effect_hook{ effect }, which = 0, anim = "impact", life = 0.0 } iferr { null }
    }

    // A duration visual (visualeffects.2da Type_FD D) held on an object until it is released.
    fn hold_on {
        mut v: Vfx, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, effect: i32, object: u32,
    } {
        let row = effect_row{ t = w.tables.visualeffects, effect } ifnull { return }
        let model = effect_model{ t = w.tables.visualeffects, row }
        if model.len == 0 { return }
        _ = spawn_hold{ &v, &sc, &w, &dev, model, object, hook = effect_hook{ effect }, effect } iferr { null }
    }

    // A visualeffects.2da row playing at a point.
    fn visual_at {
        mut v: Vfx, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, effect: i32, at: math::Vec3, facing: math::Vec3,
    } {
        let row = effect_row{ t = w.tables.visualeffects, effect } ifnull { return }
        let model = effect_model{ t = w.tables.visualeffects, row }
        if model.len == 0 { return }
        _ = spawn_still{ &v, &sc, &w, &dev, model, at, facing, anim = "impact", life = 0.0 } iferr { null }
    }

    // The note's effects, if it is one of theirs.
    fn take { mut v: Vfx, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, note: outbox::Note } {
        match note {
            shot{ attacker, target, ammo, power, hand, flight_ms, result } => {
                shoot{ &v, &sc, &w, &dev, attacker, target, ammo, power, hand, flight = @as(f32, flight_ms) / 1000.0, result }
            }
            lightsaber{ id, forced, powered, transition } => { scene::set_saber{ sc = &sc, id, forced, powered } }
            visual{ effect, target, source, position } => {
                if target != obj::INVALID { visual_on{ &v, &sc, &w, &dev, effect, object = target } }
                else { visual_at{ &v, &sc, &w, &dev, effect, at = position, facing = math::vec3::zero{} } }
            }
            visual_hold{ effect, target } => { hold_on{ &v, &sc, &w, &dev, effect, object = target } }
            visual_release{ effect, target } => { release{ &v, effect, object = target } }
            effect_model{ model, object, hook, position, life } => {
                var_model_fx{ &v, &sc, &w, &dev, model, object, hook, position, life }
            }
            area_effect{ effect, position, area } => {
                visual_at{ &v, &sc, &w, &dev, effect, at = position, facing = math::vec3::zero{} }
            }
            else => {}
        }
    }

    // An effect model by name: riding a node of an object, or standing at a point.
    fn var_model_fx {
        mut v: Vfx, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device,
        model: resref::ResRef, object: u32, hook: resref::ResRef, position: math::Vec3, life: f32,
    } {
        let mut m = model
        let mut h = hook
        if object != obj::INVALID {
            _ = spawn_follow{ &v, &sc, &w, &dev, model = resref::bytes{ r = &m }, object, hook = resref::bytes{ r = &h }, which = 0, anim = "impact", life } iferr { null }
        } else {
            _ = spawn_still{ &v, &sc, &w, &dev, model = resref::bytes{ r = &m }, at = position, facing = math::vec3::zero{}, anim = "impact", life } iferr { null }
        }
    }

    // Where an object's node is in the world, else `fallback` metres above its feet.
    fn hook_point { sc: *scene::Scene, w: *world::World, id: u32, hook: []u8, which: usize, fallback: f32 } -> math::Vec3 {
        if scene::hook_of{ sc, w, id, hook, which } is some{ value = m } { return math::mat4::get_translation{ m } }
        if world::object{ w, id } is some{ value = o } { return math::Vec3{ x = o.position.x, y = o.position.y, z = o.position.z + fallback } }
        return math::vec3::zero{}
    }

    // One bolt: from the attacker's weapon to the target, a muzzle flash at the weapon.
    fn shoot {
        mut v: Vfx, mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device,
        attacker: u32, target: u32, ammo: i32, power: bool, hand: i32, flight: f32, result: i32,
    } {
        if ammo <= 0 { return }
        let row = @as(usize, ammo)
        let model = twoda::get_string{ t = w.tables.ammunitiontypes, row, column = if power { "model1" } else { "model0" } } ifnull ""
        if model.len == 0 { return }
        // The weapon's muzzle: the bullet hook of the weapon in that hand, else of the other.
        let mut which: usize = if hand == 1 { 1 } else { 0 }
        if scene::hook_of{ sc = &sc, w = &w, id = attacker, hook = "bullethook", which } == null { which = 0 }
        let from = hook_point{ sc = &sc, w = &w, id = attacker, hook = "bullethook", which, fallback = 1.2 }
        let mark = hook_point{ sc = &sc, w = &w, id = target, hook = "impact_bolt", which = 0, fallback = 1.2 }
        let hit = result >= rules::outcome::HIT and result <= rules::outcome::AUTOMATIC_HIT
        let deflected = result == rules::outcome::DEFLECTED or result == rules::outcome::RETURNED
        let flash = twoda::get_string{ t = w.tables.ammunitiontypes, row, column = "muzzleflash" } ifnull ""
        if flash.len > 0 {
            _ = spawn_follow{ &v, &sc, &w, &dev, model = flash, object = attacker, hook = "bullethook", which, anim = "impact", life = 0.0 } iferr { null }
        }
        if hit or deflected or result == rules::outcome::SHIELD {
            _ = spawn_bolt{ &v, &sc, &w, &dev, model, from, to = mark, flight, end_effect = 0 } iferr { null }
            return
        }
        // A miss flies by: aimed a little off the target (to the side and up or down), on until
        // something solid stops it, where it throws sparks.
        let span = math::vec3::sub{ a = mark, b = from }
        let length = math::vec3::length{ v = span }
        if length < 0.1 { return }
        let ahead = math::vec3::scale{ v = span, s = 1.0 / length }
        let side = math::vec3::normalize{ v = math::vec3::cross{ a = ahead, b = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 } } }
        let sway = (0.4 + 0.6 * random{ &v }) * (if random{ &v } < 0.5 { -1.0 } else { 1.0 })
        let rise = (random{ &v } - 0.5) * 0.8
        let aim = math::vec3::add{ a = math::vec3::add_scaled{ a = mark, b = side, s = sway }, b = math::Vec3{ x = 0.0, y = 0.0, z = rise } }
        let dir = math::vec3::normalize{ v = math::vec3::sub{ a = aim, b = from } }
        let stop = scene::ray_hit{ sc = &sc, w = &w, origin = from, dir, max_t = MISS_RANGE }
        let least = length + MISS_PAST
        let mut reach = if stop != null { stop } else { MISS_RANGE }
        if reach < least { reach = least }
        let end = math::vec3::add_scaled{ a = from, b = dir, s = reach }
        // The same speed all the way: the flight to the target took `flight`.
        let speed = length / math::max{ a = flight, b = 0.02 }
        _ = spawn_bolt{ &v, &sc, &w, &dev, model, from, to = end, flight = reach / speed, end_effect = if stop != null { VFX_BLASTER_IMPACT_GROUND } else { 0 } } iferr { null }
    }
}
