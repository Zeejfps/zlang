// The CPU side of a model's emitters: births, ageing, and the live particles as render::Particle
// rows. The simulation is ours, from the emitter node's data (birth rate, life, size, colour and
// alpha curves; docs/re/gui3d.md says what is inferred): the original's code is read only as far
// as the main menu needs.
//
// Particles live in their emitter's space, so a moving emitter carries them (the original's live in
// the world and only `inherit` ones follow the emitter: docs/design/vfx.md, "Decisions"); what the
// world does to them, gravity and the surfaces they bounce off, is the world's, brought into that
// space each step. One Emitting is one emitter node of one model; the Scene owns them.
namespace gui3d {
    // One live particle. `aim` is the unit direction it was sent in (the +Z of the particle's own
    // orientation in the original), which does not follow its velocity; `tail` is where a
    // Motion_Blur particle's streak ends, trailing behind `pos`. `still`: it bounced to a stop on a
    // surface and is no longer moved.
    struct Puff { pos: math::Vec3, vel: math::Vec3, age: f32, life: f32, angle: f32, frame: f32, aim: math::Vec3, tail: math::Vec3, still: bool }

    // Where a bouncing particle's step (from, to: world space) first meets the world: the point and
    // the face's unit normal there, null for none.
    struct Contact { at: math::Vec3, normal: math::Vec3 }

    // Nothing to bounce off: a menu's or a minigame's scene.
    fn no_contact { from: math::Vec3, to: math::Vec3 } -> ?Contact { return null }

    // The most particles one emitter keeps alive, whatever its birth rate and life say.
    const MAX_PUFFS: usize = 4096

    // One emitter node's particles. All arrays are in the memory `make_emitting` was given.
    struct Emitting {
        emitter: u32,                       // index in Model.emitters
        texture: ?render::Texture,
        puffs: []mut Puff,                  // live ones first, `live` of them
        live: u32,
        owed: f32,                          // births carried to the next step (a fraction of one)
        rng: u32,
        out: []mut render::Particle,        // the live ones as the seam takes them
        seen: u32,                          // a world emitter: the scene frame it was last stepped in, 0 never (lib/scene/emitters.ctx)
        latch: bool,                        // an Explosion emitter: its owner's animation said `detonate`, not burst yet
    }

    // ---- random numbers (xorshift32: the stream matters only for variety)

    fn rng_next { mut s: u32 } -> u32 {
        let mut x = s
        if x == 0 { x = 0x9E3779B9 }
        x = x ^ (x << 13)
        x = x ^ (x >> 17)
        x = x ^ (x << 5)
        s = x
        return x
    }

    // 0 up to 1.
    fn rng_unit { mut s: u32 } -> f32 {
        let bits = rng_next{ &s }
        return @as(f32, bits >> 8) / 16777216.0
    }

    // ---- making and stepping

    // Room for the particles an emitter can have alive at once: births per second times life,
    // with some slack for the random part of the rate.
    fn capacity_for { props: mdl::EmitterProps } -> usize {
        let rate = math::max{ a = props.birthrate, b = 0.0 } + math::max{ a = props.random_birthrate, b = 0.0 }
        let need = rate * math::max{ a = props.life_exp, b = 0.0 } * 1.25 + 8.0
        let n = math::clamp{ x = need, lo = 8.0, hi = @as(f32, MAX_PUFFS) }
        return @as(usize, n)
    }

    // The emitter `index` of `model`: its arrays in `heap`, its texture through the material
    // cache (a missing texture draws nothing).
    fn make_emitting {
        mut fs: Fs, mut dev: gpu::Device, mut heap: arena::Arena, mut mats: material::Cache, rm: res::Manager,
        model: *mdl::Model, index: u32,
    } -> !Emitting {
        let e = &model.emitters[index]
        let cap = capacity_for{ props = e.props }
        let puffs = try alloc::resize(Puff, arena::Arena){ realloc = arena::alloc, heap = &heap, mem = slice::empty(Puff){}, count = cap }
        let out = try alloc::resize(render::Particle, arena::Arena){ realloc = arena::alloc, heap = &heap, mem = slice::empty(render::Particle){}, count = cap }
        let t = material::get{ cache = &mats, &fs, &dev, rm, name = e.texture }
        return Emitting{
            emitter = index, texture = t.texture, puffs, live = 0, owed = 0.0,
            rng = 0x2545F491 + 7919 * (index + 1), out, seen = 0, latch = false,
        }
    }

    // One step of `dt` seconds: the old die, the rest move, new ones are born. A Single emitter keeps
    // one particle while its birth rate is at least 1 (whole particles: the original truncates),
    // which ages to the end of its curves and stays there; the others give birth `birthrate` times a
    // second. `world` is the emitter node's matrix to world space, where gravity pulls down (world -Z)
    // and `ground` says where a bouncing particle meets something.
    fn step_emitting {
        mut em: Emitting, e: *mdl::Emitter, props: mdl::EmitterProps, dt: f32, world: math::Mat4,
        ground: &fn{ from: math::Vec3, to: math::Vec3 } -> ?Contact,
    } {
        if dt <= 0.0 { return }
        let single = e.update == mdl::EmitterUpdate::single
        let blur = e.render == mdl::EmitterRender::motion_blur
        let bounces = (e.flags & EMIT_BOUNCE) != 0
        // World down in the emitter's space (its length is a world metre's there): the original's
        // particles are in the world and fall along world -Z whichever way the emitter points
        // (0x00492450); a sideways spark emitter (the clash sparks v_spkb_imp emit along their
        // effect's facing) must not fall sideways.
        let to_local = math::mat4::inverse_affine{ m = world }
        let down = math::mat4::transform_dir{ m = to_local, v = math::Vec3{ x = 0.0, y = 0.0, z = -1.0 } }
        let pull = props.mass * GRAVITY * dt
        let mut i: u32 = 0
        while i < em.live {
            let mut p = em.puffs[i]
            p.age = p.age + dt
            if p.age >= p.life and not single {
                em.puffs[i] = em.puffs[em.live - 1]
                em.live = em.live - 1
                continue
            }
            // The streak's tail eases toward the head over `blurlength` seconds (a frame at least),
            // measured from where the head was before this step.
            if blur {
                let t = if props.blur_length > 0.000001 { math::min{ a = dt, b = props.blur_length } / props.blur_length } else { 1.0 }
                p.tail = math::vec3::lerp{ a = p.tail, b = p.pos, t }
            }
            p.angle = p.angle + props.particle_rot * dt
            if p.still {
                em.puffs[i] = p
                i = i + 1
                continue
            }
            // The original moves a particle and then lets gravity (the controller `mass`, in g) pull
            // its velocity down: a negative mass rises (smoke, flames).
            let from = p.pos
            p.pos = math::vec3::add_scaled{ a = p.pos, b = p.vel, s = dt }
            if bounces { bounce{ &p, from, world, to_local, bounce_co = props.bounce_co, dt, ground } }
            if not p.still { p.vel = math::vec3::add_scaled{ a = p.vel, b = down, s = pull } }
            em.puffs[i] = p
            i = i + 1
        }
        // Lightning is drawn as a strip of its own, which is not done: such an emitter stays quiet.
        if e.update == mdl::EmitterUpdate::lightning { return }
        if single {
            if props.birthrate < 1.0 {
                em.live = 0
            } else if em.live == 0 and em.puffs.len > 0 {
                spawn{ &em, e, props }
            }
            return
        }
        let mut rate = props.birthrate
        if props.random_birthrate > 0.0 {
            rate = rate + (2.0 * rng_unit{ s = &em.rng } - 1.0) * props.random_birthrate
        }
        if rate < 0.0 { rate = 0.0 }
        em.owed = em.owed + rate * dt
        while em.owed >= 1.0 {
            em.owed = em.owed - 1.0
            if @as(usize, em.live) < em.puffs.len { spawn{ &em, e, props } }
        }
    }

    // Births `birthrate` particles (at least one) at once from an Explosion emitter: its burst on the
    // animation's `detonate`.
    fn burst { mut em: Emitting, e: *mdl::Emitter, props: mdl::EmitterProps } {
        let want = math::max{ a = props.birthrate, b = 1.0 }
        let mut n: usize = 0
        while @as(f32, n) < want and em.live < em.puffs.len {
            spawn{ &em, e, props }
            n = n + 1
        }
    }

    // Metres per second squared that a `mass` of 1 pulls with.
    const GRAVITY: f32 = 9.81

    // MDL emitter flag: particles bounce off the world.
    const EMIT_BOUNCE: u32 = 0x10

    // A bouncing particle's step from `from` to p.pos (the emitter's space) against the world, as the
    // original's (docs/re/particles.md, "A particle"): at a contact it is put there and, with bounce_co
    // 0, stops; otherwise its velocity is reflected about the surface, scaled by 0.75, and its upward
    // part further by bounce_co (more for a long frame). Slower than sqrt(0.5) m/s it comes to rest
    // 2 cm off the surface.
    fn bounce {
        mut p: Puff, from: math::Vec3, world: math::Mat4, to_local: math::Mat4, bounce_co: f32, dt: f32,
        ground: &fn{ from: math::Vec3, to: math::Vec3 } -> ?Contact,
    } {
        let a = math::mat4::transform_point{ m = world, p = from }
        let b = math::mat4::transform_point{ m = world, p = p.pos }
        let c = ground{ from = a, to = b } ifnull { return }
        let mut v = math::vec3::zero{}
        if bounce_co != 0.0 {
            let vw = math::mat4::transform_dir{ m = world, v = p.vel }
            v = math::vec3::scale{ v = math::vec3::sub{ a = vw, b = math::vec3::scale{ v = c.normal, s = 2.0 * math::vec3::dot{ a = vw, b = c.normal } } }, s = 0.75 }
            v.z = v.z * bounce_co * math::clamp{ x = 0.033 / dt, lo = 0.5, hi = 1.0 }
        }
        let mut at = c.at
        if math::vec3::length_sq{ v } < 0.5 {
            p.still = true
            v = math::vec3::zero{}
            at = math::vec3::add_scaled{ a = c.at, b = c.normal, s = 0.02 }
        }
        p.pos = math::mat4::transform_point{ m = to_local, p = at }
        p.vel = math::mat4::transform_dir{ m = to_local, v }
    }

    // One new particle: in an xsize/100 by ysize/100 metre rectangle centred on the emitter, in its
    // X/Y plane (0x0048d870: up to xsize/200 either way), moving along +Z tilted by up to half of
    // `spread` (the full cone's angle, 0x0048de60) at velocity plus or minus up to randvel. It starts
    // turned to 0 and spins by `particleRot` a second.
    fn spawn { mut em: Emitting, e: *mdl::Emitter, props: mdl::EmitterProps } {
        let x = (2.0 * rng_unit{ s = &em.rng } - 1.0) * props.x_size * 0.005
        let y = (2.0 * rng_unit{ s = &em.rng } - 1.0) * props.y_size * 0.005
        let theta = rng_unit{ s = &em.rng } * props.spread * 0.5
        let phi = rng_unit{ s = &em.rng } * math::TAU
        let dir = math::Vec3{
            x = math::sinf{ x = theta } * math::cosf{ x = phi },
            y = math::sinf{ x = theta } * math::sinf{ x = phi },
            z = math::cosf{ x = theta },
        }
        let speed = props.velocity + props.rand_vel * (2.0 * rng_unit{ s = &em.rng } - 1.0)
        // Emitters with `random` pick one cell of their sprite sheet at birth; the others play the
        // sheet from frame_start at `fps`.
        let mut frame = props.frame_start
        if (e.flags & EMIT_RANDOM) != 0 {
            let span = math::max{ a = props.frame_end - props.frame_start + 1.0, b = 1.0 }
            frame = props.frame_start + math::floorf{ x = rng_unit{ s = &em.rng } * span }
        }
        let at = math::Vec3{ x, y, z = 0.0 }
        // lifeExp -1: the particle stays as long as the effect does, at its starting size and colour.
        let life = if props.life_exp < 0.0 { 1.0e9 } else { math::max{ a = props.life_exp, b = 0.01 } }
        em.puffs[em.live] = Puff{
            pos = at, vel = math::vec3::scale{ v = dir, s = speed },
            age = 0.0, life, angle = 0.0, frame, aim = dir, tail = at, still = false,
        }
        em.live = em.live + 1
    }

    // MDL emitter flag: pick the sprite cell at random.
    const EMIT_RANDOM: u32 = 0x20

    // ---- drawing

    // The sprite cell a particle shows: with `fps` set it steps from its first cell one a 1/fps seconds, to
    // `frameEnd` and stays there, or round again when the emitter picks its cells at random (the original
    // counts the cells from the first it was given; frameStart is 0 where that matters).
    fn cell_of { e: *mdl::Emitter, props: mdl::EmitterProps, p: Puff } -> f32 {
        let count = math::floorf{ x = props.frame_end - props.frame_start + 0.5 } + 1.0
        if props.fps <= 0.0 or count < 2.0 { return p.frame }
        let steps = math::floorf{ x = p.age * props.fps }
        if (e.flags & EMIT_RANDOM) != 0 {
            let from = p.frame - props.frame_start
            let total = from + steps
            return props.frame_start + (total - count * math::floorf{ x = total / count })
        }
        return math::min{ a = p.frame + steps, b = props.frame_end }
    }

    // Where a curve with three values stands at life fraction t: `a` from percent `ps`, `b` at
    // `pm`, `c` at `pe`, linear between, held outside.
    fn curve { t: f32, ps: f32, pm: f32, pe: f32, a: f32, b: f32, c: f32 } -> f32 {
        if t <= ps { return a }
        if t >= pe { return c }
        if t < pm { return math::lerp{ a, b, t = (t - ps) / math::max{ a = pm - ps, b = 0.0001 } } }
        return math::lerp{ a = b, b = c, t = (t - pm) / math::max{ a = pe - pm, b = 0.0001 } }
    }

    // The live particles as seam rows (valid until the next call), in the emitter's space.
    // Returns how many. What `size` and `dir` mean depends on how the emitter draws (look_of):
    //   Motion_Blur: a streak from the particle's tail to its head, centred between them, `dir` along it,
    //     twice `sizeStart` wide (the original's width is the size on each side of the line) and as long
    //     as the tail is behind plus a cap of a quarter of the height at each end;
    //   Aligned_to_Particle_Dir: `dir` is the direction it was sent in, kept as it flies;
    //   the others: `dir` is the way it moves now.
    fn fill_particles { mut em: Emitting, e: *mdl::Emitter, props: mdl::EmitterProps } -> u32 {
        let blur = e.render == mdl::EmitterRender::motion_blur
        let aimed = e.render == mdl::EmitterRender::aligned_to_particle_dir
        // The height is the width unless some key of it is set (a key left at 0 then means 0).
        let tall = props.size_start_y != 0.0 or props.size_mid_y != 0.0 or props.size_end_y != 0.0
        let mut i: u32 = 0
        while i < em.live {
            let p = em.puffs[i]
            let t = math::clamp{ x = p.age / p.life, lo = 0.0, hi = 1.0 }
            let r = curve{ t, ps = props.percent_start, pm = props.percent_mid, pe = props.percent_end, a = props.color_start.x, b = props.color_mid.x, c = props.color_end.x }
            let g = curve{ t, ps = props.percent_start, pm = props.percent_mid, pe = props.percent_end, a = props.color_start.y, b = props.color_mid.y, c = props.color_end.y }
            let b = curve{ t, ps = props.percent_start, pm = props.percent_mid, pe = props.percent_end, a = props.color_start.z, b = props.color_mid.z, c = props.color_end.z }
            let a = curve{ t, ps = props.percent_start, pm = props.percent_mid, pe = props.percent_end, a = props.alpha_start, b = props.alpha_mid, c = props.alpha_end }
            let sx = curve{ t, ps = props.percent_start, pm = props.percent_mid, pe = props.percent_end, a = props.size_start, b = props.size_mid, c = props.size_end }
            let sy = curve{ t, ps = props.percent_start, pm = props.percent_mid, pe = props.percent_end, a = props.size_start_y, b = props.size_mid_y, c = props.size_end_y }
            let high = if tall { sy } else { sx }
            let mut dir = math::vec3::normalize{ v = p.vel }
            if math::vec3::length_sq{ v = dir } < 0.5 { dir = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 } }
            let mut at = p.pos
            let mut size = math::Vec2{ x = sx, y = high }
            if aimed {
                dir = p.aim
            } else if blur {
                let d = math::vec3::sub{ a = p.pos, b = p.tail }
                let len = math::vec3::length{ v = d }
                if len > 0.00001 { dir = math::vec3::scale{ v = d, s = 1.0 / len } }
                at = math::vec3::scale{ v = math::vec3::add{ a = p.pos, b = p.tail }, s = 0.5 }
                size = math::Vec2{ x = 2.0 * sx, y = len + high * 0.5 }
            }
            em.out[i] = render::Particle{
                position = at, size, angle = p.angle,
                color = render::Color{ r = r, g = g, b = b, a = a }, frame = @as(u32, cell_of{ e, props, p }), dir,
            }
            i = i + 1
        }
        return em.live
    }

    // How the emitter's particles face and which axis that turns about, in the emitter's space
    // (`world`: its node's matrix to world, to bring Z up into it). The original's seven render
    // modes (a particle's quad is spanned by two axes):
    //   Normal, Linked   the view's right and up: a square-on billboard (a Linked emitter's particles
    //                    are drawn so too; its chain of beams is the vfx beams');
    //   Billboard_to_Local_Z  the emitter's own X and Y: it lies in the emitter's plane, so a scorch
    //                    on the floor lies on the floor, a muzzle flash is crossed sheets;
    //   Billboard_to_World_Z  the world's X and Y: flat on the ground whatever the emitter's turn;
    //   Aligned_to_World_Z    the view's right and world Z: upright, a flare standing up;
    //   Aligned_to_Particle_Dir  the direction it was sent and the tangent about the emitter's Z;
    //   Motion_Blur      a streak from tail to head (fill_particles).
    struct Look { facing: render::Facing, axis: math::Vec3, blend: render::Blend }

    fn look_of { e: *mdl::Emitter, world: math::Mat4 } -> Look {
        let up_local = math::vec3::normalize{ v = math::mat4::transform_dir{ m = math::mat4::inverse_affine{ m = world }, v = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 } } }
        let local_z = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }
        let mut l = Look{ facing = render::Facing::camera, axis = local_z, blend = render::Blend::alpha }
        let r = e.render
        if r == mdl::EmitterRender::billboard_to_local_z {
            l.facing = render::Facing::emitter_plane
        } else if r == mdl::EmitterRender::billboard_to_world_z {
            l.facing = render::Facing::world_plane
        } else if r == mdl::EmitterRender::aligned_to_world_z {
            l.facing = render::Facing::upright
            l.axis = up_local
        } else if r == mdl::EmitterRender::aligned_to_particle_dir {
            l.facing = render::Facing::tangent
        } else if r == mdl::EmitterRender::motion_blur {
            l.facing = render::Facing::velocity
        }
        if e.blend == mdl::EmitterBlend::lighten {
            l.blend = render::Blend::additive
        } else if e.blend == mdl::EmitterBlend::punch_through {
            l.blend = render::Blend::punch
        }
        return l
    }
}
