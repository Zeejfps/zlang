// Turning GUI events into the front end's actions: the options, the save list, the movie list
// and the main menu's buttons (docs/re/gui.md section 10.1).
namespace frontend {
    // The text of a movies.2da row's name is dialog.tlk string `strrefname`; the row label is the
    // file in movies/. The list shows a movie when `alwaysshow` is 1 or the player has seen it.
    fn fill_movies { mut fe: Front, mut g: gui::Gui, mut fs: Fs, p: u32 } -> ! {
        gui::list_clear{ &g, panel = p, tag = "LB_MOVIES" }
        let rm = g.rm
        let bytes = try res::load{ &fs, rm, name = "movies", kind = restype::Type::twoda, realloc = heap::alloc, heap = fe.heap } ifnull { return }
        defer _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = fe.heap, mem = bytes, count = 0 }
        let t = try twoda::parse{ data = bytes, realloc = heap::alloc, heap = fe.heap }
        defer twoda::free{ t, realloc = heap::alloc, heap = fe.heap }
        // By the table's `order` column.
        let mut taken = [false; 128]
        let mut shown: usize = 0
        while shown < twoda::rows{ t } and shown < 128 {
            let mut best: i32 = -1
            let mut best_order: i32 = 2147483647
            let mut r: usize = 0
            while r < twoda::rows{ t } and r < 128 {
                if not taken[r] {
                    let seen = r < 64 and fe.settings.movies_seen[r]
                    let always = (twoda::get_int{ t, row = r, column = "alwaysshow" } ifnull 0) != 0
                    let order = twoda::get_int{ t, row = r, column = "order" } ifnull 0
                    if (seen or always) and order < best_order {
                        best = @as(i32, r)
                        best_order = order
                    }
                }
                r = r + 1
            }
            if best < 0 { break }
            taken[@as(usize, best)] = true
            let row = @as(usize, best)
            let strref = @as(u32, twoda::get_int{ t, row, column = "strrefname" } ifnull 0)
            let title = try gui::tlk_text{ &g, strref }
            defer gui::free_string{ &g, s = title }
            let label = twoda::get_string_at{ t, row, col = 0 } ifnull ""
            _ = try gui::list_add{ &g, panel = p, tag = "LB_MOVIES", text = title, user = best_row_user{ row = best, label } }
            shown = shown + 1
        }
    }

    // A list row's user value for a movie: the table row (the label is read again from it).
    fn best_row_user { row: i32, label: []u8 } -> i64 {
        return @as(i64, row)
    }

    // The label (file name) of row `row` of movies.2da, copied into `into`.
    fn movie_label { mut fe: Front, mut fs: Fs, rm: res::Manager, row: i64, into: []mut u8 } -> usize {
        let loaded = res::load{ &fs, rm, name = "movies", kind = restype::Type::twoda, realloc = heap::alloc, heap = fe.heap } iferr { return 0 }
        let bytes = loaded ifnull { return 0 }
        defer _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = fe.heap, mem = bytes, count = 0 }
        let t = twoda::parse{ data = bytes, realloc = heap::alloc, heap = fe.heap } iferr { return 0 }
        defer twoda::free{ t, realloc = heap::alloc, heap = fe.heap }
        if row < 0 or @as(usize, row) >= twoda::rows{ t } { return 0 }
        return copy_into{ dst = into, src = t.labels[@as(usize, row)] }
    }

    // ---- Load Game and Save Game (saveload.gui)

    // The longest name the Save Game box takes.
    const SAVE_NAME_MAX: i32 = 40

    // Fills the list: Load Game shows ours and the install's saves, Save Game ours with "New Slot"
    // first (list_saves). The install's saves are read-only here: nothing deletes them, so the
    // Delete button is hidden in both.
    fn fill_saves { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, p: u32, for_save: bool } -> ! {
        if fe.saves_loaded {
            free_saves{ heap = fe.heap, list = fe.saves }
            fe.saves_loaded = false
        }
        fe.saves = list_saves{
            &fs, heap = fe.heap, scratch = &g.cache.scratch, own = fe.own_saves[..fe.own_saves_len],
            install = fe.saves_dir[..fe.saves_dir_len], for_save,
        } iferr { SaveList{ entries = slice::empty(SaveEntry){}, count = 0 } }
        fe.saves_loaded = true
        try gui::set_strref{ &g, panel = p, tag = "LBL_PANELNAME", strref = if for_save { 1588 } else { 1585 } }
        try gui::set_strref{ &g, panel = p, tag = "BTN_SAVELOAD", strref = if for_save { 1587 } else { 1589 } }
        gui::set_visible{ &g, panel = p, tag = "BTN_DELETE", visible = false }
        // Saving needs no selection (the "New Slot" row is the one); loading needs a save picked.
        gui::set_enabled{ &g, panel = p, tag = "BTN_SAVELOAD", enabled = for_save }
        gui::list_clear{ &g, panel = p, tag = "LB_GAMES" }
        let mut i: usize = 0
        while i < fe.saves.count {
            let e = fe.saves.entries[i]
            if e.new_slot {
                let title = try gui::tlk_text{ &g, strref = 1590 }
                defer gui::free_string{ &g, s = title }
                _ = try gui::list_add{ &g, panel = p, tag = "LB_GAMES", text = if title.len > 0 { title } else { e.label[..e.label_len] }, user = @as(i64, i) }
            } else {
                _ = try gui::list_add{ &g, panel = p, tag = "LB_GAMES", text = e.label[..e.label_len], user = @as(i64, i) }
            }
            gui::list_set_color{ &g, panel = p, tag = "LB_GAMES", row = @as(i32, i), color = gui::color_menu{} }
            i = i + 1
        }
        if for_save and fe.saves.count > 0 { gui::list_select{ &g, panel = p, tag = "LB_GAMES", row = 0 } }
        try gui::set_text{ &g, panel = p, tag = "LBL_PLANETNAME", text = "" }
        try gui::set_text{ &g, panel = p, tag = "LBL_AREANAME", text = "" }
    }

    // Shows the details of the highlighted save: area, time, party and the screenshot.
    fn show_save { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, p: u32, row: i32, for_save: bool } -> ! {
        if row < 0 or @as(usize, row) >= fe.saves.count { return }
        let e = fe.saves.entries[@as(usize, row)]
        gui::set_enabled{ &g, panel = p, tag = "BTN_SAVELOAD", enabled = for_save or not e.corrupt }
        release_shot{ &fe, &dev }
        let tags: [3][]u8 = ["LBL_PM1", "LBL_PM2", "LBL_PM3"]
        if e.new_slot {
            // Nothing is saved there yet.
            try gui::set_text{ &g, panel = p, tag = "LBL_PLANETNAME", text = "" }
            try gui::set_text{ &g, panel = p, tag = "LBL_AREANAME", text = "" }
            gui::clear_picture{ &g, panel = p, tag = "LBL_SCREENSHOT" }
            let mut k: usize = 0
            while k < 3 {
                gui::clear_picture{ &g, panel = p, tag = tags[k] }
                k = k + 1
            }
            return
        }
        // The area is saved as "Planet - Place"; the panel has a label for each half.
        let area = e.area[..e.area_len]
        let dash = ci::find{ s = area, needle = " - " }
        if dash != null {
            try gui::set_text{ &g, panel = p, tag = "LBL_PLANETNAME", text = area[..dash] }
            try gui::set_text{ &g, panel = p, tag = "LBL_AREANAME", text = area[dash + 3..] }
        } else {
            try gui::set_text{ &g, panel = p, tag = "LBL_PLANETNAME", text = "" }
            try gui::set_text{ &g, panel = p, tag = "LBL_AREANAME", text = area }
        }
        let shot = load_screenshot{ &fs, &dev, heap = fe.heap, scratch = &g.cache.scratch, folder = e.path[..e.path_len] } iferr { null }
        fe.shot = shot
        if shot != null {
            gui::set_picture{ &g, panel = p, tag = "LBL_SCREENSHOT", texture = shot, w = 256.0, h = 256.0 }
        } else {
            gui::clear_picture{ &g, panel = p, tag = "LBL_SCREENSHOT" }
        }
        let mut k: usize = 0
        while k < 3 {
            if k < e.portrait_count {
                let img = gui::resolve_img{ &g, &fs, &dev, name = resref::bytes{ r = &e.portraits[k] } }
                if img.ok { gui::set_picture{ &g, panel = p, tag = tags[k], texture = img.tex, w = img.w, h = img.h } } else { gui::clear_picture{ &g, panel = p, tag = tags[k] } }
            } else {
                gui::clear_picture{ &g, panel = p, tag = tags[k] }
            }
            k = k + 1
        }
    }

    fn load_outcome { fe: *Front, row: i32 } -> Outcome {
        if row < 0 or @as(usize, row) >= fe.saves.count { return Outcome::running }
        let e = fe.saves.entries[@as(usize, row)]
        if e.corrupt or e.new_slot { return Outcome::running }
        return Outcome::load_game{ folder = e.path, folder_len = e.path_len }
    }

    // ---- the name box of Save Game (savename.gui)

    // "Game N - Hh Mm" (dialog.tlk 1594): N is the number of the manual save about to be made (one
    // under its folder's slot, which starts at 2), H and M the play time.
    fn make_default_name { mut fe: Front } {
        let mut highest: i32 = 1
        let mut i: usize = 0
        while i < fe.saves.count {
            if fe.saves.entries[i].number > highest { highest = fe.saves.entries[i].number }
            i = i + 1
        }
        let out = fe.name_default[..]
        let mut n = copy_into{ dst = out, src = "Game " }
        n = put_int{ into = out, at = n, n = highest }
        n = n + copy_into{ dst = out[n..], src = " - " }
        n = put_int{ into = out, at = n, n = @as(i32, fe.played_seconds / 3600) }
        n = n + copy_into{ dst = out[n..], src = "h " }
        n = put_int{ into = out, at = n, n = @as(i32, (fe.played_seconds / 60) % 60) }
        n = n + copy_into{ dst = out[n..], src = "m" }
        fe.name_default_len = n
    }

    // Save was pressed (or the row activated) on `row`: asks for the name, starting with the
    // default for a new slot or the name of the save that is being replaced. The original asks
    // "Are you sure you want to overwrite" (1591) for an existing one and writes over it; the game
    // layer here only makes new slots (save::save_named), so the old save stays and there is
    // nothing to confirm.
    fn begin_save_name { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, row: i32 } {
        if row < 0 or @as(usize, row) >= fe.saves.count { return }
        let e = fe.saves.entries[@as(usize, row)]
        if e.new_slot {
            make_default_name{ &fe }
        } else {
            fe.name_default_len = copy_into{ dst = fe.name_default[..], src = e.label[..e.label_len] }
        }
        open_screen{ &fe, &g, &fs, &dev, screen = SCR_SAVENAME } iferr {}
    }

    // The name box was just opened: an edit box (code makes it one: the file has a label) with the
    // default name, taking typed text.
    fn open_save_name { mut fe: Front, mut g: gui::Gui, p: u32 } -> ! {
        gui::make_edit{ &g, panel = p, tag = "EDITBOX" }
        gui::set_max_chars{ &g, panel = p, tag = "EDITBOX", max = SAVE_NAME_MAX }
        try gui::set_text{ &g, panel = p, tag = "EDITBOX", text = fe.name_default[..fe.name_default_len] }
        gui::set_focus{ &g, panel = p, tag = "EDITBOX" }
    }

    fn trim_spaces { s: []u8 } -> []u8 {
        let mut a: usize = 0
        let mut b = s.len
        while a < b and s[a] == ' ' { a = a + 1 }
        while b > a and s[b - 1] == ' ' { b = b - 1 }
        return s[a..b]
    }

    // OK (or Enter) in the name box: the name becomes the request (an empty one is the default),
    // and the box and the Save Game list close.
    fn accept_save_name { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, p: u32 } {
        let c = gui::find_control{ &g, panel = p, tag = "EDITBOX" } ifnull { return }
        let typed = trim_spaces{ s = c.text.text }
        fe.save_len = copy_into{ dst = fe.save_name[..], src = if typed.len > 0 { typed } else { fe.name_default[..fe.name_default_len] } }
        close_top{ &fe, &g, &fs, &dev }
        close_top{ &fe, &g, &fs, &dev }
    }

    // ---- the options

    fn defaults_for { mut fe: Front, screen: u32 } {
        let d = default_settings{}
        if screen == SCR_GAMEPLAY {
            fe.settings.difficulty = d.difficulty
            fe.settings.mouse_look = d.mouse_look
            fe.settings.auto_level_up = d.auto_level_up
            fe.settings.autosave = d.autosave
            fe.settings.reverse_minigame_y = d.reverse_minigame_y
            fe.settings.combat_movement = d.combat_movement
        } else if screen == SCR_FEEDBACK {
            fe.settings.floating_numbers = d.floating_numbers
            fe.settings.tutorial_popups = d.tutorial_popups
            fe.settings.status_summary = d.status_summary
            fe.settings.subtitles = d.subtitles
            fe.settings.minimap = d.minimap
            fe.settings.tooltips = d.tooltips
        } else if screen == SCR_AUTOPAUSE {
            fe.settings.pause_end_round = d.pause_end_round
            fe.settings.pause_enemy_sighted = d.pause_enemy_sighted
            fe.settings.pause_mine_sighted = d.pause_mine_sighted
            fe.settings.pause_party_killed = d.pause_party_killed
            fe.settings.pause_action_menu = d.pause_action_menu
            fe.settings.pause_triggers = d.pause_triggers
        } else if screen == SCR_GRAPHICS {
            fe.settings.gamma = d.gamma
            fe.settings.shadows = d.shadows
            fe.settings.grass = d.grass
            fe.display_pending = true
        } else if screen == SCR_GRAPHICS_ADV {
            fe.settings.antialias = d.antialias
            fe.settings.texture_quality = d.texture_quality
            fe.settings.anisotropy = d.anisotropy
            fe.settings.frame_buffer = d.frame_buffer
            fe.settings.soft_shadows = d.soft_shadows
            fe.settings.vsync = d.vsync
            fe.display_pending = true
        } else if screen == SCR_SOUND {
            fe.settings.music = d.music
            fe.settings.voice = d.voice
            fe.settings.effects = d.effects
            fe.settings.movie = d.movie
            fe.sound_pending = true
        } else if screen == SCR_SOUND_ADV {
            fe.settings.eax = d.eax
            fe.settings.force_software = d.force_software
        } else if screen == SCR_MOUSE {
            fe.settings.mouse_sensitivity = d.mouse_sensitivity
            fe.settings.reverse_buttons = d.reverse_buttons
        }
    }

    // A check box or slider of an options panel changed to `v`.
    fn apply_value { mut fe: Front, screen: u32, tag: []u8, v: i32 } {
        let on = v != 0
        let s = &fe.settings
        if screen == SCR_GAMEPLAY {
            if slice::eq_bytes{ a = tag, b = "CB_INVERTCAM" } { s.mouse_look = on }
            else if slice::eq_bytes{ a = tag, b = "CB_LEVELUP" } { s.auto_level_up = on }
            else if slice::eq_bytes{ a = tag, b = "CB_AUTOSAVE" } { s.autosave = on }
            else if slice::eq_bytes{ a = tag, b = "CB_REVERSE" } { s.reverse_minigame_y = on }
            else if slice::eq_bytes{ a = tag, b = "CB_DISABLEMOVE" } { s.combat_movement = on }
        } else if screen == SCR_AUTOPAUSE {
            if slice::eq_bytes{ a = tag, b = "CB_ENDROUND" } { s.pause_end_round = on }
            else if slice::eq_bytes{ a = tag, b = "CB_ENEMYSIGHTED" } { s.pause_enemy_sighted = on }
            else if slice::eq_bytes{ a = tag, b = "CB_MINESIGHTED" } { s.pause_mine_sighted = on }
            else if slice::eq_bytes{ a = tag, b = "CB_PARTYKILLED" } { s.pause_party_killed = on }
            else if slice::eq_bytes{ a = tag, b = "CB_ACTIONMENU" } { s.pause_action_menu = on }
            else if slice::eq_bytes{ a = tag, b = "CB_TRIGGERS" } { s.pause_triggers = on }
        } else if screen == SCR_GRAPHICS {
            if slice::eq_bytes{ a = tag, b = "SLI_GAMMA" } { s.gamma = v; fe.display_pending = true }
            else if slice::eq_bytes{ a = tag, b = "CB_SHADOWS" } { s.shadows = on; fe.display_pending = true }
            else if slice::eq_bytes{ a = tag, b = "CB_GRASS" } { s.grass = on; fe.display_pending = true }
        } else if screen == SCR_GRAPHICS_ADV {
            if slice::eq_bytes{ a = tag, b = "CB_FRAMEBUFF" } { s.frame_buffer = on }
            else if slice::eq_bytes{ a = tag, b = "CB_SOFTSHADOWS" } { s.soft_shadows = on }
            else if slice::eq_bytes{ a = tag, b = "CB_VSYNC" } { s.vsync = on }
            fe.display_pending = true
        } else if screen == SCR_SOUND {
            if slice::eq_bytes{ a = tag, b = "SLI_MUSIC" } { s.music = v }
            else if slice::eq_bytes{ a = tag, b = "SLI_VO" } { s.voice = v }
            else if slice::eq_bytes{ a = tag, b = "SLI_FX" } { s.effects = v }
            else if slice::eq_bytes{ a = tag, b = "SLI_MOVIE" } { s.movie = v }
            fe.sound_pending = true
        } else if screen == SCR_SOUND_ADV {
            if slice::eq_bytes{ a = tag, b = "CB_FORCESOFTWARE" } { s.force_software = on }
        } else if screen == SCR_MOUSE {
            if slice::eq_bytes{ a = tag, b = "SLI_MOUSESEN" } { s.mouse_sensitivity = v }
            else if slice::eq_bytes{ a = tag, b = "CB_REVBUTTONS" } { s.reverse_buttons = on }
        }
    }

    // The arrows beside a choice button (difficulty, anti-aliasing, ...): the new value.
    fn cycle { v: i32, count: i32, step: i32 } -> i32 {
        let n = v + step
        if n < 0 { return count - 1 }
        if n >= count { return 0 }
        return n
    }

    // Applies the volumes to the mixer's groups.
    fn apply_sound { mut fe: Front, mixer: ?*mut mix::Mixer } {
        fe.sound_pending = false
        let m = mixer ifnull { return }
        mix::set_group_volume{ m, group = mix::Group::music, volume = @as(f32, fe.settings.music) / 100.0 }
        mix::set_group_volume{ m, group = mix::Group::voice, volume = @as(f32, fe.settings.voice) / 100.0 }
        mix::set_group_volume{ m, group = mix::Group::sfx, volume = @as(f32, fe.settings.effects) / 100.0 }
        mix::set_group_volume{ m, group = mix::Group::movie, volume = @as(f32, fe.settings.movie) / 100.0 }
    }

    // Choice buttons: which setting a left/right button pair edits.
    fn change_choice { mut fe: Front, mut g: gui::Gui, p: u32, screen: u32, tag: []u8 } -> ! {
        let left = tag.len > 5 and slice::eq_bytes{ a = tag[tag.len - 4..], b = "LEFT" }
        let right = tag.len > 5 and tag.len >= 5 and slice::eq_bytes{ a = tag[tag.len - 5..], b = "RIGHT" }
        if not left and not right { return }
        let step: i32 = if left { -1 } else { 1 }
        let base = if left { tag[..tag.len - 4] } else { tag[..tag.len - 5] }
        let s = &fe.settings
        if slice::eq_bytes{ a = base, b = "BTN_DIFF" } {
            s.difficulty = cycle{ v = s.difficulty, count = 3, step }
            try show_difficulty{ &g, p, d = s.difficulty }
        } else if slice::eq_bytes{ a = base, b = "BTN_ANTIALIAS_" } or slice::eq_bytes{ a = base, b = "BTN_ANTIALIAS" } {
            s.antialias = cycle{ v = s.antialias, count = 4, step }
            try show_choice{ &g, p, tag = "BTN_ANTIALIAS", which = CH_AA, v = s.antialias }
            fe.display_pending = true
        } else if slice::eq_bytes{ a = base, b = "BTN_TEXQUAL" } {
            s.texture_quality = cycle{ v = s.texture_quality, count = 3, step }
            try show_choice{ &g, p, tag = "BTN_TEXQUAL", which = CH_TEX, v = s.texture_quality }
            fe.display_pending = true
        } else if slice::eq_bytes{ a = base, b = "BTN_ANISOTROPY" } {
            s.anisotropy = cycle{ v = s.anisotropy, count = 4, step }
            try show_choice{ &g, p, tag = "BTN_ANISOTROPY", which = CH_AF, v = s.anisotropy }
            fe.display_pending = true
        } else if slice::eq_bytes{ a = base, b = "BTN_EAX" } {
            s.eax = not s.eax
            try show_choice{ &g, p, tag = "BTN_EAX", which = CH_EAX, v = if s.eax { 1 } else { 0 } }
        }
    }

    // Rebinds the controls of the top screen after its settings were reset.
    fn rebind { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, screen: u32, p: u32 } -> ! {
        try bind_screen{ &fe, &g, &fs, &dev, screen, p }
    }

    // ---- character generation (lib/chargen)

    fn new_game_outcome { fe: *Front, player: []u8 } -> Outcome {
        return Outcome::new_game{ module = resref::truncate{ name = fe.start_module[..fe.start_len] }, player }
    }

    // New Game: the original makes the player before it loads the first module. Without the data
    // for it (or when it fails) the game starts at once with the engine's default player.
    //
    // Character generation shows the loading screen with the class selection's picture while it is made
    // (re/gui.md 10.2: CSWGuiClassSelection's constructor does): this only puts the screen up, and the work is
    // done by `start_chargen` on the next step, after the engine has drawn the screen once.
    fn begin_chargen { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device } -> Outcome {
        fe.load_panel = show_loading{ &fe, &g, &fs, &dev, name = "classsel", story = false, saving = false } iferr { 0 }
        if fe.load_panel == 0 { return start_chargen{ &fe, &g, &fs, &dev } }
        set_loading_progress{ &g, panel = fe.load_panel, percent = 30 }
        fe.cg_wait = true
        return Outcome::running
    }

    fn start_chargen { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device } -> Outcome {
        fe.cg_wait = false
        let seed = @as(u32, g.time * 1000.0)
        let st = chargen::begin{ &fs, &g, &dev, heap = fe.heap, seed } iferr {
            close_loading{ &fe, &g }
            return new_game_outcome{ &fe, player = slice::empty(u8){} }
        }
        fe.cg = st
        close_loading{ &fe, &g }
        return Outcome::running
    }

    fn close_loading { mut fe: Front, mut g: gui::Gui } {
        if fe.load_panel != 0 { gui::close{ &g, id = fe.load_panel } }
        fe.load_panel = 0
    }

    fn end_chargen { mut fe: Front, mut g: gui::Gui, mut dev: gpu::Device } {
        let st = fe.cg ifnull { return }
        chargen::free{ st, &g, &dev }
        fe.cg = null
    }

    // An event while the character generation panels are up. Finished hands the character on;
    // cancelled leaves the main menu as it was.
    fn chargen_event { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        let st = fe.cg ifnull { return Outcome::running }
        let o = chargen::on_event{ st, &g, &fs, &dev, ev }
        if o is finished { return new_game_outcome{ &fe, player = st.player } }
        if o is cancelled { end_chargen{ &fe, &g, &dev } }
        return Outcome::running
    }

    // One event from the GUI. Returns what the engine should do next.
    fn on_event { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        if fe.cg != null { return chargen_event{ &fe, &g, &fs, &dev, ev } }
        let screen = screen_of{ &fe, panel = ev.panel }
        if screen == 0 { return Outcome::running }
        let p = ev.panel
        if ev.kind == gui::EventKind::cancel {
            if screen != SCR_MAIN { close_top{ &fe, &g, &fs, &dev } }
            return Outcome::running
        }
        if screen == SCR_MAIN {
            if ev.kind != gui::EventKind::activate { return Outcome::running }
            if tag_is{ ev, tag = "BTN_NEWGAME" } { return begin_chargen{ &fe, &g, &fs, &dev } }
            if tag_is{ ev, tag = "BTN_LOADGAME" } { open_screen{ &fe, &g, &fs, &dev, screen = SCR_LOAD } iferr {} }
            if tag_is{ ev, tag = "BTN_MOVIES" } { open_screen{ &fe, &g, &fs, &dev, screen = SCR_MOVIES } iferr {} }
            if tag_is{ ev, tag = "BTN_OPTIONS" } { open_screen{ &fe, &g, &fs, &dev, screen = SCR_OPTIONS } iferr {} }
            if tag_is{ ev, tag = "BTN_EXIT" } { return Outcome::quit }
            return Outcome::running
        }
        if screen == SCR_LOAD or screen == SCR_SAVE {
            let saving = screen == SCR_SAVE
            if ev.kind == gui::EventKind::row_selected {
                show_save{ &fe, &g, &fs, &dev, p, row = ev.row, for_save = saving } iferr {}
            } else if ev.kind == gui::EventKind::row_activated {
                if saving { begin_save_name{ &fe, &g, &fs, &dev, row = ev.row } } else { return load_outcome{ &fe, row = ev.row } }
            } else if ev.kind == gui::EventKind::activate {
                if tag_is{ ev, tag = "BTN_SAVELOAD" } {
                    let row = gui::list_selected{ &g, panel = p, tag = "LB_GAMES" }
                    if saving { begin_save_name{ &fe, &g, &fs, &dev, row } } else { return load_outcome{ &fe, row } }
                }
                if tag_is{ ev, tag = "BTN_BACK" } { close_top{ &fe, &g, &fs, &dev } }
            }
            return Outcome::running
        }
        if screen == SCR_SAVENAME {
            if ev.kind == gui::EventKind::text_accepted or (ev.kind == gui::EventKind::activate and tag_is{ ev, tag = "BTN_OK" }) {
                accept_save_name{ &fe, &g, &fs, &dev, p }
            } else if ev.kind == gui::EventKind::activate and tag_is{ ev, tag = "BTN_CANCEL" } {
                close_top{ &fe, &g, &fs, &dev }
            }
            return Outcome::running
        }
        if screen == SCR_MOVIES {
            if ev.kind == gui::EventKind::row_activated {
                fe.play_len = movie_label{ &fe, &fs, rm = g.rm, row = ev.user, into = fe.play_request[..] }
            } else if ev.kind == gui::EventKind::activate and tag_is{ ev, tag = "BTN_BACK" } {
                close_top{ &fe, &g, &fs, &dev }
            }
            return Outcome::running
        }
        // The options panels.
        if ev.kind == gui::EventKind::value_changed and ev.control >= 0 {
            // A row of the feedback list is a check box too.
            apply_value{ &fe, screen, tag = ev.tag, v = ev.value }
            return Outcome::running
        }
        if screen == SCR_FEEDBACK and ev.kind == gui::EventKind::row_selected {
            let on = not gui::list_is_checked{ &g, panel = p, tag = "LB_OPTIONS", row = ev.row }
            gui::list_set_checked{ &g, panel = p, tag = "LB_OPTIONS", row = ev.row, checked = on }
            let s = &fe.settings
            if ev.row == 0 { s.floating_numbers = on } else if ev.row == 1 { s.tutorial_popups = on } else if ev.row == 2 { s.status_summary = on }
            else if ev.row == 3 { s.subtitles = on } else if ev.row == 4 { s.minimap = on } else if ev.row == 5 { s.tooltips = on }
            return Outcome::running
        }
        if screen == SCR_RESOLUTION {
            if ev.kind == gui::EventKind::row_activated or (ev.kind == gui::EventKind::activate and tag_is{ ev, tag = "BTN_OK" }) {
                let row = gui::list_selected{ &g, panel = p, tag = "LB_RESOLUTIONS" }
                if row >= 0 and row < 15 {
                    fe.settings.width = MODES[@as(usize, row)][0]
                    fe.settings.height = MODES[@as(usize, row)][1]
                    fe.display_pending = true
                }
                close_top{ &fe, &g, &fs, &dev }
            } else if ev.kind == gui::EventKind::activate and tag_is{ ev, tag = "BTN_CANCEL" } {
                close_top{ &fe, &g, &fs, &dev }
            }
            return Outcome::running
        }
        if ev.kind != gui::EventKind::activate { return Outcome::running }
        if tag_is{ ev, tag = "BTN_CANCEL" } and (screen == SCR_GRAPHICS_ADV or screen == SCR_SOUND_ADV) {
            fe.settings = fe.snapshot
            fe.display_pending = true
            fe.sound_pending = true
        }
        if tag_is{ ev, tag = "BTN_BACK" } or tag_is{ ev, tag = "BTN_CANCEL" } or tag_is{ ev, tag = "BTN_EXIT" } {
            close_top{ &fe, &g, &fs, &dev }
            return Outcome::running
        }
        if tag_is{ ev, tag = "BTN_DEFAULT" } {
            defaults_for{ &fe, screen }
            rebind{ &fe, &g, &fs, &dev, screen, p } iferr {}
            return Outcome::running
        }
        if screen == SCR_OPTIONS {
            let next: u32 = if tag_is{ ev, tag = "BTN_GAMEPLAY" } { SCR_GAMEPLAY }
                else if tag_is{ ev, tag = "BTN_FEEDBACK" } { SCR_FEEDBACK }
                else if tag_is{ ev, tag = "BTN_AUTOPAUSE" } { SCR_AUTOPAUSE }
                else if tag_is{ ev, tag = "BTN_GRAPHICS" } { SCR_GRAPHICS }
                else if tag_is{ ev, tag = "BTN_SOUND" } { SCR_SOUND }
                else { 0 }
            if next != 0 { open_screen{ &fe, &g, &fs, &dev, screen = next } iferr {} }
        } else if screen == SCR_GAMEPLAY {
            if tag_is{ ev, tag = "BTN_MOUSE" } { open_screen{ &fe, &g, &fs, &dev, screen = SCR_MOUSE } iferr {} }
            else { change_choice{ &fe, &g, p, screen, tag = ev.tag } iferr {} }
        } else if screen == SCR_GRAPHICS {
            if tag_is{ ev, tag = "BTN_RESOLUTION" } { open_screen{ &fe, &g, &fs, &dev, screen = SCR_RESOLUTION } iferr {} }
            else if tag_is{ ev, tag = "BTN_ADVANCED" } { open_screen{ &fe, &g, &fs, &dev, screen = SCR_GRAPHICS_ADV } iferr {} }
        } else if screen == SCR_SOUND {
            if tag_is{ ev, tag = "BTN_ADVANCED" } { open_screen{ &fe, &g, &fs, &dev, screen = SCR_SOUND_ADV } iferr {} }
        } else if screen == SCR_GRAPHICS_ADV or screen == SCR_SOUND_ADV {
            change_choice{ &fe, &g, p, screen, tag = ev.tag } iferr {}
        }
        return Outcome::running
    }
}
