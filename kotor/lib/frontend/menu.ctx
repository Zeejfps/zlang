// The front end's screens: the main menu, the options panels, Load Game and the movie list,
// driven by the events lib/gui makes (docs/design/gui.md, "The front end"). Each screen is a
// .gui file; a stack of them mirrors the GUI's panel stack, and `step` turns events into
// changes of the options or an Outcome for the engine.
namespace frontend {
    const SCR_MAIN: u32 = 1
    const SCR_OPTIONS: u32 = 2
    const SCR_GAMEPLAY: u32 = 3
    const SCR_FEEDBACK: u32 = 4
    const SCR_AUTOPAUSE: u32 = 5
    const SCR_GRAPHICS: u32 = 6
    const SCR_GRAPHICS_ADV: u32 = 7
    const SCR_RESOLUTION: u32 = 8
    const SCR_SOUND: u32 = 9
    const SCR_SOUND_ADV: u32 = 10
    const SCR_MOUSE: u32 = 11
    const SCR_LOAD: u32 = 12
    const SCR_MOVIES: u32 = 13
    const SCR_SAVE: u32 = 14                // the Save Game list (saveload.gui in save mode); in game only
    const SCR_SAVENAME: u32 = 15            // its name box (savename.gui), over it

    // What the engine does next.
    union Outcome {
        running,                                            // keep stepping
        new_game{ module: resref::ResRef, player: []u8 },   // start this module as a new game; `player` is the created character (a UTC-shaped GFF, empty: none)
        load_game{ folder: [300]u8, folder_len: usize },    // load the save in this folder (a path, ours or the install's: save::find_save resolves it)
        quit,
    }

    struct Entry { screen: u32, panel: u32 }

    const MAX_MODES: usize = 192

    // The values the UI Scale button steps through; 0 fits the window.
    const UI_SCALES: [9]f32 = [0.0, 1.0, 1.25, 1.5, 1.75, 2.0, 2.5, 3.0, 4.0]

    struct Front {
        heap: *mut heap::Heap,
        game: []u8,                         // the install, for Saves/
        own_saves: [300]u8, own_saves_len: usize,   // our saves directory (set_own_saves), listed with the install's
        played_seconds: u32,                // the game's play time, for the default save name (in game)
        save_name: [64]u8, save_len: usize, // the name the Save Game screen was given: take_save_request
        name_default: [64]u8, name_default_len: usize,  // what the name box starts with
        settings: Settings,
        config_path: [256]u8, config_len: usize,
        stack: [10]Entry, depth: usize,
        saves: SaveList, saves_loaded: bool,
        shot: ?render::Texture,             // the selected save's screenshot
        display_pending: bool,              // resolution, fullscreen or vsync changed: the engine applies it
        // What the display offers, for the resolution list (set_display_info): every mode, the desktop's, and the
        // room a window has; and the size the game renders at now, for the UI Scale button's "Auto (175%)".
        modes: [192]render::DisplayMode, mode_count: usize,
        desktop: render::DisplayMode,
        usable_w: i32, usable_h: i32,
        render_w: i32, render_h: i32,
        max_samples: i32, max_anisotropy: f32,  // the device's limits: the Advanced panel offers the steps within them
        rows: [192]render::DisplayMode, row_count: usize,      // the rows the resolution list shows
        sound_pending: bool,
        play_request: [24]u8, play_len: usize,      // a movie the player picked in the movie list
        start_module: [16]u8, start_len: usize,
        saves_dir: [300]u8, saves_dir_len: usize,
        snapshot: Settings,                 // the options when an Advanced panel opened, for its Cancel
        // the start-up movies and the movie list
        stage: u32,
        queue: [4][24]u8, queue_lens: [4]usize, queue_count: usize, queue_at: usize,
        player: ?*mut movie::Player,
        tables: ?*bink_tables::Tables,
        audio_clock: bool,
        from_menu: bool,                    // the movie playing was picked from the movie list
        // the 3D background of the main menu
        scene: ?*mut MenuScene,
        scene_failed: bool,
        // character generation, while the player is making a character
        cg: ?*mut chargen::State,
        // the menu's music
        music: mix::Handle,
        music_bytes: []mut u8,
        music_started: bool,
        hint_game: u32, hint_story: u32,    // the loading screen's round-robin hint counters
        cg_wait: bool,                      // New Game was picked: character generation starts after the next frame, behind its loading screen
        load_panel: u32,                    // that loading screen (0 when none)
        tutorials_allowed: bool,            // someone is playing: character generation's tutorial pop-ups may show
        tutorial_shown: [6]u8,              // the ones character generation showed, for the new game's shown set
    }

    // A front end with the options from `config_path` (the defaults if there is no such file).
    fn make { mut fs: Fs, heap: *mut heap::Heap, game: []u8, config_path: []u8 } -> Front {
        let mut fe = Front{
            heap, game, own_saves = [0; 300], own_saves_len = 0, played_seconds = 0,
            save_name = [0; 64], save_len = 0, name_default = [0; 64], name_default_len = 0,
            settings = load_settings{ &fs, heap, path = config_path },
            config_path = [0; 256], config_len = 0, stack = [Entry{ screen = 0, panel = 0 }; 10], depth = 0,
            saves = SaveList{ entries = slice::empty(SaveEntry){}, count = 0 }, saves_loaded = false, shot = null,
            display_pending = false, sound_pending = true,
            modes = [render::DisplayMode{ width = 0, height = 0, refresh = 0 }; 192], mode_count = 0,
            desktop = render::DisplayMode{ width = 1920, height = 1080, refresh = 60 }, usable_w = 1920, usable_h = 1080,
            render_w = 1280, render_h = 720, max_samples = 8, max_anisotropy = 16.0,
            rows = [render::DisplayMode{ width = 0, height = 0, refresh = 0 }; 192], row_count = 0,
            play_request = [0; 24], play_len = 0, start_module = [0; 16], start_len = 0,
            saves_dir = [0; 300], saves_dir_len = 0,
            snapshot = default_settings{},
            stage = 0, queue = [[0; 24]; 4], queue_lens = [0; 4], queue_count = 0, queue_at = 0,
            player = null, tables = null, audio_clock = true, from_menu = false,
            scene = null, scene_failed = false, cg = null,
            music = mix::Handle{ slot = 0, id = 0 }, music_bytes = slice::empty(u8){}, music_started = false,
            hint_game = 0, hint_story = 0, cg_wait = false, load_panel = 0, tutorials_allowed = false, tutorial_shown = [0; 6],
        }
        fe.config_len = copy_into{ dst = fe.config_path[..], src = config_path }
        fe.start_len = copy_into{ dst = fe.start_module[..], src = "end_m01aa" }
        let dir = join_path{ into = fe.saves_dir[..], a = game, b = "Saves", c = "" }
        fe.saves_dir_len = dir.len
        return fe
    }

    // Our saves directory: the Load Game list shows its saves with the install's, and the Save
    // Game list is made of them. Empty (the default): the install's only.
    fn set_own_saves { mut fe: Front, dir: []u8 } {
        fe.own_saves_len = copy_into{ dst = fe.own_saves[..], src = dir }
    }

    // The name typed in the Save Game screen, once: copied into `into`, its length (0 when none).
    fn take_save_request { mut fe: Front, into: []mut u8 } -> usize {
        let n = copy_into{ dst = into, src = fe.save_name[..fe.save_len] }
        fe.save_len = 0
        return n
    }

    fn screen_gui { screen: u32 } -> []u8 {
        if screen == SCR_MAIN { return "mainmenu" }
        if screen == SCR_OPTIONS { return "optionsmain" }
        if screen == SCR_GAMEPLAY { return "optgameplay" }
        if screen == SCR_FEEDBACK { return "optfeedback" }
        if screen == SCR_AUTOPAUSE { return "optautopause" }
        if screen == SCR_GRAPHICS { return "optgraphics" }
        if screen == SCR_GRAPHICS_ADV or screen == SCR_GRAPHICS_FX { return "optgraphicsadv" }
        if screen == SCR_RESOLUTION { return "optresolution" }
        if screen == SCR_SOUND { return "optsound" }
        if screen == SCR_SOUND_ADV { return "optsoundadv" }
        if screen == SCR_MOUSE { return "optmouse" }
        if screen == SCR_LOAD or screen == SCR_SAVE { return "saveload" }
        if screen == SCR_SAVENAME { return "savename" }
        return "titlemovie"
    }

    fn tag_is { ev: gui::Event, tag: []u8 } -> bool {
        return slice::eq_bytes{ a = ev.tag, b = tag }
    }

    fn top_screen { fe: *Front } -> u32 {
        if fe.depth == 0 { return 0 }
        return fe.stack[fe.depth - 1].screen
    }

    fn top_panel { fe: *Front } -> u32 {
        if fe.depth == 0 { return 0 }
        return fe.stack[fe.depth - 1].panel
    }

    fn screen_of { fe: *Front, panel: u32 } -> u32 {
        let mut i: usize = 0
        while i < fe.depth {
            if fe.stack[i].panel == panel { return fe.stack[i].screen }
            i = i + 1
        }
        return 0
    }

    // ---- opening and closing

    // Opens `screen` on top. Panels past the main menu are modal full-screen menus.
    fn open_screen { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, screen: u32 } -> ! {
        if fe.depth >= 10 { return }
        let mode = if screen == SCR_RESOLUTION or screen == SCR_SAVENAME { gui::Mode::dialog } else { gui::Mode::full_screen }
        if screen == SCR_GRAPHICS_ADV or screen == SCR_SOUND_ADV or screen == SCR_GRAPHICS_FX { fe.snapshot = fe.settings }
        let id = try gui::open{ &g, &fs, &dev, name = screen_gui{ screen }, mode, modal = screen != SCR_MAIN }
        gui::ensure_backdrop{ &g, &fs, &dev, kind = 0 }
        fe.stack[fe.depth] = Entry{ screen, panel = id }
        fe.depth = fe.depth + 1
        try bind_screen{ &fe, &g, &fs, &dev, screen, p = id }
    }

    // Closes the top screen; the options are written out when an options screen closes.
    fn close_top { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device } {
        if fe.depth <= 1 { return }
        let top = fe.stack[fe.depth - 1]
        gui::close{ &g, id = top.panel }
        fe.depth = fe.depth - 1
        if top.screen == SCR_LOAD or top.screen == SCR_SAVE { release_shot{ &fe, &dev } }
        if (top.screen >= SCR_OPTIONS and top.screen <= SCR_MOUSE and top.screen != SCR_RESOLUTION) or top.screen == SCR_GRAPHICS_FX { persist{ &fe, &fs } }
        let under = fe.stack[fe.depth - 1]
        if under.screen == SCR_GRAPHICS { sync_graphics{ &fe, &g, p = under.panel } iferr {} }
        gui::play_sound{ &g, n = 5 }
    }

    // Writes the options file. A failure is not fatal: the options still hold for this run.
    fn persist { mut fe: Front, mut fs: Fs } {
        save_settings{ &fs, heap = fe.heap, path = fe.config_path[..fe.config_len], s = fe.settings } iferr {}
    }

    fn release_shot { mut fe: Front, mut dev: gpu::Device } {
        let t = fe.shot ifnull { return }
        gpu::free_texture{ &dev, t }
        fe.shot = null
    }

    // ---- binding the options to the controls

    fn bind_screen { mut fe: Front, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, screen: u32, p: u32 } -> ! {
        let s = fe.settings
        if screen == SCR_MAIN {
            // The debug warp list and button are for the original's developers; the logos in the
            // file are not bound by its code. A 3D scene, if there is one, covers the picture.
            gui::set_visible{ &g, panel = p, tag = "LB_MODULES", visible = false }
            gui::set_visible{ &g, panel = p, tag = "BTN_WARP", visible = false }
            gui::set_visible{ &g, panel = p, tag = "LBL_NEWCONTENT", visible = false }
            gui::set_visible{ &g, panel = p, tag = "LBL_BW", visible = false }
            gui::set_visible{ &g, panel = p, tag = "LBL_LUCAS", visible = false }
            gui::set_focus{ &g, panel = p, tag = "BTN_NEWGAME" }
        } else if screen == SCR_OPTIONS {
            gui::set_focus{ &g, panel = p, tag = "BTN_GAMEPLAY" }
        } else if screen == SCR_GAMEPLAY {
            gui::set_checked{ &g, panel = p, tag = "CB_INVERTCAM", on = s.mouse_look }
            gui::set_checked{ &g, panel = p, tag = "CB_LEVELUP", on = s.auto_level_up }
            gui::set_checked{ &g, panel = p, tag = "CB_AUTOSAVE", on = s.autosave }
            gui::set_checked{ &g, panel = p, tag = "CB_REVERSE", on = s.reverse_minigame_y }
            gui::set_checked{ &g, panel = p, tag = "CB_DISABLEMOVE", on = s.combat_movement }
            try show_difficulty{ &g, p, d = s.difficulty }
            gui::set_enabled{ &g, panel = p, tag = "BTN_KEYMAP", enabled = false }
            gui::set_focus{ &g, panel = p, tag = "BTN_DIFFICULTY" }
        } else if screen == SCR_FEEDBACK {
            try fill_feedback{ &fe, &g, p }
        } else if screen == SCR_AUTOPAUSE {
            gui::set_checked{ &g, panel = p, tag = "CB_ENDROUND", on = s.pause_end_round }
            gui::set_checked{ &g, panel = p, tag = "CB_ENEMYSIGHTED", on = s.pause_enemy_sighted }
            gui::set_checked{ &g, panel = p, tag = "CB_MINESIGHTED", on = s.pause_mine_sighted }
            gui::set_checked{ &g, panel = p, tag = "CB_PARTYKILLED", on = s.pause_party_killed }
            gui::set_checked{ &g, panel = p, tag = "CB_ACTIONMENU", on = s.pause_action_menu }
            gui::set_checked{ &g, panel = p, tag = "CB_TRIGGERS", on = s.pause_triggers }
        } else if screen == SCR_GRAPHICS {
            try bind_graphics{ &fe, &g, p }
        } else if screen == SCR_GRAPHICS_ADV {
            gui::set_checked{ &g, panel = p, tag = "CB_FRAMEBUFF", on = s.frame_buffer }
            gui::set_checked{ &g, panel = p, tag = "CB_SOFTSHADOWS", on = s.soft_shadows }
            gui::set_checked{ &g, panel = p, tag = "CB_VSYNC", on = s.vsync }
            try show_choice{ &g, p, tag = "BTN_ANTIALIAS", which = CH_AA, v = s.antialias }
            try show_choice{ &g, p, tag = "BTN_TEXQUAL", which = CH_TEX, v = s.texture_quality }
            try show_choice{ &g, p, tag = "BTN_ANISOTROPY", which = CH_AF, v = s.anisotropy }
            // Greyed when the driver has no step but Off, as the original's (0x006e0520).
            enable_choice{ &g, p, tag = "BTN_ANTIALIAS", on = choice_count{ fe = &fe, which = CH_AA } > 1 }
            enable_choice{ &g, p, tag = "BTN_ANISOTROPY", on = choice_count{ fe = &fe, which = CH_AF } > 1 }
        } else if screen == SCR_GRAPHICS_FX {
            try bind_enhanced{ &fe, &g, p }
        } else if screen == SCR_RESOLUTION {
            try fill_resolutions{ &fe, &g, p }
        } else if screen == SCR_SOUND {
            gui::set_value{ &g, panel = p, tag = "SLI_MUSIC", value = s.music }
            gui::set_value{ &g, panel = p, tag = "SLI_VO", value = s.voice }
            gui::set_value{ &g, panel = p, tag = "SLI_FX", value = s.effects }
            gui::set_value{ &g, panel = p, tag = "SLI_MOVIE", value = s.movie }
        } else if screen == SCR_SOUND_ADV {
            gui::set_checked{ &g, panel = p, tag = "CB_FORCESOFTWARE", on = s.force_software }
            try show_choice{ &g, p, tag = "BTN_EAX", which = CH_EAX, v = if s.eax { 1 } else { 0 } }
        } else if screen == SCR_MOUSE {
            gui::set_value{ &g, panel = p, tag = "SLI_MOUSESEN", value = s.mouse_sensitivity }
            gui::set_checked{ &g, panel = p, tag = "CB_REVBUTTONS", on = s.reverse_buttons }
        } else if screen == SCR_LOAD {
            try fill_saves{ &fe, &g, &fs, &dev, p, for_save = false }
        } else if screen == SCR_SAVE {
            try fill_saves{ &fe, &g, &fs, &dev, p, for_save = true }
        } else if screen == SCR_SAVENAME {
            try open_save_name{ &fe, &g, p }
        } else if screen == SCR_MOVIES {
            try fill_movies{ &fe, &g, &fs, p }
        }
    }

    const CH_AA: u32 = 0
    const CH_TEX: u32 = 1
    const CH_AF: u32 = 2
    const CH_EAX: u32 = 3
    const CH_DIFF: u32 = 4

    // The steps of the anti-aliasing and anisotropy buttons, the original's: Off, 2, 4, 6, 8 samples (0x006e0520) and
    // Off, 2x, 4x, 8x, 16x taps (0x006e06d0).
    fn aa_samples { step: i32 } -> i32 {
        return if step <= 0 { 0 } else if step == 1 { 2 } else if step == 2 { 4 } else if step == 3 { 6 } else { 8 }
    }

    fn aniso_taps { step: i32 } -> i32 {
        return if step <= 0 { 1 } else if step == 1 { 2 } else if step == 2 { 4 } else if step == 3 { 8 } else { 16 }
    }

    fn set_device_limits { mut fe: Front, max_samples: i32, max_anisotropy: f32 } {
        fe.max_samples = max_samples
        fe.max_anisotropy = max_anisotropy
    }

    // How many steps a button cycles through (left and right arrows). The anti-aliasing and anisotropy buttons offer
    // only the steps the driver has, as the original's lists hold only those (0x006e05e0, 0x006e06d0).
    fn choice_count { fe: *Front, which: u32 } -> i32 {
        if which == CH_AA {
            let mut n: i32 = 1
            while n < 5 and aa_samples{ step = n } <= fe.max_samples { n = n + 1 }
            return n
        }
        if which == CH_AF {
            let mut n: i32 = 1
            while n < 5 and @as(f32, aniso_taps{ step = n }) <= fe.max_anisotropy { n = n + 1 }
            return n
        }
        if which == CH_TEX or which == CH_DIFF { return 3 }
        return 2
    }

    // A choice button and its arrows (the files name them BTN_XLEFT, BTN_XRIGHT, or BTN_X_RIGHT) enabled or greyed.
    fn enable_choice { mut g: gui::Gui, p: u32, tag: []u8, on: bool } {
        gui::set_enabled{ &g, panel = p, tag, enabled = on }
        let sides: [4][]u8 = ["LEFT", "RIGHT", "_LEFT", "_RIGHT"]
        let mut name: [40]u8
        let mut i: usize = 0
        while i < 4 {
            let n = tag.len + sides[i].len
            if n <= name.len {
                slice::copy(u8){ dst = name[..tag.len], src = tag }
                slice::copy(u8){ dst = name[tag.len..n], src = sides[i] }
                gui::set_enabled{ &g, panel = p, tag = name[..n], enabled = on }
            }
            i = i + 1
        }
    }

    fn choice_text { which: u32, v: i32 } -> []u8 {
        if which == CH_AA {
            return if v == 1 { "2x" } else if v == 2 { "4x" } else if v == 3 { "6x" } else if v >= 4 { "8x" } else { "Off" }
        }
        if which == CH_AF {
            return if v == 1 { "2x" } else if v == 2 { "4x" } else if v == 3 { "8x" } else if v >= 4 { "16x" } else { "Off" }
        }
        if which == CH_TEX { return if v == 0 { "Low" } else if v == 1 { "Medium" } else { "High" } }
        if which == CH_DIFF { return if v == 0 { "Easy" } else if v == 1 { "Normal" } else { "Hard" } }
        return if v == 0 { "Off" } else { "On" }
    }

    fn show_difficulty { mut g: gui::Gui, p: u32, d: i32 } -> ! {
        try show_choice{ &g, p, tag = "BTN_DIFFICULTY", which = CH_DIFF, v = d }
    }

    // A button whose text is the current choice of a short list.
    fn show_choice { mut g: gui::Gui, p: u32, tag: []u8, which: u32, v: i32 } -> ! {
        try gui::set_text{ &g, panel = p, tag, text = choice_text{ which, v } }
    }

    fn fill_feedback { mut fe: Front, mut g: gui::Gui, p: u32 } -> ! {
        gui::list_clear{ &g, panel = p, tag = "LB_OPTIONS" }
        let s = fe.settings
        let names: [6][]u8 = ["Floating Numbers", "Tutorial Popups", "Status Summary", "Subtitles", "Mini Map", "Tooltips"]
        let vals: [6]bool = [s.floating_numbers, s.tutorial_popups, s.status_summary, s.subtitles, s.minimap, s.tooltips]
        let mut i: usize = 0
        while i < 6 {
            let row = try gui::list_add{ &g, panel = p, tag = "LB_OPTIONS", text = names[i], user = @as(i64, i) }
            gui::list_set_checked{ &g, panel = p, tag = "LB_OPTIONS", row, checked = vals[i] }
            i = i + 1
        }
    }

    // ---- the graphics panel's extra controls

    // What the display offers (the platform layer's list: gpu::list_display_modes, desktop_mode,
    // usable_size) and the size the game renders at. Set before the options open, and again when the
    // display changes.
    fn set_display_info { mut fe: Front, modes: []render::DisplayMode, desktop: render::DisplayMode, usable: render::Size, render_size: render::Size } {
        let n = if modes.len < MAX_MODES { modes.len } else { MAX_MODES }
        let mut i: usize = 0
        while i < n {
            fe.modes[i] = modes[i]
            i = i + 1
        }
        fe.mode_count = n
        fe.desktop = desktop
        fe.usable_w = @as(i32, usable.width)
        fe.usable_h = @as(i32, usable.height)
        fe.render_w = @as(i32, render_size.width)
        fe.render_h = @as(i32, render_size.height)
    }

    // The Graphics panel's buttons are 240 pixels wide and the original's own labels leave them 17 to 25 pixels
    // either side (dialogfont16x16: "Texture Quality" in 200, "Frame Buffer Effects" in 240 leaves 18). Ours keep to
    // that, in the widest case each can have: 204 pixels of text in 240. "Display Mode: Borderless" was 239.
    fn window_mode_text { mode: i32 } -> []u8 {
        if mode == 1 { return "Display: Fullscreen" }
        if mode == 2 { return "Display: Borderless" }
        return "Display: Windowed"
    }

    // "UI Scale: Auto 175%" or "UI Scale: 200%".
    fn ui_scale_text { fe: *Front, into: []mut u8 } -> []u8 {
        let want = fe.settings.gui_scale
        let shown = if want <= 0.0 { gui::auto_scale{ w = fe.render_w, h = fe.render_h } } else { want }
        let mut n = copy_into{ dst = into, src = "UI Scale: " }
        if want <= 0.0 { n = n + copy_into{ dst = into[n..], src = "Auto " } }
        n = put_int{ into, at = n, n = @as(i32, math::floorf{ x = shown * 100.0 + 0.5 }) }
        n = n + copy_into{ dst = into[n..], src = "%" }
        return into[..n]
    }

    fn resolution_text { fe: *Front, into: []mut u8 } -> []u8 {
        let s = &fe.settings
        // "Screen: 3840 x 2160" is 200 pixels, "Resolution: 3840 x 2160" 233 and "Resolution: Desktop (3840 x 2160)" 327.
        let mut n = copy_into{ dst = into, src = "Screen: " }
        if s.window_mode == 2 and s.width >= fe.desktop.width and s.height >= fe.desktop.height {
            n = n + copy_into{ dst = into[n..], src = "Desktop" }
            return into[..n]
        }
        n = n + format_mode{ into = into[n..], w = s.width, h = s.height }
        return into[..n]
    }

    // Writes the display texts of the Graphics panel again (its three buttons show the settings).
    fn sync_graphics { mut fe: Front, mut g: gui::Gui, p: u32 } -> ! {
        let mut buf: [48]u8
        try gui::set_text{ &g, panel = p, tag = "BTN_RESOLUTION", text = resolution_text{ &fe, into = buf[..] } }
        try gui::set_text{ &g, panel = p, tag = "BTN_DISPLAYMODE", text = window_mode_text{ mode = fe.settings.window_mode } }
        try gui::set_text{ &g, panel = p, tag = "BTN_UISCALE", text = ui_scale_text{ &fe, into = buf[..] } }
        // Soft Shadows on the Advanced panel may have switched Shadows on.
        gui::set_checked{ &g, panel = p, tag = "CB_SHADOWS", on = fe.settings.shadows }
    }

    // The Graphics panel has the original's controls and three of ours (a display mode and a UI scale button, an
    // Emitters check box, which the original's strings have but its panel lost), laid out in the room the file leaves.
    fn bind_graphics { mut fe: Front, mut g: gui::Gui, p: u32 } -> ! {
        let s = fe.settings
        // (Set Default binds the panel again: the controls are added once.)
        if not gui::has_control{ &g, panel = p, tag = "BTN_DISPLAYMODE" } {
            _ = try gui::clone_control{ &g, panel = p, from = "BTN_RESOLUTION", tag = "BTN_DISPLAYMODE", x = 60, y = 180 }
            _ = try gui::clone_control{ &g, panel = p, from = "BTN_RESOLUTION", tag = "BTN_UISCALE", x = 60, y = 206 }
            _ = try gui::clone_control{ &g, panel = p, from = "CB_GRASS", tag = "CB_EMITTERS", x = 60, y = 308 }
            _ = try gui::clone_control{ &g, panel = p, from = "BTN_ADVANCED", tag = "BTN_ENHANCED", x = 60, y = 378 }
            gui::set_extent{ &g, panel = p, tag = "BTN_ADVANCED", x = 60, y = 352, w = 240, h = 22 }
            try gui::set_text{ &g, panel = p, tag = "BTN_ENHANCED", text = "Enhanced Graphics" }
            gui::set_extent{ &g, panel = p, tag = "BTN_RESOLUTION", x = 60, y = 154, w = 240, h = 22 }
            gui::set_extent{ &g, panel = p, tag = "CB_SHADOWS", x = 60, y = 234, w = 240, h = 40 }
            gui::set_extent{ &g, panel = p, tag = "CB_GRASS", x = 60, y = 271, w = 240, h = 40 }
            try gui::set_strref{ &g, panel = p, tag = "CB_EMITTERS", strref = 47958 }
        }
        gui::set_value{ &g, panel = p, tag = "SLI_GAMMA", value = s.gamma }
        gui::set_checked{ &g, panel = p, tag = "CB_SHADOWS", on = s.shadows }
        gui::set_checked{ &g, panel = p, tag = "CB_GRASS", on = s.grass }
        gui::set_checked{ &g, panel = p, tag = "CB_EMITTERS", on = s.emitters }
        try sync_graphics{ &fe, &g, p }
    }

    // ---- the resolution list

    // The rows of the resolution list for the current display mode: windowed, the display's sizes that fit the
    // desktop; borderless, the sizes up to the desktop's (smaller ones are drawn scaled up); full screen, every
    // size and refresh rate. Largest first. The current choice is always among them.
    fn build_rows { mut fe: Front } {
        let mode = fe.settings.window_mode
        let mut n: usize = 0
        let mut i: usize = 0
        while i < fe.mode_count and n < MAX_MODES {
            let m = fe.modes[i]
            i = i + 1
            if m.width < 640 or m.height < 480 { continue }
            if mode == 0 and (m.width > fe.usable_w or m.height > fe.usable_h) { continue }
            if mode == 2 and (m.width > fe.desktop.width or m.height > fe.desktop.height) { continue }
            // One row per size unless the refresh rate is what the player is choosing.
            let mut dup = false
            let mut k: usize = 0
            while k < n {
                if fe.rows[k].width == m.width and fe.rows[k].height == m.height and (mode != 1 or fe.rows[k].refresh == m.refresh) { dup = true }
                k = k + 1
            }
            if dup { continue }
            fe.rows[n] = m
            n = n + 1
        }
        // The display may not list the size the settings hold (a window can be any size).
        let mut have = false
        let mut k: usize = 0
        while k < n {
            if fe.rows[k].width == fe.settings.width and fe.rows[k].height == fe.settings.height { have = true }
            k = k + 1
        }
        if not have and n < MAX_MODES {
            // Insert in size order.
            let mut at: usize = 0
            while at < n and fe.rows[at].width * fe.rows[at].height > fe.settings.width * fe.settings.height { at = at + 1 }
            let mut j = n
            while j > at {
                fe.rows[j] = fe.rows[j - 1]
                j = j - 1
            }
            fe.rows[at] = render::DisplayMode{ width = fe.settings.width, height = fe.settings.height, refresh = fe.settings.refresh }
            n = n + 1
        }
        fe.row_count = n
    }

    fn fill_resolutions { mut fe: Front, mut g: gui::Gui, p: u32 } -> ! {
        gui::list_clear{ &g, panel = p, tag = "LB_RESOLUTIONS" }
        build_rows{ &fe }
        let full = fe.settings.window_mode == 1
        let mut picked = false
        let mut i: usize = 0
        while i < fe.row_count {
            let m = fe.rows[i]
            let mut buf: [40]u8
            let mut n = format_mode{ into = buf[..], w = m.width, h = m.height }
            if full and m.refresh > 0 {
                n = n + copy_into{ dst = buf[n..], src = " @ " }
                n = put_int{ into = buf[..], at = n, n = m.refresh }
                n = n + copy_into{ dst = buf[n..], src = " Hz" }
            }
            let row = try gui::list_add{ &g, panel = p, tag = "LB_RESOLUTIONS", text = buf[..n], user = @as(i64, i) }
            // The row of the current size (full screen: and the refresh rate, 0 meaning the highest, the first).
            let same_size = m.width == fe.settings.width and m.height == fe.settings.height
            if not picked and same_size and
                (not full or fe.settings.refresh == 0 or fe.settings.refresh == m.refresh) {
                gui::list_select{ &g, panel = p, tag = "LB_RESOLUTIONS", row }
                picked = true
            }
            i = i + 1
        }
    }

    fn put_int { into: []mut u8, at: usize, n: i32 } -> usize {
        let mut digits: [12]u8
        let mut k: usize = 0
        let mut v = if n < 0 { -n } else { n }
        if v == 0 {
            digits[0] = '0'
            k = 1
        }
        while v > 0 {
            digits[k] = '0' + @trunc(u8, v % 10)
            v = v / 10
            k = k + 1
        }
        let mut at2 = at
        if n < 0 and at2 < into.len {
            into[at2] = '-'
            at2 = at2 + 1
        }
        while k > 0 and at2 < into.len {
            k = k - 1
            into[at2] = digits[k]
            at2 = at2 + 1
        }
        return at2
    }

    fn format_mode { into: []mut u8, w: i32, h: i32 } -> usize {
        let mut n = put_int{ into, at = 0, n = w }
        n = n + copy_into{ dst = into[n..], src = " x " }
        return put_int{ into, at = n, n = h }
    }
}
