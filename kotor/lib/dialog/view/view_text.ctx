// The strings dialogue text is made of (docs/formats/tlk.md, Tokens): the player's name and the
// scripts' <CUSTOMn>, handed to the GUI, which expands them when a line is set.
namespace dlgview {
    fn set_token { mut g: gui::Gui, name: []u8, value: []u8 } {
        gui::set_token{ g = &g, name, value } iferr {}
    }

    // The computer panel's four counters (CSWGuiDialogComputer, FUN_006a8240): the leader's Computer Use
    // and Repair ranks and how many programming spikes (items tagged k_computer_spike) and repair parts
    // (k_repair_part) the party holds, counted by stack. Set with each line, as spikes are used up.
    fn sync_computer { mut v: View, mut w: world::World, mut g: gui::Gui } {
        if v.panels.main == 0 or not v.panels.computer { return }
        let mut computer_skill: i32 = 0
        let mut repair_skill: i32 = 0
        if world::object{ w = &w, id = party::leader{ w = &w } } is some{ value = o } {
            if fight::of{ o } is some{ value = f } {
                computer_skill = rules::skill_rank{ tables = w.rules, c = &f.c, skill = rules::skill::COMPUTER_USE, vs = rules::no_versus{}, base_only = false }
                repair_skill = rules::skill_rank{ tables = w.rules, c = &f.c, skill = rules::skill::REPAIR, vs = rules::no_versus{}, base_only = false }
            }
        }
        let mut spikes: i32 = 0
        let mut parts: i32 = 0
        let ids = list::items{ list = w.bag }
        let mut k: usize = 0
        while k < ids.len {
            if world::object{ w = &w, id = ids[k] } is some{ value = io } {
                if obj::item{ o = io } is some{ value = it } {
                    if ci::eq{ a = io.tag, b = "k_computer_spike" } { spikes = spikes + @as(i32, it.stack) }
                    else if ci::eq{ a = io.tag, b = "k_repair_part" } { parts = parts + @as(i32, it.stack) }
                }
            }
            k = k + 1
        }
        dlgpanel::set_computer_stats{ p = &v.panels, g = &g, skill = computer_skill, spikes, repair_skill, repair_parts = parts } iferr {}
    }

    // Gives the GUI the tokens a line may use. The player's name splits at its first space.
    fn sync_tokens { mut w: world::World, mut g: gui::Gui } {
        let pc = world::object{ w = &w, id = w.conversation.other }
        if pc != null {
            let full = pc.name.text
            let mut space: usize = 0
            while space < full.len and full[space] != ' ' { space = space + 1 }
            set_token{ &g, name = "FullName", value = full }
            set_token{ &g, name = "FirstName", value = full[..space] }
            let last: []u8 = if space < full.len { full[space + 1..] } else { full[..0] }
            set_token{ &g, name = "LastName", value = last }
        }
        // <CUSTOMn> from SetCustomToken (the world keeps them for the whole session).
        let all = list::items{ list = w.tokens.all }
        let mut i: usize = 0
        while i < all.len {
            let c = all[i]
            i = i + 1
            // "CUSTOM" and the number's digits.
            let mut name: [16]u8
            let prefix: []u8 = "CUSTOM"
            let mut n: usize = 0
            while n < prefix.len {
                name[n] = prefix[n]
                n = n + 1
            }
            let mut digits: [10]u8
            let mut count: usize = 0
            let mut value = if c.number < 0 { 0 } else { c.number }
            while value > 0 or count == 0 {
                digits[count] = @trunc(u8, '0' + value % 10)
                count = count + 1
                value = value / 10
            }
            while count > 0 {
                count = count - 1
                name[n] = digits[count]
                n = n + 1
            }
            set_token{ &g, name = name[..n], value = c.text }
        }
    }
}
