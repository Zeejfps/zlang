// The strings scripts hand to dialogue text (docs/formats/tlk.md, Tokens): SetCustomToken's
// <CUSTOMn>. The GUI expands them when a line is shown (dlgview::sync_tokens gives it these).
namespace dlg {
    // Sets <CUSTOMn> to `text` (the first 80 bytes), replacing an earlier value of the same number.
    fn set_custom_token { mut w: world::World, number: i32, text: []u8 } {
        let mut at = w.conversation.custom_count
        let mut i: usize = 0
        while i < w.conversation.custom_count {
            if w.conversation.custom[i].number == number { at = i }
            i = i + 1
        }
        if at >= 32 { return }
        let n = if text.len < 80 { text.len } else { 80 }
        w.conversation.custom[at].number = number
        w.conversation.custom[at].len = n
        let mut k: usize = 0
        while k < n {
            w.conversation.custom[at].text[k] = text[k]
            k = k + 1
        }
        if at == w.conversation.custom_count { w.conversation.custom_count = at + 1 }
    }
}
