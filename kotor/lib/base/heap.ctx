// A general-purpose allocator: the C library's malloc, realloc and free behind std's allocator
// interface, for memory whose lifetime isn't one arena's. The game mounts and unmounts modules,
// loads and drops resources, for hours; an arena alone would only grow.
//
//   let mut h = heap::new{ &mem }
//   let mut xs = list::new(u32){ realloc = heap::alloc, heap = &h }
//   let bytes = try alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = &h, mem = slice::empty(u8){}, count = 100 }
//
// A Heap holds the Mem capability, since taking memory from the system is an effect (spec §1.3),
// and counts what is live, so a leak shows up as a number that keeps growing.
//
// Alignment: malloc's, 16 bytes on every 64-bit platform the game targets. A request for more
// (`align` > 16) fails (returns null), as no type in the game needs it; a GPU upload buffer that
// does should come from the platform layer.
namespace heap {
    // The most alignment malloc guarantees on our targets.
    const MAX_ALIGN: usize = 16

    struct Heap {
        mem: Mem,
        live: usize,            // bytes allocated and not freed
        blocks: usize,          // allocations not freed
        peak: usize,            // the most `live` has been
    }

    extern fn malloc { mut mem: Mem, size: usize } -> ?*mut u8
    extern fn realloc { mut mem: Mem, p: *mut u8, size: usize } -> ?*mut u8
    extern fn free { mut mem: Mem, p: *mut u8 }

    fn new { mut mem: Mem } -> Heap {
        return Heap{ mem, live = 0, blocks = 0, peak = 0 }
    }

    // Has type alloc::Fn(Heap). `mem` must be empty or a block this heap gave out, at the length
    // it was given out with.
    fn alloc { mut heap: Heap, mem: alloc::Bytes, new: usize, align: usize } -> ?alloc::Bytes {
        if align > MAX_ALIGN { return null }
        if new == 0 {
            if mem.len > 0 {
                free{ mem = &heap.mem, p = mem.ptr }
                heap.live = heap.live - mem.len
                heap.blocks = heap.blocks - 1
            }
            return slice::empty(u8){}
        }
        if mem.len == 0 {
            let p = malloc{ mem = &heap.mem, size = new } ifnull { return null }
            heap.blocks = heap.blocks + 1
            heap.live = heap.live + new
            if heap.live > heap.peak { heap.peak = heap.live }
            return @slice(p, new)
        }
        let q = realloc{ mem = &heap.mem, p = mem.ptr, size = new } ifnull { return null }
        heap.live = heap.live - mem.len + new
        if heap.live > heap.peak { heap.peak = heap.live }
        return @slice(q, new)
    }
}
