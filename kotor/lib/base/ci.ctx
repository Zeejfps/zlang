// ASCII case-insensitive comparison of bytes. The game compares resrefs, 2DA column names and
// row labels, TXI and LYT keywords and file names this way (C's _stricmp): only A-Z and a-z fold,
// every other byte compares as itself.
namespace ci {
    fn eq { a: []u8, b: []u8 } -> bool {
        if a.len != b.len { return false }
        let mut i: usize = 0
        while i < a.len {
            if ascii::to_lower{ c = a[i] } != ascii::to_lower{ c = b[i] } { return false }
            i = i + 1
        }
        return true
    }

    // Whether `s` starts with `prefix`, ignoring case.
    fn starts_with { s: []u8, prefix: []u8 } -> bool {
        return s.len >= prefix.len and eq{ a = s[..prefix.len], b = prefix }
    }

    // Whether `s` ends with `suffix`, ignoring case.
    fn ends_with { s: []u8, suffix: []u8 } -> bool {
        return s.len >= suffix.len and eq{ a = s[s.len - suffix.len..], b = suffix }
    }

    // -1, 0 or 1 as `a` sorts before, with or after `b` with both lower-cased, bytes as unsigned
    // numbers, a prefix first.
    fn compare { a: []u8, b: []u8 } -> i32 {
        let mut i: usize = 0
        while i < a.len and i < b.len {
            let x = ascii::to_lower{ c = a[i] }
            let y = ascii::to_lower{ c = b[i] }
            if x != y { return if x < y { -1 } else { 1 } }
            i = i + 1
        }
        if a.len == b.len { return 0 }
        return if a.len < b.len { -1 } else { 1 }
    }

    // A hash that agrees with `eq`: FNV-1a over the lower-cased bytes.
    fn hash { key: []u8 } -> u64 {
        let mut h: u64 = 14695981039346656037
        let mut i: usize = 0
        while i < key.len {
            h = @wrap_mul(h ^ @as(u64, ascii::to_lower{ c = key[i] }), 1099511628211)
            i = i + 1
        }
        return h
    }

    // Lower-cases `src` into the start of `into` and returns that part. Panics if it doesn't fit.
    fn lower { src: []u8, into: []mut u8 } -> []mut u8 {
        let mut i: usize = 0
        while i < src.len {
            into[i] = ascii::to_lower{ c = src[i] }
            i = i + 1
        }
        return into[..src.len]
    }
}
