// The Force powers step of a level-up (pwrlvlup, docs/re/chargen.md I): the original's rows of icon
// cells, one row per chain of every Force power (chargen power_cells.ctx). Known powers are framed
// green at half strength, picks framed green, selectable ones faint until picked, the rest faint on
// a faint backing; the focused cell names and describes its power. As many picks as
// classpowergain.2da gives.
namespace lvl {
    fn pending_powers { s: *State } -> rules::LevelRecord {
        let mut rec: rules::LevelRecord
        rec.class = s.class
        rec.npowers = @as(i32, s.pnchosen)
        let mut i: usize = 0
        while i < s.pnchosen {
            rec.powers[i] = s.pchosen[i]
            i = i + 1
        }
        return rec
    }

    fn power_is_chosen { s: *State, spell: i32 } -> bool {
        let mut i: usize = 0
        while i < s.pnchosen {
            if s.pchosen[i] == spell { return true }
            i = i + 1
        }
        return false
    }

    // Affect Mind and Dominate Mind are the player character's: for anyone else they stay in the
    // selectable set but are drawn as out of reach and refused with 42470 (0x006f15a0, 0x006f2030).
    fn power_kept_for_pc { f: *fight::Fighter, spell: i32 } -> bool {
        return not f.c.is_pc and (spell == 6 or spell == 14)
    }

    fn power_index { s: *State, spell: i64 } -> i32 {
        let mut i: usize = 0
        while i < s.pcount {
            if @as(i64, s.prows[i].id) == spell { return @as(i32, i) }
            i = i + 1
        }
        return -1
    }

    // The panel's powers in list order, each cell of each chain: every Force power, known or not,
    // reachable or not (0x006ce0f0 with its every-power flag).
    fn rows_from_power_chains { mut s: State, chains: []chargen::FeatChain } {
        s.pcount = 0
        let mut i: usize = 0
        while i < chains.len {
            let mut k: usize = 0
            while k < 3 {
                if chains[i].cell[k] >= 0 and s.pcount < MAX_POWER_ROWS {
                    s.prows[s.pcount] = Row{ id = chains[i].cell[k], state = FS_SELECTABLE }
                    s.pcount = s.pcount + 1
                }
                k = k + 1
            }
            i = i + 1
        }
    }

    // Each power's state (0x006f1280): known, picked, in the selectable set, or out of reach. The
    // set is CanLearnForcePower with the level's count + 1 (0x006f1730), so it does not empty as
    // picks are made: Select enforces the count (42529).
    fn refresh_power_states { mut s: State, w: *world::World, f: *fight::Fighter } {
        let rec = pending_powers{ s = &s }
        let level_before = s.opts.char_level - 1
        let total = if s.opts.powers > 0 { s.opts.powers + 1 } else { 0 }
        let mut i: usize = 0
        while i < s.pcount {
            let spell = s.prows[i].id
            if rules::knows_power{ c = &f.c, spell } {
                s.prows[i].state = FS_KNOWN
            } else if power_is_chosen{ s = &s, spell } {
                s.prows[i].state = FS_CHOSEN
            } else if rules::can_learn_force_power{ tables = w.rules, c = &f.c, spell, class = s.class, level_before, total_to_gain = total, pending = &rec } {
                s.prows[i].state = FS_SELECTABLE
            } else {
                s.prows[i].state = FS_UNAVAILABLE
            }
            i = i + 1
        }
    }

    fn open_powers { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device } -> ! {
        let f = creature_of{ w = &w, id = s.who } ifnull { return }
        s.pnchosen = 0
        s.ppicks = s.opts.powers
        let mut chains: [chargen::MAX_FEAT_CHAINS]chargen::FeatChain
        let none: [1]u16 = [0]
        let n = chargen::build_power_chains{ tables = w.rules, all = true, known = none[..0], usable = none[..0], out = &chains }
        rows_from_power_chains{ &s, chains = chains[..n] }
        refresh_power_states{ &s, w = &w, f }
        try chargen::fill_chain_cells{ &g, fs = &w.fs, &dev, panel = s.step, tag = "LB_POWERS", t = w.tables.spells, column = "iconresref", chains = chains[..n] }
        // The focus starts on the first row's first cell (0x006cdd10).
        s.psel = if s.pcount > 0 { 0 } else { -1 }
        if s.psel >= 0 { _ = gui::list_focus_cell{ &g, panel = s.step, tag = "LB_POWERS", user = @as(i64, s.prows[0].id) } }
        restyle_power_cells{ &s, &g, f }
        try refresh_power_counts{ &s, &g }
        try show_power{ &s, &g, &w }
        gui::set_focus{ &g, panel = s.step, tag = "LB_POWERS" }
    }

    // Each cell's look (0x006f15a0): out of reach, known (green at half), picked (green) or
    // selectable (faint icon).
    fn restyle_power_cells { mut s: State, mut g: gui::Gui, f: *fight::Fighter } {
        let mut i: usize = 0
        while i < s.pcount {
            let pr = s.prows[i]
            let style = if pr.state == FS_SELECTABLE and power_kept_for_pc{ f, spell = pr.id } { gui::CELL_LOCKED } else { chargen::feat_cell_style{ state = pr.state } }
            gui::list_set_cell_style{ &g, panel = s.step, tag = "LB_POWERS", user = @as(i64, pr.id), style }
            i = i + 1
        }
    }

    fn refresh_power_counts { mut s: State, mut g: gui::Gui } -> ! {
        try chargen::set_number{ &g, panel = s.step, tag = "REMAINING_SELECTIONS_LBL", n = s.ppicks }
    }

    // The focused power's name and description, and the Select button (0x006f1460): "Add Power"
    // or "Remove Power" (38455 / 38456, a space, 42488), dim for a known or unreachable power.
    fn show_power { mut s: State, mut g: gui::Gui, mut w: world::World } -> ! {
        if s.psel < 0 or @as(usize, s.psel) >= s.pcount { return }
        let p = s.step
        let pr = s.prows[@as(usize, s.psel)]
        let row = rules::get_spell{ tables = w.rules, row = pr.id } ifnull { return }
        try gui::set_strref{ &g, panel = p, tag = "LBL_POWER", strref = @as(u32, row.name) }
        let desc = twoda::get_int{ t = w.tables.spells, row = @as(usize, pr.id), column = "spelldesc" } ifnull 0
        try chargen::set_description{ &g, panel = p, tag = "LB_DESC", strref = @as(u32, desc) }
        let remove = pr.state == FS_CHOSEN or pr.state == FS_KNOWN
        let verb = try gui::tlk_text{ &g, strref = if remove { 38456 } else { 38455 } }
        defer gui::free_string{ &g, s = verb }
        let noun = try gui::tlk_text{ &g, strref = 42488 }
        defer gui::free_string{ &g, s = noun }
        let mut buf: [64]u8
        let mut n = frontend::copy_into{ dst = buf[..], src = verb }
        n = n + frontend::copy_into{ dst = buf[n..], src = " " }
        n = n + frontend::copy_into{ dst = buf[n..], src = noun }
        try gui::set_text{ &g, panel = p, tag = "SELECT_BTN", text = buf[..n] }
        gui::set_text_color{ &g, panel = p, tag = "SELECT_BTN", color = if pr.state == FS_SELECTABLE or pr.state == FS_CHOSEN { gui::color_menu{} } else { gui::color_disabled{} } }
    }

    // Adds or removes the focused power, with the original's refusals (0x006f2030).
    fn toggle_power { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device } -> ! {
        if s.psel < 0 or @as(usize, s.psel) >= s.pcount { return }
        let f = creature_of{ w = &w, id = s.who } ifnull { return }
        let pr = s.prows[@as(usize, s.psel)]
        if pr.state == FS_KNOWN {
            try say{ &s, &g, &w, &dev, strref = 42185, ask = ASK_INFO }
            return
        }
        if pr.state == FS_UNAVAILABLE {
            try say{ &s, &g, &w, &dev, strref = 42186, ask = ASK_INFO }
            return
        }
        if pr.state == FS_SELECTABLE {
            if power_kept_for_pc{ f, spell = pr.id } {
                try say{ &s, &g, &w, &dev, strref = 42470, ask = ASK_INFO }
                return
            }
            if s.ppicks <= 0 {
                try say{ &s, &g, &w, &dev, strref = 42529, ask = ASK_INFO }
                return
            }
            if s.pnchosen < 8 {
                s.pchosen[s.pnchosen] = pr.id
                s.pnchosen = s.pnchosen + 1
                s.ppicks = s.ppicks - 1
            }
        } else {
            drop_power{ &s, w = &w, f, spell = pr.id }
        }
        refresh_power_states{ &s, w = &w, f }
        restyle_power_cells{ &s, &g, f }
        try refresh_power_counts{ &s, &g }
        try show_power{ &s, &g, &w }
    }

    // Removes a pick and every pick that needed it.
    fn drop_power { mut s: State, w: *world::World, f: *fight::Fighter, spell: i32 } {
        let mut i: usize = 0
        while i < s.pnchosen {
            if s.pchosen[i] == spell {
                let mut k = i
                while k + 1 < s.pnchosen {
                    s.pchosen[k] = s.pchosen[k + 1]
                    k = k + 1
                }
                s.pnchosen = s.pnchosen - 1
                s.ppicks = s.ppicks + 1
                break
            }
            i = i + 1
        }
        // A pick that named it as a prerequisite goes too.
        let mut j: usize = 0
        while j < s.pnchosen {
            let row = rules::get_spell{ tables = w.rules, row = s.pchosen[j] } ifnull { return }
            let mut p: usize = 0
            while p < @as(usize, row.nprereq) and p < 4 {
                if row.prereq[p] == spell {
                    drop_power{ &s, w, f, spell = s.pchosen[j] }
                    return
                }
                p = p + 1
            }
            j = j + 1
        }
    }

    // The picks the auto-leveller would make.
    fn recommend_powers { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device } -> ! {
        let f = creature_of{ w = &w, id = s.who } ifnull { return }
        let mut trial = f.c
        let mut rec: rules::LevelRecord
        if not rules::prepare_auto_level{ tables = w.rules, c = &trial, class = s.class, rec = &rec } { rec.npowers = 0 }
        s.pnchosen = 0
        s.ppicks = s.opts.powers
        let mut i: usize = 0
        while i < @as(usize, rec.npowers) and s.pnchosen < 8 and s.ppicks > 0 {
            s.pchosen[s.pnchosen] = rec.powers[i]
            s.pnchosen = s.pnchosen + 1
            s.ppicks = s.ppicks - 1
            i = i + 1
        }
        refresh_power_states{ &s, w = &w, f }
        restyle_power_cells{ &s, &g, f }
        try refresh_power_counts{ &s, &g }
        try show_power{ &s, &g, &w }
        // "The following power(s) have been recommended."
        try show_list_popup{ &s, &g, &w, &dev, caption = 42257, t = w.tables.spells, icon_column = "iconresref", ids = s.pchosen[..s.pnchosen] }
    }

    fn powers_event { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, ev: gui::Event } -> ! {
        if ev.kind == gui::EventKind::cancel {
            close_step{ &s, &g }
            return
        }
        if ev.kind == gui::EventKind::row_selected {
            s.psel = power_index{ s = &s, spell = ev.user }
            try show_power{ &s, &g, &w }
        } else if ev.kind == gui::EventKind::row_activated {
            s.psel = power_index{ s = &s, spell = ev.user }
            try toggle_power{ &s, &g, &w, &dev }
        } else if ev.kind == gui::EventKind::activate {
            if slice::eq_bytes{ a = ev.tag, b = "SELECT_BTN" } {
                try toggle_power{ &s, &g, &w, &dev }
            } else if slice::eq_bytes{ a = ev.tag, b = "RECOMMENDED_BTN" } {
                try recommend_powers{ &s, &g, &w, &dev }
            } else if slice::eq_bytes{ a = ev.tag, b = "ACCEPT_BTN" } {
                // Refused while picks remain and the selectable set is not empty (0x006f1130).
                if s.ppicks > 0 {
                    let mut any = false
                    let mut i: usize = 0
                    while i < s.pcount {
                        if s.prows[i].state == FS_SELECTABLE { any = true }
                        i = i + 1
                    }
                    if any {
                        // "You have gained new powers. You must use "Add Power" to select your new powers before continuing."
                        try say{ &s, &g, &w, &dev, strref = 48210, ask = ASK_INFO }
                        return
                    }
                }
                s.rec.npowers = @as(i32, s.pnchosen)
                let mut i: usize = 0
                while i < s.pnchosen {
                    s.rec.powers[i] = s.pchosen[i]
                    i = i + 1
                }
                close_step{ &s, &g }
                step_taken{ &s, &g, &w, step = STEP_POWERS }
            } else if slice::eq_bytes{ a = ev.tag, b = "BACK_BTN" } {
                close_step{ &s, &g }
            }
        }
    }
}
