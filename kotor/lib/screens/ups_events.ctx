// The bench's events: clicking slots, choosing crystals, Assemble and Cancel.
namespace ups {
    // One GUI event of this frame; true when it belonged to the bench.
    fn on_event { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, ev: gui::Event } -> bool {
        if not s.open { return false }
        let a = msgbox::answer{ b = s.box, ev }
        if a != msgbox::Answer::none {
            let ask = s.ask
            let row = s.box.item
            msgbox::close{ &g, b = &s.box }
            s.ask = ASK_NOTHING
            if ask == ASK_REEQUIP and a == msgbox::Answer::cancel {
                // Undo the install the question was about.
                remove_row{ &s, row = @as(usize, row) }
                fill_bench{ &s, &g, &w, &dev } iferr err{ error } { _ = @fmt(&w.io, "kotor: upgrade bench: {}\n", error) }
            }
            return true
        }
        let mine = ev.panel == s.sel or ev.panel == s.list or ev.panel == s.bench
        if not mine { return false }
        if msgbox::is_open{ b = s.box } { return true }
        let top = if s.mode == MODE_BENCH { s.bench } else if s.mode == MODE_ITEMS { s.list } else { s.sel }
        if ev.panel != top { return true }
        if s.mode == MODE_BENCH {
            bench_event{ &s, &g, &w, &dev, ev } iferr err{ error } { _ = @fmt(&w.io, "kotor: upgrade bench: {}\n", error) }
        } else if s.mode == MODE_ITEMS {
            items_event{ &s, &g, &w, &dev, ev } iferr err{ error } { _ = @fmt(&w.io, "kotor: upgrade bench: {}\n", error) }
        } else {
            categories_event{ &s, &g, &w, &dev, ev } iferr err{ error } { _ = @fmt(&w.io, "kotor: upgrade bench: {}\n", error) }
        }
        return true
    }

    // ---- the ledger

    // Installs upgrade row `row` in the item: from the party's stock, or the unit this session gave back.
    fn install_row { mut s: State, row: usize } {
        s.bits = s.bits | (@as(u32, 1) << @as(u32, row))
        if s.give[row] { s.give[row] = false } else { s.consume[row] = true }
    }

    // Takes it out again: the unit goes back to the party (at Assemble), or was never taken.
    fn remove_row { mut s: State, row: usize } {
        s.bits = s.bits & ((@as(u32, 1) << @as(u32, row)) ^ 0xFFFFFFFF)
        if s.consume[row] { s.consume[row] = false } else { s.give[row] = true }
    }

    // Whether the wearer can still wear the item with these bits (a feat an upgrade added a need for).
    fn wearer_still_fits { mut s: State, mut w: world::World } -> bool {
        if s.owner == obj::INVALID or s.slot_worn < 0 { return true }
        set_bits{ &w, item = s.item, bits = s.bits }
        let mask = @as(u32, 1) << @as(u32, s.slot_worn)
        return equip::may_equip{ w = &w, id = s.owner, item = s.item, mask }
    }

    // ---- the bench

    fn bench_event { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, ev: gui::Event } -> ! {
        if ev.kind == gui::EventKind::cancel {
            if s.choosing {
                s.choosing = false
                try fill_bench{ &s, &g, &w, &dev }
            } else {
                try leave_bench{ &s, &g, &w, &dev, assemble = false }
            }
            return
        }
        if s.choosing {
            // The crystal list: pointing at a row describes it, a click chooses it.
            if slice::eq_bytes{ a = ev.tag, b = "LB_ITEMS" } and ev.user >= 0 {
                if ev.kind == gui::EventKind::row_hover or ev.kind == gui::EventKind::row_selected {
                    try describe_choice{ &s, &g, &w, index = @as(usize, ev.user) }
                } else if ev.kind == gui::EventKind::row_activated {
                    try choose{ &s, &g, &w, &dev, index = @as(usize, ev.user) }
                }
            } else if ev.kind == gui::EventKind::activate and slice::eq_bytes{ a = ev.tag, b = "BTN_BACK" } {
                s.choosing = false
                try fill_bench{ &s, &g, &w, &dev }
            }
            return
        }
        if ev.kind == gui::EventKind::hilight {
            let k = slot_of_tag{ s = &s, tag = ev.tag }
            if k >= 0 {
                s.hot_slot = @as(usize, k)
                try describe_slot{ &s, &g, &w, k = @as(usize, k) }
            }
            return
        }
        if ev.kind != gui::EventKind::activate { return }
        if slice::eq_bytes{ a = ev.tag, b = "BTN_ASSEMBLE" } {
            try leave_bench{ &s, &g, &w, &dev, assemble = true }
        } else if slice::eq_bytes{ a = ev.tag, b = "BTN_BACK" } {
            try leave_bench{ &s, &g, &w, &dev, assemble = false }
        } else {
            let k = slot_of_tag{ s = &s, tag = ev.tag }
            if k >= 0 { try slot_click{ &s, &g, &w, &dev, k = @as(usize, k) } }
        }
    }

    // OnSlotClicked (0x006c6500): a lightsaber slot always opens the list of crystals (None, the
    // one it has, the ones the party can give). On the other items a filled slot gives its upgrade
    // back and an empty one takes the upgrade of its kind from the party's stock.
    fn slot_click { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, k: usize } -> ! {
        s.hot_slot = k
        let slot = s.slots[k]
        if s.lightsaber {
            try start_choosing{ &s, &g, &w, &dev, k }
            return
        }
        if slot.row != NO_ROW {
            remove_row{ &s, row = @as(usize, slot.row) }
            gui::play_sound{ &g, n = 11 }
        } else {
            if slot.fixed < 0 or not upgrade_available{ s = &s, w = &w, row = @as(usize, slot.fixed) } { return }
            install_row{ &s, row = @as(usize, slot.fixed) }
            try check_wearer{ &s, &g, &w, &dev, row = @as(usize, slot.fixed) }
        }
        try fill_bench{ &s, &g, &w, &dev }
    }

    // After an install: the wearer may not be able to use the item any more; the original asks.
    fn check_wearer { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, row: usize } -> ! {
        if wearer_still_fits{ &s, &w } { return }
        s.box = msgbox::show_strref{ &g, &w, &dev, strref = STR_NO_REEQUIP, cancel = true, what = ASK_REEQUIP, item = @as(u32, row) }
        s.ask = ASK_REEQUIP
    }

    // A crystal picked from the list (OnUpgradeChosen 0x006c5510): the one it has already changes
    // nothing, "None" gives the slot's crystal back, another replaces it.
    fn choose { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, index: usize } -> ! {
        if index >= s.nchoices { return }
        let row = s.choices[index]
        let slot = s.slots[s.choosing_slot]
        s.choosing = false
        if row != CHOICE_KEEP {
            if slot.kind == KIND_COLOUR {
                let old = if s.colour_new >= 0 { s.colour_new } else { s.colour_now }
                // The old crystal goes back to the party, the new one comes out of its stock.
                if old >= 0 {
                    if s.col_consume[@as(usize, old)] { s.col_consume[@as(usize, old)] = false } else { s.col_give[@as(usize, old)] = true }
                }
                if s.col_give[@as(usize, row)] { s.col_give[@as(usize, row)] = false } else { s.col_consume[@as(usize, row)] = true }
                s.colour_new = if row == s.colour_now { -1 } else { row }
                swap_saber{ &s, &w }
            } else {
                // No CanEquipItem question here: OnUpgradeChosen asks only OnSlotClicked's.
                if slot.row != NO_ROW { remove_row{ &s, row = @as(usize, slot.row) } }
                if row >= 0 { install_row{ &s, row = @as(usize, row) } }
            }
            gui::play_sound{ &g, n = 11 }
        }
        try fill_bench{ &s, &g, &w, &dev }
    }

    // A new colour crystal replaces the saber at once by the upcrystals.2da saber of that colour and
    // kind, keeping its upgrades and its stolen flag (OnUpgradeChosen 0x006c5510); the saber the
    // bench opened on is kept aside for Cancel. Going back to the first colour takes that one back.
    fn swap_saber { mut s: State, mut w: world::World } {
        if s.colour_new < 0 {
            if s.original == obj::INVALID { return }
            world::destroy{ &w, id = s.item }
            s.item = s.original
            s.original = obj::INVALID
            return
        }
        let t = twoda::get_string{ t = s.crystals_t, row = @as(usize, s.colour_new), column = saber_column{ w = &w, item = s.item } } ifnull ""
        let fresh = make_preview{ &w, template = t }
        if fresh == obj::INVALID { return }
        set_bits{ &w, item = fresh, bits = s.bits }
        let first = if s.original != obj::INVALID { s.original } else { s.item }
        if items::item_of{ w = &w, id = first } is some{ value = old } {
            if items::item_of{ w = &w, id = fresh } is some{ value = nw } {
                if old.rules is some{ value = ro } {
                    if nw.rules is some{ value = rn } { rn.stolen = ro.stolen }
                }
            }
        }
        if s.original == obj::INVALID { s.original = s.item } else { world::destroy{ &w, id = s.item } }
        s.item = fresh
        if w.log.actions {
            let o = world::object{ w = &w, id = fresh } ifnull { return }
            _ = @fmt(&w.io, "upgrade bench: the saber is now {}\n", o.tag)
        }
    }

    // ---- leaving

    // Assemble makes the ledger true and puts the item back; Cancel puts it back as it was. The
    // bench then returns to the list it came from (or closes when a script gave the item).
    fn leave_bench { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, assemble: bool } -> ! {
        if w.log.actions {
            let how: []u8 = if assemble { "assembled" } else { "cancelled" }
            _ = @fmt(&w.io, "upgrade bench: {} {}, upgrades {} (were {})\n", items::name_of{ w = &w, id = s.item }, how, if assemble { s.bits } else { s.orig_bits }, s.orig_bits)
        }
        if assemble {
            settle{ &s, &g, &w }
        } else {
            // OnCancel restores the backup item: the saber the bench opened on, whatever colour came since.
            if s.original != obj::INVALID {
                world::destroy{ &w, id = s.item }
                s.item = s.original
                s.original = obj::INVALID
            }
            set_bits{ &w, item = s.item, bits = s.orig_bits }
        }
        put_back_item{ &s, &w }
        let back = s.item
        s.item = obj::INVALID
        s.original = obj::INVALID
        drop_view{ &s, &dev }
        gui::close{ &g, id = s.bench }
        s.bench = 0
        if s.list != 0 {
            s.mode = MODE_ITEMS
            try fill_items{ &s, &g, &w, &dev, show = back }
        } else if s.sel != 0 {
            s.mode = MODE_CATEGORIES
        } else {
            close_all{ &s, &g, &w }
        }
    }

    // The upgrade items the ledger names leave or enter the party's stock (a new colour crystal
    // replaced the saber when it was chosen: swap_saber).
    fn settle { mut s: State, mut g: gui::Gui, mut w: world::World } {
        let mut r: usize = 0
        while r < ROWS {
            if s.consume[r] { _ = consume_one{ &w, template = template_of_row{ s = &s, row = r } } }
            if s.give[r] { _ = rt_item::create_item{ &w, template = template_of_row{ s = &s, row = r }, target = w.player, stack = 1 } }
            r = r + 1
        }
        r = 0
        while r < COLOURS {
            let t = twoda::get_string{ t = s.crystals_t, row = r, column = "template" } ifnull ""
            if s.col_consume[r] { _ = consume_one{ &w, template = t } }
            if s.col_give[r] { _ = rt_item::create_item{ &w, template = t, target = w.player, stack = 1 } }
            r = r + 1
        }
        set_bits{ &w, item = s.item, bits = s.bits }
    }

    // Whether the bag holds the item itself (a unit split off a stack is not in it).
    fn in_bag { w: *world::World, item: u32 } -> bool {
        let ids = list::items{ list = w.bag }
        let mut k: usize = 0
        while k < ids.len {
            if ids[k] == item { return true }
            k = k + 1
        }
        return false
    }

    // `item` goes into `hand` of the owner, else (the rules refuse it) into the party's bag.
    fn wear_or_bag { mut s: State, mut w: world::World, item: u32, hand: usize } {
        if item == obj::INVALID { return }
        if equip::equip_item{ &w, id = s.owner, item, slot = hand } { return }
        if not in_bag{ w = &w, item } { _ = xfer::to_party{ &w, item } }
    }

    // ReturnItem (0x006c5e90): the item goes back where it came from if CanEquipItem still allows it,
    // else into the party's bag. A dual wielder's other weapon goes back too: the item in its hand and
    // the other in the off hand; when the item no longer fits, the other weapon takes the main hand.
    fn put_back_item { mut s: State, mut w: world::World } {
        if s.original != obj::INVALID { world::destroy{ &w, id = s.original } }
        if s.owner == obj::INVALID or s.slot_worn < 0 {
            _ = xfer::to_party{ &w, item = s.item }
            return
        }
        let hand = @as(usize, s.slot_worn)
        if not s.partner {
            wear_or_bag{ &s, &w, item = s.item, hand }
            return
        }
        let other = bag_unit_like{ &w, holder = s.owner, template = s.partner_template, bits = s.partner_bits }
        let fits = equip::may_equip{ w = &w, id = s.owner, item = s.item, mask = @as(u32, 1) << @as(u32, s.slot_worn) }
        s.partner = false
        if hand == obj::SLOT_RIGHT_WEAPON {
            if fits {
                wear_or_bag{ &s, &w, item = s.item, hand }
                wear_or_bag{ &s, &w, item = other, hand = s.partner_slot }
            } else {
                _ = xfer::to_party{ &w, item = s.item }
                wear_or_bag{ &s, &w, item = other, hand = obj::SLOT_RIGHT_WEAPON }
            }
        } else {
            wear_or_bag{ &s, &w, item = other, hand = obj::SLOT_RIGHT_WEAPON }
            if fits {
                wear_or_bag{ &s, &w, item = s.item, hand }
            } else {
                _ = xfer::to_party{ &w, item = s.item }
            }
        }
    }
}
