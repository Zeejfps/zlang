// The feats step of a level-up (ftchrgen, docs/re/chargen.md H): the original's rows of icon
// cells, one row per prereqfeat chain the class lists or the creature knows (chargen
// feat_cells.ctx). Known and granted feats are framed green at half strength, picks framed green,
// the rest faint until picked; the focused cell names and describes its feat. A level with bonus
// feats asks for them in a second panel after the regular picks are accepted (the bonus pass,
// sub title 1316 "Bonus Feats"; 0x006f44c0), as featgain.2da gives each.
namespace lvl {
    const STR_BONUS_FEATS: u32 = 1316
    const STR_FEATS_RECOMMENDED: u32 = 42256      // "The following feat(s) have been recommended."

    // The record of this pass's picks, for the rules' prerequisite and pool checks.
    fn pending_feats { s: *State } -> rules::LevelRecord {
        let mut rec: rules::LevelRecord
        rec.class = s.class
        rec.nfeats = @as(i32, s.fnchosen)
        let mut i: usize = 0
        while i < s.fnchosen {
            rec.feats[i] = s.fchosen[i]
            i = i + 1
        }
        return rec
    }

    // The creature as this pass sees it: in the bonus pass the regular picks are its own, as the
    // original adds them to the creature before it opens that pass; so are the regular picks a
    // bonus pass's Back left on it.
    fn feat_base { s: *State, f: *fight::Fighter } -> rules::Creature {
        let mut c = f.c
        let mut i: usize = 0
        while i < s.fnkept {
            rules::grant_feat{ &c, feat = s.fkept[i] }
            i = i + 1
        }
        i = 0
        while i < s.fnprior {
            rules::grant_feat{ &c, feat = s.fprior[i] }
            i = i + 1
        }
        return c
    }

    // Back (0x006f2c70) pops the panel without taking anything back from the creature: in the bonus
    // pass the regular picks, which the regular Accept added to it, stay. The step is not taken, so
    // the regular pass opens again, with those feats known and the level's picks to make anew, as
    // the original's does; ours applies them with the rest of the level.
    fn leave_feats { mut s: State, mut g: gui::Gui } {
        if s.fbonus {
            let mut i: usize = 0
            while i < s.fnprior and s.fnkept < 8 {
                s.fkept[s.fnkept] = s.fprior[i]
                s.fnkept = s.fnkept + 1
                i = i + 1
            }
            s.fnprior = 0
        }
        close_step{ &s, &g }
    }

    // The pools this pass may fill: the regular pass counts only the regular picks, the bonus
    // pass only the bonus ones.
    fn pass_general { s: *State } -> i32 { return if s.fbonus { 0 } else { s.opts.general_feats } }
    fn pass_bonus { s: *State } -> i32 { return if s.fbonus { s.opts.bonus_feats } else { 0 } }

    fn feat_is_chosen { s: *State, feat: i32 } -> bool {
        let mut i: usize = 0
        while i < s.fnchosen {
            if s.fchosen[i] == feat { return true }
            i = i + 1
        }
        return false
    }

    // The panel's feats in list order, each cell of each row.
    fn rows_from_chains { mut s: State, chains: []chargen::FeatChain } {
        s.fcount = 0
        let mut i: usize = 0
        while i < chains.len {
            let mut k: usize = 0
            while k < 3 {
                if chains[i].cell[k] >= 0 and s.fcount < MAX_FEAT_ROWS {
                    s.frows[s.fcount] = Row{ id = chains[i].cell[k], state = FS_SELECTABLE }
                    s.fcount = s.fcount + 1
                }
                k = k + 1
            }
            i = i + 1
        }
    }

    fn feat_index { s: *State, feat: i64 } -> i32 {
        let mut i: usize = 0
        while i < s.fcount {
            if @as(i64, s.frows[i].id) == feat { return @as(i32, i) }
            i = i + 1
        }
        return -1
    }

    // Each row's state: known, granted this level (the regular pass only), picked, open to pick
    // in this pass's pool, or out of reach.
    fn refresh_feat_states { mut s: State, w: *world::World, f: *fight::Fighter } {
        let rec = pending_feats{ s = &s }
        let base = feat_base{ s = &s, f }
        let cx = @as(usize, s.class)
        let mut i: usize = 0
        while i < s.fcount {
            let feat = s.frows[i].id
            let row = rules::get_feat{ tables = w.rules, row = feat } ifnull { return }
            let sel = rules::feat_selectable_as{ tables = w.rules, class = s.class, feat }
            let fits = if s.fbonus { sel.bonus } else { sel.general }
            if rules::has_feat{ c = &base, feat } {
                s.frows[i].state = if not s.fbonus and row.list[cx] == 3 and row.granted[cx] == s.opts.class_level { FS_GRANTED } else { FS_KNOWN }
            } else if feat_is_chosen{ s = &s, feat } {
                s.frows[i].state = FS_CHOSEN
            } else if fits and rules::meets_feat_requirements{ tables = w.rules, c = &base, feat, class = s.class, class_level = s.opts.class_level, pending = &rec } {
                s.frows[i].state = FS_SELECTABLE
            } else {
                s.frows[i].state = FS_UNAVAILABLE
            }
            i = i + 1
        }
    }

    // Opens the regular pass, or the bonus pass with `bonus`. A level without regular picks goes
    // straight to the bonus pass, as the original's regular panel accepts itself at once.
    fn open_feats { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, bonus: bool } -> ! {
        let f = creature_of{ w = &w, id = s.who } ifnull { return }
        s.fbonus = bonus or s.opts.general_feats == 0
        if not s.fbonus { s.fnprior = 0 }
        if s.fbonus { try gui::set_strref{ &g, panel = s.step, tag = "SUB_TITLE_LBL", strref = STR_BONUS_FEATS } }
        s.fnchosen = 0
        s.fpicks = pass_general{ s = &s } + pass_bonus{ s = &s }
        let base = feat_base{ s = &s, f }
        let mut chains: [chargen::MAX_FEAT_CHAINS]chargen::FeatChain
        let n = chargen::build_feat_chains{ tables = w.rules, class = s.class, c = &base, regular = not s.fbonus, bonus = s.fbonus, out = &chains }
        rows_from_chains{ &s, chains = chains[..n] }
        refresh_feat_states{ &s, w = &w, f }
        try chargen::fill_chain_cells{ &g, fs = &w.fs, &dev, panel = s.step, tag = "LB_FEATS", t = s.feat_table, column = "icon", chains = chains[..n] }
        // The focus starts on the first row's first cell.
        s.fsel = if s.fcount > 0 { 0 } else { -1 }
        if s.fsel >= 0 { _ = gui::list_focus_cell{ &g, panel = s.step, tag = "LB_FEATS", user = @as(i64, s.frows[0].id) } }
        restyle_feat_cells{ &s, &g }
        try refresh_feat_counts{ &s, &g }
        try show_feat{ &s, &g, &w }
        gui::set_focus{ &g, panel = s.step, tag = "LB_FEATS" }
    }

    // Each cell's look from its feat's state.
    fn restyle_feat_cells { mut s: State, mut g: gui::Gui } {
        let mut i: usize = 0
        while i < s.fcount {
            gui::list_set_cell_style{ &g, panel = s.step, tag = "LB_FEATS", user = @as(i64, s.frows[i].id), style = chargen::feat_cell_style{ state = s.frows[i].state } }
            i = i + 1
        }
    }

    fn refresh_feat_counts { mut s: State, mut g: gui::Gui } -> ! {
        try chargen::set_number{ &g, panel = s.step, tag = "STD_REMAINING_SELECTIONS_LBL", n = s.fpicks }
    }

    // The selected row's name and description, and what the Add button says.
    fn show_feat { mut s: State, mut g: gui::Gui, mut w: world::World } -> ! {
        if s.fsel < 0 or @as(usize, s.fsel) >= s.fcount { return }
        let p = s.step
        let fr = s.frows[@as(usize, s.fsel)]
        let name_row = rules::get_feat{ tables = w.rules, row = fr.id } ifnull { return }
        try gui::set_strref{ &g, panel = p, tag = "LBL_NAME", strref = @as(u32, name_row.name) }
        let desc = twoda::get_int{ t = s.feat_table, row = @as(usize, fr.id), column = "description" } ifnull 0
        try chargen::set_description{ &g, panel = p, tag = "LB_DESC", strref = @as(u32, desc) }
        let remove = fr.state == FS_CHOSEN or fr.state == FS_GRANTED or fr.state == FS_KNOWN
        let verb = try gui::tlk_text{ &g, strref = if remove { 38456 } else { 38455 } }
        defer gui::free_string{ &g, s = verb }
        let noun = try gui::tlk_text{ &g, strref = 42487 }
        defer gui::free_string{ &g, s = noun }
        let mut buf: [64]u8
        let mut n = frontend::copy_into{ dst = buf[..], src = verb }
        n = n + frontend::copy_into{ dst = buf[n..], src = " " }
        n = n + frontend::copy_into{ dst = buf[n..], src = noun }
        try gui::set_text{ &g, panel = p, tag = "BTN_SELECT", text = buf[..n] }
        gui::set_text_color{ &g, panel = p, tag = "BTN_SELECT", color = if fr.state == FS_SELECTABLE or fr.state == FS_CHOSEN { gui::color_menu{} } else { gui::color_disabled{} } }
    }

    // Adds or removes the selected row's feat, with the original's messages.
    fn toggle_feat { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device } -> ! {
        if s.fsel < 0 or @as(usize, s.fsel) >= s.fcount { return }
        let f = creature_of{ w = &w, id = s.who } ifnull { return }
        let i = @as(usize, s.fsel)
        let fr = s.frows[i]
        if fr.state == FS_GRANTED {
            try say{ &s, &g, &w, &dev, strref = 42183, ask = ASK_INFO }
            return
        }
        if fr.state == FS_KNOWN {
            try say{ &s, &g, &w, &dev, strref = 42182, ask = ASK_INFO }
            return
        }
        if fr.state == FS_UNAVAILABLE {
            try say{ &s, &g, &w, &dev, strref = 42184, ask = ASK_INFO }
            return
        }
        let base = feat_base{ s = &s, f }
        if fr.state == FS_SELECTABLE {
            let rec = pending_feats{ s = &s }
            if s.fpicks <= 0 {
                try say{ &s, &g, &w, &dev, strref = 42530, ask = ASK_INFO }
                return
            }
            // The pool may be full for this kind of feat even with picks left.
            if not rules::can_select_feat{ tables = w.rules, c = &base, feat = fr.id, class = s.class, class_level = s.opts.class_level, general = pass_general{ s = &s }, bonus = pass_bonus{ s = &s }, pending = &rec } {
                try say{ &s, &g, &w, &dev, strref = 42530, ask = ASK_INFO }
                return
            }
            if s.fnchosen < 8 {
                s.fchosen[s.fnchosen] = fr.id
                s.fnchosen = s.fnchosen + 1
                s.fpicks = s.fpicks - 1
            }
        } else {
            drop_feat{ &s, w = &w, c = &base, feat = fr.id }
        }
        refresh_feat_states{ &s, w = &w, f }
        restyle_feat_cells{ &s, &g }
        try refresh_feat_counts{ &s, &g }
        try show_feat{ &s, &g, &w }
    }

    // Removes a pick and every pick that needed it.
    fn drop_feat { mut s: State, w: *world::World, c: *rules::Creature, feat: i32 } {
        let mut i: usize = 0
        while i < s.fnchosen {
            if s.fchosen[i] == feat {
                let mut k = i
                while k + 1 < s.fnchosen {
                    s.fchosen[k] = s.fchosen[k + 1]
                    k = k + 1
                }
                s.fnchosen = s.fnchosen - 1
                s.fpicks = s.fpicks + 1
                break
            }
            i = i + 1
        }
        let mut j: usize = 0
        while j < s.fnchosen {
            let ft = s.fchosen[j]
            let mut without = pending_feats{ s = &s }
            without.nfeats = 0
            let mut m: usize = 0
            while m < s.fnchosen {
                if m != j {
                    without.feats[@as(usize, without.nfeats)] = s.fchosen[m]
                    without.nfeats = without.nfeats + 1
                }
                m = m + 1
            }
            if not rules::meets_feat_requirements{ tables = w.rules, c, feat = ft, class = s.class, class_level = s.opts.class_level, pending = &without } {
                drop_feat{ &s, w, c, feat = ft }
                return
            }
            j = j + 1
        }
    }

    // The picks the auto-leveller would make that fit this pass's pool.
    fn recommend_feats { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device } -> ! {
        let f = creature_of{ w = &w, id = s.who } ifnull { return }
        let mut trial = f.c
        let mut rec: rules::LevelRecord
        if not rules::prepare_auto_level{ tables = w.rules, c = &trial, class = s.class, rec = &rec } { rec.nfeats = 0 }
        let base = feat_base{ s = &s, f }
        s.fnchosen = 0
        s.fpicks = pass_general{ s = &s } + pass_bonus{ s = &s }
        let mut i: usize = 0
        while i < @as(usize, rec.nfeats) and s.fnchosen < 8 and s.fpicks > 0 {
            let pending = pending_feats{ s = &s }
            if rules::can_select_feat{ tables = w.rules, c = &base, feat = rec.feats[i], class = s.class, class_level = s.opts.class_level, general = pass_general{ s = &s }, bonus = pass_bonus{ s = &s }, pending = &pending } {
                s.fchosen[s.fnchosen] = rec.feats[i]
                s.fnchosen = s.fnchosen + 1
                s.fpicks = s.fpicks - 1
            }
            i = i + 1
        }
        refresh_feat_states{ &s, w = &w, f }
        restyle_feat_cells{ &s, &g }
        try refresh_feat_counts{ &s, &g }
        try show_feat{ &s, &g, &w }
        try show_list_popup{ &s, &g, &w, &dev, caption = STR_FEATS_RECOMMENDED, t = s.feat_table, icon_column = "icon", ids = s.fchosen[..s.fnchosen] }
    }

    // Accept: refused while picks remain and something could still be picked; after the regular
    // pass of a level with bonus feats, the bonus pass opens in a new panel; else the step is done
    // with both passes' picks.
    fn accept_feats { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device } -> ! {
        if s.fpicks > 0 {
            let mut any = false
            let mut i: usize = 0
            while i < s.fcount {
                if s.frows[i].state == FS_SELECTABLE { any = true }
                i = i + 1
            }
            if any {
                try say{ &s, &g, &w, &dev, strref = 48215, ask = ASK_INFO }
                return
            }
        }
        if not s.fbonus and s.opts.bonus_feats > 0 {
            s.fnprior = 0
            while s.fnprior < s.fnchosen {
                s.fprior[s.fnprior] = s.fchosen[s.fnprior]
                s.fnprior = s.fnprior + 1
            }
            close_step{ &s, &g }
            try open_step{ &s, &g, &w, &dev, k = STEP_FEATS, bonus = true }
            return
        }
        let mut n: usize = 0
        while n < s.fnkept {
            s.rec.feats[n] = s.fkept[n]
            n = n + 1
        }
        let mut k: usize = 0
        while k < s.fnprior and n < rules::MAX_LEVEL_FEATS {
            s.rec.feats[n] = s.fprior[k]
            n = n + 1
            k = k + 1
        }
        let mut i: usize = 0
        while i < s.fnchosen and n < rules::MAX_LEVEL_FEATS {
            s.rec.feats[n] = s.fchosen[i]
            n = n + 1
            i = i + 1
        }
        s.rec.nfeats = @as(i32, n)
        close_step{ &s, &g }
        step_taken{ &s, &g, &w, step = STEP_FEATS }
    }

    fn feats_event { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, ev: gui::Event } -> ! {
        if ev.kind == gui::EventKind::cancel {
            leave_feats{ &s, &g }
            return
        }
        if ev.kind == gui::EventKind::row_selected {
            s.fsel = feat_index{ s = &s, feat = ev.user }
            try show_feat{ &s, &g, &w }
        } else if ev.kind == gui::EventKind::row_activated {
            s.fsel = feat_index{ s = &s, feat = ev.user }
            try toggle_feat{ &s, &g, &w, &dev }
        } else if ev.kind == gui::EventKind::activate {
            if slice::eq_bytes{ a = ev.tag, b = "BTN_SELECT" } {
                try toggle_feat{ &s, &g, &w, &dev }
            } else if slice::eq_bytes{ a = ev.tag, b = "BTN_RECOMMENDED" } {
                try recommend_feats{ &s, &g, &w, &dev }
            } else if slice::eq_bytes{ a = ev.tag, b = "BTN_ACCEPT" } {
                try accept_feats{ &s, &g, &w, &dev }
            } else if slice::eq_bytes{ a = ev.tag, b = "BTN_BACK" } {
                leave_feats{ &s, &g }
            }
        }
    }
}
