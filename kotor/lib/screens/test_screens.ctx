// Headless test commands for the screens: `FRAME ui COMMAND ARGS` lines the input script does not
// know (lib/ingame/script.ctx) come here.
//
//   FRAME ui gold N                  the party's credits
//   FRAME ui store RESREF [UP DOWN]  a merchant made from a UTM blueprint and opened (OpenStore's
//                                    bonuses UP and DOWN, percent)
//   FRAME ui loot TAG                the container with that tag opened as if the leader used it
//   FRAME ui bag                     prints the party's inventory and credits
//   FRAME ui xp N                    gives the party N experience points
namespace test_screens {
    fn run { mut ui: ingame::Ingame, mut w: world::World, mut dev: gpu::Device, cmd: []u8, args: []u8 } -> bool {
        let mut words = text::words{ s = args }
        if ci::eq{ a = cmd, b = "gold" } {
            w.party.gold = @trunc(i32, text::scan_decimal{ s = args })
        } else if ci::eq{ a = cmd, b = "store" } {
            let name = text::next_word{ &words } ifnull { return true }
            let up = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            let down = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            let id = tmpl::spawn{ &w, kind = obj::Kind::store, template = name, position = math::vec3::zero{}, orientation = math::Vec3{ x = 0.0, y = 1.0, z = 0.0 } } iferr err{ error } {
                _ = @fmt(&w.io, "store {}: {}\n", name, error)
                return true
            }
            outbox::post{ out = &w.out, note = outbox::Note::open_store{ store = id, customer = w.pc, markup = up, markdown = down } }
            if store::data_of{ w = &w, store = id } is some{ value = st } {
                _ = @fmt(&w.io, "store {} markup {} markdown {} flag {}\n", name, st.markup, st.markdown, st.buy_sell)
                let stock = list::items{ list = st.stock }
                let mut k: usize = 0
                while k < stock.len {
                    let it = items::item_of{ w = &w, id = stock[k] }
                    let tail: []u8 = if it != null and it.infinite { " infinite" } else { "" }
                    _ = @fmt(&w.io, "  {} {} value {} buy {} sell {}{}\n", stock[k], items::name_of{ w = &w, id = stock[k] },
                        store::value_of{ w = &w, item = stock[k] }, store::buy_price{ w = &w, store = id, item = stock[k] },
                        store::sell_price{ w = &w, store = id, item = stock[k] }, tail)
                    k = k + 1
                }
            }
        } else if ci::eq{ a = cmd, b = "loot" } {
            let tag = text::next_word{ &words } ifnull { return true }
            // The first object with the tag that holds items (a tag can be shared with a waypoint).
            let mut id = world::object_by_tag{ w = &w, tag, nth = 0 }
            let mut nth: i32 = 0
            while nth < 8 {
                let found = world::object_by_tag{ w = &w, tag, nth }
                nth = nth + 1
                if found == obj::INVALID { break }
                if world::object{ w = &w, id = found } is some{ value = fo } {
                    if obj::placeable{ o = fo } is some{ value = fp } {
                        if fp.has_inventory { id = found; break }
                    }
                }
            }
            if not container::open{ &w, placeable = id, user = w.pc } { _ = @fmt(&w.io, "loot {} ({}): does not open\n", tag, id) }
        } else if ci::eq{ a = cmd, b = "containers" } {
            let all = list::items{ list = w.objects.all }
            let mut k: usize = 0
            while k < all.len {
                let o = all[k]
                k = k + 1
                if obj::placeable{ o } is some{ value = p } {
                    if p.has_inventory {
                        _ = @fmt(&w.io, "container {} tag {} items {} locked {} useable {} at {} {} {}\n", o.id, o.tag, p.inventory.len, p.locked, p.useable, o.position.x, o.position.y, o.position.z)
                    }
                }
            }
        } else if ci::eq{ a = cmd, b = "bag" } {
            _ = @fmt(&w.io, "credits {}\n", w.party.gold)
            let ids = list::items{ list = w.bag }
            let mut k: usize = 0
            while k < ids.len {
                _ = @fmt(&w.io, "  {} {} x{}\n", ids[k], items::name_of{ w = &w, id = ids[k] }, items::stack_of{ w = &w, id = ids[k] })
                k = k + 1
            }
        } else if ci::eq{ a = cmd, b = "addclass" } {
            // AddMultiClass for the leader: a new class slot at level 0 (3 Jedi Guardian, 4 Consular, 5 Sentinel).
            let f = levelup::fighter_of{ w = &w, id = party::leader{ w = &w } } ifnull { return true }
            let class = @as(i32, text::scan_decimal{ s = args })
            if f.c.nclasses < rules::MAX_LEVEL_CLASSES {
                f.c.classes[@as(usize, f.c.nclasses)] = rules::ClassSlot{ class, level = 0 }
                f.c.nclasses = f.c.nclasses + 1
            }
        } else if ci::eq{ a = cmd, b = "bench" } {
            // The upgrade bench; with a tag, straight on the party's item with that tag.
            let tag = text::next_word{ &words } ifnull ""
            let mut item = obj::INVALID
            if tag.len > 0 {
                let ids = list::items{ list = w.bag }
                let mut k: usize = 0
                while k < ids.len {
                    if world::object{ w = &w, id = ids[k] } is some{ value = o } {
                        if ci::eq{ a = o.tag, b = tag } { item = ids[k]; break }
                    }
                    k = k + 1
                }
            }
            outbox::post{ out = &w.out, note = outbox::Note::upgrade_screen{ item } }
        } else if ci::eq{ a = cmd, b = "upcheck" } {
            // Prints the bench category of each item blueprint named (0: not upgradeable).
            let mut sc = ups::new{}
            sc.upgrade_t = world::load_table{ fs = &w.fs, heap = w.heap, rm = w.rm.*, name = "upgrade" } iferr { return true }
            while true {
                let name = text::next_word{ &words } ifnull { break }
                let id = tmpl::spawn_item{ &w, template = name, possessor = obj::INVALID } iferr { continue }
                let cat = ups::category_of{ s = &sc, w = &w, item = id }
                if cat != 0 { _ = @fmt(&w.io, "upgradeable {} category {}\n", name, cat) }
                world::destroy{ &w, id }
            }
        } else if ci::eq{ a = cmd, b = "planets" } {
            // Planets available and selectable: `planets 1 3 4 5 ...` (planetary.2da rows).
            while true {
                let word = text::next_word{ &words } ifnull { break }
                let p = @as(i32, text::scan_decimal{ s = word })
                party::set_planet_flag{ &w, planet = p, bit = party::PLANET_AVAILABLE_SHIFT, on = true }
                party::set_planet_flag{ &w, planet = p, bit = party::PLANET_SELECTABLE_SHIFT, on = true }
            }
        } else if ci::eq{ a = cmd, b = "galaxy" } {
            let p = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "-1" })
            outbox::post{ out = &w.out, note = outbox::Note::galaxy_map{ planet = p } }
        } else if ci::eq{ a = cmd, b = "autoopt" } {
            w.rules.settings.auto_level = text::scan_decimal{ s = args } != 0
        } else if ci::eq{ a = cmd, b = "levels" } {
            // Every party member's level and XP.
            let members = party::members{ w = &w }
            let mut m: usize = 0
            while m < members.len {
                if levelup::fighter_of{ w = &w, id = members[m] } is some{ value = f } {
                    _ = @fmt(&w.io, "member {} {}: level {} xp {} hp {}\n", members[m], hud::name_of{ w = &w, id = members[m] }, rules::total_level{ c = &f.c }, f.c.xp, f.c.stats.max_hp)
                }
                m = m + 1
            }
        } else if ci::eq{ a = cmd, b = "levelup" } {
            outbox::post{ out = &w.out, note = outbox::Note::level_up{ who = party::leader{ w = &w } } }
        } else if ci::eq{ a = cmd, b = "autolevel" } {
            _ = @fmt(&w.io, "autolevel: {} levels\n", levelup::auto_level{ &w, id = party::leader{ w = &w } })
        } else if ci::eq{ a = cmd, b = "sheet" } {
            let f = levelup::fighter_of{ w = &w, id = party::leader{ w = &w } } ifnull { return true }
            _ = @fmt(&w.io, "sheet: level {} xp {} hp {}/{} fp {} bab {} saves {} {} {} abil {} {} {} {} {} {} classes", rules::total_level{ c = &f.c }, f.c.xp,
                f.c.stats.max_hp, f.c.stats.max_hp, f.c.stats.max_fp, f.c.stats.bab, f.c.stats.save_base[0], f.c.stats.save_base[1], f.c.stats.save_base[2],
                f.c.abil[0], f.c.abil[1], f.c.abil[2], f.c.abil[3], f.c.abil[4], f.c.abil[5])
            let mut k: i32 = 0
            while k < f.c.nclasses {
                _ = @fmt(&w.io, " {}x{}", f.c.classes[@as(usize, k)].class, f.c.classes[@as(usize, k)].level)
                k = k + 1
            }
            _ = @fmt(&w.io, " skills")
            let mut sk: usize = 0
            while sk < 8 {
                _ = @fmt(&w.io, " {}", f.c.skills[sk])
                sk = sk + 1
            }
            _ = @fmt(&w.io, " skillpts {}\n", f.c.skill_points)
        } else if ci::eq{ a = cmd, b = "xp" } {
            rt_crea::give_party_xp{ &w, amount = @as(i32, text::scan_decimal{ s = args }) }
        } else {
            return false
        }
        return true
    }
}
