// The creature standing in charrec_light, as the character sheet (character.gui LBL_3DCHAR) and
// the level-up main panel (maincg MODEL_LBL) show it: chargen's main-panel preview (preview3d,
// Kind::main) of the creature as it is dressed. CSWGuiCharacter::UpdateStats copies the creature's
// appearance record and builds body and head only (docs/re/gui.md, "CSWGuiCharacter"), so this
// is the body its armour gives (as lib/scene/visual.ctx picks it), its head, the dark side's
// textures by alignment, no weapons. The light model plays the alignment's animation (red clouds
// and sparks on the dark side, blue on the light, mist between) and the creature its pose;
// T3-M4, HK-47 and Zaalbar have their own camera hooks (chargen-3d.md, FUN_006100f0).
namespace lvl {
    const VIEW_MEMORY: usize = 33554432
    const PREVIEW_MEMORY: usize = 4194304

    struct View {
        heap: *mut heap::Heap,
        mem: alloc::Bytes,
        keep: *mut arena::Arena,
        models: *mut mdl_cache::Cache,
        pmem: alloc::Bytes,
        preview: *mut preview3d::Preview,
    }

    // The texture names a Look points into.
    struct LookNames { body: [24]u8, body_len: usize, head: [24]u8, head_len: usize }

    fn cell { t: twoda::Table, row: usize, column: []u8 } -> []u8 {
        return twoda::get_string{ t, row, column } ifnull ""
    }

    // `base` + two digits of `v` into `into` (tex<L>NN); the length, 0 if it does not fit.
    fn put_numbered { into: []mut u8, base: []u8, v: u32 } -> usize {
        if base.len == 0 or base.len + 2 > into.len { return 0 }
        let mut n: usize = 0
        preview3d::put_bytes{ into, at = &n, s = base }
        into[n] = @trunc(u8, '0' + (v / 10) % 10)
        into[n + 1] = @trunc(u8, '0' + v % 10)
        return n + 2
    }


    // What creature `c` looks like on the sheet. A B body takes the letter and texture variation
    // of its armour (a and the creature's own variation without one); an unarmoured body below
    // alignment 31 wears texaevil + 01, and the head below 41 the dark side's texture of its
    // stage. Null when the appearance has no body model.
    fn look_of { mut w: world::World, c: *obj::Creature, names: *mut LookNames } -> ?preview3d::Look {
        let t = w.tables.appearance
        let shown = if c.disguise > 0 { c.disguise } else { c.appearance }
        if @as(usize, shown) >= twoda::rows{ t } { return null }
        let row = @as(usize, shown)
        let kind = cell{ t, row, column = "modeltype" }
        let alignment = @as(i32, c.good_evil)
        let mut look = preview3d::Look{ body = "", body_texture = "", head = "", head_texture = "", pose = "" }
        names.body_len = 0
        names.head_len = 0
        if ci::eq{ a = kind, b = "b" } {
            let mut letter: u8 = 'a'
            let mut texvar = @as(u32, c.texture_variation)
            let mut armoured = false
            let armor = world::object{ w = &w, id = c.equipped[obj::SLOT_BODY] }
            if armor != null {
                if obj::item{ o = armor } is some{ value = it } {
                    armoured = true
                    let bodyvar = cell{ t = w.tables.baseitems, row = @as(usize, it.base), column = "bodyvar" }
                    if bodyvar.len == 1 { letter = ascii::to_lower{ c = bodyvar[0] } }
                    else if it.body_variation >= 1 and it.body_variation <= 10 { letter = @trunc(u8, 'a' + it.body_variation - 1) }
                    texvar = it.texture_variation
                }
            }
            let li = if letter >= 'a' and letter <= 'j' { @as(usize, letter - 'a') } else { 0 }
            look.body = cell{ t, row, column = visual::MODEL_COLUMNS[li] }
            names.body_len = put_numbered{ into = names.body[..], base = cell{ t, row, column = visual::TEX_COLUMNS[li] }, v = if texvar == 0 { 1 } else { texvar } }
            if not armoured {
                let evil = visual::dark_body_texture{ w = &w, row, alignment, into = names.body[..] }
                if evil > 0 { names.body_len = evil }
            }
            let head_row = if c.head >= 0 { c.head } else { twoda::get_int{ t, row, column = "normalhead" } ifnull -1 }
            if head_row >= 0 and @as(usize, head_row) < twoda::rows{ t = w.tables.heads } {
                let hr = @as(usize, head_row)
                look.head = cell{ t = w.tables.heads, row = hr, column = "head" }
                let dark = visual::dark_head_texture{ w = &w, head_row = hr, alignment }
                if dark.len > 0 and dark.len <= names.head.len {
                    names.head_len = 0
                    preview3d::put_bytes{ into = names.head[..], at = &names.head_len, s = dark }
                }
            }
        } else if ci::eq{ a = kind, b = "f" } {
            look.body = cell{ t, row, column = "modela" }
            if look.body.len == 0 { look.body = cell{ t, row, column = "race" } }
        } else {
            look.body = cell{ t, row, column = "race" }
            let racetex = cell{ t, row, column = "racetex" }
            if racetex.len <= names.body.len { preview3d::put_bytes{ into = names.body[..], at = &names.body_len, s = racetex } }
        }
        if look.body.len == 0 { return null }
        look.body_texture = names.body[..names.body_len]
        look.head_texture = names.head[..names.head_len]
        return look
    }

    // The preview of creature `who`; null when its appearance does not make one.
    fn make_view { mut w: world::World, mut g: gui::Gui, mut dev: gpu::Device, who: u32 } -> ?*mut View {
        let o = world::object{ w = &w, id = who } ifnull { return null }
        let c = hud::creature_of{ w = &w, id = who } ifnull { return null }
        let mut names = LookNames{ body = [0; 24], body_len = 0, head = [0; 24], head_len = 0 }
        let mut look = look_of{ &w, c, names = &names } ifnull { return null }
        // FUN_006100f0 knows three party members by tag: the droids pause instead of posing, and
        // each of the three has its own camera hook in charrec_light.
        let mut camera_node: []u8 = ""
        if slice::eq_bytes{ a = o.tag, b = "t3m4" } {
            camera_node = "camerahookt"
            look.pose = "pause1"
        } else if slice::eq_bytes{ a = o.tag, b = "hk47" } {
            camera_node = "camerahookh"
            look.pose = "pause1"
        } else if slice::eq_bytes{ a = o.tag, b = "zaalbar" } {
            camera_node = "camerahookz"
        }
        let heap = w.heap
        let mem = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap, mem = slice::empty(u8){}, count = VIEW_MEMORY } iferr { return null }
        let keep = alloc::new(arena::Arena, heap::Heap){ realloc = heap::alloc, heap, value = arena::new{ buf = mem } } iferr { return null }
        let models = alloc::new(mdl_cache::Cache, heap::Heap){ realloc = heap::alloc, heap, value = mdl_cache::new{ rm = w.rm.*, keep } } iferr { return null }
        let pmem = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap, mem = slice::empty(u8){}, count = PREVIEW_MEMORY } iferr { return null }
        let p = preview3d::make_with{
            fs = &w.fs, &dev, buf = pmem, rm = w.rm.*, models, mats = g.cache,
            appearance_2da = w.tables.appearance, heads_2da = w.tables.heads,
            kind = preview3d::Kind::main, alignment = @as(i32, c.good_evil), camera_node, look,
        } iferr err{ error } {
            _ = @fmt(&w.io, "kotor: creature view: {}\n", error)
            return null
        }
        let slot = alloc::new(preview3d::Preview, heap::Heap){ realloc = heap::alloc, heap, value = p } iferr { return null }
        return alloc::new(View, heap::Heap){ realloc = heap::alloc, heap, value = View{ heap, mem, keep, models, pmem, preview = slot } } iferr { return null }
    }

    fn free_view { mut v: View, mut dev: gpu::Device } {
        preview3d::free{ preview = v.preview, &dev }
        alloc::free(preview3d::Preview, heap::Heap){ realloc = heap::alloc, heap = v.heap, p = v.preview }
        _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = v.heap, mem = v.pmem, count = 0 }
        alloc::free(mdl_cache::Cache, heap::Heap){ realloc = heap::alloc, heap = v.heap, p = v.models }
        alloc::free(arena::Arena, heap::Heap){ realloc = heap::alloc, heap = v.heap, p = v.keep }
        _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = v.heap, mem = v.mem, count = 0 }
        alloc::free(View, heap::Heap){ realloc = heap::alloc, heap = v.heap, p = &v }
    }

    fn update_view { mut s: State, dt: f32 } {
        if not s.open { return }
        let v = s.view ifnull { return }
        preview3d::update{ preview = v.preview, dt }
    }

    // Over MODEL_LBL, between the backdrop and the panels.
    fn draw_view { mut s: State, mut g: gui::Gui, mut frame: render::Frame, target: render::Size } {
        if not s.open or s.step != 0 { return }
        let v = s.view ifnull { return }
        add_view{ v, &g, &frame, target, panel = s.main, tag = "MODEL_LBL" }
    }

    // Adds view `v` to the frame over control `tag` of `panel`.
    fn add_view { mut v: View, mut g: gui::Gui, mut frame: render::Frame, target: render::Size, panel: u32, tag: []u8 } {
        let r = gui::control_rect{ &g, panel, tag } ifnull { return }
        let sx = @as(f32, target.width) / @as(f32, g.ui_w)
        let sy = @as(f32, target.height) / @as(f32, g.ui_h)
        _ = preview3d::add_to_frame{ preview = v.preview, &frame, viewport = render::Rect{ x = r.x * sx, y = r.y * sy, w = r.w * sx, h = r.h * sy } }
    }
}
