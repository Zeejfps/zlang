// GLSL 410 sources of the enhanced renderer's PN-triangle tessellation of characters (fx_tess.ctx). The fragment
// program is glsl::SCENE_FX_FS, which reads what TESS_ES writes.
namespace glsl {
    // glsl::SCENE_VS's skinning and dangle, left in world space for the tessellation stages, with the vertex's smooth
    // normal (location 10: the normal shared by every vertex at its position, made at create_mesh) skinned too.
    const TESS_VS: c::String =
        \\#version 410 core
        \\uniform mat4 u_model;
        \\uniform mat3 u_normal;
        \\uniform int u_bone_count;
        \\uniform mat4 u_bones[32];
        \\uniform vec4 u_dangle;
        \\layout(location = 0) in vec3 a_position;
        \\layout(location = 1) in vec3 a_normal;
        \\layout(location = 2) in vec2 a_uv0;
        \\layout(location = 3) in vec2 a_uv1;
        \\layout(location = 4) in vec3 a_ts0;
        \\layout(location = 5) in vec3 a_ts1;
        \\layout(location = 6) in vec4 a_weights;
        \\layout(location = 7) in vec4 a_bones;
        \\layout(location = 8) in vec4 a_color;
        \\layout(location = 9) in float a_constraint;
        \\layout(location = 10) in vec3 a_smooth;
        \\out vec3 c_world;
        \\out vec3 c_normal;
        \\out vec3 c_smooth;
        \\out vec3 c_tangent;
        \\out vec3 c_bitangent;
        \\out vec2 c_uv0;
        \\out vec2 c_uv1;
        \\out vec4 c_color;
        \\void main() {
        \\    vec3 p = a_position + u_dangle.xyz * (a_constraint / 255.0);
        \\    vec3 n = a_normal;
        \\    vec3 sn = a_smooth;
        \\    vec3 t = -a_ts1;
        \\    vec3 b = a_ts0;
        \\    if (u_bone_count > 0) {
        \\        mat4 skin = mat4(0.0);
        \\        float total = 0.0;
        \\        for (int k = 0; k < 4; k++) {
        \\            float w = a_weights[k];
        \\            int i = int(a_bones[k] + 0.5);
        \\            if (a_bones[k] >= 0.0 && w > 0.0 && i < u_bone_count) {
        \\                skin += u_bones[i] * w;
        \\                total += w;
        \\            }
        \\        }
        \\        if (total < 0.001) {
        \\            skin = mat4(1.0);
        \\        }
        \\        p = (skin * vec4(p, 1.0)).xyz;
        \\        mat3 s3 = mat3(skin);
        \\        n = s3 * n;
        \\        sn = s3 * sn;
        \\        t = s3 * t;
        \\        b = s3 * b;
        \\    }
        \\    if (u_dangle.w != 0.0) {
        \\        p += normalize(n) * u_dangle.w;
        \\    }
        \\    c_world = (u_model * vec4(p, 1.0)).xyz;
        \\    c_normal = u_normal * n;
        \\    c_smooth = normalize(u_normal * sn);
        \\    c_tangent = mat3(u_model) * t;
        \\    c_bitangent = mat3(u_model) * b;
        \\    c_uv0 = a_uv0;
        \\    c_uv1 = a_uv1;
        \\    c_color = a_color;
        \\}
        \\

    // The PN triangle's control points (from the corners and their smooth normals, so a seam's two sides curve
    // alike) and how finely each edge is cut: u_tess.x at most, falling to 1 (flat) between u_tess.y and u_tess.z
    // metres from the eye, by the edge's own midpoint, so two triangles sharing an edge cut it alike.
    const TESS_CS: c::String =
        \\#version 410 core
        \\layout(std140) uniform Frame {
        \\    mat4 u_view_proj;
        \\    mat4 u_view;
        \\    vec4 u_eye;
        \\    vec4 u_ambient;
        \\    vec4 u_fog_color;
        \\    vec4 u_fog;
        \\};
        \\layout(vertices = 3) out;
        \\uniform vec4 u_tess;
        \\in vec3 c_world[];
        \\in vec3 c_normal[];
        \\in vec3 c_smooth[];
        \\in vec3 c_tangent[];
        \\in vec3 c_bitangent[];
        \\in vec2 c_uv0[];
        \\in vec2 c_uv1[];
        \\in vec4 c_color[];
        \\out vec3 e_world[];
        \\out vec3 e_normal[];
        \\out vec3 e_tangent[];
        \\out vec3 e_bitangent[];
        \\out vec2 e_uv0[];
        \\out vec2 e_uv1[];
        \\out vec4 e_color[];
        \\patch out vec3 p_b210;
        \\patch out vec3 p_b120;
        \\patch out vec3 p_b021;
        \\patch out vec3 p_b012;
        \\patch out vec3 p_b102;
        \\patch out vec3 p_b201;
        \\patch out vec3 p_b111;
        \\float level_of(vec3 a, vec3 b) {
        \\    float d = distance((a + b) * 0.5, u_eye.xyz);
        \\    float f = 1.0 - clamp((d - u_tess.y) / max(u_tess.z - u_tess.y, 0.01), 0.0, 1.0);
        \\    return max(1.0, mix(1.0, u_tess.x, f));
        \\}
        \\float w_of(int i, int j) {
        \\    return dot(c_world[j] - c_world[i], c_smooth[i]);
        \\}
        \\void main() {
        \\    e_world[gl_InvocationID] = c_world[gl_InvocationID];
        \\    e_normal[gl_InvocationID] = c_normal[gl_InvocationID];
        \\    e_tangent[gl_InvocationID] = c_tangent[gl_InvocationID];
        \\    e_bitangent[gl_InvocationID] = c_bitangent[gl_InvocationID];
        \\    e_uv0[gl_InvocationID] = c_uv0[gl_InvocationID];
        \\    e_uv1[gl_InvocationID] = c_uv1[gl_InvocationID];
        \\    e_color[gl_InvocationID] = c_color[gl_InvocationID];
        \\    if (gl_InvocationID == 0) {
        \\        vec3 p0 = c_world[0];
        \\        vec3 p1 = c_world[1];
        \\        vec3 p2 = c_world[2];
        \\        p_b210 = (2.0 * p0 + p1 - w_of(0, 1) * c_smooth[0]) / 3.0;
        \\        p_b120 = (2.0 * p1 + p0 - w_of(1, 0) * c_smooth[1]) / 3.0;
        \\        p_b021 = (2.0 * p1 + p2 - w_of(1, 2) * c_smooth[1]) / 3.0;
        \\        p_b012 = (2.0 * p2 + p1 - w_of(2, 1) * c_smooth[2]) / 3.0;
        \\        p_b102 = (2.0 * p2 + p0 - w_of(2, 0) * c_smooth[2]) / 3.0;
        \\        p_b201 = (2.0 * p0 + p2 - w_of(0, 2) * c_smooth[0]) / 3.0;
        \\        vec3 e = (p_b210 + p_b120 + p_b021 + p_b012 + p_b102 + p_b201) / 6.0;
        \\        vec3 v = (p0 + p1 + p2) / 3.0;
        \\        p_b111 = e + (e - v) * 0.5;
        \\        float l0 = level_of(p1, p2);
        \\        float l1 = level_of(p2, p0);
        \\        float l2 = level_of(p0, p1);
        \\        gl_TessLevelOuter[0] = l0;
        \\        gl_TessLevelOuter[1] = l1;
        \\        gl_TessLevelOuter[2] = l2;
        \\        gl_TessLevelInner[0] = max(l0, max(l1, l2));
        \\    }
        \\}
        \\

    // The curved surface at the tessellator's point: the cubic PN patch for the position, the corners' own normals,
    // tangents, UVs and colours interpolated for shading, as the scene's fragment program reads them.
    const TESS_ES: c::String =
        \\#version 410 core
        \\layout(std140) uniform Frame {
        \\    mat4 u_view_proj;
        \\    mat4 u_view;
        \\    vec4 u_eye;
        \\    vec4 u_ambient;
        \\    vec4 u_fog_color;
        \\    vec4 u_fog;
        \\};
        \\layout(triangles, fractional_odd_spacing, ccw) in;
        \\in vec3 e_world[];
        \\in vec3 e_normal[];
        \\in vec3 e_tangent[];
        \\in vec3 e_bitangent[];
        \\in vec2 e_uv0[];
        \\in vec2 e_uv1[];
        \\in vec4 e_color[];
        \\patch in vec3 p_b210;
        \\patch in vec3 p_b120;
        \\patch in vec3 p_b021;
        \\patch in vec3 p_b012;
        \\patch in vec3 p_b102;
        \\patch in vec3 p_b201;
        \\patch in vec3 p_b111;
        \\out vec3 v_world;
        \\out vec3 v_normal;
        \\out vec3 v_tangent;
        \\out vec3 v_bitangent;
        \\out vec2 v_uv0;
        \\out vec2 v_uv1;
        \\out vec4 v_color;
        \\void main() {
        \\    float u = gl_TessCoord.x;
        \\    float v = gl_TessCoord.y;
        \\    float w = gl_TessCoord.z;
        \\    vec3 p = e_world[0] * u * u * u + e_world[1] * v * v * v + e_world[2] * w * w * w
        \\           + p_b210 * 3.0 * u * u * v + p_b120 * 3.0 * u * v * v + p_b201 * 3.0 * u * u * w
        \\           + p_b021 * 3.0 * v * v * w + p_b102 * 3.0 * u * w * w + p_b012 * 3.0 * v * w * w
        \\           + p_b111 * 6.0 * u * v * w;
        \\    v_world = p;
        \\    v_normal = e_normal[0] * u + e_normal[1] * v + e_normal[2] * w;
        \\    v_tangent = e_tangent[0] * u + e_tangent[1] * v + e_tangent[2] * w;
        \\    v_bitangent = e_bitangent[0] * u + e_bitangent[1] * v + e_bitangent[2] * w;
        \\    v_uv0 = e_uv0[0] * u + e_uv0[1] * v + e_uv0[2] * w;
        \\    v_uv1 = e_uv1[0] * u + e_uv1[1] * v + e_uv1[2] * w;
        \\    v_color = e_color[0] * u + e_color[1] * v + e_color[2] * w;
        \\    gl_Position = u_view_proj * vec4(p, 1.0);
        \\}
        \\
}
