// The pointer drawn by the operating system (EnableHardwareMouse=1, docs/mechanics/graphics.md "The OS pointer"):
// the original then shows Windows' own cursor with its cursor pictures instead of drawing one. Here the GUI still
// says which picture the frame's pointer is (render::Frame.pointer); with `os` on, `draw_ui` leaves that quad out
// and `present` turns the picture into an SDL colour cursor (made once per picture and size, then kept) and shows
// it, or hides the OS pointer when the frame has none (a loading screen, free look, a movie). Off, nothing here
// touches the OS pointer: the game's owner keeps it hidden and the GUI draws its own.
namespace gpu {
    const POINTER_CURSORS: usize = 48
    const POINTER_SIDE: i32 = 128                   // the largest picture read back, and the largest cursor made
    const POINTER_BYTES: usize = 65536              // POINTER_SIDE squared, RGBA

    struct PointerCursor { image: u32, width: i32, height: i32, hot_x: i32, hot_y: i32, cursor: ?*mut sdl::Cursor }

    struct PointerState {
        os: bool,                       // the OS draws the pointer
        want: render::Pointer,          // the last submitted frame's pointer
        shown: i32,                     // what the OS pointer was last made: -1 not known, 0 hidden, 1 shown
        current: i32,                   // the cursor in force, an index into `cursors` (-1 none of ours)
        cursors: [48]PointerCursor, count: usize,
        pixels: []mut u8,               // POINTER_BYTES for the picture read back, as many for the cursor's
    }

    fn no_pointer_state { pixels: []mut u8 } -> PointerState {
        let none = PointerCursor{ image = 0, width = 0, height = 0, hot_x = 0, hot_y = 0, cursor = null }
        return PointerState{ os = false, want = render::no_pointer{}, shown = -1, current = -1, cursors = [none; 48], count = 0, pixels }
    }

    // Whether the OS draws the pointer from now on. Turned off, the OS pointer is left as it is: the owner hides it.
    fn set_os_pointer { mut dev: Device, on: bool } {
        if dev.pointer.os == on { return }
        dev.pointer.os = on
        dev.pointer.shown = -1
        dev.pointer.current = -1
    }

    fn os_pointer { dev: Device } -> bool { return dev.pointer.os }

    // Minimises the window (Alt+Enter without AllowWindowedMode, as the original's lost activation does).
    fn minimize_window { mut dev: Device, mut sdl: sdl::Sdl } {
        if dev.config.hidden { return }
        sdl::SDL_MinimizeWindow{ &sdl, window = dev.win.window }
    }

    // After the frame is shown: the OS pointer as the frame asked, its picture `scale` times the render pixels (the
    // drawable over the render size).
    fn show_pointer { mut dev: Device, mut sdl: sdl::Sdl, scale: f32 } {
        if not dev.pointer.os or dev.config.hidden { return }
        let p = dev.pointer.want
        let mut on = p.shown
        if on {
            let k = pointer_cursor{ &dev, &sdl, p, scale }
            if k < 0 { on = false }
            else if k != dev.pointer.current {
                let c = dev.pointer.cursors[@as(usize, k)].cursor ifnull { return }
                sdl::SDL_SetCursor{ &sdl, cursor = c }
                dev.pointer.current = k
            }
        }
        let state: i32 = if on { 1 } else { 0 }
        if state != dev.pointer.shown {
            sdl::show_cursor{ &sdl, on }
            dev.pointer.shown = state
        }
    }

    // The cursor for a picture at its size, made the first time; -1 when it can't be.
    fn pointer_cursor { mut dev: Device, mut sdl: sdl::Sdl, p: render::Pointer, scale: f32 } -> i32 {
        let w = clamp_side{ v = p.width * scale }
        let h = clamp_side{ v = p.height * scale }
        let hx = within{ v = @as(i32, p.hot_x * scale + 0.5), hi = w - 1 }
        let hy = within{ v = @as(i32, p.hot_y * scale + 0.5), hi = h - 1 }
        let mut i: usize = 0
        while i < dev.pointer.count {
            let c = dev.pointer.cursors[i]
            if c.image == p.image.id and c.width == w and c.height == h and c.hot_x == hx and c.hot_y == hy { return @as(i32, i) }
            i = i + 1
        }
        let slot = texture_slot{ dev, t = p.image }
        if slot == NO_SLOT { return -1 }
        let ts = dev.textures[slot]
        let tw = @as(i32, ts.width)
        let th = @as(i32, ts.height)
        if ts.cube or tw <= 0 or th <= 0 or tw > POINTER_SIDE or th > POINTER_SIDE { return -1 }
        // Level 0 as RGBA (a compressed picture comes back decoded), bottom row first as every texture is stored.
        let src = dev.pointer.pixels[..POINTER_BYTES]
        let dst = dev.pointer.pixels[POINTER_BYTES..POINTER_BYTES * 2]
        dev.gl.active_texture{ texture = gl::TEXTURE0 }
        dev.gl.bind_texture{ target = gl::TEXTURE_2D, texture = ts.name }
        dev.gl.pixel_storei{ pname = gl::PACK_ALIGNMENT, param = 1 }
        dev.gl.get_tex_image{ target = gl::TEXTURE_2D, level = 0, format = gl::RGBA, kind = gl::UNSIGNED_BYTE, pixels = src.ptr }
        dev.gl.bind_texture{ target = gl::TEXTURE_2D, texture = 0 }
        dev.state = unknown_state{}
        // Nearest texel, top row first for the OS.
        let mut y: i32 = 0
        while y < h {
            let sy = th - 1 - within{ v = y * th / h, hi = th - 1 }
            let mut x: i32 = 0
            while x < w {
                let sx = within{ v = x * tw / w, hi = tw - 1 }
                let from = @as(usize, (sy * tw + sx) * 4)
                let to = @as(usize, (y * w + x) * 4)
                slice::copy(u8){ dst = dst[to..to + 4], src = src[from..from + 4] }
                x = x + 1
            }
            y = y + 1
        }
        let made = sdl::make_cursor{ &sdl, rgba = dst, width = w, height = h, hot_x = hx, hot_y = hy } ifnull { return -1 }
        if dev.pointer.count == POINTER_CURSORS {
            // Full (pictures change with the GUI scale): start again, with the new cursor in force before the old go.
            sdl::SDL_SetCursor{ &sdl, cursor = made }
            free_pointers{ &dev, &sdl }
        }
        let k = dev.pointer.count
        dev.pointer.cursors[k] = PointerCursor{ image = p.image.id, width = w, height = h, hot_x = hx, hot_y = hy, cursor = made }
        dev.pointer.count = k + 1
        return @as(i32, k)
    }

    fn within { v: i32, hi: i32 } -> i32 { return if v < 0 { 0 } else if v > hi { hi } else { v } }

    fn clamp_side { v: f32 } -> i32 {
        let n = @as(i32, v + 0.5)
        return if n < 1 { 1 } else if n > POINTER_SIDE { POINTER_SIDE } else { n }
    }

    // Frees every cursor made (SDL keeps the one in force usable until another is set).
    fn free_pointers { mut dev: Device, mut sdl: sdl::Sdl } {
        let mut i: usize = 0
        while i < dev.pointer.count {
            let c = dev.pointer.cursors[i].cursor
            if c is some{ value } { sdl::SDL_FreeCursor{ &sdl, cursor = value } }
            dev.pointer.cursors[i].cursor = null
            i = i + 1
        }
        dev.pointer.count = 0
        dev.pointer.current = -1
    }
}
