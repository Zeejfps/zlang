// Depth of field of the enhanced renderer (docs/design/enhanced-render.md, "Depth of field"): for a view with a focus
// (View.focus: conversations focus on the speaker), after the scene is resolved and before the bloom. At half
// resolution the light and each pixel's blur, then a gather over a disc as wide as the blur, blended back over the
// light as much as each full-resolution pixel is out of focus.
namespace gpu {
    struct DofState {
        made: bool, width: i32, height: i32,
        tex: [2]u32, fbo: [2]u32,
        down: u32, down_proj: i32, down_focus: i32, down_lens: i32,
        blur: u32, blur_params: i32,
        apply: u32, apply_proj: i32, apply_focus: i32, apply_size: i32, apply_lens: i32,
    }

    fn no_dof {} -> DofState {
        return DofState{
            made = false, width = 0, height = 0, tex = [0; 2], fbo = [0; 2],
            down = 0, down_proj = -1, down_focus = -1, down_lens = -1, blur = 0, blur_params = -1,
            apply = 0, apply_proj = -1, apply_focus = -1, apply_size = -1, apply_lens = -1,
        }
    }

    const GLSL_410: c::String =
        \\#version 410 core
        \\

    fn make_dof_programs { mut dev: Device } -> ! {
        let vs = glsl::POST_VS
        let mut n: usize = 0
        let down_fs: [3]c::String = [GLSL_410, glsl::DOF_COC, glsl::DOF_DOWN_FS]
        let down = try_link{ gl = &dev.gl, vertex = &vs, fragment = down_fs[..], log = dev.log, log_len = &n }
        if down == 0 { return shader_failed{ log = dev.log[..n] } }
        let blur_fs: [2]c::String = [GLSL_410, glsl::DOF_BLUR_FS]
        let blur = try_link{ gl = &dev.gl, vertex = &vs, fragment = blur_fs[..], log = dev.log, log_len = &n }
        if blur == 0 { return shader_failed{ log = dev.log[..n] } }
        let apply_fs: [3]c::String = [GLSL_410, glsl::DOF_COC, glsl::DOF_APPLY_FS]
        let apply = try_link{ gl = &dev.gl, vertex = &vs, fragment = apply_fs[..], log = dev.log, log_len = &n }
        if apply == 0 { return shader_failed{ log = dev.log[..n] } }
        dev.gl.use_program{ program = down }
        set_unit{ &dev, program = down, name = "u_color", unit = 0 }
        set_unit{ &dev, program = down, name = "u_depth", unit = 1 }
        dev.gl.use_program{ program = blur }
        set_unit{ &dev, program = blur, name = "u_src", unit = 2 }
        dev.gl.use_program{ program = apply }
        set_unit{ &dev, program = apply, name = "u_blur", unit = 2 }
        set_unit{ &dev, program = apply, name = "u_depth", unit = 1 }
        dev.gl.use_program{ program = 0 }
        dev.dof.down = down
        dev.dof.down_proj = dev.gl.get_uniform_location{ program = down, name = "u_proj" }
        dev.dof.down_focus = dev.gl.get_uniform_location{ program = down, name = "u_focus" }
        dev.dof.down_lens = dev.gl.get_uniform_location{ program = down, name = "u_lens" }
        dev.dof.blur = blur
        dev.dof.blur_params = dev.gl.get_uniform_location{ program = blur, name = "u_params" }
        dev.dof.apply = apply
        dev.dof.apply_proj = dev.gl.get_uniform_location{ program = apply, name = "u_proj" }
        dev.dof.apply_focus = dev.gl.get_uniform_location{ program = apply, name = "u_focus" }
        dev.dof.apply_size = dev.gl.get_uniform_location{ program = apply, name = "u_size" }
        dev.dof.apply_lens = dev.gl.get_uniform_location{ program = apply, name = "u_lens" }
    }

    fn free_dof { mut dev: Device } {
        free_dof_targets{ &dev }
        dev.gl.delete_program{ program = dev.dof.down }
        dev.gl.delete_program{ program = dev.dof.blur }
        dev.gl.delete_program{ program = dev.dof.apply }
    }

    fn free_dof_targets { mut dev: Device } {
        if not dev.dof.made { return }
        let mut i: usize = 0
        while i < 2 {
            gl::delete_framebuffer{ gl = &dev.gl, id = dev.dof.fbo[i] }
            forget_texture{ &dev, name = dev.dof.tex[i] }
            i = i + 1
        }
        dev.dof.made = false
    }

    fn ensure_dof_targets { mut dev: Device, width: i32, height: i32 } -> ! {
        if dev.dof.made and dev.dof.width == width and dev.dof.height == height { return }
        free_dof_targets{ &dev }
        let mut i: usize = 0
        while i < 2 {
            dev.dof.tex[i] = make_plain_texture{ gl = &dev.gl, internal = gl::RGBA16F, format = gl::RGBA, kind = gl::HALF_FLOAT, width, height, linear = true }
            dev.dof.fbo[i] = try make_fbo{ gl = &dev.gl, c0 = dev.dof.tex[i], c1 = 0, depth = 0 }
            i = i + 1
        }
        dev.dof.made = true
        dev.dof.width = width
        dev.dof.height = height
        dev.gl.bind_framebuffer{ target = gl::FRAMEBUFFER, framebuffer = 0 }
    }

    // The view's focus blur, over dev.fxt.color (resolved). Nothing without View.focus or with the option off.
    fn run_dof { mut dev: Device, v: render::View, area: GlRect } -> ! {
        let level = dev.enhance.dof
        let f = v.focus
        if level == 0 or not f.on or f.blur <= 0.01 { return }
        let t = dev.fxt
        let hw = (t.width + 1) / 2
        let hh = (t.height + 1) / 2
        try ensure_dof_targets{ &dev, width = hw, height = hh }
        post_state{ &dev }
        let p = v.camera.proj
        // A lens: a 24 mm tall sensor behind the focal length the view's field of view gives (p.m[5] is 1 / tan(fov/2)),
        // at f/2 (f/2.8 low). A wide shot focused far blurs little, a close two-shot with a long lens more. The blur's
        // radius stops at 1/108 of the picture's height (10 pixels at 1080p; 1/144 low), in half-resolution pixels.
        let sensor: f32 = 0.024
        let focal = sensor * p.m[5] * 0.5
        let stops: f32 = if level >= 2 { 2.0 } else { 2.8 }
        let per_metre = @as(f32, area.h) / (4.0 * sensor)
        let largest = @as(f32, area.h) / (if level >= 2 { 216.0 } else { 288.0 })
        let half = GlRect{ x = area.x / 2, y = area.y / 2, w = (area.w + 1) / 2, h = (area.h + 1) / 2 }
        dev.gl.bind_framebuffer{ target = gl::FRAMEBUFFER, framebuffer = dev.dof.fbo[0] }
        dev.gl.viewport{ x = half.x, y = half.y, width = half.w, height = half.h }
        dev.gl.use_program{ program = dev.dof.down }
        bind_unit{ &dev, unit = 0, target = gl::TEXTURE_2D, name = t.color }
        bind_unit{ &dev, unit = 1, target = gl::TEXTURE_2D, name = t.depth }
        dev.gl.uniform4f{ location = dev.dof.down_proj, v0 = p.m[0], v1 = p.m[5], v2 = p.m[10], v3 = p.m[14] }
        dev.gl.uniform4f{ location = dev.dof.down_focus, v0 = f.distance, v1 = f.range, v2 = largest, v3 = math::clamp{ x = f.blur, lo = 0.0, hi = 1.0 } }
        dev.gl.uniform4f{ location = dev.dof.down_lens, v0 = focal, v1 = focal / stops, v2 = per_metre, v3 = 0.0 }
        draw_fullscreen{ &dev }
        dev.gl.bind_framebuffer{ target = gl::FRAMEBUFFER, framebuffer = dev.dof.fbo[1] }
        dev.gl.use_program{ program = dev.dof.blur }
        bind_unit{ &dev, unit = 2, target = gl::TEXTURE_2D, name = dev.dof.tex[0] }
        dev.gl.uniform4f{ location = dev.dof.blur_params, v0 = largest, v1 = if level >= 2 { 24.0 } else { 12.0 }, v2 = if level >= 2 { 4.0 } else { 2.0 }, v3 = 0.0 }
        draw_fullscreen{ &dev }
        dev.gl.bind_framebuffer{ target = gl::FRAMEBUFFER, framebuffer = t.color_fbo }
        dev.gl.viewport{ x = area.x, y = area.y, width = area.w, height = area.h }
        dev.gl.enable{ cap = gl::BLEND }
        dev.gl.blend_func_separate{ sfactor_rgb = gl::SRC_ALPHA, dfactor_rgb = gl::ONE_MINUS_SRC_ALPHA, sfactor_alpha = gl::ZERO, dfactor_alpha = gl::ONE }
        dev.gl.use_program{ program = dev.dof.apply }
        bind_unit{ &dev, unit = 2, target = gl::TEXTURE_2D, name = dev.dof.tex[1] }
        dev.gl.uniform4f{ location = dev.dof.apply_proj, v0 = p.m[0], v1 = p.m[5], v2 = p.m[10], v3 = p.m[14] }
        dev.gl.uniform4f{ location = dev.dof.apply_focus, v0 = f.distance, v1 = f.range, v2 = largest, v3 = math::clamp{ x = f.blur, lo = 0.0, hi = 1.0 } }
        dev.gl.uniform2f{ location = dev.dof.apply_size, v0 = 1.0 / @as(f32, t.width), v1 = 1.0 / @as(f32, t.height) }
        dev.gl.uniform4f{ location = dev.dof.apply_lens, v0 = focal, v1 = focal / stops, v2 = per_metre, v3 = 0.0 }
        draw_fullscreen{ &dev }
        dev.gl.disable{ cap = gl::BLEND }
        dev.state = unknown_state{}
        timer_mark{ &dev, name = "depth of field" }
    }
}
