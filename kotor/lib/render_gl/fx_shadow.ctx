// Shadow maps of the enhanced renderer (docs/design/enhanced-render.md, "Shadows"): from the view's sun and the
// strongest shadow-casting lights (render::Light.shadow) near what the camera looks at, cast by the draws that say
// they cast (Draw.casts: creatures, placeables, doors) onto everything, and by the rooms too onto creatures and
// objects from the sun. One depth atlas holds every map:
//
//   sun, moving casters only | sun, rooms and moving casters        (the top half: two squares)
//   point lights: 6 faces each, in tiles of an eighth of the atlas  (the bottom half)
//
// Rooms receive only the moving casters' shadows (their own are baked in their lightmaps): the first sun map and the
// point lights' maps, which hold no rooms. Creatures and objects take the second sun map, so a building or a tree
// shades them, and the point lights' maps.
namespace gpu {
    const SHADOW_POINTS: usize = 3
    const SHADOW_NEAR: f32 = 0.05
    const SHADOW_FOCUS: f32 = 6.0
    // A point light's shadows reach past its light, to 1.6 times its radius, as the original's did (its shadows were
    // not cut off where its light ends): its map's far plane, fading out over the last third.
    const SHADOW_REACH: f32 = 1.6

    struct ShadowState {
        size: i32,                          // the atlas's side: 0 not made
        atlas: u32,
        fbo: u32,
        sampler_cmp: u32,                   // the atlas with depth comparison and bilinear filtering (unit 5)
        sampler_raw: u32,                   // the atlas's depths as they are (unit 6), for the soft shadows' blocker search
        program: u32,
        loc: ScenePrograms,
        // The view being drawn:
        sun: bool,
        sun_light: u32,                     // the frame light that is the sun, + 1
        sun_mat: [2]math::Mat4,             // world to atlas (uv, depth): moving casters, everything
        sun_dir: math::Vec3,
        sun_strength: f32,
        sun_texel: f32,                     // metres per texel of the sun's maps
        sun_soft: f32,                      // penumbra width in atlas uv per unit of depth difference
        points: u32,
        point_light: [3]u32,                // their frame lights
        point_pos: [3]math::Vec4,           // position, radius
        point_mat: [18]math::Mat4,
        point_strength: f32,
    }

    fn no_shadows {} -> ShadowState {
        let id = math::mat4::identity{}
        return ShadowState{
            size = 0, atlas = 0, fbo = 0, sampler_cmp = 0, sampler_raw = 0, program = 0, loc = no_scene_program{},
            sun = false, sun_light = 0, sun_mat = [id; 2], sun_dir = math::vec3::zero{}, sun_strength = 0.0, sun_texel = 0.0, sun_soft = 0.0,
            points = 0, point_light = [0; 3], point_pos = [math::Vec4{ x = 0.0, y = 0.0, z = 0.0, w = 1.0 }; 3], point_mat = [id; 18],
            point_strength = 0.0,
        }
    }

    fn make_shadow_program { mut dev: Device } -> ! {
        let vs = glsl::SCENE_VS
        let fs: [1]c::String = [glsl::CASTER_FS]
        let mut n: usize = 0
        let p = try_link{ gl = &dev.gl, vertex = &vs, fragment = fs[..], log = dev.log, log_len = &n }
        if p == 0 { return shader_failed{ log = dev.log[..n] } }
        bind_frame_block{ &dev, program = p }
        dev.gl.use_program{ program = p }
        set_unit{ &dev, program = p, name = "u_diffuse", unit = 0 }
        dev.gl.use_program{ program = 0 }
        dev.shadow.program = p
        dev.shadow.loc = scene_locations{ &dev, program = p }
    }

    fn free_shadows { mut dev: Device } {
        free_shadow_atlas{ &dev }
        dev.gl.delete_program{ program = dev.shadow.program }
    }

    fn free_shadow_atlas { mut dev: Device } {
        if dev.shadow.size == 0 { return }
        gl::delete_framebuffer{ gl = &dev.gl, id = dev.shadow.fbo }
        gl::delete_texture{ gl = &dev.gl, id = dev.shadow.atlas }
        gl::delete_sampler{ gl = &dev.gl, id = dev.shadow.sampler_cmp }
        gl::delete_sampler{ gl = &dev.gl, id = dev.shadow.sampler_raw }
        dev.shadow.size = 0
    }

    // The atlas at the size the Shadows level asks (4096 soft, 2048 low).
    fn ensure_shadow_atlas { mut dev: Device, size: i32 } -> ! {
        if dev.shadow.size == size { return }
        free_shadow_atlas{ &dev }
        let t = make_plain_texture{ gl = &dev.gl, internal = gl::DEPTH_COMPONENT24, format = gl::DEPTH_COMPONENT, kind = gl::UNSIGNED_INT, width = size, height = size, linear = false }
        let fbo = gl::gen_framebuffer{ gl = &dev.gl }
        dev.gl.bind_framebuffer{ target = gl::FRAMEBUFFER, framebuffer = fbo }
        dev.gl.framebuffer_texture_2d{ target = gl::FRAMEBUFFER, attachment = gl::DEPTH_ATTACHMENT, textarget = gl::TEXTURE_2D, texture = t, level = 0 }
        let none: [1]u32 = [gl::NONE]
        dev.gl.draw_buffers{ n = 1, bufs = &none[0] }
        dev.gl.read_buffer{ src = gl::NONE }
        let status = dev.gl.check_framebuffer_status{ target = gl::FRAMEBUFFER }
        dev.gl.bind_framebuffer{ target = gl::FRAMEBUFFER, framebuffer = 0 }
        if status != gl::FRAMEBUFFER_COMPLETE {
            gl::delete_framebuffer{ gl = &dev.gl, id = fbo }
            gl::delete_texture{ gl = &dev.gl, id = t }
            return gl::incomplete{ status }
        }
        let cmp = gl::gen_sampler{ gl = &dev.gl }
        dev.gl.sampler_parameteri{ sampler = cmp, pname = gl::TEXTURE_MIN_FILTER, param = @as(i32, gl::LINEAR) }
        dev.gl.sampler_parameteri{ sampler = cmp, pname = gl::TEXTURE_MAG_FILTER, param = @as(i32, gl::LINEAR) }
        dev.gl.sampler_parameteri{ sampler = cmp, pname = gl::TEXTURE_WRAP_S, param = @as(i32, gl::CLAMP_TO_EDGE) }
        dev.gl.sampler_parameteri{ sampler = cmp, pname = gl::TEXTURE_WRAP_T, param = @as(i32, gl::CLAMP_TO_EDGE) }
        dev.gl.sampler_parameteri{ sampler = cmp, pname = gl::TEXTURE_COMPARE_MODE, param = @as(i32, gl::COMPARE_REF_TO_TEXTURE) }
        dev.gl.sampler_parameteri{ sampler = cmp, pname = gl::TEXTURE_COMPARE_FUNC, param = @as(i32, gl::LEQUAL) }
        let raw = gl::gen_sampler{ gl = &dev.gl }
        dev.gl.sampler_parameteri{ sampler = raw, pname = gl::TEXTURE_MIN_FILTER, param = @as(i32, gl::NEAREST) }
        dev.gl.sampler_parameteri{ sampler = raw, pname = gl::TEXTURE_MAG_FILTER, param = @as(i32, gl::NEAREST) }
        dev.gl.sampler_parameteri{ sampler = raw, pname = gl::TEXTURE_WRAP_S, param = @as(i32, gl::CLAMP_TO_EDGE) }
        dev.gl.sampler_parameteri{ sampler = raw, pname = gl::TEXTURE_WRAP_T, param = @as(i32, gl::CLAMP_TO_EDGE) }
        dev.shadow.size = size
        dev.shadow.atlas = t
        dev.shadow.fbo = fbo
        dev.shadow.sampler_cmp = cmp
        dev.shadow.sampler_raw = raw
    }

    // ---- a view's maps

    // Picks the view's shadow lights and draws their maps. False when nothing casts (no sun, no shadow-casting light
    // near): the view then keeps the original's planar shadows.
    fn render_shadows { mut dev: Device, frame: *render::Frame, index: u32 } -> !bool {
        dev.shadow.sun = false
        dev.shadow.points = 0
        let e = dev.enhance
        if e.shadows == 0 or not dev.shadows { return false }
        let v = frame.views[index]
        let forward = math::Vec3{ x = -v.camera.view.m[2], y = -v.camera.view.m[6], z = -v.camera.view.m[10] }
        let soft = e.shadows >= 2
        let reach: f32 = if soft { 32.0 } else { 24.0 }
        let focus = math::vec3::add_scaled{ a = v.camera.eye, b = forward, s = reach * 0.5 }
        let near_focus = math::vec3::add_scaled{ a = v.camera.eye, b = forward, s = 3.0 }
        pick_shadow_lights{ &dev, frame, at = near_focus, count = if soft { 3 } else { 1 }, sun_light = if v.sun.on { v.sun.light } else { 0 } }
        if not v.sun.on and dev.shadow.points == 0 { return false }
        try ensure_shadow_atlas{ &dev, size = if soft { 4096 } else { 2048 } }
        let size = dev.shadow.size
        dev.gl.bind_framebuffer{ target = gl::FRAMEBUFFER, framebuffer = dev.shadow.fbo }
        dev.gl.viewport{ x = 0, y = 0, width = size, height = size }
        dev.gl.disable{ cap = gl::SCISSOR_TEST }
        dev.gl.depth_mask{ flag = gl::TRUE }
        dev.gl.clear_depth{ depth = 1.0 }
        dev.gl.clear{ mask = gl::DEPTH_BUFFER_BIT }
        dev.state = unknown_state{}
        set_depth{ &dev, test = true, write = true }
        set_blend{ &dev, blend = render::Blend::opaque }
        set_stencil{ &dev, on = false }
        set_cull{ &dev, on = false }
        set_offset{ &dev, on = true }
        dev.gl.polygon_offset{ factor = 2.0, units = 4.0 }
        use_program{ &dev, program = dev.shadow.program }
        let id = math::mat4::identity{}
        dev.gl.uniform_matrix4fv{ location = dev.shadow.loc.post, count = 1, transpose = gl::FALSE, value = &id.m[0] }
        if v.sun.on { render_sun{ &dev, frame, index, v, focus, reach } }
        let mut k: u32 = 0
        while k < dev.shadow.points {
            render_point{ &dev, frame, index, k }
            k = k + 1
        }
        set_offset{ &dev, on = false }
        dev.state = unknown_state{}
        dev.shadow.point_strength = if v.sun.on { v.sun.strength } else { 0.6 }
        timer_mark{ &dev, name = "shadow maps" }
        return true
    }

    // The shadow-casting lights (not the sun) brightest at `at`, above it, at most `count`.
    fn pick_shadow_lights { mut dev: Device, frame: *render::Frame, at: math::Vec3, count: u32, sun_light: u32 } {
        let mut score: [3]f32 = [0.0; 3]
        let mut n: u32 = 0
        let mut l: u32 = 0
        while l < frame.light_count {
            let light = frame.lights[l]
            l = l + 1
            if not light.shadow or l == sun_light or light.radius >= 100.0 or light.radius <= 0.5 { continue }
            // How much it lights the casters near the camera's subject (their shadows are what shows), nearer ones more.
            let lum = light.color.x * 0.299 + light.color.y * 0.587 + light.color.z * 0.114
            let mut s: f32 = 0.0
            let mut d: u32 = 0
            while d < frame.draw_count {
                let draw = frame.draws[d]
                d = d + 1
                if not draw.casts { continue }
                let c = math::mat4::get_translation{ m = draw.transform }
                let from_focus = math::vec3::distance{ a = c, b = at }
                if from_focus > SHADOW_FOCUS * 2.0 or light.position.z < c.z + 0.5 { continue }
                let dist = math::vec3::distance{ a = light.position, b = c }
                if dist >= light.radius { continue }
                let f = 1.0 - dist / light.radius
                s = s + f * f * lum / (1.0 + from_focus * 0.3)
            }
            if s <= 0.0 { continue }
            // Insert by score.
            let mut k = if n < count { n } else { count }
            while k > 0 and score[k - 1] < s {
                if k < count {
                    score[k] = score[k - 1]
                    dev.shadow.point_light[k] = dev.shadow.point_light[k - 1]
                }
                k = k - 1
            }
            if k < count {
                score[k] = s
                dev.shadow.point_light[k] = l - 1
                if n < count { n = n + 1 }
            }
        }
        dev.shadow.points = n
        dev.shadow.sun_light = sun_light
        let mut i: u32 = 0
        while i < n {
            let light = frame.lights[dev.shadow.point_light[i]]
            dev.shadow.point_pos[i] = math::Vec4{ x = light.position.x, y = light.position.y, z = light.position.z, w = light.radius * SHADOW_REACH }
            i = i + 1
        }
    }

    // The matrix taking clip space to a tile of the atlas: x, y from -1..1 to the tile's uv rectangle, depth to 0..1.
    fn tile_matrix { x0: f32, y0: f32, w: f32 } -> math::Mat4 {
        let mut m = math::mat4::identity{}
        m.m[0] = w * 0.5
        m.m[5] = w * 0.5
        m.m[10] = 0.5
        m.m[12] = x0 + w * 0.5
        m.m[13] = y0 + w * 0.5
        m.m[14] = 0.5
        return m
    }

    // The sun's two maps: an orthographic square of 2 `reach` around `focus`, seen along the sun, snapped to whole
    // texels so the shadows don't shimmer as the camera moves.
    fn render_sun { mut dev: Device, frame: *render::Frame, index: u32, v: render::View, focus: math::Vec3, reach: f32 } {
        let size = dev.shadow.size
        let tile = size / 2
        let dir = math::vec3::normalize{ v = v.sun.direction }
        let up = if math::abs{ x = dir.z } > 0.95 { math::Vec3{ x = 1.0, y = 0.0, z = 0.0 } } else { math::Vec3{ x = 0.0, y = 0.0, z = 1.0 } }
        let rot = math::mat4::look_at{ eye = math::vec3::zero{}, at = dir, up }
        let c = math::mat4::transform_point{ m = rot, p = focus }
        let texel = 2.0 * reach / @as(f32, tile)
        let cx = math::floorf{ x = c.x / texel } * texel
        let cy = math::floorf{ x = c.y / texel } * texel
        let depth_range: f32 = 400.0
        // The eye looks down -z: the square spans cz + 200 (toward the sun) .. cz - 200.
        let proj = math::mat4::ortho{ left = cx - reach, right = cx + reach, bottom = cy - reach, top = cy + reach, near = -c.z - 200.0, far = -c.z + 200.0 }
        let vp = math::mat4::mul{ a = proj, b = rot }
        dev.shadow.sun = true
        dev.shadow.sun_dir = dir
        // A dim sun's shadows on the rooms are fainter: less of their baked light was its (the Star Map's ruins).
        let lum = v.sun.color.x * 0.299 + v.sun.color.y * 0.587 + v.sun.color.z * 0.114
        dev.shadow.sun_strength = v.sun.strength * math::min{ a = 1.0, b = lum * 2.0 }
        dev.shadow.sun_texel = texel
        // Half a degree of sun, widened: metres of penumbra per metre between caster and receiver, as atlas uv per
        // unit of depth (depth 0..1 spans depth_range metres; a square spans 2 reach metres and half the atlas).
        dev.shadow.sun_soft = 0.02 * depth_range / (2.0 * reach) * 0.5
        let frustum = math::frustum::from_matrix{ m = vp }
        let mut map: u32 = 0
        while map < 2 {
            let x0 = @as(i32, map) * tile
            dev.shadow.sun_mat[map] = math::mat4::mul{ a = tile_matrix{ x0 = @as(f32, map) * 0.5, y0 = 0.0, w = 0.5 }, b = vp }
            dev.gl.viewport{ x = x0, y = 0, width = tile, height = tile }
            upload_matrix_block{ &dev, view_proj = vp }
            draw_casters{ &dev, frame, index, frustum, rooms = map == 1, light = math::vec3::zero{}, reach = 0.0 }
            map = map + 1
        }
    }

    // A point light's six faces, each a 90 degree perspective out to its radius, in its row of tiles.
    fn render_point { mut dev: Device, frame: *render::Frame, index: u32, k: u32 } {
        let p = dev.shadow.point_pos[k]
        let at = math::Vec3{ x = p.x, y = p.y, z = p.z }
        let tile = dev.shadow.size / 8
        let proj = math::mat4::perspective{ fovy = math::radians{ degrees = 90.0 }, aspect = 1.0, near = SHADOW_NEAR, far = p.w }
        let dirs: [6]math::Vec3 = [
            math::Vec3{ x = 1.0, y = 0.0, z = 0.0 }, math::Vec3{ x = -1.0, y = 0.0, z = 0.0 },
            math::Vec3{ x = 0.0, y = 1.0, z = 0.0 }, math::Vec3{ x = 0.0, y = -1.0, z = 0.0 },
            math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }, math::Vec3{ x = 0.0, y = 0.0, z = -1.0 },
        ]
        let mut f: u32 = 0
        while f < 6 {
            let d = dirs[f]
            let up = if f >= 4 { math::Vec3{ x = 0.0, y = 1.0, z = 0.0 } } else { math::Vec3{ x = 0.0, y = 0.0, z = 1.0 } }
            let view = math::mat4::look_at{ eye = at, at = math::vec3::add{ a = at, b = d }, up }
            let vp = math::mat4::mul{ a = proj, b = view }
            let j = k * 6 + f
            let tx = @as(i32, j % 8) * tile
            let ty = dev.shadow.size / 2 + @as(i32, j / 8) * tile
            dev.shadow.point_mat[j] = math::mat4::mul{ a = tile_matrix{ x0 = @as(f32, j % 8) / 8.0, y0 = 0.5 + @as(f32, j / 8) / 8.0, w = 0.125 }, b = vp }
            dev.gl.viewport{ x = tx, y = ty, width = tile, height = tile }
            upload_matrix_block{ &dev, view_proj = vp }
            let frustum = math::frustum::from_matrix{ m = vp }
            draw_casters{ &dev, frame, index, frustum, rooms = false, light = at, reach = p.w }
            f = f + 1
        }
    }

    // The Frame block with only a view-projection matrix: what the scene's vertex program needs to draw casters.
    fn upload_matrix_block { mut dev: Device, view_proj: math::Mat4 } {
        let mut f: [48]f32 = [0.0; 48]
        let mut i: usize = 0
        while i < 16 {
            f[i] = view_proj.m[i]
            i = i + 1
        }
        dev.gl.bind_buffer{ target = gl::UNIFORM_BUFFER, buffer = dev.frame_ubo }
        dev.gl.buffer_sub_data{ target = gl::UNIFORM_BUFFER, offset = 0, size = 192, data = @cast(*u8, &f) }
        dev.gl.bind_buffer_base{ target = gl::UNIFORM_BUFFER, index = 0, buffer = dev.frame_ubo }
    }

    // The view's casting draws in a light's frustum: those that say they cast, and with `rooms` the rooms' opaque
    // and alpha-tested surfaces. `reach` > 0 limits them to a point light's sphere.
    fn draw_casters { mut dev: Device, frame: *render::Frame, index: u32, frustum: math::Frustum, rooms: bool, light: math::Vec3, reach: f32 } {
        let mut d: u32 = 0
        while d < frame.draw_count {
            let draw = frame.draws[d]
            d = d + 1
            if draw.view != index { continue }
            let room = draw.kind == render::DrawKind::room
            if not draw.casts and not (rooms and room) { continue }
            let m = draw.material
            if m.inflate != 0.0 or m.color.a < 0.5 { continue }
            if m.blend == render::Blend::alpha or m.blend == render::Blend::additive { continue }
            // Skinned draws have no bounds: their origin with a creature's size.
            let center = math::mat4::transform_point{ m = draw.transform, p = draw.center }
            let radius = if draw.radius > 0.0 { draw.radius * draw_scale{ m = draw.transform } } else { 3.0 }
            if reach > 0.0 and math::vec3::distance{ a = center, b = light } > reach + radius { continue }
            if not math::frustum::intersects_sphere{ f = frustum, center, radius } { continue }
            draw_caster{ &dev, frame, draw }
        }
    }

    fn draw_scale { m: math::Mat4 } -> f32 {
        let sx = math::vec3::length{ v = math::Vec3{ x = m.m[0], y = m.m[1], z = m.m[2] } }
        let sy = math::vec3::length{ v = math::Vec3{ x = m.m[4], y = m.m[5], z = m.m[6] } }
        let sz = math::vec3::length{ v = math::Vec3{ x = m.m[8], y = m.m[9], z = m.m[10] } }
        return math::max{ a = sx, b = math::max{ a = sy, b = sz } }
    }

    // One caster into the depth map: the scene's vertices (skinned, dangly) and, for alpha-tested and alpha-depth
    // surfaces, the diffuse alpha's cut.
    fn draw_caster { mut dev: Device, frame: *render::Frame, draw: render::Draw } {
        let mi = mesh_slot{ dev, m = draw.mesh }
        if mi == NO_SLOT { return }
        let mesh = dev.meshes[mi]
        if mesh.mode != gl::TRIANGLES { return }
        let loc = dev.shadow.loc
        let m = draw.material
        bind_vao{ &dev, vao = mesh.vao }
        dev.gl.uniform_matrix4fv{ location = loc.model, count = 1, transpose = gl::FALSE, value = &draw.transform.m[0] }
        let bones = if draw.bone_count > MAX_BONES { MAX_BONES } else { draw.bone_count }
        let palette_ok = bones > 0 and draw.bones + bones <= frame.bone_count
        dev.gl.uniform1i{ location = loc.bone_count, v0 = if palette_ok { @as(i32, bones) } else { 0 } }
        if palette_ok {
            dev.gl.uniform_matrix4fv{ location = loc.bones, count = @as(i32, bones), transpose = gl::FALSE, value = &frame.bones[draw.bones].m[0] }
        }
        dev.gl.uniform4f{ location = loc.dangle, v0 = draw.dangle.x, v1 = draw.dangle.y, v2 = draw.dangle.z, v3 = 0.0 }
        let cut = m.blend == render::Blend::punch or m.blend == render::Blend::alpha_depth
        let has_diffuse = if cut { material_map{ &dev, t = m.diffuse, unit = 0, cube = false } } else { 0 }
        dev.gl.uniform4i{ location = loc.mode, v0 = @as(i32, m.blend), v1 = has_diffuse, v2 = 0, v3 = 0 }
        if cut {
            dev.gl.uniform4f{ location = loc.uv, v0 = m.uv_scale.x, v1 = m.uv_scale.y, v2 = m.uv_offset.x, v3 = m.uv_offset.y }
            dev.gl.uniform1i{ location = loc.uv_cell, v0 = if m.uv_cell { 1 } else { 0 } }
        }
        let first = if draw.first < mesh.index_count { draw.first } else { mesh.index_count }
        let count = if draw.count == 0 or first + draw.count > mesh.index_count { mesh.index_count - first } else { draw.count }
        if count == 0 { return }
        dev.gl.draw_elements{ mode = mesh.mode, count = @as(i32, count), kind = gl::UNSIGNED_SHORT, offset = @as(usize, first) * 2 }
        dev.stats.draws = dev.stats.draws + 1
    }

    // ---- receiving

    // The enhanced scene program's shadow uniforms for the view (after render_shadows), and the atlas on units 5 and 6.
    fn set_shadow_uniforms { mut dev: Device, on: bool } {
        let s = dev.shadow
        let loc = dev.cur
        use_program{ &dev, program = loc.id }
        let quality: i32 = if dev.enhance.shadows >= 2 { 2 } else { 1 }
        let sun: i32 = if on and s.sun { 1 } else { 0 }
        let points: i32 = if on { @as(i32, s.points) } else { 0 }
        dev.gl.uniform4i{ location = loc.shadow_on, v0 = sun, v1 = points, v2 = quality, v3 = 0 }
        if not on or s.size == 0 { return }
        dev.gl.active_texture{ texture = gl::TEXTURE0 + 5 }
        dev.gl.bind_texture{ target = gl::TEXTURE_2D, texture = s.atlas }
        dev.gl.bind_sampler{ unit = 5, sampler = s.sampler_cmp }
        dev.gl.active_texture{ texture = gl::TEXTURE0 + 6 }
        dev.gl.bind_texture{ target = gl::TEXTURE_2D, texture = s.atlas }
        dev.gl.bind_sampler{ unit = 6, sampler = s.sampler_raw }
        dev.gl.active_texture{ texture = gl::TEXTURE0 }
        dev.gl.uniform_matrix4fv{ location = loc.sun_mat, count = 2, transpose = gl::FALSE, value = &s.sun_mat[0].m[0] }
        dev.gl.uniform4f{ location = loc.sun_dir, v0 = s.sun_dir.x, v1 = s.sun_dir.y, v2 = s.sun_dir.z, v3 = s.sun_strength }
        dev.gl.uniform4f{ location = loc.shadow_params, v0 = 1.0 / @as(f32, s.size), v1 = s.sun_texel, v2 = s.sun_soft, v3 = s.point_strength }
        if s.points > 0 {
            dev.gl.uniform_matrix4fv{ location = loc.point_mat, count = @as(i32, s.points) * 6, transpose = gl::FALSE, value = &s.point_mat[0].m[0] }
            dev.gl.uniform4fv{ location = loc.point_pos, count = @as(i32, s.points), value = &s.point_pos[0].x }
        }
    }

    // Which shadow map each of a draw's lights takes (the sun 0, point light k + 1, none -1), for set_lights.
    fn shadow_slot { dev: Device, light: u32 } -> i32 {
        if dev.shadow.sun and dev.shadow.sun_light == light + 1 { return 0 }
        let mut k: u32 = 0
        while k < dev.shadow.points {
            if dev.shadow.point_light[k] == light { return @as(i32, k) + 1 }
            k = k + 1
        }
        return -1
    }
}
