// GLSL 410 sources of the GL backend's programs, one array element per line (ctxlang has no
// multi-line literal; GL joins the elements as they are).
//
// GLSL 410 can't place samplers or blocks itself (layout(binding) is 4.2), so gpu.ctx sets each
// sampler's unit and the Frame block's binding (0) after linking. Attribute locations are fixed by
// `layout(location)` and match gpu.ctx's vertex array setup.
namespace glsl {
    // The per-view block every 3D program reads, std140: 192 bytes.
    //   view_proj, view: mat4; eye.xyz; ambient.rgb; fog_color.rgb; fog = (near, far, on, time)

    // Meshes: rigid, skinned (a bone palette of up to 32) and dangly, and the planar shadows,
    // which run the same vertices through `u_post`.
    const SCENE_VS: [70]c::String = [
        "#version 410 core\n",
        "layout(std140) uniform Frame {\n",
        "    mat4 u_view_proj;\n",
        "    mat4 u_view;\n",
        "    vec4 u_eye;\n",
        "    vec4 u_ambient;\n",
        "    vec4 u_fog_color;\n",
        "    vec4 u_fog;\n",
        "};\n",
        "uniform mat4 u_model;\n",
        "uniform mat4 u_post;\n",
        "uniform mat3 u_normal;\n",
        "uniform int u_bone_count;\n",
        "uniform mat4 u_bones[32];\n",
        "uniform vec4 u_dangle;\n",
        "layout(location = 0) in vec3 a_position;\n",
        "layout(location = 1) in vec3 a_normal;\n",
        "layout(location = 2) in vec2 a_uv0;\n",
        "layout(location = 3) in vec2 a_uv1;\n",
        "layout(location = 4) in vec3 a_ts0;\n",
        "layout(location = 5) in vec3 a_ts1;\n",
        "layout(location = 6) in vec4 a_weights;\n",
        "layout(location = 7) in vec4 a_bones;\n",
        "layout(location = 8) in vec4 a_color;\n",
        "layout(location = 9) in float a_constraint;\n",
        "out vec3 v_world;\n",
        "out vec3 v_normal;\n",
        "out vec3 v_tangent;\n",
        "out vec3 v_bitangent;\n",
        "out vec2 v_uv0;\n",
        "out vec2 v_uv1;\n",
        "out vec4 v_color;\n",
        "void main() {\n",
        "    vec3 p = a_position + u_dangle.xyz * (a_constraint / 255.0);\n",
        "    vec3 n = a_normal;\n",
        // MDX keeps +dP/dv, then -dP/du, then the normal.
        "    vec3 t = -a_ts1;\n",
        "    vec3 b = a_ts0;\n",
        "    if (u_bone_count > 0) {\n",
        "        mat4 skin = mat4(0.0);\n",
        "        float total = 0.0;\n",
        "        for (int k = 0; k < 4; k++) {\n",
        "            float w = a_weights[k];\n",
        "            int i = int(a_bones[k] + 0.5);\n",
        "            if (a_bones[k] >= 0.0 && w > 0.0 && i < u_bone_count) {\n",
        "                skin += u_bones[i] * w;\n",
        "                total += w;\n",
        "            }\n",
        "        }\n",
        "        if (total < 0.001) {\n",
        "            skin = mat4(1.0);\n",
        "        }\n",
        "        p = (skin * vec4(p, 1.0)).xyz;\n",
        "        mat3 s3 = mat3(skin);\n",
        "        n = s3 * n;\n",
        "        t = s3 * t;\n",
        "        b = s3 * b;\n",
        "    }\n",
        // The material's inflate (u_dangle.w): out along the skinned normal, a shell around the body.
        "    if (u_dangle.w != 0.0) {\n",
        "        p += normalize(n) * u_dangle.w;\n",
        "    }\n",
        "    vec4 world = u_post * (u_model * vec4(p, 1.0));\n",
        "    v_world = world.xyz / world.w;\n",
        "    v_normal = u_normal * n;\n",
        "    v_tangent = mat3(u_model) * t;\n",
        "    v_bitangent = mat3(u_model) * b;\n",
        "    v_uv0 = a_uv0;\n",
        "    v_uv1 = a_uv1;\n",
        "    v_color = a_color;\n",
        "    gl_Position = u_view_proj * world;\n",
        "}\n",
    ]

    // u_maps: diffuse, lightmap, envmap (1 cube, 2 sphere), bumpmap.
    // u_mode: blend (0 opaque, 1 punch, 2 alpha, 3 additive, 4 alpha_depth), lit, fog, shadow.
    const SCENE_FS: [105]c::String = [
        "#version 410 core\n",
        "layout(std140) uniform Frame {\n",
        "    mat4 u_view_proj;\n",
        "    mat4 u_view;\n",
        "    vec4 u_eye;\n",
        "    vec4 u_ambient;\n",
        "    vec4 u_fog_color;\n",
        "    vec4 u_fog;\n",
        "};\n",
        "uniform sampler2D u_diffuse;\n",
        "uniform sampler2D u_lightmap;\n",
        "uniform samplerCube u_envcube;\n",
        "uniform sampler2D u_envsphere;\n",
        "uniform sampler2D u_bump;\n",
        "uniform ivec4 u_maps;\n",
        "uniform ivec4 u_mode;\n",
        "uniform vec4 u_color;\n",
        "uniform vec4 u_selfillum;\n",
        "uniform vec4 u_uv;\n",
        "uniform int u_uv_cell;\n",
        "uniform int u_light_count;\n",
        "uniform vec4 u_light_pos[8];\n",
        "uniform vec4 u_light_color[8];\n",
        "in vec3 v_world;\n",
        "in vec3 v_normal;\n",
        "in vec3 v_tangent;\n",
        "in vec3 v_bitangent;\n",
        "in vec2 v_uv0;\n",
        "in vec2 v_uv1;\n",
        "in vec4 v_color;\n",
        "layout(location = 0) out vec4 o_color;\n",
        "void main() {\n",
        "    if (u_mode.w == 1) {\n",
        "        o_color = vec4(0.0, 0.0, 0.0, u_color.a);\n",
        "        return;\n",
        "    }\n",
        "    vec2 uv = v_uv0;\n",
        "    if (u_uv_cell == 1) {\n",
        "        uv = fract(uv);\n",
        "    }\n",
        "    uv = uv * u_uv.xy + u_uv.zw;\n",
        "    vec4 tex = vec4(1.0);\n",
        "    if (u_maps.x == 1) {\n",
        "        tex = texture(u_diffuse, uv);\n",
        "    }\n",
        "    float cut_alpha = tex.a * u_color.a * v_color.a;\n",
        "    if ((u_mode.x == 1 && cut_alpha <= 0.35) || (u_mode.x == 4 && cut_alpha <= 0.0)) {\n",
        "        discard;\n",
        "    }\n",
        "    vec3 n = normalize(v_normal);\n",
        "    if (!gl_FrontFacing) {\n",
        "        n = -n;\n",
        "    }\n",
        "    if (u_maps.w == 1) {\n",
        "        vec3 bn = texture(u_bump, uv).xyz * 2.0 - 1.0;\n",
        "        n = normalize(normalize(v_tangent) * bn.x + normalize(v_bitangent) * bn.y + n * bn.z);\n",
        "    }\n",
        "    vec3 light = vec3(1.0);\n",
        "    if (u_maps.y == 1) {\n",
        "        light = texture(u_lightmap, v_uv1).rgb;\n",
        "    } else if (u_mode.y == 1) {\n",
        "        light = u_ambient.rgb;\n",
        "        for (int i = 0; i < u_light_count; i++) {\n",
        "            vec3 d = u_light_pos[i].xyz - v_world;\n",
        "            float dist = length(d);\n",
        "            float att = clamp(1.0 - dist / u_light_pos[i].w, 0.0, 1.0);\n",
        "            float lambert = max(dot(n, d / max(dist, 0.0001)), 0.0);\n",
        "            light += u_light_color[i].rgb * (att * att * lambert);\n",
        "        }\n",
        "    }\n",
        "    vec4 base = tex * u_color * v_color;\n",
        // Self-illumination is the fixed-function pipeline's emission (CAurPartTriMesh::ApplyMaterial
        // 0x00473900 sets GL_EMISSION): added to the light, the sum clamped as GL clamps the lit
        // colour, then modulated by the texture.
        "    vec3 rgb = base.rgb * min(light + u_selfillum.rgb, vec3(1.0));\n",
        "    float alpha = base.a;\n",
        "    if (u_maps.z != 0) {\n",
        "        vec3 r = reflect(normalize(v_world - u_eye.xyz), n);\n",
        "        vec3 env;\n",
        "        if (u_maps.z == 1) {\n",
        "            env = texture(u_envcube, r).rgb;\n",
        "        } else {\n",
        "            vec3 e = mat3(u_view) * r;\n",
        "            float m = 2.0 * sqrt(e.x * e.x + e.y * e.y + (e.z + 1.0) * (e.z + 1.0));\n",
        "            env = texture(u_envsphere, e.xy / m + 0.5).rgb;\n",
        "        }\n",
        "        float amount = u_selfillum.a;\n",
        // On an opaque surface the diffuse alpha is the reflection mask (re/render-gui.md, "Environment
        // maps"): a lightmapped surface adds the reflection where alpha is low; any other surface
        // (creatures, placeables) blends lit diffuse and reflection by alpha, so a low-alpha armour
        // plate shows the dark environment, not the light diffuse plus a mirror.
        "        if (u_mode.x > 1) {\n",
        "            rgb += env * amount;\n",
        "        } else if (u_maps.y == 1) {\n",
        "            rgb += env * (amount * (1.0 - tex.a));\n",
        "        } else {\n",
        "            rgb = mix(env * amount, rgb, tex.a);\n",
        "        }\n",
        "    }\n",
        "    if (u_mode.x <= 1) {\n",
        "        alpha = 1.0;\n",
        "    }\n",
        "    if (u_mode.z == 1 && u_fog.z > 0.5) {\n",
        "        float f = clamp((length(v_world - u_eye.xyz) - u_fog.x) / max(u_fog.y - u_fog.x, 0.0001), 0.0, 1.0);\n",
        "        if (u_mode.x == 3) {\n",
        "            rgb *= 1.0 - f;\n",
        "        } else {\n",
        "            rgb = mix(rgb, u_fog_color.rgb, f);\n",
        "        }\n",
        "    }\n",
        "    o_color = vec4(rgb, alpha);\n",
        "}\n",
    ]

    // 2D quads, one instance each: rect (x, y, w, h), uv (u0, v0, u1, v1), colour, angle.
    const UI_VS: [19]c::String = [
        "#version 410 core\n",
        "uniform vec2 u_screen;\n",
        "layout(location = 0) in vec4 a_rect;\n",
        "layout(location = 1) in vec4 a_uv;\n",
        "layout(location = 2) in vec4 a_color;\n",
        "layout(location = 3) in float a_angle;\n",
        "out vec2 v_uv;\n",
        "out vec4 v_color;\n",
        "void main() {\n",
        // A triangle strip's corners: top left, top right, bottom left, bottom right.
        "    vec2 corner = vec2(float(gl_VertexID & 1), float((gl_VertexID >> 1) & 1));\n",
        "    vec2 local = (corner - 0.5) * a_rect.zw;\n",
        "    float c = cos(a_angle);\n",
        "    float s = sin(a_angle);\n",
        // Counterclockwise on screen, where y runs down.
        "    local = vec2(local.x * c + local.y * s, local.y * c - local.x * s);\n",
        "    vec2 p = a_rect.xy + a_rect.zw * 0.5 + local;\n",
        "    gl_Position = vec4(p.x / u_screen.x * 2.0 - 1.0, 1.0 - p.y / u_screen.y * 2.0, 0.0, 1.0);\n",
        "    v_uv = vec2(mix(a_uv.x, a_uv.z, corner.x), mix(a_uv.y, a_uv.w, corner.y));\n",
        "    v_color = a_color;\n",
        "}\n",
    ]

    // u_image: 0 colour only, 1 a texture, 2 a video frame's Y, U and V planes (BT.601, limited range).
    //
    // A quad shows its picture once, so it never samples past the picture's rim: `rim` pins the
    // coordinate to the centres of the outermost texels, which is what CLAMP_TO_EDGE does, whatever
    // wrap mode the texture was made with (art is REPEAT unless its TXI says `clamp`). Without it,
    // a GUI scale that magnifies a border's edge texture (1.5 on an 8-texel strip drawn 9 pixels
    // thick) lets the linear filter reach across the rim to the texture's opposite side and draws
    // that side's line inside the border, a seam along the inner edge of every button.
    const UI_FS: [24]c::String = [
        "#version 410 core\n",
        "uniform sampler2D u_tex;\n",
        "uniform sampler2D u_tex_u;\n",
        "uniform sampler2D u_tex_v;\n",
        "uniform int u_image;\n",
        "in vec2 v_uv;\n",
        "in vec4 v_color;\n",
        "layout(location = 0) out vec4 o_color;\n",
        "vec2 rim(sampler2D s) {\n",
        "    vec2 half_texel = 0.5 / vec2(textureSize(s, 0));\n",
        "    return clamp(v_uv, half_texel, 1.0 - half_texel);\n",
        "}\n",
        "void main() {\n",
        "    vec4 c = vec4(1.0);\n",
        "    if (u_image == 1) {\n",
        "        c = texture(u_tex, rim(u_tex));\n",
        "    } else if (u_image == 2) {\n",
        "        float y = (texture(u_tex, rim(u_tex)).r - 16.0 / 255.0) * (255.0 / 219.0);\n",
        "        float u = (texture(u_tex_u, rim(u_tex_u)).r - 128.0 / 255.0) * (255.0 / 224.0);\n",
        "        float v = (texture(u_tex_v, rim(u_tex_v)).r - 128.0 / 255.0) * (255.0 / 224.0);\n",
        "        c = vec4(y + 1.402 * v, y - 0.344136 * u - 0.714136 * v, y + 1.772 * u, 1.0);\n",
        "    }\n",
        "    o_color = c * v_color;\n",
        "}\n",
    ]

    // Particles, one instance each: position, size, angle, colour, frame, direction.
    // u_emit: facing (0 camera, 1 axis, 2 plane, 3 velocity, 4 emitter plane, 5 world plane, 6 upright,
    // 7 tangent, 8 ribbon), grid x, grid y. A ribbon's instance is the quad from its row to the next, whose
    // position, size and direction come in as a_next_* (the same rows one further on).
    const PARTICLE_VS: [85]c::String = [
        "#version 410 core\n",
        "layout(std140) uniform Frame {\n",
        "    mat4 u_view_proj;\n",
        "    mat4 u_view;\n",
        "    vec4 u_eye;\n",
        "    vec4 u_ambient;\n",
        "    vec4 u_fog_color;\n",
        "    vec4 u_fog;\n",
        "};\n",
        "uniform mat4 u_model;\n",
        "uniform ivec4 u_emit;\n",
        "uniform vec4 u_axis;\n",
        "layout(location = 0) in vec3 a_position;\n",
        "layout(location = 1) in vec2 a_size;\n",
        "layout(location = 2) in float a_angle;\n",
        "layout(location = 3) in vec4 a_color;\n",
        "layout(location = 4) in float a_frame;\n",
        "layout(location = 5) in vec3 a_dir;\n",
        "layout(location = 6) in vec3 a_next_position;\n",
        "layout(location = 7) in vec2 a_next_size;\n",
        "layout(location = 10) in vec3 a_next_dir;\n",
        "out vec2 v_uv;\n",
        "out vec4 v_color;\n",
        "out vec3 v_world;\n",
        "void main() {\n",
        "    vec2 corner = vec2(float(gl_VertexID & 1), float((gl_VertexID >> 1) & 1));\n",
        "    vec2 local = (vec2(corner.x, 1.0 - corner.y) - 0.5) * a_size;\n",
        "    float ang = u_emit.x == 7 ? 0.0 : a_angle;\n",
        "    float c = cos(ang);\n",
        "    float s = sin(ang);\n",
        "    local = vec2(local.x * c - local.y * s, local.x * s + local.y * c);\n",
        "    vec3 center = (u_model * vec4(a_position, 1.0)).xyz;\n",
        "    vec3 right = vec3(u_view[0][0], u_view[1][0], u_view[2][0]);\n",
        "    vec3 up = vec3(u_view[0][1], u_view[1][1], u_view[2][1]);\n",
        "    vec3 to_eye = u_eye.xyz - center;\n",
        "    if (u_emit.x == 1 || u_emit.x == 3) {\n",
        "        vec3 along = u_emit.x == 1 ? u_axis.xyz : a_dir;\n",
        "        vec3 a = mat3(u_model) * along;\n",
        "        vec3 r = cross(a, to_eye);\n",
        "        if (dot(a, a) > 1e-8 && dot(r, r) > 1e-8) {\n",
        "            up = normalize(a);\n",
        "            right = normalize(r);\n",
        "        }\n",
        "    } else if (u_emit.x == 2) {\n",
        "        vec3 nrm = normalize(mat3(u_model) * u_axis.xyz);\n",
        "        vec3 ref = abs(nrm.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);\n",
        "        right = normalize(cross(ref, nrm));\n",
        "        up = cross(nrm, right);\n",
        "    } else if (u_emit.x == 4) {\n",
        "        right = normalize(mat3(u_model)[0]);\n",
        "        up = normalize(mat3(u_model)[1]);\n",
        "    } else if (u_emit.x == 5) {\n",
        "        right = vec3(1.0, 0.0, 0.0);\n",
        "        up = vec3(0.0, 1.0, 0.0);\n",
        "    } else if (u_emit.x == 6) {\n",
        "        up = normalize(mat3(u_model) * u_axis.xyz);\n",
        "    } else if (u_emit.x == 7) {\n",
        "        vec3 tang = cross(u_axis.xyz, a_dir);\n",
        "        if (dot(tang, tang) < 1e-6) { tang = vec3(1.0, 0.0, 0.0); }\n",
        "        right = normalize(mat3(u_model) * tang);\n",
        "        up = normalize(mat3(u_model) * a_dir);\n",
        "    }\n",
        "    vec3 world = center + right * local.x + up * local.y;\n",
        // A ribbon's joint: its corners across the on-screen way into it, in the camera's plane (0x00495b20).
        "    if (u_emit.x == 8) {\n",
        "        bool far = corner.y < 0.5;\n",
        "        vec3 jp = (u_model * vec4(far ? a_next_position : a_position, 1.0)).xyz;\n",
        "        vec2 js = far ? a_next_size : a_size;\n",
        "        vec3 jd = mat3(u_model) * (far ? a_next_dir : a_dir);\n",
        "        float dx = dot(jd, right);\n",
        "        float dy = dot(jd, up);\n",
        "        float dl = sqrt(dx * dx + dy * dy);\n",
        "        vec3 e1 = right;\n",
        "        vec3 e2 = up;\n",
        "        if (dl > 1e-5) { e2 = (right * dx + up * dy) / dl; e1 = (right * dy - up * dx) / dl; }\n",
        "        world = jp + e1 * (js.x * (corner.x * 2.0 - 1.0)) + e2 * js.y;\n",
        "    }\n",
        "    gl_Position = u_view_proj * vec4(world, 1.0);\n",
        "    int gx = max(u_emit.y, 1);\n",
        "    int gy = max(u_emit.z, 1);\n",
        "    int f = int(a_frame + 0.5) % (gx * gy);\n",
        "    vec2 cell = vec2(float(f % gx), float(f / gx));\n",
        // The quad's top corners take the cell's higher v: v counts up the picture.
        "    v_uv = (cell + vec2(corner.x, 1.0 - corner.y)) / vec2(float(gx), float(gy));\n",
        "    v_color = a_color;\n",
        "    v_world = world;\n",
        "}\n",
    ]

    // u_mode: blend, fog, textured.
    const PARTICLE_FS: [33]c::String = [
        "#version 410 core\n",
        "layout(std140) uniform Frame {\n",
        "    mat4 u_view_proj;\n",
        "    mat4 u_view;\n",
        "    vec4 u_eye;\n",
        "    vec4 u_ambient;\n",
        "    vec4 u_fog_color;\n",
        "    vec4 u_fog;\n",
        "};\n",
        "uniform sampler2D u_tex;\n",
        "uniform ivec4 u_mode;\n",
        "in vec2 v_uv;\n",
        "in vec4 v_color;\n",
        "in vec3 v_world;\n",
        "layout(location = 0) out vec4 o_color;\n",
        "void main() {\n",
        "    vec4 c = v_color;\n",
        "    if (u_mode.z == 1) {\n",
        "        c *= texture(u_tex, v_uv);\n",
        "    }\n",
        "    if ((u_mode.x == 1 && c.a <= 0.35) || (u_mode.x == 4 && c.a <= 0.0)) {\n",
        "        discard;\n",
        "    }\n",
        "    if (u_mode.y == 1 && u_fog.z > 0.5) {\n",
        "        float f = clamp((length(v_world - u_eye.xyz) - u_fog.x) / max(u_fog.y - u_fog.x, 0.0001), 0.0, 1.0);\n",
        "        if (u_mode.x == 3) {\n",
        "            c.rgb *= 1.0 - f;\n",
        "        } else {\n",
        "            c.rgb = mix(c.rgb, u_fog_color.rgb, f);\n",
        "        }\n",
        "    }\n",
        "    o_color = c;\n",
        "}\n",
    ]

    // Debug lines and triangles: a world position and a colour per vertex.
    const DEBUG_VS: [16]c::String = [
        "#version 410 core\n",
        "layout(std140) uniform Frame {\n",
        "    mat4 u_view_proj;\n",
        "    mat4 u_view;\n",
        "    vec4 u_eye;\n",
        "    vec4 u_ambient;\n",
        "    vec4 u_fog_color;\n",
        "    vec4 u_fog;\n",
        "};\n",
        "layout(location = 0) in vec3 a_position;\n",
        "layout(location = 1) in vec4 a_color;\n",
        "out vec4 v_color;\n",
        "void main() {\n",
        "    v_color = a_color;\n",
        "    gl_Position = u_view_proj * vec4(a_position, 1.0);\n",
        "}\n",
    ]

    const DEBUG_FS: [6]c::String = [
        "#version 410 core\n",
        "in vec4 v_color;\n",
        "layout(location = 0) out vec4 o_color;\n",
        "void main() {\n",
        "    o_color = v_color;\n",
        "}\n",
    ]

    // The last step, screen to window: one triangle that covers the viewport. u_exponent is the
    // brightness option's gamma curve (the original loads it into the display's gamma ramp,
    // out = in ^ exponent, so it darkens or lightens everything on screen, movies included).
    const POST_VS: [9]c::String = [
        "#version 410 core\n",
        "out vec2 v_uv;\n",
        "void main() {\n",
        "    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n",
        "    v_uv = p;\n",
        "    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n",
        "}\n",
        "\n",
        "\n",
    ]

    // Speed blur: the picture sampled along the line to the centre, more toward the edges (a view's `blur`).
    const BLUR_FS: [15]c::String = [
        "#version 410 core\n",
        "uniform sampler2D u_tex;\n",
        "uniform float u_strength;\n",
        "in vec2 v_uv;\n",
        "layout(location = 0) out vec4 o_color;\n",
        "void main() {\n",
        "    vec2 to_center = vec2(0.5) - v_uv;\n",
        "    float edge = clamp(length(to_center) * 1.6, 0.0, 1.0);\n",
        "    vec3 sum = vec3(0.0);\n",
        "    for (int i = 0; i < 12; i++) {\n",
        "        float t = float(i) / 11.0;\n",
        "        sum += texture(u_tex, v_uv + to_center * (u_strength * edge * t)).rgb;\n",
        "    }\n",
        "    o_color = vec4(sum / 12.0, 1.0);\n",
        "}\n",
    ]

    // A video effect (render::VideoEffect, videoeffects.2da): a grain of u_noise at most, in cells of u_cells across the
    // picture that change with u_seed, added to the picture (the original adds its 32x32 `filmnoisetex`, of 0..0.02,
    // tiled 7.5 times over the screen), then each channel the dot product of its row with the colour.
    const VIDEO_FS: [17]c::String = [
        "#version 410 core\n",
        "uniform sampler2D u_tex;\n",
        "uniform vec3 u_red;\n",
        "uniform vec3 u_green;\n",
        "uniform vec3 u_blue;\n",
        "uniform float u_noise;\n",
        "uniform float u_seed;\n",
        "uniform vec2 u_cells;\n",
        "in vec2 v_uv;\n",
        "layout(location = 0) out vec4 o_color;\n",
        "void main() {\n",
        "    vec2 cell = floor(v_uv * u_cells);\n",
        "    float grain = fract(sin(dot(cell, vec2(12.9898, 78.233)) + u_seed) * 43758.5453);\n",
        "    vec3 c = texture(u_tex, v_uv).rgb + vec3(grain * u_noise);\n",
        "    o_color = vec4(clamp(vec3(dot(u_red, c), dot(u_green, c), dot(u_blue, c)), 0.0, 1.0), 1.0);\n",
        "}\n",
        "\n",
    ]

    const POST_FS: [10]c::String = [
        "#version 410 core\n",
        "uniform sampler2D u_tex;\n",
        "uniform float u_exponent;\n",
        "in vec2 v_uv;\n",
        "layout(location = 0) out vec4 o_color;\n",
        "void main() {\n",
        "    vec3 c = texture(u_tex, v_uv).rgb;\n",
        "    o_color = vec4(pow(c, vec3(u_exponent)), 1.0);\n",
        "}\n",
        "\n",
    ]
}
