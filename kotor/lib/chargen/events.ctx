// What the panels' events do (docs/re/chargen.md): class selection, the quick or custom lists, the
// five steps and the confirmation boxes.
namespace chargen {
    // Class selection's six slots, left to right: class (classes.2da row), gender, the description's
    // strref (0x007a2684).
    const SLOT_CLASS: [SLOTS]i32 = [2, 1, 0, 0, 1, 2]
    const SLOT_GENDER: [SLOTS]i32 = [0, 0, 0, 1, 1, 1]
    const SLOT_DESC: [SLOTS]u32 = [32109, 32110, 32111, 32111, 32110, 32109]

    // gui::EventKind::arrow's values (gui's DIR_LEFT and DIR_RIGHT).
    const ARROW_LEFT: i32 = 2
    const ARROW_RIGHT: i32 = 3

    fn tag_is { ev: gui::Event, tag: []u8 } -> bool {
        return slice::eq_bytes{ a = ev.tag, b = tag }
    }

    // The slot a BTN_SELn tag names (0 based), -1 for another tag.
    fn slot_of { tag: []u8 } -> i32 {
        if tag.len != 8 or not slice::eq_bytes{ a = tag[..7], b = "BTN_SEL" } { return -1 }
        let d = tag[7]
        if d < '1' or d > '6' { return -1 }
        return @as(i32, d - '1')
    }

    // The k of a BTN_STEPNAMEk tag (1 based), 0 for another tag.
    fn step_button_of { tag: []u8 } -> i32 {
        if tag.len != 13 or not slice::eq_bytes{ a = tag[..12], b = "BTN_STEPNAME" } { return 0 }
        let d = tag[12]
        if d < '1' or d > '6' { return 0 }
        return @as(i32, d - '0')
    }

    // One event from the GUI.
    fn on_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        if st.msg_panel != 0 and ev.panel == st.msg_panel { return message_event{ st, &g, &fs, &dev, ev } }
        let screen = screen_of{ st, panel = ev.panel }
        if screen == SCR_CLASS { return class_event{ st, &g, &fs, &dev, ev } }
        if screen == SCR_CHOICE { return choice_event{ st, &g, &fs, &dev, ev } }
        if screen == SCR_QUICK or screen == SCR_CUSTOM { return steps_event{ st, &g, &fs, &dev, ev, screen } }
        if screen == SCR_PORTRAIT { return portrait_event{ st, &g, &fs, &dev, ev } }
        if screen == SCR_NAME { return name_event{ st, &g, &fs, &dev, ev } }
        if screen == SCR_ABILITIES { return abilities_event{ st, &g, &fs, &dev, ev } }
        if screen == SCR_SKILLS { return skills_event{ st, &g, &fs, &dev, ev } }
        if screen == SCR_FEATS { return feats_event{ st, &g, &fs, &dev, ev } }
        return Outcome::running
    }

    // ---- class selection

    // "Male Scout": the gender word and the class name, joined.
    fn show_class_name { st: *mut State, mut g: gui::Gui, p: u32, slot: i32 } -> ! {
        let s = @as(usize, slot)
        let gender = try gui::tlk_text{ &g, strref = if SLOT_GENDER[s] == 1 { 647 } else { 646 } }
        defer gui::free_string{ &g, s = gender }
        let class = try gui::tlk_text{ &g, strref = @as(u32, st.tables.classes[@as(usize, SLOT_CLASS[s])].name) }
        defer gui::free_string{ &g, s = class }
        let mut buf: [96]u8
        let mut n = frontend::copy_into{ dst = buf[..], src = gender }
        n = n + frontend::copy_into{ dst = buf[n..], src = " " }
        n = n + frontend::copy_into{ dst = buf[n..], src = class }
        try gui::set_text{ &g, panel = p, tag = "LBL_CLASS", text = buf[..n] }
        try gui::set_strref{ &g, panel = p, tag = "LBL_DESC", strref = SLOT_DESC[s] }
    }

    fn class_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        let p = ev.panel
        if ev.kind == gui::EventKind::cancel { return Outcome::cancelled }
        let slot = slot_of{ tag = ev.tag }
        if ev.kind == gui::EventKind::hilight and slot >= 0 {
            show_class_name{ st, &g, p, slot } iferr {}
        } else if ev.kind == gui::EventKind::activate {
            if tag_is{ ev, tag = "BTN_BACK" } { return Outcome::cancelled }
            if slot >= 0 { choose_slot{ st, &g, &fs, &dev, slot } iferr {} }
        }
        return Outcome::running
    }

    // The hilighted button is the large one. The exe's per-frame render of the panel
    // (CSWGuiClassSelection, 0x006dc030; docs/re/chargen.md A) moves each button's TOP between 128
    // (small) and 118 (large) and its 3D label with it, every edge by the same amount: left and top
    // by the step, width and height by twice that.
    const SLOT_LARGE_TOP: i32 = 118
    const SLOT_SMALL_TOP: i32 = 128
    const SLOT_TAG: [SLOTS][]u8 = ["BTN_SEL1", "BTN_SEL2", "BTN_SEL3", "BTN_SEL4", "BTN_SEL5", "BTN_SEL6"]

    fn animate_slots { st: *mut State, mut g: gui::Gui, p: u32, dt: f32 } {
        let mut i: usize = 0
        while i < SLOTS {
            animate_slot{ st, &g, p, slot = i, dt }
            i = i + 1
        }
    }

    // A change of hilight starts a timer of a quarter second for every whole ten pixels to go
    // (none when less is left, so the next frame snaps); then the button is at 40 pixels a second
    // from the end it left until the time is out, when it snaps to the target.
    fn animate_slot { st: *mut State, mut g: gui::Gui, p: u32, slot: usize, dt: f32 } {
        let e = gui::control_extent{ &g, panel = p, tag = SLOT_TAG[slot] } ifnull { return }
        let top = @as(i32, e.y)
        let large = gui::is_hilighted{ &g, panel = p, tag = SLOT_TAG[slot] }
        let target = if large { SLOT_LARGE_TOP } else { SLOT_SMALL_TOP }
        let to_go = if large { top - target } else { target - top }
        if to_go <= 0 {
            st.slot_timer[slot] = -1.0
            return
        }
        if st.slot_timer[slot] == -1.0 {
            st.slot_timer[slot] = @as(f32, to_go / 10) * 0.25
            return
        }
        let left = st.slot_timer[slot] - dt
        st.slot_timer[slot] = left
        let mut next = target
        if left > 0.0 {
            let moved = @as(i32, (0.25 - left) * 40.0)
            next = if large { SLOT_SMALL_TOP - moved } else { SLOT_LARGE_TOP + moved }
            if (large and next <= SLOT_LARGE_TOP) or (not large and next >= SLOT_SMALL_TOP) {
                next = target
                st.slot_timer[slot] = -1.0
            }
        } else {
            st.slot_timer[slot] = -1.0
        }
        let step = next - top
        if step == 0 { return }
        move_edges{ &g, panel = p, tag = SLOT_TAG[slot], step }
        move_edges{ &g, panel = p, tag = MODEL_TAG[slot], step }
    }

    // `step` > 0 shrinks the control, < 0 grows it, about its centre.
    fn move_edges { mut g: gui::Gui, panel: u32, tag: []u8, step: i32 } {
        let e = gui::control_extent{ &g, panel, tag } ifnull { return }
        gui::set_extent{
            &g, panel, tag, x = @as(i32, e.x) + step, y = @as(i32, e.y) + step,
            w = @as(i32, e.w) - 2 * step, h = @as(i32, e.h) - 2 * step,
        }
    }

    // The slot's creature becomes the character; the summary opens with the quick-or-custom list.
    fn choose_slot { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, slot: i32 } -> ! {
        let s = @as(usize, slot)
        st.ch = fresh_choices{}
        st.ch.slot = slot
        st.ch.class = SLOT_CLASS[s]
        st.ch.gender = SLOT_GENDER[s]
        st.ch.portrait = st.slot_portrait[s]
        st.ch.appearance = portrait_appearance{ d = &st.data, row = st.ch.portrait, class = st.ch.class }
        st.mode = 0
        st.step = 0
        try open_screen{ st, &g, &fs, &dev, screen = SCR_MAIN }
        try open_screen{ st, &g, &fs, &dev, screen = SCR_CHOICE }
    }

    // ---- quick or custom

    fn choice_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        let p = ev.panel
        if ev.kind == gui::EventKind::cancel { leave_summary{ st, &g }; return Outcome::running }
        if ev.kind == gui::EventKind::hilight {
            if tag_is{ ev, tag = "QUICK_CHAR_BTN" } { set_description{ &g, panel = p, tag = "LB_DESC", strref = 241 } iferr {} }
            if tag_is{ ev, tag = "CUST_CHAR_BTN" } { set_description{ &g, panel = p, tag = "LB_DESC", strref = 242 } iferr {} }
        } else if ev.kind == gui::EventKind::activate {
            if tag_is{ ev, tag = "BTN_BACK" } { leave_summary{ st, &g }; return Outcome::running }
            if tag_is{ ev, tag = "QUICK_CHAR_BTN" } { show_step_panel{ st, &g, &fs, &dev, screen = SCR_QUICK } iferr {} }
            if tag_is{ ev, tag = "CUST_CHAR_BTN" } { show_step_panel{ st, &g, &fs, &dev, screen = SCR_CUSTOM } iferr {} }
        }
        return Outcome::running
    }

    // Back on the quick-or-custom list closes the summary, which uncovers class selection.
    fn leave_summary { st: *mut State, mut g: gui::Gui } {
        while st.depth > 1 { close_top{ st, &g } }
        refresh_views_after_leave{ st }
    }

    // Replaces the step list on top of the summary by `screen` (the quick-or-custom list, quick or custom).
    fn show_step_panel { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, screen: u32 } -> ! {
        while st.depth > 2 { close_top{ st, &g } }
        st.step = 0
        st.mode = if screen == SCR_QUICK { 1 } else if screen == SCR_CUSTOM { 2 } else { 0 }
        let main = panel_of_screen{ st, screen = SCR_MAIN }
        if screen == SCR_QUICK {
            quick_build{ st }
            refresh_summary{ st, &g, p = main } iferr {}
        }
        try open_screen{ st, &g, &fs, &dev, screen }
    }

    // ---- the step lists

    // The panel `screen` ("quick" or "custom") with only the current step enabled (the panels'
    // SetStep, custom 0x006eefd0, quick 0x006efc10). Each step is a circle (`LBL_k`, a type-5 control
    // the pointer never touches), its number (`LBL_NUMk`) and its name (`BTN_STEPNAMEk`): the current
    // step's circle is hilighted and its number and name are selectable in the hilight colour; every
    // other step's are neither, their text dim.
    fn bind_steps { st: *mut State, mut g: gui::Gui, p: u32, screen: u32 } {
        let count: i32 = if screen == SCR_QUICK { 3 } else { 6 }
        let mut k: i32 = 0
        while k < count {
            let digit = '1' + @trunc(u8, k)
            let current = k == st.step
            let mut circle: [8]u8
            let nc = frontend::copy_into{ dst = circle[..], src = "LBL_" }
            circle[nc] = digit
            gui::set_click_through{ &g, panel = p, tag = circle[..nc + 1], through = true }
            gui::set_hilighted{ &g, panel = p, tag = circle[..nc + 1], on = current }
            let mut number: [12]u8
            let nn = frontend::copy_into{ dst = number[..], src = "LBL_NUM" }
            number[nn] = digit
            show_step_text{ &g, p, tag = number[..nn + 1], current }
            let mut name: [16]u8
            let n = frontend::copy_into{ dst = name[..], src = "BTN_STEPNAME" }
            name[n] = digit
            show_step_text{ &g, p, tag = name[..n + 1], current }
            k = k + 1
        }
        gui::set_enabled{ &g, panel = p, tag = "BTN_BACK", enabled = st.step > 0 }
    }

    // A step's number or name: selectable in the hilight colour when it is the current step, else
    // not selectable, which dims its text (SetSelectable, vtable slot 34).
    fn show_step_text { mut g: gui::Gui, p: u32, tag: []u8, current: bool } {
        if current {
            gui::set_enabled{ &g, panel = p, tag, enabled = true }
            gui::set_text_color{ &g, panel = p, tag, color = gui::color_hilight{} }
        } else {
            gui::set_text_color{ &g, panel = p, tag, color = gui::color_menu{} }
            gui::set_enabled{ &g, panel = p, tag, enabled = false }
        }
    }

    // After a step: the counter moves on and the list below shows the next step.
    fn finish_step { st: *mut State, mut g: gui::Gui, to: i32 } {
        st.step = to
        let screen = top_screen{ st }
        if screen == SCR_QUICK or screen == SCR_CUSTOM { bind_steps{ st, &g, p = top_panel{ st }, screen } }
    }

    fn steps_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event, screen: u32 } -> Outcome {
        if ev.kind == gui::EventKind::cancel { back_step{ st, &g, &fs, &dev }; return Outcome::running }
        if ev.kind != gui::EventKind::activate { return Outcome::running }
        if tag_is{ ev, tag = "BTN_BACK" } { back_step{ st, &g, &fs, &dev }; return Outcome::running }
        if tag_is{ ev, tag = "BTN_CANCEL" } { cancel_step{ st, &g, &fs, &dev }; return Outcome::running }
        let k = step_button_of{ tag = ev.tag }
        if k == 0 or k - 1 != st.step { return Outcome::running }
        return run_step{ st, &g, &fs, &dev, screen, index = k - 1 }
    }

    // The sub-panel (or Play) of the step at `index`.
    fn run_step { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, screen: u32, index: i32 } -> Outcome {
        let quick = screen == SCR_QUICK
        let target: u32 = if index == 0 { SCR_PORTRAIT }
            else if quick { if index == 1 { SCR_NAME } else { 0 } }
            else if index == 1 { SCR_ABILITIES } else if index == 2 { SCR_SKILLS } else if index == 3 { SCR_FEATS } else if index == 4 { SCR_NAME } else { 0 }
        if target == 0 { return play{ st } }
        open_screen{ st, &g, &fs, &dev, screen = target } iferr {}
        return Outcome::running
    }

    // Back: one step down (the custom list resets the character on reaching its second step), or
    // out to the quick-or-custom list from the first.
    fn back_step { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device } {
        let screen = top_screen{ st }
        if st.step > 0 {
            let to = st.step - 1
            if screen == SCR_CUSTOM and to == 1 {
                reset_character{ st, &g }
            }
            finish_step{ st, &g, to }
            return
        }
        reset_character{ st, &g }
        show_step_panel{ st, &g, &fs, &dev, screen = SCR_CHOICE } iferr {}
    }

    fn cancel_step { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device } {
        if st.step > 0 {
            show_message{ st, &g, &fs, &dev, strref = 48541, ask = Ask::cancel_all } iferr {}
            return
        }
        reset_character{ st, &g }
        show_step_panel{ st, &g, &fs, &dev, screen = SCR_CHOICE } iferr {}
    }

    // All scores back to 8 and 30 points, skills and feats cleared; the name, portrait and body stay.
    fn reset_character { st: *mut State, mut g: gui::Gui } {
        st.ch.abil = [8; 6]
        st.ch.ability_points = ABILITY_POINTS
        st.ch.skills = [0; SKILLS]
        st.ch.skill_points = 0
        st.ch.nfeats = 0
        let main = panel_of_screen{ st, screen = SCR_MAIN }
        if main != 0 { clear_summary{ &g, p = main } }
    }

    // The answer to a message box.
    fn message_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        if ev.kind != gui::EventKind::activate and ev.kind != gui::EventKind::cancel { return Outcome::running }
        let ask = st.msg_ask
        let ok = tag_is{ ev, tag = "BTN_OK" }
        close_message{ st, &g }
        if not ok { return Outcome::running }
        if ask == Ask::cancel_all {
            reset_character{ st, &g }
            show_step_panel{ st, &g, &fs, &dev, screen = SCR_CHOICE } iferr {}
        } else if ask == Ask::skills_left {
            let done = accept_skills{ st, &g, &fs, &dev, confirmed = true } iferr { false }
            if done { close_top{ st, &g }; finish_step{ st, &g, to = 3 } }
        }
        return Outcome::running
    }

    // ---- the five steps

    fn portrait_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        let p = ev.panel
        if ev.kind == gui::EventKind::cancel { leave_portrait{ st, &g, &fs, &dev }; return Outcome::running }
        if ev.kind == gui::EventKind::arrow and (ev.value == ARROW_LEFT or ev.value == ARROW_RIGHT) {
            step_portrait{ st, &g, &fs, &dev, p, delta = if ev.value == ARROW_LEFT { -1 } else { 1 } }
        }
        if ev.kind != gui::EventKind::activate { return Outcome::running }
        if tag_is{ ev, tag = "BTN_ARRL" } { step_portrait{ st, &g, &fs, &dev, p, delta = -1 } }
        if tag_is{ ev, tag = "BTN_ARRR" } { step_portrait{ st, &g, &fs, &dev, p, delta = 1 } }
        if tag_is{ ev, tag = "BTN_BACK" } { leave_portrait{ st, &g, &fs, &dev } }
        if tag_is{ ev, tag = "BTN_ACCEPT" } {
            close_top{ st, &g }
            let main = panel_of_screen{ st, screen = SCR_MAIN }
            show_portrait_picture{ st, &g, &fs, &dev, p = main, tag = "PORTRAIT_LBL", row = st.ch.portrait }
            refresh_views{ st, &g, &fs, &dev }
            finish_step{ st, &g, to = 1 }
        }
        return Outcome::running
    }

    fn leave_portrait { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device } {
        restore_portrait{ st, &g, &fs, &dev }
        close_top{ st, &g }
        refresh_views{ st, &g, &fs, &dev }
    }

    fn name_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        let p = ev.panel
        if ev.kind == gui::EventKind::cancel { close_top{ st, &g }; return Outcome::running }
        let accepted = ev.kind == gui::EventKind::text_accepted or (ev.kind == gui::EventKind::activate and tag_is{ ev, tag = "END_BTN" })
        if accepted {
            let ok = accept_name{ st, &g, &fs, &dev, p } iferr { false }
            if ok {
                close_top{ st, &g }
                finish_step{ st, &g, to = if st.mode == 1 { 2 } else { 5 } }
            }
        } else if ev.kind == gui::EventKind::activate {
            if tag_is{ ev, tag = "BTN_RANDOM" } {
                random_name_into_box{ st, &g, &fs, p } iferr {}
                gui::set_focus{ &g, panel = p, tag = "NAME_BOX_EDIT" }
            }
            if tag_is{ ev, tag = "BTN_BACK" } { close_top{ st, &g } }
        }
        return Outcome::running
    }

    fn abilities_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        let p = ev.panel
        if ev.kind == gui::EventKind::cancel { leave_abilities{ st, &g }; return Outcome::running }
        let row = ability_row_of{ tag = ev.tag }
        if ev.kind == gui::EventKind::arrow and (ev.value == ARROW_LEFT or ev.value == ARROW_RIGHT) {
            // the arrow keys are the focused row's minus and plus (0x3f, 0x40)
            if ev.value == ARROW_LEFT { lower_ability{ st, &g, &fs, &dev, p, row = st.ab_focus } iferr {} } else { raise_ability{ st, &g, &fs, &dev, p, row = st.ab_focus } iferr {} }
        }
        if ev.kind == gui::EventKind::hilight and row >= 0 {
            focus_ability{ st, &g, p, row = @as(usize, row) }
        } else if ev.kind == gui::EventKind::activate {
            if row >= 0 and slice::eq_bytes{ a = ev.tag[4..], b = "PLUS_BTN" } {
                raise_ability{ st, &g, &fs, &dev, p, row = @as(usize, row) } iferr {}
            } else if row >= 0 and slice::eq_bytes{ a = ev.tag[4..], b = "MINUS_BTN" } {
                lower_ability{ st, &g, &fs, &dev, p, row = @as(usize, row) } iferr {}
            } else if tag_is{ ev, tag = "BTN_RECOMMENDED" } {
                recommend_abilities{ st, &g, p } iferr {}
            } else if tag_is{ ev, tag = "BTN_ACCEPT" } {
                let ok = accept_abilities{ st, &g, &fs, &dev } iferr { false }
                if ok {
                    close_top{ st, &g }
                    let main = panel_of_screen{ st, screen = SCR_MAIN }
                    refresh_summary{ st, &g, p = main } iferr {}
                    finish_step{ st, &g, to = 2 }
                }
            } else if tag_is{ ev, tag = "BTN_BACK" } {
                leave_abilities{ st, &g }
            }
        }
        return Outcome::running
    }

    fn leave_abilities { st: *mut State, mut g: gui::Gui } {
        st.ch.ability_points = ABILITY_POINTS
        close_top{ st, &g }
    }

    fn skills_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        let p = ev.panel
        if ev.kind == gui::EventKind::cancel { close_top{ st, &g }; return Outcome::running }
        let row = skill_row_of{ tag = ev.tag }
        if ev.kind == gui::EventKind::arrow and (ev.value == ARROW_LEFT or ev.value == ARROW_RIGHT) {
            if ev.value == ARROW_LEFT { lower_skill{ st, &g, p, row = st.sk_focus } iferr {} } else { raise_skill{ st, &g, &fs, &dev, p, row = st.sk_focus } iferr {} }
        }
        if ev.kind == gui::EventKind::hilight and row >= 0 {
            focus_skill{ st, &g, p, row = @as(usize, row) }
        } else if ev.kind == gui::EventKind::activate {
            if row >= 0 and slice::eq_bytes{ a = ev.tag[4..], b = "PLUS_BTN" } {
                raise_skill{ st, &g, &fs, &dev, p, row = @as(usize, row) } iferr {}
            } else if row >= 0 and slice::eq_bytes{ a = ev.tag[4..], b = "MINUS_BTN" } {
                lower_skill{ st, &g, p, row = @as(usize, row) } iferr {}
            } else if tag_is{ ev, tag = "BTN_RECOMMENDED" } {
                recommend_skills{ st, &g, p } iferr {}
            } else if tag_is{ ev, tag = "BTN_ACCEPT" } {
                let ok = accept_skills{ st, &g, &fs, &dev, confirmed = false } iferr { false }
                if ok {
                    close_top{ st, &g }
                    finish_step{ st, &g, to = 3 }
                }
            } else if tag_is{ ev, tag = "BTN_BACK" } {
                st.sk = [0; SKILLS]
                close_top{ st, &g }
            }
        }
        return Outcome::running
    }

    fn feats_event { st: *mut State, mut g: gui::Gui, mut fs: Fs, mut dev: gpu::Device, ev: gui::Event } -> Outcome {
        let p = ev.panel
        if ev.kind == gui::EventKind::cancel { close_top{ st, &g }; return Outcome::running }
        if ev.kind == gui::EventKind::row_selected {
            st.fsel = feat_index{ st, feat = ev.user }
            show_feat{ st, &g, p } iferr {}
        } else if ev.kind == gui::EventKind::row_activated {
            st.fsel = feat_index{ st, feat = ev.user }
            toggle_feat{ st, &g, &fs, &dev, p } iferr {}
        } else if ev.kind == gui::EventKind::cell_enter {
            // Enter picks or drops the focused cell's feat, whichever control has the focus (0x006f4680:
            // GUI sound 0, then 0x006f3c20 as a press on the cell); the focused control has it next.
            gui::play_sound{ &g, n = 0 }
            st.fsel = feat_index{ st, feat = ev.user }
            toggle_feat{ st, &g, &fs, &dev, p } iferr {}
        } else if ev.kind == gui::EventKind::activate {
            if tag_is{ ev, tag = "BTN_SELECT" } {
                toggle_feat{ st, &g, &fs, &dev, p } iferr {}
            } else if tag_is{ ev, tag = "BTN_RECOMMENDED" } {
                recommend_feats{ st, &g, p } iferr {}
            } else if tag_is{ ev, tag = "BTN_ACCEPT" } {
                let ok = accept_feats{ st, &g, &fs, &dev } iferr { false }
                if ok {
                    close_top{ st, &g }
                    finish_step{ st, &g, to = 4 }
                }
            } else if tag_is{ ev, tag = "BTN_BACK" } {
                close_top{ st, &g }
            }
        }
        return Outcome::running
    }

    // ---- Quick Character and Play

    // The class's recommended character: its scores, the feats and the skills its priority lists
    // pick (docs/re/chargen.md C.4).
    fn quick_build { st: *mut State } {
        let mut r: usize = 0
        while r < 6 {
            st.ch.abil[r] = class_score{ d = &st.data, class = st.ch.class, ability = r }
            r = r + 1
        }
        st.ch.ability_points = 0
        reset_scratch{ st }
        let mut rec: rules::LevelRecord
        if not rules::prepare_auto_level{ tables = st.tables, c = st.scratch, class = st.ch.class, rec = &rec } { return }
        st.ch.skills = rec.skills
        st.ch.skill_points = rec.skill_left
        st.ch.nfeats = rec.nfeats
        let mut f: usize = 0
        while f < 8 {
            st.ch.feats[f] = rec.feats[f]
            f = f + 1
        }
    }

    // Play: the creature is made and the front end takes it.
    fn play { st: *mut State } -> Outcome {
        make_player{ st } iferr { return Outcome::running }
        return Outcome::finished
    }
}
