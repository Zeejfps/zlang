// The name step's Random Name button: a first name from humanm.ltr or humanf.ltr and a last name
// from humanl.ltr, drawn the way the engine draws them (docs/formats/ltr.md, docs/re/chargen.md),
// refused when namefilter.2da lists the name.
namespace chargen {
    // Longest name part the generator is asked for (the engine passes none: 0).
    const NAME_PART_MAX: usize = 15

    // The bytes of the table `name` (an LTR resref), read from the install; empty if it is missing.
    fn load_ltr { mut fs: Fs, rm: res::Manager, heap: *mut heap::Heap, name: []u8 } -> alloc::Bytes {
        let loaded = res::load{ &fs, rm, name, kind = restype::Type::ltr, realloc = heap::alloc, heap } iferr { return slice::empty(u8){} }
        return loaded ifnull { slice::empty(u8){} }
    }

    fn free_bytes { b: alloc::Bytes, heap: *mut heap::Heap } {
        if b.len > 0 { _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap, mem = b, count = 0 } }
    }

    // Whether namefilter.2da lists `name` (compared whole, ignoring case).
    fn is_filtered { mut fs: Fs, rm: res::Manager, heap: *mut heap::Heap, name: []u8 } -> bool {
        let loaded = res::load{ &fs, rm, name = "namefilter", kind = restype::Type::twoda, realloc = heap::alloc, heap } iferr { return false }
        let bytes = loaded ifnull { return false }
        defer free_bytes{ b = bytes, heap }
        let t = twoda::parse{ data = bytes, realloc = heap::alloc, heap } iferr { return false }
        defer twoda::free{ t, realloc = heap::alloc, heap }
        let mut r: usize = 0
        while r < twoda::rows{ t } {
            let word = twoda::get_string{ t, row = r, column = "name" } ifnull ""
            if word.len > 0 and ci::eq{ a = word, b = name } { return true }
            r = r + 1
        }
        return false
    }

    // One name part from the table `name`, into `into`; its length (0: the table is missing or the
    // generator gave up). Draws again while the filter lists the result.
    fn draw_name_part { mut fs: Fs, rm: res::Manager, heap: *mut heap::Heap, name: []u8, mut rng: ltr::Rng, into: []mut u8 } -> usize {
        let bytes = load_ltr{ &fs, rm, heap, name }
        defer free_bytes{ b = bytes, heap }
        if bytes.len == 0 { return 0 }
        let t = ltr::parse{ data = bytes } iferr { return 0 }
        let mut tries: u32 = 0
        while tries < 20 {
            let part = ltr::generate{ t, &rng, max_len = NAME_PART_MAX, into }
            if part.len == 0 { return 0 }
            if not is_filtered{ &fs, rm, heap, name = part } { return part.len }
            tries = tries + 1
        }
        return 0
    }

    // A full random name, "First Last", for the player of that gender (0 male, 1 female).
    fn random_name { mut fs: Fs, rm: res::Manager, heap: *mut heap::Heap, gender: i32, mut rng: ltr::Rng, into: []mut u8 } -> usize {
        let mut first: [NAME_PART_MAX]u8
        let mut last: [NAME_PART_MAX]u8
        let fl = draw_name_part{ &fs, rm, heap, name = if gender == 1 { "humanf" } else { "humanm" }, &rng, into = first[..] }
        let ll = draw_name_part{ &fs, rm, heap, name = "humanl", &rng, into = last[..] }
        let mut n = frontend::copy_into{ dst = into, src = first[..fl] }
        if ll > 0 and n + 1 < into.len {
            into[n] = ' '
            n = n + 1
            n = n + frontend::copy_into{ dst = into[n..], src = last[..ll] }
        }
        return n
    }
}
