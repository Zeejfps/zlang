// Character generation as the front end drives it (docs/design/chargen.md):
//
//   let st = try chargen::begin{ &fs, &g, &dev, heap = fe.heap, seed }     // loads the rules tables, opens classsel
//   each frame: for each GUI event: match chargen::on_event{ st, &g, &fs, &dev, ev } { running => {}, finished => ..., cancelled => ... }
//               chargen::update{ st, &g, dt }
//               chargen::draw_views{ st, &g, &frame, target }              // the 3D creatures, after the panels
//   chargen::free{ st, &g, &dev }                                           // frees everything, closes the panels
//
// `State.player` holds the finished player creature as the bytes of a UTC-shaped GFF once the
// outcome is `finished`.
namespace chargen {
    struct State {
        heap: *mut heap::Heap,
        tables: *mut rules::Tables,
        data: Data,
        stack: [10]Entry = [Entry{ screen = 0, panel = 0 }; 10],
        depth: usize = 0,
        ch: Choices,
        rng: ltr::Rng,
        player: alloc::Bytes,               // the finished creature's GFF bytes (heap)
        scratch: *mut rules::Creature,      // a creature the screens ask the rules questions of
        // class selection
        slot_portrait: [SLOTS]i32 = [0; SLOTS], // the random portrait each slot's creature shows
        slot_timer: [SLOTS]f32 = [-1.0; SLOTS], // the button's grow or shrink in progress: seconds left, -1 none
        // the quick or custom list: which one is up and its step counter
        mode: u32 = 0,                      // 0 none yet, 1 quick, 2 custom
        step: i32 = 0,
        // a message box over the panels
        msg_panel: u32 = 0,
        msg_ask: Ask = Ask::nothing,
        // the portrait step
        plist: [MAX_PORTRAITS]i32 = [0; MAX_PORTRAITS],
        pcount: usize = 0,
        pidx: usize = 0,
        portrait_before: i32 = 0,
        appearance_before: i32 = 0,
        // the abilities step, in the panel's order STR DEX CON WIS INT CHA
        ab: [6]i32 = [8; 6],
        ab_points: i32 = 0,
        ab_focus: usize = 0,
        // the skills step
        sk: [SKILLS]i32 = [0; SKILLS],
        sk_points: i32 = 0,
        sk_focus: usize = 0,
        // the feats step
        frows: [MAX_FEAT_ROWS]FeatRow = [FeatRow{ feat = 0, state = 0 }; MAX_FEAT_ROWS],
        fcount: usize = 0,
        fpicks: i32 = 0,                    // regular feats still to choose
        fchosen: [8]i32 = [0; 8],
        fnchosen: usize = 0,
        fsel: i32 = 0,                      // the focused cell's feat, an index into frows
        views: Views,
        fgranted: i32 = 0,                  // the feats the class granted when the feats panel opened (its "granted" popup)
        tut: Tutor,                         // the tutorial pop-ups (tutorial.ctx)
    }

    // Starts character generation: reads the rules tables and opens the class selection.
    fn begin { mut fs: Fs, mut g: gui::Gui, mut dev: gpu::Device, heap: *mut heap::Heap, seed: u32 } -> !*mut State {
        let mut blank: rules::Tables
        let tables = try alloc::new(rules::Tables, heap::Heap){ realloc = heap::alloc, heap, value = blank }
        rules::load_tables{ &fs, rm = g.rm, heap = &heap.*, out = &tables.* } iferr err{ error } {
            alloc::free(rules::Tables, heap::Heap){ realloc = heap::alloc, heap, p = tables }
            return error
        }
        let data = try load_data{ &fs, rm = g.rm, heap }
        let mut blank_creature: rules::Creature
        let scratch = try alloc::new(rules::Creature, heap::Heap){ realloc = heap::alloc, heap, value = blank_creature }
        let st = try alloc::new(State, heap::Heap){ realloc = heap::alloc, heap, value = State{
            heap, tables, data, ch = fresh_choices{},
            rng = ltr::seed_rng{ seed }, player = slice::empty(u8){}, scratch,
            views = Views{ .. }, tut = Tutor{ .. },
            ..
        } }
        try open_screen{ st, &g, &fs, &dev, screen = SCR_CLASS }
        return st
    }

    fn fresh_choices {} -> Choices {
        let mut c: Choices
        c.slot = -1
        c.class = -1
        c.portrait = -1
        c.abil = [8; 6]
        c.ability_points = ABILITY_POINTS
        return c
    }

    // Closes the panels and gives back everything.
    fn free { st: *mut State, mut g: gui::Gui, mut dev: gpu::Device } {
        free_views{ st, &dev }
        while st.depth > 0 {
            gui::close{ &g, id = st.stack[st.depth - 1].panel }
            st.depth = st.depth - 1
        }
        close_message{ st, &g }
        free_tutor{ st, &g }
        free_bytes{ b = st.player, heap = st.heap }
        free_data{ d = st.data, heap = st.heap }
        rules::free_tables{ out = &st.tables.*, heap = &st.heap.* }
        alloc::free(rules::Tables, heap::Heap){ realloc = heap::alloc, heap = st.heap, p = st.tables }
        alloc::free(rules::Creature, heap::Heap){ realloc = heap::alloc, heap = st.heap, p = st.scratch }
        alloc::free(State, heap::Heap){ realloc = heap::alloc, heap = st.heap, p = st }
    }
}
