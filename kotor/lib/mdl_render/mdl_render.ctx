// Models through the render seam: a parsed model's meshes uploaded once, and each frame a pose
// turned into draws. Textures and materials are the caller's (the render lead's `material`
// library maps a mesh's texture names and TXI to a render::Material); this file adds what the
// model and its pose say: the mesh, its transform, opacity, self-illumination, scrolling UVs,
// the bone palette and the bounding sphere.
//
//   let g = try mdl_render::upload{ &dev, realloc, &heap, model = &m }
//   let mats = ...one render::Material per Model.meshes entry (mdl_render::base_material{ mesh } plus textures)
//   each frame, after mdl_anim::evaluate:
//   _ = mdl_render::add_draws{ &frame, view, model = &m, pose, g, transform = instance, materials = mats, time }
//
// Which meshes draw (models.md): those with `render` set, except AABB meshes (the walkmesh's
// copy). A lightsaber blade draws from geometry built out of its Saber arrays, two-sided.
//
// A program that adds this directory adds lib/render and a backend (lib/render_gl).
namespace mdl_render {
    // A model's meshes on the GPU, by Model.meshes index: null for meshes that don't draw.
    struct Gpu { meshes: []?render::Mesh }

    fn draws { mesh: mdl::Mesh } -> bool {
        if not mesh.render or mesh.aabb != null { return false }
        if mesh.saber != null { return has_blade{ mesh } }
        return mesh.indices.len > 0 and mesh.vertex_count > 0
    }

    // Uploads every mesh that draws. Vertex arrays are packed in memory from `realloc` and given
    // back once uploaded; the Gpu's array stays, in the same allocator.
    fn upload(S) { mut dev: gpu::Device, realloc: alloc::Fn(S), mut heap: S, model: *mdl::Model } -> !Gpu {
        let out = try alloc::resize(?render::Mesh, S){ realloc, &heap, mem = slice::empty(?render::Mesh){}, count = model.meshes.len }
        let mut i: usize = 0
        while i < out.len {
            out[i] = null
            let m = model.meshes[i]
            if draws{ mesh = m } {
                if m.saber != null {
                    out[i] = try upload_blade{ &dev, realloc, &heap, mesh = m }
                } else {
                    let s = streams{ mesh = m }
                    let bytes = try alloc::resize(u8, S){ realloc, &heap, mem = slice::empty(u8){}, count = render::streams_size{ s } }
                    let made = upload_streams{ &dev, s, bytes, indices = m.indices }
                    _ = alloc::resize(u8, S){ realloc, &heap, mem = bytes, count = 0 }
                    out[i] = try made
                }
            }
            i = i + 1
        }
        return Gpu{ meshes = out }
    }

    // ---- lightsaber blades
    //
    // A saber mesh's 176 vertices are 44 columns of 4 along the blade (base cap, base, tip, tip
    // cap). Columns 23, 22, 0 and 1 cross the blade: one edge (u = 0), the axis twice (u = 0.5),
    // the other edge (u = 1); the rest repeat the axis (for the swing trail, inferred). The blade
    // is the strip edge to axis to edge, 3 quads along each half: 12 triangles, as many as the
    // mesh's placeholder faces. Each saber model crosses two such meshes at right angles, and
    // its `powerup` and `powerdown` animations scale them out and in. mdl.md, Saber.
    const BLADE_COLUMNS: [4]usize = [23, 22, 0, 1]
    const SABER_VERTICES: usize = 176

    fn has_blade { mesh: mdl::Mesh } -> bool {
        let s = mesh.saber ifnull { return false }
        return s.positions.len >= 3 * SABER_VERTICES and s.uvs.len >= 2 * SABER_VERTICES
    }

    fn upload_blade(S) { mut dev: gpu::Device, realloc: alloc::Fn(S), mut heap: S, mesh: mdl::Mesh } -> !render::Mesh {
        let saber = mesh.saber ifnull { @panic("mdl_render: upload_blade without a saber") }
        let floats = try alloc::resize(f32, S){ realloc, &heap, mem = slice::empty(f32){}, count = 16 * 8 }
        let positions = floats[..48]
        let normals = floats[48..96]
        let uvs = floats[96..128]
        let has_normals = saber.normals.len >= 3 * SABER_VERTICES
        let columns = BLADE_COLUMNS
        let mut c: usize = 0
        while c < 4 {
            let mut r: usize = 0
            while r < 4 {
                let from = 4 * columns[c] + r
                let to = 4 * c + r
                let mut k: usize = 0
                while k < 3 {
                    positions[3 * to + k] = saber.positions[3 * from + k]
                    normals[3 * to + k] = if has_normals { saber.normals[3 * from + k] } else if k == 1 { 1.0 } else { 0.0 }
                    k = k + 1
                }
                uvs[2 * to] = saber.uvs[2 * from]
                uvs[2 * to + 1] = saber.uvs[2 * from + 1]
                r = r + 1
            }
            c = c + 1
        }
        // From the allocator, not the stack: what create_mesh fails with may be taken to hold
        // its arguments' addresses (docs/friction/models.md).
        let indices = try alloc::resize(u16, S){ realloc, &heap, mem = slice::empty(u16){}, count = 36 }
        let mut n: usize = 0
        let halves: [2]u16 = [0, 2]
        let mut h: usize = 0
        while h < 2 {
            let a = halves[h]
            let mut r: u16 = 0
            while r < 3 {
                let p = 4 * a + r
                let q = 4 * (a + 1) + r
                indices[n] = p
                indices[n + 1] = q
                indices[n + 2] = q + 1
                indices[n + 3] = p
                indices[n + 4] = q + 1
                indices[n + 5] = p + 1
                n = n + 6
                r = r + 1
            }
            h = h + 1
        }
        let s = render::Streams{
            vertex_count = 16, positions, normals, uv0 = uvs, uv1 = slice::empty(f32){}, tangents = slice::empty(f32){},
            weights = slice::empty(f32){}, bones = slice::empty(u8){}, colors = slice::empty(u8){}, constraints = slice::empty(f32){},
        }
        let bytes = try alloc::resize(u8, S){ realloc, &heap, mem = slice::empty(u8){}, count = render::streams_size{ s } }
        let made = upload_streams{ &dev, s, bytes, indices }
        _ = alloc::resize(u8, S){ realloc, &heap, mem = bytes, count = 0 }
        _ = alloc::resize(u16, S){ realloc, &heap, mem = indices, count = 0 }
        _ = alloc::resize(f32, S){ realloc, &heap, mem = floats, count = 0 }
        return try made
    }

    fn upload_streams { mut dev: gpu::Device, s: render::Streams, bytes: []mut u8, indices: []u16 } -> !render::Mesh {
        // pack_streams fails only for a buffer smaller than streams_size, which `bytes` isn't.
        let layout = render::pack_streams{ s, into = bytes } ifnull { @panic("mdl_render: pack_streams refused its own size") }
        let desc = render::MeshDesc{
            layout, vertex_count = s.vertex_count, index_count = @as(u32, indices.len),
            primitive = render::Primitive::triangles, dynamic = false,
        }
        return try gpu::create_mesh{ &dev, desc, vertices = bytes, indices }
    }

    fn release { mut dev: gpu::Device, g: Gpu } {
        let mut i: usize = 0
        while i < g.meshes.len {
            let m = g.meshes[i]
            if m != null { gpu::free_mesh{ &dev, m } }
            i = i + 1
        }
    }

    // The mesh's vertex arrays as render takes them: lib/mdl's streams as they are, skin weights
    // and palette slots, and a dangly mesh's constraints.
    fn streams { mesh: mdl::Mesh } -> render::Streams {
        let mut s = render::Streams{
            vertex_count = mesh.vertex_count,
            positions = mesh.positions, normals = mesh.normals, uv0 = mesh.uv0, uv1 = mesh.uv1, tangents = mesh.tangents,
            weights = slice::empty(f32){}, bones = slice::empty(u8){}, colors = slice::empty(u8){}, constraints = slice::empty(f32){},
        }
        let skin = mesh.skin
        if skin != null {
            s.weights = skin.weights
            s.bones = skin.bones
        }
        let dangly = mesh.dangly
        if dangly != null and dangly.constraints.len == @as(usize, mesh.vertex_count) { s.constraints = dangly.constraints }
        return s
    }

    // What a mesh's own data says of its material, before textures: lit and fogged, sorted by
    // the transparency hint among transparent surfaces. The caller adds textures and what their
    // TXI says (blending, environment and bump maps).
    fn base_material { mesh: mdl::Mesh } -> render::Material {
        let mut m = render::make_material{}
        m.sort = if mesh.transparency_hint < 1000 { @as(i32, mesh.transparency_hint) } else { 1000 }
        return m
    }

    // Adds a draw for every mesh of `model` that draws, posed by `pose` and placed by
    // `transform` (the model's world matrix), with `materials[i]` for Model.meshes[i]. The pose
    // adds opacity (its accumulated alpha: below 1 an opaque or punch-through surface blends),
    // self-illumination, UV scrolling at `time` (seconds), skin palettes and dangly meshes' swing
    // (mdl_anim::swing). Returns how many draws the frame took.
    fn add_draws {
        mut frame: render::Frame, view: u32, model: *mdl::Model, pose: mdl_anim::Pose, g: Gpu,
        transform: math::Mat4, materials: []render::Material, time: f32,
    } -> u32 {
        return add_draws_look{ &frame, view, model, pose, g, transform, materials, time, look = null }
    }

    // The same with `look`, when there is one, in place of every mesh's own material (a creature
    // in stealth mode wears one shimmering texture over all of it).
    fn add_draws_look {
        mut frame: render::Frame, view: u32, model: *mdl::Model, pose: mdl_anim::Pose, g: Gpu,
        transform: math::Mat4, materials: []render::Material, time: f32, look: ?render::Material,
    } -> u32 {
        let mut palette: [32]math::Mat4
        let mut added: u32 = 0
        let mut i: usize = 0
        while i < model.meshes.len and i < g.meshes.len and i < materials.len {
            let handle = g.meshes[i]
            let mesh = &model.meshes[i]
            i = i + 1
            if handle == null { continue }
            let node: usize = mesh.node
            let mut mat = materials[i - 1]
            if look is some{ value = l } {
                // Keep what decides whether the mesh shows at all (a hidden node's alpha).
                let mut worn = l
                worn.color.a = mat.color.a
                mat = worn
            }
            let alpha = pose.alpha[node]
            if alpha < 0.999 {
                mat.color.a = mat.color.a * math::max{ a = alpha, b = 0.0 }
                if mat.blend == render::Blend::opaque or mat.blend == render::Blend::punch { mat.blend = render::Blend::alpha }
            }
            let si = pose.nodes[node].self_illum
            mat.selfillum = math::vec3::add{ a = mat.selfillum, b = si }
            if mesh.animate_uv {
                mat.uv_offset = math::Vec2{
                    x = mat.uv_offset.x + fract{ x = mesh.uv_direction.x * time },
                    y = mat.uv_offset.y + fract{ x = mesh.uv_direction.y * time },
                }
            }
            if mesh.saber != null { mat.two_sided = true }
            let mut d = render::make_draw{ view, mesh = handle, transform = math::mat4::mul{ a = transform, b = pose.world[node] }, material = mat }
            let skin = mesh.skin
            if skin != null {
                let n = mdl_anim::skin_palette{ model, mesh, pose, out = palette[..] }
                let first = render::add_bones{ &frame, palette = palette[..n] } ifnull { continue }
                d.bones = first
                d.bone_count = @as(u32, n)
            } else if mesh.saber == null {
                d.center = mesh.average
                d.radius = mesh.radius
            }
            if mesh.dangly != null and i - 1 < pose.swings.len { d.dangle = pose.swings[i - 1].offset }
            if render::add_draw{ &frame, draw = d } != null { added = added + 1 }
        }
        return added
    }

    fn fract { x: f32 } -> f32 { return x - math::floorf{ x } }
}
