// The functions every backend's namespace `gpu` declares, written as calls so the compiler checks
// them against whichever backend the build added. Nothing calls `check`; compiling it is the test.
// A backend that changes a signature breaks the build here, not in game code.
//
// ctxlang can't name a function whose error set is inferred as a value of a function type (spec
// §8, Errors, rule 12), so the contract is calls with the argument and result types spelled out.
namespace render_contract {
    fn check {
        mut sdl: sdl::Sdl, realloc: alloc::Fn(arena::Arena), mut heap: arena::Arena, config: render::Config,
        texture_desc: render::TextureDesc, mesh_desc: render::MeshDesc, data: []u8, indices: []u16,
        frame: *render::Frame, pixels: []mut u8,
    } -> ! {
        let mut dev: gpu::Device = try gpu::open{ &sdl, realloc, &heap, config }
        let info: render::Info = gpu::describe{ dev }
        let stats: render::Stats = gpu::get_stats{ dev }
        let screen: render::Size = gpu::screen_size{ dev }
        let messages: []u8 = gpu::messages{ dev }
        gpu::clear_messages{ &dev }
        try gpu::resize{ &dev, width = screen.width, height = screen.height }

        // The window and the display options (docs/mechanics/graphics.md).
        let window: render::Size = gpu::window_size{ &sdl, dev }
        let drawable: render::Size = gpu::drawable_size{ &sdl, dev }
        let mut modes: [8]render::DisplayMode
        let mode_count: usize = gpu::list_display_modes{ &sdl, dev, into = modes[..] }
        let desktop: render::DisplayMode = gpu::desktop_mode{ &sdl, dev }
        let usable: render::Size = gpu::usable_size{ &sdl, dev }
        let dpi_scale: f32 = gpu::display_scale{ &sdl, dev }
        let kind: render::WindowMode = gpu::window_mode{ &sdl, dev }
        try gpu::set_window_mode{ &dev, &sdl, mode = kind, width = 640, height = 480, refresh = 0 }
        let vsync: bool = gpu::set_vsync{ &dev, &sdl, on = true }
        let samples: i32 = gpu::set_antialias{ &dev, samples = 4 }
        let aniso: f32 = gpu::set_anisotropy{ &dev, level = 8 }
        gpu::set_gamma{ &dev, exponent = 1.0 }
        gpu::set_effects{ &dev, shadows = true, soft_shadows = false, particles = true, screen_effects = true }
        gpu::shade_pixels{ dev, pixels }
        let shown: render::Rect = gpu::present_rect{ &sdl, dev }

        let t: render::Texture = try gpu::create_texture{ &dev, desc = texture_desc, data }
        try gpu::update_texture{ &dev, t, level = 0, x = 0, y = 0, width = 1, height = 1, format = render::PixelFormat::rgba8, data }
        let size: render::Size = gpu::texture_size{ dev, t }
        gpu::free_texture{ &dev, t }

        let m: render::Mesh = try gpu::create_mesh{ &dev, desc = mesh_desc, vertices = data, indices }
        try gpu::update_mesh{ &dev, m, offset = 0, vertices = data }
        gpu::free_mesh{ &dev, m }

        let target: render::Target = try gpu::create_target{ &dev, width = 64, height = 64 }
        let colour: ?render::Texture = gpu::target_texture{ dev, t = target }
        let read: render::Size = try gpu::read_target{ &dev, t = target, into = pixels }
        gpu::free_target{ &dev, t = target }

        try gpu::submit{ &dev, frame }
        gpu::present{ &dev, &sdl }
        let shot: render::Size = try gpu::read_screen{ &dev, into = pixels }
        gpu::close{ &dev, &sdl }
    }
}
