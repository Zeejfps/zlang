// The functions every backend's namespace `gpu` declares, as values of their function types, so
// the compiler checks them against whichever backend the build added. Nothing calls `check`;
// compiling it is the test. A backend that changes a signature breaks the build here, not in game
// code. A function converts to its type if it takes no field the type lacks (it may leave one
// out), each with the same type and, if `mut`, `mut` there too, and returns the same result type:
// a `!T` fails with any error in the type, and the function's own errors convert to it (spec §5).
namespace render_contract {
    fn check {} {
        let open: fn{ mut sdl: sdl::Sdl, realloc: alloc::Fn(arena::Arena), mut heap: arena::Arena, config: render::Config } -> !gpu::Device = gpu::open
        let describe: fn{ dev: gpu::Device } -> render::Info = gpu::describe
        let get_stats: fn{ dev: gpu::Device } -> render::Stats = gpu::get_stats
        let screen_size: fn{ dev: gpu::Device } -> render::Size = gpu::screen_size
        let messages: fn{ dev: gpu::Device } -> []u8 = gpu::messages
        let clear_messages: fn{ mut dev: gpu::Device } = gpu::clear_messages
        let resize: fn{ mut dev: gpu::Device, width: u32, height: u32 } -> ! = gpu::resize

        // The window and the display options (docs/mechanics/graphics.md).
        let window_size: fn{ mut sdl: sdl::Sdl, dev: gpu::Device } -> render::Size = gpu::window_size
        let drawable_size: fn{ mut sdl: sdl::Sdl, dev: gpu::Device } -> render::Size = gpu::drawable_size
        let list_display_modes: fn{ mut sdl: sdl::Sdl, dev: gpu::Device, into: []mut render::DisplayMode } -> usize = gpu::list_display_modes
        let desktop_mode: fn{ mut sdl: sdl::Sdl, dev: gpu::Device } -> render::DisplayMode = gpu::desktop_mode
        let usable_size: fn{ mut sdl: sdl::Sdl, dev: gpu::Device } -> render::Size = gpu::usable_size
        let display_scale: fn{ mut sdl: sdl::Sdl, dev: gpu::Device } -> f32 = gpu::display_scale
        let window_mode: fn{ mut sdl: sdl::Sdl, dev: gpu::Device } -> render::WindowMode = gpu::window_mode
        let set_window_mode: fn{
            mut dev: gpu::Device, mut sdl: sdl::Sdl, mode: render::WindowMode, width: i32, height: i32, refresh: i32,
        } -> ! = gpu::set_window_mode
        let set_vsync: fn{ mut dev: gpu::Device, mut sdl: sdl::Sdl, on: bool } -> bool = gpu::set_vsync
        let set_antialias: fn{ mut dev: gpu::Device, samples: i32 } -> i32 = gpu::set_antialias
        let set_anisotropy: fn{ mut dev: gpu::Device, level: i32 } -> f32 = gpu::set_anisotropy
        let set_gamma: fn{ mut dev: gpu::Device, exponent: f32 } = gpu::set_gamma
        let set_effects: fn{ mut dev: gpu::Device, shadows: bool, soft_shadows: bool, particles: bool, screen_effects: bool } = gpu::set_effects
        let shade_pixels: fn{ dev: gpu::Device, pixels: []mut u8 } = gpu::shade_pixels
        // The enhanced renderer (docs/design/enhanced-render.md).
        let set_enhance: fn{ mut dev: gpu::Device, enhance: render::Enhance } = gpu::set_enhance
        let get_timings: fn{ dev: gpu::Device } -> render::Timings = gpu::get_timings
        let present_rect: fn{ mut sdl: sdl::Sdl, dev: gpu::Device } -> render::Rect = gpu::present_rect

        let create_texture: fn{ mut dev: gpu::Device, desc: render::TextureDesc, data: []u8 } -> !render::Texture = gpu::create_texture
        let update_texture: fn{
            mut dev: gpu::Device, t: render::Texture, level: u32, x: u32, y: u32, width: u32, height: u32,
            format: render::PixelFormat, data: []u8,
        } -> ! = gpu::update_texture
        let texture_size: fn{ dev: gpu::Device, t: render::Texture } -> render::Size = gpu::texture_size
        let free_texture: fn{ mut dev: gpu::Device, t: render::Texture } = gpu::free_texture

        let create_mesh: fn{ mut dev: gpu::Device, desc: render::MeshDesc, vertices: []u8, indices: []u16 } -> !render::Mesh = gpu::create_mesh
        let update_mesh: fn{ mut dev: gpu::Device, m: render::Mesh, offset: usize, vertices: []u8 } -> ! = gpu::update_mesh
        let free_mesh: fn{ mut dev: gpu::Device, m: render::Mesh } = gpu::free_mesh

        let create_target: fn{ mut dev: gpu::Device, width: u32, height: u32 } -> !render::Target = gpu::create_target
        let target_texture: fn{ dev: gpu::Device, t: render::Target } -> ?render::Texture = gpu::target_texture
        let read_target: fn{ mut dev: gpu::Device, t: render::Target, into: []mut u8 } -> !render::Size = gpu::read_target
        let free_target: fn{ mut dev: gpu::Device, t: render::Target } = gpu::free_target

        let submit: fn{ mut dev: gpu::Device, frame: *render::Frame } -> ! = gpu::submit
        let present: fn{ mut dev: gpu::Device, mut sdl: sdl::Sdl } = gpu::present
        let read_screen: fn{ mut dev: gpu::Device, into: []mut u8 } -> !render::Size = gpu::read_screen
        let close: fn{ mut dev: gpu::Device, mut sdl: sdl::Sdl } = gpu::close
    }
}
