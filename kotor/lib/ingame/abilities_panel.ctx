// Abilities (abilities.gui, menu 3): the leader's skills, Force powers and feats, one tab each, with
// the description of the chosen entry (docs/re/gui.md, "CSWGuiAbilities"). What the creature knows
// comes from `sheet::known_of` and its numbers from `sheet::read` (sheet_data.ctx); the names,
// icons and descriptions are skills.2da, spells.2da and feat.2da rows through dialog.tlk.
//
// A list row's `user` value is the 2DA row of its entry. The Powers and Feats tabs show the original's
// rows of icon cells, one chain of known powers or feats per row (gui cells.ctx, chargen
// power_cells.ctx and feat_cells.ctx), every cell plain until it has the focus; the focused cell is
// the entry described. The Powers tab is hidden for a character with no Force class, and the tab
// shown is kept between openings (as the original keeps it).
namespace abilities_panel {
    const TAB_SKILLS: i32 = 0
    const TAB_POWERS: i32 = 1
    const TAB_FEATS: i32 = 2
    const TAB_TAGS: [3][]u8 = ["BTN_SKILLS", "BTN_POWERS", "BTN_FEATS"]

    // The three info lines' captions (dialog.tlk): skills show the rank, the bonus from the key
    // attribute and feats, and the total; powers show the base cost, what the alignment adds or
    // takes off, and the cost per use.
    const STR_SKILL_RANK: u32 = 1579
    const STR_BONUS: u32 = 32129
    const STR_TOTAL_RANK: u32 = 41904
    const STR_BASE_COST: u32 = 37655
    const STR_DARK_SIDE: u32 = 41890
    const STR_LIGHT_SIDE: u32 = 41891
    const STR_COST_PER_USE: u32 = 41905

    const INFO_TAGS: [7][]u8 = ["LBL_INFOBG", "LBL_SKILLRANK", "LBL_RANKVAL", "LBL_BONUS", "LBL_BONUSVAL", "LBL_TOTAL", "LBL_TOTALVAL"]

    struct State {
        opened: bool,
        tab: i32,                       // TAB_*
        who: u32,                       // the creature shown
        portrait: [4]i32,               // LBL_PORTRAIT as the file has it: x, y, w, h
        focus: [3]i64,                  // per tab, the entry that had the focus (-1 the first), kept across tab changes
    }

    fn new {} -> State { return State{ opened = false, tab = TAB_SKILLS, who = obj::INVALID, portrait = [0; 4], focus = [-1; 3] } }

    // The panel was just added or the leader changed: the rows are built afresh with the focus on
    // the first cell (SetCreature 0x006adb00).
    fn open { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32 } -> ! {
        s.focus = [-1; 3]
        try rebuild{ &s, &g, &w, &dev, panel }
    }

    // Fills the panel for the tab shown (RebuildList 0x006ad560), the tab's focus restored.
    fn rebuild { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32 } -> ! {
        if not s.opened { s.portrait = sheet::home_of{ &g, panel, tag = "LBL_PORTRAIT" } }
        s.opened = true
        s.who = party::leader{ w = &w }
        let known = sheet::known_of{ &w, id = s.who }
        let v = sheet::read{ &w, id = s.who, known }
        // Powers belong to Force users only.
        gui::set_visible{ &g, panel, tag = "BTN_POWERS", visible = v.force_user }
        if not v.force_user and s.tab == TAB_POWERS { s.tab = TAB_SKILLS }
        try sheet::show_picture{ &g, &w, &dev, panel, tag = "LBL_PORTRAIT", name = sheet::portrait_of{ w = &w, id = s.who }, home = s.portrait }

        // The tab that is showing is lit, the others are the menu blue.
        let mut k: usize = 0
        while k < 3 {
            let color = if @as(i32, k) == s.tab { gui::color_hilight{} } else { gui::color_menu{} }
            gui::set_text_color{ &g, panel, tag = TAB_TAGS[k], color }
            k = k + 1
        }
        // Feats have no numbers; skills and powers share the three info lines.
        k = 0
        while k < 7 {
            gui::set_visible{ &g, panel, tag = INFO_TAGS[k], visible = s.tab != TAB_FEATS }
            k = k + 1
        }
        if s.tab == TAB_SKILLS {
            try gui::set_strref{ &g, panel, tag = "LBL_SKILLRANK", strref = STR_SKILL_RANK }
            try gui::set_strref{ &g, panel, tag = "LBL_BONUS", strref = STR_BONUS }
            try gui::set_strref{ &g, panel, tag = "LBL_TOTAL", strref = STR_TOTAL_RANK }
        } else if s.tab == TAB_POWERS {
            try gui::set_strref{ &g, panel, tag = "LBL_SKILLRANK", strref = STR_BASE_COST }
            try gui::set_strref{ &g, panel, tag = "LBL_BONUS", strref = if v.light < 50 { STR_DARK_SIDE } else { STR_LIGHT_SIDE } }
            try gui::set_strref{ &g, panel, tag = "LBL_TOTAL", strref = STR_COST_PER_USE }
        }

        let mut first: i64 = -1
        if s.tab == TAB_SKILLS {
            gui::list_use_rows{ &g, panel, tag = "LB_ABILITY" }
            gui::list_clear{ &g, panel, tag = "LB_ABILITY" }
            first = try fill_rows{ &g, &w, &dev, panel, tab = s.tab, known }
            if first >= 0 { gui::list_select{ &g, panel, tag = "LB_ABILITY", row = 0 } }
        } else {
            first = try fill_cells{ &s, &g, &w, &dev, panel, known, v }
        }
        if first >= 0 {
            try show_detail{ &g, &w, panel, tab = s.tab, row = @as(usize, first), known, v }
        } else {
            try clear_detail{ &g, &w, panel }
        }
    }

    // The Powers or Feats tab's rows (0x006ce0f0 without its every-power flag, 0x006ce370), all
    // cells style 6 (0x006abce0), the focus on the tab's remembered entry or the first cell.
    // Returns the focused entry, -1 for an empty list.
    fn fill_cells { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, known: sheet::Known, v: sheet::Sheet } -> !i64 {
        let feats = s.tab == TAB_FEATS
        let t = sheet::table_of{ &w, name = if feats { "feat" } else { "spells" } } ifnull { return -1 }
        let mut chains: [chargen::MAX_FEAT_CHAINS]chargen::FeatChain
        let mut n: usize = 0
        if feats {
            n = chargen::build_known_feat_chains{ tables = w.rules, known = known.feats[..known.nfeats], out = &chains }
        } else {
            // A power past a row's first cell shows only while the Force points cover its cost
            // (0x005a6e70: HasEnoughForcePoints). A character the rules do not run (one known only
            // from its blueprint) has the pool and the cost per use the sheet shows.
            let mut usable: [96]u16
            let mut nu: usize = 0
            let f = hud::ruled_of{ w = &w, id = s.who }
            let mut i: usize = 0
            while i < known.npowers {
                let spell = @as(i32, known.powers[i])
                let ok = if f is some{ value = fr } { rules::has_enough_force_points{ tables = w.rules, c = &fr.c, spell } } else { blueprint_can_afford{ &w, t, spell, v } }
                if ok {
                    usable[nu] = known.powers[i]
                    nu = nu + 1
                }
                i = i + 1
            }
            n = chargen::build_power_chains{ tables = w.rules, all = false, known = known.powers[..known.npowers], usable = usable[..nu], out = &chains }
        }
        try chargen::fill_chain_cells{ &g, fs = &w.fs, &dev, panel, tag = "LB_ABILITY", t, column = if feats { "icon" } else { "iconresref" }, chains = chains[..n] }
        gui::list_set_cell_styles{ &g, panel, tag = "LB_ABILITY", style = gui::CELL_PLAIN }
        if n == 0 { return -1 }
        let want = s.focus[@as(usize, s.tab)]
        if want < 0 or not gui::list_focus_cell{ &g, panel, tag = "LB_ABILITY", user = want } {
            _ = gui::list_focus_cell{ &g, panel, tag = "LB_ABILITY", user = @as(i64, chains[0].cell[0]) }
        }
        return gui::list_focused_cell{ &g, panel, tag = "LB_ABILITY" }
    }

    // One list row: the entry's name and icon; `user` is its 2DA row.
    fn add_row { mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, name: []u8, icon: []u8, user: i64 } -> ! {
        let row = try gui::list_add{ &g, panel, tag = "LB_ABILITY", text = name, user }
        let img = gui::resolve_img{ &g, fs = &w.fs, &dev, name = icon }
        if img.ok { gui::list_set_icon{ &g, panel, tag = "LB_ABILITY", row, texture = img.tex, w = img.w, h = img.h } }
    }

    // The tab's list: every skill, or the feats or Force powers the creature knows. Returns the 2DA
    // row of the first entry, -1 for an empty list.
    fn fill_rows { mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, tab: i32, known: sheet::Known } -> !i64 {
        let mut first: i64 = -1
        if tab == TAB_SKILLS {
            let t = sheet::table_of{ &w, name = "skills" } ifnull { return first }
            let mut row: usize = 0
            while row < sheet::SKILLS and row < twoda::rows{ t } {
                let name = sheet::tlk_text{ w = &w, strref = @as(u32, twoda::get_int{ t, row, column = "name" } ifnull 0) }
                try add_row{ &g, &w, &dev, panel, name, icon = twoda::get_string{ t, row, column = "icon" } ifnull "", user = @as(i64, row) }
                if first < 0 { first = @as(i64, row) }
                row = row + 1
            }
        } else {
            let feats = tab == TAB_FEATS
            let t = sheet::table_of{ &w, name = if feats { "feat" } else { "spells" } } ifnull { return first }
            let count = if feats { known.nfeats } else { known.npowers }
            let mut i: usize = 0
            while i < count {
                let row = @as(usize, if feats { known.feats[i] } else { known.powers[i] })
                i = i + 1
                let name = sheet::tlk_text{ w = &w, strref = @as(u32, twoda::get_int{ t, row, column = "name" } ifnull 0) }
                // Rows with no name are the table's unused slots.
                if name.len == 0 { continue }
                let icon = twoda::get_string{ t, row, column = if feats { "icon" } else { "iconresref" } } ifnull ""
                try add_row{ &g, &w, &dev, panel, name, icon, user = @as(i64, row) }
                if first < 0 { first = @as(i64, row) }
            }
        }
        return first
    }

    // Nothing is chosen (an empty list): the detail side is blank.
    fn clear_detail { mut g: gui::Gui, mut w: world::World, panel: u32 } -> ! {
        let mut b = sheet::new_text{ w = &w }
        defer utf8::free{ &b }
        try sheet::say{ &g, &b, panel, tag = "LBL_NAME", text = "" }
        try sheet::say{ &g, &b, panel, tag = "LBL_RANKVAL", text = "" }
        try sheet::say{ &g, &b, panel, tag = "LBL_BONUSVAL", text = "" }
        try sheet::say{ &g, &b, panel, tag = "LBL_TOTALVAL", text = "" }
        try gui::set_list_text{ &g, panel, tag = "LB_DESC", text = "" }
    }

    // The chosen entry: its name over the description, and its numbers in the info lines.
    fn show_detail { mut g: gui::Gui, mut w: world::World, panel: u32, tab: i32, row: usize, known: sheet::Known, v: sheet::Sheet } -> ! {
        let mut b = sheet::new_text{ w = &w }
        defer utf8::free{ &b }
        if tab == TAB_SKILLS {
            let t = sheet::table_of{ &w, name = "skills" } ifnull { return }
            try sheet::say{ &g, &b, panel, tag = "LBL_NAME", text = sheet::tlk_text{ w = &w, strref = strref_of{ t, row, column = "name" } } }
            try gui::set_list_text{ &g, panel, tag = "LB_DESC", text = sheet::tlk_text{ w = &w, strref = strref_of{ t, row, column = "description" } } }
            let rank = known.skill_rank[row]
            let total = sheet::skill_total{ skills = t, k = known, abil_mod = v.abil_mod, skill = row }
            try sheet::say_num{ &g, &b, panel, tag = "LBL_RANKVAL", n = rank }
            try sheet::say_signed{ &g, &b, panel, tag = "LBL_BONUSVAL", n = total - rank }
            try sheet::say_num{ &g, &b, panel, tag = "LBL_TOTALVAL", n = total }
        } else if tab == TAB_FEATS {
            let t = sheet::table_of{ &w, name = "feat" } ifnull { return }
            try sheet::say{ &g, &b, panel, tag = "LBL_NAME", text = sheet::tlk_text{ w = &w, strref = strref_of{ t, row, column = "name" } } }
            try gui::set_list_text{ &g, panel, tag = "LB_DESC", text = sheet::tlk_text{ w = &w, strref = strref_of{ t, row, column = "description" } } }
        } else {
            let t = sheet::table_of{ &w, name = "spells" } ifnull { return }
            try sheet::say{ &g, &b, panel, tag = "LBL_NAME", text = sheet::tlk_text{ w = &w, strref = strref_of{ t, row, column = "name" } } }
            try gui::set_list_text{ &g, panel, tag = "LB_DESC", text = sheet::tlk_text{ w = &w, strref = strref_of{ t, row, column = "spelldesc" } } }
            let base = twoda::get_int{ t, row, column = "forcepoints" } ifnull 0
            let kind = twoda::get_string{ t, row, column = "goodevil" } ifnull "-"
            let cost = power_cost{ &w, base, kind, light = v.light }
            try sheet::say_num{ &g, &b, panel, tag = "LBL_RANKVAL", n = base }
            try sheet::say_signed{ &g, &b, panel, tag = "LBL_BONUSVAL", n = cost - base }
            try sheet::say_num{ &g, &b, panel, tag = "LBL_TOTALVAL", n = cost }
        }
    }

    fn strref_of { t: twoda::Table, row: usize, column: []u8 } -> u32 {
        return @as(u32, twoda::get_int{ t, row, column } ifnull 0)
    }

    // Whether the sheet's Force points cover a use of `spell` (spells.2da `forcepoints` with the
    // alignment's forceadjust multiplier), for a character with no rules state.
    fn blueprint_can_afford { mut w: world::World, t: twoda::Table, spell: i32, v: sheet::Sheet } -> bool {
        let row = @as(usize, spell)
        let base = twoda::get_int{ t, row, column = "forcepoints" } ifnull 0
        let kind = twoda::get_string{ t, row, column = "goodevil" } ifnull "-"
        return v.fp >= power_cost{ &w, base, kind, light = v.light }
    }

    // What a use of the power costs the player (rules.md 3.2): the base cost times forceadjust.2da's
    // multiplier for the alignment row (good_evil / 10), `goodcost` for a light power ('G'),
    // `evilcost` for a dark one ('E'), truncated.
    fn power_cost { mut w: world::World, base: i32, kind: []u8, light: i32 } -> i32 {
        if kind.len == 0 or (kind[0] != 'G' and kind[0] != 'E') { return base }
        let t = sheet::table_of{ &w, name = "forceadjust" } ifnull { return base }
        let row = @as(usize, if light < 0 { 0 } else { light / 10 })
        let mult = twoda::get_float{ t, row, column = if kind[0] == 'G' { "goodcost" } else { "evilcost" } } ifnull 1.0
        return @as(i32, @as(f32, base) * mult)
    }

    // Every frame while the panel is shown.
    fn update { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, dt: f32 } {
    }

    // One of the panel's GUI events (BTN_EXIT, Escape and the BTN_CHANGE buttons are the
    // framework's). True when it used the event.
    fn on_event { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, ev: gui::Event } -> bool {
        if ev.kind == gui::EventKind::activate {
            let mut k: usize = 0
            while k < 3 {
                if slice::eq_bytes{ a = ev.tag, b = TAB_TAGS[k] } {
                    s.tab = @as(i32, k)
                    rebuild{ &s, &g, &w, &dev, panel } iferr err{ error } { _ = @fmt(&w.io, "kotor: abilities: {}\n", error) }
                    return true
                }
                k = k + 1
            }
            if slice::eq_bytes{ a = ev.tag, b = "BTN_CHARLEFT" } or slice::eq_bytes{ a = ev.tag, b = "BTN_CHARRIGHT" } {
                // The previous or the next party member becomes the leader and their abilities show.
                let count = party::members{ w = &w }.len
                if count < 2 { return true }
                ingame::change_leader{ &w, step = if slice::eq_bytes{ a = ev.tag, b = "BTN_CHARRIGHT" } { 1 } else { count - 1 } }
                ingame::fill_change_buttons{ &g, &w, &dev, panel }
                open{ &s, &g, &w, &dev, panel } iferr err{ error } { _ = @fmt(&w.io, "kotor: abilities: {}\n", error) }
                return true
            }
            return false
        }
        if ev.kind == gui::EventKind::row_selected and slice::eq_bytes{ a = ev.tag, b = "LB_ABILITY" } {
            if ev.user < 0 { return true }
            if s.tab != TAB_SKILLS { s.focus[@as(usize, s.tab)] = ev.user }
            let known = sheet::known_of{ &w, id = s.who }
            let v = sheet::read{ &w, id = s.who, known }
            show_detail{ &g, &w, panel, tab = s.tab, row = @as(usize, ev.user), known, v } iferr err{ error } {
                _ = @fmt(&w.io, "kotor: abilities: {}\n", error)
            }
            return true
        }
        return false
    }

    // The panel is going away.
    fn close { mut s: State, mut g: gui::Gui, mut w: world::World, panel: u32 } {
        s.opened = false
    }
}
