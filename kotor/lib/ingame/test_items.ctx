// Headless test commands for the equipment and inventory panels: `FRAME ui COMMAND ARGS` lines the
// input script does not know (lib/ingame/script.ctx) come here. The player of end_m01aa carries
// almost nothing, so these fill the leader's hands and bag to show a full panel.
//
//   FRAME ui giveitem RESREF [COUNT] [equip]   a UTI template into the leader's inventory (a stack
//                                              of COUNT); `equip` puts it on in the first slot it fits
//   FRAME ui stock                              a spread of weapons, armour, gear, medpacs and grenades
//                                              (one blaster pistol and a suit of armour are put on)
//   FRAME ui unequip SLOT                       takes off the item in equipment index SLOT (0..17)
//   FRAME ui race N                             the leader's race (5 droid, 6 human): the droid slots
//   FRAME ui combat 0|1                         the leader in combat (armour cannot be changed then)
//   FRAME ui credits N                          the leader's credits
//   FRAME ui inv                                prints what the leader wears and carries
//   FRAME ui movectl TAG [ROW]                  the pointer to the centre of the shown control with that tag (of the
//                                              list box's row ROW), as a mouse move event
//   FRAME ui clickctl TAG [ROW]                 the same, then press and release the left button there: the click a
//                                              player makes, with the panels' own hit test deciding what it hits
//   FRAME ui ctl TAG                            prints where the control is (GUI pixels) and whether it is shown
namespace test_items {
    const STOCK: [22][]u8 = [
        "g_w_blstrpstl001", "g_w_blstrpstl002", "g_w_hvyblstr01", "g_w_blstrrfl001", "g_w_stunbaton01", "g_w_qtrstaff01",
        "g_w_vbroswrd01", "g_w_lghtsbr01", "g_a_class4001", "g_a_class5001", "g_a_jedirobe01", "g_i_mask01",
        "g_i_gauntlet01", "g_i_frarmbnds01", "g_i_belt001", "g_i_implant101", "g_i_medeqpmnt01", "g_i_adrnaline001",
        "g_w_fraggren01", "g_i_datapad001", "g_i_pltuseitm01", "g_i_drdshld001",
    ]

    fn run { mut ui: ingame::Ingame, mut w: world::World, mut dev: gpu::Device, cmd: []u8, args: []u8 } -> bool {
        let leader = party::leader{ w = &w }
        if ci::eq{ a = cmd, b = "giveitem" } {
            let mut words = text::words{ s = args }
            let name = text::next_word{ &words } ifnull { return true }
            let mut count: i32 = 1
            let mut equip = false
            while true {
                let word = text::next_word{ &words } ifnull { break }
                if ci::eq{ a = word, b = "equip" } { equip = true } else { count = @as(i32, text::scan_decimal{ s = word }) }
            }
            give{ &w, leader, name, count, equip }
        } else if ci::eq{ a = cmd, b = "stock" } {
            let mut k: usize = 0
            while k < STOCK.len {
                let stack: i32 = if k == 16 or k == 17 { 5 } else if k == 18 { 4 } else { 1 }
                give{ &w, leader, name = STOCK[k], count = stack, equip = k == 0 or k == 8 }
                k = k + 1
            }
        } else if ci::eq{ a = cmd, b = "unequip" } {
            let slot = @as(usize, text::scan_decimal{ s = args })
            if slot < obj::EQUIP_SLOTS { _ = items::unequip{ &w, who = leader, index = slot } }
        } else if ci::eq{ a = cmd, b = "race" } {
            if hud::creature_of{ w = &w, id = leader } is some{ value = c } { c.race = @trunc(u32, text::scan_decimal{ s = args }) }
        } else if ci::eq{ a = cmd, b = "combat" } {
            if hud::creature_of{ w = &w, id = leader } is some{ value = c } { c.in_combat = text::scan_decimal{ s = args } != 0 }
        } else if ci::eq{ a = cmd, b = "credits" } {
            if hud::creature_of{ w = &w, id = leader } is some{ value = c } { c.gold = @trunc(u32, text::scan_decimal{ s = args }) }
        } else if ci::eq{ a = cmd, b = "inv" } {
            dump{ &w, leader }
        } else if ci::eq{ a = cmd, b = "faction" } {
            // `ui faction TAG N`: the creature joins a standard faction (1 hostile, 2 friendly, 5 neutral), so a
            // test can have a hostile where the story has none.
            let mut words = text::words{ s = args }
            let tag = text::next_word{ &words } ifnull { return true }
            let n = @as(u32, text::scan_decimal{ s = text::next_word{ &words } ifnull "1" })
            let o = world::object{ w = &w, id = world::object_by_tag{ w = &w, tag, nth = 0 } } ifnull { return true }
            o.faction = n
        } else if ci::eq{ a = cmd, b = "log" } {
            // The HUD's message log, oldest line first (`ui log N`: only the last N).
            let n = hud::log_count{ log = &ui.log }
            let want = @as(usize, text::scan_decimal{ s = args })
            let from = if want > 0 and want < n { n - want } else { 0 }
            let mut i = from
            while i < n {
                _ = @fmt(&w.io, "log: {}\n", hud::log_text{ log = &ui.log, i })
                i = i + 1
            }
        } else if ci::eq{ a = cmd, b = "fx" } {
            // The effects on the creature with the tag (the leader when none is given): kind, how long it
            // lasts, the first parameters, whose it is and from which power, and when it ends.
            let tag = text::first_word{ s = args }
            let id = if tag.len == 0 { leader } else { world::object_by_tag{ w = &w, tag, nth = 0 } }
            let o = world::object{ w = &w, id } ifnull { return true }
            let f = fight::of{ o } ifnull { return true }
            _ = @fmt(&w.io, "fx {}: {} effects\n", o.tag, f.c.nfx)
            let now = clock::now_ms{ c = w.clock }
            let mut k: usize = 0
            while k < @as(usize, f.c.nfx) {
                let e = f.c.fx[k]
                k = k + 1
                _ = @fmt(&w.io, "  fx kind {} dur {} sub {} seconds {} ints {} {} {} {} creator {} spell {} (now {} ms)\n", e.kind, e.dur, e.sub, e.duration, e.ints[0], e.ints[1], e.ints[2], e.ints[3], e.creator, e.spell_id, now)
            }
        } else if ci::eq{ a = cmd, b = "movectl" } or ci::eq{ a = cmd, b = "clickctl" } or ci::eq{ a = cmd, b = "ctl" } {
            let mut words = text::words{ s = args }
            let tag = text::next_word{ &words } ifnull { return true }
            let row = if text::next_word{ &words } is some{ value = n } { @as(i32, text::scan_decimal{ s = n }) } else { -1 }
            point_at{ &ui, &w, &dev, tag, row, click = ci::eq{ a = cmd, b = "clickctl" }, print = ci::eq{ a = cmd, b = "ctl" } }
        } else {
            return false
        }
        return true
    }

    // Moves the pointer to the centre of the control tagged `tag` in the topmost shown panel that has it
    // (of its row `row`, when a list box and row >= 0), and clicks when asked. The events are the
    // platform's own (motion, then the button), so the hit test is the panels'.
    fn point_at { mut ui: ingame::Ingame, mut w: world::World, mut dev: gpu::Device, tag: []u8, row: i32, click: bool, print: bool } {
        let ps = list::items{ list = ui.gui.panels }
        let mut i: usize = ps.len
        while i > 0 {
            i = i - 1
            let p = ps[i]
            if not p.shown or p.removing { continue }
            let found = gui::find_by_tag{ p, tag }
            if found < 0 { continue }
            let c = list::at{ list = p.controls, i = @as(usize, found) }
            let mut x = p.sx + c.x + c.w / 2
            let mut y = p.sy + c.y + c.h / 2
            if row >= 0 {
                let r = gui::row_rect{ g = &ui.gui, panel = p.id, tag, row } ifnull {
                    _ = @fmt(&w.io, "ctl: {} row {} is not visible\n", tag, row)
                    return
                }
                x = @as(i32, r.x + r.w / 2.0)
                y = @as(i32, r.y + r.h / 2.0)
            }
            if print {
                _ = @fmt(&w.io, "ctl: {} in {} at {} {} size {} {} centre {} {} visible {} rows {}\n", tag, resref::bytes{ r = &p.name }, p.sx + c.x, p.sy + c.y, c.w, c.h, x, y, (c.flags & gui::F_VISIBLE) != 0, c.row_count)
                return
            }
            let wx = @as(i32, @as(f32, x) * ui.gui.scale)
            let wy = @as(i32, @as(f32, y) * ui.gui.scale)
            ingame::send{ &ui, &w, &dev, ev = sdl::Event::mouse_motion{ x = wx, y = wy, dx = 0, dy = 0, buttons = 0 } }
            if click {
                ingame::send{ &ui, &w, &dev, ev = sdl::Event::mouse_button{ down = true, button = sdl::BUTTON_LEFT, clicks = 1, x = wx, y = wy } }
                ingame::send{ &ui, &w, &dev, ev = sdl::Event::mouse_button{ down = false, button = sdl::BUTTON_LEFT, clicks = 1, x = wx, y = wy } }
            }
            return
        }
        _ = @fmt(&w.io, "ctl: no shown control {}\n", tag)
    }

    // One template into the leader's bag, and on when asked.
    fn give { mut w: world::World, leader: u32, name: []u8, count: i32, equip: bool } {
        let id = rt_item::create_item{ &w, template = name, target = items::bag_holder{ w = &w, who = leader }, stack = count }
        if id == obj::INVALID {
            _ = @fmt(&w.io, "giveitem {}: nothing made\n", name)
            return
        }
        if not equip { return }
        let mask = items::equipable_slots{ w = &w, id }
        let mut index: usize = 0
        while index < obj::EQUIP_SLOTS {
            if (mask & items::mask_of{ index }) != 0 and items::slot_button{ index } < items::SLOTS {
                // The right hand before the left, as the server does.
                if index == obj::SLOT_LEFT_WEAPON and (mask & items::mask_of{ index = obj::SLOT_RIGHT_WEAPON }) != 0 {
                    index = index + 1
                    continue
                }
                let swap = items::equip{ &w, who = leader, item = id, index }
                if swap.equipped != obj::INVALID { return }
            }
            index = index + 1
        }
    }

    fn dump { mut w: world::World, leader: u32 } {
        let c = hud::creature_of{ w = &w, id = leader } ifnull { return }
        _ = @fmt(&w.io, "leader {} {} race {} gold {} portrait {}\n", leader, hud::name_of{ w = &w, id = leader }, c.race, c.gold, hud::portrait_of{ w = &w, id = leader })
        let members = party::members{ w = &w }
        let mut m: usize = 1
        while m < members.len {
            _ = @fmt(&w.io, "member {} {} portrait {}\n", members[m], hud::name_of{ w = &w, id = members[m] }, hud::portrait_of{ w = &w, id = members[m] })
            m = m + 1
        }
        let mut slot: usize = 0
        while slot < obj::EQUIP_SLOTS {
            let id = c.equipped[slot]
            slot = slot + 1
            if id == obj::INVALID { continue }
            _ = @fmt(&w.io, "  worn {}: {} {}\n", slot - 1, id, items::name_of{ w = &w, id })
        }
        let ids = items::bag_of{ w = &w, id = items::bag_holder{ w = &w, who = leader } }
        let mut k: usize = 0
        while k < ids.len {
            let id = ids[k]
            k = k + 1
            let o = world::object{ w = &w, id } ifnull {
                _ = @fmt(&w.io, "  carried {}: no such object\n", id)
                continue
            }
            _ = @fmt(&w.io, "  carried {} {} x{} tag {}\n", id, items::name_of{ w = &w, id }, items::stack_of{ w = &w, id }, o.tag)
        }
    }
}
