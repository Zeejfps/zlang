// Headless test commands for the equipment and inventory panels: `FRAME ui COMMAND ARGS` lines the
// input script does not know (lib/ingame/script.ctx) come here. The player of end_m01aa carries
// almost nothing, so these fill the leader's hands and bag to show a full panel.
//
//   FRAME ui giveitem RESREF [COUNT] [equip]   a UTI template into the leader's inventory (a stack
//                                              of COUNT); `equip` puts it on in the first slot it fits
//   FRAME ui stock                              a spread of weapons, armour, gear, medpacs and grenades
//                                              (one blaster pistol and a suit of armour are put on)
//   FRAME ui unequip SLOT                       takes off the item in equipment index SLOT (0..17)
//   FRAME ui race N                             the leader's race (5 droid, 6 human): the droid slots
//   FRAME ui combat 0|1                         the leader in combat (armour cannot be changed then)
//   FRAME ui credits N                          the leader's credits
//   FRAME ui inv                                prints what the leader wears and carries
namespace test_items {
    const STOCK: [22][]u8 = [
        "g_w_blstrpstl001", "g_w_blstrpstl002", "g_w_hvyblstr01", "g_w_blstrrfl001", "g_w_stunbaton01", "g_w_qtrstaff01",
        "g_w_vbroswrd01", "g_w_lghtsbr01", "g_a_class4001", "g_a_class5001", "g_a_jedirobe01", "g_i_mask01",
        "g_i_gauntlet01", "g_i_frarmbnds01", "g_i_belt001", "g_i_implant101", "g_i_medeqpmnt01", "g_i_adrnaline001",
        "g_w_fraggren01", "g_i_datapad001", "g_i_pltuseitm01", "g_i_drdshld001",
    ]

    fn run { mut ui: ingame::Ingame, mut w: world::World, mut dev: gpu::Device, cmd: []u8, args: []u8 } -> bool {
        let leader = party::leader{ w = &w }
        if ci::eq{ a = cmd, b = "giveitem" } {
            let mut words = text::words{ s = args }
            let name = text::next_word{ &words } ifnull { return true }
            let mut count: i32 = 1
            let mut equip = false
            while true {
                let word = text::next_word{ &words } ifnull { break }
                if ci::eq{ a = word, b = "equip" } { equip = true } else { count = @as(i32, text::scan_decimal{ s = word }) }
            }
            give{ &w, leader, name, count, equip }
        } else if ci::eq{ a = cmd, b = "stock" } {
            let mut k: usize = 0
            while k < STOCK.len {
                let stack: i32 = if k == 16 or k == 17 { 5 } else if k == 18 { 4 } else { 1 }
                give{ &w, leader, name = STOCK[k], count = stack, equip = k == 0 or k == 8 }
                k = k + 1
            }
        } else if ci::eq{ a = cmd, b = "unequip" } {
            let slot = @as(usize, text::scan_decimal{ s = args })
            if slot < obj::EQUIP_SLOTS { _ = items::unequip{ &w, who = leader, index = slot } }
        } else if ci::eq{ a = cmd, b = "race" } {
            if hud::creature_of{ w = &w, id = leader } is some{ value = c } { c.race = @trunc(u32, text::scan_decimal{ s = args }) }
        } else if ci::eq{ a = cmd, b = "combat" } {
            if hud::creature_of{ w = &w, id = leader } is some{ value = c } { c.in_combat = text::scan_decimal{ s = args } != 0 }
        } else if ci::eq{ a = cmd, b = "credits" } {
            if hud::creature_of{ w = &w, id = leader } is some{ value = c } { c.gold = @trunc(u32, text::scan_decimal{ s = args }) }
        } else if ci::eq{ a = cmd, b = "inv" } {
            dump{ &w, leader }
        } else {
            return false
        }
        return true
    }

    // One template into the leader's bag, and on when asked.
    fn give { mut w: world::World, leader: u32, name: []u8, count: i32, equip: bool } {
        let id = rt_item::create_item{ &w, template = name, target = items::bag_holder{ w = &w, who = leader }, stack = count }
        if id == obj::INVALID {
            _ = @fmt(&w.io, "giveitem {}: nothing made\n", name)
            return
        }
        if not equip { return }
        let mask = items::equipable_slots{ w = &w, id }
        let mut index: usize = 0
        while index < obj::EQUIP_SLOTS {
            if (mask & items::mask_of{ index }) != 0 and items::slot_button{ index } < items::SLOTS {
                // The right hand before the left, as the server does.
                if index == obj::SLOT_LEFT_WEAPON and (mask & items::mask_of{ index = obj::SLOT_RIGHT_WEAPON }) != 0 {
                    index = index + 1
                    continue
                }
                let swap = items::equip{ &w, who = leader, item = id, index }
                if swap.equipped != obj::INVALID { return }
            }
            index = index + 1
        }
    }

    fn dump { mut w: world::World, leader: u32 } {
        let c = hud::creature_of{ w = &w, id = leader } ifnull { return }
        _ = @fmt(&w.io, "leader {} {} race {} gold {}\n", leader, hud::name_of{ w = &w, id = leader }, c.race, c.gold)
        let mut slot: usize = 0
        while slot < obj::EQUIP_SLOTS {
            let id = c.equipped[slot]
            slot = slot + 1
            if id == obj::INVALID { continue }
            _ = @fmt(&w.io, "  worn {}: {} {}\n", slot - 1, id, items::name_of{ w = &w, id })
        }
        let ids = items::bag_of{ w = &w, id = items::bag_holder{ w = &w, who = leader } }
        let mut k: usize = 0
        while k < ids.len {
            let o = world::object{ w = &w, id = ids[k] } ifnull { continue }
            _ = @fmt(&w.io, "  carried {} {} x{} tag {}\n", ids[k], items::name_of{ w = &w, id = ids[k] }, items::stack_of{ w = &w, id = ids[k] }, o.tag)
            k = k + 1
        }
    }
}
