// Headless test commands for the map, party selection and options panels (called for any
// `FRAME ui COMMAND ARGS` line script.ctx does not know). They give the panels something the game
// does not have yet.
//
//   FRAME ui note X Y TEXT...    a waypoint with an enabled map note at world (X, Y), at the leader's height
//   FRAME ui avail N [N...]      party table slots (0 Bastila, 1 Canderous, 2 Carth, 3 HK-47, 4 Jolee,
//                                5 Juhani, 6 Mission, 7 T3-M4, 8 Zaalbar) made available and selectable;
//                                `avail none` clears them all
//   FRAME ui where               prints the leader's position, the map's picture and where it falls in it
//   FRAME ui shove I DX DY       moves party member I (0 is the leader) by (DX, DY) metres
//   FRAME ui restrict N          the area's RestrictMode (non-zero refuses Party Selection)
//   FRAME ui str N               prints dialog.tlk string N
//
// Party Selection itself is reached through the map: `ui menu map`, then a click on the button.
namespace test_map {
    fn run { mut ui: ingame::Ingame, mut w: world::World, mut dev: gpu::Device, cmd: []u8, args: []u8 } -> bool {
        let mut words = text::words{ s = args }
        if ci::eq{ a = cmd, b = "note" } {
            let x = text::scan_f32{ s = text::next_word{ &words } ifnull "0" } ifnull 0.0
            let y = text::scan_f32{ s = text::next_word{ &words } ifnull "0" } ifnull 0.0
            add_note{ &w, x, y, text = text::rest{ words } }
            return true
        }
        if ci::eq{ a = cmd, b = "avail" } {
            let first = text::next_word{ &words } ifnull { return true }
            if ci::eq{ a = first, b = "none" } {
                w.party.available = [false; 12]
                w.party.selectable = [false; 12]
                return true
            }
            mark_available{ &w, word = first }
            while true {
                let word = text::next_word{ &words } ifnull { break }
                mark_available{ &w, word }
            }
            return true
        }
        if ci::eq{ a = cmd, b = "where" } {
            let lo = world::object{ w = &w, id = party::leader{ w = &w } } ifnull { return true }
            _ = @fmt(&w.io, "leader at {} {} {} facing {} {}\n", lo.position.x, lo.position.y, lo.position.z, lo.orientation.x, lo.orientation.y)
            let ids = party::members{ w = &w }
            let mut k: usize = 1
            while k < ids.len {
                let m = world::object{ w = &w, id = ids[k] }
                k = k + 1
                if m != null { _ = @fmt(&w.io, "member at {} {} {}\n", m.position.x, m.position.y, m.position.z) }
            }
            let info = hud::load_map{ g = &ui.gui, &w, &dev, area = w.area }
            if info.present {
                let at = hud::map_point{ info, x = lo.position.x, y = lo.position.y }
                _ = @fmt(&w.io, "map picture {} x {}, leader at {} {} (axis {})\n", info.picture.w, info.picture.h, at.x, at.y, info.axis)
            } else {
                _ = @fmt(&w.io, "no map for this area\n")
            }
            return true
        }
        if ci::eq{ a = cmd, b = "shove" } {
            let i = text::scan_int{ s = text::next_word{ &words } ifnull "0" } ifnull 0
            let dx = text::scan_f32{ s = text::next_word{ &words } ifnull "0" } ifnull 0.0
            let dy = text::scan_f32{ s = text::next_word{ &words } ifnull "0" } ifnull 0.0
            let ids = party::members{ w = &w }
            if i < 0 or @as(usize, i) >= ids.len { return true }
            let o = world::object{ w = &w, id = ids[@as(usize, i)] } ifnull { return true }
            o.position.x = o.position.x + dx
            o.position.y = o.position.y + dy
            return true
        }
        if ci::eq{ a = cmd, b = "restrict" } {
            let n = text::scan_int{ s = text::next_word{ &words } ifnull "0" } ifnull 0
            let ao = world::object{ w = &w, id = w.area } ifnull { return true }
            let a = obj::area{ o = ao } ifnull { return true }
            a.restrict_mode = @trunc(u32, n)
            return true
        }
        if ci::eq{ a = cmd, b = "str" } {
            let n = text::scan_int{ s = text::next_word{ &words } ifnull "0" } ifnull 0
            _ = @fmt(&w.io, "str {}: {}\n", n, world::string_by_strref{ w = &w, strref = @trunc(u32, n) })
            return true
        }
        return false
    }

    fn mark_available { mut w: world::World, word: []u8 } {
        let n = text::scan_int{ s = word } ifnull -1
        if n < 0 or n >= 9 { return }
        w.party.available[@as(usize, n)] = true
        w.party.selectable[@as(usize, n)] = true
        // The blueprint the party screen spawns the companion from (AddAvailableNPCByTemplate keeps it).
        if resref::is_empty{ r = w.party.templates[@as(usize, n)] } {
            w.party.templates[@as(usize, n)] = resref::truncate{ name = partysel_panel::TEMPLATES[@as(usize, n)] }
        }
    }

    // A waypoint with a map note at (x, y) in the current area.
    fn add_note { mut w: world::World, x: f32, y: f32, text: []u8 } {
        let lo = world::object{ w = &w, id = party::leader{ w = &w } }
        let z = if lo != null { lo.position.z } else { 0.0 }
        let o = world::add_object{ &w, kind = obj::Kind::waypoint, id = 0, character = false } iferr { return }
        o.area = w.area
        o.position = math::Vec3{ x, y, z }
        let wp = obj::waypoint{ o } ifnull { return }
        wp.has_map_note = true
        wp.map_note_enabled = true
        world::set_name{ &w, name = &wp.map_note, strref = 0xFFFFFFFF, text } iferr {}
    }
}
