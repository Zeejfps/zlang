// The HUD's four self action slots (docs/re/gui.md, "Action menus"): at the bottom right the
// leader's own actions, each a button with the icon of the selected entry, arrows to cycle the
// entries, and the slot's tooltip. In order: a friendly Force power, a medical item, another
// usable item, a mine. A click does the selected entry on the leader.
//
// What the RE settles: the slot controls, the cycling, the dimmed icon of an entry that cannot be
// used now (alpha 0.25), the refusal messages with their reason codes (shown for 5 seconds in the
// combat message bar), the description of the hovered slot's entry in LBL_ACTIONDESC, the
// request being the leader's own and replacing its queued actions, and the blink. What it does not
// (UpdateActionMenus, 0x00689d80, is read for its frame only): which powers and items make up
// each list. The rules here are ours, from the data:
//   - powers: the leader's known Force powers (spells.2da usertype 1) that are not hostile
//     (hostilesetting 0) and are cast at touch or personal range (range T or P), by row;
//   - medical: carried items with a CastSpell ability on the user (touch or personal range)
//     whose base item is medical (itemtype 45), droid repair (26) or a squad recovery kit (47);
//   - items: the other carried items with such an ability the leader can use (stims, shields);
//     grenades and the like (range L, M) are the target block's, not these;
//   - mines: the original's rule (0x00616520): trap kits (itemtype 28 with a Trap property) for a
//     leader who can use Demolitions, named "<kit> (self)"; a click lays one (traps::lay_mine).
// An entry shows dimmed with its reason when the leader cannot use it now: not enough Force
// points, armour or a weapon the power forbids, a medical item at full vitality, a recovery kit
// with the party unhurt, the leader dead.
namespace selfslots {
    const SLOTS: usize = 4
    const MAX: usize = 12
    // How often the lists are rebuilt (seconds): the original rebuilds every frame, the screen only
    // changes when the bag or the leader does.
    const REBUILD: f32 = 0.2
    const MESSAGE_SECONDS: f32 = 5.0
    // A use makes the icon dip to nothing and come back over two tenths of a second (UpdateBlink, 0x006858e0).
    const BLINK_SECONDS: f32 = 0.2

    // Why an entry cannot be used now (the original's reason codes).
    const R_OK: i32 = 0
    const R_FORCE: i32 = 1
    const R_ARMOR: i32 = 2
    const R_ITEM: i32 = 3
    const R_FULL: i32 = 5
    const R_DEAD: i32 = 6

    // dialog.tlk: the slots' tooltips and the reasons' messages, by index.
    const TIPS: [4]u32 = [48486, 48291, 48299, 48295]
    const REASON_TEXT: [7]u32 = [0, 38613, 38614, 38615, 42422, 42498, 47936]

    const TYPE_REPAIR_KIT: i32 = 26
    const TYPE_STIM: i32 = 25
    const TYPE_MEDPAC: i32 = 45
    const TYPE_RECOVERY_KIT: i32 = 47

    // One choice: a power (spells.2da row in `id`, icon from the table) or an item (its object id).
    struct Entry { id: u32, icon: [24]u8, icon_len: usize, strref: u32, usable: bool, reason: i32 }

    struct Slot {
        entries: [12]Entry,
        count: usize,
        selected: u32,              // the id of the chosen entry, kept when the list is rebuilt
        sig: u32,                   // what the controls show now
    }

    struct State {
        slots: [4]Slot,
        wait: f32,                  // seconds to the next rebuild
        message: f32,               // seconds the refusal stays up
        blink: [4]f32,              // seconds left of each slot's blink
        hover: i32,                 // the slot under the pointer, -1 none
        shown_leader: u32,
        labelled: bool,             // the description label shows one of these slots' entries
        queued: bool,               // a choice was used in combat mode: an auto-pause banner says "Action added to queue." (ingame)
    }

    fn empty_entry {} -> Entry {
        return Entry{ id = obj::INVALID, icon = [0; 24], icon_len = 0, strref = 0, usable = false, reason = R_OK }
    }

    fn empty_slot {} -> Slot {
        return Slot{ entries = [empty_entry{}; 12], count = 0, selected = obj::INVALID, sig = 0 }
    }

    fn new {} -> State {
        return State{ slots = [empty_slot{}; 4], wait = 0.0, message = 0.0, blink = [0.0; 4], hover = -1, shown_leader = obj::INVALID, labelled = false, queued = false }
    }

    // ---- the lists

    fn push { mut sl: Slot, id: u32, icon: []u8, strref: u32, usable: bool, reason: i32 } {
        if sl.count >= MAX { return }
        let mut e = empty_entry{}
        e.id = id
        let n = if icon.len > 24 { 24 } else { icon.len }
        slice::copy(u8){ dst = e.icon[..n], src = icon[..n] }
        e.icon_len = n
        e.strref = strref
        e.usable = usable
        e.reason = reason
        sl.entries[sl.count] = e
        sl.count = sl.count + 1
    }

    // Slot 0: the leader's friendly powers, one per friendly line (spells.2da ForceFriendly: Cure and
    // Heal, the three armour powers, the speeds, the valors, Force resistance and immunity, the energy
    // resistances), the known power of the line with the highest ForcePriority, the lines in order
    // (UpdateActionMenus' 0x00616230: the same pick as the target block's hostile lines).
    fn fill_powers { w: *world::World, leader: u32, mut out: [4]Slot } {
        let f = hud::ruled_of{ w, id = leader } ifnull { return }
        let alive = not hud::is_down{ w, id = leader }
        let t = w.tables.spells
        let rows = twoda::rows{ t }
        let mut best_row: [8]i32 = [-1; 8]
        let mut best_pri: [8]i32 = [-1; 8]
        let mut r: usize = 0
        while r < rows and r < 256 {
            let spell = @as(i32, r)
            r = r + 1
            if not rules::knows_power{ c = &f.c, spell } { continue }
            let row = rules::get_spell{ tables = w.rules, row = spell } ifnull { continue }
            if not row.valid or row.user_type != 1 or row.line_friendly < 0 or row.line_friendly >= 8 { continue }
            let line = @as(usize, row.line_friendly)
            if row.priority > best_pri[line] {
                best_pri[line] = row.priority
                best_row[line] = spell
            }
        }
        let mut line: usize = 0
        while line < 8 {
            let spell = best_row[line]
            line = line + 1
            if spell < 0 { continue }
            let row = rules::get_spell{ tables = w.rules, row = spell } ifnull { continue }
            let icon = twoda::get_string{ t, row = @as(usize, spell), column = "iconresref" } ifnull { continue }
            let reason = hud::power_reason{ w, f, spell, alive, dist2 = 1000000.0 }
            push{ sl = &out[0], id = @as(u32, spell), icon, strref = @as(u32, row.name), usable = reason == R_OK, reason }
        }
    }

    // Whether any party member has lost hit points.
    fn any_injured { w: *world::World } -> bool {
        let ids = party::members{ w }
        let mut k: usize = 0
        while k < ids.len {
            let v = hud::vitality_of{ w, id = ids[k] }
            if v.hp < v.hp_max { return true }
            k = k + 1
        }
        return false
    }

    // Which self slot lists the item for the leader, 0 for none: items::self_slot_of (the original's test).
    fn slot_of_item { mut w: world::World, leader: u32, id: u32, worn: bool } -> usize {
        return items::self_slot_of{ &w, who = leader, id, worn }
    }

    // One item's entry in its list, dimmed with the reason when the leader cannot use it now.
    fn add_item { mut w: world::World, leader: u32, id: u32, worn: bool, mut out: [4]Slot } {
        let k = slot_of_item{ &w, leader, id, worn }
        if k == 0 or k == 3 { return }          // the mine slot is fill_mines' (the trap kits)
        let kind = items::base_int{ w = &w, id, column = "itemtype", fallback = 0 }
        let alive = not hud::is_down{ w = &w, id = leader }
        let mut reason = R_OK
        if not alive { reason = R_DEAD }
        else if kind == TYPE_MEDPAC or kind == TYPE_REPAIR_KIT {
            let v = hud::vitality_of{ w = &w, id = leader }
            if v.hp >= v.hp_max { reason = R_FULL }
        } else if kind == TYPE_RECOVERY_KIT and not any_injured{ w = &w } { reason = R_FULL }
        let mut buf: [40]u8
        let icon = items::icon_name{ w = &w, id, into = buf[..] }
        push{ sl = &out[k], id, icon, strref = 0, usable = reason == R_OK, reason }
    }

    // Slots 1 and 2: the party's items with such an ability, and what the leader wears on the arms and belt.
    fn fill_items { mut w: world::World, leader: u32, mut out: [4]Slot } {
        let ids = list::items{ list = w.bag }
        let mut k: usize = 0
        while k < ids.len {
            let id = ids[k]
            k = k + 1
            if world::is_valid{ w = &w, id } { add_item{ &w, leader, id, worn = false, out = &out } }
        }
        if hud::creature_of{ w = &w, id = leader } is some{ value = c } {
            let cells: [3]usize = [obj::SLOT_LEFT_ARM, obj::SLOT_RIGHT_ARM, obj::SLOT_BELT]
            k = 0
            while k < cells.len {
                let id = c.equipped[cells[k]]
                k = k + 1
                if id != obj::INVALID and world::is_valid{ w = &w, id } { add_item{ &w, leader, id, worn = true, out = &out } }
            }
        }
    }

    // Slot 3: the trap kits in the bag (0x006197d0 with 0x00616520: itemtype 28 with a Trap property,
    // a leader who can use Demolitions and the item). Never dimmed: a kit that cannot be laid is not
    // listed.
    fn fill_mines { mut w: world::World, leader: u32, mut out: [4]Slot } {
        if not traps::can_use_demolitions{ w = &w, who = leader } { return }
        let ids = list::items{ list = w.bag }
        let mut k: usize = 0
        while k < ids.len {
            let id = ids[k]
            k = k + 1
            // (CanUseItem passes for every kit: none has a limiting property, and items::can_use wants a CastSpell one.)
            if not world::is_valid{ w = &w, id } or not traps::is_kit{ w = &w, item = id } { continue }
            let mut buf: [40]u8
            let icon = items::icon_name{ w = &w, id, into = buf[..] }
            push{ sl = &out[3], id, icon, strref = 0, usable = true, reason = R_OK }
        }
    }

    // What the four lists are now for the leader.
    fn build { mut w: world::World, leader: u32, mut out: [4]Slot } {
        out = [empty_slot{}; 4]
        fill_powers{ w = &w, leader, out = &out }
        fill_items{ &w, leader, out = &out }
        fill_mines{ &w, leader, out = &out }
    }

    // A number that changes when what a slot shows would.
    fn signature { sl: *Slot } -> u32 {
        let mut h: u32 = @wrap_add(2166136261, @as(u32, sl.count))
        let mut i: usize = 0
        while i < sl.count {
            let e = &sl.entries[i]
            i = i + 1
            h = @wrap_mul(h ^ e.id, 16777619)
            h = @wrap_mul(h ^ (if e.usable { 1 } else { 2 }), 16777619)
            h = @wrap_mul(h ^ @as(u32, e.reason), 16777619)
        }
        return h
    }

    fn index_of { sl: *Slot, id: u32 } -> usize {
        let mut i: usize = 0
        while i < sl.count {
            if sl.entries[i].id == id { return i }
            i = i + 1
        }
        return 0
    }

    // ---- the controls

    fn tag_for { into: []mut u8, prefix: []u8, k: usize } -> []u8 { return hud::tag_n{ into, prefix, n = k } }

    // Sets slot `k`'s controls from its list as CSWGuiActionSlot::SetState does (0x00689280, called for every
    // slot every frame by UpdateActionMenus): the frame and the icon are never hidden, the arrows show only
    // for more than one choice, and a slot with none is a blank frame drawn at half strength. A list with
    // choices puts the selected one's picture on the icon (dimmed when it cannot be used).
    fn show_slot { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, k: usize } {
        let mut buf: [24]u8
        let mut icon_buf: [24]u8
        let sl = &s.slots[k]
        let has = sl.count > 0
        gui::set_tooltip{ &g, panel, tag = tag_for{ into = buf[..], prefix = "BTN_ACTION", k }, text = world::string_by_strref{ w = &w, strref = TIPS[k] } } iferr {}
        let lbl = tag_for{ into = icon_buf[..], prefix = "LBL_ACTION", k }
        gui::set_frame_alpha{ &g, panel, tag = tag_for{ into = buf[..], prefix = "BTN_ACTION", k }, alpha = if has { 1.0 } else { 0.5 } }
        gui::set_visible{ &g, panel, tag = tag_for{ into = buf[..], prefix = "BTN_ACTIONUP", k }, visible = sl.count > 1 }
        gui::set_visible{ &g, panel, tag = tag_for{ into = buf[..], prefix = "BTN_ACTIONDOWN", k }, visible = sl.count > 1 }
        if not has {
            gui::clear_picture{ &g, panel, tag = lbl }
            return
        }
        let e = sl.entries[index_of{ sl, id = sl.selected }]
        let img = if k == 0 { gui::resolve_img{ &g, fs = &w.fs, &dev, name = e.icon[..e.icon_len] } } else { items::icon_of{ &g, &w, &dev, id = e.id } }
        if img.ok { gui::set_picture{ &g, panel, tag = lbl, texture = img.tex, w = img.w, h = img.h } } else { gui::clear_picture{ &g, panel, tag = lbl } }
        if gui::find_control{ &g, panel, tag = lbl } is some{ value = c } {
            c.border.tinted = not e.usable
            c.border.color = render::Color{ r = 1.0, g = 1.0, b = 1.0, a = 0.25 }
        }
    }

    // The selected entry's name, for the description under the slots.
    fn entry_name { mut w: world::World, k: usize, e: Entry } -> []u8 {
        if k == 0 { return world::string_by_strref{ w = &w, strref = e.strref } }
        return items::name_of{ w = &w, id = e.id }
    }

    fn show_description { mut s: State, mut g: gui::Gui, mut w: world::World, panel: u32 } {
        let k = s.hover
        let shown = k >= 0 and s.slots[@as(usize, k)].count > 0
        // The label is shared with the target block's slots: only take it down when it was ours.
        if not shown and not s.labelled { return }
        s.labelled = shown
        gui::set_visible{ &g, panel, tag = "LBL_ACTIONDESC", visible = shown }
        gui::set_visible{ &g, panel, tag = "LBL_ACTIONDESCBG", visible = shown }
        if not shown { return }
        let sl = &s.slots[@as(usize, k)]
        let e = sl.entries[index_of{ sl, id = sl.selected }]
        // "Name (N)" for a stack of two or more (0x00686e20: the format "%s (%d)"); a mine's entry
        // reads "<kit> (self)" before that (0x006193a0, dialog.tlk 38005).
        let name = entry_name{ &w, k = @as(usize, k), e }
        let stack = if k == 0 { 1 } else { items::stack_of{ w = &w, id = e.id } }
        if stack > 1 or k == 3 {
            let mut b = items::new_text{ w = &w }
            defer list::free{ list = &b.bytes }
            _ = @fmt(&b, "{}", name)
            if k == 3 { _ = @fmt(&b, " ({})", world::string_by_strref{ w = &w, strref = 38005 }) }
            if stack > 1 { _ = @fmt(&b, " ({})", stack) }
            gui::set_text{ &g, panel, tag = "LBL_ACTIONDESC", text = utf8::view{ b }.bytes } iferr {}
            return
        }
        gui::set_text{ &g, panel, tag = "LBL_ACTIONDESC", text = name } iferr {}
    }

    // ---- every frame

    // Rebuilds the lists from the leader and the bag now and then and refreshes the slots that
    // changed; runs the blinks and takes the refusal message down.
    fn update { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, dt: f32, combat_message: bool } {
        let leader = party::leader{ w = &w }
        s.wait = s.wait - dt
        if s.wait <= 0.0 or leader != s.shown_leader {
            s.wait = REBUILD
            let mut next: [4]Slot
            build{ &w, leader, out = &next }
            let mut k: usize = 0
            while k < SLOTS {
                next[k].sig = signature{ sl = &next[k] }
                // The chosen entry stays chosen while it is still in the list.
                let keep = s.slots[k].selected
                let mut found = false
                let mut i: usize = 0
                while i < next[k].count {
                    if next[k].entries[i].id == keep { found = true }
                    i = i + 1
                }
                next[k].selected = if found { keep } else if next[k].count > 0 { next[k].entries[0].id } else { obj::INVALID }
                let changed = next[k].sig != s.slots[k].sig or next[k].selected != s.slots[k].selected or leader != s.shown_leader
                s.slots[k] = next[k]
                if changed { show_slot{ &s, &g, &w, &dev, panel, k } }
                k = k + 1
            }
            s.shown_leader = leader
            show_description{ &s, &g, &w, panel }
        }
        let mut buf: [24]u8
        let mut k: usize = 0
        while k < SLOTS {
            if s.blink[k] > 0.0 {
                s.blink[k] = s.blink[k] - dt
                if s.blink[k] <= 0.0 {
                    // Over: the icon is as the list left it.
                    show_slot{ &s, &g, &w, &dev, panel, k }
                } else if gui::find_control{ &g, panel, tag = tag_for{ into = buf[..], prefix = "LBL_ACTION", k } } is some{ value = c } {
                    // The first tenth the icon fades out, the second it fades in; it overrides the dimming.
                    let t = s.blink[k]
                    let a: f32 = if t > 0.1 { 1.0 - (0.2 - t) * 10.0 } else { (0.1 - t) * 10.0 }
                    c.border.tinted = true
                    c.border.color = render::Color{ r = 1.0, g = 1.0, b = 1.0, a }
                }
            }
            k = k + 1
        }
        if s.message > 0.0 {
            s.message = s.message - dt
            if s.message <= 0.0 and not combat_message {
                gui::set_visible{ &g, panel, tag = "LBL_CMBTMSGBG", visible = false }
                gui::set_visible{ &g, panel, tag = "LBL_CMBTMODEMSG", visible = false }
            }
        }
    }

    // ---- events

    fn slot_of { tag: []u8, prefix: []u8 } -> i32 {
        let mut buf: [24]u8
        let mut k: usize = 0
        while k < SLOTS {
            if slice::eq_bytes{ a = tag, b = tag_for{ into = buf[..], prefix, k } } { return @as(i32, k) }
            k = k + 1
        }
        return -1
    }

    // The refusal in the message bar.
    fn say_reason { mut s: State, mut g: gui::Gui, panel: u32, reason: i32 } {
        if reason <= 0 or reason >= 7 { return }
        gui::set_strref{ &g, panel, tag = "LBL_CMBTMODEMSG", strref = REASON_TEXT[@as(usize, reason)] } iferr {}
        gui::set_visible{ &g, panel, tag = "LBL_CMBTMSGBG", visible = true }
        gui::set_visible{ &g, panel, tag = "LBL_CMBTMODEMSG", visible = true }
        s.message = MESSAGE_SECONDS
    }

    // A slot's button: does its selected entry on the leader (UseSelfAction, 0x0068ad60).
    fn use_slot { mut s: State, mut g: gui::Gui, mut w: world::World, panel: u32, k: usize } {
        let sl = &s.slots[k]
        if sl.count == 0 { return }
        let e = sl.entries[index_of{ sl, id = sl.selected }]
        if not e.usable {
            say_reason{ &s, &g, panel, reason = e.reason }
            gui::play_sound{ &g, n = 2 }
            return
        }
        let leader = party::leader{ w = &w }
        // In combat mode during an auto-pause the banner turns to reason 10 (UseSelfAction 0x0068ad60).
        if hud::leader_in_combat_mode{ w = &w } { s.queued = true }
        if k == 0 {
            actions::clear_for_player{ &w, id = leader }
            rt_talent::queue_cast{ &w, me = leader, spell = @as(i32, e.id), target = leader, location = math::vec3::zero{}, cheat = 0, instant = 0, item = obj::INVALID }
        } else if k == 3 {
            // A mine is laid at the leader's feet (UseItem's trap branch, SETTRAP).
            _ = traps::lay_mine{ &w, who = leader, item = e.id }
        } else {
            items::use_item{ &w, who = leader, item = e.id }
        }
        gui::play_sound{ &g, n = 6 }
        s.blink[k] = BLINK_SECONDS
        s.wait = 0.0
    }

    // The HUD's events for the slots: the button, the arrows (with wrap-around), the pointer over a
    // slot. True when it was theirs.
    fn event { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, ev: gui::Event } -> bool {
        // The icon label lies over the button and takes the pointer, so either one is the slot's.
        let over_button = slot_of{ tag = ev.tag, prefix = "BTN_ACTION" }
        let over = if over_button >= 0 { over_button } else { slot_of{ tag = ev.tag, prefix = "LBL_ACTION" } }
        if over >= 0 {
            if ev.kind == gui::EventKind::hilight {
                s.hover = over
                show_description{ &s, &g, &w, panel }
                return true
            }
            if ev.kind == gui::EventKind::unhilight {
                if s.hover == over { s.hover = -1 }
                show_description{ &s, &g, &w, panel }
                return true
            }
            if ev.kind == gui::EventKind::activate {
                use_slot{ &s, &g, &w, panel, k = @as(usize, over) }
                return true
            }
            return false
        }
        if ev.kind != gui::EventKind::activate { return false }
        let up = slot_of{ tag = ev.tag, prefix = "BTN_ACTIONUP" }
        let down = slot_of{ tag = ev.tag, prefix = "BTN_ACTIONDOWN" }
        let k = if up >= 0 { up } else { down }
        if k < 0 { return false }
        cycle{ &s, &g, &w, &dev, panel, k = @as(usize, k), forward = down >= 0 }
        return true
    }

    // Slot `k`'s next (or previous) choice, wrapping: its arrows, and Shift with the slot's key.
    fn cycle { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, k: usize, forward: bool } {
        let sl = &s.slots[k]
        if sl.count > 1 {
            let at = index_of{ sl, id = sl.selected }
            let to = if forward { (at + 1) % sl.count } else { (at + sl.count - 1) % sl.count }
            sl.selected = sl.entries[to].id
            gui::play_sound{ &g, n = 7 }
            show_slot{ &s, &g, &w, &dev, panel, k }
            show_description{ &s, &g, &w, panel }
        }
    }
}
