// The game's tutorial pop-up box (docs/re/gui.md "Tutorial pop-ups"; the box itself is
// gui::TutorialBox, lib/gui/tutorial_box.ctx). Anything may take an offer (world::offer_tutorial); the
// frame after one is taken the tutorial is marked shown in the game (PT_TUT_WND_SHOWN) and the box
// opens over everything, pausing the game unless the player has. After its last page it closes, the
// pause it made ends, and the action that offered it is done (hud::redo_tutorial).
namespace ingame {
    struct TutorialBox { b: gui::TutorialBox, paused_it: bool, who: u32, target: u32, n: i32 }

    fn no_tutorial_box {} -> TutorialBox {
        return TutorialBox{ b = gui::no_tutorial_box{}, paused_it = false, who = obj::INVALID, target = obj::INVALID, n = 0 }
    }

    // MainLoop's step for the offer taken last (0x0062f4a0): marked shown, the box with its first page.
    fn update_tutorial { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device } {
        // A box something else took down (a conversation's interface, a module change) is over, and its pause.
        if ui.tbox.b.panel != 0 and gui::find_panel{ g = &ui.gui, id = ui.tbox.b.panel } == null {
            if ui.tbox.paused_it { clock::set_pause{ c = &w.clock, bit = clock::PAUSE_PLAYER, on = false } }
            ui.tbox = no_tutorial_box{}
            w.tut.open = false
        }
        let id = w.tut.pending
        if id < 0 { return }
        w.tut.pending = -1
        if ui.tbox.b.panel != 0 { return }
        let b = gui::open_tutorial_box{ g = &ui.gui, fs = &w.fs, &dev, t = w.tables.tutorial, id } iferr { return }
        if b.panel == 0 { return }
        world::mark_tutorial_shown{ &w, id }
        ui.tbox = TutorialBox{ b, paused_it = false, who = w.tut.who, target = w.tut.target, n = w.tut.n }
        w.tut.open = true
        // OnPanelAdded (0x006aa860): the game pauses unless the player has paused it already.
        if not clock_paused_by_player{ w = &w } {
            clock::set_pause{ c = &w.clock, bit = clock::PAUSE_PLAYER, on = true }
            ui.tbox.paused_it = true
        }
        if w.log.objects {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "tutorial shown: {} page 0 strref {}\n", id, gui::tutorial_page{ t = w.tables.tutorial, id, page = 0 } ifnull 0)
        }
    }

    // The box's events: OK, Enter or Escape turn the page (HandleInputEvent 0x006aa8a0), or close the box
    // after the last. True when the event was the box's.
    fn tutorial_event { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, ev: gui::Event } -> bool {
        if ui.tbox.b.panel == 0 or ev.panel != ui.tbox.b.panel { return false }
        if ev.kind != gui::EventKind::activate and ev.kind != gui::EventKind::cancel { return true }
        if gui::turn_tutorial_page{ g = &ui.gui, b = &ui.tbox.b, t = w.tables.tutorial } { return true }
        close_tutorial{ &ui, &w, &dev }
        return true
    }

    // The close (CSWGuiMessageBox's, GUI sound 0, then the id's callback): the pause it made ends, and the
    // action that offered it is done.
    fn close_tutorial { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device } {
        let t = ui.tbox
        gui::close{ g = &ui.gui, id = t.b.panel }
        gui::play_sound{ g = &ui.gui, n = 0 }
        ui.tbox = no_tutorial_box{}
        w.tut.open = false
        if t.paused_it { clock::set_pause{ c = &w.clock, bit = clock::PAUSE_PLAYER, on = false } }
        if w.log.objects {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "tutorial closed: {}\n", t.b.id)
        }
        hud::redo_tutorial{ h = &ui.hud, g = &ui.gui, &w, id = t.b.id, who = t.who, target = t.target, n = t.n }
        // 0x27's close (0x006aa620): the map's Return to Base again.
        if t.b.id == world::TUT_RETURN and ui.menu == MENU_MAP { map_panel::ask_return{ s = &ui.menus.map, g = &ui.gui, &w, &dev } }
    }
}
