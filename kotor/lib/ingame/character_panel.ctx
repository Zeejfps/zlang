// Character sheet (character.gui, menu 2): the leader's name, class and level, vitality, Force,
// defence, the six attributes with their modifiers, the three saves, alignment, XP and the level-up
// buttons (docs/re/gui.md, "CSWGuiCharacter"). The numbers come from `sheet::read`
// (sheet_data.ctx), the one place that works them out.
//
// What the original has that this does not yet (each marked PLACEHOLDER below): the 3D model in the
// middle (the portrait stands in). The effect icons next to the alignment bar are the creature's ICON
// effects. The Scripts button opens the AI style panel (scriptselect_panel.ctx) for the character shown.
namespace character_panel {
    // The label tags of the six attributes and their modifiers, in STR DEX CON INT WIS CHA order.
    const ABIL_TAGS: [6][]u8 = ["LBL_STR", "LBL_DEX", "LBL_CON", "LBL_INT", "LBL_WIS", "LBL_CHA"]
    const MOD_TAGS: [6][]u8 = ["LBL_STR_MOD", "LBL_DEX_MOD", "LBL_CON_MOD", "LBL_INT_MOD", "LBL_WIS_MOD", "LBL_CHA_MOD"]
    const SAVE_TAGS: [3][]u8 = ["LBL_FORTITUDE_STAT", "LBL_REFLEX_STAT", "LBL_WILL_STAT"]

    struct State {
        opened: bool,
        who: u32,                       // the creature shown
        script: scriptselect_panel::State,  // the AI style panel (BTN_SCRIPTS), modal over the sheet
        area: [4]i32,                   // LBL_3DCHAR as the file has it: x, y, w, h
    }

    fn new {} -> State { return State{ opened = false, who = obj::INVALID, script = scriptselect_panel::new{}, area = [0; 4] } }

    // The panel was just added, or the leader changed and it must be filled again.
    fn open { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32 } -> ! {
        if not s.opened { s.area = sheet::home_of{ &g, panel, tag = "LBL_3DCHAR" } }
        s.opened = true
        s.who = party::leader{ w = &w }
        let known = sheet::known_of{ &w, id = s.who }
        let v = sheet::read{ &w, id = s.who, known }
        try fill{ &g, &w, &dev, panel, id = s.who, v, area = s.area }
    }

    fn fill { mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, id: u32, v: sheet::Sheet, area: [4]i32 } -> ! {
        let mut b = sheet::new_text{ w = &w }
        defer utf8::free{ &b }

        try sheet::say{ &g, &b, panel, tag = "LBL_NAME", text = hud::name_of{ w = &w, id } }

        // Class and level: one line per class slot; the second line hides for a single class.
        let class_tags: [2][]u8 = ["LBL_CLASS1", "LBL_CLASS2"]
        let level_tags: [2][]u8 = ["LBL_LEVEL1", "LBL_LEVEL2"]
        let mut k: usize = 0
        while k < 2 {
            let has = k < v.nclasses
            gui::set_visible{ &g, panel, tag = class_tags[k], visible = has }
            gui::set_visible{ &g, panel, tag = level_tags[k], visible = has }
            if has {
                try gui::set_strref{ &g, panel, tag = class_tags[k], strref = v.class_name[k] }
                try sheet::say_num{ &g, &b, panel, tag = level_tags[k], n = v.class_level[k] }
            }
            k = k + 1
        }

        try sheet::say_pair{ &g, &b, panel, tag = "LBL_VITALITY_STAT", a = v.hp, z = v.hp_max }
        try sheet::say_pair{ &g, &b, panel, tag = "LBL_FORCE_STAT", a = v.fp, z = v.fp_max }
        try sheet::say_num{ &g, &b, panel, tag = "LBL_DEFENSE_STAT", n = v.defense }

        let mut a: usize = 0
        while a < 6 {
            try sheet::say_num{ &g, &b, panel, tag = ABIL_TAGS[a], n = v.abil[a] }
            try sheet::say_signed{ &g, &b, panel, tag = MOD_TAGS[a], n = v.abil_mod[a] }
            a = a + 1
        }
        let mut sv: usize = 0
        while sv < 3 {
            try sheet::say_num{ &g, &b, panel, tag = SAVE_TAGS[sv], n = v.save[sv] }
            sv = sv + 1
        }

        // The attack bonus has no label in the file (labels take no tooltip either); the button over
        // the character carries it.
        if v.attack >= 0 {
            try @fmt(&b, "Attack bonus +{}", v.attack)
        } else {
            try @fmt(&b, "Attack bonus {}", v.attack)
        }
        try gui::set_tooltip{ &g, panel, tag = "BTN_3DCHAR", text = utf8::view{ b }.bytes }
        utf8::clear{ &b }

        // Experience and the XP of the next level (the cap has none).
        try sheet::say_grouped{ &g, &b, panel, tag = "LBL_EXPERIENCE_STAT", n = v.xp }
        if v.xp_next >= 0 {
            try sheet::say_grouped{ &g, &b, panel, tag = "LBL_NEEDED_XP", n = v.xp_next }
        } else {
            try sheet::say{ &g, &b, panel, tag = "LBL_NEEDED_XP", text = "-" }
        }

        // Alignment: the slider's top is the light side (re/gui.md: 100 - good/evil). It only shows.
        gui::set_max{ &g, panel, tag = "SLD_ALIGN", max = 100 }
        gui::set_value{ &g, panel, tag = "SLD_ALIGN", value = 100 - v.light }
        gui::set_enabled{ &g, panel, tag = "SLD_ALIGN", enabled = false }

        // The level-up buttons show only for a character whose XP allows a level.
        gui::set_visible{ &g, panel, tag = "BTN_LEVELUP", visible = v.can_level }
        gui::set_visible{ &g, panel, tag = "BTN_AUTO", visible = v.can_level }
        if v.can_level {
            try gui::set_tooltip{ &g, panel, tag = "BTN_LEVELUP", text = "Level Up" }
            try gui::set_tooltip{ &g, panel, tag = "BTN_AUTO", text = "Auto Level Up" }
        }

        try show_effects{ &g, &w, &dev, panel, id }

        // PLACEHOLDER: the original shows a rotating 3D model of the character here (a gui3d scene
        // drawn into the control's rectangle by the session); until that is wired the portrait
        // takes its place, in proportion and centred in the model's area.
        try sheet::show_picture{ &g, &w, &dev, panel, tag = "LBL_3DCHAR", name = sheet::portrait_of{ w = &w, id }, home = area }
    }

    // The icons beside the alignment bar: the creature's ICON effects (rules effect kind 0x43;
    // int 0 is the effecticon.2da row, whose IconResRef is the texture), each icon once, up to ten
    // with "more" lit for the rest. A creature with no rules state shows none.
    fn show_effects { mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, id: u32 } -> ! {
        let mut rows: [10]i32 = [0; 10]
        let mut shown: usize = 0
        let mut more = false
        if hud::ruled_of{ w = &w, id } is some{ value = f } {
            let mut i: usize = 0
            while i < @as(usize, f.c.nfx) {
                let e = &f.c.fx[i]
                i = i + 1
                if e.kind != rules::fx::ICON { continue }
                let row = e.ints[0]
                let mut dup = false
                let mut j: usize = 0
                while j < shown {
                    if rows[j] == row { dup = true }
                    j = j + 1
                }
                if dup { continue }
                if shown >= 10 {
                    more = true
                    continue
                }
                rows[shown] = row
                shown = shown + 1
            }
        }
        let t = rules::raw_table{ tables = w.rules, which = rules::Tab::effecticon }
        let mut n: usize = 1
        let mut tag: [16]u8
        while n <= 10 {
            let at = hud::tag_n{ into = tag[..], prefix = "LBL_GOOD", n }
            let mut img = gui::no_img{}
            if n <= shown and rows[n - 1] >= 0 and @as(usize, rows[n - 1]) < twoda::rows{ t } {
                let name = rules::cell_text{ t, row = @as(usize, rows[n - 1]), col = "iconresref" }
                if name.len > 0 { img = gui::resolve_img{ &g, fs = &w.fs, &dev, name } }
            }
            gui::set_visible{ &g, panel, tag = at, visible = img.ok }
            if img.ok { gui::set_picture{ &g, panel, tag = at, texture = img.tex, w = img.w, h = img.h } }
            n = n + 1
        }
        gui::set_visible{ &g, panel, tag = "LBL_MORE", visible = more }
    }

    // Every frame while the panel is shown: the AI style panel over it, when open, takes its events.
    fn update { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, dt: f32 } {
        scriptselect_panel::update{ s = &s.script, g = &g, w = &w, dev = &dev }
    }

    // One of the panel's GUI events (BTN_EXIT, Escape and the BTN_CHANGE buttons are the
    // framework's). True when it used the event.
    fn on_event { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, ev: gui::Event } -> bool {
        if ev.kind != gui::EventKind::activate { return false }
        if slice::eq_bytes{ a = ev.tag, b = "BTN_CHARLEFT" } or slice::eq_bytes{ a = ev.tag, b = "BTN_CHARRIGHT" } {
            // The previous or the next party member becomes the leader and the sheet shows them.
            let count = party::members{ w = &w }.len
            if count < 2 { return true }
            ingame::change_leader{ &w, step = if slice::eq_bytes{ a = ev.tag, b = "BTN_CHARRIGHT" } { 1 } else { count - 1 } }
            ingame::fill_change_buttons{ &g, &w, &dev, panel }
            open{ &s, &g, &w, &dev, panel } iferr err{ error } { _ = @fmt(&w.io, "kotor: character sheet: {}\n", error) }
            return true
        }
        // Level Up asks for the level-up panels (lib/screens, through the outbox as ShowLevelUpGUI
        // does); Auto takes the levels the auto-leveller would and shows the sheet again.
        if slice::eq_bytes{ a = ev.tag, b = "BTN_LEVELUP" } {
            outbox::post{ out = &w.out, note = outbox::Note::level_up{ who = party::leader{ w = &w } } }
            return true
        }
        if slice::eq_bytes{ a = ev.tag, b = "BTN_AUTO" } {
            _ = levelup::auto_level{ &w, id = party::leader{ w = &w } }
            open{ &s, &g, &w, &dev, panel } iferr err{ error } { _ = @fmt(&w.io, "kotor: character sheet: {}\n", error) }
            return true
        }
        // Scripts: the AI style of the character shown (script select, modal; re/gui.md event 0x29).
        if slice::eq_bytes{ a = ev.tag, b = "BTN_SCRIPTS" } {
            scriptselect_panel::open_modal{ s = &s.script, g = &g, w = &w, dev = &dev, who = s.who } iferr err{ error } {
                _ = @fmt(&w.io, "kotor: script select: {}\n", error)
            }
            return true
        }
        return false
    }

    // The panel is going away.
    fn close { mut s: State, mut g: gui::Gui, mut w: world::World, panel: u32 } {
        scriptselect_panel::close{ s = &s.script, g = &g, w = &w }
        s.opened = false
    }
}
