// The character sheet's numbers: ONE place that reads a creature's attributes, defence, saves,
// attack bonus, hit points, Force points, level, XP, class names, skill ranks, feats and Force
// powers for the character sheet and the abilities menu (docs/design/hud.md, "Reading the game").
//
// The numbers are the creature's rules state (fight::Fighter.c, read from its GFF): `read_ruled`
// takes them from rules::Stats (abilities, base attack bonus, saves, Force points, level),
// rules::armor_class_sheet (defence), rules::xp_to_reach_level / can_level_up, and `known_ruled`
// from the creature's skill ranks, feat and power bit sets and rules::skill_rank.
// A creature with no rules state (`hud::ruled_of` is null) falls back to `read_standin` and
// `known_standin`, which compute the same numbers from the d20 formulas of docs/re/rules.md and
// combat.md and the game's own 2DAs on the engine's own creature fields (obj::Creature) and its
// blueprint.
//
// Every 2DA the fallback reads goes into the frame's scratch memory (nothing to free), so a caller
// uses what these return in the frame it asked in.
namespace sheet {
    const SKILLS: usize = 8
    const MAX_FEATS: usize = 192
    const MAX_POWERS: usize = 96
    const MAX_LEVEL: i32 = 20

    // feat.2da rows the numbers depend on (rules.md 5.1 and 4.5; the rules lead's names).
    const FEAT_CONDITIONING: u16 = 13
    const FEAT_IMPROVED_CONDITIONING: u16 = 21
    const FEAT_MASTER_CONDITIONING: u16 = 22
    const FEAT_FORCE_SENSITIVE: u16 = 116

    // What the creature knows how to do, beyond the numbers the engine keeps on it.
    struct Known {
        ruled: bool,                        // from the rules creature (else the fallback below)
        total: [8]i32,                      // rules::skill_rank with effects, by skills.2da row (ruled only)
        from_template: bool,                // read from the blueprint (else derived from the classes)
        skill_rank: [8]i32,                 // ranks bought, by skills.2da row
        nfeats: usize,
        feats: [192]u16,                    // feat.2da rows, ascending
        npowers: usize,
        powers: [96]u16,                    // spells.2da rows, ascending
        force_base: i32,                    // the blueprint's ForcePoints
        force_now: i32,                     // and CurrentForce; -1 when it has none
        natural_ac: i32,
        save_bonus: [3]i32,                 // the blueprint's fort/ref/will bonus
    }

    // The numbers the character sheet shows.
    struct Sheet {
        valid: bool,
        level: i32,
        nclasses: usize,
        class_name: [3]u32,                 // dialog.tlk strrefs
        class_level: [3]i32,
        abil: [6]i32,                       // STR DEX CON INT WIS CHA
        abil_mod: [6]i32,
        hp: i32,
        hp_max: i32,
        fp: i32,
        fp_max: i32,
        defense: i32,
        save: [3]i32,                       // fortitude, reflex, will
        bab: i32,
        xp: i32,
        attack: i32,                        // the attack modifier with the right-hand weapon (ruled only; else bab)
        xp_next: i32,                       // the XP of the next level; -1 at the level cap
        can_level: bool,
        light: i32,                         // good_evil: 0 dark .. 100 light
        force_user: bool,                   // has a Force class (the abilities menu shows Powers)
        droid: bool,
    }

    // ---- 2DAs

    // A 2DA parsed into the frame's scratch memory; null when the install has none of that name.
    fn load_2da { mut w: world::World, name: []u8 } -> !?twoda::Table {
        let bytes = try world::read_scratch{ &w, name, kind = restype::Type::twoda } ifnull { return null }
        return try twoda::parse{ data = bytes, realloc = arena::alloc, heap = w.scratch }
    }

    fn table_of { mut w: world::World, name: []u8 } -> ?twoda::Table {
        return load_2da{ &w, name } iferr { null }
    }

    // A row number clamped into the table (a level's row in a 1..N table).
    fn clamp_row { t: twoda::Table, row: i32 } -> usize {
        let n = twoda::rows{ t }
        if n == 0 { return 0 }
        let r = if row < 0 { 0 } else { @as(usize, row) }
        return if r >= n { n - 1 } else { r }
    }

    // A key ability's name in skills.2da as the six attributes' index; 3 (INT) for anything else.
    fn ability_index { name: []u8 } -> usize {
        if ci::eq{ a = name, b = "STR" } { return 0 }
        if ci::eq{ a = name, b = "DEX" } { return 1 }
        if ci::eq{ a = name, b = "CON" } { return 2 }
        if ci::eq{ a = name, b = "INT" } { return 3 }
        if ci::eq{ a = name, b = "WIS" } { return 4 }
        if ci::eq{ a = name, b = "CHA" } { return 5 }
        return 3
    }

    // ---- what the creature knows (skill ranks, feats, Force powers)

    fn has_feat { k: Known, feat: u16 } -> bool {
        let mut i: usize = 0
        while i < k.nfeats {
            if k.feats[i] == feat { return true }
            i = i + 1
        }
        return false
    }

    fn add_feat { mut k: Known, feat: u16 } {
        if k.nfeats >= MAX_FEATS { return }
        let mut at: usize = 0
        while at < k.nfeats and k.feats[at] < feat { at = at + 1 }
        if at < k.nfeats and k.feats[at] == feat { return }
        let mut j = k.nfeats
        while j > at {
            k.feats[j] = k.feats[j - 1]
            j = j - 1
        }
        k.feats[at] = feat
        k.nfeats = k.nfeats + 1
    }

    fn add_power { mut k: Known, spell: u16 } {
        if k.npowers >= MAX_POWERS { return }
        let mut at: usize = 0
        while at < k.npowers and k.powers[at] < spell { at = at + 1 }
        if at < k.npowers and k.powers[at] == spell { return }
        let mut j = k.npowers
        while j > at {
            k.powers[j] = k.powers[j - 1]
            j = j - 1
        }
        k.powers[at] = spell
        k.npowers = k.npowers + 1
    }

    fn number_of { doc: gff::Doc, s: u32, label: []u8, default: i64 } -> i64 {
        return gff::get_number{ doc, s, label } ifnull default
    }

    // Skill ranks, feats and Force powers of a creature: the rules creature's.
    fn known_of { mut w: world::World, id: u32 } -> Known {
        if hud::ruled_of{ w = &w, id } is some{ value = f } { return known_ruled{ &w, f } }
        return known_standin{ &w, id }
    }

    // From the rules creature: the ranks bought, every feat and power its bit sets hold, and the
    // skill totals (ranks + key ability + feat line + effects) as the rules count them.
    fn known_ruled { mut w: world::World, f: *mut fight::Fighter } -> Known {
        let mut k: Known
        k.ruled = true
        k.from_template = true
        k.force_now = -1
        let mut i: usize = 0
        while i < SKILLS {
            k.skill_rank[i] = f.c.skills[i]
            k.total[i] = rules::skill_rank{ tables = w.rules, c = &f.c, skill = @as(i32, i), vs = rules::no_versus{}, base_only = false }
            i = i + 1
        }
        let mut row: i32 = 0
        while row < 256 {
            if rules::has_feat{ c = &f.c, feat = row } { add_feat{ &k, feat = @trunc(u16, row) } }
            if rules::knows_power{ c = &f.c, spell = row } { add_power{ &k, spell = @trunc(u16, row) } }
            row = row + 1
        }
        return k
    }

    // The fallback for a creature with no rules state. The ranks, feats and powers come from its
    // blueprint (the UTC the object was made from: real data); a creature with no blueprint gets
    // the feats its classes grant at its levels, from feat.2da's `<class>_granted` columns.
    fn known_standin { mut w: world::World, id: u32 } -> Known {
        let mut k: Known
        k.force_now = -1
        let o = world::object{ w = &w, id } ifnull { return k }
        let c = obj::creature{ o } ifnull { return k }
        let template = o.template
        if resref::is_empty{ r = template } {
            grant_class_feats{ &k, &w, c }
            return k
        }
        let found = world::read_gff{ &w, name = resref::bytes{ r = &template }, kind = restype::Type::utc } iferr { null }
        let doc = found ifnull {
            grant_class_feats{ &k, &w, c }
            return k
        }
        k.from_template = true
        let s = gff::ROOT
        let ranks = gff::get_list{ doc, s, label = "SkillList" } ifnull slice::empty(u32){}
        let mut i: usize = 0
        while i < ranks.len and i < SKILLS {
            k.skill_rank[i] = @trunc(i32, number_of{ doc, s = ranks[i], label = "Rank", default = 0 })
            i = i + 1
        }
        let feats = gff::get_list{ doc, s, label = "FeatList" } ifnull slice::empty(u32){}
        i = 0
        while i < feats.len {
            add_feat{ &k, feat = @trunc(u16, number_of{ doc, s = feats[i], label = "Feat", default = 0 }) }
            i = i + 1
        }
        // Force powers sit in each class slot's KnownList0 (the levels above 0 are empty in KOTOR).
        let classes = gff::get_list{ doc, s, label = "ClassList" } ifnull slice::empty(u32){}
        i = 0
        while i < classes.len {
            let known = gff::get_list{ doc, s = classes[i], label = "KnownList0" } ifnull slice::empty(u32){}
            let mut p: usize = 0
            while p < known.len {
                add_power{ &k, spell = @trunc(u16, number_of{ doc, s = known[p], label = "Spell", default = 0 }) }
                p = p + 1
            }
            i = i + 1
        }
        k.force_base = @trunc(i32, number_of{ doc, s, label = "ForcePoints", default = 0 })
        k.force_now = @trunc(i32, number_of{ doc, s, label = "CurrentForce", default = -1 })
        k.natural_ac = @trunc(i32, number_of{ doc, s, label = "NaturalAC", default = 0 })
        k.save_bonus[0] = @trunc(i32, number_of{ doc, s, label = "fortbonus", default = 0 })
        k.save_bonus[1] = @trunc(i32, number_of{ doc, s, label = "refbonus", default = 0 })
        k.save_bonus[2] = @trunc(i32, number_of{ doc, s, label = "willbonus", default = 0 })
        return k
    }

    // Fallback: a creature with no blueprint and no rules state knows the feats its classes grant
    // outright up to its class levels (armour and weapon proficiencies, mostly).
    fn grant_class_feats { mut k: Known, mut w: world::World, c: *obj::Creature } {
        let classes = table_of{ &w, name = "classes" } ifnull { return }
        let feats = table_of{ &w, name = "feat" } ifnull { return }
        let mut slot: usize = 0
        while slot < 3 {
            let level = @as(i32, c.class_levels[slot])
            if level > 0 {
                let code = twoda::get_string{ t = classes, row = @as(usize, c.classes[slot]), column = "featgain" } ifnull ""
                let mut buf: [24]u8
                let suffix: []u8 = "_granted"
                if code.len > 0 and code.len + suffix.len <= buf.len {
                    slice::copy(u8){ dst = buf[..code.len], src = code }
                    slice::copy(u8){ dst = buf[code.len..code.len + suffix.len], src = suffix }
                    let col = twoda::find_column{ t = feats, name = buf[..code.len + suffix.len] }
                    if col != null {
                        let mut row: usize = 0
                        while row < twoda::rows{ t = feats } {
                            let granted = twoda::get_int_at{ t = feats, row, col = col } ifnull -1
                            // feat.2da rows with no name are unused slots.
                            if granted >= 1 and granted <= level and twoda::get_int{ t = feats, row, column = "name" } != null {
                                add_feat{ &k, feat = @as(u16, row) }
                            }
                            row = row + 1
                        }
                    }
                }
            }
            slot = slot + 1
        }
    }

    // ---- skills

    // The best tier of a skill's feat line (+1 / +2 / +3, rules.md 5.1): Computer Use (0), Repair
    // (5) and Security (6) have Gear Head, Adept and Master; Demolitions (1) and Stealth (2)
    // Cautious, Improved and Master Caution; Awareness (3), Persuade (4) and Treat Injury (7)
    // Empathy, Improved and Master.
    fn skill_feat_bonus { k: Known, skill: usize } -> i32 {
        if skill == 0 or skill == 5 or skill == 6 {
            if has_feat{ k, feat = 120 } { return 3 }
            if has_feat{ k, feat = 119 } { return 2 }
            if has_feat{ k, feat = 12 } { return 1 }
        } else if skill == 1 or skill == 2 {
            if has_feat{ k, feat = 118 } { return 3 }
            if has_feat{ k, feat = 117 } { return 2 }
            if has_feat{ k, feat = 7 } { return 1 }
        } else if skill == 3 or skill == 4 or skill == 7 {
            if has_feat{ k, feat = 122 } { return 3 }
            if has_feat{ k, feat = 121 } { return 2 }
            if has_feat{ k, feat = 10 } { return 1 }
        }
        return 0
    }

    // CSWSCreatureStats::GetSkillRank without effects (rules.md 5.1): ranks + key attribute modifier
    // + the feat line; 0 for a skill that needs training and has none. `skills` is skills.2da.
    fn skill_total { skills: twoda::Table, k: Known, abil_mod: [6]i32, skill: usize } -> i32 {
        if k.ruled and skill < SKILLS { return k.total[skill] }
        let ranks = k.skill_rank[skill]
        let untrained = twoda::get_int{ t = skills, row = skill, column = "untrained" } ifnull 0
        if untrained == 0 and ranks == 0 { return 0 }
        let key = ability_index{ name = twoda::get_string{ t = skills, row = skill, column = "keyability" } ifnull "INT" }
        return ranks + abil_mod[key] + skill_feat_bonus{ k, skill }
    }

    // ---- the sheet

    struct ClassNums { name: u32, caster: bool, bab: i32, fort: i32, refl: i32, will: i32, ac: i32, force_die: i32 }

    // What one class slot contributes at its level, from classes.2da and the tables it names:
    // attack bonus, the three saves and the defence bonus (rules.md 2.1, combat.md 4 and 5).
    fn class_nums { mut w: world::World, classes: twoda::Table, acbonus: ?twoda::Table, row: usize, level: i32 } -> ClassNums {
        let mut n: ClassNums
        n.name = @as(u32, twoda::get_int{ t = classes, row, column = "name" } ifnull 0)
        n.caster = (twoda::get_int{ t = classes, row, column = "spellcaster" } ifnull 0) != 0
        n.force_die = twoda::get_int{ t = classes, row, column = "forcedie" } ifnull 0
        let atk = twoda::get_string{ t = classes, row, column = "attackbonustable" } ifnull ""
        if atk.len > 0 {
            let t = table_of{ &w, name = atk }
            if t != null { n.bab = twoda::get_int{ t = t, row = clamp_row{ t = t, row = level - 1 }, column = "bab" } ifnull 0 }
        }
        let st = twoda::get_string{ t = classes, row, column = "savingthrowtable" } ifnull ""
        if st.len > 0 {
            let t = table_of{ &w, name = st }
            if t != null {
                let r = clamp_row{ t = t, row = level - 1 }
                n.fort = twoda::get_int{ t = t, row = r, column = "fortsave" } ifnull 0
                n.refl = twoda::get_int{ t = t, row = r, column = "refsave" } ifnull 0
                n.will = twoda::get_int{ t = t, row = r, column = "willsave" } ifnull 0
            }
        }
        let col = twoda::get_string{ t = classes, row, column = "armorclasscolumn" } ifnull ""
        if col.len > 0 {
            let t = acbonus ifnull { return n }
            let c = twoda::find_column{ t = t, name = col }
            if c != null { n.ac = twoda::get_int_at{ t = t, row = clamp_row{ t = t, row = level }, col = c } ifnull 0 }
        }
        return n
    }

    // The body armour's base AC and the DEX modifier it allows (rules.md: real armour caps the
    // modifier at its DEXBONUS; robes, with a base AC of 0, do not).
    fn armour_of { w: *world::World, c: *obj::Creature, dex_mod: i32 } -> Armour {
        let mut a = Armour{ base_ac = 0, dex_mod }
        let body = world::object{ w, id = c.equipped[1] } ifnull { return a }
        let it = obj::item{ o = body } ifnull { return a }
        let t = w.tables.baseitems
        let row = @as(usize, it.base)
        let base_ac = twoda::get_int{ t, row, column = "baseac" } ifnull 0
        let dex_bonus = twoda::get_int{ t, row, column = "dexbonus" } ifnull -1
        let model = twoda::get_int{ t, row, column = "modeltype" } ifnull 0
        a.base_ac = base_ac
        if model == 1 and base_ac > 0 and dex_bonus >= 0 and dex_mod > dex_bonus { a.dex_mod = dex_bonus }
        return a
    }

    struct Armour { base_ac: i32, dex_mod: i32 }

    // Everything the character sheet shows for creature `id`: the rules creature's numbers, or the
    // fallback's for a creature that has none.
    fn read { mut w: world::World, id: u32, known: Known } -> Sheet {
        if hud::ruled_of{ w = &w, id } is some{ value = f } { return read_ruled{ &w, id, f } }
        return read_standin{ &w, id, known }
    }

    // From the rules creature (Creature.stats were rebuilt by rules::recompute when anything
    // changed): abilities, level, attack bonus, saves and Force points as the stats hold them, the
    // defence of rules::armor_class_sheet, the XP thresholds and the level-up test of lib/rules.
    fn read_ruled { mut w: world::World, id: u32, f: *mut fight::Fighter } -> Sheet {
        let mut s: Sheet
        let st = &f.c.stats
        s.valid = true
        s.droid = f.c.race == rules::race::DROID
        let mut a: usize = 0
        while a < 6 {
            s.abil[a] = st.abil[a]
            s.abil_mod[a] = st.abil_mod[a]
            a = a + 1
        }
        let mut i: usize = 0
        while i < @as(usize, f.c.nclasses) and i < rules::MAX_CLASSES {
            let slot = f.c.classes[i]
            i = i + 1
            if slot.class < 0 or slot.level < 1 or s.nclasses >= 3 { continue }
            let n = s.nclasses
            s.nclasses = n + 1
            s.class_level[n] = slot.level
            if rules::get_class{ tables = w.rules, row = slot.class } is some{ value = row } {
                s.class_name[n] = @trunc(u32, row.name)
                if row.caster { s.force_user = true }
            }
        }
        s.level = if st.level < 1 { 1 } else { st.level }
        s.bab = st.bab
        s.attack = items::attack_with{ w = &w, f, off_hand = false }
        s.defense = rules::armor_class_sheet{ tables = w.rules, c = &f.c }
        let mut sv: i32 = 1
        while sv <= 3 {
            s.save[@as(usize, sv - 1)] = rules::save_value{ c = &f.c, which = sv }
            sv = sv + 1
        }

        // Hit points are the object's; Force points the rules creature's current and maximum.
        let v = hud::vitality_of{ w = &w, id }
        s.hp = v.hp
        s.hp_max = v.hp_max
        s.fp_max = st.max_fp
        s.fp = if f.c.fp < 0 { 0 } else if f.c.fp > st.max_fp { st.max_fp } else { f.c.fp }

        s.light = if f.c.good_evil > 100 { 100 } else if f.c.good_evil < 0 { 0 } else { f.c.good_evil }
        s.xp = f.c.xp
        s.xp_next = -1
        if s.level < MAX_LEVEL { s.xp_next = rules::xp_to_reach_level{ tables = w.rules, level = s.level + 1 } }
        // PLACEHOLDER: nothing awards a companion the XP its level implies (the party's joining and
        // catch-up XP are not in the engine); a creature is never shown below the XP its level starts at.
        let floor = rules::xp_to_reach_level{ tables = w.rules, level = s.level }
        if s.xp < floor { s.xp = floor }
        s.can_level = hud::can_level_up{ w = &w, id }
        return s
    }

    // The fallback for a creature with no rules state (see the head of the file).
    fn read_standin { mut w: world::World, id: u32, known: Known } -> Sheet {
        let mut s: Sheet
        let o = world::object{ w = &w, id } ifnull { return s }
        let c = obj::creature{ o } ifnull { return s }
        s.valid = true
        s.droid = c.race == 5

        // Attributes: the engine's, never below 3 (rules.md 1.7). A creature whose scores were
        // never filled in (the default player) is average.
        let mut unset = true
        let mut a: usize = 0
        while a < 6 {
            if c.abilities[a] != 0 { unset = false }
            a = a + 1
        }
        a = 0
        while a < 6 {
            let mut v = if unset { 10 } else { @as(i32, c.abilities[a]) }
            if v < 3 { v = 3 }
            s.abil[a] = v
            s.abil_mod[a] = (v - 10) >> 1
            a = a + 1
        }

        // Classes and level.
        let classes = table_of{ &w, name = "classes" }
        let acbonus = table_of{ &w, name = "acbonus" }
        let mut force_dice: i32 = 0
        let mut ac_class: i32 = 0
        let mut save_class = [0; 3]
        let mut i: usize = 0
        while i < 3 {
            let level = @as(i32, c.class_levels[i])
            if level > 0 {
                let n = s.nclasses
                s.class_level[n] = level
                s.level = s.level + level
                s.nclasses = n + 1
                if classes != null {
                    let nums = class_nums{ &w, classes = classes, acbonus, row = @as(usize, c.classes[i]), level }
                    s.class_name[n] = nums.name
                    s.bab = s.bab + nums.bab
                    save_class[0] = save_class[0] + nums.fort
                    save_class[1] = save_class[1] + nums.refl
                    save_class[2] = save_class[2] + nums.will
                    ac_class = ac_class + nums.ac
                    if nums.caster {
                        s.force_user = true
                        force_dice = force_dice + level * nums.force_die
                    }
                }
            }
            i = i + 1
        }
        if s.level == 0 { s.level = 1 }

        // Saves: the class tables, the Conditioning feats, the attribute and the blueprint's bonus.
        let mut conditioning: i32 = 0
        if has_feat{ k = known, feat = FEAT_MASTER_CONDITIONING } { conditioning = 3 }
        else if has_feat{ k = known, feat = FEAT_IMPROVED_CONDITIONING } { conditioning = 2 }
        else if has_feat{ k = known, feat = FEAT_CONDITIONING } { conditioning = 1 }
        s.save[0] = save_class[0] + conditioning + s.abil_mod[2] + known.save_bonus[0]
        s.save[1] = save_class[1] + conditioning + s.abil_mod[1] + known.save_bonus[1]
        s.save[2] = save_class[2] + conditioning + s.abil_mod[4] + known.save_bonus[2]

        // Defence (the sheet's: nobody attacking): 10 + the class bonus + natural + armour + DEX.
        let armour = armour_of{ w = &w, c, dex_mod = s.abil_mod[1] }
        s.defense = 10 + ac_class + known.natural_ac + armour.base_ac + armour.dex_mod

        // Hit points are the object's.
        let v = hud::vitality_of{ w = &w, id }
        s.hp = v.hp
        s.hp_max = v.hp_max

        // Force points (rules.md 3.8): none for droids or for a creature with no Force class. The
        // player: a die per Jedi level plus WIS and CHA each level (at least 1); everyone else the
        // blueprint's pool plus WIS and CHA each level. Force Sensitive adds 40.
        if s.force_user and not s.droid {
            let mods = s.abil_mod[4] + s.abil_mod[5]
            let mut max: i32 = 0
            if c.is_pc and w.pc == id {
                // Fallback: with no level-up history a Jedi level counts as its class's die.
                let mut j: usize = 0
                while j < 3 {
                    let level = @as(i32, c.class_levels[j])
                    if level > 0 and classes != null {
                        let die = twoda::get_int{ t = classes, row = @as(usize, c.classes[j]), column = "forcedie" } ifnull 0
                        if die > 0 {
                            let per = die + mods
                            max = max + level * (if per < 1 { 1 } else { per })
                        }
                    }
                    j = j + 1
                }
            } else {
                max = known.force_base + s.level * mods
                if max < s.level { max = s.level }
            }
            if has_feat{ k = known, feat = FEAT_FORCE_SENSITIVE } { max = max + 40 }
            s.fp_max = max
            // Fallback: with no current pool a companion's is its blueprint's; the player's is full.
            let own = known.force_now >= 0 and known.force_now <= max and not (c.is_pc and w.pc == id)
            s.fp = if own { known.force_now } else { max }
        }

        // Experience and the next level (exptable.2da: row L-1 is the XP that level starts at).
        s.light = @as(i32, c.good_evil)
        if s.light > 100 { s.light = 100 }
        s.xp = @as(i32, c.xp)
        s.xp_next = -1
        let exp = table_of{ &w, name = "exptable" }
        if exp != null {
            let et = exp
            // Fallback: a creature is never below the XP its level starts at.
            let floor = twoda::get_int{ t = et, row = clamp_row{ t = et, row = s.level - 1 }, column = "xp" } ifnull 0
            if s.xp < floor { s.xp = floor }
            if s.level < MAX_LEVEL { s.xp_next = twoda::get_int{ t = et, row = clamp_row{ t = et, row = s.level }, column = "xp" } ifnull -1 }
        }
        s.can_level = s.xp_next >= 0 and s.xp >= s.xp_next and not hud::is_down{ w = &w, id }
        s.attack = s.bab
        return s
    }
}
