// Long text in a list box. The original sizes each row of a text list to the text it holds, so one
// quest text or one log line is one tall row that the scroll bar and the up and down keys scroll.
// The GUI's rows all have the height the file gives its prototype (two lines of the font in the
// journal's and the message log's lists), so:
//  - `show_text`: one text is the list's one wrapped text (`set_list_text`), which scrolls by lines
//    when it is taller than the box, as the original's tall row does;
//  - `add_wrapped`: a log line goes into as many rows as it needs, each holding the lines that fit,
//    broken where the row would break them.
namespace journal {
    // How a list box wraps: the font its rows use and the widths and heights of its text.
    struct Wrap {
        font: i32,              // index into the Gui's fonts, -1 when the list has no usable prototype
        row_w: i32,             // the width of the text of a row
        per_row: usize,         // the lines a row holds
    }

    fn wrap_of { mut g: gui::Gui, panel: u32, tag: []u8 } -> Wrap {
        let mut r = Wrap{ font = -1, row_w = 0, per_row = 1 }
        let p = gui::find_panel{ &g, id = panel } ifnull { return r }
        let ci = gui::find_by_tag{ p, tag }
        if ci < 0 { return r }
        let c = list::at{ list = p.controls, i = @as(usize, ci) }
        if c.proto < 0 { return r }
        let pc = list::at{ list = p.controls, i = @as(usize, c.proto) }
        if pc.text.font < 0 or @as(usize, pc.text.font) >= g.fonts.len { return r }
        let font = list::items{ list = g.fonts }[@as(usize, pc.text.font)].font
        let l = gui::list_layout{ p, c }
        let area = gui::text_area{ b = pc.border, x = 0, y = 0, w = l.aw - 2 * c.padding, h = l.row_h }
        let line_h = gui::lines_height{ font, count = 1 }
        r.font = pc.text.font
        r.row_w = area.w
        if line_h > 0 and area.h / line_h > 1 { r.per_row = @as(usize, area.h / line_h) }
        return r
    }

    // Replaces the list's contents with `text`, one wrapped text.
    fn show_text { mut g: gui::Gui, panel: u32, tag: []u8, text: []u8 } -> ! {
        if text.len == 0 {
            gui::list_clear{ &g, panel, tag }
            return
        }
        try gui::set_list_text{ &g, panel, tag, text }
    }

    // Appends `text` to list box `tag` as rows; with `colored` they are drawn in `color`.
    fn add_wrapped { mut g: gui::Gui, panel: u32, tag: []u8, text: []u8, colored: bool, color: render::Color } -> ! {
        let r = wrap_of{ &g, panel, tag }
        let mut n: usize = 0
        if r.font >= 0 {
            let font = list::items{ list = g.fonts }[@as(usize, r.font)].font
            n = gui::layout{ font, text, width = r.row_w, lines = g.lines }
        }
        let mut k: usize = 0
        while true {
            // The row's text: from the first of its lines to the end of the last.
            let mut piece = text
            if n > r.per_row {
                let last = if k + r.per_row < n { k + r.per_row - 1 } else { n - 1 }
                let from = @as(usize, g.lines[k].start)
                piece = text[from..@as(usize, g.lines[last].start) + @as(usize, g.lines[last].len)]
            }
            let row = try gui::list_add{ &g, panel, tag, text = piece, user = 0 }
            if colored { gui::list_set_color{ &g, panel, tag, row, color } }
            k = k + r.per_row
            if k >= n { break }
        }
    }
}
