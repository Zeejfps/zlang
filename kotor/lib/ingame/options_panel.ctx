// In-game options (optionsingame.gui, menu 7): Load Game, Save Game, the option screens and Exit
// Game (docs/re/gui.md, "Options").
//
// The option screens are the front end's (lib/frontend): this panel keeps a `frontend::Front`
// with the same settings file the main menu uses, opens its screens with frontend::open_screen
// and feeds their events to frontend::on_event. The screens are modal panels of their own on top
// of the menu, so their events never reach `on_event` (the framework passes only the menu
// panel's); `update` takes them from the GUI's list by panel id instead. The front end's stack
// has a stand-in main-menu entry at the bottom so that its screens can close themselves.
//
// Load Game and Save Game are the front end's saveload screen too (lib/frontend, saves.ctx and
// events.ctx): Load Game lists our saves and the install's, Save Game ours with a "New Slot" row
// and asks for a name. What they pick comes out as a request, kept in this state until the
// owner takes it (`take_save`, `take_load`).
//
// What the owner (play.ctx) can ask of it: `ingame::wants_quit` (Exit Game was confirmed),
// `options_panel::take_display_change` (resolution, v-sync, gamma ... changed: apply
// `options_panel::settings`), `ingame::take_save_request` and `ingame::take_load_request` (a game
// to save under a name, or a save's folder to load).
namespace options_panel {
    // What the open message box is for.
    const BOX_NONE: u32 = 0
    const BOX_NOTICE: u32 = 1
    const BOX_QUIT: u32 = 2

    struct State {
        opened: bool,
        quit: bool,                         // the Exit Game button was confirmed
        fe: ?*mut frontend::Front,          // the option screens' state and settings
        box: u32,                           // the message box on screen, 0 when none
        box_for: u32,
        save_req: [64]u8, save_len: usize,  // the name a game is to be saved under, once chosen
        load_req: [300]u8, load_len: usize, // the folder (a path) of the save to load, once chosen
        config: [256]u8, config_len: usize, // the options file
    }

    fn new {} -> State {
        return State{
            opened = false, quit = false, fe = null, box = 0, box_for = BOX_NONE,
            save_req = [0; 64], save_len = 0, load_req = [0; 300], load_len = 0,
            config = [0; 256], config_len = 0,
        }
    }

    // Which file the option screens read and write (default: kotor/out/kotor-settings.ini).
    fn set_config { mut s: State, path: []u8 } {
        let n = if path.len < 256 { path.len } else { 256 }
        slice::copy(u8){ dst = s.config[..n], src = path[..n] }
        s.config_len = n
    }

    // A key while the key remapping screen waits for one: the screen takes it (frontend::capture_key).
    fn capture_key { mut s: State, mut g: gui::Gui, keycode: i32 } -> bool {
        let fe = s.fe ifnull { return false }
        return frontend::capture_key{ fe, &g, keycode }
    }

    // Whether a save or a load was chosen and not yet taken: the menu closes itself then, so that
    // the saved picture is the game's frame and a load starts from a clear screen.
    fn has_request { s: *State } -> bool {
        return s.save_len > 0 or s.load_len > 0
    }

    // The name to save the game under, once (null when none was chosen). The bytes stay in the
    // state, valid until the next request.
    fn take_save { mut s: State } -> ?[]u8 {
        if s.save_len == 0 { return null }
        let n = s.save_len
        s.save_len = 0
        return s.save_req[..n]
    }

    // The folder (a path save::find_save resolves) of the save to load, once (null when none).
    fn take_load { mut s: State } -> ?[]u8 {
        if s.load_len == 0 { return null }
        let n = s.load_len
        s.load_len = 0
        return s.load_req[..n]
    }

    // The front end's settings, once the panel has been opened (null before).
    fn settings { s: *State } -> ?*frontend::Settings {
        let fe = s.fe ifnull { return null }
        return &fe.settings
    }

    // True once when an option that needs the display changed (resolution, full screen, gamma,
    // v-sync ...): the owner applies `settings`.
    fn take_display_change { mut s: State } -> bool {
        let fe = s.fe ifnull { return false }
        return frontend::take_display_change{ fe }
    }

    // ---- opening

    // The front end for this session: the settings file is the one play.ctx loads for the main
    // menu. Made on first use, kept.
    fn make_front { mut s: State, mut w: world::World } -> ! {
        if s.fe != null { return }
        let fe = try alloc::new(frontend::Front, heap::Heap){
            realloc = heap::alloc, heap = w.heap,
            value = frontend::make{ fs = &w.fs, heap = w.heap, game = w.rm.game, config_path = if s.config_len > 0 { s.config[..s.config_len] } else { "kotor/out/kotor-settings.ini" } },
        }
        // The screens close themselves down to the main menu, which is not here: a stand-in entry
        // for it keeps close_top from refusing.
        fe.stack[0] = frontend::Entry{ screen = frontend::SCR_MAIN, panel = 0 }
        fe.depth = 1
        frontend::set_own_saves{ fe, dir = w.gip.root }
        s.fe = fe
    }

    // The panel was just added, or the leader changed and it must be filled again.
    fn open { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32 } -> ! {
        s.opened = true
        try make_front{ &s, &w }
        gui::set_focus{ &g, panel, tag = "BTN_GAMEPLAY" }
    }

    // ---- the buttons

    // The option screen a button opens (0: not one of them).
    fn screen_of_tag { tag: []u8 } -> u32 {
        if slice::eq_bytes{ a = tag, b = "BTN_GAMEPLAY" } { return frontend::SCR_GAMEPLAY }
        if slice::eq_bytes{ a = tag, b = "BTN_FEEDBACK" } { return frontend::SCR_FEEDBACK }
        if slice::eq_bytes{ a = tag, b = "BTN_AUTOPAUSE" } { return frontend::SCR_AUTOPAUSE }
        if slice::eq_bytes{ a = tag, b = "BTN_GRAPHICS" } { return frontend::SCR_GRAPHICS }
        if slice::eq_bytes{ a = tag, b = "BTN_SOUND" } { return frontend::SCR_SOUND }
        return 0
    }

    // A box with a message of dialog.tlk's; `ask` adds Cancel.
    fn say { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, strref: u32, ask: bool, for_what: u32 } {
        if s.box != 0 { return }
        let text = world::string_by_strref{ w = &w, strref }
        s.box = gui::message_box{ g = &g, fs = &w.fs, &dev, text, cancel = ask } iferr { 0 }
        if s.box != 0 { s.box_for = for_what }
    }

    // One of the panel's GUI events (BTN_EXIT, Escape and the BTN_CHANGE buttons are the
    // framework's). True when it used the event.
    fn on_event { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, ev: gui::Event } -> bool {
        if ev.kind != gui::EventKind::activate { return false }
        let screen = screen_of_tag{ tag = ev.tag }
        if screen != 0 {
            let fe = s.fe ifnull { return true }
            frontend::open_screen{ fe, &g, fs = &w.fs, &dev, screen } iferr {}
        } else if slice::eq_bytes{ a = ev.tag, b = "BTN_LOADGAME" } {
            let fe = s.fe ifnull { return true }
            frontend::open_screen{ fe, &g, fs = &w.fs, &dev, screen = frontend::SCR_LOAD } iferr {}
        } else if slice::eq_bytes{ a = ev.tag, b = "BTN_SAVEGAME" } {
            let fe = s.fe ifnull { return true }
            fe.played_seconds = @trunc(u32, @as(u64, w.played_seconds))
            frontend::open_screen{ fe, &g, fs = &w.fs, &dev, screen = frontend::SCR_SAVE } iferr {}
        } else if slice::eq_bytes{ a = ev.tag, b = "BTN_QUIT" } {
            // "Do you really want to quit?"; OK ends the game loop (ingame::wants_quit).
            say{ &s, &g, &w, &dev, strref = 42348, ask = true, for_what = BOX_QUIT }
        } else {
            return false
        }
        return true
    }

    // ---- the option screens and the box, which are panels of their own

    // Every frame while the panel is shown.
    fn update { mut s: State, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, panel: u32, dt: f32 } {
        let fe = s.fe ifnull { return }
        let n = gui::take_events{ g = &g }.len
        let mut i: usize = 0
        while i < n {
            let evs = gui::take_events{ g = &g }
            if i >= evs.len { break }
            let ev = evs[i]
            i = i + 1
            if ev.panel == 0 or ev.panel == panel { continue }
            if s.box != 0 and ev.panel == s.box {
                box_event{ &s, &g, &w, ev }
            } else if frontend::screen_of{ fe, panel = ev.panel } != 0 {
                // The options screens only run; Load Game says which save was picked.
                let outcome = frontend::on_event{ fe, &g, fs = &w.fs, &dev, ev }
                match outcome {
                    load_game{ folder, folder_len } => { s.load_len = frontend::copy_into{ dst = s.load_req[..], src = folder[..folder_len] } }
                    else => {}
                }
                // Volumes go to the mixer's groups at once, as in the main menu.
                if fe.sound_pending { frontend::apply_sound{ fe, mixer = g.mixer } }
                // The Feedback screen's tooltip switch is the GUI's own.
                if frontend::screen_of{ fe, panel = ev.panel } == frontend::SCR_FEEDBACK {
                    gui::set_tooltip_delay{ &g, seconds = g.tooltip_delay, enabled = fe.settings.tooltips }
                }
            }
        }
        // Save Game was answered with a name.
        if s.save_len == 0 { s.save_len = frontend::take_save_request{ fe, into = s.save_req[..] } }
    }

    // The message box was answered.
    fn box_event { mut s: State, mut g: gui::Gui, mut w: world::World, ev: gui::Event } {
        let ok = ev.kind == gui::EventKind::activate and slice::eq_bytes{ a = ev.tag, b = "BTN_OK" }
        let no = ev.kind == gui::EventKind::cancel or (ev.kind == gui::EventKind::activate and slice::eq_bytes{ a = ev.tag, b = "BTN_CANCEL" })
        if not ok and not no { return }
        gui::close{ &g, id = s.box }
        s.box = 0
        if ok and s.box_for == BOX_QUIT { s.quit = true }
        s.box_for = BOX_NONE
    }

    // The panel is going away: so do the screens and box that were over it.
    fn close { mut s: State, mut g: gui::Gui, mut w: world::World, panel: u32 } {
        s.opened = false
        if s.box != 0 {
            gui::close{ &g, id = s.box }
            s.box = 0
            s.box_for = BOX_NONE
        }
        let fe = s.fe ifnull { return }
        if fe.depth <= 1 { return }
        while fe.depth > 1 {
            fe.depth = fe.depth - 1
            gui::close{ &g, id = fe.stack[fe.depth].panel }
        }
        // A screen was still up: the options it changed are kept, as when it closes itself.
        frontend::persist{ fe, fs = &w.fs }
    }
}
