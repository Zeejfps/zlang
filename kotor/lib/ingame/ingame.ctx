// The in-game interface (docs/design/hud.md): one Gui for everything that draws over a running
// module. It owns the HUD, the menu bar and the menu panels; the game loop gives it events and
// the world each frame and asks it to draw. Other systems that put panels on the screen
// (dialogue) use `ui.gui` and its stack.
//
//   let ui = try ingame::make{ &w, &dev, mixer, scratch, width, height }       // after the module is entered
//   ingame::begin_frame{ ui }                                                  // top of the frame
//   used = ingame::handle_event{ ui, &w, &dev, ev, scale_x, scale_y }          // per SDL event: true, the GUI took it
//   ingame::take{ ui, &w, note }                                               // per outbox note (feedback text)
//   ingame::update{ ui, &w, &dev, sc, camera, dt }                             // after the scene is synced
//   ingame::draw{ ui, &w, &dev, &frame }                                       // after the scene, before submit
namespace ingame {
    struct Ingame {
        heap: *mut heap::Heap,
        cache: *mut material::Cache,        // the GUI's textures: panels, portraits, icons
        gui: gui::Gui,                      // shared with whoever else shows panels in game
        hud: hud::Hud,
        selfs: selfslots::State,            // the HUD's four self action slots
        text: utf8::Builder(heap::Heap),    // scratch for formatted text
        width: i32, height: i32,            // the render size in pixels
        gui_scale: f32,                     // the GUI Scale option: 0 fits the window, 1 the original's pixels
        menu: i32,                          // the open menu (MENU_*), NO_MENU
        menu_panel: u32,                    // its panel and the tab bar's, 0 when none
        top_panel: u32,
        menus: Menus,
        pause_panel: u32,                   // the "PAUSED" banner, 0 when not shown
        screens: screens::State,            // the store, loot, level-up, workbench and galaxy map panels (lib/screens)
        hud_hidden: bool,
        psel_wait: bool,                    // ShowPartySelectionGUI asked: the screen opens when no conversation is up
        psel_exit: resref::ResRef,          // its exit script, forced slots
        psel_force1: i32, psel_force2: i32,
        psel_paused: bool,                  // the party selection screen holds the menu pause (it is up even with no menu)
        bot: bot::Bot,                      // the headless test player (bot.ctx); off unless a script turns it on
        shift_held: bool,                   // Shift (AlternateActions): with a slot's key it steps through the slot's choices
        ctrl_held: bool,                    // Ctrl (Lookabout): the camera follows the mouse (lib/scene/camera, play.ctx)
        solo_box: msgbox::Box,              // "Do you wish to turn Solo Mode on?", up while the question is asked
        solo_pause: bool,                   // the box paused the game and must unpause it
        focus_paused: bool,                 // the window lost the focus and the game was running: it resumes on return
        run_script: resref::ResRef,         // a script the loop should run when it can (no caller), empty when none
        right_held: bool,                   // the right mouse button is down (Lookabout too)
        look_x: i32,                        // mouse counts since the camera last asked, while the mouse turns it
        looking: bool,                      // the mouse is turning the camera (cursor hidden)
        freelook: bool,                     // free look (Caps Lock): the eye in the leader's head, the HUD hidden
        look_y: i32,                        // mouse counts up and down since the camera last asked (free look's pitch)
        turn_to: u32,                       // Q or E picked this object: the camera should swing round to it
        mouse_look: bool,                   // the "Mouse Look" option: Lookabout then gives the cursor back
        mouse_sens: i32,                    // "Mouse Sensitivity", 0..100
        reverse_buttons: bool,              // "Reverse Mouse Buttons": left and right swap
        autopause: bool,                    // the auto-pause triggers run (a person is playing: off in headless runs)
        ap_enemy: bool, ap_mine: bool, ap_party: bool, ap_target: bool, ap_round: bool, ap_action_menu: bool,    // [Autopause Options]
        party_alive: i32,                   // party members on their feet last frame
        ap_cooldown: f32,                   // seconds before "Party Member Down" may pause again
        pause_reason: u32,                  // the banner's text (dialog.tlk) for the next pause
        mine_quiet: f32,                    // seconds no hostile mine has been in sight (mine_watch.ctx)
    }

    // What the camera takes from the mouse each frame (CameraInputMouseYaw, movement.md 2.3).
    struct CameraInput { yaw_degrees: f32, pitch_degrees: f32, edge: f32, looking: bool, freelook: bool }

    // Opens the interface for a window of `width` x `height`. `scratch` is the texture decoder's
    // working memory (the scene's may be shared: loads never overlap).
    fn make {
        mut w: world::World, mut dev: gpu::Device, mixer: ?*mut mix::Mixer, scratch: alloc::Bytes, width: i32, height: i32,
        settings: []u8, gui_scale: f32,
    } -> !*mut Ingame {
        let cache = try alloc::new(material::Cache, heap::Heap){ realloc = heap::alloc, heap = w.heap, value = material::new_cache{ heap = w.heap, scratch } }
        let mut g = try gui::make{ heap = w.heap, rm = w.rm.*, cache, width, height }
        if w.tlk != null {
            let tb = w.tlk ifnull { return gui::no_such_gui{ name = "dialog.tlk" } }
            let t = try alloc::new(tlk::Table, heap::Heap){ realloc = heap::alloc, heap = w.heap, value = tb }
            gui::set_tlk{ &g, table = t }
        }
        try gui::load_defaults{ &g, fs = &w.fs, &dev }
        gui::set_screen{ &g, fs = &w.fs, &dev, width, height, scale = gui_scale }
        // The game options the rules read: Auto Level Up NPCs and the difficulty (the options menu keeps them current).
        let saved = frontend::load_settings{ fs = &w.fs, heap = w.heap, path = settings }
        w.rules.settings.auto_level = saved.auto_level_up
        w.rules.settings.difficulty = saved.difficulty
        if mixer != null { gui::set_mixer{ &g, mixer } }
        let mut h = try hud::open{ &g, &w, &dev }
        h.floating.enabled = saved.floating_numbers
        let ui = Ingame{
            heap = w.heap, cache, gui = g, hud = h, selfs = selfslots::new{},
            text = utf8::Builder(heap::Heap){ bytes = list::new(u8, heap::Heap){ realloc = heap::alloc, heap = w.heap } },
            width, height, gui_scale, menu = NO_MENU, menu_panel = 0, top_panel = 0, menus = new_menus{},
            pause_panel = 0, hud_hidden = false, screens = screens::new{}, bot = bot::new{},
            shift_held = false, ctrl_held = false, solo_box = msgbox::blank{}, solo_pause = false, focus_paused = false, run_script = resref::empty{},
            right_held = false, look_x = 0, look_y = 0, looking = false, freelook = false, turn_to = obj::INVALID, mouse_look = saved.mouse_look, mouse_sens = saved.mouse_sensitivity, reverse_buttons = saved.reverse_buttons,
            autopause = false, ap_enemy = saved.pause_enemy_sighted, ap_mine = saved.pause_mine_sighted, ap_party = saved.pause_party_killed,
            ap_target = saved.pause_triggers, ap_round = saved.pause_end_round, ap_action_menu = saved.pause_action_menu,
            party_alive = 0, ap_cooldown = 0.0, pause_reason = REASON_PAUSED,
            psel_wait = false, psel_exit = resref::empty{}, psel_force1 = -1, psel_force2 = -1, psel_paused = false,
            mine_quiet = 1000.0,
        }
        let mut p = try alloc::new(Ingame, heap::Heap){ realloc = heap::alloc, heap = w.heap, value = ui }
        options_panel::set_config{ s = &p.menus.options, path = settings }
        // The option screens' state exists from the start, so the engine can tell it what the display offers.
        try options_panel::make_front{ s = &p.menus.options, &w }
        hud::set_tooltips{ h = &p.hud, g = &p.gui, &w, text = &p.text }
        return p
    }

    // The option screens' front end: its settings are what the Graphics panels edit.
    fn options_front { mut ui: Ingame } -> ?*mut frontend::Front { return ui.menus.options.fe }

    // Once, after the player changed a graphics option in the options menu: the settings to make the
    // device agree with. The caller may correct them (a mode the display refused).
    fn take_display_change { mut ui: Ingame } -> ?*mut frontend::Settings {
        if not options_panel::take_display_change{ s = &ui.menus.options } { return null }
        let fe = ui.menus.options.fe ifnull { return null }
        return &fe.settings
    }

    // Closes every panel and frees the interface (a module change makes a new one).
    fn free { mut ui: Ingame, mut dev: gpu::Device } {
        gui::free{ g = &ui.gui }
        screens::free{ s = &ui.screens, heap = ui.heap }
        list::free{ list = &ui.text.bytes }
        material::free_cache{ cache = ui.cache, &dev }
    }

    // The window changed size: the device and the GUI follow, and the HUD is opened again for the
    // new size (its layout is fitted to the window).
    fn resize { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, width: i32, height: i32 } {
        if width < 320 or height < 240 { return }
        gpu::resize{ &dev, width = @as(u32, width), height = @as(u32, height) } iferr { return }
        relayout{ &ui, &w, &dev, width, height }
    }

    // The GUI Scale option changed (0 fits the window); `relayout` then applies it.
    fn set_gui_scale { mut ui: Ingame, scale: f32 } { ui.gui_scale = scale }

    // The render size or the GUI scale changed and the device already follows: the GUI's pixel space
    // and the HUD, fitted to it, are made again.
    fn relayout { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, width: i32, height: i32 } {
        if width < 320 or height < 240 { return }
        ui.width = width
        ui.height = height
        gui::set_screen{ g = &ui.gui, fs = &w.fs, &dev, width, height, scale = ui.gui_scale }
        let was_hidden = ui.hud_hidden
        hud::close{ h = &ui.hud, g = &ui.gui, &dev }
        let h = hud::open{ g = &ui.gui, &w, &dev } iferr err{ error } {
            _ = @fmt(&w.io, "kotor: HUD: {}\n", error)
            return
        }
        ui.hud = h
        ui.selfs = selfslots::new{}
        hud::set_tooltips{ h = &ui.hud, g = &ui.gui, &w, text = &ui.text }
        set_hud_hidden{ &ui, hidden = was_hidden }
    }

    // Hides or shows the HUD (a conversation covers the screen with its own panels).
    fn set_hud_hidden { mut ui: Ingame, hidden: bool } {
        ui.hud_hidden = hidden
        hud::set_hidden{ h = &ui.hud, g = &ui.gui, hidden }
    }

    // Whether the world should not be picked or clicked: a menu or modal panel is up, or the HUD
    // is hidden.
    fn is_blocked { mut ui: Ingame } -> bool {
        return ui.menu != NO_MENU or ui.hud_hidden or gui::is_modal_open{ g = &ui.gui } or screens::is_open{ s = &ui.screens }
    }

    // Whether the UI is in the middle of something (--speed lets an idle UI skip ticks, not this one).
    fn is_busy { mut ui: Ingame } -> bool {
        return ui.psel_wait or screens::is_waiting{ s = &ui.screens } or is_blocked{ &ui }
    }

    // The test player's step alone: --speed runs the rest of the UI once per N ticks, the bot decides every tick.
    fn step_bot { mut ui: Ingame, mut w: world::World } {
        bot::step{ b = &ui.bot, &w }
    }

    // Whether the player confirmed Exit Game in the options menu: the loop should end.
    fn wants_quit { ui: *Ingame } -> bool {
        return ui.menus.options.quit
    }

    // The options menu's Save Game, once: the name to save under (a new slot; "QUICKSAVE" and
    // "AUTOSAVE" are the game's own slots) for save::save_named. The menus closed themselves when
    // it was chosen, so the frame that is then saved is the game's. The bytes stay valid until the
    // next request.
    fn take_save_request { mut ui: Ingame } -> ?[]u8 {
        return options_panel::take_save{ s = &ui.menus.options }
    }

    // The options menu's Load Game, once: the folder (a path) of the save for save::find_save.
    // The menus have closed.
    fn take_load_request { mut ui: Ingame } -> ?[]u8 {
        return options_panel::take_load{ s = &ui.menus.options }
    }

    // ---- events

    // Offers a platform event to the interface; true when it used it, so the game does not also
    // treat it as a key or a world click.
    fn handle_event { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, ev: sdl::Event, scale_x: f32, scale_y: f32 } -> bool {
        // "Reverse Mouse Buttons" swaps what left and right do, for everything downstream.
        let mut turned = ev
        if ui.reverse_buttons and ev is mouse_button{ down, button, clicks, x, y } {
            if button == sdl::BUTTON_LEFT { turned = sdl::Event::mouse_button{ down, button = sdl::BUTTON_RIGHT, clicks, x, y } }
            else if button == sdl::BUTTON_RIGHT { turned = sdl::Event::mouse_button{ down, button = sdl::BUTTON_LEFT, clicks, x, y } }
        }
        // The mouse turns the camera while Lookabout (Ctrl or the right button) is held, or all the time
        // with the Mouse Look option and Lookabout gives the cursor back.
        if turned is mouse_button{ down, button } {
            if button == sdl::BUTTON_RIGHT { ui.right_held = down }
        }
        if turned is mouse_motion{ dx, dy } {
            if ui.looking {
                ui.look_x = ui.look_x + dx
                ui.look_y = ui.look_y + dy
            }
        }
        return handle_turned{ &ui, &w, &dev, ev = turned, scale_x, scale_y }
    }

    fn handle_turned { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, ev: sdl::Event, scale_x: f32, scale_y: f32 } -> bool {
        // Switching to another window pauses the game, coming back resumes it unless it was already paused
        // (OnAppDeactivate 0x00401d90, OnAppActivate 0x00401e00). Held keys and buttons are let go: their
        // key-up goes to the other window.
        if ev is focus{ gained } {
            if not gained {
                ui.shift_held = false
                ui.hud.alternate = false
                ui.ctrl_held = false
                ui.right_held = false
                if ui.autopause and not clock_paused_by_player{ w = &w } and w.transition == null {
                    set_player_pause{ &ui, &w, &dev, on = true }
                    ui.focus_paused = true
                }
            } else if ui.focus_paused {
                ui.focus_paused = false
                if clock_paused_by_player{ w = &w } { set_player_pause{ &ui, &w, &dev, on = false } }
            }
            return false
        }
        // Keys first: the menu keys, Escape and pause work with or without a menu open, and a menu
        // (a full-screen panel) would otherwise take every key.
        if ev is key{ down, repeat, keycode } {
            if keycode == sdl::key::LSHIFT or keycode == sdl::key::RSHIFT {
                ui.shift_held = down
                ui.hud.alternate = down
            }
            if keycode == sdl::key::LCTRL or keycode == sdl::key::RCTRL { ui.ctrl_held = down }
            if down and not repeat {
                if handle_key{ &ui, &w, &dev, keycode } { return true }
            }
        }
        if ev is resized{ width, height } {
            resize{ &ui, &w, &dev, width, height }
            return false
        }
        if gui::handle_event{ g = &ui.gui, ev, scale_x, scale_y } { return true }
        if is_blocked{ &ui } { return false }
        // Past the GUI: the pointer on the world's objects.
        if ev is mouse_button{ down, button, x, y } {
            if button != sdl::BUTTON_LEFT or ui.looking { return false }
            let ux = gui::to_ui{ v = x, s = scale_x, scale = ui.gui.scale }
            let uy = gui::to_ui{ v = y, s = scale_y, scale = ui.gui.scale }
            return hud::world_click{ h = &ui.hud, g = &ui.gui, &w, x = ux, y = uy, down }
        }
        return false
    }

    // The game's keys (keymap.2da's defaults, docs/mechanics/controls.md): menus on U I P K J L M O, Escape
    // closes the open menu or opens the options, Q and E step through the menus or the targets, Space and
    // Pause pause, Tab changes the leader, V asks about solo mode, 1-3 and 4-7 run the target block's and the
    // self slots' choices (with Shift they step to the next choice), R the target's default action, F leaves
    // combat, Y drops the last queued action. True when the key was used.
    fn handle_key { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, keycode: i32 } -> bool {
        // Free look (Caps Lock, only with nothing queued for the leader and the game running) and the keys that
        // leave it: the same key, a menu key, Escape, pause, Q and E (HandleInputAction 0xd0, 0xd1-0xd8, 0xe0,
        // 0xcc/0xcd, 0xdf).
        if keycode == sdl::key::CAPSLOCK {
            if ui.freelook {
                ui.freelook = false
            } else if not ui.hud_hidden and ui.menu == NO_MENU and not gui::is_modal_open{ g = &ui.gui } and not clock_paused_by_player{ w = &w } {
                let lead = world::object{ w = &w, id = party::leader{ w = &w } }
                if lead != null and lead.actions.len == 0 { ui.freelook = true }
            }
            return true
        }
        if ui.freelook and (menu_of_key{ keycode } >= 0 or keycode == sdl::key::ESCAPE or keycode == sdl::key::PAUSE or keycode == 'q' or keycode == 'e') {
            ui.freelook = false
            set_hud_hidden{ &ui, hidden = w.conversation.active }
        }
        if ui.hud_hidden or gui::is_modal_open{ g = &ui.gui } { return false }
        if keycode == sdl::key::ESCAPE {
            // A panel in a sub-mode (the equipment's slot selection) takes Escape as its Cancel.
            if ui.menu != NO_MENU and panel_escape{ &ui, &w, &dev } { return true }
            if ui.menu != NO_MENU { close_menu{ &ui, &w } } else { open_menu{ &ui, &w, &dev, n = MENU_OPTIONS } }
            return true
        }
        let n = menu_of_key{ keycode }
        if n >= 0 {
            if ui.menu == n { close_menu{ &ui, &w } } else { open_menu{ &ui, &w, &dev, n } }
            return true
        }
        // ChangeChar works in the world and in the menus (ICPC and ICPCGUI); a menu shows the new leader.
        if keycode == sdl::key::TAB {
            if cycle_leader{ &w } {
                gui::play_sound{ g = &ui.gui, n = 6 }
                if ui.menu != NO_MENU { fill_panel{ &ui, &w, &dev, n = ui.menu, panel = ui.menu_panel } }
            }
            return true
        }
        if ui.menu != NO_MENU {
            if keycode == 'q' or keycode == 'e' {
                let step = if keycode == 'e' { 1 } else { MENU_COUNT - 1 }
                open_menu{ &ui, &w, &dev, n = (ui.menu + step) % MENU_COUNT }
                return true
            }
            return false
        }
        if keycode == 'q' or keycode == 'e' {
            hud::cycle_target{ &w, forward = keycode == 'e' }
            ui.turn_to = w.target
            return true
        }
        if keycode == 'r' {
            return hud::run_default{ h = &ui.hud, &w }
        }
        if keycode >= '1' and keycode <= '3' {
            // The target block's three slots (keymap.2da: TargetLeft/Middle/RightAct).
            let k = @as(usize, keycode - '1')
            if ui.shift_held {
                hud::cycle_slot{ h = &ui.hud, g = &ui.gui, &w, &dev, k, forward = true }
                return true
            }
            return hud::use_slot{ h = &ui.hud, g = &ui.gui, &w, k }
        }
        if keycode >= '4' and keycode <= '7' {
            // The four self slots: 4 friendly powers, 5 medical items, 6 other items, 7 mines.
            let k: usize = if keycode == '4' { 0 } else if keycode == '5' { 1 } else if keycode == '6' { 2 } else { 3 }
            if ui.shift_held {
                selfslots::cycle{ s = &ui.selfs, g = &ui.gui, &w, &dev, panel = ui.hud.panel, k, forward = true }
            } else {
                selfslots::use_slot{ s = &ui.selfs, g = &ui.gui, &w, panel = ui.hud.panel, k }
            }
            return true
        }
        if keycode == sdl::key::SPACE or keycode == sdl::key::PAUSE {
            set_player_pause{ &ui, &w, &dev, on = not clock_paused_by_player{ w = &w } }
            gui::play_sound{ g = &ui.gui, n = 6 }
            return true
        }
        if keycode == 'v' {
            ask_solo{ &ui, &w, &dev, for_stealth = false }
            return true
        }
        if keycode == 'f' {
            hud::disengage{ &w }
            return true
        }
        if keycode == 'y' {
            hud::clear_one{ &w }
            return true
        }
        // keymap.2da: G stealth (action 264).
        if keycode == 'g' {
            request_stealth{ &ui, &w, &dev, from_key = true }
            return true
        }
        return false
    }

    // Solo mode (ShowSoloModeConfirm, re/gui.md): with more than one in the party, no conversation and a
    // leader who can act, the game pauses and a box asks whether to turn solo mode on or off; anything
    // else is a refusal sound. Asked `for_stealth` (stealth_ui.ctx), it says stealth needs solo mode
    // (SetMode 0x006c24a0 picks 37889 on, 37890 for stealth, 37891 off, 37892 off ending stealth).
    fn ask_solo { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, for_stealth: bool } {
        if w.party.count < 2 or w.conversation.active or hud::is_down{ w = &w, id = party::leader{ w = &w } } or msgbox::is_open{ b = ui.solo_box } {
            gui::play_sound{ g = &ui.gui, n = 2 }
            return
        }
        if not clock_paused_by_player{ w = &w } {
            set_player_pause{ &ui, &w, &dev, on = true }
            ui.solo_pause = true
        }
        let mut strref: u32 = if w.party.solo { 37891 } else { 37889 }
        if for_stealth { strref = 37890 }
        else if w.party.solo and stealth::is_on{ w = &w, id = party::leader{ w = &w } } { strref = 37892 }
        ui.solo_box = msgbox::show_strref{ g = &ui.gui, &w, &dev, strref, cancel = true, what = if for_stealth { SOLO_FOR_STEALTH } else { 0 }, item = 0 }
    }

    // The box's answer: OK flips solo mode (off takes the party out of stealth) and, asked for stealth,
    // then toggles the leader's; either way the box goes and the game runs on again.
    fn answer_solo { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, ev: gui::Event } {
        let a = msgbox::answer{ b = ui.solo_box, ev }
        if a == msgbox::Answer::none { return }
        let for_stealth = ui.solo_box.what == SOLO_FOR_STEALTH
        close_solo{ &ui, &w, &dev }
        if a == msgbox::Answer::ok {
            stealth::set_solo{ &w, on = not w.party.solo }
            ui.run_script = resref::truncate{ name = "k_sup_solo" }
            if for_stealth { stealth::toggle{ &w, id = party::leader{ w = &w } } }
        }
    }

    // The box goes, and the game runs on again if it paused it.
    fn close_solo { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device } {
        msgbox::close{ g = &ui.gui, b = &ui.solo_box }
        ui.solo_box = msgbox::blank{}
        if ui.solo_pause { set_player_pause{ &ui, &w, &dev, on = false } }
        ui.solo_pause = false
    }

    // The start of a frame: what the panels said last frame has been seen by now.
    fn begin_frame { mut ui: Ingame } {
        gui::clear_events{ g = &ui.gui }
    }

    // Text the game wants shown (docs/design/engine.md, the outbox): feedback goes to the log and
    // the lines on the HUD.
    fn take { mut ui: Ingame, mut w: world::World, note: outbox::Note } {
        screens::take{ s = &ui.screens, &w, note }
        match note {
            party_selection{ exit_script, force1, force2 } => {
                ui.psel_wait = true
                ui.psel_exit = exit_script
                ui.psel_force1 = force1
                ui.psel_force2 = force2
            }
            hud_notice{ kind } => {
                if kind >= 0 { notify{ &ui, which = @as(usize, kind) } }
            }
            feedback{ strref, text } => {
                let sent = outbox::text_of{ out = &w.out, t = text }
                let said = if sent.len > 0 { sent } else { world::string_by_strref{ w = &w, strref } }
                // The combat log's lines go to Messages only; the attack summary is red there.
                let kind = if fight_log::is_summary{ strref } { messages_panel::KIND_FEEDBACK_RED } else if fight_log::is_combat_line{ strref } { fight_log::LOG_COMBAT } else { hud::LOG_FEEDBACK }
                if said.len > 0 { hud::log_add{ log = &w.messages, text = said, kind } }
            }
            floating_text{ object, kind, amount } => {
                hud::add_float{ h = &ui.hud, g = &ui.gui, &w, object, kind, amount }
            }
            else => {}
        }
    }

    // An event the player should notice: turns on one of the HUD's notification icons for four
    // seconds (hud::NOTE_*: journal updated, credits, experience, alignment shift, item received
    // or lost). The engine's routines that cause them call this through the outbox once it carries
    // them; until then `ui flash N` shows each.
    fn notify { mut ui: Ingame, which: usize } {
        hud::flash_icon{ h = &ui.hud, which }
    }

    // ---- the camera's share of the mouse

    // Called once a frame by the loop before the camera updates: the yaw the mouse asks for this frame
    // (mouse counts / 100 clamped to one, times 10 + 0.45 * the sensitivity slider, degrees; the mouse
    // moving right turns the view right), and the screen-edge turn (a cursor within max(2, width / 1000)
    // pixels of the left or right edge acts as the rotate key: +1 turns left) when the mouse is not
    // turning the camera. UpdateCameraInput 0x005f5e10, movement.md 2.3.
    fn camera_input { mut ui: Ingame } -> CameraInput {
        let held = ui.ctrl_held or ui.right_held
        // Free look hides the HUD itself, so that does not count as the interface being in the way.
        let usable = not (ui.menu != NO_MENU or gui::is_modal_open{ g = &ui.gui } or screens::is_open{ s = &ui.screens } or (ui.hud_hidden and not ui.freelook))
        let looking = usable and (ui.freelook or (if ui.mouse_look { not held } else { held }))
        ui.looking = looking
        gui::set_cursor_visible{ g = &ui.gui, visible = not looking }
        let counts = ui.look_x
        let counts_y = ui.look_y
        ui.look_x = 0
        ui.look_y = 0
        let mut yaw: f32 = 0.0
        let mut pitch: f32 = 0.0
        if looking {
            let scale = 10.0 + 0.45 * @as(f32, ui.mouse_sens)
            yaw = -math::clamp{ x = @as(f32, counts) / 100.0, lo = -1.0, hi = 1.0 } * scale
            pitch = -math::clamp{ x = @as(f32, counts_y) / 100.0, lo = -1.0, hi = 1.0 } * scale
        }
        let mut edge: f32 = 0.0
        if usable and not looking {
            let margin: i32 = if ui.width / 1000 > 2 { ui.width / 1000 } else { 2 }
            if ui.gui.mouse_x <= margin { edge = 1.0 }
            else if ui.gui.mouse_x >= ui.width - margin { edge = -1.0 }
        }
        return CameraInput{ yaw_degrees = yaw, pitch_degrees = pitch, edge, looking, freelook = ui.freelook and usable }
    }

    // How fast the keys move the leader after this tick's control step: the larger of the velocity's two
    // components (CSWCPlayerControl::GetCurrentSpeed 0x00679750). The HUD drops a target a leader on the move
    // has kept for half a second (hud/autotarget.ctx).
    fn set_move_speed { mut ui: Ingame, speed: f32 } {
        ui.hud.move_speed = speed
    }

    // The object Q or E just picked, once: the loop tells the camera to swing round to it.
    fn take_turn_to { mut ui: Ingame } -> u32 {
        let id = ui.turn_to
        ui.turn_to = obj::INVALID
        return id
    }

    // ---- pause

    fn clock_paused_by_player { w: *world::World } -> bool {
        return (w.clock.pause_bits & clock::PAUSE_PLAYER) != 0
    }

    // The player's pause (Space, the HUD's toggle): the clock stops and a banner says so.
    fn set_player_pause { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, on: bool } {
        clock::set_pause{ c = &w.clock, bit = clock::PAUSE_PLAYER, on }
        gui::set_checked{ g = &ui.gui, panel = ui.hud.panel, tag = "TB_PAUSE", on }
        if on and ui.pause_panel == 0 and ui.menu == NO_MENU {
            let p = gui::open{ g = &ui.gui, fs = &w.fs, &dev, name = "pause", mode = gui::Mode::placed, modal = false } iferr { 0 }
            ui.pause_panel = p
            let pp = gui::find_panel{ g = &ui.gui, id = p } ifnull { return }
            pp.x = (ui.gui.ui_w - pp.w) / 2
            pp.y = ui.gui.ui_h / 6
            gui::place{ g = &ui.gui, p = pp }
            if ui.pause_reason == REASON_PAUSED {
                gui::set_strref{ g = &ui.gui, panel = p, tag = "LBL_PAUSEREASON", strref = ui.pause_reason } iferr {}
            } else {
                // An automatic pause says why, and its text carries the instruction itself, so the panel's own
                // "press the pause button" line goes and the box grows to hold the text (CSWGuiPause::SetReason);
                // "<Pause>" is the key's name.
                let raw = world::string_by_strref{ w = &w, strref = ui.pause_reason }
                ui.text.bytes.len = 0
                let token: []u8 = "<Pause>"
                let mut at: usize = 0
                while at < raw.len {
                    if at + token.len <= raw.len and slice::eq_bytes{ a = raw[at..at + token.len], b = token } {
                        _ = @fmt(&ui.text, "Space")
                        at = at + token.len
                    } else {
                        list::push{ list = &ui.text.bytes, item = raw[at] } iferr {}
                        at = at + 1
                    }
                }
                gui::set_text{ g = &ui.gui, panel = p, tag = "LBL_PAUSEREASON", text = utf8::view{ b = ui.text }.bytes } iferr {}
                gui::set_visible{ g = &ui.gui, panel = p, tag = "LBL_PRESS", visible = false }
                let reason_label = gui::find_control{ g = &ui.gui, panel = p, tag = "LBL_PAUSEREASON" }
                if reason_label != null { reason_label.h = 80 }
                let button = gui::find_control{ g = &ui.gui, panel = p, tag = "BTN_UNPAUSE" }
                if button != null { button.h = 86 }
                pp.h = 90
            }
            ui.pause_reason = REASON_PAUSED
        } else if not on and ui.pause_panel != 0 {
            gui::close{ g = &ui.gui, id = ui.pause_panel }
            ui.pause_panel = 0
        }
    }

    // ---- auto-pause (re/gameloop.md 6.4, [Autopause Options])

    // The banner texts (dialog.tlk) by reason.
    const REASON_PAUSED: u32 = 1508
    const REASON_ENEMY: u32 = 48212          // "ENEMY SIGHTED! Press the Pause key to continue"
    const REASON_PARTY_DOWN: u32 = 42397     // "Party Member Down"
    const REASON_TARGET: u32 = 42481         // "Target Changed"
    const REASON_MENU: u32 = 42482           // "Menu Used"
    const REASON_ROUND: u32 = 42432          // "End of Combat Round"
    const REASON_MINE: u32 = 49118           // "MINE SIGHTED! Press the Pause button to continue"

    // Pauses for `reason` unless the game is already paused, a conversation or a menu has the screen, or
    // a module change is coming (RequestAutoPause 0x005f3f10).
    fn auto_pause { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, reason: u32 } {
        if clock_paused_by_player{ w = &w } or w.conversation.active or ui.menu != NO_MENU or ui.hud_hidden { return }
        if w.transition != null or w.arrival > 0 or is_blocked{ &ui } { return }
        ui.pause_reason = reason
        if w.log.objects {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "auto-pause: {} (target {})\n", reason, w.target)
        }
        set_player_pause{ &ui, &w, &dev, on = true }
    }

    // Every frame: the first request of the frame from the engine and the HUD (autopause::request: an
    // enemy sighted, a party member down, a slot's choice stepped, the end of a round, a new target) is
    // weighed against the options and a person playing.
    fn update_autopause { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, dt: f32 } {
        if ui.ap_cooldown > 0.0 { ui.ap_cooldown = ui.ap_cooldown - dt }
        let asked = autopause::take{ &w }
        if asked == 0 or not ui.autopause { return }
        // The option of each reason ([Autopause Options]); a new target only counts in combat mode
        // (HandleInputAction 0xcc/0xcd), and a member down pauses once a second or two.
        let mut text: u32 = 0
        if asked == autopause::ENEMY_SIGHTED { if ui.ap_enemy { text = REASON_ENEMY } }
        else if asked == autopause::ACTION_MENU { if ui.ap_action_menu { text = REASON_MENU } }
        else if asked == autopause::PARTY_MEMBER_DOWN { if ui.ap_party and ui.ap_cooldown <= 0.0 { text = REASON_PARTY_DOWN } }
        else if asked == autopause::MINE_SIGHTED { if ui.ap_mine { text = REASON_MINE } }
        else if asked == autopause::END_OF_ROUND { if ui.ap_round { text = REASON_ROUND } }
        else if asked == autopause::NEW_TARGET { if ui.ap_target and hud::leader_in_combat{ w = &w } { text = REASON_TARGET } }
        if text == 0 { return }
        if asked == autopause::PARTY_MEMBER_DOWN { ui.ap_cooldown = 2.0 }
        auto_pause{ &ui, &w, &dev, reason = text }
    }

    // ---- the frame

    // One frame after the world's: the GUI's clocks, the HUD from the world, then what the panels
    // said.
    fn update { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, sc: scene::Scene, camera: cam::Camera, dt: f32 } {
        gui::update{ g = &ui.gui, dt }
        bot::step{ b = &ui.bot, &w }
        hud::log_tick{ log = &w.messages, dt }
        if options_panel::settings{ s = &ui.menus.options } is some{ value = st } {
            w.rules.settings.auto_level = st.auto_level_up
            w.rules.settings.difficulty = st.difficulty
            ui.hud.floating.enabled = st.floating_numbers
            ui.mouse_look = st.mouse_look
            ui.mouse_sens = st.mouse_sensitivity
            ui.reverse_buttons = st.reverse_buttons
            ui.ap_enemy = st.pause_enemy_sighted
            ui.ap_mine = st.pause_mine_sighted
            ui.ap_party = st.pause_party_killed
            ui.ap_target = st.pause_triggers
            ui.ap_round = st.pause_end_round
            ui.ap_action_menu = st.pause_action_menu
        }
        update_autopause{ &ui, &w, &dev, dt }
        // A conversation or cutscene takes the screen: the HUD and any menu go away for it
        // (re/gui.md, "SetHudMode"), and the world is not picked.
        // Free look leaves when the leader is given something to do (it needs an empty queue to start).
        if ui.freelook {
            let lead = world::object{ w = &w, id = party::leader{ w = &w } }
            if lead == null or lead.actions.len > 0 or w.conversation.active { ui.freelook = false }
        }
        // A cutscene's picture is held a moment after it ends (dlgview), so the HUD does not show between it and the next conversation.
        let wants_hidden = w.conversation.active or w.conversation.hold or ui.freelook
        if wants_hidden != ui.hud_hidden {
            if w.conversation.active and ui.menu != NO_MENU { close_menu{ &ui, &w } }
            set_hud_hidden{ &ui, hidden = wants_hidden }
        }
        let aspect = @as(f32, ui.width) / @as(f32, ui.height)
        // A conversation covers the screen with its own panels.
        ui.hud.looking = ui.looking
        hud::update{ h = &ui.hud, g = &ui.gui, &w, &dev, text = &ui.text, camera, aspect, blocked = is_blocked{ &ui }, dt }
        // The auto-target's picks that turn the camera (an enemy coming into sight, a pick in combat mode) go the way Q and E do.
        if ui.hud.swing_to != obj::INVALID {
            ui.turn_to = ui.hud.swing_to
            ui.hud.swing_to = obj::INVALID
        }
        selfslots::update{ s = &ui.selfs, g = &ui.gui, &w, &dev, panel = ui.hud.panel, dt, combat_message = ui.hud.combat and ui.hud.combat_message > 0.0 }
        let events = gui::take_events{ g = &ui.gui }
        let mut i: usize = 0
        while i < events.len {
            let ev = events[i]
            i = i + 1
            answer_solo{ &ui, &w, &dev, ev }
            if ev.panel == ui.hud.panel { hud_event{ &ui, &w, &dev, ev } }
            else if ev.panel == ui.pause_panel and ev.kind == gui::EventKind::activate { set_player_pause{ &ui, &w, &dev, on = false } }
        }
        if not ui.hud_hidden { watch_mines{ &ui, &w, dt } }
        check_solo_box{ &ui, &w, &dev }
        // The pause banner follows the clock (a script or the toggle can change it).
        if ui.pause_panel != 0 and not clock_paused_by_player{ w = &w } {
            gui::close{ g = &ui.gui, id = ui.pause_panel }
            ui.pause_panel = 0
        }
        // A menu: its events (the list was taken above; the bar and panel ids tell which are its).
        if ui.menu != NO_MENU {
            menu_events{ &ui, &w, &dev, events }
            if ui.menu != NO_MENU { panel_update{ &ui, &w, &dev, n = ui.menu, panel = ui.menu_panel, dt } }
            // A game to save or load was chosen in the options: the menus go, the owner takes the request.
            if ui.menu == MENU_OPTIONS and options_panel::has_request{ s = &ui.menus.options } { close_menu{ &ui, &w } }
        }
        // The store, loot, level-up, workbench and galaxy map panels (lib/screens): one asked for
        // by a script closes the menu first.
        if screens::is_waiting{ s = &ui.screens } and ui.menu != NO_MENU { close_menu{ &ui, &w } }
        screens::update{ s = &ui.screens, g = &ui.gui, &w, &dev, events, dt }
        // The party selection screen (a script's ShowPartySelectionGUI), once the conversation that asked is over.
        if ui.psel_wait and not w.conversation.active and not gui::is_modal_open{ g = &ui.gui } {
            ui.psel_wait = false
            if ui.menu != NO_MENU { close_menu{ &ui, &w } }
            partysel_panel::open_modal{ s = &ui.menus.partysel, g = &ui.gui, &w, &dev, force1 = ui.psel_force1, force2 = ui.psel_force2, from_script = true, exit_script = ui.psel_exit } iferr err{ error } {
                _ = @fmt(&w.io, "kotor: party selection: {}\n", error)
            }
        }
        partysel_panel::update{ s = &ui.menus.partysel, g = &ui.gui, &w, &dev, dt }
        // The party selection screen stops the world while it is up, even when a script opened it with
        // no menu behind it (the bot walked 20,000 frames under it).
        let selecting = partysel_panel::is_open{ s = &ui.menus.partysel }
        if selecting and not ui.psel_paused {
            clock::set_pause{ c = &w.clock, bit = clock::PAUSE_MENU, on = true }
            ui.psel_paused = true
        } else if not selecting and ui.psel_paused {
            ui.psel_paused = false
            if ui.menu == NO_MENU and not screens::is_open{ s = &ui.screens } { clock::set_pause{ c = &w.clock, bit = clock::PAUSE_MENU, on = false } }
        }
        // The test bot accepts the screen after a short look at it (the picture a test takes is of the screen, not of the
        // world behind it).
        if ui.bot.party and partysel_panel::is_open{ s = &ui.menus.partysel } {
            ui.bot.party_wait = ui.bot.party_wait + 1
            if ui.bot.party_wait % 20 == 0 { partysel_panel::auto_accept{ s = &ui.menus.partysel, g = &ui.gui, &w, &dev } }
        } else {
            ui.bot.party_wait = 0
        }
    }

    // A script the interface wants run once, with no caller (the solo mode box's k_sup_solo): the owner
    // of the VM runs it.
    fn take_script_request { mut ui: Ingame } -> ?resref::ResRef {
        if resref::is_empty{ r = ui.run_script } { return null }
        let r = ui.run_script
        ui.run_script = resref::empty{}
        return r
    }

    // The exit script of a party selection that was just applied, once: the owner of the VM runs it
    // (scripts::run with no caller).
    fn take_exit_script { mut ui: Ingame } -> ?resref::ResRef {
        return partysel_panel::take_exit_script{ s = &ui.menus.partysel }
    }

    // What the HUD's own controls ask for: a menu, the pause toggle, a party portrait, the target
    // block's slots.
    fn hud_event { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, ev: gui::Event } {
        if selfslots::event{ s = &ui.selfs, g = &ui.gui, &w, &dev, panel = ui.hud.panel, ev } { return }
        if hud::block_event{ h = &ui.hud, g = &ui.gui, &w, &dev, ev } { return }
        if hud::combat_event{ h = &ui.hud, g = &ui.gui, &w, ev } { return }
        if ev.kind == gui::EventKind::activate {
            let n = menu_of_tag{ tag = ev.tag }
            if n >= 0 {
                open_menu{ &ui, &w, &dev, n }
                return
            }
            let who = hud::portrait_button{ tag = ev.tag }
            if who >= 0 {
                // A portrait: the leader's opens the equipment (or the character sheet), a
                // companion's makes it the leader.
                let ids = party::members{ w = &w }
                let member = hud::member_of_widget{ count = ids.len, widget = @as(usize, who) }
                if member == 0 { open_menu{ &ui, &w, &dev, n = MENU_EQUIP } }
                else if member > 0 { change_leader{ &w, step = @as(usize, member) } }
            }
        } else if ev.kind == gui::EventKind::value_changed and slice::eq_bytes{ a = ev.tag, b = "TB_PAUSE" } {
            set_player_pause{ &ui, &w, &dev, on = ev.value != 0 }
        } else if ev.kind == gui::EventKind::value_changed and slice::eq_bytes{ a = ev.tag, b = "TB_SOLO" } {
            // The toggle only asks (the box decides); the HUD sets the check mark from the party table.
            ask_solo{ &ui, &w, &dev, for_stealth = false }
        } else if ev.kind == gui::EventKind::value_changed and slice::eq_bytes{ a = ev.tag, b = "TB_STEALTH" } {
            // Stealth (stealth_ui.ctx); the check mark follows the leader next frame.
            request_stealth{ &ui, &w, &dev, from_key = false }
        }
    }

    // Adds the interface to the frame: the HUD's own render targets, then the panels.
    fn draw { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, mut frame: render::Frame } {
        if ui.menu == NO_MENU and not ui.hud_hidden { hud::draw{ h = &ui.hud, g = &ui.gui, &w, &dev, &frame, log = &w.messages } }
        // A menu that draws into a render target before the panels (the map's picture with its arrows).
        if ui.menu == MENU_MAP { map_panel::draw{ s = &ui.menus.map, g = &ui.gui, &w, &dev, &frame, panel = ui.menu_panel } }
        gui::draw_backdrop_pass{ g = &ui.gui, &frame }
        screens::draw_views{ s = &ui.screens, g = &ui.gui, &frame, target = gpu::screen_size{ dev } }
        gui::draw_panels{ g = &ui.gui, &frame }
        screens::draw_over{ s = &ui.screens, g = &ui.gui, &frame, target = gpu::screen_size{ dev } }
    }
}
