// A test player for headless playthroughs (tools/playthrough): while it is on, the leader fights
// what is hostile near it and otherwise walks a route of tagged objects (doors, waypoints, anything
// with a place), opening doors on the way. It stands in for a person with a mouse; it never
// runs in a real game (it starts off and only the input script turns it on).
//
//   FRAME ui bot route TAG...    the route (objects by tag, in order; a door is opened when reached; @TAG: talk to it when reached)
//   FRAME ui bot on | off        start / stop
//   FRAME ui bot unlock on|off   open the lock of a door before opening it (the story's own way is
//                                a key, a skill or a switch of the party leader)
//   FRAME ui bot god on|off      the leader and the companions never drop below 1 hit point
//   FRAME ui bot party on|off    a party selection screen is accepted (OK, and OK on the question) 0.7 s after it opens
//   FRAME ui bot tour            a route made of the area's own waypoints, doors, placeables, triggers and talkers (bot_tour.ctx)
//   FRAME ui bot status          where the route stands
namespace bot {
    const MAX_ROUTE: usize = 64
    const TAG_BYTES: usize = 40
    const EVERY: u32 = 10                       // frames between decisions
    const SIGHT: f32 = 16.0                     // metres within which it picks a fight
    const REACH: f32 = 2.0                      // close enough to a route stop
    const STUCK_TICKS: u32 = 240                // decisions on one stop before it gives up on it

    struct Bot {
        on: bool,
        unlock: bool,
        god: bool,                              // keeps the leader at 1 hit point at least, module after module
        party: bool,                            // accepts a party selection screen
        party_wait: u32,                        // ticks it has been open
        route: [64][40]u8,
        lens: [64]u8,
        count: usize,
        next: usize,
        tick: u32,
        waiting: u32,                           // decisions spent on the current stop
        foe: u32,                               // the one it last ordered an attack on
        stalled: u32,                           // decisions in a row that left it no nearer the stop: a closed door in the way
        last_dist: f32,
        area: u32,                              // the area it last decided in (0 before the first decision)
        talked: bool,                           // the current stop is a `@TAG` and the leader has been told to talk to it
        clicked: usize,                         // 1 + the route index of the transition door it clicked last (0 none)
        seen_open: bool,                        // the door of the current stop has been seen open (one the story shuts again is passed, not opened twice)
        trans_stop: bool,                       // the current stop is a trigger that starts an area transition (crossing it is reaching it)
        best: f32,                              // the nearest the leader has been to the current stop: a long walk is not a stuck one
        tour: Tour,                             // the area's own route, when `bot tour` made one
    }

    fn new {} -> Bot {
        return Bot{ on = false, unlock = false, god = false, party = false, party_wait = 0, route = [[0; 40]; 64], lens = [0; 64], count = 0, next = 0, tick = 0, waiting = 0, foe = obj::INVALID, seen_open = false, stalled = 0, last_dist = 0.0, area = 0, talked = false, clicked = 0, trans_stop = false, best = 1000000.0, tour = new_tour{} }
    }

    // The `bot ...` input line, after the word `bot`.
    fn run_command { mut b: Bot, mut w: world::World, args: []u8 } {
        let mut words = text::words{ s = args }
        let what = text::next_word{ &words } ifnull { return }
        if ci::eq{ a = what, b = "route" } {
            b.count = 0
            b.next = 0
            b.waiting = 0
            while b.count < MAX_ROUTE {
                let tag = text::next_word{ &words } ifnull { break }
                let n = if tag.len > TAG_BYTES { TAG_BYTES } else { tag.len }
                slice::copy(u8){ dst = b.route[b.count][..n], src = tag[..n] }
                b.lens[b.count] = @trunc(u8, n)
                b.count = b.count + 1
            }
        } else if ci::eq{ a = what, b = "tour" } {
            // `tour` builds the tour of the area and walks it; `tour off` leaves it (a route can take over).
            if ci::eq{ a = text::next_word{ &words } ifnull "", b = "off" } { b.tour.on = false } else { tour_build{ &b, &w } }
        } else if ci::eq{ a = what, b = "on" } {
            b.on = true
        } else if ci::eq{ a = what, b = "off" } {
            b.on = false
        } else if ci::eq{ a = what, b = "unlock" } {
            b.unlock = on_word{ words = &words }
        } else if ci::eq{ a = what, b = "party" } {
            b.party = on_word{ words = &words }
        } else if ci::eq{ a = what, b = "god" } {
            b.god = on_word{ words = &words }
        } else if ci::eq{ a = what, b = "status" } {
            if b.tour.on {
                _ = @fmt(&w.io, "bot: tour of {} stops, at {}", b.tour.count, b.tour.next)
                if b.tour.next < b.tour.count {
                    if world::object{ w = &w, id = b.tour.ids[b.tour.next] } is some{ value = t } { _ = @fmt(&w.io, " ({} {} acted {} still {})", t.tag, @as(u32, t.kind), b.tour.acted, b.tour.still) }
                }
                _ = @fmt(&w.io, "\n")
            }
            _ = @fmt(&w.io, "bot: {} stops, at {}", b.count, b.next)
            if b.next < b.count { _ = @fmt(&w.io, " ({})", b.route[b.next][..@as(usize, b.lens[b.next])]) }
            _ = @fmt(&w.io, "\n")
        }
    }

    fn on_word { mut words: text::Words } -> bool {
        let v = text::next_word{ &words } ifnull { return true }
        return not ci::eq{ a = v, b = "off" }
    }

    // One frame of the bot's work.
    fn step { mut b: Bot, mut w: world::World } {
        if not b.on { return }
        b.tick = b.tick + 1
        if b.tick % EVERY != 0 { return }
        watch_door{ &b, w = &w }
        if w.conversation.active or w.transition != null or w.arrival > 0 { return }
        let lead = party::leader{ w = &w }
        let me = world::object{ w = &w, id = lead } ifnull { return }
        let c = obj::creature{ o = me } ifnull { return }
        if c.dead { return }
        if b.god {
            // The leader and every companion: a companion that goes down is a red cross on the HUD for the rest of the
            // test.
            let team = party::members{ w = &w }
            let mut m: usize = 0
            while m < team.len {
                if world::object{ w = &w, id = team[m] } is some{ value = mo } { mo.min_one_hp = true }
                m = m + 1
            }
        }
        // A new area: a stop that is an area-transition door has done its work (the door of the same tag on the
        // other side would send it straight back).
        if b.area != w.area {
            let came = b.area != 0
            b.area = w.area
            // (Only when the stop is the door it clicked or a transition trigger: the stop may have been passed already.)
            if came and b.next < b.count and (b.clicked == b.next + 1 or b.trans_stop) { advance{ &b } }
            b.clicked = 0
        }
        // Something hostile and alive within sight: fight it, nearest first.
        let foe = nearest_foe{ w = &w, me }
        if foe != obj::INVALID and not tour_ignores{ &b, foe } {
            if foe != b.foe or me.actions.len == 0 {
                b.foe = foe
                let mut a = actions::make{ kind = actions::Kind::attack_object }
                a.params[0] = actions::Param::object{ id = foe }
                actions::clear_all{ &w, id = lead }
                _ = actions::add{ &w, id = lead, action = a, force = true }
            }
            return
        }
        b.foe = obj::INVALID
        if b.tour.on {
            tour_step{ &b, &w, lead, me }
            return
        }
        if b.next >= b.count { return }
        let raw = b.route[b.next][..@as(usize, b.lens[b.next])]
        // `X,Y`: a place on the floor (the hidden path through the Eastern Dune Sea is a row of them).
        if point_stop{ stop = raw } is some{ value = pt } {
            let f = walkmap::floor_anywhere{ m = &w.walk, x = pt[0], y = pt[1] }
            let at = math::Vec3{ x = pt[0], y = pt[1], z = if f != null { f.z } else { me.position.z } }
            let dist = math::vec3::distance{ a = at, b = me.position }
            b.waiting = b.waiting + 1
            if dist < b.best - 2.0 {
                b.best = dist
                b.waiting = 0
            }
            if b.waiting > STUCK_TICKS {
                _ = @fmt(&w.io, "bot: stuck {} m from {} {}, skipped\n", dist, pt[0], pt[1])
                advance{ &b }
                return
            }
            if dist < 2.0 {
                advance{ &b }
                return
            }
            if me.actions.len > 0 { return }
            let mut a = actions::make{ kind = actions::Kind::move_to_point }
            a.params[0] = actions::Param::vector{ v = at }
            a.params[1] = actions::Param::int{ v = 1 }
            a.params[2] = actions::Param::float{ v = 1.0 }
            a.params[3] = actions::Param::object{ id = obj::INVALID }
            a.params[4] = actions::Param::float{ v = 0.0 }
            _ = actions::add{ &w, id = lead, action = a, force = true }
            return
        }
        // `@TAG`: walk up to it and talk to it (the leader's click on a creature). `TAG#N`: the Nth object of that tag.
        let talk = raw.len > 1 and raw[0] == '@'
        let stop = if talk { raw[1..] } else { raw }
        let nth = stop_nth{ stop }
        let tag = stop_tag{ stop }
        let t = world::object{ w = &w, id = world::object_by_tag{ w = &w, tag, nth } } ifnull {
            _ = @fmt(&w.io, "bot: no object {}, skipped\n", tag)
            advance{ &b }
            return
        }
        let at = stop_point{ w = &w, t, near_z = me.position.z }
        b.trans_stop = if obj::trigger{ o = t } is some{ value = tr } { tr.linked_to.len > 0 } else { false }
        let dist = math::vec3::distance{ a = at, b = me.position }
        b.waiting = b.waiting + 1
        if dist < b.best - 2.0 {
            b.best = dist
            b.waiting = 0
        }
        if b.waiting > STUCK_TICKS {
            _ = @fmt(&w.io, "bot: stuck {} m from {}, skipped\n", dist, tag)
            advance{ &b }
            return
        }
        // No nearer than a few decisions ago while it walks: a closed door nobody told the bot about is in the way. The
        // closest one within four metres is opened (its lock first, when the cheat is on).
        if b.next < b.count {
            // Best distance so far (the walk jitters by a metre); eight decisions without beating it by a metre.
            if b.last_dist <= 0.0 or dist < b.last_dist - 1.0 {
                b.last_dist = dist
                b.stalled = 0
            } else {
                b.stalled = b.stalled + 1
            }
            if b.stalled >= 8 {
                b.stalled = 0
                b.last_dist = 0.0
                let door = nearest_closed_door{ w = &w, me }
                if door != obj::INVALID {
                    _ = @fmt(&w.io, "bot: no nearer to {} for a while ({} m), opens door {}\n", tag, dist, door)
                    if world::object{ w = &w, id = door } is some{ value = dob } {
                        if dob.ext is door{ d } { if d.locked and b.unlock { d.locked = false } }
                    }
                    let mut a = actions::make{ kind = actions::Kind::open_door }
                    a.params[0] = actions::Param::object{ id = door }
                    actions::clear_all{ &w, id = lead }
                    _ = actions::add{ &w, id = lead, action = a, force = true }
                    return
                }
            }
        }
        // A stop to talk to is a click on the creature: the leader walks up to it by itself (round a counter, through a door)
        // and talks, so the order is given once it is near.
        if talk and not b.talked and dist < 8.0 and obj::creature{ o = t } != null {
            b.talked = true
            let mut a = actions::make{ kind = actions::Kind::dialog_object }
            a.params[0] = actions::Param::object{ id = t.id }
            actions::clear_all{ &w, id = lead }
            _ = actions::add{ &w, id = lead, action = a, force = true }
            return
        }
        if me.actions.len > 0 { return }
        // The conversation ordered above has been held (the top of this function waits out one that is on): the stop is done.
        if talk and b.talked {
            advance{ &b }
            return
        }
        if t.ext is door{ d } {
            if d.state == obj::DoorState::closed and b.seen_open and d.linked_flags == 0 {
                advance{ &b }
                return
            }
            if d.state == obj::DoorState::closed {
                // A click on an area-transition door starts its transition afresh (a new token); once in two seconds
                // is a player's pace, every decision would never let it finish.
                if b.waiting % 6 != 1 { return }
                if d.locked and b.unlock { d.locked = false }
                if d.linked_flags != 0 { b.clicked = b.next + 1 }
                let mut a = actions::make{ kind = actions::Kind::open_door }
                a.params[0] = actions::Param::object{ id = t.id }
                _ = actions::add{ &w, id = lead, action = a, force = true }
                return
            }
            // An area-transition door that stands open (an NPC opened it) is not clicked into a transition by the engine;
            // shut, it is: close it, and the next decision clicks it.
            if d.linked_flags != 0 and dist < REACH + 3.0 {
                if b.waiting % 6 == 1 {
                    let mut a = actions::make{ kind = actions::Kind::close_door }
                    a.params[0] = actions::Param::object{ id = t.id }
                    _ = actions::add{ &w, id = lead, action = a, force = true }
                }
                return
            }
            if dist < REACH + 1.0 {
                advance{ &b }
                return
            }
        } else if dist < (if obj::trigger{ o = t } is some{ value = tr } { 0.6 } else { REACH + 0.25 }) and not outside_trigger{ t, me } {    // a trigger counts only when stood in, near its middle
            if talk and not b.talked {
                b.talked = true
                let mut a = actions::make{ kind = actions::Kind::dialog_object }
                a.params[0] = actions::Param::object{ id = t.id }
                _ = actions::add{ &w, id = lead, action = a, force = true }
                return
            }
            advance{ &b }
            return
        }
        let mut a = actions::make{ kind = actions::Kind::move_to_point }
        a.params[0] = actions::Param::vector{ v = at }
        a.params[1] = actions::Param::int{ v = 1 }
        a.params[2] = actions::Param::float{ v = if obj::trigger{ o = t } is some{ value = tr } { 0.2 } else { 1.0 } }
        // A trigger is entered at the middle of its polygon, not at its origin, which the move would head for if it were told the object.
        a.params[3] = actions::Param::object{ id = if obj::trigger{ o = t } is some{ value = tr } { obj::INVALID } else { t.id } }
        a.params[4] = actions::Param::float{ v = 0.0 }
        _ = actions::add{ &w, id = lead, action = a, force = true }
    }

    // Notes that the door of the current stop was open at some tick (even in a cutscene).
    fn watch_door { mut b: Bot, w: *world::World } {
        if b.next >= b.count { return }
        let mut stop = b.route[b.next][..@as(usize, b.lens[b.next])]
        if stop.len > 1 and stop[0] == '@' { stop = stop[1..] }
        let t = world::object{ w, id = world::object_by_tag{ w, tag = stop_tag{ stop }, nth = stop_nth{ stop } } } ifnull { return }
        if t.ext is door{ d } { if d.state != obj::DoorState::closed { b.seen_open = true } }
    }

    // Whether the stop is a trigger the leader does not stand in yet (near its middle is not enough in a narrow polygon).
    fn outside_trigger { t: *obj::Object, me: *obj::Object } -> bool {
        if obj::trigger{ o = t } is some{ value = tr } {
            return not movement::inside_polygon{ poly = tr.polygon, x = me.position.x, y = me.position.y }
        }
        return false
    }

    // Where to walk for a stop: the object's place, or the middle of a trigger's polygon (a transition trigger is a thin
    // strip some way from its origin, and standing near the origin is not standing in it).
    fn stop_point { w: *world::World, t: *obj::Object, near_z: f32 } -> math::Vec3 {
        if obj::trigger{ o = t } is some{ value = tr } {
            if tr.polygon.len > 0 {
                let mid = polygon_middle{ poly = tr.polygon }
                // The polygon's heights are not the floor's: the floor under the middle, as the leader would find it from the
                // polygon's own height (a stop on the far side of a hilly area is not at the leader's), else from the leader's.
                let f = walkmap::floor{ m = &w.walk, x = mid.x, y = mid.y, z = mid.z + 2.0 }
                if f != null { return math::Vec3{ x = mid.x, y = mid.y, z = f.z } }
                let f2 = walkmap::floor{ m = &w.walk, x = mid.x, y = mid.y, z = near_z + 2.0 }
                return math::Vec3{ x = mid.x, y = mid.y, z = if f2 != null { f2.z } else { near_z } }
            }
        }
        return t.position
    }

    // A stop that is a place, `X,Y` (digits and a comma, no tag starts that way), as the two numbers.
    fn point_stop { stop: []u8 } -> ?[2]f32 {
        if stop.len < 3 { return null }
        let c = stop[0]
        if not ((c >= '0' and c <= '9') or c == '-') { return null }
        let comma = text::find_byte{ s = stop, c = ',' } ifnull { return null }
        let x = text::scan_f32{ s = stop[..comma] } ifnull { return null }
        let y = text::scan_f32{ s = stop[comma + 1..] } ifnull { return null }
        return [x, y]
    }

    // A stop's tag and, after a `#`, which object of that tag (counting from 0) it names.
    fn stop_tag { stop: []u8 } -> []u8 {
        let mut i: usize = 0
        while i < stop.len {
            if stop[i] == '#' { return stop[..i] }
            i = i + 1
        }
        return stop
    }

    fn stop_nth { stop: []u8 } -> i32 {
        let mut i: usize = 0
        while i < stop.len {
            if stop[i] == '#' { return @as(i32, text::scan_decimal{ s = stop[i + 1..] }) }
            i = i + 1
        }
        return 0
    }

    // The closest closed door within four metres of `me`, or OBJECT_INVALID.
    fn nearest_closed_door { w: *world::World, me: *obj::Object } -> u32 {
        let all = list::items{ list = w.objects.all }
        let mut best = obj::INVALID
        let mut best_d: f32 = 4.0
        let mut i: usize = 0
        while i < all.len {
            let o = all[i]
            i = i + 1
            if o.destroyed or o.kind != obj::Kind::door { continue }
            if o.ext is door{ d } {
                if d.state != obj::DoorState::closed { continue }
            } else { continue }
            let dist = math::vec3::distance{ a = o.position, b = me.position }
            if dist < best_d {
                best_d = dist
                best = o.id
            }
        }
        return best
    }

    fn advance { mut b: Bot } {
        b.next = b.next + 1
        b.waiting = 0
        b.seen_open = false
        b.talked = false
        b.trans_stop = false
        b.best = 1000000.0
        b.stalled = 0
        b.last_dist = 0.0
    }

    // The nearest live hostile creature within sight that the leader can see to attack.
    fn nearest_foe { w: *world::World, me: *obj::Object } -> u32 {
        let all = list::items{ list = w.objects.all }
        let mut best = obj::INVALID
        let mut best_d: f32 = SIGHT
        let mut i: usize = 0
        while i < all.len {
            let o = all[i]
            i = i + 1
            if o.destroyed or o.kind != obj::Kind::creature or o.id == me.id or o.area != me.area { continue }
            let c = obj::creature{ o } ifnull { continue }
            if c.dead or o.plot or not hud::is_hostile{ w, id = o.id } { continue }    // a plot creature (the Enclave's turrets) takes no damage
            let d = math::vec3::distance{ a = o.position, b = me.position }
            if d < best_d {
                best_d = d
                best = o.id
            }
        }
        return best
    }
}
