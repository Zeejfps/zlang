// The headless input script's `ui` lines (play.ctx): synthetic pointer and key events and a few
// test helpers, so a run can open every panel and look at it.
//
//   FRAME ui move X Y          the pointer (window pixels)
//   FRAME ui click X Y         press and release the left button there
//   FRAME ui key NAME          a key (escape, return, space, up, down, left, right, backspace, a letter)
//   FRAME ui type TEXT         typed text, for an edit box with the focus (the save name box)
//   FRAME ui menu NAME|N       open a menu: equip inventory character abilities messages journal map options
//   FRAME ui close             close the open menu
//   FRAME ui target TAG        select the object with the tag;  ui join TAG: it joins the party
//   FRAME ui unlock TAG | ui global NAME N | ui goto TAG | ui where [PART]     test helpers: unlock a door or placeable;
//                              set a number global; the leader walks to a tagged object; print objects by tag part
//   FRAME ui list | pick | info | party    print selectable objects / the pick under the pointer / the target / the party
namespace ingame {
    fn run_command { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, text: []u8 } {
        let mut words = text::words{ s = text }
        let cmd = text::next_word{ &words } ifnull { return }
        if ci::eq{ a = cmd, b = "move" } or ci::eq{ a = cmd, b = "click" } {
            let x = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            let y = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            send{ &ui, &w, &dev, ev = sdl::Event::mouse_motion{ x, y, dx = 0, dy = 0, buttons = 0 } }
            if ci::eq{ a = cmd, b = "click" } {
                send{ &ui, &w, &dev, ev = sdl::Event::mouse_button{ down = true, button = sdl::BUTTON_LEFT, clicks = 1, x, y } }
                send{ &ui, &w, &dev, ev = sdl::Event::mouse_button{ down = false, button = sdl::BUTTON_LEFT, clicks = 1, x, y } }
            }
        } else if ci::eq{ a = cmd, b = "key" } {
            let name = text::next_word{ &words } ifnull { return }
            let code = key_code{ name }
            if code != 0 {
                send{ &ui, &w, &dev, ev = sdl::Event::key{ down = true, repeat = false, scancode = 0, keycode = code, mods = 0 } }
                send{ &ui, &w, &dev, ev = sdl::Event::key{ down = false, repeat = false, scancode = 0, keycode = code, mods = 0 } }
            }
        } else if ci::eq{ a = cmd, b = "type" } {
            // Typed text for a focused edit box (the save name), in the pieces the platform delivers.
            let typed = text::rest{ words }
            let mut at: usize = 0
            while at < typed.len {
                let n = if typed.len - at > 32 { 32 } else { typed.len - at }
                let mut piece: [32]u8
                slice::copy(u8){ dst = piece[..n], src = typed[at..at + n] }
                send{ &ui, &w, &dev, ev = sdl::Event::text{ bytes = piece, len = n } }
                at = at + n
            }
        } else if ci::eq{ a = cmd, b = "menu" } {
            let name = text::next_word{ &words } ifnull { return }
            open_menu{ &ui, &w, &dev, n = menu_by_name{ name } }
        } else if ci::eq{ a = cmd, b = "close" } {
            close_menu{ &ui, &w }
        } else if ci::eq{ a = cmd, b = "target" } {
            let tag = text::next_word{ &words } ifnull { return }
            w.target = world::object_by_tag{ w = &w, tag, nth = 0 }
        } else if ci::eq{ a = cmd, b = "combat" } {
            // Puts the leader in combat mode (there is no combat yet) and queues an attack on TAG.
            let c = hud::creature_of{ w = &w, id = party::leader{ w = &w } } ifnull { return }
            c.in_combat = true
            let tag = text::next_word{ &words } ifnull { return }
            let mut a = actions::make{ kind = actions::Kind::attack_object }
            a.params[0] = actions::Param::object{ id = world::object_by_tag{ w = &w, tag, nth = 0 } }
            _ = actions::add{ &w, id = party::leader{ w = &w }, action = a, force = false }
        } else if ci::eq{ a = cmd, b = "resize" } {
            let x = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            let y = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            send{ &ui, &w, &dev, ev = sdl::Event::resized{ width = x, height = y } }
        } else if ci::eq{ a = cmd, b = "flash" } {
            let n = text::next_word{ &words } ifnull { return }
            notify{ &ui, which = @as(usize, text::scan_decimal{ s = n }) }
        } else if ci::eq{ a = cmd, b = "say" } {
            hud::log_add{ log = &ui.log, text = text::rest{ words }, kind = hud::LOG_FEEDBACK }
        } else if ci::eq{ a = cmd, b = "join" } {
            // The object joins the party (play will have the party lead's routines for this).
            let tag = text::next_word{ &words } ifnull { return }
            _ = party::add{ &w, id = world::object_by_tag{ w = &w, tag, nth = 0 } }
        } else if ci::eq{ a = cmd, b = "unlock" } {
            // Test helper: opens the lock of a door or placeable (a path the story would open).
            let tag = text::next_word{ &words } ifnull { return }
            let o = world::object{ w = &w, id = world::object_by_tag{ w = &w, tag, nth = 0 } } ifnull { return }
            if o.ext is door{ d } { d.locked = false }
            else if o.ext is placeable{ p } { p.locked = false }
        } else if ci::eq{ a = cmd, b = "global" } {
            // Test helper: a number global (`ui global K_SWG_TELEPORT 1`).
            let name = text::next_word{ &words } ifnull { return }
            let v = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            globals::set_number{ g = &w.globals, name, value = v }
        } else if ci::eq{ a = cmd, b = "where" } {
            // Test helper: every object whose tag contains the word (none given: all), with its place.
            let part = text::next_word{ &words } ifnull ""
            let all = list::items{ list = w.objects.all }
            let mut i: usize = 0
            while i < all.len {
                let o = all[i]
                i = i + 1
                if o.destroyed { continue }
                let tag: []u8 = o.tag
                if not has_part{ s = tag, part } { continue }
                _ = @fmt(&w.io, "where {} k{} {} at {} {} {} hp {}\n", o.id, @as(u32, o.kind), tag, o.position.x, o.position.y, o.position.z, o.hp)
            }
        } else if ci::eq{ a = cmd, b = "goto" } {
            // Test helper: the leader walks (runs) to the object with the tag, as a click on the floor there would.
            let tag = text::next_word{ &words } ifnull { return }
            let target = world::object_by_tag{ w = &w, tag, nth = 0 }
            let t = world::object{ w = &w, id = target } ifnull { return }
            let mut a = actions::make{ kind = actions::Kind::move_to_point }
            a.params[0] = actions::Param::vector{ v = t.position }
            a.params[1] = actions::Param::int{ v = 1 }
            a.params[2] = actions::Param::float{ v = 1.0 }
            a.params[3] = actions::Param::object{ id = target }
            a.params[4] = actions::Param::float{ v = 0.0 }
            _ = actions::add{ &w, id = w.pc, action = a, force = true }
        } else if ci::eq{ a = cmd, b = "pos" } {
            // Test helper: where the leader is, its hit points, its action and whether a conversation runs.
            let o = world::object{ w = &w, id = w.pc } ifnull { return }
            _ = @fmt(&w.io, "pos {} {} {} hp {}/{} talking {} pc {} leader {} player {}\n", o.position.x, o.position.y, o.position.z, o.hp, o.hp_max, w.conversation.active, w.pc, party::leader{ w = &w }, w.player)
        } else if ci::eq{ a = cmd, b = "locals" } {
            // Test helper: the local variables that are set on the object with the tag.
            let tag = text::next_word{ &words } ifnull { return }
            let o = world::object{ w = &w, id = world::object_by_tag{ w = &w, tag, nth = 0 } } ifnull { return }
            _ = @fmt(&w.io, "locals {} bools:", tag)
            let mut k: i32 = 0
            while k < 96 {
                if obj::local_bool{ l = o.locals, index = k } { _ = @fmt(&w.io, " {}", k) }
                k = k + 1
            }
            _ = @fmt(&w.io, " numbers: {} {} {} {} {} {} {} {}", o.locals.numbers[0], o.locals.numbers[1], o.locals.numbers[2], o.locals.numbers[3], o.locals.numbers[4], o.locals.numbers[5], o.locals.numbers[6], o.locals.numbers[7])
            _ = @fmt(&w.io, "\n")
        } else if ci::eq{ a = cmd, b = "bot" } {
            bot::run_command{ b = &ui.bot, &w, args = text::rest{ words } }
        } else if ci::eq{ a = cmd, b = "party" } {
            let ids = party::members{ w = &w }
            let mut i: usize = 0
            while i < ids.len {
                _ = @fmt(&w.io, "party {}: {} {}\n", i, ids[i], hud::name_of{ w = &w, id = ids[i] })
                i = i + 1
            }
        } else if ci::eq{ a = cmd, b = "list" } {
            let all = list::items{ list = w.objects.all }
            let mut i: usize = 0
            while i < all.len {
                let o = all[i]
                i = i + 1
                if not hud::is_selectable{ w = &w, id = o.id } { continue }
                let b = hud::box_on_screen{ p = ui.hud.projector, o }
                if b != null {
                    _ = @fmt(&w.io, "  {} {} box {} {} {} {}\n", o.id, o.tag, b.x0, b.y0, b.x1, b.y1)
                }
            }
        } else if ci::eq{ a = cmd, b = "info" } {
            let o = world::object{ w = &w, id = w.target } ifnull { return }
            let s = hud::shape_of{ o }
            _ = @fmt(&w.io, "target {} at {} {} {} shape {} {} {}\n", w.target, o.position.x, o.position.y, o.position.z, s.half_x, s.half_y, s.height)
            let b = hud::box_on_screen{ p = ui.hud.projector, o }
            if b != null {
                _ = @fmt(&w.io, "box {} {} {} {} top {} {}\n", b.x0, b.y0, b.x1, b.y1, b.top.x, b.top.y)
            }
        } else if ci::eq{ a = cmd, b = "pick" } {
            let id = hud::pick_at{ p = ui.hud.projector, w = &w, x = ui.gui.mouse_x, y = ui.gui.mouse_y }
            _ = @fmt(&w.io, "pick at {} {}: {} {}\n", ui.gui.mouse_x, ui.gui.mouse_y, id, hud::name_of{ w = &w, id })
        } else {
            // Commands of the panel owners (test_*.ctx): what a panel needs to show something the
            // game has not got yet.
            let args = text::rest{ words }
            if test_items::run{ &ui, &w, &dev, cmd, args } { return }
            if test_sheet::run{ &ui, &w, &dev, cmd, args } { return }
            if test_journal::run{ &ui, &w, &dev, cmd, args } { return }
            if test_map::run{ &ui, &w, &dev, cmd, args } { return }
            if test_screens::run{ &ui, &w, &dev, cmd, args } { return }
            _ = @fmt(&w.io, "ui: unknown command {}\n", cmd)
        }
    }

    // True when `part` occurs in `s`, ignoring case (empty: always).
    fn has_part { s: []u8, part: []u8 } -> bool {
        if part.len == 0 { return true }
        if part.len > s.len { return false }
        let mut i: usize = 0
        while i + part.len <= s.len {
            if ci::eq{ a = s[i..i + part.len], b = part } { return true }
            i = i + 1
        }
        return false
    }

    // A synthetic event, as if the window had delivered it.
    fn send { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, ev: sdl::Event } {
        _ = handle_event{ &ui, &w, &dev, ev, scale_x = 1.0, scale_y = 1.0 }
    }

    // A menu by name or number; -1 for neither.
    fn menu_by_name { name: []u8 } -> i32 {
        let names: [8][]u8 = ["equip", "inventory", "character", "abilities", "messages", "journal", "map", "options"]
        let mut i: usize = 0
        while i < 8 {
            if ci::eq{ a = name, b = names[i] } { return @as(i32, i) }
            i = i + 1
        }
        return @as(i32, text::scan_decimal{ s = name })
    }

    // An SDL keycode by the name scripts use; 0 for an unknown one.
    fn key_code { name: []u8 } -> i32 {
        if name.len == 1 { return @as(i32, ascii::to_lower{ c = name[0] }) }
        if ci::eq{ a = name, b = "escape" } { return sdl::key::ESCAPE }
        if ci::eq{ a = name, b = "return" } { return sdl::key::RETURN }
        if ci::eq{ a = name, b = "space" } { return sdl::key::SPACE }
        if ci::eq{ a = name, b = "tab" } { return sdl::key::TAB }
        if ci::eq{ a = name, b = "backspace" } { return sdl::key::BACKSPACE }
        if ci::eq{ a = name, b = "up" } { return sdl::key::UP }
        if ci::eq{ a = name, b = "down" } { return sdl::key::DOWN }
        if ci::eq{ a = name, b = "left" } { return sdl::key::LEFT }
        if ci::eq{ a = name, b = "right" } { return sdl::key::RIGHT }
        return 0
    }
}
