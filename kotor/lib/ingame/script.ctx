// The headless input script's `ui` lines (play.ctx): synthetic pointer and key events and a few
// test helpers, so a run can open every panel and look at it.
//
//   FRAME ui move X Y | click X Y | key NAME | type TEXT     the pointer, clicks, keys and typed text: game/inject.ctx
//                              puts them on SDL's queue as the events they stand for
//   FRAME ui menu NAME|N       open a menu: equip inventory character abilities messages journal map options
//   FRAME ui close             close the open menu
//   FRAME ui target TAG [N]    select the object with the tag (the Nth of several, counting from 0);  ui join TAG: it joins the party
//   FRAME ui unlock TAG | ui global NAME N | ui gbool NAME 0|1 | ui goto TAG | ui where [PART]     test helpers: unlock a door or placeable;
//                              set a number global; the leader walks to a tagged object; print objects by tag part
//   FRAME ui hover             print the panels' places and the control under the pointer
//   FRAME ui sweep             the pointer to the centre of each control: a hover test of every shown panel
//   FRAME ui anims             each party member's animation, moving flag and speed
//   FRAME ui list | pick | info | party   print selectable objects / the pick under the pointer / the target / the party
namespace ingame {
    // The scripted `ui` line (play.ctx hands each line to every owner in turn; the conversation
    // panels' `ui` lines come first). True if the word is `ui`.
    fn handle_scripted { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, word: []u8, rest: []u8 } -> bool {
        if not ci::eq{ a = word, b = "ui" } { return false }
        run_command{ &ui, &w, &dev, text = rest }
        return true
    }

    // Where a click would land on the tagged object (the Nth of several, from 0): the middle of its box
    // on the screen, or the nearest point to the middle that the HUD's pick gives to it (another object
    // in front of it, or the screen's edge, can hide the middle). Null when no point of it can be picked.
    // `FRAME clickon TAG [N] [right]` in play.ctx clicks there through the SDL queue.
    fn click_point { ui: Ingame, w: *world::World, tag: []u8, nth: i32 } -> ?[2]i32 {
        // `=NAME` names the object by what the HUD calls it ("Remains" has no tag), the Nth of that name from 0.
        let mut id = obj::INVALID
        if tag.len > 1 and tag[0] == '=' {
            let all = list::items{ list = w.objects.all }
            let mut seen: i32 = 0
            let mut i: usize = 0
            while i < all.len {
                let o = all[i]
                i = i + 1
                if o.destroyed or not ci::eq{ a = hud::name_of{ w, id = o.id }, b = tag[1..] } { continue }
                if seen == nth {
                    id = o.id
                    break
                }
                seen = seen + 1
            }
        } else {
            id = world::object_by_tag{ w, tag, nth }
        }
        let o = world::object{ w, id } ifnull { return null }
        let b = hud::box_on_screen{ p = ui.hud.projector, o } ifnull { return null }
        let sw = @as(f32, ui.gui.ui_w)
        let sh = @as(f32, ui.gui.ui_h)
        let x0 = math::max{ a = b.x0, b = 0.0 }
        let x1 = math::min{ a = b.x1, b = sw - 1.0 }
        let y0 = math::max{ a = b.y0, b = 0.0 }
        let y1 = math::min{ a = b.y1, b = sh - 1.0 }
        if x1 <= x0 or y1 <= y0 { return null }
        // the middle first, then rings of points around it
        let cx = (x0 + x1) * 0.5
        let cy = (y0 + y1) * 0.5
        let mut ring: i32 = 0
        while ring <= 8 {
            let mut k: i32 = 0
            while k < 9 {
                let ox = @as(f32, (k % 3) - 1) * @as(f32, ring) * (x1 - x0) / 16.0
                let oy = @as(f32, (k / 3) - 1) * @as(f32, ring) * (y1 - y0) / 16.0
                k = k + 1
                let px = @as(i32, cx + ox)
                let py = @as(i32, cy + oy)
                if hud::pick_at{ p = ui.hud.projector, w, x = px, y = py } == id { return [px, py] }
            }
            ring = ring + 1
        }
        return null
    }

    fn run_command { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, text: []u8 } {
        let mut words = text::words{ s = text }
        let cmd = text::next_word{ &words } ifnull { return }
        if ci::eq{ a = cmd, b = "menu" } {
            let name = text::next_word{ &words } ifnull { return }
            open_menu{ &ui, &w, &dev, n = menu_by_name{ name } }
        } else if ci::eq{ a = cmd, b = "hostiles" } {
            // Test helper: the creatures hostile to the leader with whether the HUD can select them and whether the
            // party has seen them (what enemy-sighted auto-pause looks at).
            let all = list::items{ list = w.objects.all }
            let lead = party::leader{ w = &w }
            let lead_faction = if world::object{ w = &w, id = lead } is some{ value = lo } { lo.faction } else { 0 }
            let mut i: usize = 0
            while i < all.len {
                let o = all[i]
                i = i + 1
                if o.destroyed or o.kind != obj::Kind::creature or o.id == lead or not hud::is_hostile{ w = &w, id = o.id } { continue }
                let seen = if perception::entry_of{ w = &w, viewer = lead, target = o.id } is some{ value = e } { e.seen } else { false }
                _ = @fmt(&w.io, "hostile {} {} selectable {} seen {} at {} {} faction {} standing {}\n", o.id, o.tag, hud::is_selectable{ w = &w, id = o.id }, seen, o.position.x, o.position.y, o.faction, if lead_faction == 0 { w.repute[0][o.faction % 32] } else { w.repute[o.faction % 32][lead_faction % 32] })
            }
        } else if ci::eq{ a = cmd, b = "losaudit" } {
            // `ui losaudit [METRES]`: every companion (not the leader) against every living hostile creature of
            // its area within METRES (12): the distance, whether a clear line joins them, whether the companion
            // perceives it, and what blocks the line. A companion that stands 5 m from an enemy it cannot see
            // is how a fight goes by without it (docs/mechanics/combat.md, "Companions in a fight").
            let reach = if text::next_word{ &words } is some{ value = word } { text::scan_f32{ s = word } ifnull 12.0 } else { 12.0 }
            let team = party::members{ w = &w }
            let lead = party::leader{ w = &w }
            let all = list::items{ list = w.objects.all }
            let mut m: usize = 0
            while m < team.len {
                let mid = team[m]
                m = m + 1
                if mid == lead { continue }
                let me = world::object{ w = &w, id = mid } ifnull { continue }
                let mc = obj::creature{ o = me } ifnull { continue }
                let mut i: usize = 0
                while i < all.len {
                    let o = all[i]
                    i = i + 1
                    if o.destroyed or o.kind != obj::Kind::creature or o.area != me.area or o.id == mid { continue }
                    let oc = obj::creature{ o } ifnull { continue }
                    if oc.dead or world::standing{ w = &w, from = me.faction, toward = o.faction } < 11 { continue }
                    let d = math::vec3::distance{ a = me.position, b = o.position }
                    if d > reach { continue }
                    let blk = perception::find_block{ w = &w, a = me.position, b = o.position, solids = true, ignore = obj::INVALID }
                    let seen = if perception::entry_of{ w = &w, viewer = mid, target = o.id } is some{ value = e } { e.seen } else { false }
                    _ = @fmt(&w.io, "audit {} sees {} at {} m: clear {} perceived {} sight range {}", me.tag, o.tag, d, blk.what == 0, seen, mc.sight_range)
                    if blk.what == 1 {
                        _ = @fmt(&w.io, " blocked by room {} face {} material {} at {} m", blk.index, blk.face, blk.material, blk.t)
                    } else if blk.what == 2 {
                        let owner = world::object{ w = &w, id = list::items{ list = w.walk.placed }[blk.index].owner } ifnull { continue }
                        let mut note: []u8 = ""
                        if owner.ext is door{ d } { note = if d.state == obj::DoorState::closed { " (closed)" } else { " (open)" } }
                        _ = @fmt(&w.io, " blocked by the mesh of {}{}", owner.tag, note)
                    }
                    _ = @fmt(&w.io, "\n")
                }
            }
        } else if ci::eq{ a = cmd, b = "los" } {
            // `ui los TAG1 TAG2`: whether the first object sees the second along a clear line (perception::clear_line:
            // the rooms' walkmeshes and the doors' and placeables'), and whether it perceives it now.
            let ta = text::next_word{ &words } ifnull { return }
            let tb = text::next_word{ &words } ifnull { return }
            let ia = world::object_by_tag{ w = &w, tag = ta, nth = 0 }
            let ib = world::object_by_tag{ w = &w, tag = tb, nth = 0 }
            let oa = world::object{ w = &w, id = ia } ifnull { return }
            let ob = world::object{ w = &w, id = ib } ifnull { return }
            let seen = if perception::entry_of{ w = &w, viewer = ia, target = ib } is some{ value = e } { e.seen } else { false }
            _ = @fmt(&w.io, "los {} {}: clear {} sight {} seen {} distance {} (leader's view: selectable kind {} in view {})\n", ta, tb, perception::clear_line{ w = &w, a = oa.position, b = ob.position }, perception::is_sight_clear{ w = &w, a = oa.position, b = ob.position, ignore = ib }, seen, math::vec3::distance{ a = oa.position, b = ob.position }, hud::is_selectable_kind{ w = &w, id = ib }, hud::is_in_view{ w = &w, id = ib })
            // What stops the line, if anything: a room's face with its surface material, or a door's or placeable's mesh.
            let blk = perception::find_block{ w = &w, a = oa.position, b = ob.position, solids = true, ignore = obj::INVALID }
            if blk.what == 1 {
                _ = @fmt(&w.io, "  blocked by room {} face {} material {} at {} m\n", blk.index, blk.face, blk.material, blk.t)
            } else if blk.what == 2 {
                let owner = world::object{ w = &w, id = list::items{ list = w.walk.placed }[blk.index].owner } ifnull { return }
                _ = @fmt(&w.io, "  blocked by the mesh of {} ({})\n", owner.tag, owner.id)
            }
        } else if ci::eq{ a = cmd, b = "autopause" } {
            // `ui autopause on|off`: the auto-pause triggers (enemy sighted, party member down, new target in
            // combat), off in headless runs until a test asks.
            ui.autopause = ci::eq{ a = text::next_word{ &words } ifnull "on", b = "on" }
        } else if ci::eq{ a = cmd, b = "summary" } {
            // `ui summary on|off|panel`: the "Status Summary" option; `panel` lets a headless run show the panel
            // (it only lights the HUD's icons there otherwise, as nobody would press OK).
            let word = text::next_word{ &words } ifnull "on"
            if ci::eq{ a = word, b = "panel" } { ui.summary.panel_allowed = true } else {
                ui.summary.on = ci::eq{ a = word, b = "on" }
                if options_front{ &ui } is some{ value = fe } { fe.settings.status_summary = ui.summary.on }
            }
        } else if ci::eq{ a = cmd, b = "close" } {
            close_menu{ &ui, &w }
        } else if ci::eq{ a = cmd, b = "target" } {
            let tag = text::next_word{ &words } ifnull { return }
            let nth = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            w.target = world::object_by_tag{ w = &w, tag, nth }
        } else if ci::eq{ a = cmd, b = "combat" } {
            // Puts the leader in combat (the server's state; there is no combat yet) and combat mode, and queues
            // an attack on TAG.
            let c = hud::creature_of{ w = &w, id = party::leader{ w = &w } } ifnull { return }
            c.in_combat = true
            c.combat_mode = true
            let tag = text::next_word{ &words } ifnull { return }
            let mut a = actions::make{ kind = actions::Kind::attack_object }
            a.params[0] = actions::Param::object{ id = world::object_by_tag{ w = &w, tag, nth = 0 } }
            _ = actions::add{ &w, id = party::leader{ w = &w }, action = a, force = false }
        } else if ci::eq{ a = cmd, b = "resize" } {
            let x = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            let y = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            send{ &ui, &w, &dev, ev = sdl::Event::resized{ width = x, height = y } }
        } else if ci::eq{ a = cmd, b = "flash" } {
            let n = text::next_word{ &words } ifnull { return }
            notify{ &ui, which = @as(usize, text::scan_decimal{ s = n }) }
        } else if ci::eq{ a = cmd, b = "say" } {
            hud::log_add{ log = &w.messages, text = text::rest{ words }, kind = hud::LOG_FEEDBACK }
        } else if ci::eq{ a = cmd, b = "join" } {
            // The object joins the party (play will have the party lead's routines for this).
            let tag = text::next_word{ &words } ifnull { return }
            _ = party::add{ &w, id = world::object_by_tag{ w = &w, tag, nth = 0 } }
        } else if ci::eq{ a = cmd, b = "unlock" } {
            // Test helper: opens the lock of a door or placeable (a path the story would open).
            let tag = text::next_word{ &words } ifnull { return }
            let o = world::object{ w = &w, id = world::object_by_tag{ w = &w, tag, nth = 0 } } ifnull { return }
            if o.ext is door{ d } { d.locked = false }
            else if o.ext is placeable{ p } { p.locked = false }
        } else if ci::eq{ a = cmd, b = "relock" } {
            // Test helper: `ui relock TAG DC [KEYTAG|required]` locks a door or placeable that opens to a Security
            // roll against DC, or, with a key tag, to that key; `required` makes it key-only with no key to find.
            let tag = text::next_word{ &words } ifnull { return }
            let dc = @as(u32, text::scan_decimal{ s = text::next_word{ &words } ifnull "10" })
            let key = text::next_word{ &words } ifnull ""
            let o = world::object{ w = &w, id = world::object_by_tag{ w = &w, tag, nth = 0 } } ifnull { return }
            let required = ci::eq{ a = key, b = "required" }
            let copy = obj::copy_bytes{ heap = w.heap, s = if required { "" } else { key } } iferr { return }
            if o.ext is door{ d } {
                d.locked = true
                d.lockable = true
                d.key_required = required
                d.open_dc = dc
                d.key = copy
            } else if o.ext is placeable{ p } {
                p.locked = true
                p.lockable = true
                p.key_required = required
                p.open_dc = dc
                p.key = copy
            }
        } else if ci::eq{ a = cmd, b = "global" } {
            // Test helper: a number global (`ui global K_SWG_TELEPORT 1`).
            let name = text::next_word{ &words } ifnull { return }
            let v = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull "0" })
            globals::set_number{ g = &w.globals, name, value = v }
        } else if ci::eq{ a = cmd, b = "gbool" } {
            // Test helper: a boolean global (`ui gbool Tar_GadonMission 1`).
            let name = text::next_word{ &words } ifnull { return }
            let v = text::scan_decimal{ s = text::next_word{ &words } ifnull "0" }
            globals::set_boolean{ g = &w.globals, name, value = v != 0 }
        } else if ci::eq{ a = cmd, b = "planet" } {
            // Test helper for a crafted start: the planet is on the galaxy map and can be travelled to
            // (`ui planet 7 1`; planetary.2da: 1 Taris, 3 Dantooine, 4 Tatooine, 5 Kashyyyk, 6 Manaan, 7 Korriban,
            // 10 Star Forge). The story's own scripts do it (SetPlanetAvailable) as the planets are reached.
            let planet = @as(i32, text::scan_decimal{ s = text::next_word{ &words } ifnull { return } })
            let on = text::scan_decimal{ s = text::next_word{ &words } ifnull "1" } != 0
            party::set_planet_flag{ &w, planet, bit = party::PLANET_AVAILABLE_SHIFT, on }
            party::set_planet_flag{ &w, planet, bit = party::PLANET_SELECTABLE_SHIFT, on }
        } else if ci::eq{ a = cmd, b = "globals" } {
            // Test helper: the number and boolean globals whose name contains the word and are not zero
            // (`ui globals tar_` lists the Taris story's state).
            let part = text::next_word{ &words } ifnull ""
            let all = list::items{ list = w.globals.all }
            let mut i: usize = 0
            while i < all.len {
                let g = all[i]
                i = i + 1
                if (g.kind != globals::Type::boolean and g.kind != globals::Type::number) or g.number == 0 { continue }
                if not has_part{ s = g.name, part } { continue }
                _ = @fmt(&w.io, "global {} {}\n", g.name, g.number)
            }
        } else if ci::eq{ a = cmd, b = "where" } {
            // Test helper: every object whose tag contains the word (none given: all), with its place.
            let part = text::next_word{ &words } ifnull ""
            let all = list::items{ list = w.objects.all }
            let mut i: usize = 0
            while i < all.len {
                let o = all[i]
                i = i + 1
                if o.destroyed { continue }
                let tag: []u8 = o.tag
                if not has_part{ s = tag, part } { continue }
                _ = @fmt(&w.io, "where {} k{} {} at {} {} {} hp {} facing {} {} faction {}\n", o.id, @as(u32, o.kind), tag, o.position.x, o.position.y, o.position.z, o.hp, o.orientation.x, o.orientation.y, o.faction)
                if o.ext is creature{ c } { _ = @fmt(&w.io, "  portrait {}\n", c.portrait) }
                if o.ext is door{ d } { _ = @fmt(&w.io, "  door state {} locked {} area {} link flags {} to {}\n", @as(u32, d.state), d.locked, o.area, d.linked_flags, d.linked_to) }
                if obj::trigger{ o } is some{ value = tr } {
                    _ = @fmt(&w.io, "  trigger type {} polygon", tr.trigger_type)
                    let mut k: usize = 0
                    while k < tr.polygon.len {
                        _ = @fmt(&w.io, " ({} {} {})", tr.polygon[k].x, tr.polygon[k].y, tr.polygon[k].z)
                        k = k + 1
                    }
                    _ = @fmt(&w.io, " inside {}\n", tr.inside.len)
                }
            }
        } else if ci::eq{ a = cmd, b = "locks" } {
            // Test helper: the locked (or lockable) doors and placeables whose tag contains the word, with the lock's record.
            let part = text::next_word{ &words } ifnull ""
            let all = list::items{ list = w.objects.all }
            let mut i: usize = 0
            while i < all.len {
                let o = all[i]
                i = i + 1
                if o.destroyed or not has_part{ s = o.tag, part } { continue }
                if o.ext is door{ d } {
                    if d.locked or d.lockable or part.len > 0 { _ = @fmt(&w.io, "lock door {} {} locked {} lockable {} key-required {} key '{}' open-dc {} close-dc {} plot {} state {} static {} walk {} at {} {}\n", o.id, o.tag, d.locked, d.lockable, d.key_required, d.key, d.open_dc, d.close_dc, o.plot, @as(u32, d.state), d.static, d.walk, o.position.x, o.position.y) }
                } else if o.ext is placeable{ p } {
                    if p.locked or p.lockable { _ = @fmt(&w.io, "lock placeable {} {} locked {} lockable {} key-required {} key '{}' open-dc {} close-dc {} plot {} inventory {} at {} {}\n", o.id, o.tag, p.locked, p.lockable, p.key_required, p.key, p.open_dc, p.close_dc, o.plot, p.inventory.len, o.position.x, o.position.y) }
                }
            }
        } else if ci::eq{ a = cmd, b = "goto" } {
            // Test helper: the leader walks (runs) to the object with the tag, as a click on the floor there would.
            let tag = text::next_word{ &words } ifnull { return }
            let target = world::object_by_tag{ w = &w, tag, nth = 0 }
            let t = world::object{ w = &w, id = target } ifnull { return }
            let mut a = actions::make{ kind = actions::Kind::move_to_point }
            a.params[0] = actions::Param::vector{ v = t.position }
            a.params[1] = actions::Param::int{ v = 1 }
            a.params[2] = actions::Param::float{ v = 1.0 }
            a.params[3] = actions::Param::object{ id = target }
            a.params[4] = actions::Param::float{ v = 0.0 }
            _ = actions::add{ &w, id = w.pc, action = a, force = true }
        } else if ci::eq{ a = cmd, b = "pos" } {
            // Test helper: where the leader is, its hit points, its action and whether a conversation runs.
            let o = world::object{ w = &w, id = w.pc } ifnull { return }
            _ = @fmt(&w.io, "pos {} {} {} hp {}/{} talking {} pc {} leader {} player {} facing {} {}\n", o.position.x, o.position.y, o.position.z, o.hp, o.hp_max, w.conversation.active, w.pc, party::leader{ w = &w }, w.player, o.orientation.x, o.orientation.y)
        } else if ci::eq{ a = cmd, b = "locals" } {
            // Test helper: the local variables that are set on the object with the tag.
            let tag = text::next_word{ &words } ifnull { return }
            let o = world::object{ w = &w, id = world::object_by_tag{ w = &w, tag, nth = 0 } } ifnull { return }
            _ = @fmt(&w.io, "locals {} bools:", tag)
            let mut k: i32 = 0
            while k < 96 {
                if obj::local_bool{ l = o.locals, index = k } { _ = @fmt(&w.io, " {}", k) }
                k = k + 1
            }
            _ = @fmt(&w.io, " numbers: {} {} {} {} {} {} {} {}", o.locals.numbers[0], o.locals.numbers[1], o.locals.numbers[2], o.locals.numbers[3], o.locals.numbers[4], o.locals.numbers[5], o.locals.numbers[6], o.locals.numbers[7])
            _ = @fmt(&w.io, "\n")
        } else if ci::eq{ a = cmd, b = "xp" } and text::rest{ words }.len == 0 {
            // Test helper: each party member's experience points (`ui xp N` gives the party N: test_screens.ctx).
            let ids = party::members{ w = &w }
            let mut i: usize = 0
            while i < ids.len {
                if world::object{ w = &w, id = ids[i] } is some{ value = m } {
                    if obj::creature{ o = m } is some{ value = c } {
                        // The rules creature holds it when there is one (the sheet reads it from there).
                        let xp = if c.fighter is some{ value = f } { f.c.xp } else { @as(i32, c.xp) }
                        _ = @fmt(&w.io, "xp {} {}: {}\n", ids[i], hud::name_of{ w = &w, id = ids[i] }, xp)
                    }
                }
                i = i + 1
            }
        } else if ci::eq{ a = cmd, b = "ai" } {
            // Test helper: an object's AI level, whether it takes orders, and its action queue (kinds in order).
            let tag = text::next_word{ &words } ifnull { return }
            let id = world::object_by_tag{ w = &w, tag, nth = 0 }
            let o = world::object{ w = &w, id } ifnull { return }
            _ = @fmt(&w.io, "ai {} {}: level {} commandable {} destroyed {} area {} queue", id, o.tag, o.ai_level, o.commandable, o.destroyed, o.area)
            let q = list::items{ list = o.actions }
            let mut k: usize = 0
            while k < q.len {
                _ = @fmt(&w.io, " {}", @as(u32, q[k].kind))
                k = k + 1
            }
            _ = @fmt(&w.io, "\n")
        } else if ci::eq{ a = cmd, b = "fx" } {
            // Test helper: the effects on the creature with the tag (none given: the leader): kind, duration
            // type, the seconds it was given, when it expires (day, ms) against now, and who made it.
            let tag = text::next_word{ &words } ifnull ""
            let id = if tag.len == 0 { w.pc } else { world::object_by_tag{ w = &w, tag, nth = 0 } }
            let o = world::object{ w = &w, id } ifnull { return }
            let c = obj::creature{ o } ifnull { return }
            let f = c.fighter ifnull { return }
            let now = fight::time_now{ w = &w }
            _ = @fmt(&w.io, "fx {} {}: {} effects, now {} {} (clock {} min per hour, rules day {} ms)\n", id, o.tag, f.c.nfx, now.day, now.ms, w.clock.min_per_hour, w.rules.settings.ms_per_day)
            let mut k: i32 = 0
            while k < f.c.nfx {
                let e = &f.c.fx[@as(usize, k)]
                k = k + 1
                _ = @fmt(&w.io, "  fx kind {} dur {} {} s expires {} {} creator {} spell {} ints {} {} {}\n", e.kind, e.dur, e.duration, e.expire.day, e.expire.ms, e.creator, e.spell_id, e.ints[0], e.ints[1], e.ints[2])
            }
        } else if ci::eq{ a = cmd, b = "bot" } {
            bot::run_command{ b = &ui.bot, &w, args = text::rest{ words } }
        } else if ci::eq{ a = cmd, b = "party" } {
            let ids = party::members{ w = &w }
            let mut i: usize = 0
            while i < ids.len {
                _ = @fmt(&w.io, "party {}: {} {}\n", i, ids[i], hud::name_of{ w = &w, id = ids[i] })
                i = i + 1
            }
        } else if ci::eq{ a = cmd, b = "anims" } {
            // Test helper: each party member's animation, whether it is moving, its speed and place.
            let ids = party::members{ w = &w }
            let mut i: usize = 0
            while i < ids.len {
                let o = world::object{ w = &w, id = ids[i] }
                i = i + 1
                if o == null { continue }
                let c = obj::creature{ o = o } ifnull { continue }
                _ = @fmt(&w.io, "anims {}: anim {} x{} moving {} speed {} actions {} at {} {}\n", o.tag, o.animation, o.anim_speed, c.moving, c.speed, o.actions.len, o.position.x, o.position.y)
            }
        } else if ci::eq{ a = cmd, b = "list" } {
            let all = list::items{ list = w.objects.all }
            let mut i: usize = 0
            while i < all.len {
                let o = all[i]
                i = i + 1
                if not hud::is_selectable{ w = &w, id = o.id } { continue }
                let b = hud::box_on_screen{ p = ui.hud.projector, o }
                if b != null {
                    _ = @fmt(&w.io, "  {} {} box {} {} {} {}\n", o.id, o.tag, b.x0, b.y0, b.x1, b.y1)
                }
            }
        } else if ci::eq{ a = cmd, b = "info" } {
            let o = world::object{ w = &w, id = w.target } ifnull { return }
            let s = hud::shape_of{ o }
            _ = @fmt(&w.io, "target {} at {} {} {} shape {} {} {}\n", w.target, o.position.x, o.position.y, o.position.z, s.half_x, s.half_y, s.height)
            let b = hud::box_on_screen{ p = ui.hud.projector, o }
            if b != null {
                _ = @fmt(&w.io, "box {} {} {} {} top {} {}\n", b.x0, b.y0, b.x1, b.y1, b.top.x, b.top.y)
            }
        } else if ci::eq{ a = cmd, b = "hover" } {
            // Test helper: where the panels are on the screen and which control is under the pointer.
            let ps = list::items{ list = ui.gui.panels }
            let mut i: usize = 0
            while i < ps.len {
                let p = ps[i]
                i = i + 1
                _ = @fmt(&w.io, "panel {} {} at {} {} size {} {} shown {} mode {} backdrop {} modal {}\n", p.id, resref::bytes{ r = &p.name }, p.sx, p.sy, p.w, p.h, p.shown, @as(u32, p.mode), p.backdrop, p.modal)
            }
            _ = @fmt(&w.io, "pointer {} {} window {}x{} ui {}x{} scale {}\n", ui.gui.mouse_x, ui.gui.mouse_y, ui.gui.win_w, ui.gui.win_h, ui.gui.ui_w, ui.gui.ui_h, ui.gui.scale)
            let h = ui.gui.hover
            let hp = gui::find_panel{ g = &ui.gui, id = h.panel }
            if hp != null and h.control >= 0 {
                let c = list::at{ list = hp.controls, i = @as(usize, h.control) }
                _ = @fmt(&w.io, "hover {} control {} at {} {} size {} {}\n", resref::bytes{ r = &hp.name }, c.tag, hp.sx + c.x, hp.sy + c.y, c.w, c.h)
            } else {
                _ = @fmt(&w.io, "hover nothing\n")
            }
        } else if ci::eq{ a = cmd, b = "sweep" } {
            // Test helper: the pointer to the centre of every visible control that takes it, one at a
            // time, through the event path; prints those where the hover is on another control (one
            // lying over it, usually) and the totals. A hover offset from the drawing shows as many.
            let mut total: u32 = 0
            let mut wrong: u32 = 0
            let ps = list::items{ list = ui.gui.panels }
            let mut i: usize = 0
            while i < ps.len {
                let p = ps[i]
                i = i + 1
                if not p.shown or p.removing { continue }
                let cs = list::items{ list = p.controls }
                let mut k: usize = 0
                while k < cs.len {
                    let c = &cs[k]
                    k = k + 1
                    if not gui::is_interactive{ c } or (c.flags & gui::F_VISIBLE) == 0 or c.w <= 0 or c.h <= 0 { continue }
                    let x = p.sx + c.x + c.w / 2
                    let y = p.sy + c.y + c.h / 2
                    send{ &ui, &w, &dev, ev = sdl::Event::mouse_motion{ x, y, dx = 0, dy = 0, buttons = 0 } }
                    total = total + 1
                    if ui.gui.hover.panel != p.id or ui.gui.hover.control != @as(i32, k) - 1 {
                        wrong = wrong + 1
                        let hp = gui::find_panel{ g = &ui.gui, id = ui.gui.hover.panel }
                        let under: []u8 = if hp != null and ui.gui.hover.control >= 0 { list::at{ list = hp.controls, i = @as(usize, ui.gui.hover.control) }.tag } else { "-" }
                        _ = @fmt(&w.io, "sweep: {} {} at {} {} hovers {}\n", resref::bytes{ r = &p.name }, c.tag, x, y, under)
                    }
                }
            }
            _ = @fmt(&w.io, "sweep: {} controls, {} hovered something else\n", total, wrong)
        } else if ci::eq{ a = cmd, b = "tutorial" } {
            // `ui tutorial on|off|allow|reset`: the "Tutorial Popups" option; `allow` lets a headless run show the
            // pop-ups (as `ui summary panel`); `reset` forgets which were shown.
            let word = text::next_word{ &words } ifnull ""
            if ci::eq{ a = word, b = "allow" } { w.tut.allowed = true }
            else if ci::eq{ a = word, b = "reset" } { w.party.tutorial_shown = [0; 6] }
            else {
                w.tut.on = ci::eq{ a = word, b = "on" }
                if options_front{ &ui } is some{ value = fe } { fe.settings.tutorial_popups = w.tut.on }
            }
        } else if ci::eq{ a = cmd, b = "bodypick" } {
            // Test helper: the picks at four points 0.8 m from the newest kept body (around it, a little above
            // the floor), where its lying body is and its bag (0.55 m across) is not; each is the bag when the
            // body hands the pointer to its bag (ProcessInput's +0x3dc).
            let bag = corpses::newest_bag{ w = &w }
            let bodies = list::items{ list = w.corpses }
            let mut k: usize = 0
            while k < bodies.len {
                if bodies[k].bag == bag and bag != obj::INVALID {
                    let at = bodies[k].o.position
                    let mut hits: u32 = 0
                    let mut d: usize = 0
                    while d < 4 {
                        let ox: f32 = if d == 0 { 0.8 } else if d == 1 { -0.8 } else { 0.0 }
                        let oy: f32 = if d == 2 { 0.8 } else if d == 3 { -0.8 } else { 0.0 }
                        if hud::project{ p = ui.hud.projector, at = math::Vec3{ x = at.x + ox, y = at.y + oy, z = at.z + 0.2 } } is some{ value = q } {
                            let id = hud::pick_at{ p = ui.hud.projector, w = &w, x = @as(i32, q.x), y = @as(i32, q.y) }
                            if id == bag { hits = hits + 1 }
                        }
                        d = d + 1
                    }
                    _ = @fmt(&w.io, "bodypick bag {} hidden {}: {} of 4 points by the body pick it\n", bag, corpses::hides_bag{ w = &w, bag }, hits)
                }
                k = k + 1
            }
        } else if ci::eq{ a = cmd, b = "pick" } {
            let id = hud::pick_at{ p = ui.hud.projector, w = &w, x = ui.gui.mouse_x, y = ui.gui.mouse_y }
            _ = @fmt(&w.io, "pick at {} {}: {} {} (hover {} target {} cursor {})\n", ui.gui.mouse_x, ui.gui.mouse_y, id, hud::name_of{ w = &w, id }, w.hover, w.target, ui.gui.cursor)
        } else {
            // Commands of the panel owners (test_*.ctx): what a panel needs to show something the
            // game has not got yet.
            let args = text::rest{ words }
            if test_items::run{ &ui, &w, &dev, cmd, args } { return }
            if test_sheet::run{ &ui, &w, &dev, cmd, args } { return }
            if test_force::run{ &ui, &w, &dev, cmd, args } { return }
            if test_journal::run{ &ui, &w, &dev, cmd, args } { return }
            if test_map::run{ &ui, &w, &dev, cmd, args } { return }
            if test_screens::run{ &ui, &w, &dev, cmd, args } { return }
            if test_traps::run{ &ui, &w, &dev, cmd, args } { return }
            if test_combat::run{ &ui, &w, &dev, cmd, args } { return }
            if test_stealth::run{ &ui, &w, &dev, cmd, args } { return }
            _ = @fmt(&w.io, "ui: unknown command {}\n", cmd)
        }
    }

    // True when `part` occurs in `s`, ignoring case (empty: always).
    fn has_part { s: []u8, part: []u8 } -> bool {
        if part.len == 0 { return true }
        if part.len > s.len { return false }
        let mut i: usize = 0
        while i + part.len <= s.len {
            if ci::eq{ a = s[i..i + part.len], b = part } { return true }
            i = i + 1
        }
        return false
    }

    // A synthetic event, as if the window had delivered it.
    fn send { mut ui: Ingame, mut w: world::World, mut dev: gpu::Device, ev: sdl::Event } {
        _ = handle_event{ &ui, &w, &dev, ev, scale_x = 1.0, scale_y = 1.0 }
    }

    // A menu by name or number; -1 for neither.
    fn menu_by_name { name: []u8 } -> i32 {
        let names: [8][]u8 = ["equip", "inventory", "character", "abilities", "messages", "journal", "map", "options"]
        let mut i: usize = 0
        while i < 8 {
            if ci::eq{ a = name, b = names[i] } { return @as(i32, i) }
            i = i + 1
        }
        return @as(i32, text::scan_decimal{ s = name })
    }

    // An SDL keycode by the name scripts use; 0 for an unknown one.
    fn key_code { name: []u8 } -> i32 {
        if name.len == 1 { return @as(i32, ascii::to_lower{ c = name[0] }) }
        if ci::eq{ a = name, b = "escape" } { return sdl::key::ESCAPE }
        if ci::eq{ a = name, b = "return" } { return sdl::key::RETURN }
        if ci::eq{ a = name, b = "space" } { return sdl::key::SPACE }
        if ci::eq{ a = name, b = "tab" } { return sdl::key::TAB }
        if ci::eq{ a = name, b = "backspace" } { return sdl::key::BACKSPACE }
        if ci::eq{ a = name, b = "up" } { return sdl::key::UP }
        if ci::eq{ a = name, b = "down" } { return sdl::key::DOWN }
        if ci::eq{ a = name, b = "left" } { return sdl::key::LEFT }
        if ci::eq{ a = name, b = "right" } { return sdl::key::RIGHT }
        return 0
    }
}
