// The heads-up display (docs/design/hud.md): the HUD panel (mipc2*.gui) over the running game.
// It opens the panel for the window, fits the file's layout to it, and each frame sets its
// controls from the world: party portraits and bars, the minimap, the target block and action
// slots, the combat queue, the pause banner.
//
//   var h = try hud::open{ &g, &fs, &dev }              // once the module runs
//   hud::update{ &h, &g, &w, &dev, dt }                 // each frame, after the world
//   for ev in gui::take_events{ &g }: hud::on_event{ &h, &g, &w, ev }
namespace hud {
    const WIDGETS: usize = 3

    // What a party widget shows now, so a frame only sets what changed.
    struct Widget {
        id: u32,                // the creature shown, obj::INVALID when the widget is empty
        portrait: u32,          // portraits.2da row
        hp: i32, hp_max: i32,
        fp: i32, fp_max: i32,
        level: i32,
        xp: u32,
        down: bool,
    }

    // A creature whose level-up the portraits announced, and at which level (the client creature's +0x440 bit 1:
    // set when it is made and after each level-up, cleared by the announcement; re/gui.md "State").
    struct Told { id: u32, level: i32 }

    // A control of the floating target block with its place in the file; the block moves as a
    // whole over the selected object.
    struct BlockPart { index: i32, x: i32, y: i32 }

    // The target marker as this frame placed it (block.ctx, update_reticle): one of MARKS, its top left
    // corner and side in GUI pixels, and the quarter turns of the picture (the edge arrows).
    struct Reticle { shown: bool, x: f32, y: f32, side: f32, mark: u8, turns: i32 }

    struct Hud {
        panel: u32,
        file_w: i32, file_h: i32,           // the HUD file's design size
        widgets: [3]Widget,
        block: [16]BlockPart,               // by BLOCK_TAGS
        minimap: MiniMap,
        font: i32,                          // the feedback lines' font slot, -1 none
        combat: bool,                       // the combat controls are up
        cmsg: u32,                          // the combat message bar's text (dialog.tlk; main interface +0x7728)
        cmsg_left: f32,                     // seconds left of a timed message (+0x7724); below 0 none runs, and a new message may come up
        cmsg_total: f32,                    // its whole time (+0x7720)
        cmsg_label: u32,                    // the strref LBL_CMBTMODEMSG shows now, 0 when it must be written again
        label_lent: bool,                   // the self slots' refusal has the bar's label this frame (ingame)
        auto_paused: bool,                  // the game is paused by an auto-pause (client +0x384 bit 0; ingame)
        queued_banner: bool,                // a choice was queued while auto-paused: the banner says so (pause reason 10; taken by ingame)
        notify: [9]f32,                     // seconds left of each notification icon
        notify_shown: [9]bool,
        level_news: bool,                   // a member can newly level up: the status summary's gui_level is due (taken by ingame)
        told: [12]Told,                     // whose level-up was announced, at which level
        shown_target: u32,                  // the target the block was built for
        lists: [3]ActionList,               // the block's slots
        power_pick: i32,                    // the Force power chosen in the middle slot (a spells.2da row), kept from target to target
        refusal: f32,                       // seconds left of a refusal message in the target block's name label
        refusal_reason: i32,                // its reason code (REASON_TEXT)
        hover_slot: i32,                    // the target slot under the pointer, -1 none
        look: i32,                          // the block's frames and health bar as set: 1 hostile, 2 poisoned, -1 not yet
        pressed: u32,                       // the target when the button went down in the world
        pressing: bool,                     // the button went down in the world (not on the GUI)
        reticle: Reticle,                   // the target marker to draw
        reticle_for: u32,                   // the target the marker was last placed for
        zoom: f32,                          // seconds left of the combat reticle's zoom-in; -1 armed for the next combat frame
        sight_latch: bool,                  // an enemy in sight has been announced (autotarget.ctx)
        sight_quiet: f32,                   // seconds left before the latch lets go once none is in sight
        target_lost: f32,                   // seconds the target has been out of sight
        move_speed: f32,                    // the keys' velocity, the larger component, m/s (set by the loop after the control's step)
        moving_for: f32,                    // seconds the leader has been moving by the keys, out of combat mode (autotarget.ctx)
        looking: bool,                      // the mouse turns the camera: the pointer is hidden and nothing is hovered
        swing_to: u32,                      // an object the auto-target wants the camera to swing round to (taken by the loop), obj::INVALID none
        door_window: f32,                   // seconds left in which an auto-pause request waits (client +0x38c, after the player's action on a door)
        deferred: f32,                      // seconds left before a waiting auto-pause request is made (+0x390); the auto-target's drop waits too
        deferred_text: u32,                 // that request's reason text
        alternate: bool,                    // Shift is held (AlternateActions): slot orders replace the queue in combat
        trans_panel: u32,                   // the area transition label's panel while the pointer is on a transition, else 0
        trans_object: u32,                  // the transition it names
        projector: Projector,               // this frame's, for picking and the reticle
        floating: Floating,                 // the damage, miss and XP labels over creatures (floating.ctx)
    }

    // The HUD controls of the floating target block.
    const BLOCK_TAGS: [16][]u8 = [
        "LBL_NAMEBG", "LBL_NAME", "LBL_HEALTHBG", "PB_HEALTH",
        "BTN_TARGET0", "BTN_TARGET1", "BTN_TARGET2",
        "BTN_TARGETUP0", "BTN_TARGETUP1", "BTN_TARGETUP2",
        "BTN_TARGETDOWN0", "BTN_TARGETDOWN1", "BTN_TARGETDOWN2",
        "LBL_TARGET0", "LBL_TARGET1", "LBL_TARGET2",
    ]

    // Controls that show only when the game gives them something to show (a state, an event, a
    // party member); they start hidden and the update turns them on.
    const STARTS_HIDDEN: [27][]u8 = [
        "LBL_ARROW_MARGIN", "LBL_MAP", "LBL_ARROW",
        "LBL_CMBTMODEMSG", "LBL_CMBTMSGBG", "LBL_COMBATBG1", "LBL_COMBATBG2", "LBL_COMBATBG3",
        "LBL_QUEUE0", "LBL_QUEUE1", "LBL_QUEUE2", "LBL_QUEUE3",
        "BTN_CLEARONE", "BTN_CLEARONE2", "BTN_CLEARALL",
        "LBL_ACTIONDESC", "LBL_ACTIONDESCBG", "TB_SOLO", "TB_STEALTH",
        "LBL_JOURNAL", "LBL_CASH", "LBL_PLOTXP", "LBL_STEALTHXP", "LBL_DARKSHIFT", "LBL_LIGHTSHIFT",
        "LBL_ITEMRCVD", "LBL_ITEMLOST",
    ]

    // Opens the HUD panel for the window, fitted to it.
    fn open { mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device } -> !Hud {
        let name = gui::hud_name{ w = g.ui_w, h = g.ui_h }
        let panel = try gui::open{ &g, fs = &w.fs, &dev, name, mode = gui::Mode::placed, modal = false }
        let p = gui::find_panel{ &g, id = panel } ifnull { return gui::no_such_gui{ name } }
        let file_w = p.w
        let file_h = p.h
        fit_to_screen{ &g, p }
        let mut h = Hud{
            panel, file_w, file_h,
            widgets = [Widget{ id = obj::INVALID, portrait = 0, hp = -1, hp_max = -1, fp = -1, fp_max = -1, level = -1, xp = 0, down = false }; 3],
            block = [BlockPart{ index = -1, x = 0, y = 0 }; 16],
            minimap = open_minimap{ &g, &w, &dev, panel },
            font = gui::font_slot{ &g, fs = &w.fs, &dev, name = "dialogfont10x10" }, combat = false, cmsg = COMBAT_ENGAGED, cmsg_left = -1.0, cmsg_total = 2.5, cmsg_label = 0, label_lent = false, auto_paused = false, queued_banner = false, notify = [0.0; 9], notify_shown = [false; 9], level_news = false, told = [Told{ id = obj::INVALID, level = -1 }; 12],
            shown_target = obj::INVALID, lists = [empty_list{}; 3], power_pick = -1, refusal = 0.0, refusal_reason = 0, hover_slot = -1, look = -1, pressed = obj::INVALID,
            pressing = false, reticle = Reticle{ shown = false, x = 0.0, y = 0.0, side = 0.0, mark = 0, turns = 0 }, reticle_for = obj::INVALID, zoom = -1.0, sight_latch = false, sight_quiet = 0.0, target_lost = 0.0, move_speed = 0.0, moving_for = 0.0, looking = false, swing_to = obj::INVALID, door_window = 0.0, deferred = 0.0, deferred_text = 0, alternate = false, trans_panel = 0, trans_object = obj::INVALID,
            projector = Projector{ vp = math::mat4::identity{}, eye = math::vec3::zero{}, w = 1.0, h = 1.0 },
            floating = new_floating{ &g, &w, &dev },
        }
        let mut i: usize = 0
        while i < STARTS_HIDDEN.len {
            gui::set_visible{ &g, panel, tag = STARTS_HIDDEN[i], visible = false }
            i = i + 1
        }
        // The action slots' down arrows are the up arrow turned half way round (CSWGuiActionSlot::Init).
        turn_down_arrows{ &g, panel }
        adopt_slot_parts{ &g, panel }
        // The pause toggle, the menu buttons and the four self action slots stay (a slot with nothing is a
        // blank frame, selfslots.ctx); the party widgets hide until a member fills them.
        i = 0
        while i < WIDGETS {
            hide_widget{ &g, panel, n = i }
            i = i + 1
        }
        i = 0
        while i < BLOCK_TAGS.len {
            let ci = gui::find_by_tag{ p, tag = BLOCK_TAGS[i] }
            if ci >= 0 {
                let c = list::at{ list = p.controls, i = @as(usize, ci) }
                h.block[i] = BlockPart{ index = ci, x = c.x, y = c.y }
            }
            i = i + 1
        }
        hide_block{ &h, &g }
        return h
    }

    // The HUD file has one fixed pixel layout; the original shows the file made for the window's
    // exact size. On any other size (a 16:9 window) we keep the pixels and anchor each control to
    // the nearest edge of the screen: what sat in a corner of the file stays in that corner, what
    // sat in the middle of an edge stays centred on it.
    fn fit_to_screen { mut g: gui::Gui, p: *mut gui::Panel } {
        let dw = g.ui_w - p.w
        let dh = g.ui_h - p.h
        if dw == 0 and dh == 0 { return }
        let cs = list::items{ list = p.controls }
        let mut i: usize = 0
        while i < cs.len {
            let c = &cs[i]
            let cx = c.x + c.w / 2
            let cy = c.y + c.h / 2
            if cx * 3 > p.w * 2 { c.x = c.x + dw } else if cx * 3 >= p.w { c.x = c.x + dw / 2 }
            if cy * 3 > p.h * 2 { c.y = c.y + dh } else if cy * 3 >= p.h { c.y = c.y + dh / 2 }
            i = i + 1
        }
        p.w = g.ui_w
        p.h = g.ui_h
    }

    // The down arrows (BTN_ACTIONDOWN0..3, BTN_TARGETDOWN0..2) use the same picture as the up arrows, turned 180 degrees.
    fn turn_down_arrows { mut g: gui::Gui, panel: u32 } {
        let mut buf: [32]u8
        let mut n: usize = 0
        while n < 4 {
            gui::set_fill_turns{ &g, panel, tag = tag_n{ into = buf[..], prefix = "BTN_ACTIONDOWN", n }, turns = 2 }
            if n < 3 { gui::set_fill_turns{ &g, panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGETDOWN", n }, turns = 2 } }
            n = n + 1
        }
    }

    // The target slots' frame is the parent of its icon and arrows (CSWGuiActionSlot::Init, AddChild), so the
    // pointer on any of them lights the frame.
    fn adopt_slot_parts { mut g: gui::Gui, panel: u32 } {
        let mut a: [24]u8
        let mut b: [24]u8
        let mut n: usize = 0
        while n < 3 {
            let frame = tag_n{ into = a[..], prefix = "BTN_TARGET", n }
            gui::set_parent{ &g, panel, tag = tag_n{ into = b[..], prefix = "BTN_TARGETUP", n }, parent = frame }
            gui::set_parent{ &g, panel, tag = tag_n{ into = b[..], prefix = "BTN_TARGETDOWN", n }, parent = frame }
            gui::set_parent{ &g, panel, tag = tag_n{ into = b[..], prefix = "LBL_TARGET", n }, parent = frame }
            n = n + 1
        }
    }

    // ---- party widgets

    const WIDGET_TAGS: [11][]u8 = [
        "BTN_CHAR", "LBL_CHAR", "PB_VIT", "PB_FORCE", "LBL_BACK", "LBL_LEVELUP", "LBL_LVLUPBG",
        "LBL_DEBILATATED", "LBL_DISABLE", "LBL_CMBTEFCTRED", "LBL_CMBTEFCTINC",
    ]

    fn hide_widget { mut g: gui::Gui, panel: u32, n: usize } {
        let mut buf: [32]u8
        let mut k: usize = 0
        while k < WIDGET_TAGS.len {
            gui::set_visible{ &g, panel, tag = tag_n{ into = buf[..], prefix = WIDGET_TAGS[k], n = n + 1 }, visible = false }
            k = k + 1
        }
    }

    // The widget a party member goes to: the leader to the first; with exactly two members the
    // companion to the third, beside the leader (docs/re/gui.md, "Party portraits").
    fn widget_for { count: usize, member: usize } -> usize {
        if count == 2 and member == 1 { return 2 }
        return member
    }

    // Closes the HUD's panel and frees its minimap target (the window changed size, or the game ends).
    fn close { mut h: Hud, mut g: gui::Gui, mut dev: gpu::Device } {
        gui::close{ &g, id = h.panel }
        let t = h.minimap.target
        if t != null { gpu::free_target{ &dev, t } }
        h.minimap.target = null
    }

    // The member a widget shows, the inverse of widget_for; -1 for an empty widget.
    fn member_of_widget { count: usize, widget: usize } -> i32 {
        if count == 2 { return if widget == 0 { 0 } else if widget == 2 { 1 } else { -1 } }
        return if widget < count { @as(i32, widget) } else { -1 }
    }

    // Which party widget a button tag belongs to (BTN_CHAR1 .. BTN_CHAR3 -> 0 .. 2); -1 for any other.
    fn portrait_button { tag: []u8 } -> i32 {
        let mut buf: [16]u8
        let mut n: usize = 0
        while n < WIDGETS {
            if slice::eq_bytes{ a = tag, b = tag_n{ into = buf[..], prefix = "BTN_CHAR", n = n + 1 } } { return @as(i32, n) }
            n = n + 1
        }
        return -1
    }

    // Takes the HUD off the screen (or puts it back): a conversation covers the screen with its
    // own panels. The panel is moved out of reach rather than closed, so its state stays.
    fn set_hidden { mut h: Hud, mut g: gui::Gui, hidden: bool } {
        let p = gui::find_panel{ &g, id = h.panel } ifnull { return }
        p.sx = if hidden { 100000 } else { p.x }
    }

    // Shows or hides every control of the floating target block.
    fn hide_block { mut h: Hud, mut g: gui::Gui } {
        let mut i: usize = 0
        while i < BLOCK_TAGS.len {
            gui::set_visible{ &g, panel = h.panel, tag = BLOCK_TAGS[i], visible = false }
            i = i + 1
        }
    }

    // Adds the HUD's own passes to the frame, before the panels (the minimap's target).
    fn draw { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, mut frame: render::Frame, log: *MessageLog } {
        draw_minimap{ mm = &h.minimap, &g, &w, &dev, &frame, panel = h.panel }
        draw_reticle{ &h, &g, &w, &dev, &frame }
        draw_hover_reticle{ &h, &g, &w, &dev, &frame }
        draw_feedback{ &h, &g, log, &frame }
        draw_floats{ &h, &g, &w, &frame }
    }

    // One frame: everything the HUD shows that the world decides. `blocked` says a menu or
    // modal panel is up, so the world under it is not picked.
    fn update {
        mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, mut text: utf8::Builder(heap::Heap),
        camera: cam::Camera, aspect: f32, blocked: bool, dt: f32,
    } {
        h.projector = make_projector{ camera, ui_w = g.ui_w, ui_h = g.ui_h, aspect }
        update_party{ &h, &g, &w, &dev, &text }
        // The target follows the player when the world is on show (UpdateSelectableObjects waits for no modal panel).
        if not blocked and not w.conversation.active and not w.conversation.hold and w.transition == null and w.arrival == 0 {
            update_target{ &h, &w, dt }
            // Then the party's combat mode (0x005f3ad0 follows UpdateSelectableObjects in MainLoop).
            update_combat_modes{ &h, &w }
        }
        update_hover{ &h, &g, &w, blocked }
        update_transition{ &h, &g, &w, &dev, id = w.hover }
        update_block{ &h, &g, &w, &dev }
        update_reticle{ &h, &w, dt }
        update_combat{ &h, &g, &w, &dev, dt }
        // Solo mode: its toggle shows once there is someone to leave behind.
        gui::set_visible{ &g, panel = h.panel, tag = "TB_SOLO", visible = w.party.count > 1 }
        gui::set_checked{ &g, panel = h.panel, tag = "TB_SOLO", on = w.party.solo }
        update_stealth{ &h, &g, &w }
        update_notify{ &h, &g, dt }
        tick_floats{ &h, dt }
    }

    // A member showing the level-up badge raises the status summary's level-up sound once per level
    // (UpdatePartyPortraits 0x00687860, event 9).
    fn tell_level_up { mut h: Hud, id: u32, level: i32 } {
        let mut free: usize = 12
        let mut i: usize = 0
        while i < 12 {
            if h.told[i].id == id {
                if h.told[i].level == level { return }
                free = i
                break
            }
            if h.told[i].id == obj::INVALID and free == 12 { free = i }
            i = i + 1
        }
        if free == 12 { free = 0 }
        h.told[free] = Told{ id, level }
        h.level_news = true
    }

    // Portraits, vitality and Force bars, level-up and down marks of the party members.
    fn update_party { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, mut text: utf8::Builder(heap::Heap) } {
        let ids = party_ids{ w = &w }
        let mut shown = [false; 3]
        let mut m: usize = 0
        while m < ids.len and m < WIDGETS {
            let n = widget_for{ count = ids.len, member = m }
            shown[n] = true
            show_member{ &h, &g, &w, &dev, &text, n, id = ids[m] }
            m = m + 1
        }
        let mut n: usize = 0
        while n < WIDGETS {
            if not shown[n] and h.widgets[n].id != obj::INVALID {
                hide_widget{ &g, panel = h.panel, n }
                h.widgets[n].id = obj::INVALID
            }
            n = n + 1
        }
    }

    fn show_member { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, mut text: utf8::Builder(heap::Heap), n: usize, id: u32 } {
        let panel = h.panel
        let mut buf: [32]u8
        let c = creature_of{ w = &w, id } ifnull { return }
        let v = vitality_of{ w = &w, id }
        let f = force_of{ w = &w, id }
        let level = level_of{ w = &w, id }
        let down = is_down{ w = &w, id }
        let wd = &h.widgets[n]
        let fresh = wd.id != id
        if fresh {
            // The controls a member's widget always shows.
            let always: [5][]u8 = ["BTN_CHAR", "LBL_CHAR", "PB_VIT", "PB_FORCE", "LBL_BACK"]
            let mut k: usize = 0
            while k < 5 {
                gui::set_visible{ &g, panel, tag = tag_n{ into = buf[..], prefix = always[k], n = n + 1 }, visible = true }
                k = k + 1
            }
            let resref = portrait_of{ w = &w, id }
            let img = gui::resolve_img{ &g, fs = &w.fs, &dev, name = resref }
            let tag = tag_n{ into = buf[..], prefix = "LBL_CHAR", n = n + 1 }
            if img.ok { gui::set_picture{ &g, panel, tag, texture = img.tex, w = img.w, h = img.h } } else { gui::clear_picture{ &g, panel, tag } }
            // The vitality bar's fill is green (the file's red is the original's odd case).
            let fill = gui::resolve_img{ &g, fs = &w.fs, &dev, name = "greenfill" }
            let bar = gui::find_control{ &g, panel, tag = tag_n{ into = buf[..], prefix = "PB_VIT", n = n + 1 } }
            if bar != null and fill.ok { bar.progress.fill = fill }
            wd.id = id
            wd.hp = -1
            wd.fp = -1
            wd.level = -1
        }
        if fresh or wd.hp != v.hp or wd.hp_max != v.hp_max {
            gui::set_max{ &g, panel, tag = tag_n{ into = buf[..], prefix = "PB_VIT", n = n + 1 }, max = v.hp_max }
            gui::set_value{ &g, panel, tag = tag_n{ into = buf[..], prefix = "PB_VIT", n = n + 1 }, value = v.hp }
            wd.hp = v.hp
            wd.hp_max = v.hp_max
            set_member_tooltip{ &h, &g, &w, &text, n, id, v, f, level }
        }
        if fresh or wd.fp != f.fp or wd.fp_max != f.fp_max {
            gui::set_max{ &g, panel, tag = tag_n{ into = buf[..], prefix = "PB_FORCE", n = n + 1 }, max = f.fp_max }
            gui::set_value{ &g, panel, tag = tag_n{ into = buf[..], prefix = "PB_FORCE", n = n + 1 }, value = f.fp }
            wd.fp = f.fp
            wd.fp_max = f.fp_max
        }
        let xp = c.xp
        if fresh or wd.level != level or wd.down != down or wd.xp != xp {
            wd.level = level
            wd.down = down
            wd.xp = xp
            // A mark over the portrait when the member is down, and the level-up badge when the
            // experience allows another level.
            let up = can_level_up{ w = &w, id }
            if up { tell_level_up{ &h, id, level } }
            gui::set_visible{ &g, panel, tag = tag_n{ into = buf[..], prefix = "LBL_DEBILATATED", n = n + 1 }, visible = down }
            gui::set_visible{ &g, panel, tag = tag_n{ into = buf[..], prefix = "LBL_LEVELUP", n = n + 1 }, visible = up }
            gui::set_visible{ &g, panel, tag = tag_n{ into = buf[..], prefix = "LBL_LVLUPBG", n = n + 1 }, visible = up }
            set_member_tooltip{ &h, &g, &w, &text, n, id, v, f, level }
        }
        _ = c
    }
}
