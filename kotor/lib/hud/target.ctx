// Targets and their actions (docs/re/movement.md section 7, docs/re/gui.md "Action menus"):
// which objects the pointer can pick, which one is the target, what the leader can do to it, and
// the block that floats over it with its name, health and three action slots.
namespace hud {
    // Objects farther than this from the leader (squared metres) are not selectable.
    const RANGE2: f32 = 900.0
    // Below this standing an object is hostile to the leader (repute.2da: 0..10).
    const HOSTILE_BELOW: i32 = 11

    // What a slot does when pressed.
    enum Act: u8 { none, open, bash, use_place, open_place, talk, attack, unlock, power }

    // Why an entry cannot be used now (the original's reason codes, strings in REASON_TEXT).
    const R_OK: i32 = 0
    const R_FORCE: i32 = 1
    const R_ARMOR: i32 = 2
    const R_ITEM: i32 = 3
    const R_FULL: i32 = 5
    const R_DEAD: i32 = 6

    // dialog.tlk: the refusal messages by reason code (shown for 5 seconds in the message bar).
    const REASON_TEXT: [7]u32 = [0, 38613, 38614, 38615, 42422, 42498, 47936]

    // One choice in a slot: its icon (a texture in the GUI pack) and the dialog.tlk string that
    // names it. A power's `id` is its spells.2da row; it dims and says `reason` when `usable` is
    // false.
    struct Entry { act: Act, icon: [24]u8, icon_len: usize, strref: u32, id: i32, usable: bool, reason: i32 }

    // The most choices a slot lists (the ten hostile power lines are the longest list).
    const LIST_MAX: usize = 12

    // A slot's choices, cycled with its arrows.
    struct ActionList { entries: [12]Entry, count: usize, selected: usize }

    fn entry { act: Act, icon: []u8, strref: u32 } -> Entry {
        let mut e = Entry{ act, icon = [0; 24], icon_len = 0, strref, id = -1, usable = true, reason = R_OK }
        let n = if icon.len > 24 { 24 } else { icon.len }
        slice::copy(u8){ dst = e.icon[..n], src = icon[..n] }
        e.icon_len = n
        return e
    }

    fn empty_list {} -> ActionList {
        return ActionList{ entries = [entry{ act = Act::none, icon = "", strref = 0 }; 12], count = 0, selected = 0 }
    }

    fn push_entry { mut l: ActionList, e: Entry } {
        if l.count >= LIST_MAX { return }
        l.entries[l.count] = e
        l.count = l.count + 1
    }

    // Whether `id` is hostile to the party leader.
    fn is_hostile { w: *world::World, id: u32 } -> bool {
        let o = world::object{ w, id } ifnull { return false }
        let lo = world::object{ w, id = party::leader{ w } } ifnull { return false }
        if o.kind != obj::Kind::creature { return false }
        return world::standing{ w, from = o.faction, toward = lo.faction } < HOSTILE_BELOW
    }

    // Whether the pointer can pick `id` and the leader can target it: close enough, and by kind
    // (movement.md 7.1) a living creature other than the leader, a closed door that isn't scenery,
    // a placeable that can be used.
    fn is_selectable { w: *world::World, id: u32 } -> bool {
        let leader = party::leader{ w }
        if id == leader { return false }
        let o = world::object{ w, id } ifnull { return false }
        let lo = world::object{ w, id = leader } ifnull { return false }
        let dx = o.position.x - lo.position.x
        let dy = o.position.y - lo.position.y
        let dz = o.position.z - lo.position.z
        if dx * dx + dy * dy + dz * dz > RANGE2 { return false }
        match o.ext {
            creature{ c } => { return not c.dead and o.hp > 0 }
            door{ d } => { return d.state == obj::DoorState::closed and not d.static }
            placeable{ p } => { return (p.useable or p.has_inventory) and not p.static }
            else => { return false }
        }
    }

    // What the leader can do to `id` by default, in the order the slot offers them (the first is
    // the default action: movement.md 7.4).
    fn default_actions { w: *world::World, id: u32 } -> ActionList {
        let mut l = empty_list{}
        let o = world::object{ w, id } ifnull { return l }
        match o.ext {
            door{ d } => {
                // A locked door the leader can pick (Security trained): that comes first.
                if d.locked and not d.key_required and can_pick_locks{ w } {
                    push_entry{ &l, e = entry{ act = Act::unlock, icon = "isk_security", strref = 329 } }
                }
                push_entry{ &l, e = entry{ act = Act::open, icon = "i_opendoor", strref = 365 } }
                // Only a locked door that is not plot can be bashed (movement.md 7.4).
                if d.locked and not o.plot { push_entry{ &l, e = entry{ act = Act::bash, icon = "i_attack", strref = 368 } } }
            }
            placeable{ p } => {
                // A locked container offers the skill even when it wants a key: the attempt says so.
                if p.locked and p.has_inventory and can_pick_locks{ w } {
                    push_entry{ &l, e = entry{ act = Act::unlock, icon = "isk_security", strref = 329 } }
                }
                if p.has_inventory { push_entry{ &l, e = entry{ act = Act::open_place, icon = "i_openplace", strref = 365 } } }
                else { push_entry{ &l, e = entry{ act = Act::use_place, icon = "i_useplace", strref = 366 } } }
            }
            creature{ c } => {
                if is_hostile{ w, id } { push_entry{ &l, e = entry{ act = Act::attack, icon = "i_attack", strref = 375 } } }
                else { push_entry{ &l, e = entry{ act = Act::talk, icon = "i_dialog", strref = 371 } } }
            }
            else => {}
        }
        return l
    }

    // The reason a known power cannot be cast now (R_OK when it can): the rules' answer as the
    // action menus' reason codes (re/gui.md "Action menus").
    fn power_reason { w: *world::World, f: *fight::Fighter, spell: i32, alive: bool } -> i32 {
        let r = rules::can_cast_spell{ tables = w.rules, c = &f.c, spell, alive, from_item = false }
        if r == rules::cast::DEAD { return R_DEAD }
        if r == rules::cast::NOT_ENOUGH_FP { return R_FORCE }
        if r == rules::cast::FORBIDDEN_EQUIPMENT or r == rules::cast::MISSING_EQUIPMENT { return R_ARMOR }
        return R_OK
    }

    // The spells.2da Exclusion bits that apply to a target (UpdateActionMenus' 0x006191f0): a
    // droid (racialtypes row 5) excludes the powers that bar droids (bit 1), a human (row 6) those
    // that bar humans (bit 0, the droid-only powers); any other race leaves both kinds.
    fn target_exclusion { w: *world::World, target: u32 } -> i32 {
        let t = ruled_of{ w, id = target } ifnull { return 0 }
        if t.c.race == 5 { return 2 }
        if t.c.race == 6 { return 1 }
        return 0
    }

    // The Force powers the leader can cast at a hostile creature, as the middle slot of the target
    // block lists them: one entry per hostile line (spells.2da ForceHostile: stun, choke, push...),
    // the known power of that line with the highest ForcePriority (Stasis Field over Stasis; a line
    // never lists its lower rungs), the lines in order. The powers that do not suit the target's
    // race are left out.
    fn power_actions { w: *world::World, target: u32 } -> ActionList {
        let mut l = empty_list{}
        let leader = party::leader{ w }
        let f = ruled_of{ w, id = leader } ifnull { return l }
        let alive = not is_down{ w, id = leader }
        let exclude = target_exclusion{ w, target }
        let mut best_row: [10]i32 = [-1; 10]
        let mut best_pri: [10]i32 = [-1; 10]
        let mut spell: usize = 0
        let rows = twoda::rows{ t = w.tables.spells }
        while spell < rows and spell < 256 {
            let s = @as(i32, spell)
            spell = spell + 1
            if not rules::knows_power{ c = &f.c, spell = s } { continue }
            let row = rules::get_spell{ tables = w.rules, row = s } ifnull { continue }
            if not row.valid or row.user_type != 1 or row.line_hostile < 0 or row.line_hostile >= 10 { continue }
            if (row.exclusion & exclude) != 0 { continue }
            let line = @as(usize, row.line_hostile)
            if row.priority > best_pri[line] {
                best_pri[line] = row.priority
                best_row[line] = s
            }
        }
        let mut line: usize = 0
        while line < 10 {
            let s = best_row[line]
            line = line + 1
            if s < 0 { continue }
            let row = rules::get_spell{ tables = w.rules, row = s } ifnull { continue }
            let icon = twoda::get_string{ t = w.tables.spells, row = @as(usize, s), column = "iconresref" } ifnull ""
            let mut e = entry{ act = Act::power, icon, strref = @as(u32, row.name) }
            e.id = s
            e.reason = power_reason{ w, f, spell = s, alive }
            e.usable = e.reason == R_OK
            push_entry{ &l, e }
        }
        return l
    }

    // Whether the party leader has the Security skill trained.
    fn can_pick_locks { w: *world::World } -> bool {
        let o = world::object{ w, id = party::leader{ w } } ifnull { return false }
        let c = obj::creature{ o } ifnull { return false }
        let f = c.fighter ifnull { return false }
        return rt_talent::has_skill{ w, f, skill = rules::skill::SECURITY }
    }

    // The pointer's picture for what a click on `id` would do.
    fn cursor_for { w: *world::World, id: u32 } -> u32 {
        let l = default_actions{ w, id }
        if l.count == 0 { return gui::CURSOR_DEFAULT }
        match l.entries[0].act {
            open => { return gui::CURSOR_DOOR }
            bash => { return gui::CURSOR_BASH }
            use_place | open_place | unlock => { return gui::CURSOR_USE }
            talk => { return gui::CURSOR_TALK }
            attack => { return gui::CURSOR_ATTACK }
            else => { return gui::CURSOR_DEFAULT }
        }
    }

    // The selectable object under the GUI point (x, y), the nearest to the eye among those whose
    // box on the screen holds it; INVALID for none.
    fn pick_at { p: Projector, w: *world::World, x: i32, y: i32 } -> u32 {
        let all = list::items{ list = w.objects.all }
        let fx = @as(f32, x)
        let fy = @as(f32, y)
        let mut best = obj::INVALID
        let mut best_d: f32 = 1000000.0
        let mut i: usize = 0
        while i < all.len {
            let o = all[i]
            i = i + 1
            if o.destroyed { continue }
            if o.kind != obj::Kind::creature and o.kind != obj::Kind::door and o.kind != obj::Kind::placeable { continue }
            if not is_selectable{ w, id = o.id } { continue }
            let b = box_on_screen{ p, o } ifnull { continue }
            if fx < b.x0 - 4.0 or fx > b.x1 + 4.0 or fy < b.y0 - 4.0 or fy > b.y1 + 4.0 { continue }
            let dx = o.position.x - p.eye.x
            let dy = o.position.y - p.eye.y
            let dz = o.position.z - p.eye.z
            let d = dx * dx + dy * dy + dz * dz
            if d < best_d {
                best_d = d
                best = o.id
            }
        }
        return best
    }

    // Q and E: the next (or previous) selectable object around the leader by bearing from its
    // facing, wrapping; hostile ones only in combat (movement.md 7.3).
    fn cycle_target { mut w: world::World, forward: bool } {
        let leader = party::leader{ w = &w }
        let lo = world::object{ w = &w, id = leader } ifnull { return }
        let facing = math::atan2f{ y = lo.orientation.y, x = lo.orientation.x }
        let all = list::items{ list = w.objects.all }
        let mut ids: [32]u32
        let mut bearing: [32]f32
        let mut n: usize = 0
        let mut i: usize = 0
        while i < all.len and n < 32 {
            let o = all[i]
            i = i + 1
            if o.destroyed or not is_selectable{ w = &w, id = o.id } { continue }
            let mut in_combat = false
            if lo.ext is creature{ c = lc } { in_combat = lc.in_combat }
            if in_combat and not is_hostile{ w = &w, id = o.id } { continue }
            let mut a = math::atan2f{ y = o.position.y - lo.position.y, x = o.position.x - lo.position.x } - facing
            while a > 3.1415927 { a = a - 6.2831855 }
            while a < -3.1415927 { a = a + 6.2831855 }
            ids[n] = o.id
            bearing[n] = a
            n = n + 1
        }
        if n == 0 {
            w.target = obj::INVALID
            return
        }
        // Sorted by bearing, so Q and E walk around the leader.
        let mut a: usize = 1
        while a < n {
            let mut b = a
            while b > 0 and bearing[b - 1] > bearing[b] {
                let ti = ids[b]
                let tb = bearing[b]
                ids[b] = ids[b - 1]
                bearing[b] = bearing[b - 1]
                ids[b - 1] = ti
                bearing[b - 1] = tb
                b = b - 1
            }
            a = a + 1
        }
        let mut at: usize = n
        let mut k: usize = 0
        while k < n {
            if ids[k] == w.target { at = k }
            k = k + 1
        }
        let next = if at == n { if forward { 0 } else { n - 1 } } else if forward { (at + 1) % n } else { (at + n - 1) % n }
        w.target = ids[next]
    }

    // Does `act` on `target` for the leader: queues the matching action in place of whatever it
    // was doing (the player's choice replaces the queue, actions.md).
    fn run_act { mut w: world::World, act: Act, target: u32, id: i32 } {
        let leader = party::leader{ w = &w }
        if act == Act::power {
            // A Force power at the target; the cast walks into range itself.
            actions::clear_all{ &w, id = leader }
            rt_talent::queue_cast{ &w, me = leader, spell = id, target, location = math::vec3::zero{}, cheat = 0, instant = 0, item = obj::INVALID }
            return
        }
        let kind: actions::Kind = match act {
            open => { actions::Kind::open_door }
            use_place | open_place => { actions::Kind::use_object }
            unlock => { actions::Kind::open_lock }
            talk => { actions::Kind::dialog_object }
            attack | bash => { actions::Kind::attack_object }
            else => { return }
        }
        let mut a = actions::make{ kind }
        a.params[0] = actions::Param::object{ id = target }
        actions::clear_all{ &w, id = leader }
        _ = actions::add{ &w, id = leader, action = a, force = false }
    }
}
