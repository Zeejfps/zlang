// Targets and their actions (docs/re/movement.md section 7, docs/re/gui.md "Action menus"):
// which objects the pointer can pick, which one is the target, what the leader can do to it, and
// the block that floats over it with its name, health and three action slots.
namespace hud {
    // Objects farther than this from the leader (squared metres) are not selectable.
    const RANGE2: f32 = 900.0
    // Below this standing an object is hostile to the leader (repute.2da: 0..10).
    const HOSTILE_BELOW: i32 = 11

    // What a slot does when pressed.
    enum Act: u8 { none, open, bash, use_place, open_place, talk, attack, unlock, throw, power, feat_attack, disarm_mine, recover_mine }

    // Why an entry cannot be used now (the original's reason codes, strings in REASON_TEXT).
    const R_OK: i32 = 0
    const R_FORCE: i32 = 1
    const R_ARMOR: i32 = 2
    const R_ITEM: i32 = 3
    const R_FULL: i32 = 5
    const R_DEAD: i32 = 6

    // dialog.tlk: the refusal messages by reason code (shown for 5 seconds in the message bar).
    const REASON_TEXT: [7]u32 = [0, 38613, 38614, 38615, 42422, 42498, 47936]

    // One choice in a slot: its icon (a texture in the GUI pack) and the dialog.tlk string that
    // names it; an item's (a grenade to throw) is named by the item, which `item` says. A power's
    // `id` is its spells.2da row; it dims and says `reason` when `usable` is false.
    struct Entry { act: Act, icon: [24]u8, icon_len: usize, strref: u32, item: u32, id: i32, usable: bool, reason: i32 }

    // The most choices a slot lists (the ten hostile power lines are the longest list).
    const LIST_MAX: usize = 12

    // A slot's choices, cycled with its arrows.
    struct ActionList { entries: [12]Entry, count: usize, selected: usize }

    fn entry { act: Act, icon: []u8, strref: u32 } -> Entry {
        let mut e = Entry{ act, icon = [0; 24], icon_len = 0, strref, item = obj::INVALID, id = -1, usable = true, reason = R_OK }
        let n = if icon.len > 24 { 24 } else { icon.len }
        slice::copy(u8){ dst = e.icon[..n], src = icon[..n] }
        e.icon_len = n
        return e
    }

    fn empty_list {} -> ActionList {
        return ActionList{ entries = [entry{ act = Act::none, icon = "", strref = 0 }; 12], count = 0, selected = 0 }
    }

    fn push_entry { mut l: ActionList, e: Entry } {
        if l.count >= LIST_MAX { return }
        l.entries[l.count] = e
        l.count = l.count + 1
    }

    // Whether `id` is hostile to the party leader.
    fn is_hostile { w: *world::World, id: u32 } -> bool {
        let o = world::object{ w, id } ifnull { return false }
        let lo = world::object{ w, id = party::leader{ w } } ifnull { return false }
        if o.kind != obj::Kind::creature { return false }
        return world::standing{ w, from = o.faction, toward = lo.faction } < HOSTILE_BELOW
    }

    // Whether the pointer can pick `id` and the leader can target it: close enough, by kind
    // (movement.md 7.1) a living creature other than the leader, a closed door that isn't scenery,
    // a placeable that can be used, and in view (in_view).
    fn is_selectable { w: *world::World, id: u32 } -> bool {
        return selectable_kind{ w, id } and in_view{ w, id }
    }

    // Whether the leader can see `id` from where it stands (CSWCCreature::GetIsTargetVisible 0x00617ad0, which
    // the pointer, Q and E and the auto-target all ask): a creature is in the leader's perception list as seen,
    // or seen this instant (GetIsSelectableTarget's own fallback), and the line from the leader's eyes meets no
    // wall and no closed door. A closed door in the way hides what is behind it.
    fn in_view { w: *world::World, id: u32 } -> bool {
        let lo = world::object{ w, id = party::leader{ w } } ifnull { return false }
        let o = world::object{ w, id } ifnull { return false }
        if o.kind == obj::Kind::creature {
            let listed = perception::entry_of{ w, viewer = lo.id, target = id } is some{ value = e } and e.seen
            if not listed and not perception::sees_now{ w, viewer = lo.id, target = id } { return false }
        }
        return perception::sight_line{ w, a = lo.position, b = o.position, ignore = id }
    }

    // Whether the area allows combat (RestrictMode 0, `area+0x2b0`): Attack and Bash are offered only then.
    fn combat_allowed { w: *world::World } -> bool {
        let ao = world::object{ w, id = w.area } ifnull { return true }
        let a = obj::area{ o = ao } ifnull { return true }
        return a.restrict_mode == 0
    }

    // GetIsSelectableTarget's own tests (0x004f2c30) within the 30 m of GetNearbySelectableObjects.
    fn selectable_kind { w: *world::World, id: u32 } -> bool {
        let leader = party::leader{ w }
        if id == leader { return false }
        let o = world::object{ w, id } ifnull { return false }
        let lo = world::object{ w, id = leader } ifnull { return false }
        let dx = o.position.x - lo.position.x
        let dy = o.position.y - lo.position.y
        let dz = o.position.z - lo.position.z
        if dx * dx + dy * dy + dz * dz > RANGE2 { return false }
        match o.ext {
            creature{ c } => { return not c.dead and o.hp > 0 }
            // An area transition stays clickable once someone has opened it (the click walks the leader through).
            door{ d } => { return (d.state == obj::DoorState::closed or modload::link_of{ o } != null) and not d.static }
            placeable{ p } => { return (p.useable or p.has_inventory) and not p.static }
            trigger{ t } => { return traps::is_known{ w, o } }
            else => { return false }
        }
    }

    // What the leader does to `id` when it clicks the target or presses R (BuildDefaultActions 0x00620620,
    // movement.md 7.4); the first is the default action. A door: Open (the server refuses a locked one with
    // the locked message and OnFailToOpen), then Bash when it is locked, not plot and the area allows combat.
    // The unlock is never the default: it is in the block's middle slot (slot_actions).
    fn default_actions { w: *world::World, id: u32 } -> ActionList {
        let mut l = empty_list{}
        let o = world::object{ w, id } ifnull { return l }
        match o.ext {
            door{ d } => {
                push_entry{ &l, e = entry{ act = Act::open, icon = "i_opendoor", strref = 365 } }
                if d.locked and not o.plot and combat_allowed{ w } { push_entry{ &l, e = entry{ act = Act::bash, icon = "i_attack", strref = 368 } } }
            }
            placeable{ p } => {
                if p.has_inventory { push_entry{ &l, e = entry{ act = Act::open_place, icon = "i_openplace", strref = 365 } } }
                else { push_entry{ &l, e = entry{ act = Act::use_place, icon = "i_useplace", strref = 366 } } }
                if p.locked and not o.plot and combat_allowed{ w } { push_entry{ &l, e = entry{ act = Act::bash, icon = "i_attack", strref = 368 } } }
            }
            creature{ c } => {
                if is_hostile{ w, id } {
                    if combat_allowed{ w } { push_entry{ &l, e = entry{ act = Act::attack, icon = "i_attack", strref = 375 } } }
                } else { push_entry{ &l, e = entry{ act = Act::talk, icon = "i_dialog", strref = 371 } } }
            }
            trigger{ t } => {
                // A mine (BuildDefaultActions kind 2, movement.md 7.4; 0x00691f00): Disable when it is
                // hostile to the leader, Recover on any, both only for a leader with Demolitions.
                let leader = party::leader{ w }
                if traps::can_disable{ w, who = leader, o } { push_entry{ &l, e = entry{ act = Act::disarm_mine, icon = "i_disablemine", strref = 370 } } }
                if traps::can_recover{ w, who = leader, o } { push_entry{ &l, e = entry{ act = Act::recover_mine, icon = "i_recovermine", strref = 1531 } } }
            }
            else => {}
        }
        return l
    }

    // What the target block's slot `k` holds for a door or placeable (FUN_00684410 and FUN_006837d0): the left
    // one Bash when it is locked, not plot and the area allows combat; the middle one Security (the unlock)
    // when it is locked and the leader has the skill, a door also only when it wants no key. Open, Use and
    // Talk are in no slot: they are what a click does.
    fn slot_actions { w: *world::World, id: u32, k: usize } -> ActionList {
        let mut l = empty_list{}
        let o = world::object{ w, id } ifnull { return l }
        let mut locked = false
        let mut wants_key = false
        match o.ext {
            door{ d } => {
                locked = d.locked
                wants_key = d.key_required
            }
            placeable{ p } => { locked = p.locked and (p.useable or p.has_inventory) }
            else => { return l }
        }
        if not locked { return l }
        if k == 0 and not o.plot and combat_allowed{ w } {
            push_entry{ &l, e = entry{ act = Act::bash, icon = "i_attack", strref = 368 } }
        }
        if k == 1 and not wants_key and can_pick_locks{ w } {
            push_entry{ &l, e = entry{ act = Act::unlock, icon = "isk_security", strref = 329 } }
        }
        return l
    }

    // A mine's Recover has the middle slot to itself (0x00691f00 fills the left slot with Disable,
    // the middle with Recover): moved there out of the left list. Other targets keep theirs.
    fn split_mine { mut left: ActionList, mut middle: ActionList, w: *world::World, id: u32 } {
        let o = world::object{ w, id } ifnull { return }
        if o.kind != obj::Kind::trigger { return }
        let mut kept = empty_list{}
        let mut i: usize = 0
        while i < left.count {
            if left.entries[i].act == Act::recover_mine { push_entry{ l = &middle, e = left.entries[i] } } else { push_entry{ l = &kept, e = left.entries[i] } }
            i = i + 1
        }
        left = kept
    }

    // The reason a known power cannot be cast now (R_OK when it can): the rules' answer as the
    // action menus' reason codes (re/gui.md "Action menus").
    fn power_reason { w: *world::World, f: *fight::Fighter, spell: i32, alive: bool } -> i32 {
        let r = rules::can_cast_spell{ tables = w.rules, c = &f.c, spell, alive, from_item = false }
        if r == rules::cast::DEAD { return R_DEAD }
        if r == rules::cast::NOT_ENOUGH_FP { return R_FORCE }
        if r == rules::cast::FORBIDDEN_EQUIPMENT or r == rules::cast::MISSING_EQUIPMENT { return R_ARMOR }
        return R_OK
    }

    // The spells.2da Exclusion bits that apply to a target (UpdateActionMenus' 0x006191f0): a
    // droid (racialtypes row 5) excludes the powers that bar droids (bit 1), a human (row 6) those
    // that bar humans (bit 0, the droid-only powers); any other race leaves both kinds.
    fn target_exclusion { w: *world::World, target: u32 } -> i32 {
        let t = ruled_of{ w, id = target } ifnull { return 0 }
        if t.c.race == 5 { return 2 }
        if t.c.race == 6 { return 1 }
        return 0
    }

    // The Force powers the leader can cast at a hostile creature, as the middle slot of the target
    // block lists them: one entry per hostile line (spells.2da ForceHostile: stun, choke, push...),
    // the known power of that line with the highest ForcePriority (Stasis Field over Stasis; a line
    // never lists its lower rungs), the lines in order. The powers that do not suit the target's
    // race are left out.
    fn power_actions { w: *world::World, target: u32 } -> ActionList {
        let mut l = empty_list{}
        let leader = party::leader{ w }
        let f = ruled_of{ w, id = leader } ifnull { return l }
        let alive = not is_down{ w, id = leader }
        let exclude = target_exclusion{ w, target }
        let mut best_row: [10]i32 = [-1; 10]
        let mut best_pri: [10]i32 = [-1; 10]
        let mut spell: usize = 0
        let rows = twoda::rows{ t = w.tables.spells }
        while spell < rows and spell < 256 {
            let s = @as(i32, spell)
            spell = spell + 1
            if not rules::knows_power{ c = &f.c, spell = s } { continue }
            let row = rules::get_spell{ tables = w.rules, row = s } ifnull { continue }
            if not row.valid or row.user_type != 1 or row.line_hostile < 0 or row.line_hostile >= 10 { continue }
            if (row.exclusion & exclude) != 0 { continue }
            let line = @as(usize, row.line_hostile)
            if row.priority > best_pri[line] {
                best_pri[line] = row.priority
                best_row[line] = s
            }
        }
        let mut line: usize = 0
        while line < 10 {
            let s = best_row[line]
            line = line + 1
            if s < 0 { continue }
            let row = rules::get_spell{ tables = w.rules, row = s } ifnull { continue }
            let icon = twoda::get_string{ t = w.tables.spells, row = @as(usize, s), column = "iconresref" } ifnull ""
            let mut e = entry{ act = Act::power, icon, strref = @as(u32, row.name) }
            e.id = s
            e.reason = power_reason{ w, f, spell = s, alive }
            e.usable = e.reason == R_OK
            push_entry{ &l, e }
        }
        return l
    }

    // Whether the party leader has the Security skill trained.
    fn can_pick_locks { w: *world::World } -> bool {
        let o = world::object{ w, id = party::leader{ w } } ifnull { return false }
        let c = obj::creature{ o } ifnull { return false }
        let f = c.fighter ifnull { return false }
        return rt_talent::has_skill{ w, f, skill = rules::skill::SECURITY }
    }

    // The pointer's picture over `id` (SetHoverObject 0x006222f0, movement.md 7.2): over the current target it
    // is the picture of its default action (GetCursorForAction 0x0061faa0: open door 0x3f2 the door, talk
    // 0x3ea the talk bubble, use 0x3f7 the hand, attack 0x3eb the kill reticle, bash 0x3f5 the bash);
    // over any other selectable object the select cursor; over nothing the arrow.
    fn cursor_for { w: *world::World, id: u32 } -> u32 {
        if id == obj::INVALID { return gui::CURSOR_DEFAULT }
        if id != w.target { return gui::CURSOR_SELECT }
        return action_cursor{ w, id }
    }

    // The picture of what a click on the target `id` would do.
    fn action_cursor { w: *world::World, id: u32 } -> u32 {
        let l = default_actions{ w, id }
        if l.count == 0 { return gui::CURSOR_INVALID }
        match l.entries[0].act {
            open => { return gui::CURSOR_DOOR }
            bash => { return gui::CURSOR_BASH }
            use_place | open_place => { return gui::CURSOR_USE }
            unlock => { return gui::CURSOR_LOCK }
            talk => { return gui::CURSOR_TALK }
            attack => { return gui::CURSOR_KILL }
            disarm_mine => { return gui::CURSOR_DISMINE }        // 0x3f4
            recover_mine => { return gui::CURSOR_RECMINE }       // 0x402
            else => { return gui::CURSOR_INVALID }
        }
    }

    // The selectable object under the GUI point (x, y), the nearest to the eye among those whose
    // box on the screen holds it; INVALID for none.
    fn pick_at { p: Projector, w: *world::World, x: i32, y: i32 } -> u32 {
        let all = list::items{ list = w.objects.all }
        let fx = @as(f32, x)
        let fy = @as(f32, y)
        let mut best = obj::INVALID
        let mut best_d: f32 = 1000000.0
        let mut i: usize = 0
        while i < all.len {
            let o = all[i]
            i = i + 1
            if o.destroyed { continue }
            if o.kind != obj::Kind::creature and o.kind != obj::Kind::door and o.kind != obj::Kind::placeable and o.kind != obj::Kind::trigger { continue }
            if not is_selectable{ w, id = o.id } { continue }
            let b = box_on_screen{ p, o } ifnull { continue }
            if fx < b.x0 - 4.0 or fx > b.x1 + 4.0 or fy < b.y0 - 4.0 or fy > b.y1 + 4.0 { continue }
            let dx = o.position.x - p.eye.x
            let dy = o.position.y - p.eye.y
            let dz = o.position.z - p.eye.z
            let d = dx * dx + dy * dy + dz * dz
            if d < best_d {
                best_d = d
                best = o.id
            }
        }
        return best
    }

    // Q and E: the next (or previous) selectable object around the leader by bearing from its
    // facing, wrapping; hostile ones only in combat (movement.md 7.3).
    fn cycle_target { mut w: world::World, forward: bool } {
        let leader = party::leader{ w = &w }
        let lo = world::object{ w = &w, id = leader } ifnull { return }
        let all = list::items{ list = w.objects.all }
        let mut ids: [32]u32
        let mut bearing: [32]f32
        let mut n: usize = 0
        let mut i: usize = 0
        while i < all.len and n < 32 {
            let o = all[i]
            i = i + 1
            if o.destroyed or not is_selectable{ w = &w, id = o.id } { continue }
            let mut in_combat = false
            if lo.ext is creature{ c = lc } { in_combat = lc.in_combat }
            if in_combat and not is_hostile{ w = &w, id = o.id } { continue }
            let a = bearing_to{ lo, p = o.position }
            ids[n] = o.id
            bearing[n] = a
            n = n + 1
        }
        if n == 0 {
            w.target = obj::INVALID
            return
        }
        // Sorted by bearing, so Q and E walk around the leader.
        let mut a: usize = 1
        while a < n {
            let mut b = a
            while b > 0 and bearing[b - 1] > bearing[b] {
                let ti = ids[b]
                let tb = bearing[b]
                ids[b] = ids[b - 1]
                bearing[b] = bearing[b - 1]
                ids[b - 1] = ti
                bearing[b - 1] = tb
                b = b - 1
            }
            a = a + 1
        }
        let mut at: usize = n
        let mut k: usize = 0
        while k < n {
            if ids[k] == w.target { at = k }
            k = k + 1
        }
        let next = if at == n { if forward { 0 } else { n - 1 } } else if forward { (at + 1) % n } else { (at + n - 1) % n }
        w.target = ids[next]
        autopause::request{ &w, reason = autopause::NEW_TARGET }
    }

    // Does `act` on `target` for the leader: queues the matching action in place of whatever it
    // was doing (the player's choice replaces the queue, actions.md).
    //
    // `queue` adds the order behind the leader's others instead of replacing them: the slot keys and buttons
    // in combat mode queue, and Shift makes them replace (UseSelfAction 0x0068ad60, OnActionButton
    // 0x0068b970); out of combat an order replaces what the leader was doing.
    fn run_act { mut w: world::World, act: Act, target: u32, item: u32, spell: i32, queue: bool } {
        let leader = party::leader{ w = &w }
        if act == Act::power {
            // A Force power at the target; the cast walks into range itself.
            if not queue { actions::clear_all{ &w, id = leader } }
            rt_talent::queue_cast{ &w, me = leader, spell, target, location = math::vec3::zero{}, cheat = 0, instant = 0, item = obj::INVALID }
            return
        }
        if act == Act::throw {
            // A grenade: its ability cast at the target (a fighting order: make_room_to_fight).
            let spell = rt_item::ability_of{ w = &w, id = item }
            if spell < 0 { return }
            if not make_room_to_fight{ &w, leader, queue } { return }
            rt_item::signal_activation{ &w, who = leader, item, target }
            rt_talent::queue_cast{ &w, me = leader, spell, target, location = math::vec3::zero{}, cheat = 0, instant = 0, item }
            return
        }
        if act == Act::feat_attack {
            // A combat feat's attack: the feat (the entry's id) in ATTACKOBJECT's param 2, as the
            // original's 0x00617dd0 sends it with the attack.
            if not make_room_to_fight{ &w, leader, queue } { return }
            let mut a = actions::make{ kind = actions::Kind::attack_object }
            a.params[0] = actions::Param::object{ id = target }
            a.params[2] = actions::Param::int{ v = spell }
            _ = actions::add{ &w, id = leader, action = a, force = false }
            return
        }
        let kind: actions::Kind = match act {
            open => { actions::Kind::open_door }
            use_place | open_place => { actions::Kind::use_object }
            unlock => { actions::Kind::open_lock }
            talk => { actions::Kind::dialog_object }
            attack | bash => { actions::Kind::attack_object }
            disarm_mine => { actions::Kind::disable_trap }
            recover_mine => { actions::Kind::recover_trap }
            else => { return }
        }
        // The mine actions go through UseSkill, which refuses a trap that cannot be disarmed.
        if kind == actions::Kind::disable_trap or kind == actions::Kind::recover_trap {
            let o = world::object{ w = &w, id = target } ifnull { return }
            let trap = traps::of{ o } ifnull { return }
            if not trap.disarmable { return }
        }
        let mut a = actions::make{ kind }
        a.params[0] = actions::Param::object{ id = target }
        if act == Act::talk {
            // The player's talk order: walk up first (DIALOGOBJECT's approach mode 1, ignore-range 0).
            a.params[2] = actions::Param::int{ v = 0 }
            a.params[3] = actions::Param::int{ v = 1 }
            a.params[4] = actions::Param::int{ v = 0 }
        }
        if kind == actions::Kind::attack_object {
            if not make_room_to_fight{ &w, leader, queue } { return }
        } else if not queue {
            actions::clear_for_player{ &w, id = leader }
        }
        _ = actions::add{ &w, id = leader, action = a, force = false }
    }

    // Whether a slot order goes behind the leader's queue: in combat mode, unless Shift is held.
    fn queues_orders { h: *Hud, w: *world::World } -> bool {
        return leader_in_combat{ w } and not h.alternate
    }

    // The fighting orders waiting in the leader's queue (attacks and casts).
    fn pending_fights { w: *world::World, leader: u32 } -> usize {
        let o = world::object{ w, id = leader } ifnull { return 0 }
        let q = list::items{ list = o.actions }
        let mut n: usize = 0
        let mut i: usize = 0
        while i < q.len {
            if q[i].kind == actions::Kind::attack_object or q[i].kind == actions::Kind::cast_spell { n = n + 1 }
            i = i + 1
        }
        return n
    }

    // A fighting order (AddAttackActions' scheduled path, actions.md 3.13): one that replaces clears
    // what the leader was doing; one that queues waits behind the round in progress and the orders
    // before it, and is refused when four already wait. True when the order may be added.
    fn make_room_to_fight { mut w: world::World, leader: u32, queue: bool } -> bool {
        if queue { return pending_fights{ w = &w, leader } < 4 }
        actions::clear_for_player{ &w, id = leader }
        return true
    }

    // ---- the target block's attack slot

    // The first of three feats (best rank first) the creature has, -1 for none (0x00616140).
    fn best_feat { c: *rules::Creature, a: i32, b: i32, cc: i32 } -> i32 {
        if rules::has_feat{ c, feat = a } { return a }
        if rules::has_feat{ c, feat = b } { return b }
        if rules::has_feat{ c, feat = cc } { return cc }
        return -1
    }

    // A feat's choice: feat.2da's NAME and ICON (the original's 0x00618a30); its id is the feat.
    fn push_feat { w: *world::World, mut l: ActionList, feat: i32 } {
        if feat < 0 { return }
        let row = @as(usize, feat)
        let icon = twoda::get_string{ t = w.tables.feat, row, column = "icon" } ifnull ""
        let name = twoda::get_int{ t = w.tables.feat, row, column = "name" } ifnull 0
        let mut e = entry{ act = Act::feat_attack, icon, strref = @as(u32, name) }
        e.id = feat
        push_entry{ &l, e }
    }

    // The target block's first slot (UpdateActionMenus -> CSWGuiTargetInfo::Refresh 0x00689410 ->
    // 0x00619c20 by the target's kind). On a hostile creature: the leader's best rank of each
    // combat feat for the weapon in its right hand, then Attack (0x00619950, 0x00619b10): Critical
    // Strike, Flurry, Power Attack for melee; Power Blast, Rapid Shot, Sniper Shot for a ranged
    // weapon. On anything else the default actions. (The click on the target and R take the default
    // actions' first, plain Attack: BuildDefaultActions, movement.md 7.4.)
    fn attack_slot { w: *world::World, id: u32 } -> ActionList {
        let plain = default_actions{ w, id }
        if not is_hostile{ w, id } {
            // A mine's Disable and Recover; a locked door's or placeable's Bash; nothing on a friendly creature.
            if world::object{ w, id } is some{ value = o } { if o.kind == obj::Kind::trigger { return plain } }
            return slot_actions{ w, id, k = 0 }
        }
        let lo = world::object{ w, id = party::leader{ w } } ifnull { return plain }
        let lc = obj::creature{ o = lo } ifnull { return plain }
        let f = lc.fighter ifnull { return plain }
        let mut ranged = false
        if world::object{ w, id = lc.equipped[obj::SLOT_RIGHT_WEAPON] } is some{ value = io } {
            if obj::item{ o = io } is some{ value = it } {
                ranged = (twoda::get_int{ t = w.tables.baseitems, row = @as(usize, it.base), column = "rangedweapon" } ifnull 0) != 0
            }
        }
        let mut l = empty_list{}
        if ranged {
            push_feat{ w, &l, feat = best_feat{ c = &f.c, a = 82, b = 18, cc = 29 } }
            push_feat{ w, &l, feat = best_feat{ c = &f.c, a = 26, b = 92, cc = 30 } }
            push_feat{ w, &l, feat = best_feat{ c = &f.c, a = 77, b = 20, cc = 31 } }
        } else {
            push_feat{ w, &l, feat = best_feat{ c = &f.c, a = 81, b = 19, cc = 8 } }
            push_feat{ w, &l, feat = best_feat{ c = &f.c, a = 53, b = 91, cc = 11 } }
            push_feat{ w, &l, feat = best_feat{ c = &f.c, a = 83, b = 17, cc = 28 } }
        }
        let mut i: usize = 0
        while i < plain.count {
            push_entry{ &l, e = plain.entries[i] }
            i = i + 1
        }
        return l
    }

    // A slot's new list keeps the choice the player made in it, when the new list has it (the
    // original remembers each slot's selected entry by its id, CSWGuiTargetInfo::Refresh).
    fn keep_choice { old: ActionList, new: ActionList } -> ActionList {
        let mut l = new
        if old.count == 0 { return l }
        let was = old.entries[old.selected]
        let mut i: usize = 0
        while i < l.count {
            let e = l.entries[i]
            if e.act == was.act and e.id == was.id and e.item == was.item { l.selected = i }
            i = i + 1
        }
        return l
    }
}
