// What the HUD and the in-game panels read from the game (docs/design/hud.md, "Reading the
// game"). Every question the interface asks of the world is one function here, so the places
// where a system is still a stand-in (the party purse and the journal wait for their owners)
// change in one file. Force points, the level and the level-up test come from the creature's
// rules state (fight::Fighter.c) when it has one.
namespace hud {
    // The creature behind an id, or null for anything else (an item, a door, a stale id).
    fn creature_of { w: *world::World, id: u32 } -> ?*mut obj::Creature {
        let o = world::object{ w, id } ifnull { return null }
        return obj::creature{ o }
    }

    // The party, leader first.
    fn party_ids { w: *world::World } -> []u32 { return party::members{ w } }

    // A name for display: the object's dialog.tlk string when it has a strref, else its own text.
    fn name_of { w: *world::World, id: u32 } -> []u8 {
        let o = world::object{ w, id } ifnull { return "" }
        if o.name.strref != 0xFFFFFFFF {
            let text = world::string_by_strref{ w, strref = o.name.strref }
            if text.len > 0 { return text }
        }
        return o.name.text
    }

    // Hit points as the bars show them: current and maximum, never below zero.
    struct Vitality { hp: i32, hp_max: i32 }

    fn vitality_of { w: *world::World, id: u32 } -> Vitality {
        let o = world::object{ w, id } ifnull { return Vitality{ hp = 0, hp_max = 1 } }
        let max = if o.hp_max < 1 { 1 } else { o.hp_max }
        let hp = if o.hp < 0 { 0 } else if o.hp > max { max } else { o.hp }
        return Vitality{ hp, hp_max = max }
    }

    // The rules state of a creature that was read from a GFF, or null (then the fallbacks below
    // answer).
    fn ruled_of { w: *world::World, id: u32 } -> ?*mut fight::Fighter {
        let o = world::object{ w, id } ifnull { return null }
        let f = fight::of{ o } ifnull { return null }
        if not f.loaded { return null }
        return f
    }

    // Force points: current and maximum, from the rules creature (a creature with no Force has
    // max 1, value 0, as the original's bar does).
    struct Force { fp: i32, fp_max: i32 }

    fn force_of { w: *world::World, id: u32 } -> Force {
        let f = ruled_of{ w, id } ifnull { return Force{ fp = 0, fp_max = 1 } }
        let max = f.c.stats.max_fp
        if max < 1 { return Force{ fp = 0, fp_max = 1 } }
        let fp = if f.c.fp < 0 { 0 } else if f.c.fp > max { max } else { f.c.fp }
        return Force{ fp, fp_max = max }
    }

    // The character level: the rules' total over the class slots. Without a rules creature the
    // fallback sums the engine's class levels.
    fn level_of { w: *world::World, id: u32 } -> i32 {
        if ruled_of{ w, id } is some{ value = f } {
            if f.c.stats.level > 0 { return f.c.stats.level }
        }
        let c = creature_of{ w, id } ifnull { return 1 }
        let mut n: u32 = 0
        let mut i: usize = 0
        while i < 3 {
            n = n + c.class_levels[i]
            i = i + 1
        }
        if n == 0 { n = c.hit_dice }
        return if n == 0 { 1 } else { @as(i32, n) }
    }

    // The experience a character needs for level `level` + 1 (exptable.2da through the rules), 0
    // at the level cap.
    fn xp_for_next { w: *world::World, level: i32 } -> u32 {
        if level < 1 or level >= 20 { return 0 }
        return @as(u32, rules::xp_to_reach_level{ tables = w.rules, level = level + 1 })
    }

    // Whether the creature has the experience for a level it has not taken (the HUD shows the
    // level-up mark): the rules' CanLevelUp, or the XP test alone for a creature without rules.
    fn can_level_up { w: *world::World, id: u32 } -> bool {
        if ruled_of{ w, id } is some{ value = f } {
            return rules::can_level_up{ tables = w.rules, c = &f.c, alive = not is_down{ w, id } }
        }
        let c = creature_of{ w, id } ifnull { return false }
        let need = xp_for_next{ w, level = level_of{ w, id } }
        return need > 0 and c.xp >= need
    }

    // Whether the creature is down: dead, or out of hit points.
    fn is_down { w: *world::World, id: u32 } -> bool {
        let c = creature_of{ w, id } ifnull { return true }
        let o = world::object{ w, id } ifnull { return true }
        return c.dead or o.hp <= 0
    }

    // The portrait texture's resref for a creature: portraits.2da's baseresref for its row.
    fn portrait_of { w: *world::World, id: u32 } -> []u8 {
        let c = creature_of{ w, id } ifnull { return "" }
        return twoda::get_string{ t = w.tables.portraits, row = @as(usize, c.portrait), column = "baseresref" } ifnull ""
    }

    // Writes `prefix` then the decimal `n` into `into` and returns the used part: control tags
    // like PB_VIT1.
    fn tag_n { into: []mut u8, prefix: []u8, n: usize } -> []u8 {
        slice::copy(u8){ dst = into[..prefix.len], src = prefix }
        let digits = utf8::fmt_u64{ n = @as(u64, n), into = into[prefix.len..] }
        return into[..prefix.len + digits.bytes.len]
    }
}
