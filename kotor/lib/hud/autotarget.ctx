// The target the leader has without asking (CClientExoAppInternal::UpdateSelectableObjects 0x005fa5a0 and
// the target drop in ProcessInput 0x006227e0, docs/re/movement.md 7.1). Every frame the game works out what
// the leader can select within 30 m and keeps the HUD target on something:
//   - a target that is still in that list and in view stays, whoever picked it (a click, Q / E, the last
//     frame's pick); one out of sight for a second goes;
//   - a leader the keys keep moving (control speed 0.25 m/s or more), out of combat mode, loses its target
//     after half a second of that, so a player on the move gets the nearest thing in front every half
//     second and a player standing still keeps what he has;
//   - with no target, the pick is the nearest visible object in front of the leader (within 30 degrees of
//     its facing, seen from a point 4 m behind it); in combat mode with enemies about, the nearest hostile
//     in front, else the first hostile in sight by bearing, else the nearest object in front;
//   - the first enemy to come into sight (none has been in sight for 10 s) becomes the target and, out of
//     combat mode, asks for the "enemy sighted" auto-pause.
namespace hud {
    // cos 30 degrees, and how far behind the leader the cone's point is.
    const FRONT_COS: f32 = 0.866
    const BEHIND: f32 = 4.0
    // Seconds with no enemy in sight before the next one is announced; seconds a target may be out of
    // sight before it is dropped.
    const SIGHT_LATCH_S: f32 = 10.0
    const LOST_S: f32 = 1.0
    // The leader moving this fast (the control's larger velocity component, m/s) for this long without
    // a break drops the target.
    const MOVING_MIN: f32 = 0.25
    const MOVING_DROP_S: f32 = 0.5
    const NEAR_MAX: usize = 128
    const TWO_PI: f32 = 6.2831855

    // The counter-clockwise angle from the leader's facing to the direction of `p`, in [0, 2 pi): the
    // order Q and E walk the selectable objects in.
    fn measure_bearing { lo: *obj::Object, p: math::Vec3 } -> f32 {
        let facing = math::atan2f{ y = lo.orientation.y, x = lo.orientation.x }
        let mut a = math::atan2f{ y = p.y - lo.position.y, x = p.x - lo.position.x } - facing
        while a < 0.0 { a = a + TWO_PI }
        while a >= TWO_PI { a = a - TWO_PI }
        return a
    }

    // One frame of the auto-target, with a line in the objects log whenever the target changes: what it
    // was, what it is, how far away, and the angle from the leader's facing it lies at.
    // Its clocks are the world's (both functions are handed g_fFrameDelta, 0 while anything pauses the game,
    // movement.md 7.1): a pause freezes the walking drop, the out-of-view second and the sighting latch, so a
    // target the player clicks while paused stays. The real frame time would let the keys' velocity of the
    // frame the pause began (the control does not step while paused) drop a clicked enemy every half second.
    fn update_target { mut h: Hud, mut w: world::World, dt: f32 } {
        let before = w.target
        let world_dt = if w.clock.paused { 0.0 } else { dt }
        drop_while_moving{ &h, &w, dt = world_dt }
        pick_target{ &h, &w, dt = world_dt }
        if w.target != before and w.log.objects {
            let lo = world::object{ w = &w, id = party::leader{ w = &w } } ifnull { return }
            let mut bt: []u8 = "none"
            if world::object{ w = &w, id = before } is some{ value = bo } { bt = bo.tag }
            let mut at: []u8 = "none"
            let mut dist: f32 = 0.0
            let mut bearing: f32 = 0.0
            if world::object{ w = &w, id = w.target } is some{ value = no } {
                at = no.tag
                let dx = no.position.x - lo.position.x
                let dy = no.position.y - lo.position.y
                dist = math::sqrtf{ x = dx * dx + dy * dy }
                bearing = measure_bearing{ lo, p = no.position } * 57.29578
            }
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "target: {} -> {} ({} m, {} deg ccw of facing)\n", bt, at, dist, bearing)
        }
    }

    // ProcessInput's timer (client+0x36c): outside combat mode, a target and a leader moving by the keys
    // for half a second on end, and the target is gone (the pick below then finds the nearest in front).
    // Standing still, or any slower frame, starts the half second again; so does a frame in which an
    // auto-pause request is waiting its second (client+0x390, ingame's update_autopause).
    fn drop_while_moving { mut h: Hud, mut w: world::World, dt: f32 } {
        if w.target == obj::INVALID or h.move_speed < MOVING_MIN or leader_in_combat_mode{ w = &w } or h.deferred > 0.0 {
            h.moving_for = 0.0
            return
        }
        h.moving_for = h.moving_for + dt
        if h.moving_for >= MOVING_DROP_S {
            h.moving_for = 0.0
            w.target = obj::INVALID
        }
    }

    // Whether the leader sees entry `k` of the list, asked once per entry per frame and only for entries
    // the pick looks at (the original caches it per entry too: GetIsTargetVisible 0x00617ad0 is a pair of
    // ray casts).
    fn is_entry_seen { w: *world::World, ids: [NEAR_MAX]u32, mut seen: [NEAR_MAX]u8, k: usize } -> bool {
        if seen[k] == 0 { seen[k] = if is_in_view{ w, id = ids[k] } { 1 } else { 2 } }
        return seen[k] == 1
    }

    fn pick_target { mut h: Hud, mut w: world::World, dt: f32 } {
        let leader = party::leader{ w = &w }
        let lo = world::object{ w = &w, id = leader } ifnull { return }
        let mut fx = lo.orientation.x
        let mut fy = lo.orientation.y
        let mut fz = lo.orientation.z
        let flen = math::sqrtf{ x = fx * fx + fy * fy + fz * fz }
        if flen < 0.0001 {
            fx = 1.0
            fy = 0.0
            fz = 0.0
        } else {
            fx = fx / flen
            fy = fy / flen
            fz = fz / flen
        }
        // The point 4 m behind the leader the cone starts from.
        let px = lo.position.x - BEHIND * fx
        let py = lo.position.y - BEHIND * fy
        let pz = lo.position.z - BEHIND * fz

        // The selectable objects within 30 m (GetNearbySelectableObjects 0x004fc4c0), with the squared
        // distance and bearing the two orders are made of, whether each is in the front cone, and whether
        // the leader sees it (0 not asked yet, 1 yes, 2 no).
        let mut ids: [NEAR_MAX]u32
        let mut d2: [NEAR_MAX]f32
        let mut bearing: [NEAR_MAX]f32
        let mut seen: [NEAR_MAX]u8
        let mut hostile: [NEAR_MAX]bool
        let mut front: [NEAR_MAX]bool
        let mut n: usize = 0
        let mut hostile_near = false
        let all = list::items{ list = w.objects.all }
        let mut i: usize = 0
        while i < all.len and n < NEAR_MAX {
            let o = all[i]
            i = i + 1
            if o.destroyed { continue }
            if o.kind != obj::Kind::creature and o.kind != obj::Kind::door and o.kind != obj::Kind::placeable and o.kind != obj::Kind::trigger { continue }
            if not is_selectable_kind{ w = &w, id = o.id } { continue }
            let dx = o.position.x - lo.position.x
            let dy = o.position.y - lo.position.y
            let dz = o.position.z - lo.position.z
            ids[n] = o.id
            d2[n] = dx * dx + dy * dy + dz * dz
            bearing[n] = measure_bearing{ lo, p = o.position }
            seen[n] = 0
            hostile[n] = o.kind == obj::Kind::creature and is_hostile{ w = &w, id = o.id }
            let mut in_front = false
            if dx * fx + dy * fy + dz * fz >= 0.0 {
                let bx = o.position.x - px
                let by = o.position.y - py
                let bz = o.position.z - pz
                let bl = math::sqrtf{ x = bx * bx + by * by + bz * bz }
                in_front = bl > 0.0001 and (bx * fx + by * fy + bz * fz) / bl > FRONT_COS
            }
            front[n] = in_front
            if hostile[n] { hostile_near = true }
            n = n + 1
        }

        // The current target: kept while it is on the list and in view, dropped a second after it leaves view.
        let mut have = false
        if w.target != obj::INVALID {
            let mut k: usize = 0
            while k < n {
                if ids[k] == w.target {
                    have = true
                    if is_entry_seen{ w = &w, ids, &seen, k } {
                        h.target_lost = 0.0
                    } else {
                        h.target_lost = h.target_lost + dt
                        if h.target_lost >= LOST_S {
                            h.target_lost = 0.0
                            have = false
                        }
                    }
                }
                k = k + 1
            }
            if not have { w.target = obj::INVALID }
        } else {
            h.target_lost = 0.0
        }

        // An enemy coming into sight: the first of the visible hostile creatures round the leader by bearing.
        let combat = leader_in_combat_mode{ w = &w }
        let mut first_hostile: usize = n
        let mut k: usize = 0
        while k < n {
            if hostile[k] and (first_hostile == n or bearing[k] < bearing[first_hostile]) and is_entry_seen{ w = &w, ids, &seen, k } { first_hostile = k }
            k = k + 1
        }
        let sighted = first_hostile < n
        if sighted and not h.sight_latch and w.clock.pause_bits == 0 {
            w.target = ids[first_hostile]
            h.swing_to = w.target
            have = true
            if w.log.objects {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "enemy sighted: {}, combat mode {}\n", ids[first_hostile], combat)
            }
            if not combat { autopause::request{ &w, reason = autopause::ENEMY_SIGHTED } }
        }
        // The announcement latches until no enemy has been in sight for ten seconds.
        if not h.sight_latch or sighted {
            h.sight_latch = sighted
            h.sight_quiet = SIGHT_LATCH_S
        } else if h.sight_quiet >= 0.0 {
            h.sight_quiet = h.sight_quiet - dt
        } else {
            h.sight_latch = false
            if w.log.objects {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "enemy sight latch cleared\n")
            }
        }

        if have { return }
        // No target: the nearest visible one in front. In combat mode with a hostile creature about, the
        // nearest visible hostile in front, else the first visible hostile by bearing, else the first
        // object in front that is not hostile (that last one without a look at whether it is seen).
        let mut pick: usize = n
        if combat and hostile_near {
            k = 0
            while k < n {
                if front[k] and hostile[k] and (pick == n or d2[k] < d2[pick]) and is_entry_seen{ w = &w, ids, &seen, k } { pick = k }
                k = k + 1
            }
            if pick == n {
                k = 0
                while k < n {
                    if hostile[k] and (pick == n or bearing[k] < bearing[pick]) and is_entry_seen{ w = &w, ids, &seen, k } { pick = k }
                    k = k + 1
                }
            }
            if pick == n {
                k = 0
                while k < n {
                    if front[k] and not hostile[k] and (pick == n or d2[k] < d2[pick]) { pick = k }
                    k = k + 1
                }
            }
        } else {
            k = 0
            while k < n {
                if front[k] and (pick == n or d2[k] < d2[pick]) and is_entry_seen{ w = &w, ids, &seen, k } { pick = k }
                k = k + 1
            }
        }
        if pick < n {
            w.target = ids[pick]
            // SelectTarget swings the camera toward a pick only in combat mode.
            if combat { h.swing_to = w.target }
        }
    }
}
