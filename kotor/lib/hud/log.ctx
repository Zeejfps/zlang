// The message log as the HUD and the menus see it: the world keeps it (`w.messages`, lib/engine/
// msglog.ctx) so a save can carry it, as the original's party table does.
namespace hud {
    type MessageLog = msglog::Log

    const LOG_LINES: usize = msglog::LINES
    const LOG_LEN: usize = msglog::LEN

    // What a line is: feedback from the game, or something said in a conversation.
    const LOG_FEEDBACK: u8 = msglog::FEEDBACK
    const LOG_DIALOG: u8 = msglog::DIALOG

    // Lines kept.
    fn log_count { log: *MessageLog } -> usize { return msglog::count{ log } }

    // Line `i`, oldest first.
    fn log_text { log: *MessageLog, i: usize } -> []u8 { return msglog::text{ log, i } }

    fn log_kind { log: *MessageLog, i: usize } -> u8 { return msglog::kind{ log, i } }

    fn log_age { log: *MessageLog, i: usize } -> f32 { return msglog::age{ log, i } }

    // Adds a line (cut to LOG_LEN bytes).
    fn log_add { mut log: MessageLog, text: []u8, kind: u8 } { msglog::add{ log = &log, text, kind } }

    fn log_tick { mut log: MessageLog, dt: f32 } { msglog::tick{ log = &log, dt } }
}
