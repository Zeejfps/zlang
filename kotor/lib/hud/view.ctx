// Putting world points on the screen: the projection the HUD needs to float the target block over
// an object, to pick the object under the pointer, and to turn the reticle.
namespace hud {
    struct Projector {
        vp: math::Mat4,         // projection * view
        eye: math::Vec3,
        w: f32, h: f32,         // the GUI's pixel space
    }

    // `aspect` is the 3D view's (the window's); the GUI's pixel space may be smaller than the
    // window when the GUI is scaled.
    fn make_projector { camera: cam::Camera, ui_w: i32, ui_h: i32, aspect: f32 } -> Projector {
        let rc = cam::render_camera{ c = &camera, aspect }
        return Projector{ vp = math::mat4::mul{ a = rc.proj, b = rc.view }, eye = rc.eye, w = @as(f32, ui_w), h = @as(f32, ui_h) }
    }

    // A world point in GUI pixels, or null when it is behind the eye.
    fn project { p: Projector, at: math::Vec3 } -> ?math::Vec2 {
        let c = math::mat4::transform{ m = p.vp, v = math::Vec4{ x = at.x, y = at.y, z = at.z, w = 1.0 } }
        if c.w < 0.05 { return null }
        return math::Vec2{ x = (c.x / c.w * 0.5 + 0.5) * p.w, y = (0.5 - c.y / c.w * 0.5) * p.h }
    }

    // A world point's perspective division in GUI pixels, behind the eye too (then the point comes out
    // mirrored through the middle of the screen): what the target marker's edge arrows are placed from.
    struct RawPoint { x: f32, y: f32, front: bool }

    fn project_raw { p: Projector, at: math::Vec3 } -> RawPoint {
        let c = math::mat4::transform{ m = p.vp, v = math::Vec4{ x = at.x, y = at.y, z = at.z, w = 1.0 } }
        let front = c.w >= 0.05
        let cw = if c.w >= 0.0 and c.w < 0.0001 { 0.0001 } else if c.w < 0.0 and c.w > -0.0001 { -0.0001 } else { c.w }
        return RawPoint{ x = (c.x / cw * 0.5 + 0.5) * p.w, y = (0.5 - c.y / cw * 0.5) * p.h, front }
    }

    // The box a selectable object fills, in its own space (feet at the origin, facing +Y). The
    // models' own bounds are the compiler's default box, so the shapes are ours: a creature is as
    // tall as a person scaled by its personal space (appearance.2da PERSPACE, 0.35 for a human),
    // doors and placeables a typical size.
    struct Shape { half_x: f32, half_y: f32, height: f32 }

    fn shape_of { o: *obj::Object } -> Shape {
        match o.ext {
            creature{ c } => {
                let r = math::max{ a = c.perspace, b = 0.3 }
                return Shape{ half_x = r, half_y = r, height = math::clamp{ x = 1.8 * r / 0.35, lo = 1.0, hi = 6.0 } }
            }
            door{ d } => { return Shape{ half_x = 1.3, half_y = 0.25, height = 3.2 } }
            placeable{ p } => { return Shape{ half_x = 0.55, half_y = 0.55, height = 1.1 } }
            trigger{ t } => { return Shape{ half_x = 0.45, half_y = 0.45, height = 0.4 } }    // a mine on the floor
            else => { return Shape{ half_x = 0.4, half_y = 0.4, height = 1.0 } }
        }
    }

    // An object's box on the screen: its bounds in GUI pixels and the point above its head the
    // target block hangs from. Null when the box is behind the eye.
    struct OnScreen { x0: f32, y0: f32, x1: f32, y1: f32, top: math::Vec2 }

    fn box_on_screen { p: Projector, o: *obj::Object } -> ?OnScreen {
        return box_of_shape{ p, o, s = shape_of{ o } }
    }

    // The ray from the eye through GUI pixel (x, y) (project's inverse); null if the view has none.
    fn pointer_ray { p: Projector, x: f32, y: f32 } -> ?math::Ray {
        let inv = math::mat4::inverse{ m = p.vp } ifnull { return null }
        let nx = x / p.w * 2.0 - 1.0
        let ny = 1.0 - y / p.h * 2.0
        let deep = math::mat4::transform{ m = inv, v = math::Vec4{ x = nx, y = ny, z = 1.0, w = 1.0 } }
        if deep.w == 0.0 { return null }
        let at = math::Vec3{ x = deep.x / deep.w, y = deep.y / deep.w, z = deep.z / deep.w }
        let d = math::vec3::sub{ a = at, b = p.eye }
        if math::vec3::length{ v = d } < 0.0001 { return null }
        return math::Ray{ origin = p.eye, dir = math::vec3::normalize{ v = d } }
    }

    fn box_of_shape { p: Projector, o: *obj::Object, s: Shape } -> ?OnScreen {
        // Models face +Y; the object's facing vector turns them about Z by atan2(y, x) - pi/2.
        let yaw = math::atan2f{ y = o.orientation.y, x = o.orientation.x } - 1.5707964
        let cs = math::cosf{ x = yaw }
        let sn = math::sinf{ x = yaw }
        let mut x0: f32 = 100000.0
        let mut y0: f32 = 100000.0
        let mut x1: f32 = -100000.0
        let mut y1: f32 = -100000.0
        let mut i: usize = 0
        while i < 8 {
            let lx = if (i & 1) == 0 { -s.half_x } else { s.half_x }
            let ly = if (i & 2) == 0 { -s.half_y } else { s.half_y }
            let lz = if (i & 4) == 0 { 0.0 } else { s.height }
            let at = math::Vec3{ x = o.position.x + lx * cs - ly * sn, y = o.position.y + lx * sn + ly * cs, z = o.position.z + lz }
            let q = project{ p, at } ifnull { return null }
            x0 = math::min{ a = x0, b = q.x }
            y0 = math::min{ a = y0, b = q.y }
            x1 = math::max{ a = x1, b = q.x }
            y1 = math::max{ a = y1, b = q.y }
            i = i + 1
        }
        let top = project{ p, at = math::Vec3{ x = o.position.x, y = o.position.y, z = o.position.z + s.height } } ifnull { return null }
        return OnScreen{ x0, y0, x1, y1, top }
    }
}
