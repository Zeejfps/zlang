// The combat controls (docs/re/gui.md, "Combat mode, queue, clear buttons"): while the leader is in
// combat the bar at the bottom centre shows the queue of its attack actions and the Disengage
// button, and the message bar at the top announces combat mode for a few seconds.
namespace hud {
    const COMBAT_TAGS: [8][]u8 = [
        "LBL_COMBATBG1", "LBL_COMBATBG2", "LBL_COMBATBG3", "BTN_CLEARALL", "BTN_CLEARONE", "BTN_CLEARONE2",
        "LBL_QUEUE0", "LBL_QUEUE1",
    ]

    // Whether the leader is in combat mode: its client creature's flag (CSWCCreature +0x440 bit 0, which for the
    // controlled creature is also the client's +0x320), not the server's combat state (`in_combat`, +0x4e0). The
    // combat bar, Disengage and F, the combat camera and reticle, hostile-only Q / E and the auto-target's and
    // auto-pause's combat rules all read this one.
    fn leader_in_combat_mode { w: *world::World } -> bool {
        let c = creature_of{ w, id = party::leader{ w } } ifnull { return false }
        return c.combat_mode
    }

    // CSWCCreature::SetCombatMode (0x00610a10) for the leader: the target block's and the default action's
    // fighting orders (CSWGuiTargetInfo::UseAction 0x00689610 and the callbacks 0x00616900, 0x00617dd0,
    // 0x00616200, 0x006167d0, 0x00617e40, DefaultActionAttack 0x00616800) turn it on at once, paused or not.
    fn enter_combat_mode { mut w: world::World } {
        let c = creature_of{ w = &w, id = party::leader{ w = &w } } ifnull { return }
        if not c.combat_mode and w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "combat mode on: {} (order)\n", party::leader{ w = &w })
        }
        c.combat_mode = true
    }

    // Whether `id` is alive as the original's GetDead (slot 37) sees it: a creature that is not dead (a party
    // member never is: CSWSCreature::GetDead 0x004ef820), a door or placeable with a hit point left
    // (CSWSObject::GetDead 0x004cb810); gone is not alive.
    fn is_live { w: *world::World, id: u32 } -> bool {
        if id == obj::INVALID { return false }
        let o = world::object{ w, id } ifnull { return false }
        if o.destroyed { return false }
        if obj::creature{ o } is some{ value = c } { return party::is_member{ w, id } or not c.dead }
        return o.hp >= 1
    }

    // The live object party member `o` means to fight, the original's attempted attack target (server +0x50c)
    // or attempted spell target (+0x524), INVALID for none; `self_ok` lets its own id count (the switch-off
    // test does, the switch-on test does not). The original sets them as an order is queued (AddAttackActions
    // 0x004fde40, the cast's 0x004d39b0, when unset) and clears them when the queue runs dry (RunActions
    // 0x0057f4a0) or the orders are cancelled (CancelCreatureActions 0x004aef40). Ours keeps the attempted
    // target from the attack until its target dies (fight.ctx), so here it counts while an order waits or a
    // round runs, and a waiting attack or cast counts by its own target.
    fn fight_target_of { w: *world::World, o: *obj::Object, self_ok: bool } -> u32 {
        let c = obj::creature{ o } ifnull { return obj::INVALID }
        let mut running = o.actions.len > 0
        if fight::of{ o } is some{ value = f } { if f.round.started { running = true } }
        if running and is_live{ w, id = c.attempted_target } and (self_ok or c.attempted_target != o.id) { return c.attempted_target }
        let queue = list::items{ list = o.actions }
        let mut i: usize = 0
        while i < queue.len {
            let a = queue[i]
            i = i + 1
            let mut t = obj::INVALID
            if a.kind == actions::Kind::attack_object { t = actions::object_param{ a = &a, i = 0 } }
            else if a.kind == actions::Kind::cast_spell { t = actions::object_param{ a = &a, i = 1 } }
            if is_live{ w, id = t } and (self_ok or t != o.id) { return t }
        }
        return obj::INVALID
    }

    // The client's per-frame combat mode of the party members (0x005f3ad0, called by MainLoop after
    // UpdateSelectableObjects; docs/re/gameloop.md 6.4, movement.md 2.1). A member out of combat mode enters
    // it when it has a live attempted attack or spell target (not itself). A member in combat mode leaves it
    // when (it is not the leader, or the client's 1.5 s dead-target keep timer +0x378 has run out: ours has no
    // such timer), it is not hostile itself, and it has no live attempted attack or spell target and no live
    // foe "going to attack it" (+0x520: a live hostile creature, or any live object that is not a creature);
    // the enemy-sighted latch then lets go as soon as no enemy is in sight (+0x394 = -1).
    fn update_combat_modes { mut h: Hud, mut w: world::World } {
        // ProcessInput first (asm 0x00623c2c..0x00623c8e): the leader in combat mode, moved by the keys at 0.25 m/s
        // or more, says "Player moving. Cancelling combat actions."; once slower, that message turns back into
        // "combat mode engaged".
        if creature_of{ w = &w, id = party::leader{ w = &w } } is some{ value = lc } {
            if lc.combat_mode {
                if h.move_speed >= MOVING_MIN { lc.combat_message = PLAYER_MOVING }
                else if lc.combat_message == PLAYER_MOVING { lc.combat_message = COMBAT_ENGAGED }
            }
        }
        let ids = party_ids{ w = &w }
        let mut m: usize = 0
        while m < ids.len {
            let id = ids[m]
            m = m + 1
            let o = world::object{ w = &w, id } ifnull { continue }
            let c = obj::creature{ o } ifnull { continue }
            if not c.combat_mode {
                let t = fight_target_of{ w = &w, o, self_ok = false }
                if t != obj::INVALID {
                    c.combat_mode = true
                    if w.log.combat {
                        world::prefix{ w = &w }
                        _ = @fmt(&w.io, "combat mode on: {} (target {})\n", id, t)
                    }
                }
                continue
            }
            if id == party::leader{ w = &w } and w.target_keep > 0.0 { continue }
            if is_hostile{ w = &w, id } { continue }
            if fight_target_of{ w = &w, o, self_ok = true } != obj::INVALID { continue }
            let by = c.attacked_by
            if is_live{ w = &w, id = by } {
                let bo = world::object{ w = &w, id = by } ifnull { continue }
                if bo.kind != obj::Kind::creature or is_hostile{ w = &w, id = by } { continue }
            }
            c.combat_mode = false
            h.sight_quiet = -1.0
            if w.log.combat {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "combat mode off: {}\n", id)
            }
        }
        // Last, the leader's own message is put up again every frame while it is in combat mode, unless it is
        // "combat mode engaged" (0x0062b110 at the end of 0x005f3ad0); the bar takes it only when no timed message runs.
        if creature_of{ w = &w, id = party::leader{ w = &w } } is some{ value = lc } {
            if lc.combat_mode and lc.combat_message != COMBAT_ENGAGED { show_combat_message{ &h, &w, strref = lc.combat_message } }
        }
    }

    // The combat message bar's texts (dialog.tlk).
    const COMBAT_ENGAGED: u32 = 48208       // "COMBAT MODE engaged. Press the Disengage button to cancel."
    const PLAYER_MOVING: u32 = 42476        // "Player moving. Cancelling combat actions."
    const CLOSING_IN: u32 = 42477           // "Closing to attack range."
    const ALREADY_ENGAGED: u32 = 42478      // "COMBAT MODE already engaged."
    const PATH_BLOCKED: u32 = 47859         // "The path to your target is blocked."
    const DEBILITATED: u32 = 47915          // "Player debilitated. Cancelling combat actions."
    const TIMED_MESSAGE_S: f32 = 2.5

    // CSWGuiMainInterface::ShowCombatMessage (0x00687700): puts `strref` in the bar, unless a timed message is
    // still up. "Combat mode engaged" and "Player debilitated" stand until replaced; any other message stays
    // 2.5 s, opaque for the first half and then fading, and "Player moving", "Closing to attack range" and "The
    // path is blocked" are not shown at all during an auto-pause.
    fn show_combat_message { mut h: Hud, mut w: world::World, strref: u32 } {
        if h.cmsg_left >= 0.0 { return }
        if (strref == PLAYER_MOVING or strref == CLOSING_IN or strref == PATH_BLOCKED) and h.auto_paused { return }
        if strref != COMBAT_ENGAGED and strref != DEBILITATED {
            h.cmsg_left = TIMED_MESSAGE_S
            h.cmsg_total = TIMED_MESSAGE_S
        }
        if strref != h.cmsg { h.cmsg_label = 0 }
        h.cmsg = strref
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "combat message: {}\n", strref)
        }
    }

    // The bar's text colour for a message (ShowCombatMessage's table).
    fn combat_message_color { strref: u32 } -> render::Color {
        if strref == COMBAT_ENGAGED { return render::Color{ r = 0.74, g = 0.11, b = 0.0, a = 1.0 } }
        if strref == PLAYER_MOVING or strref == ALREADY_ENGAGED { return render::Color{ r = 0.28, g = 0.92, b = 0.11, a = 1.0 } }
        if strref == PATH_BLOCKED { return render::Color{ r = 0.95, g = 0.0, b = 0.85, a = 1.0 } }
        if strref == DEBILITATED { return render::Color{ r = 0.98, g = 0.45, b = 0.0, a = 1.0 } }
        return render::Color{ r = 0.0, g = 0.66, b = 0.98, a = 1.0 }
    }

    // The picture a fighting order shows in the queue: an attack's combat feat (feat.2da ICON) or
    // i_attack, a cast's item or Force power; "" for an action the queue does not show.
    fn order_icon { w: *world::World, a: actions::Action, feat: i32, into: []mut u8 } -> []u8 {
        if a.kind == actions::Kind::attack_object {
            if feat > 0 { return twoda::get_string{ t = w.tables.feat, row = @as(usize, feat), column = "icon" } ifnull "i_attack" }
            return "i_attack"
        }
        if a.kind == actions::Kind::cast_spell {
            let item = actions::object_param{ a = &a, i = 6 }
            if item != obj::INVALID { return item_icon_name{ w, id = item, into } }
            let spell = actions::int_param{ a = &a, i = 0 }
            if spell < 0 { return "" }
            return twoda::get_string{ t = w.tables.spells, row = @as(usize, spell), column = "iconresref" } ifnull ""
        }
        return ""
    }

    fn show_combat_controls { mut h: Hud, mut g: gui::Gui, on: bool } {
        let mut i: usize = 0
        while i < COMBAT_TAGS.len {
            gui::set_visible{ &g, panel = h.panel, tag = COMBAT_TAGS[i], visible = on }
            i = i + 1
        }
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_QUEUE2", visible = on }
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_QUEUE3", visible = on }
        if not on {
            gui::set_visible{ &g, panel = h.panel, tag = "LBL_CMBTMSGBG", visible = false }
            gui::set_visible{ &g, panel = h.panel, tag = "LBL_CMBTMODEMSG", visible = false }
        }
    }

    // Shows the controls when combat starts, hides them when it ends, and fills the queue icons.
    fn update_combat { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, dt: f32 } {
        // A refusal's five seconds in the target block's name label (the block's timers, 0x00684e70): then
        // the name, or the hovered slot's choice, comes back.
        if h.refusal > 0.0 {
            h.refusal = h.refusal - dt
            if h.refusal <= 0.0 { show_slot_description{ &h, &g, &w } }
        }
        // A timed message runs out (Update 0x00686ba0): the leader's message becomes "combat mode engaged" again
        // and the bar shows it (0x006345e0).
        let mut alpha: f32 = 1.0
        if h.cmsg_left >= 0.0 {
            h.cmsg_left = h.cmsg_left - dt
            if h.cmsg_left > 0.0 {
                let f = h.cmsg_left / h.cmsg_total
                if f < 0.5 { alpha = f + f }
            } else {
                h.cmsg_left = -1.0
                if creature_of{ w = &w, id = party::leader{ w = &w } } is some{ value = lc } { lc.combat_message = COMBAT_ENGAGED }
                show_combat_message{ &h, &w, strref = COMBAT_ENGAGED }
            }
        }
        let on = leader_in_combat_mode{ w = &w }
        if on != h.combat {
            h.combat = on
            // The bar is up for as long as combat mode is (the HUD's SetCombatMode 0x006874c0, which also ends a
            // timed message when combat mode ends).
            show_combat_controls{ &h, &g, on }
            if on {
                gui::set_visible{ &g, panel = h.panel, tag = "LBL_CMBTMSGBG", visible = true }
                gui::set_visible{ &g, panel = h.panel, tag = "LBL_CMBTMODEMSG", visible = true }
            } else {
                h.cmsg_left = -1.0
            }
        }
        if not on { return }
        if h.label_lent {
            h.cmsg_label = 0
        } else {
            if h.cmsg_label != h.cmsg {
                h.cmsg_label = h.cmsg
                gui::set_strref{ &g, panel = h.panel, tag = "LBL_CMBTMODEMSG", strref = h.cmsg } iferr {}
            }
            let mut color = combat_message_color{ strref = h.cmsg }
            color.a = alpha
            gui::set_text_color{ &g, panel = h.panel, tag = "LBL_CMBTMODEMSG", color }
        }
        // The queue (UpdateCombatQueue 0x0068a010): the round the leader is fighting, then its
        // waiting fighting orders, each with its feat's, item's or power's picture.
        let leader = world::object{ w = &w, id = party::leader{ w = &w } } ifnull { return }
        let queue = list::items{ list = leader.actions }
        let mut buf: [16]u8
        let mut names: [4][24]u8 = [[0; 24]; 4]
        let mut lens: [4]usize = [0; 4]
        let mut n: usize = 0
        if fight::of{ o = leader } is some{ value = lf } {
            if lf.round.started and not lf.round.cutscene {
                let mut ib: [40]u8
                let icon = order_icon{ w = &w, a = actions::make{ kind = actions::Kind::attack_object }, feat = lf.round.feat, into = ib[..] }
                let m = if icon.len > 24 { 24 } else { icon.len }
                slice::copy(u8){ dst = names[n][..m], src = icon[..m] }
                lens[n] = m
                n = n + 1
            }
        }
        let mut q: usize = 0
        while q < queue.len and n < 4 {
            let a = queue[q]
            q = q + 1
            let mut ib: [40]u8
            let icon = order_icon{ w = &w, a, feat = actions::int_param{ a = &a, i = 2 }, into = ib[..] }
            if icon.len == 0 { continue }
            let m = if icon.len > 24 { 24 } else { icon.len }
            slice::copy(u8){ dst = names[n][..m], src = icon[..m] }
            lens[n] = m
            n = n + 1
        }
        let mut slot: usize = 0
        while slot < n {
            let icon = names[slot][..lens[slot]]
            let tag = tag_n{ into = buf[..], prefix = "LBL_QUEUE", n = slot }
            let img = gui::resolve_img{ &g, fs = &w.fs, &dev, name = icon }
            if img.ok { gui::set_picture{ &g, panel = h.panel, tag, texture = img.tex, w = img.w, h = img.h } }
            gui::set_visible{ &g, panel = h.panel, tag, visible = true }
            slot = slot + 1
        }
        while slot < 4 {
            gui::set_visible{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "LBL_QUEUE", n = slot }, visible = false }
            slot = slot + 1
        }
    }

    // Disengage (BTN_CLEARALL, the F key): the leader leaves combat mode and its orders are cancelled with
    // their targets (ClearAllCombatActions 0x006887d0: SetCombatMode(0), CancelServerActions). The server's combat
    // state is left to run out. The F key works only in combat mode (HandleInputAction 240) and the button shows
    // only then; it also arms the combat reticle's zoom-in again.
    fn disengage { mut h: Hud, mut w: world::World } {
        let leader = party::leader{ w = &w }
        let c = creature_of{ w = &w, id = leader } ifnull { return }
        if not c.combat_mode { return }
        c.combat_mode = false
        fight::cancel_actions{ &w, id = leader }
        h.zoom = -1.0
        if w.log.combat {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "combat mode off: {} (disengage)\n", leader)
        }
    }

    // Clear Combat Action (BTN_CLEARONE, the Y key): the last of the leader's queued actions goes.
    fn clear_one { mut w: world::World } {
        let o = world::object{ w = &w, id = party::leader{ w = &w } } ifnull { return }
        if o.actions.len > 1 {
            let last = o.actions.len - 1
            actions::free_params{ &w, a = list::items{ list = o.actions }[last] }
            o.actions.len = last
        }
    }

    // BTN_CLEARALL (Disengage) leaves combat and clears the leader's actions; BTN_CLEARONE drops
    // the last queued action. True when the event was theirs.
    fn combat_event { mut h: Hud, mut g: gui::Gui, mut w: world::World, ev: gui::Event } -> bool {
        if ev.kind != gui::EventKind::activate { return false }
        if slice::eq_bytes{ a = ev.tag, b = "BTN_CLEARALL" } {
            disengage{ &h, &w }
            return true
        }
        if slice::eq_bytes{ a = ev.tag, b = "BTN_CLEARONE" } or slice::eq_bytes{ a = ev.tag, b = "BTN_CLEARONE2" } {
            clear_one{ &w }
            return true
        }
        return false
    }
}
