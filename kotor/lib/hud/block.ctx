// The target block (docs/re/gui.md, "Action menus"): the name, health bar and three action slots
// that hang over the selected object, and the reticle around it. The block's controls are in the
// HUD file at (0, 0); each frame they are moved as a whole to the object's head.
namespace hud {
    const BLOCK_W: i32 = 200
    const BLOCK_H: i32 = 96

    // dialog.tlk: the target slots' tooltips (Activate Left, Middle, Right Action).
    const SLOT_TIPS: [3]u32 = [48303, 48307, 48311]

    // The name of the hovered slot's selected entry in the description label above the self slots
    // (SetActionDescription 0x00685560); hidden when the pointer is on no target slot.
    fn show_slot_description { mut h: Hud, mut g: gui::Gui, mut w: world::World } {
        let k = h.hover_slot
        let l = if k >= 0 and k < 3 { h.lists[@as(usize, k)] } else { empty_list{} }
        let shown = l.count > 0
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_ACTIONDESC", visible = shown }
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_ACTIONDESCBG", visible = shown }
        if not shown { return }
        let e = l.entries[l.selected]
        let name = if e.item != obj::INVALID { name_of{ w = &w, id = e.item } } else { world::string_by_strref{ w = &w, strref = e.strref } }
        gui::set_text{ &g, panel = h.panel, tag = "LBL_ACTIONDESC", text = name } iferr {}
    }

    // The picture and the tooltip of slot `k` from its list's selected entry.
    fn refresh_slot { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, k: usize } {
        let mut buf: [24]u8
        let l = &h.lists[k]
        let has = l.count > 0
        let tag_btn = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = k }
        gui::set_visible{ &g, panel = h.panel, tag = tag_btn, visible = has }
        gui::set_visible{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = k }, visible = has }
        let arrows = l.count > 1
        gui::set_visible{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGETUP", n = k }, visible = arrows }
        gui::set_visible{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGETDOWN", n = k }, visible = arrows }
        if not has { return }
        let e = l.entries[l.selected]
        let img = gui::resolve_img{ &g, fs = &w.fs, &dev, name = e.icon[..e.icon_len] }
        let tag_icon = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = k }
        if img.ok { gui::set_picture{ &g, panel = h.panel, tag = tag_icon, texture = img.tex, w = img.w, h = img.h } } else { gui::clear_picture{ &g, panel = h.panel, tag = tag_icon } }
        // An entry that cannot be used now is dimmed (alpha 0.25 in the original).
        if gui::find_control{ &g, panel = h.panel, tag = tag_icon } is some{ value = c } {
            c.border.tinted = not e.usable
            c.border.color = render::Color{ r = 1.0, g = 1.0, b = 1.0, a = 0.25 }
        }
        let tip = world::string_by_strref{ w = &w, strref = SLOT_TIPS[k] }
        gui::set_tooltip{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = k }, text = tip } iferr {}
        gui::set_tooltip{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = k }, text = tip } iferr {}
        if h.hover_slot == @as(i32, k) { show_slot_description{ &h, &g, &w } }
    }

    // Builds the block for a new target: its name, its health and the slots' lists.
    fn build_block { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, id: u32 } {
        h.lists[0] = keep_choice{ old = h.lists[0], new = attack_slot{ w = &w, id } }
        // The middle slot holds the leader's Force powers against a hostile creature; the right one the
        // party's grenades (item_slots.ctx).
        h.lists[1] = middle_actions{ h = &h, w = &w, id }
        h.lists[2] = grenade_actions{ w = &w, target = id }
        let mut middle = h.lists[1]
        split_mine{ left = &h.lists[0], middle = &middle, w = &w, id }
        h.lists[1] = middle
        let name = name_of{ w = &w, id }
        gui::set_text{ &g, panel = h.panel, tag = "LBL_NAME", text = name } iferr {}
        let mut k: usize = 0
        while k < 3 {
            refresh_slot{ &h, &g, &w, &dev, k }
            k = k + 1
        }
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_NAMEBG", visible = true }
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_NAME", visible = true }
        let o = world::object{ w = &w, id } ifnull { return }
        let shows_health = o.hp_max > 0
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_HEALTHBG", visible = shows_health }
        gui::set_visible{ &g, panel = h.panel, tag = "PB_HEALTH", visible = shows_health }
    }

    // What the left slot offers for `id`: the default actions, less a mine's Recover (split_mine).
    fn left_actions { w: *world::World, id: u32 } -> ActionList {
        let mut l = attack_slot{ w, id }
        let mut middle = empty_list{}
        split_mine{ left = &l, middle = &middle, w, id }
        return l
    }

    // What the middle slot offers for `id`: the Force powers, or a mine's Recover (split_mine).
    fn middle_list { h: *Hud, w: *world::World, id: u32 } -> ActionList {
        let mut left = attack_slot{ w, id }
        let mut middle = middle_actions{ h, w, id }
        split_mine{ left = &left, middle = &middle, w, id }
        return middle
    }

    // The middle slot: the leader's Force powers against a hostile creature, with the choice made
    // on the last hostile target still chosen when it is in this list (the original keeps the
    // selected entry's id per kind of target).
    fn middle_actions { h: *Hud, w: *world::World, id: u32 } -> ActionList {
        if not is_hostile{ w, id } { return build_slot_actions{ w, id, k = 1 } }
        let mut l = power_actions{ w, target = id }
        let mut i: usize = 0
        while i < l.count {
            if l.entries[i].id == h.power_pick { l.selected = i }
            i = i + 1
        }
        return l
    }

    // Whether two lists offer the same choices in the same order, usable alike.
    fn same_actions { a: ActionList, b: ActionList } -> bool {
        if a.count != b.count { return false }
        let mut i: usize = 0
        while i < a.count {
            if a.entries[i].act != b.entries[i].act or a.entries[i].item != b.entries[i].item { return false }
            if a.entries[i].id != b.entries[i].id or a.entries[i].usable != b.entries[i].usable { return false }
            i = i + 1
        }
        return true
    }

    // Keeps the block over the target: builds it for a new target, hides it when there is none or
    // it is off screen, otherwise moves it above the head and updates the health bar.
    fn update_block { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device } {
        let t = w.target
        if t != obj::INVALID and not is_selectable_kind{ w = &w, id = t } {
            w.target = obj::INVALID
        }
        let o = world::object{ w = &w, id = w.target }
        let seen = if o == null { false } else { box_on_screen{ p = h.projector, o = o } != null }
        if not seen {
            if h.shown_target != obj::INVALID {
                hide_block{ &h, &g }
                h.shown_target = obj::INVALID
                if h.hover_slot >= 0 {
                    h.hover_slot = -1
                    show_slot_description{ &h, &g, &w }
                }
            }
            return
        }
        let target_object = world::object{ w = &w, id = w.target } ifnull { return }
        let on = box_on_screen{ p = h.projector, o = target_object } ifnull { return }
        if h.shown_target != w.target {
            build_block{ &h, &g, &w, &dev, id = w.target }
            h.shown_target = w.target
        } else {
            // What the leader can do to the target changed under it (a lock picked or locked, a key found,
            // the last grenade thrown, Force points spent or regained, a power learned).
            let first = same_actions{ a = left_actions{ w = &w, id = w.target }, b = h.lists[0] }
            let middle = same_actions{ a = middle_list{ h = &h, w = &w, id = w.target }, b = h.lists[1] }
            let last = same_actions{ a = grenade_actions{ w = &w, target = w.target }, b = h.lists[2] }
            if not first or not last {
                build_block{ &h, &g, &w, &dev, id = w.target }
            } else if not middle {
                // Only the powers changed (Force points spent or regained): the other slots keep their choice.
                h.lists[1] = middle_actions{ h = &h, w = &w, id = w.target }
                refresh_slot{ &h, &g, &w, &dev, k = 1 }
            }
        }
        let p = gui::find_panel{ &g, id = h.panel } ifnull { return }
        // The block hangs 32 pixels over the point the reticle is centred on (CSWGuiTargetInfo 0x00686090).
        let at = aim_point{ h = &h, w = &w, o = target_object, b = on }
        let mut x0 = @as(i32, at.x) - BLOCK_W / 2
        let mut y0 = @as(i32, at.y) - 32 - BLOCK_H
        if x0 > g.ui_w - BLOCK_W { x0 = g.ui_w - BLOCK_W }
        if x0 < 0 { x0 = 0 }
        if y0 < 4 { y0 = 4 }
        let mut i: usize = 0
        while i < BLOCK_TAGS.len {
            let part = h.block[i]
            if part.index >= 0 {
                let c = list::at{ list = p.controls, i = @as(usize, part.index) }
                c.x = part.x + x0
                c.y = part.y + y0
            }
            i = i + 1
        }
        let v = vitality_of{ w = &w, id = w.target }
        gui::set_max{ &g, panel = h.panel, tag = "PB_HEALTH", max = v.hp_max }
        gui::set_value{ &g, panel = h.panel, tag = "PB_HEALTH", value = v.hp }
    }

    // The reticle's side in GUI pixels (UpdateReticles 0x0068a310): the texture's own 64 within 5 m of the
    // leader, then smaller in a straight line to 16 (a creature) or 32 (a door, placeable or mine) at 30 m
    // and beyond. It does not depend on the object's size, only on how far the leader is.
    fn reticle_side { distance: f32, creature: bool } -> f32 {
        let far: f32 = if creature { 16.0 } else { 32.0 }
        if distance >= 30.0 { return far }
        if distance * distance <= 25.0 { return 64.0 }
        // The original truncates (_ftol) the shrink to whole pixels.
        return 64.0 - @as(f32, @as(i32, (distance - 5.0) * 0.04 * (64.0 - far)))
    }

    // The screen point a target's reticle and block hang from: where the scene found the model's head_g or
    // lookathook node, else the middle of the object's box.
    fn aim_point { h: *Hud, w: *world::World, o: *obj::Object, b: OnScreen } -> math::Vec2 {
        if w.aim_id == o.id {
            if project{ p = h.projector, at = w.aim } is some{ value = q } { return q }
        }
        return math::Vec2{ x = (b.x0 + b.x1) / 2.0, y = (b.y0 + b.y1) / 2.0 }
    }

    // The reticle around the target: blue for the friendly, red for the hostile, drawn under the panels,
    // centred on the aim point.
    fn draw_reticle { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, mut frame: render::Frame } {
        if h.shown_target == obj::INVALID { return }
        let o = world::object{ w = &w, id = h.shown_target } ifnull { return }
        let b = box_on_screen{ p = h.projector, o } ifnull { return }
        let name: []u8 = if is_hostile{ w = &w, id = h.shown_target } { "hostilereticle2" } else { "friendlyreticle2" }
        let img = gui::resolve_img{ &g, fs = &w.fs, &dev, name }
        if not img.ok { return }
        let at = aim_point{ h = &h, w = &w, o, b }
        let cx = at.x
        let cy = at.y
        let leader = world::object{ w = &w, id = party::leader{ w = &w } } ifnull { return }
        let dx = leader.position.x - o.position.x
        let dy = leader.position.y - o.position.y
        let dz = leader.position.z - o.position.z
        let side = reticle_side{ distance = math::sqrtf{ x = dx * dx + dy * dy + dz * dz }, creature = o.kind == obj::Kind::creature }
        if w.log.trace and w.clock.frame % 4 == 0 {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "reticle {} {} m side {} px at {} {} of {} {}\n", o.tag, math::sqrtf{ x = dx * dx + dy * dy + dz * dz }, side, cx, cy, h.projector.w, h.projector.h)
        }
        render::begin_ui{ &frame, width = h.projector.w, height = h.projector.h, target = null }
        render::draw_image{ &frame, rect = render::Rect{ x = cx - side / 2.0, y = cy - side / 2.0, w = side, h = side }, texture = img.tex, color = render::white{} }
    }

    // The highlight on the object under the pointer (FUN_006889c0 0x006889c0, called at the end of UpdateReticles):
    // the target reticle's smaller sibling, the plain "friendlyreticle" / "hostilereticle" at half strength,
    // sized by the leader's distance the same way and hung on the same point. Not while the mouse looks about
    // (the pointer is hidden), not within 32 pixels of the screen's edge, and not on the target itself unless
    // its block has a left slot to offer.
    fn draw_hover_reticle { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, mut frame: render::Frame } {
        if h.looking or w.hover == obj::INVALID { return }
        if w.hover == w.target and (h.shown_target != w.target or h.lists[0].count == 0) { return }
        let o = world::object{ w = &w, id = w.hover } ifnull { return }
        let b = box_on_screen{ p = h.projector, o } ifnull { return }
        let name: []u8 = if is_hostile{ w = &w, id = w.hover } { "hostilereticle" } else { "friendlyreticle" }
        let img = gui::resolve_img{ &g, fs = &w.fs, &dev, name }
        if not img.ok { return }
        let at = aim_point{ h = &h, w = &w, o, b }
        if at.x < 32.0 or at.x > @as(f32, h.projector.w) - 32.0 or at.y < 32.0 or at.y > @as(f32, h.projector.h) - 32.0 { return }
        let leader = world::object{ w = &w, id = party::leader{ w = &w } } ifnull { return }
        let dx = leader.position.x - o.position.x
        let dy = leader.position.y - o.position.y
        let dz = leader.position.z - o.position.z
        let side = reticle_side{ distance = math::sqrtf{ x = dx * dx + dy * dy + dz * dz }, creature = o.kind == obj::Kind::creature }
        render::begin_ui{ &frame, width = h.projector.w, height = h.projector.h, target = null }
        render::draw_image{ &frame, rect = render::Rect{ x = at.x - side / 2.0, y = at.y - side / 2.0, w = side, h = side }, texture = img.tex, color = render::Color{ r = 1.0, g = 1.0, b = 1.0, a = 0.5 } }
    }

    // Does slot `k`'s selected choice on the target (UseAction, 0x00689610; the keys 1, 2, 3 and the
    // buttons). A choice that cannot be used says why in the message bar and makes the refusal
    // sound; one that can is done in place of what the leader was doing (or behind it, in combat mode).
    // True when the slot had a choice.
    fn use_slot { mut h: Hud, mut g: gui::Gui, mut w: world::World, k: usize } -> bool {
        if k >= 3 or w.target == obj::INVALID { return false }
        let l = h.lists[k]
        if l.count == 0 { return false }
        let e = l.entries[l.selected]
        if not e.usable {
            say_reason{ &h, &g, reason = e.reason }
            gui::play_sound{ &g, n = 2 }
            return true
        }
        run_act{ &w, act = e.act, target = w.target, item = e.item, spell = e.id, queue = queues_orders{ h = &h, w = &w } }
        return true
    }

    // The R key (DefaultAction, movement.md 7.4): the first of the target's default actions (plain Attack on a
    // foe, not the first slot's combat feats), as a
    // second click on it does. True when a choice was run.
    fn run_default { mut h: Hud, mut w: world::World } -> bool {
        if w.target == obj::INVALID { return false }
        let l = default_actions{ w = &w, id = w.target }
        if l.count == 0 { return false }
        run_act{ &w, act = l.entries[0].act, target = w.target, item = l.entries[0].item, spell = l.entries[0].id, queue = false }
        return true
    }

    // Target slot `k`'s next (or previous) choice, wrapping: its arrows, and Shift with the slot's key.
    fn cycle_slot { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, k: usize, forward: bool } {
        let l = &h.lists[k]
        if l.count > 1 {
            l.selected = if forward { (l.selected + 1) % l.count } else { (l.selected + l.count - 1) % l.count }
            if k == 1 { h.power_pick = l.entries[l.selected].id }
            gui::play_sound{ &g, n = 7 }
            autopause::request{ &w, reason = autopause::ACTION_MENU }
            refresh_slot{ &h, &g, &w, &dev, k }
        }
    }

    // What the block's buttons do. True when the event was one of theirs.
    fn block_event { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, ev: gui::Event } -> bool {
        let mut buf: [24]u8
        if ev.kind == gui::EventKind::hilight or ev.kind == gui::EventKind::unhilight {
            // The pointer on a target slot names its selected entry above the self slots.
            let mut over: i32 = -1
            let mut s: usize = 0
            while s < 3 {
                if slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = s } } or slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = s } } { over = @as(i32, s) }
                s = s + 1
            }
            if over < 0 { return false }
            if ev.kind == gui::EventKind::hilight { h.hover_slot = over } else if h.hover_slot == over { h.hover_slot = -1 }
            show_slot_description{ &h, &g, &w }
            return true
        }
        if ev.kind != gui::EventKind::activate { return false }
        let mut k: usize = 0
        while k < 3 {
            // The icon label lies over the button and takes the pointer, so either one is the slot's.
            let over_button = slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = k } }
            if over_button or slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = k } } {
                _ = use_slot{ &h, &g, &w, k }
                return true
            }
            let up = slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGETUP", n = k } }
            let down = slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGETDOWN", n = k } }
            if up or down {
                cycle_slot{ &h, &g, &w, &dev, k, forward = down }
                return true
            }
            k = k + 1
        }
        return false
    }

    // A left click in the world, past the GUI (movement.md 7.4): the first click on an object
    // targets it, a second on the target does its default action. Returns true when it hit an
    // object (the game does not also move there).
    fn world_click { mut h: Hud, mut g: gui::Gui, mut w: world::World, x: i32, y: i32, down: bool } -> bool {
        let id = pick_at{ p = h.projector, w = &w, x, y }
        if down {
            h.pressed = id
            return id != obj::INVALID
        }
        let began = h.pressed
        h.pressed = obj::INVALID
        if id == obj::INVALID or id != began { return false }
        if id == w.target {
            // The default action: entry 0 of BuildDefaultActions (a mine's Recover is in the middle slot).
            let l = default_actions{ w = &w, id }
            if l.count > 0 {
                gui::play_sound{ &g, n = 6 }
                run_act{ &w, act = l.entries[0].act, target = id, item = l.entries[0].item, spell = l.entries[0].id, queue = false }
            }
        } else {
            w.target = id
        }
        return true
    }

    // Hover: the pointer's picture follows what a click would do; nothing over the GUI.
    fn update_hover { mut h: Hud, mut g: gui::Gui, mut w: world::World, blocked: bool } {
        if blocked or g.hover.panel != 0 {
            w.hover = obj::INVALID
            gui::set_cursor{ &g, id = gui::CURSOR_DEFAULT }
            return
        }
        let id = pick_at{ p = h.projector, w = &w, x = g.mouse_x, y = g.mouse_y }
        w.hover = id
        gui::set_cursor{ &g, id = if id == obj::INVALID { gui::CURSOR_DEFAULT } else { cursor_for{ w = &w, id } } }
    }
}
