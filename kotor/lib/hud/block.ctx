// The target block (docs/re/gui.md, "Action menus"): the name, health bar and three action slots
// that hang over the selected object, and the reticle around it. The block's controls are in the
// HUD file at (0, 0); each frame they are moved as a whole to the object's head.
namespace hud {
    const BLOCK_W: i32 = 200
    const BLOCK_H: i32 = 94             // the slots' bottom edge in the file (top 35 + height 59)
    const BAR_H: i32 = 33               // the health bar's (top 27 + height 6)

    // dialog.tlk: the target slots' tooltips (Activate Left, Middle, Right Action).
    const SLOT_TIPS: [3]u32 = [48303, 48307, 48311]

    // The block's name bar: the target's name, or the selected entry's name while the pointer is on one of the
    // slots (FUN_00685cb0 0x00685cb0; the self slots' description label is the other slots' own). A refused
    // choice's reason takes its place for five seconds (UseAction 0x00689610 stores it), over either.
    fn block_name { mut h: Hud, mut w: world::World, id: u32 } -> []u8 {
        if h.refusal > 0.0 and h.refusal_reason > 0 and h.refusal_reason < 7 {
            return world::string_by_strref{ w = &w, strref = REASON_TEXT[@as(usize, h.refusal_reason)] }
        }
        let k = h.hover_slot
        if k >= 0 and k < 3 and h.lists[@as(usize, k)].count > 0 {
            let l = &h.lists[@as(usize, k)]
            let e = l.entries[l.selected]
            // A grenade is named by its item; a droid's utility by its ability.
            if e.item != obj::INVALID and e.strref == 0 { return name_of{ w = &w, id = e.item } }
            return world::string_by_strref{ w = &w, strref = e.strref }
        }
        return name_of{ w = &w, id }
    }

    fn show_slot_description { mut h: Hud, mut g: gui::Gui, mut w: world::World } {
        if h.shown_target == obj::INVALID { return }
        gui::set_text{ &g, panel = h.panel, tag = "LBL_NAME", text = block_name{ &h, &w, id = h.shown_target } } iferr {}
    }

    // Whether `id` carries a poison effect (the health bar turns green).
    fn is_poisoned { w: *world::World, id: u32 } -> bool {
        let o = world::object{ w, id } ifnull { return false }
        if o.kind != obj::Kind::creature { return false }
        let f = fight::of{ o } ifnull { return false }
        return rules::has_effect_kind{ c = &f.c, kind = rules::fx::POISON }
    }

    // The pictures of the block that follow what the target is (UpdateReticles calls FUN_006859e0 for any target
    // every frame): the slots' frames are red for a hostile target and blue otherwise (lbl_miscroll_h / _f), the
    // health bar red, blue, or green when poisoned (enemy_bar / friend_bar / poison_bar).
    fn set_look { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, id: u32 } {
        let hostile = is_hostile{ w = &w, id }
        let poisoned = is_poisoned{ w = &w, id }
        let look: i32 = (if hostile { 1 } else { 0 }) + (if poisoned { 2 } else { 0 })
        if look == h.look { return }
        h.look = look
        let mut buf: [24]u8
        let frame: []u8 = if hostile { "lbl_miscroll_h" } else { "lbl_miscroll_f" }
        let mut k: usize = 0
        while k < 3 {
            gui::set_fill{ &g, fs = &w.fs, &dev, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = k }, name = frame }
            k = k + 1
        }
        let bar: []u8 = if poisoned { "poison_bar" } else if hostile { "enemy_bar" } else { "friend_bar" }
        gui::set_fill{ &g, fs = &w.fs, &dev, panel = h.panel, tag = "PB_HEALTH", name = bar }
    }

    // Whether any of the three lists has a choice. Then all three slots are drawn, an empty one as a blank frame;
    // with none, only the name and the health bar (the block's viewport ends at the slots' bottom edge or at the
    // health bar's, CSWGuiTargetInfo FUN_00686090 0x00686090).
    fn has_slots { h: *Hud } -> bool {
        return h.lists[0].count + h.lists[1].count + h.lists[2].count > 0
    }

    // The picture and the tooltip of slot `k` from its list's selected entry, as CSWGuiActionSlot::SetState
    // (0x00689280) leaves a slot: the frame shows whenever any slot has a choice, at half strength when this
    // one has none (a blank frame), and the arrows show only for more than one choice, so never on a blank one.
    fn refresh_slot { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, k: usize } {
        let mut buf: [24]u8
        let l = &h.lists[k]
        let has = l.count > 0
        let drawn = has_slots{ &h }
        gui::set_visible{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = k }, visible = drawn }
        gui::set_visible{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = k }, visible = drawn }
        let arrows = drawn and l.count > 1
        gui::set_frame_alpha{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = k }, alpha = if has { 1.0 } else { 0.5 } }
        gui::set_visible{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGETUP", n = k }, visible = arrows }
        gui::set_visible{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGETDOWN", n = k }, visible = arrows }
        let tip = world::string_by_strref{ w = &w, strref = SLOT_TIPS[k] }
        gui::set_tooltip{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = k }, text = tip } iferr {}
        gui::set_tooltip{ &g, panel = h.panel, tag = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = k }, text = tip } iferr {}
        let tag_icon = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = k }
        if not has {
            gui::clear_picture{ &g, panel = h.panel, tag = tag_icon }
            return
        }
        let e = l.entries[l.selected]
        let img = gui::resolve_img{ &g, fs = &w.fs, &dev, name = e.icon[..e.icon_len] }
        if img.ok { gui::set_picture{ &g, panel = h.panel, tag = tag_icon, texture = img.tex, w = img.w, h = img.h } } else { gui::clear_picture{ &g, panel = h.panel, tag = tag_icon } }
        // An entry that cannot be used now is dimmed (alpha 0.25 in the original).
        if gui::find_control{ &g, panel = h.panel, tag = tag_icon } is some{ value = c } {
            c.border.tinted = not e.usable
            c.border.color = render::Color{ r = 1.0, g = 1.0, b = 1.0, a = 0.25 }
        }
        if h.hover_slot == @as(i32, k) { show_slot_description{ &h, &g, &w } }
    }

    // Builds the block for a new target: its name, its health and the slots' lists.
    fn build_block { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, id: u32 } {
        h.lists[0] = keep_choice{ old = h.lists[0], new = attack_slot{ w = &w, id } }
        // The middle slot holds the leader's Force powers against a hostile creature; the right one the
        // party's grenades (item_slots.ctx).
        h.lists[1] = middle_actions{ h = &h, w = &w, id }
        h.lists[2] = grenade_actions{ w = &w, target = id }
        let mut middle = h.lists[1]
        split_mine{ left = &h.lists[0], middle = &middle, w = &w, id }
        h.lists[1] = middle
        gui::set_text{ &g, panel = h.panel, tag = "LBL_NAME", text = block_name{ &h, &w, id } } iferr {}
        let mut k: usize = 0
        while k < 3 {
            refresh_slot{ &h, &g, &w, &dev, k }
            k = k + 1
        }
        set_look{ &h, &g, &w, &dev, id }
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_NAMEBG", visible = true }
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_NAME", visible = true }
        let o = world::object{ w = &w, id } ifnull { return }
        let shows_health = o.hp_max > 0
        gui::set_visible{ &g, panel = h.panel, tag = "LBL_HEALTHBG", visible = shows_health }
        gui::set_visible{ &g, panel = h.panel, tag = "PB_HEALTH", visible = shows_health }
    }

    // What the left slot offers for `id`: the default actions, less a mine's Recover (split_mine).
    fn left_actions { w: *world::World, id: u32 } -> ActionList {
        let mut l = attack_slot{ w, id }
        let mut middle = empty_list{}
        split_mine{ left = &l, middle = &middle, w, id }
        return l
    }

    // What the middle slot offers for `id`: the Force powers, or a mine's Recover (split_mine).
    fn middle_list { h: *Hud, w: *world::World, id: u32 } -> ActionList {
        let mut left = attack_slot{ w, id }
        let mut middle = middle_actions{ h, w, id }
        split_mine{ left = &left, middle = &middle, w, id }
        return middle
    }

    // The middle slot: the leader's Force powers against a hostile creature or an inventory-less placeable
    // hostile to the leader, with the choice made on the last hostile target still chosen when it is in this
    // list (the original keeps the selected entry's id per kind of target).
    fn middle_actions { h: *Hud, w: *world::World, id: u32 } -> ActionList {
        if not is_hostile{ w, id } and not is_hostile_placeable{ w, id } { return build_slot_actions{ w, id, k = 1 } }
        let mut l = power_actions{ w, target = id }
        let mut i: usize = 0
        while i < l.count {
            if l.entries[i].id == h.power_pick { l.selected = i }
            i = i + 1
        }
        return l
    }

    // Whether two lists offer the same choices in the same order, usable alike.
    fn same_actions { a: ActionList, b: ActionList } -> bool {
        if a.count != b.count { return false }
        let mut i: usize = 0
        while i < a.count {
            if a.entries[i].act != b.entries[i].act or a.entries[i].item != b.entries[i].item { return false }
            if a.entries[i].id != b.entries[i].id or a.entries[i].usable != b.entries[i].usable { return false }
            i = i + 1
        }
        return true
    }

    // Keeps the block over the target: builds it for a new target, hides it when there is none, otherwise
    // moves it above the head (or to the screen's edge on the target's side when the target is off screen:
    // the block and its lists follow the selection, so the keys 1 to 3 work on a target out of sight,
    // FUN_00686090) and updates the health bar.
    fn update_block { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device } {
        let t = w.target
        if t != obj::INVALID and not is_selectable_kind{ w = &w, id = t } {
            w.target = obj::INVALID
        }
        let target_object = world::object{ w = &w, id = w.target } ifnull {
            if h.shown_target != obj::INVALID {
                hide_block{ &h, &g }
                h.shown_target = obj::INVALID
                h.lists = [empty_list{}; 3]
                h.hover_slot = -1
            }
            return
        }
        if h.shown_target != w.target {
            build_block{ &h, &g, &w, &dev, id = w.target }
            h.shown_target = w.target
        } else {
            // What the leader can do to the target changed under it (a lock picked or locked, a key found,
            // the last grenade thrown, Force points spent or regained, a power learned).
            let first = same_actions{ a = left_actions{ w = &w, id = w.target }, b = h.lists[0] }
            let middle = same_actions{ a = middle_list{ h = &h, w = &w, id = w.target }, b = h.lists[1] }
            let last = same_actions{ a = grenade_actions{ w = &w, target = w.target }, b = h.lists[2] }
            if not first or not last {
                build_block{ &h, &g, &w, &dev, id = w.target }
            } else if not middle {
                // Only the powers changed (Force points spent or regained): the other slots keep their choice.
                h.lists[1] = middle_actions{ h = &h, w = &w, id = w.target }
                // An empty middle list may be the last list with a choice, or the first: all three frames follow.
                let mut k: usize = 0
                while k < 3 {
                    refresh_slot{ &h, &g, &w, &dev, k }
                    k = k + 1
                }
            }
            set_look{ &h, &g, &w, &dev, id = w.target }
        }
        let p = gui::find_panel{ &g, id = h.panel } ifnull { return }
        // The block hangs 32 pixels over the point the reticle is centred on (CSWGuiTargetInfo 0x00686090); for a
        // target behind the eye, over the edge point its arrow takes.
        let a = anchor_of{ h = &h, w = &w, o = target_object }
        let at = if a.front { math::Vec2{ x = a.x, y = a.y } } else { behind_point{ p = h.projector, x = a.x, y = a.y } }
        let height = if has_slots{ &h } { BLOCK_H } else { BAR_H }
        let mut x0 = @as(i32, at.x) - BLOCK_W / 2
        // The viewport reaches down to the slots' bottom edge when a slot has a choice, else to the health bar's.
        let mut y0 = @as(i32, at.y) - 32 - height
        if x0 > g.ui_w - BLOCK_W { x0 = g.ui_w - BLOCK_W }
        if x0 < 0 { x0 = 0 }
        if y0 > g.ui_h - height { y0 = g.ui_h - height }
        if y0 < 4 { y0 = 4 }
        let mut i: usize = 0
        while i < BLOCK_TAGS.len {
            let part = h.block[i]
            if part.index >= 0 {
                let c = list::at{ list = p.controls, i = @as(usize, part.index) }
                c.x = part.x + x0
                c.y = part.y + y0
            }
            i = i + 1
        }
        let v = vitality_of{ w = &w, id = w.target }
        gui::set_max{ &g, panel = h.panel, tag = "PB_HEALTH", max = v.hp_max }
        gui::set_value{ &g, panel = h.panel, tag = "PB_HEALTH", value = v.hp }
    }

    // The reticle's side in GUI pixels (UpdateReticles 0x0068a310): the texture's own 64 within 5 m of the
    // leader, then smaller in a straight line to 16 (a creature) or 32 (a door, placeable or mine) at 30 m
    // and beyond. It does not depend on the object's size, only on how far the leader is.
    fn reticle_side { distance: f32, creature: bool } -> f32 {
        let far: f32 = if creature { 16.0 } else { 32.0 }
        if distance >= 30.0 { return far }
        if distance * distance <= 25.0 { return 64.0 }
        // The original truncates (_ftol) the shrink to whole pixels.
        return 64.0 - @as(f32, @as(i32, (distance - 5.0) * 0.04 * (64.0 - far)))
    }

    // The screen point a target's reticle and block hang from: where the scene found the model's head_g or
    // lookathook node, else the middle of the object's box.
    fn aim_point { h: *Hud, w: *world::World, o: *obj::Object, b: OnScreen } -> math::Vec2 {
        if w.aim_id == o.id {
            if project{ p = h.projector, at = w.aim } is some{ value = q } { return q }
        }
        return math::Vec2{ x = (b.x0 + b.x1) / 2.0, y = (b.y0 + b.y1) / 2.0 }
    }

    // A picture over the world as its TXI asks: the reticles say `blending additive`, so their black is clear.
    fn draw_picture { mut frame: render::Frame, rect: render::Rect, img: gui::Img, color: render::Color } {
        let mut q = render::make_quad{ rect, color }
        q.image = render::Image::texture{ t = img.tex }
        q.blend = gui::quad_blend{ img }
        render::add_quad{ &frame, quad = q }
    }

    // Where the target is on the screen: the aim point when its box is in front of the eye, else the
    // perspective division of its middle as it falls (behind the eye it comes out mirrored, which the edge
    // rules below undo).
    struct Anchor { x: f32, y: f32, front: bool }

    fn anchor_of { h: *Hud, w: *world::World, o: *obj::Object } -> Anchor {
        if box_on_screen{ p = h.projector, o } is some{ value = b } {
            let at = aim_point{ h, w, o, b }
            return Anchor{ x = at.x, y = at.y, front = true }
        }
        let s = shape_of{ o }
        let mid = if w.aim_id == o.id { w.aim } else { math::Vec3{ x = o.position.x, y = o.position.y, z = o.position.z + s.height / 2.0 } }
        let r = project_raw{ p = h.projector, at = mid }
        return Anchor{ x = r.x, y = r.y, front = r.front }
    }

    // The middle of the edge arrow of a target behind the eye (UpdateReticles 0x0068a310): on the side the
    // target is (the division mirrored it, so a point left of the middle means the right edge), and at its
    // height mirrored back into the lower half, the top and bottom 32 pixels swapped.
    fn behind_point { p: Projector, x: f32, y: f32 } -> math::Vec2 {
        let ex = if x < p.w / 2.0 { p.w - 16.0 } else { 16.0 }
        let ey = if y < 32.0 { p.h - 16.0 } else if y > p.h - 32.0 { 16.0 } else if y < p.h / 2.0 { p.h - y } else { y }
        return math::Vec2{ x = ex, y = ey }
    }

    // The target marker's pictures (UpdateReticles 0x0068a310).
    const MARKS: [5][]u8 = ["friendlyreticle2", "hostilereticle2", "combatreticle", "friendlyarrow", "hostilearrow"]
    const MARK_FRIENDLY: u8 = 0
    const MARK_HOSTILE: u8 = 1
    const MARK_COMBAT: u8 = 2
    const MARK_FRIENDLY_ARROW: u8 = 3
    const MARK_HOSTILE_ARROW: u8 = 4

    // The target marker this frame (UpdateReticles 0x0068a310). It follows the HUD target wherever it is. On
    // the screen it is the reticle centred on the aim point, sized by the leader's distance; a hostile
    // creature in combat mode gets the combat reticle, which starts 64 pixels larger and shrinks to its size
    // in half a second each time the target changes or the player disengages. Within 32 pixels of an edge,
    // or behind the eye, it is a 32-pixel arrow at that edge pointing out toward the target (the picture
    // points left: turned half round on the right edge, a quarter on the bottom and three on the top).
    fn update_reticle { mut h: Hud, mut w: world::World, dt: f32 } {
        h.reticle.shown = false
        if w.target != h.reticle_for {
            h.reticle_for = w.target
            h.zoom = -1.0
        }
        let o = world::object{ w = &w, id = w.target } ifnull { return }
        let leader = world::object{ w = &w, id = party::leader{ w = &w } } ifnull { return }
        let dx = leader.position.x - o.position.x
        let dy = leader.position.y - o.position.y
        let dz = leader.position.z - o.position.z
        let mut side = reticle_side{ distance = math::sqrtf{ x = dx * dx + dy * dy + dz * dz }, creature = o.kind == obj::Kind::creature }
        let hostile = is_hostile{ w = &w, id = w.target }
        let mut mark = if hostile { MARK_HOSTILE } else { MARK_FRIENDLY }
        if hostile and leader_in_combat_mode{ w = &w } {
            mark = MARK_COMBAT
            if h.zoom < -0.5 {
                side = side + 64.0
                h.zoom = 0.5
            } else if h.zoom > 0.0 {
                h.zoom = h.zoom - dt
                if h.zoom > 0.0 { side = side + @as(f32, @as(i32, h.zoom * 128.0)) } else { h.zoom = 0.0 }
            }
        }
        let arrow = if hostile { MARK_HOSTILE_ARROW } else { MARK_FRIENDLY_ARROW }
        let a = anchor_of{ h = &h, w = &w, o }
        let sw = h.projector.w
        let sh = h.projector.h
        let mut r = Reticle{ shown = true, x = 0.0, y = 0.0, side = 32.0, mark = arrow, turns = 0 }
        if not a.front {
            let e = behind_point{ p = h.projector, x = a.x, y = a.y }
            r.x = e.x - 16.0
            r.y = @as(f32, @as(i32, e.y - 16.0))
            if a.x < sw / 2.0 { r.turns = 2 }
        } else if a.x < 32.0 or a.x > sw - 32.0 {
            r.x = if a.x < 32.0 { 0.0 } else { sw - 32.0 }
            if a.x >= 32.0 { r.turns = 2 }
            r.y = if a.y < 32.0 { 0.0 } else if a.y > sh - 32.0 { sh - 32.0 } else { @as(f32, @as(i32, a.y - 16.0)) }
        } else if a.y < 32.0 or a.y > sh - 32.0 {
            r.x = @as(f32, @as(i32, a.x - 16.0))
            r.y = if a.y < 32.0 { 0.0 } else { sh - 32.0 }
            r.turns = if a.y < 32.0 { 3 } else { 1 }
        } else {
            r.mark = mark
            r.side = side
            r.x = @as(f32, @as(i32, a.x - side / 2.0))
            r.y = @as(f32, @as(i32, a.y - side / 2.0))
        }
        h.reticle = r
        if w.log.trace and w.clock.frame % 4 == 0 {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "reticle {} {} side {} at {} {} turns {} (point {} {} front {})\n", o.tag, MARKS[@as(usize, r.mark)], r.side, r.x, r.y, r.turns, a.x, a.y, a.front)
        }
    }

    // The target marker, drawn under the panels.
    fn draw_reticle { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, mut frame: render::Frame } {
        let r = h.reticle
        if not r.shown or w.target == obj::INVALID { return }
        let img = gui::resolve_img{ &g, fs = &w.fs, &dev, name = MARKS[@as(usize, r.mark)] }
        if not img.ok { return }
        render::begin_ui{ &frame, width = h.projector.w, height = h.projector.h, target = null }
        let mut q = render::make_quad{ rect = render::Rect{ x = r.x, y = r.y, w = r.side, h = r.side }, color = render::white{} }
        q.image = render::Image::texture{ t = img.tex }
        q.blend = gui::quad_blend{ img }
        q.angle = @as(f32, r.turns) * 1.5707964
        render::add_quad{ &frame, quad = q }
    }

    // The highlight on the object under the pointer (FUN_006889c0 0x006889c0, called at the end of UpdateReticles):
    // the target reticle's smaller sibling, the plain "friendlyreticle" / "hostilereticle" at half strength,
    // sized by the leader's distance the same way and hung on the same point. Not while the mouse looks about
    // (the pointer is hidden), not within 32 pixels of the screen's edge, and not on the target itself unless
    // its block has a left slot to offer.
    fn draw_hover_reticle { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, mut frame: render::Frame } {
        if h.looking or w.hover == obj::INVALID { return }
        if w.hover == w.target and (h.shown_target != w.target or h.lists[0].count == 0) { return }
        let o = world::object{ w = &w, id = w.hover } ifnull { return }
        let b = box_on_screen{ p = h.projector, o } ifnull { return }
        let name: []u8 = if is_hostile{ w = &w, id = w.hover } { "hostilereticle" } else { "friendlyreticle" }
        let img = gui::resolve_img{ &g, fs = &w.fs, &dev, name }
        if not img.ok { return }
        let at = aim_point{ h = &h, w = &w, o, b }
        if at.x < 32.0 or at.x > @as(f32, h.projector.w) - 32.0 or at.y < 32.0 or at.y > @as(f32, h.projector.h) - 32.0 { return }
        let leader = world::object{ w = &w, id = party::leader{ w = &w } } ifnull { return }
        let dx = leader.position.x - o.position.x
        let dy = leader.position.y - o.position.y
        let dz = leader.position.z - o.position.z
        let side = reticle_side{ distance = math::sqrtf{ x = dx * dx + dy * dy + dz * dz }, creature = o.kind == obj::Kind::creature }
        render::begin_ui{ &frame, width = h.projector.w, height = h.projector.h, target = null }
        draw_picture{ &frame, rect = render::Rect{ x = at.x - side / 2.0, y = at.y - side / 2.0, w = side, h = side }, img, color = render::Color{ r = 1.0, g = 1.0, b = 1.0, a = 0.5 } }
    }

    // Does slot `k`'s selected choice on the target (UseAction, 0x00689610; the keys 1, 2, 3 and the
    // buttons). A choice that cannot be used says why in the message bar and makes the refusal
    // sound; one that can is done in place of what the leader was doing (or behind it, in combat mode).
    // True when the slot had a choice.
    fn use_slot { mut h: Hud, mut g: gui::Gui, mut w: world::World, k: usize } -> bool {
        if k >= 3 or w.target == obj::INVALID { return false }
        let l = h.lists[k]
        if l.count == 0 { return false }
        let e = l.entries[l.selected]
        if not e.usable {
            // The reason shows in the block's name label for five seconds.
            if e.reason > 0 {
                h.refusal = 5.0
                h.refusal_reason = e.reason
                show_slot_description{ &h, &g, &w }
            }
            if w.log.combat {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "refused: {} slot {} spell {} reason {} \"{}\"\n", party::leader{ w = &w }, k, e.id, e.reason, block_name{ &h, &w, id = w.target })
            }
            gui::play_sound{ &g, n = 2 }
            return true
        }
        // Out of combat mode a choice on a hostile creature (the block's kind 3, FUN_0060fc00) puts the leader in
        // it after the order is given (UseAction, asm 0x006896e9..0x006897cf).
        let to_combat = not leader_in_combat_mode{ w = &w } and is_hostile{ w = &w, id = w.target }
        note_door_action{ &h, w = &w, act = e.act, target = w.target }
        run_act{ &w, act = e.act, target = w.target, item = e.item, spell = e.id, queue = queues_orders{ h = &h, w = &w } }
        if to_combat { enter_combat_mode{ &w } }
        return true
    }

    // The R key (DefaultAction, movement.md 7.4): the first of the target's default actions (plain Attack on a
    // foe, not the first slot's combat feats), as a
    // second click on it does. True when a choice was run.
    fn run_default { mut h: Hud, mut w: world::World } -> bool {
        if w.target == obj::INVALID { return false }
        let l = default_actions{ w = &w, id = w.target }
        if l.count == 0 { return false }
        note_door_action{ &h, w = &w, act = l.entries[0].act, target = w.target }
        run_act{ &w, act = l.entries[0].act, target = w.target, item = l.entries[0].item, spell = l.entries[0].id, queue = false }
        return true
    }

    // The player's open (of a closed door), unlock or bash of a door opens a 5 s window in which an
    // auto-pause request waits a second before it is made (0x005f4100, from CSWCDoor's DefaultActionOpen,
    // the unlock and DefaultActionBash; not while a request already waits; gameloop.md 6.4).
    fn note_door_action { mut h: Hud, w: *world::World, act: Act, target: u32 } {
        if act != Act::open and act != Act::unlock and act != Act::bash { return }
        let o = world::object{ w, id = target } ifnull { return }
        let d = obj::door{ o } ifnull { return }
        if act == Act::open and d.state != obj::DoorState::closed { return }
        if h.deferred <= 0.0 { h.door_window = 5.0 }
    }

    // Target slot `k`'s next (or previous) choice, wrapping: its arrows, and Shift with the slot's key.
    fn cycle_slot { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, k: usize, forward: bool } {
        let l = &h.lists[k]
        if l.count > 1 {
            l.selected = if forward { (l.selected + 1) % l.count } else { (l.selected + l.count - 1) % l.count }
            if k == 1 { h.power_pick = l.entries[l.selected].id }
            gui::play_sound{ &g, n = 7 }
            autopause::request{ &w, reason = autopause::ACTION_MENU }
            refresh_slot{ &h, &g, &w, &dev, k }
        }
    }

    // What the block's buttons do. True when the event was one of theirs.
    fn block_event { mut h: Hud, mut g: gui::Gui, mut w: world::World, mut dev: gpu::Device, ev: gui::Event } -> bool {
        let mut buf: [24]u8
        if ev.kind == gui::EventKind::hilight or ev.kind == gui::EventKind::unhilight {
            // The pointer on a target slot names its selected entry above the self slots.
            let mut over: i32 = -1
            let mut s: usize = 0
            while s < 3 {
                // Any of the slot's four controls counts (FUN_00685840 asks each one's hilight flag).
                let on_part = slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = s } } or slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = s } } or
                    slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGETUP", n = s } } or slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGETDOWN", n = s } }
                if on_part { over = @as(i32, s) }
                s = s + 1
            }
            if over < 0 { return false }
            if ev.kind == gui::EventKind::hilight { h.hover_slot = over } else if h.hover_slot == over { h.hover_slot = -1 }
            show_slot_description{ &h, &g, &w }
            return true
        }
        if ev.kind != gui::EventKind::activate { return false }
        let mut k: usize = 0
        while k < 3 {
            // The icon label lies over the button and takes the pointer, so either one is the slot's.
            let over_button = slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGET", n = k } }
            if over_button or slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "LBL_TARGET", n = k } } {
                _ = use_slot{ &h, &g, &w, k }
                return true
            }
            let up = slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGETUP", n = k } }
            let down = slice::eq_bytes{ a = ev.tag, b = tag_n{ into = buf[..], prefix = "BTN_TARGETDOWN", n = k } }
            if up or down {
                cycle_slot{ &h, &g, &w, &dev, k, forward = down }
                return true
            }
            k = k + 1
        }
        return false
    }

    // A left click in the world, past the GUI (movement.md 7.4, OnLeftMouseUp 0x00620530): the release
    // selects whatever is under the pointer then; a release on the object that was already the target when
    // the button went down does its default action. Returns true when it hit an object (the game does not
    // also move there).
    fn world_click { mut h: Hud, mut g: gui::Gui, mut w: world::World, x: i32, y: i32, down: bool } -> bool {
        let id = pick_at{ p = h.projector, w = &w, x, y }
        if down {
            h.pressing = true
            h.pressed = w.target
            return id != obj::INVALID
        }
        // A press the GUI took is not a world click.
        if not h.pressing { return false }
        h.pressing = false
        let target_at_press = h.pressed
        h.pressed = obj::INVALID
        if id == obj::INVALID { return false }
        if id == w.target and id == target_at_press {
            // The default action: entry 0 of BuildDefaultActions (a mine's Recover is in the middle slot).
            let l = default_actions{ w = &w, id }
            if l.count > 0 {
                gui::play_sound{ &g, n = 6 }
                note_door_action{ &h, w = &w, act = l.entries[0].act, target = id }
                run_act{ &w, act = l.entries[0].act, target = id, item = l.entries[0].item, spell = l.entries[0].id, queue = false }
            }
        } else {
            w.target = id
        }
        return true
    }

    // Hover: the pointer's picture follows what a click would do; nothing over the GUI.
    fn update_hover { mut h: Hud, mut g: gui::Gui, mut w: world::World, blocked: bool } {
        if blocked or g.hover.panel != 0 {
            w.hover = obj::INVALID
            gui::set_cursor{ &g, id = gui::CURSOR_DEFAULT }
            return
        }
        let id = pick_at{ p = h.projector, w = &w, x = g.mouse_x, y = g.mouse_y }
        w.hover = id
        gui::set_cursor{ &g, id = if id == obj::INVALID { gui::CURSOR_DEFAULT } else { cursor_for{ w = &w, id } } }
    }
}
