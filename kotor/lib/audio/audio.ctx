// The sound device: SDL's queued audio, kept topped up from a mix::Mixer, either by a thread of
// its own (`start`) or by the program once a frame (`update`).
//
//   let mut dev = try audio::open{ &sdl, rate = 44100, latency_ms = 60 }
//   let m = try mix::make{ realloc, &heap, rate = dev.rate, voices_2d = 24, voices_3d = 16 }
//   try audio::start{ &sdl, &threads, &dev, m }      // the mixer's thread keeps the queue full
//   defer audio::close{ &sdl, &dev }
//   defer audio::stop{ &threads, &dev }               // before close: the thread is joined
//   while running {
//       ... game update: mix::play, mix::set_listener, ...
//   }
//
// With the thread, the queue is `latency_ms` ahead of the speakers whatever the frames take, as
// Miles mixed on a thread of its own in the original; the mixer's lock (mix.ctx) lets the game
// change sounds meanwhile. Without it (a program that doesn't take Threads, or the thread
// couldn't start), the game calls `update` once a frame, and it mixes as much as the queue lacks
// to cover the next frame: `latency_ms` is then the least kept queued, and `update` keeps more
// when frames are slow: the longest gap between updates lately plus a margin, up to MOST_MS,
// falling back as frames speed up again. Measured on the Endar Spire's escape pod and Taris
// arrival at real pace (docs/design/audio.md, "Checked"), a fixed 60 ms ran dry 144 times in
// 90 s (2.7 s of silence) where frames took 60-100 ms. Before work known to stall the loop,
// `fill` can queue more, so music keeps playing over it. `update`, `brace` and `fill` do
// nothing while the thread runs.
namespace audio {
    struct Device {
        out: sdl::AudioOut,
        rate: u32,              // the device's: the mixer must run at it
        ahead: u32,             // frames to keep queued at the least (latency_ms); the thread keeps this
        underruns: u32,         // top-ups that found the queue empty (the sound stuttered); atomic: `underruns` reads it
        slow: f64,              // the longest gap between updates lately, in seconds (decaying)
        last: u64,              // the performance counter at the last update (0: none yet)
        want: u32,              // frames the last update kept queued
        started: bool,
        buf: [2048]i16,         // a mix::BLOCK of stereo frames on its way to SDL
        mixer: ?*mut mix::Mixer,        // what the thread mixes
        thread: ?thread::Thread,        // the mixer's thread, or null: `update` tops up once a frame
        running: u32,                   // atomic: 0 asks the thread to end
    }

    // Opens the default output, stereo 16-bit, at `rate` Hz or whatever rate the device wants
    // (dev.rate says which).
    fn open { mut sdl: sdl::Sdl, rate: u32, latency_ms: u32 } -> !Device {
        try init_subsystem{ &sdl }
        let out = sdl::open_audio{ &sdl, freq = @as(i32, rate), channels = 2, samples = 1024 } iferr err{ error } {
            sdl::SDL_QuitSubSystem{ &sdl, flags = sdl::INIT_AUDIO }
            return error
        }
        let actual = @as(u32, out.freq)
        let mut dev = Device{
            out, rate = actual, ahead = 0, underruns = 0, slow = 0.0, last = 0, want = 0, started = false, buf = [0; 2048],
            mixer = null, thread = null, running = 0,
        }
        set_latency{ &dev, latency_ms }
        return dev
    }

    fn init_subsystem { mut sdl: sdl::Sdl } -> ! {
        if sdl::SDL_InitSubSystem{ &sdl, flags = sdl::INIT_AUDIO } != 0 { return sdl::failed{ call = "SDL_InitSubSystem" } }
    }

    // Closes the device; its thread, if it had one, must have been stopped.
    fn close { mut sdl: sdl::Sdl, mut dev: Device } {
        sdl::close_audio{ &sdl, out = dev.out }
        sdl::SDL_QuitSubSystem{ &sdl, flags = sdl::INIT_AUDIO }
    }

    // ---- the mixer's thread

    const PUMP_SLEEP_NS: u64 = 4000000  // between the thread's looks at the queue: a few ms, far under the 23 ms the device takes at a time

    // Starts the thread that keeps the queue `ahead` frames full from `m`, which (with `dev`) must
    // stay where it is until `stop`. Fails if the thread can't start; `update` then still works.
    fn start { mut sdl: sdl::Sdl, mut threads: Threads, mut dev: Device, m: *mut mix::Mixer } -> ! {
        if dev.thread != null { return }
        dev.mixer = m
        dev.want = dev.ahead
        @atomic_store(&dev.running, 1, atomic::Order::release)
        let mut options = thread::default_options{}
        options.name = "mixer"
        let t = thread::create{ &threads, run = pump, data = &dev, options } iferr err{ error } {
            @atomic_store(&dev.running, 0, atomic::Order::release)
            return error
        }
        dev.thread = t
    }

    // Ends the mixer's thread and waits for it: after this nothing renders until `update`.
    fn stop { mut threads: Threads, mut dev: Device } {
        let t = dev.thread ifnull { return }
        @atomic_store(&dev.running, 0, atomic::Order::release)
        thread::join{ &threads, thread = t }
        dev.thread = null
    }

    // The thread: tops the queue up to `ahead`, sleeps a little, and again, until `stop`. It holds
    // the mixer's lock only while `mix::render` mixes a block, never across SDL's calls or a sleep,
    // and prints nothing (the game reads `underruns`).
    fn pump { mut sdl: sdl::Sdl, mut threads: Threads, data: *mut Device } {
        let m = data.mixer ifnull { return }
        while @atomic_load(&data.running, atomic::Order::acquire) == 1 {
            top_up{ &sdl, dev = data, m, frames = data.ahead } iferr {}
            thread::sleep{ &threads, nanoseconds = PUMP_SLEEP_NS }
        }
    }

    // How often the queue ran dry, from any thread.
    fn underruns { dev: *Device } -> u32 {
        return @atomic_load(&dev.underruns, atomic::Order::relaxed)
    }

    // ---- topping up once a frame (no thread)

    // How far ahead of the speakers the mixer stays.
    fn set_latency { mut dev: Device, latency_ms: u32 } {
        dev.ahead = dev.rate * latency_ms / 1000
        if dev.ahead < 256 { dev.ahead = 256 }
    }

    // Stereo frames queued and not yet played.
    fn queued { mut sdl: sdl::Sdl, dev: Device } -> u32 {
        return sdl::queued_audio{ &sdl, out = dev.out } / 4
    }

    const MOST_MS: u32 = 250            // the most `update` keeps queued however slow the frames
    const MARGIN_S: f64 = 0.05          // over the slow gap: the device takes its buffer a block (23 ms) at a time, and frames vary

    // Mixes what the queue lacks to cover the next frame: `ahead` frames, or the slow gap of late
    // and a margin. Once a frame; nothing while the thread runs.
    fn update { mut sdl: sdl::Sdl, mut dev: Device, m: *mut mix::Mixer } -> ! {
        if dev.thread != null { return }
        let now = sdl::counter{ &sdl }
        if dev.last != 0 {
            // A stall longer than the most we would queue (a module loading) can't be covered: it counts as that.
            let most_s = @as(f64, MOST_MS) / 1000.0
            let measured = @as(f64, now - dev.last) / @as(f64, sdl::counter_frequency{ &sdl })
            let gap = if measured > most_s { most_s } else { measured }
            // The slow gap falls by 5 % of each gap's time (a 250 ms worst is back under 100 ms in about 3 s at 30 fps).
            let fallen = dev.slow - 0.05 * gap
            dev.slow = if gap > fallen { gap } else { fallen }
        }
        dev.last = now
        let most = dev.rate * MOST_MS / 1000
        let mut want = @as(u32, (dev.slow + MARGIN_S) * @as(f64, dev.rate))
        if want < dev.ahead { want = dev.ahead }
        if want > most { want = most }
        dev.want = want
        try top_up{ &sdl, &dev, m, frames = want }
    }

    // Before slow frames that are known to come (a new area's first ones): queues the most `update`
    // would, and keeps that until frames are seen to be quick again. Nothing while the thread runs.
    fn brace { mut sdl: sdl::Sdl, mut dev: Device, m: *mut mix::Mixer } -> ! {
        if dev.thread != null { return }
        dev.slow = @as(f64, MOST_MS) / 1000.0 - MARGIN_S
        try top_up{ &sdl, &dev, m, frames = dev.rate * MOST_MS / 1000 }
    }

    // Mixes until `frames` are queued: more before a known stall. Nothing while the thread runs.
    fn fill { mut sdl: sdl::Sdl, mut dev: Device, m: *mut mix::Mixer, frames: u32 } -> ! {
        if dev.thread != null { return }
        try top_up{ &sdl, &dev, m, frames }
    }

    // Mixes until `frames` are queued, on whichever thread tops the queue up.
    fn top_up { mut sdl: sdl::Sdl, mut dev: Device, m: *mut mix::Mixer, frames: u32 } -> ! {
        let mut have = queued{ &sdl, dev }
        if have == 0 and dev.started { _ = @atomic_add(&dev.underruns, 1, atomic::Order::relaxed) }
        while have < frames {
            let want: usize = frames - have
            let n = if want < mix::BLOCK { want } else { mix::BLOCK }
            mix::render{ m, into = dev.buf[..2 * n] }
            try sdl::queue_audio{ &sdl, out = dev.out, frames = dev.buf[..2 * n] }
            have = have + @trunc(u32, n)
        }
        if not dev.started {
            sdl::pause_audio{ &sdl, out = dev.out, paused = false }
            dev.started = true
        }
    }

    // How far into its sound voice `h` is as heard now: what the mixer has played less what
    // is still queued and the device's own buffer. For lip sync and subtitles timed to
    // voice-over.
    fn heard { mut sdl: sdl::Sdl, dev: Device, m: *mut mix::Mixer, h: mix::Handle } -> ?f64 {
        let played = mix::played{ m, h } ifnull { return null }
        let behind = @as(f64, queued{ &sdl, dev } + @as(u32, dev.out.samples)) / @as(f64, dev.rate)
        return if played > behind { played - behind } else { 0.0 }
    }

    // Drops what is queued, for a cut that must be heard at once (leaving the game).
    fn flush { mut sdl: sdl::Sdl, dev: Device } {
        sdl::clear_audio{ &sdl, out = dev.out }
    }
}
