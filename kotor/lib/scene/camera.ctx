// The chase camera (docs/re/movement.md 2.2, 2.3): behind and above the leader at the area's
// camerastyle.2da row, turned by the rotate keys through the original's rate integrator, its
// distance easing back to the style's after collisions, looking at the leader with a fixed pitch.
// In combat mode the same struct is the combat camera (2.4): row 8, rigid, looking along its yaw.
// Free look (2.5) and the shake (2.6) are here too.
namespace cam {
    struct Style { distance: f32, pitch: f32, height: f32, fov: f32 }

    struct Camera {
        style: Style,
        yaw: f32,               // radians; 0 looks along +y, forward = (-sin yaw, cos yaw)
        rate: f32,              // degrees per second, the rotate keys' integrator
        h: f32,                 // the current horizontal distance to the look-at point
        hold: f32,              // seconds left in which the camera does not ease back out after a wall or a creature moved it in
        started: bool,
        eye: math::Vec3,
        look: math::Vec3,
        dir: math::Vec3,
        up: math::Vec3,         // +Z, except while a conversation camera rolls it (lib/dialog)
        stops: [64]bool,        // surface materials a camera ray stops at: all but triggers (30)
        freelook: bool,         // the eye is in the leader's head (free look): yaw is the leader's, pitch the mouse's
        fl_pitch: f32,          // free look's pitch in degrees, up positive
        turn_to: u32,           // an object the camera is swinging round to show (target cycling), obj::INVALID when none
        turn_rate: f32,         // that swing's easing rate per second, 2.5 to 7.5
        combat: bool,           // the combat camera (combat mode): rigid at row 8's distance, no swing, no creature clip
        fl_rate: f32,           // free look's tilt integrator (W / S), degrees per second
        fl_up: f32,             // the area's FL_LOOKUP and FL_LOOKDOWN, degrees
        fl_down: f32,
        fl_row: u32,            // the camerastyle row they came from
        shake_left: f32,        // the shake (StartCameraShake): milliseconds of it left, 0 when none
        shake_total: f32,       // its whole length, milliseconds
        shake_delay: f32,       // milliseconds before it starts
        shake_yaw: f32,         // this frame's offsets, degrees (render_camera adds them)
        shake_pitch: f32,
        seed: u32,              // the shake's coin (ours: an LCG for the original's rand)
    }

    // The time constant of the camera's return to its distance (ours; the original halves the error every frame).
    const EASE_TIME: f32 = 0.1

    // How long the camera stays where a wall or a creature put it before it eases back out (ours).
    const HOLD: f32 = 0.4

    // Where collide put the camera, and whether the walls or the creatures (not the easing) decided.
    struct Placed { eye: math::Vec3, limited: bool }

    // Keyboard camera defaults (movement.md 2.3): 200 deg/s, 500 deg/s^2 up, 2000 deg/s^2 down.
    const DPS: f32 = 200.0
    const ACCELERATION: f32 = 500.0
    const DECELERATION: f32 = 2000.0

    fn new {} -> Camera {
        let mut stops = [true; 64]
        stops[30] = false
        return Camera{
            style = Style{ distance = 6.25, pitch = 80.0, height = 3.5, fov = 55.0 }, yaw = 0.0, rate = 0.0, h = 3.2, hold = 0.0,
            started = false, freelook = false, fl_pitch = 0.0, turn_to = obj::INVALID, turn_rate = 2.5,
            combat = false, fl_rate = 0.0, fl_up = 15.0, fl_down = 20.0, fl_row = 0xFFFFFFFF,
            shake_left = 0.0, shake_total = 0.0, shake_delay = 0.0, shake_yaw = 0.0, shake_pitch = 0.0, seed = 0x2545F491, eye = math::vec3::zero{}, look = math::vec3::zero{}, dir = math::Vec3{ x = 0.0, y = 1.0, z = 0.0 }, up = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }, stops,
        }
    }

    // The area's style row (without the table: the chase camera's fallback, movement.md 2.2).
    fn set_style { mut c: Camera, t: twoda::Table, row: u32 } {
        let r = @as(usize, row)
        c.style.distance = twoda::get_float{ t, row = r, column = "distance" } ifnull 6.25
        c.style.pitch = twoda::get_float{ t, row = r, column = "pitch" } ifnull 80.0
        c.style.height = twoda::get_float{ t, row = r, column = "height" } ifnull 3.5
        let fov = twoda::get_float{ t, row = r, column = "viewangle" } ifnull 55.0
        c.style.fov = if fov <= 0.0 { 55.0 } else { fov }
    }

    // Free look's pitch limits come from the area's row even in combat mode (CSWCFreeLookCamera::LoadCameraStyle
    // 0x006383c0): -20 / +15 in DEFAULT, -30 / +30 in most others. Read again only when the row changes.
    fn set_freelook_style { mut c: Camera, t: twoda::Table, row: u32 } {
        if c.fl_row == row { return }
        c.fl_row = row
        let r = @as(usize, row)
        c.fl_up = twoda::get_float{ t, row = r, column = "fl_lookup" } ifnull 15.0
        c.fl_down = twoda::get_float{ t, row = r, column = "fl_lookdown" } ifnull 20.0
    }

    // Target cycling (Q, E) asks the camera to bring the new target into view (TurnTowardObject 0x00639c30);
    // any turn by hand cancels it. Only the chase camera swings: SelectTarget finds no chase camera while the
    // combat camera is installed, so in combat mode nothing turns.
    fn turn_toward { mut c: Camera, id: u32 } {
        if c.combat { return }
        c.turn_to = id
        c.turn_rate = 2.5
    }

    // RestoreDefaultCamera in combat mode with a target (the end of a conversation, leaving free look): the
    // combat camera is put once behind the leader looking toward the target, at once (0x006d22c0, movement.md
    // 2.4). The player turns it from there.
    fn face_toward { mut c: Camera, w: *world::World, leader: u32, target: u32 } {
        let o = world::object{ w, id = leader } ifnull { return }
        let goal = world::object{ w, id = target } ifnull { return }
        let dx = goal.position.x - o.position.x
        let dy = goal.position.y - o.position.y
        if dx * dx + dy * dy < 0.000001 { return }
        c.yaw = math::atan2f{ y = -dx, x = dy }
        c.rate = 0.0
        c.turn_to = obj::INVALID
    }

    // StartCameraShake (0x006416f0): after `delay` ms the camera shakes for `duration` ms. A shorter shake does
    // not replace a longer one still running.
    fn start_shake { mut c: Camera, delay: f32, duration: f32 } {
        if duration <= 0.0 or duration < c.shake_left { return }
        c.shake_left = duration
        c.shake_total = duration
        c.shake_delay = math::max{ a = delay, b = 0.0 }
    }

    // A visual effect's note: visualeffects.2da ShakeType 2 shakes the camera for ShakeDuration seconds after
    // ShakeDelay seconds (0x00690010, 0x006a5fc0: both times 1000 into StartCameraShake's milliseconds); only
    // VFX_IMP_SCREEN_SHAKE (6002, one second) has it. Type 1 asks the pad's rumble instead, which a PC never has.
    fn take_note { mut c: Camera, w: *world::World, note: outbox::Note } {
        let id = effect_of{ note }
        if id < 0 { return }
        let row = row_of_effect{ t = w.tables.visualeffects, effect = id } ifnull { return }
        let kind = twoda::get_int{ t = w.tables.visualeffects, row, column = "shaketype" } ifnull 0
        if kind != 2 { return }
        let delay = twoda::get_float{ t = w.tables.visualeffects, row, column = "shakedelay" } ifnull 0.0
        let length = twoda::get_float{ t = w.tables.visualeffects, row, column = "shakeduration" } ifnull 0.0
        start_shake{ &c, delay = delay * 1000.0, duration = length * 1000.0 }
    }

    // UpdateCameraShake (0x00641760): while r ms of a shake of D ms are left the yaw and the pitch each get
    // -a or nothing (a coin per axis per frame), a = sin(2 pi r / 30) (1 + cos(2 pi r / D)) 20 pi / 180, added
    // to angles in degrees, so the shake is under a degree.
    fn advance_shake { mut c: Camera, dt: f32 } {
        c.shake_yaw = 0.0
        c.shake_pitch = 0.0
        if c.shake_left <= 0.0 { return }
        let mut ms = dt * 1000.0
        if c.shake_delay > 0.0 {
            if ms < c.shake_delay {
                c.shake_delay = c.shake_delay - ms
                return
            }
            ms = ms - c.shake_delay
            c.shake_delay = 0.0
        }
        if ms >= c.shake_left {
            c.shake_left = 0.0
            return
        }
        let r = c.shake_left
        let a = math::sinf{ x = 2.0 * math::PI * r / 30.0 } * (1.0 + math::cosf{ x = 2.0 * math::PI * r / c.shake_total }) * 20.0 * math::PI / 180.0
        c.seed = @wrap_add(@wrap_mul(c.seed, 1664525), 1013904223)
        if (c.seed >> 16) & 1 != 0 { c.shake_yaw = -a }
        c.seed = @wrap_add(@wrap_mul(c.seed, 1664525), 1013904223)
        if (c.seed >> 16) & 1 != 0 { c.shake_pitch = -a }
        c.shake_left = r - ms
    }

    fn forward { yaw: f32 } -> math::Vec3 {
        return math::Vec3{ x = -math::sinf{ x = yaw }, y = math::cosf{ x = yaw }, z = 0.0 }
    }

    // One step of the rotate keys' rate integrator (CRateIntegratorDecel): with input the rate moves toward
    // DPS x u, without it falls at the deceleration (time constants 0.4 s and 0.1 s).
    fn integrate_turn { rate: f32, u: f32, step: f32 } -> f32 {
        if u != 0.0 { return rate + (ACCELERATION * u - (ACCELERATION / DPS) * rate) * step }
        let r = rate - (DECELERATION / DPS) * rate * step
        return if math::abs{ x = r } < 0.01 { 0.0 } else { r }
    }

    // What the player's hands give the camera this frame.
    struct Input {
        turn: f32,              // the rotate keys or the screen edge (-1..1, positive turns left)
        mouse_degrees: f32,     // the mouse's yaw step while it looks about (positive turns left)
        pitch_degrees: f32,     // free look: the mouse's pitch step (up positive)
        looking: bool,          // the mouse looks about (Lookabout held XOR the Mouse Look option)
        look_input: f32,        // its counts / 100, clamped to one, with the yaw's sign: the integrator's input
        tilt: f32,              // free look: W (+1) and S (-1) tilt the view
    }

    fn no_input {} -> Input {
        return Input{ turn = 0.0, mouse_degrees = 0.0, pitch_degrees = 0.0, looking = false, look_input = 0.0, tilt = 0.0 }
    }

    // One update: `target` is the leader, `look_height` its head height above its feet.
    fn update { mut c: Camera, w: *world::World, sc: *scene::Scene, target: u32, look_height: f32, input: Input, dt: f32 } {
        let o = world::object{ w, id = target } ifnull { return }
        let look = math::Vec3{ x = o.position.x, y = o.position.y, z = o.position.z + look_height }
        if not c.started {
            // SnapBehindTarget: the yaw from the target's facing.
            c.yaw = math::atan2f{ y = -o.orientation.x, x = o.orientation.y }
            c.h = c.style.distance
            c.started = true
        }
        advance_shake{ &c, dt }
        // The rate integrators' dt is clamped to 0.2 s.
        let step = math::min{ a = dt, b = 0.2 }
        // Free look (movement.md 2.5): the eye at the head looking along the leader's facing, pitched by the
        // mouse, or by W and S through a rate integrator (200 deg/s, 500 deg/s^2, no extra braking; a mouse
        // move resets it), within the area's FL_LOOKDOWN and FL_LOOKUP. The chase camera starts again from
        // close in and swings out.
        if c.freelook {
            c.yaw = math::atan2f{ y = -o.orientation.x, x = o.orientation.y }
            if input.pitch_degrees != 0.0 {
                c.fl_pitch = c.fl_pitch + input.pitch_degrees
                c.fl_rate = 0.0
            } else {
                c.fl_rate = c.fl_rate + (500.0 * input.tilt - (500.0 / 200.0) * c.fl_rate) * step
                c.fl_pitch = c.fl_pitch + c.fl_rate * step
            }
            c.fl_pitch = math::clamp{ x = c.fl_pitch, lo = -c.fl_down, hi = c.fl_up }
            let f = forward{ yaw = c.yaw }
            let up = math::radians{ degrees = c.fl_pitch }
            let cp = math::cosf{ x = up }
            c.eye = math::Vec3{ x = o.position.x + f.x * 0.15, y = o.position.y + f.y * 0.15, z = o.position.z + look_height }
            c.dir = math::Vec3{ x = f.x * cp, y = f.y * cp, z = math::sinf{ x = up } }
            c.look = math::vec3::add{ a = c.eye, b = c.dir }
            c.up = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }
            c.h = 0.2
            c.rate = 0.0
            c.turn_to = obj::INVALID
            return
        }
        c.fl_pitch = 0.0
        c.fl_rate = 0.0
        if c.combat {
            update_combat{ &c, w, sc, target, look, input, step }
            return
        }
        // Swinging round to a cycled target: with no turn by hand, the yaw eases toward the heading from the
        // leader to the object, 15 degrees to the side it is already on, at a rate that grows while the
        // camera is more than a metre from where it should be and falls back near it (movement.md 2.3).
        if c.turn_to != obj::INVALID {
            if input.turn != 0.0 or input.mouse_degrees != 0.0 {
                c.turn_to = obj::INVALID
            } else if world::object{ w, id = c.turn_to } is some{ value = goal } {
                let heading = math::atan2f{ y = -(goal.position.x - o.position.x), x = goal.position.y - o.position.y }
                let mut side = c.yaw - heading
                while side > math::PI { side = side - 2.0 * math::PI }
                while side < -math::PI { side = side + 2.0 * math::PI }
                let want = heading + (if side >= 0.0 { 0.2617994 } else { -0.2617994 })
                let mut delta = want - c.yaw
                while delta > math::PI { delta = delta - 2.0 * math::PI }
                while delta < -math::PI { delta = delta + 2.0 * math::PI }
                let chord = 2.0 * c.h * math::sinf{ x = math::abs{ x = delta } * 0.5 }
                c.turn_rate = math::clamp{ x = c.turn_rate + (if chord > 1.0 { 3.0 } else { -5.0 }) * step, lo = 2.5, hi = 7.5 }
                c.yaw = c.yaw + delta * math::min{ a = c.turn_rate * step, b = 1.0 }
                if math::abs{ x = delta } < 0.017 { c.turn_to = obj::INVALID }
            } else {
                c.turn_to = obj::INVALID
            }
        }
        // While the mouse looks about it turns the camera itself, and the integrator is fed the mouse's input
        // without turning anything; once it stops looking, the rate built up coasts out over about 0.1 s
        // (UpdateYaw 0x006391a0). The keys count only when the mouse is not looking.
        if input.looking {
            c.rate = integrate_turn{ rate = c.rate, u = input.look_input, step }
            c.yaw = c.yaw + math::radians{ degrees = input.mouse_degrees }
        } else {
            c.rate = integrate_turn{ rate = c.rate, u = input.turn, step }
            c.yaw = c.yaw + math::radians{ degrees = c.rate * step }
        }
        // The distance error shrinks as time passes (ComputeFollowPosition halves it every frame; ours takes a
        // time constant of EASE_TIME instead, so the pace does not depend on the frame rate), but not for HOLD
        // seconds after a wall or a creature moved the camera in: past a railing or a row of pillars the walls
        // clear and close again every few steps, and a camera that eased out into each gap would flicker.
        c.hold = math::max{ a = 0.0, b = c.hold - step }
        let eased = c.style.distance + math::expf{ x = -step / EASE_TIME } * (c.h - c.style.distance)
        let reach = if c.hold > 0.0 { c.h } else { eased }
        let f = forward{ yaw = c.yaw }
        let nominal = math::Vec3{ x = look.x - f.x * c.style.distance, y = look.y - f.y * c.style.distance, z = look.z + c.style.height }
        let placed = collide{ c = &c, w, sc, target, look, nominal, reach, creatures = true }
        let eye = placed.eye
        if placed.limited { c.hold = HOLD }
        c.h = math::sqrtf{ x = (eye.x - look.x) * (eye.x - look.x) + (eye.y - look.y) * (eye.y - look.y) }
        // Look toward the leader, pitched down by 90 - PITCH degrees.
        let dx = look.x - eye.x
        let dy = look.y - eye.y
        let len = math::sqrtf{ x = dx * dx + dy * dy }
        let hx = if len > 0.001 { dx / len } else { f.x }
        let hy = if len > 0.001 { dy / len } else { f.y }
        let down = math::radians{ degrees = 90.0 - c.style.pitch }
        let cd = math::cosf{ x = down }
        c.dir = math::Vec3{ x = hx * cd, y = hy * cd, z = -math::sinf{ x = down } }
        c.up = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }
        c.eye = eye
        c.look = look
    }

    // The combat camera (CSWCCombatCamera, update 0x006d1fc0, movement.md 2.4): straight behind the leader at row
    // 8's distance along its own yaw, at the leader's camera height plus HEIGHT, with no easing; only the mouse
    // and the rotate keys turn it (a mouse step also becomes the keys' integrator rate, so it coasts after). The
    // chase camera's wall pull-in applies, the creatures' circles do not, and it looks along its yaw at the
    // fixed pitch instead of at the leader. Leaving combat mode, the chase camera eases out from where it was.
    fn update_combat { mut c: Camera, w: *world::World, sc: *scene::Scene, target: u32, look: math::Vec3, input: Input, step: f32 } {
        c.turn_to = obj::INVALID
        c.hold = 0.0
        if input.mouse_degrees != 0.0 {
            c.rate = input.mouse_degrees
            c.yaw = c.yaw + math::radians{ degrees = input.mouse_degrees }
        } else {
            c.rate = integrate_turn{ rate = c.rate, u = if input.looking { 0.0 } else { input.turn }, step }
            c.yaw = c.yaw + math::radians{ degrees = c.rate * step }
        }
        let f = forward{ yaw = c.yaw }
        let nominal = math::Vec3{ x = look.x - f.x * c.style.distance, y = look.y - f.y * c.style.distance, z = look.z + c.style.height }
        let eye = collide{ c = &c, w, sc, target, look, nominal, reach = c.style.distance, creatures = false }.eye
        c.h = math::sqrtf{ x = (eye.x - look.x) * (eye.x - look.x) + (eye.y - look.y) * (eye.y - look.y) }
        let down = math::radians{ degrees = 90.0 - c.style.pitch }
        let cd = math::cosf{ x = down }
        c.dir = math::Vec3{ x = f.x * cd, y = f.y * cd, z = -math::sinf{ x = down } }
        c.up = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }
        c.eye = eye
        c.look = look
    }

    // The visualeffects.2da id a note starts, -1 for any other note.
    fn effect_of { note: outbox::Note } -> i32 {
        match note {
            visual{ effect, target, source, position } => { return effect }
            visual_hold{ effect, target } => { return effect }
            else => { return -1 }
        }
    }

    // visualeffects.2da's row for an effect id: the row labelled with the id.
    fn row_of_effect { t: twoda::Table, effect: i32 } -> ?usize {
        let mut digits: [12]u8
        let mut d: usize = 0
        let mut x = effect
        if x == 0 { digits[0] = '0'; d = 1 }
        while x > 0 and d < 12 { digits[d] = @trunc(u8, '0' + @as(u32, x % 10)); x = x / 10; d = d + 1 }
        let mut label: [12]u8
        let mut n: usize = 0
        while d > 0 { d = d - 1; label[n] = digits[d]; n = n + 1 }
        return twoda::find_row{ t, label = label[..n] }
    }

    // g_fCameraCollisionOffset (0x007a241c): how far the extra rays sit from the line of sight.
    const CLEARANCE: f32 = 0.35
    // Ours: the rays end this far beyond the camera, so it stops short of a wall instead of touching it (the
    // original's camera ends on the surface and the near plane can cut it).
    const MARGIN: f32 = 0.25
    // The camera never comes closer to the look-at point than this (ours: the original lets the whole
    // distance go, which puts the eye inside the head when a wall is right behind the leader).
    const MIN_DISTANCE: f32 = 0.3
    // The room the camera wants round it, so the near plane cuts nothing (ours).
    const ROOM: f32 = 0.15

    // CSWCChaseCamera::ResolveCollision (0x0063b050, movement.md 2.3): four rays from the look-at point L, to
    // the camera C moved 0.35 m to each side and 0.35 m up and down, go against the rooms and what is drawn.
    // The camera comes in along the line by the longest stretch a ray has left past its hit and rises by half
    // of that stretch's share of the distance; the creatures' camera circles keep it out of their bodies.
    //
    // Ours differs where the original's camera flickered or touched walls. The rays end MARGIN beyond the
    // camera, so it stops short of a wall; the pass is repeated (the camera's new place sends its rays to new
    // hits) until none is left; the rise stops short of a ceiling. The place the camera comes to is worked out
    // for the camera at its full distance (`nominal`, ahead of ComputeFollowPosition's easing), so it depends
    // on the walls and not on where the easing had got to: a camera that comes in to a wall stays there,
    // instead of easing out a step, finding its rays hit again and jumping back. `reach` is the horizontal
    // distance the easing allows now; the camera is the nearer of that and the place the walls leave, which
    // makes a wall move it in at once and out smoothly. `limited` says a wall or a creature, not the easing,
    // decided where it is.
    fn collide { c: *Camera, w: *world::World, sc: *scene::Scene, target: u32, look: math::Vec3, nominal: math::Vec3, reach: f32, creatures: bool } -> Placed {
        let d0 = math::vec3::sub{ a = nominal, b = look }
        let len0 = math::vec3::length{ v = d0 }
        if len0 < 0.01 { return Placed{ eye = nominal, limited = false } }
        let dir = math::vec3::scale{ v = d0, s = 1.0 / len0 }
        let mut moved: f32 = 0.0
        let mut pass: u32 = 0
        while pass < 6 {
            pass = pass + 1
            let keep = len0 - moved
            if keep <= MIN_DISTANCE {
                moved = len0 - MIN_DISTANCE
                break
            }
            let short = overshoot{ c, w, sc, look, eye = math::vec3::add_scaled{ a = look, b = dir, s = keep }, margin = MARGIN }
            if short < 0.005 { break }
            moved = moved + short
        }
        let mut keep = math::max{ a = len0 - moved, b = MIN_DISTANCE }
        // The easing: no farther out than `reach` (a horizontal distance) allows along this line.
        let flat = math::sqrtf{ x = d0.x * d0.x + d0.y * d0.y }
        let mut limited = keep < len0 - 0.005
        if flat > 0.01 {
            let eased = math::max{ a = reach, b = MIN_DISTANCE } * len0 / flat
            if eased < keep {
                keep = eased
                limited = false
            } else {
                limited = limited and keep < eased - 0.005
            }
        }
        let mut out = math::vec3::add_scaled{ a = look, b = dir, s = keep }
        if keep < len0 {
            // Up by half the share of the line given up, but not into a ceiling.
            let mut rise = (CLEARANCE + 0.15) * (len0 - keep) / len0
            let ceiling = nearest_hit{ c, w, sc, origin = out, dir = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }, max_t = rise + CLEARANCE }
            if ceiling != null { rise = math::max{ a = 0.0, b = ceiling - CLEARANCE } }
            // The lifted place must have room all round as well (a lever's alcove is rock on every side): half the
            // rise, and half again, until it has, else none.
            let mut tries: u32 = 0
            while rise > 0.01 and clearance{ c, w, sc, eye = math::Vec3{ x = out.x, y = out.y, z = out.z + rise }, reach = ROOM } < ROOM - 0.001 {
                tries = tries + 1
                rise = if tries < 3 { rise * 0.5 } else { 0.0 }
            }
            out.z = out.z + rise
        }
        // And out of the creatures' circles, where it ended up (the chase camera's only: the combat camera has no
        // creature clip).
        if not creatures { return Placed{ eye = out, limited } }
        let clear = clip_creatures{ w, target, look, eye = out }
        if math::vec3::distance{ a = clear, b = out } > 0.0005 { limited = true }
        return Placed{ eye = clear, limited }
    }

    // The nearest thing a ray from `origin` meets within max_t: a room's walkmesh (every material but
    // the trigger's), else what is drawn: the rooms, doors and placeables (walls rise above what the
    // walkmeshes model). The leader's own model is not among them.
    fn nearest_hit { c: *Camera, w: *world::World, sc: *scene::Scene, origin: math::Vec3, dir: math::Vec3, max_t: f32 } -> ?f32 {
        let ray = math::ray::make{ origin, dir }
        let rooms = list::items{ list = w.walk.rooms }
        let mut best = max_t
        let mut i: usize = 0
        while i < rooms.len {
            let mesh = rooms[i].mesh
            i = i + 1
            if mesh == null { continue }
            let hit = bwm::cast_ray{ w = mesh, ray, max_t = best, stops = c.stops[..] } ifnull { continue }
            if hit.t < best { best = hit.t }
        }
        let drawn = scene::ray_hit{ sc, w, origin, dir, max_t = best }
        if drawn != null and drawn < best { best = drawn }
        if best >= max_t { return null }
        return best
    }

    // ClipCameraSegmentToCreatures (0x004bf650): the camera stays out of the camera circle (appearance.2da
    // CAMERASPACE, else CREPERSPACE) of the creatures around: one that ends inside a circle is brought back
    // along the line to the look-at point to where the line enters it. Only creatures within 3 m of the line's
    // box count, and not those whose personal space holds the look-at point (the leader himself, anyone
    // standing on him), nor those whose camera circle does (nothing on the line would be outside). The
    // original's function asks for both crossings of the circle to lie on the line, which a camera inside it
    // cannot give; the intent, a camera that is never inside a body, is what this does. Repeated until no
    // creature moves it (at most a few passes).
    fn clip_creatures { w: *world::World, target: u32, look: math::Vec3, eye: math::Vec3 } -> math::Vec3 {
        let mut out = eye
        let lo_x = math::min{ a = look.x, b = eye.x } - 3.0
        let hi_x = math::max{ a = look.x, b = eye.x } + 3.0
        let lo_y = math::min{ a = look.y, b = eye.y } - 3.0
        let hi_y = math::max{ a = look.y, b = eye.y } + 3.0
        let mut pass: u32 = 0
        while pass < 6 {
            pass = pass + 1
            let mut changed = false
            let all = list::items{ list = w.objects.all }
            let mut i: usize = 0
            while i < all.len {
                let o = all[i]
                i = i + 1
                if o.destroyed or o.id == target or o.kind != obj::Kind::creature or o.area != w.area { continue }
                if o.position.x < lo_x or o.position.x > hi_x or o.position.y < lo_y or o.position.y > hi_y { continue }
                let cr = obj::creature{ o } ifnull { continue }
                let lx = look.x - o.position.x
                let ly = look.y - o.position.y
                if lx * lx + ly * ly <= cr.perspace * cr.perspace { continue }
                // The segment L -> out against the circle around the creature, in the floor plane.
                let dx = out.x - look.x
                let dy = out.y - look.y
                let a = dx * dx + dy * dy
                if a < 0.000001 { continue }
                let r = cr.camspace
                let ex = out.x - o.position.x
                let ey = out.y - o.position.y
                if ex * ex + ey * ey >= r * r or lx * lx + ly * ly <= r * r { continue }
                let b = 2.0 * (lx * dx + ly * dy)
                let disc = b * b - 4.0 * a * (lx * lx + ly * ly - r * r)
                if disc <= 0.0 { continue }
                let t_near = (-b - math::sqrtf{ x = disc }) / (2.0 * a)
                if t_near < 0.0 or t_near > 1.0 { continue }
                // Where the line enters the circle, less a millimetre along the line; z follows the line.
                let dlen = math::sqrtf{ x = a }
                let back = 0.001 / dlen
                let t = math::max{ a = t_near - back, b = 0.0 }
                out = math::Vec3{ x = look.x + dx * t, y = look.y + dy * t, z = look.z + (out.z - look.z) * t - 0.01 }
                changed = true
            }
            if not changed { break }
        }
        return out
    }

    // The longest stretch the four rays have left past what blocks them, for a camera at `eye`: the rays go from
    // the look-at point to `eye` moved CLEARANCE to each side and up and down, and `margin` further out.
    fn overshoot { c: *Camera, w: *world::World, sc: *scene::Scene, look: math::Vec3, eye: math::Vec3, margin: f32 } -> f32 {
        let d = math::vec3::sub{ a = eye, b = look }
        let len = math::vec3::length{ v = d }
        if len < 0.0001 { return 0.0 }
        let beyond = math::vec3::add_scaled{ a = eye, b = d, s = margin / len }
        let flat = math::sqrtf{ x = d.x * d.x + d.y * d.y }
        let side = if flat > 0.0001 { math::Vec3{ x = -d.y / flat * CLEARANCE, y = d.x / flat * CLEARANCE, z = 0.0 } } else { math::Vec3{ x = CLEARANCE, y = 0.0, z = 0.0 } }
        let up = math::Vec3{ x = 0.0, y = 0.0, z = CLEARANCE }
        let ends = [
            math::vec3::add{ a = beyond, b = side }, math::vec3::sub{ a = beyond, b = side },
            math::vec3::add{ a = beyond, b = up }, math::vec3::sub{ a = beyond, b = up },
        ]
        let mut p: f32 = 0.0
        let mut k: usize = 0
        while k < 4 {
            let v = math::vec3::sub{ a = ends[k], b = look }
            k = k + 1
            let rl = math::vec3::length{ v }
            if rl < 0.01 { continue }
            let hit = nearest_hit{ c, w, sc, origin = look, dir = math::vec3::scale{ v, s = 1.0 / rl }, max_t = rl } ifnull { continue }
            p = math::max{ a = p, b = rl - hit }
        }
        return p
    }

    // How close the nearest surface is to `eye`, looking all round (26 directions, up to `reach`): what the near
    // plane could cut through.
    fn clearance { c: *Camera, w: *world::World, sc: *scene::Scene, eye: math::Vec3, reach: f32 } -> f32 {
        let mut best = reach
        let mut ix: i32 = -1
        while ix <= 1 {
            let mut iy: i32 = -1
            while iy <= 1 {
                let mut iz: i32 = -1
                while iz <= 1 {
                    if ix != 0 or iy != 0 or iz != 0 {
                        let v = math::vec3::normalize{ v = math::Vec3{ x = @as(f32, ix), y = @as(f32, iy), z = @as(f32, iz) } }
                        let hit = nearest_hit{ c, w, sc, origin = eye, dir = v, max_t = best } ifnull { best }
                        if hit < best { best = hit }
                    }
                    iz = iz + 1
                }
                iy = iy + 1
            }
            ix = ix + 1
        }
        return best
    }

    // Test aid (`FRAME cam probe`): the camera's collision at the leader's place for every 10 degrees of yaw, one line
    // each and a total: how far the camera comes in, whether any of the four rays still meets a wall from where it ends
    // up (`left` > 0: the picture can still cut through one) and how close the nearest surface is to the eye (`near`;
    // under about 0.15 m the near plane can cut it).
    fn probe { mut c: Camera, mut w: world::World, sc: *scene::Scene, target: u32, look_height: f32 } {
        let o = world::object{ w = &w, id = target } ifnull { return }
        let look = math::Vec3{ x = o.position.x, y = o.position.y, z = o.position.z + look_height }
        let mut bad: u32 = 0
        let mut tight: u32 = 0
        let mut shortest: f32 = 1000.0
        let mut yaw: u32 = 0
        while yaw < 360 {
            let f = forward{ yaw = math::radians{ degrees = @as(f32, yaw) } }
            let raw = math::Vec3{ x = look.x - f.x * c.style.distance, y = look.y - f.y * c.style.distance, z = look.z + c.style.height }
            let eye = collide{ c = &c, w = &w, sc, target, look, nominal = raw, reach = c.style.distance, creatures = not c.combat }.eye
            let left = overshoot{ c = &c, w = &w, sc, look, eye, margin = 0.0 }
            let near = clearance{ c = &c, w = &w, sc, eye, reach = 1.0 }
            let dist = math::vec3::distance{ a = eye, b = look }
            if left > 0.02 { bad = bad + 1 }
            if near < 0.15 { tight = tight + 1 }
            if dist < shortest { shortest = dist }
            _ = @fmt(&w.io, "probe yaw {} eye {} {} {} dist {} left {} near {}\n", yaw, eye.x, eye.y, eye.z, dist, left, near)
            yaw = yaw + 10
        }
        _ = @fmt(&w.io, "probe total {} of 36 yaws still cut by a wall, {} with a surface within 0.15 m of the eye, shortest {}\n", bad, tight, shortest)
    }

    // The render camera for an aspect ratio, with the shake's offsets added to the view's yaw and pitch.
    fn render_camera { c: *Camera, aspect: f32 } -> render::Camera {
        let mut dir = c.dir
        if c.shake_yaw != 0.0 or c.shake_pitch != 0.0 {
            let flat = math::sqrtf{ x = dir.x * dir.x + dir.y * dir.y }
            let heading = math::atan2f{ y = dir.y, x = dir.x } + math::radians{ degrees = c.shake_yaw }
            let rise = math::atan2f{ y = dir.z, x = flat } + math::radians{ degrees = c.shake_pitch }
            let cr = math::cosf{ x = rise }
            dir = math::Vec3{ x = math::cosf{ x = heading } * cr, y = math::sinf{ x = heading } * cr, z = math::sinf{ x = rise } }
        }
        let at = math::vec3::add{ a = c.eye, b = dir }
        return render::Camera{
            view = math::mat4::look_at{ eye = c.eye, at, up = c.up },
            proj = math::mat4::perspective{ fovy = math::radians{ degrees = c.style.fov }, aspect, near = 0.1, far = 1000.0 },
            eye = c.eye,
        }
    }
}
