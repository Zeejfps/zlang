// Grass (the Grass option; docs/mechanics/graphics.md). An area whose ARE names a Grass_TexName grows
// tufts on every walkmesh face whose surface material has the grass flag (surfacemat.2da): `density` a
// square metre, each a square quad of `quad_size` metres cut from one of the texture's four quarters
// (chosen by the ARE's four probabilities) that turns about the vertical to face the eye. The tufts are
// placed once, by a hash of the face, so a place has the same grass whenever it is seen; each frame the
// ones near the eye go to the frame as one emitter.
namespace grass {
    // How far from the eye grass is drawn (it shrinks over the last FADE metres, so none pops in), and
    // the most tufts one frame takes.
    const REACH: f32 = 26.0
    const FADE: f32 = 7.0
    const MAX_DRAWN: usize = 14000
    // Tufts an area may grow (a guard: 28 bytes each).
    const MAX_TUFTS: usize = 400000

    struct Tuft { x: f32, y: f32, z: f32, size: f32, cell: u32, shade: f32, phase: f32 }

    struct Field {
        on: bool,                       // the Grass option, set by the owner each frame
        texture: ?render::Texture,      // null: the area has no grass, or its texture is missing
        tufts: []mut Tuft,
        quad_size: f32,
        wind: i32,
        scratch: []mut render::Particle,    // what one frame draws
    }

    fn none {} -> Field {
        return Field{ on = true, texture = null, tufts = slice::empty(Tuft){}, quad_size = 1.0, wind = 0, scratch = slice::empty(render::Particle){} }
    }

    // xorshift32.
    fn next { mut s: u32 } -> u32 {
        let mut x = s
        x = x ^ (x << 13)
        x = x ^ (x >> 17)
        x = x ^ (x << 5)
        s = x
        return x
    }

    fn unit { mut s: u32 } -> f32 { return @as(f32, next{ s = &s } >> 8) / 16777216.0 }

    // The area of a face in square metres and how many tufts it grows (the fraction is a chance).
    fn tufts_on { a: math::Vec3, b: math::Vec3, c: math::Vec3, density: f32, seed: u32 } -> usize {
        let mut chance = seed
        let e1 = math::Vec3{ x = b.x - a.x, y = b.y - a.y, z = b.z - a.z }
        let e2 = math::Vec3{ x = c.x - a.x, y = c.y - a.y, z = c.z - a.z }
        let cx = e1.y * e2.z - e1.z * e2.y
        let cy = e1.z * e2.x - e1.x * e2.z
        let cz = e1.x * e2.y - e1.y * e2.x
        let area = 0.5 * math::sqrtf{ x = cx * cx + cy * cy + cz * cz }
        let want = area * density
        let whole = math::floorf{ x = want }
        let extra: usize = if unit{ s = &chance } < want - whole { 1 } else { 0 }
        return @as(usize, whole) + extra
    }

    // Plants the area's grass: the faces of `walk` whose material has the grass flag, the texture from
    // `cache`. A field with no texture draws nothing.
    fn plant {
        mut arena: arena::Arena, walk: *walkmap::Map, grass: obj::Grass, mut cache: material::Cache, mut fs: Fs, mut dev: gpu::Device, rm: res::Manager,
    } -> !Field {
        let mut name = grass.texture
        let tex_name = resref::bytes{ r = &name }
        if tex_name.len == 0 or grass.density <= 0.0 { return none{} }
        let entry = material::get{ &cache, &fs, &dev, rm, name = tex_name }
        if entry.texture == null { return none{} }
        let mut field = none{}
        field.texture = entry.texture
        field.quad_size = if grass.quad_size > 0.05 { grass.quad_size } else { 1.0 }
        field.wind = grass.wind
        // Pass 1 counts, pass 2 plants.
        let rooms = list::items{ list = walk.rooms }
        let mut total: usize = 0
        let mut pass: u32 = 0
        while pass < 2 {
            let mut at: usize = 0
            let mut r: usize = 0
            while r < rooms.len {
                let mesh = rooms[r].mesh
                r = r + 1
                if mesh == null { continue }
                let m = mesh
                let mut f: usize = 0
                while f < m.faces.len {
                    let mat = m.materials[f]
                    let face = m.faces[f]
                    f = f + 1
                    if @as(usize, mat) >= walk.grass.len or not walk.grass[@as(usize, mat)] { continue }
                    let a = m.vertices[@as(usize, face[0])]
                    let b = m.vertices[@as(usize, face[1])]
                    let c = m.vertices[@as(usize, face[2])]
                    let seed: u32 = @wrap_add(@wrap_mul(@as(u32, r) * 7919 + @as(u32, f), 2654435761), 12345)
                    let n = tufts_on{ a, b, c, density = grass.density, seed }
                    if pass == 0 {
                        total = total + n
                        continue
                    }
                    let mut s = seed ^ 0x9E3779B9
                    let mut k: usize = 0
                    while k < n and at < field.tufts.len {
                        // A random point of the face, by folding the unit square onto the triangle.
                        let mut u = unit{ s = &s }
                        let mut v = unit{ s = &s }
                        if u + v > 1.0 {
                            u = 1.0 - u
                            v = 1.0 - v
                        }
                        let pick = unit{ s = &s }
                        let p0 = grass.prob[0]
                        let p1 = grass.prob[1]
                        let p2 = grass.prob[2]
                        let sum = p0 + p1 + p2 + grass.prob[3]
                        let t = pick * (if sum > 0.0 { sum } else { 1.0 })
                        let cell: u32 = if t < p0 { 0 } else if t < p0 + p1 { 1 } else if t < p0 + p1 + p2 { 2 } else { 3 }
                        let grow = unit{ s = &s }
                        let tone = unit{ s = &s }
                        let turn = unit{ s = &s }
                        field.tufts[at] = Tuft{
                            x = a.x + (b.x - a.x) * u + (c.x - a.x) * v,
                            y = a.y + (b.y - a.y) * u + (c.y - a.y) * v,
                            z = a.z + (b.z - a.z) * u + (c.z - a.z) * v,
                            size = field.quad_size * (0.8 + 0.4 * grow),
                            cell, shade = 0.8 + 0.3 * tone, phase = 6.2832 * turn,
                        }
                        at = at + 1
                        k = k + 1
                    }
                }
            }
            if pass == 0 {
                let want = if total < MAX_TUFTS { total } else { MAX_TUFTS }
                field.tufts = try alloc::resize(Tuft, arena::Arena){ realloc = arena::alloc, heap = &arena, mem = slice::empty(Tuft){}, count = want }
                field.scratch = try alloc::resize(render::Particle, arena::Arena){ realloc = arena::alloc, heap = &arena, mem = slice::empty(render::Particle){}, count = MAX_DRAWN }
            } else {
                field.tufts = field.tufts[..at]
            }
            pass = pass + 1
        }
        return field
    }

    // Adds the tufts near the eye to the frame as one emitter. `ambient` is the area's light, which
    // grass takes (it is not lit by the room's lights); `fog` follows the view's.
    fn draw { f: *Field, mut frame: render::Frame, view: u32, eye: math::Vec3, forward: math::Vec3, ambient: math::Vec3, time: f32 } {
        if not f.on or f.texture == null or f.tufts.len == 0 { return }
        let reach2 = REACH * REACH
        let mut n: usize = 0
        let mut i: usize = 0
        let sway = 0.035 * @as(f32, f.wind)
        let fl = math::sqrtf{ x = forward.x * forward.x + forward.y * forward.y }
        while i < f.tufts.len and n < MAX_DRAWN {
            let t = f.tufts[i]
            i = i + 1
            let dx = t.x - eye.x
            let dy = t.y - eye.y
            let d2 = dx * dx + dy * dy
            if d2 > reach2 { continue }
            let d = math::sqrtf{ x = d2 }
            // Behind the eye (a wide cone, so the edges of the picture are kept): not drawn. Looking straight down
            // there is no behind.
            if fl > 0.3 and d > 3.0 and (dx * forward.x + dy * forward.y) / (d * fl) < -0.25 { continue }
            let fade = math::clamp{ x = (REACH - d) / FADE, lo = 0.0, hi = 1.0 }
            let size = t.size * fade
            if size < 0.02 { continue }
            let light = math::Vec3{ x = math::min{ a = ambient.x * 1.5 + 0.1, b = 1.1 }, y = math::min{ a = ambient.y * 1.5 + 0.1, b = 1.1 }, z = math::min{ a = ambient.z * 1.5 + 0.1, b = 1.1 } }
            f.scratch[n] = render::Particle{
                position = math::Vec3{ x = t.x, y = t.y, z = t.z + size * 0.5 - 0.02 },
                size = math::Vec2{ x = size, y = size },
                angle = sway * math::sinf{ x = time * 1.7 + t.phase },
                color = render::Color{ r = light.x * t.shade, g = light.y * t.shade, b = light.z * t.shade, a = 1.0 },
                frame = t.cell, dir = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 },
            }
            n = n + 1
        }
        if n == 0 { return }
        let em = render::Emitter{
            view, texture = f.texture, blend = render::Blend::punch, grid_x = 2, grid_y = 2, facing = render::Facing::axis,
            axis = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }, transform = math::mat4::identity{}, first = 0, count = 0, effect = false, fog = true, sort = 0,
        }
        render::add_emitter{ &frame, emitter = em, particles = f.scratch[..n] }
    }
}
