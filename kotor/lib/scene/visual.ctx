// An object's visual: the models that show it and how they animate (docs/formats/models-usage.md).
// A creature is its body (B type: model<L> with tex<L>NN; F: modela or race; S and L: race,
// retextured with racetex), a head at the body's headhook (B type), and its weapons at rhand and
// lhand; a door is its genericdoors model, a placeable its placeables model. The object's
// internal animation id (animname) picks the body's animation; a door's state picks
// opening1/opened1/closing1/closed.
namespace visual {
    error no_model{ name: []u8 }

    // appearance.2da's per-letter columns, a to j.
    const MODEL_COLUMNS: [10][]u8 = ["modela", "modelb", "modelc", "modeld", "modele", "modelf", "modelg", "modelh", "modeli", "modelj"]
    const TEX_COLUMNS: [10][]u8 = ["texa", "texb", "texc", "texd", "texe", "texf", "texg", "texh", "texi", "texj"]

    // The object's visual, made now; its index in Scene.visuals, or null when it shows nothing.
    fn create { mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, o: *obj::Object } -> !?usize {
        let first = sc.parts.len
        let mut prefix = false
        match o.ext {
            creature{ c } => {
                let made = try creature_parts{ &sc, &w, &dev, o, c } ifnull { return null }
                prefix = made
            }
            door{ d } => {
                let mut m = d.model
                if resref::is_empty{ r = m } { return null }
                let loaded = try scene::load_model{ &sc, &w, &dev, name = resref::bytes{ r = &m }, body_texture = "", envmap = "", hide_null = false } ifnull { return null }
                _ = try scene::add_part{ &sc, loaded, parent = -1, hook = "" }
            }
            placeable{ p } => {
                let mut m = p.model
                if resref::is_empty{ r = m } { return null }
                let loaded = try scene::load_model{ &sc, &w, &dev, name = resref::bytes{ r = &m }, body_texture = "", envmap = "", hide_null = false } ifnull { return null }
                _ = try scene::add_part{ &sc, loaded, parent = -1, hook = "" }
            }
            trigger{ t } => {
                // A trap is its mine (traps.2da `model`), unseen until the party knows of it (animate_mine).
                let name = traps::model_of{ w = &w, o } ifnull { return null }
                let loaded = try scene::load_model{ &sc, &w, &dev, name, body_texture = "", envmap = "", hide_null = false } ifnull { return null }
                _ = try scene::add_part{ &sc, loaded, parent = -1, hook = "" }
            }
            else => { return null }
        }
        if sc.parts.len == first { return null }
        try list::push{ list = &sc.visuals, item = scene::Visual{
            id = o.id, first, count = sc.parts.len - first, animation = 0xFFFFFFFF, cycles = 0.0, state = 0xFFFFFFFF,
            room = -1, creature_prefix = prefix, alive = true, stunt = false, signature = signature_of{ o }, saber = 0, saber_force = 0,
        } }
        let index = sc.visuals.len - 1
        try map::put{ m = &sc.by_id, key = o.id, value = index }
        return index
    }

    // What a visual's models depend on: a creature's appearance and its armour and weapons.
    fn signature_of { o: *obj::Object } -> u64 {
        let c = obj::creature{ o } ifnull { return 0 }
        let mut h: u64 = @as(u64, c.appearance) + @as(u64, c.head + 1) * 4096
        h = @wrap_add(@wrap_mul(h, 1000003), @as(u64, c.equipped[obj::SLOT_BODY]))
        h = @wrap_add(@wrap_mul(h, 1000003), @as(u64, c.equipped[obj::SLOT_RIGHT_WEAPON]))
        h = @wrap_add(@wrap_mul(h, 1000003), @as(u64, c.equipped[obj::SLOT_LEFT_WEAPON]))
        return h
    }

    // A cell of appearance.2da ("" for a blank or "****").
    fn cell { t: twoda::Table, row: usize, column: []u8 } -> []u8 {
        return twoda::get_string{ t, row, column } ifnull ""
    }

    // The body, head and weapons; whether the model type names animations with `c` (S and L);
    // null when the appearance has no model.
    fn creature_parts { mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, o: *obj::Object, c: *mut obj::Creature } -> !?bool {
        let t = w.tables.appearance
        let row = @as(usize, c.appearance)
        let kind = cell{ t, row, column = "modeltype" }
        let mut envmap = cell{ t, row, column = "envmap" }
        if ci::eq{ a = envmap, b = "default" } { envmap = "" }
        let mut body_name: []u8 = ""
        let mut texture: [24]u8
        let mut texture_len: usize = 0
        let is_b = ci::eq{ a = kind, b = "b" }
        if is_b {
            // The armour's body letter (models-usage.md, B-type bodies): a without armour.
            let mut letter: u8 = 'a'
            let mut texvar = @as(u32, c.texture_variation)
            let armor = world::object{ w = &w, id = c.equipped[obj::SLOT_BODY] }
            if armor != null {
                if obj::item{ o = armor } is some{ value = it } {
                    let bodyvar = cell{ t = w.tables.baseitems, row = @as(usize, it.base), column = "bodyvar" }
                    if bodyvar.len == 1 { letter = ascii::to_lower{ c = bodyvar[0] } }
                    else if it.body_variation >= 1 and it.body_variation <= 10 { letter = @trunc(u8, 'a' + it.body_variation - 1) }
                    texvar = it.texture_variation
                }
            }
            let li = if letter >= 'a' and letter <= 'j' { @as(usize, letter - 'a') } else { 0 }
            body_name = cell{ t, row, column = MODEL_COLUMNS[li] }
            let base = cell{ t, row, column = TEX_COLUMNS[li] }
            if base.len > 0 and base.len < 20 {
                let mut i: usize = 0
                while i < base.len {
                    texture[i] = base[i]
                    i = i + 1
                }
                let v = if texvar == 0 { 1 } else { texvar }
                texture[i] = @trunc(u8, '0' + (v / 10) % 10)
                texture[i + 1] = @trunc(u8, '0' + v % 10)
                texture_len = i + 2
            }
        } else if ci::eq{ a = kind, b = "f" } {
            body_name = cell{ t, row, column = "modela" }
            if body_name.len == 0 { body_name = cell{ t, row, column = "race" } }
        } else {
            body_name = cell{ t, row, column = "race" }
            let racetex = cell{ t, row, column = "racetex" }
            if racetex.len > 0 and racetex.len < 24 {
                let mut i: usize = 0
                while i < racetex.len {
                    texture[i] = racetex[i]
                    i = i + 1
                }
                texture_len = racetex.len
            }
        }
        if body_name.len == 0 { return null }
        let body_loaded = try scene::load_model{ &sc, &w, &dev, name = body_name, body_texture = texture[..texture_len], envmap, hide_null = false } ifnull {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "creature {} ({}): no model {}\n", o.id, o.tag, body_name)
            return null
        }
        let body = try scene::add_part{ &sc, loaded = body_loaded, parent = -1, hook = "" }
        if is_b {
            // DuplicateHeadAppearance's head, else the appearance's own.
            let head_row = if c.head >= 0 { c.head } else { twoda::get_int{ t, row, column = "normalhead" } ifnull -1 }
            if head_row >= 0 {
                let head = cell{ t = w.tables.heads, row = @as(usize, head_row), column = "head" }
                if head.len > 0 {
                    let hl = try scene::load_model{ &sc, &w, &dev, name = head, body_texture = "", envmap, hide_null = false }
                    if hl != null { _ = try scene::add_part{ &sc, loaded = hl, parent = @as(i32, body), hook = mdl_anim::HOOK_HEAD } }
                }
            }
        }
        try weapon{ &sc, &w, &dev, item = c.equipped[obj::SLOT_RIGHT_WEAPON], body, hook = mdl_anim::HOOK_RIGHT_HAND }
        try weapon{ &sc, &w, &dev, item = c.equipped[obj::SLOT_LEFT_WEAPON], body, hook = mdl_anim::HOOK_LEFT_HAND }
        return not is_b and not ci::eq{ a = kind, b = "f" }
    }

    // An equipped item's model at a hook: `<itemclass>_<variation:03>` (models-usage.md).
    fn weapon { mut sc: scene::Scene, mut w: world::World, mut dev: gpu::Device, item: u32, body: usize, hook: []u8 } -> ! {
        let io = world::object{ w = &w, id = item } ifnull { return }
        let it = obj::item{ o = io } ifnull { return }
        let class = cell{ t = w.tables.baseitems, row = @as(usize, it.base), column = "itemclass" }
        if class.len == 0 or class.len > 12 { return }
        let mut name: [20]u8
        let mut i: usize = 0
        while i < class.len {
            name[i] = class[i]
            i = i + 1
        }
        let v = if it.model_variation == 0 { 1 } else { it.model_variation }
        name[i] = '_'
        name[i + 1] = @trunc(u8, '0' + (v / 100) % 10)
        name[i + 2] = @trunc(u8, '0' + (v / 10) % 10)
        name[i + 3] = @trunc(u8, '0' + v % 10)
        let loaded = try scene::load_model{ &sc, &w, &dev, name = name[..i + 4], body_texture = "", envmap = "", hide_null = false } ifnull { return }
        _ = try scene::add_part{ &sc, loaded, parent = @as(i32, body), hook }
    }

    // Brings a visual up to date with its object: the room under it, the animation its state
    // asks for, every part advanced.
    fn update { mut sc: scene::Scene, mut w: world::World, v: *mut scene::Visual, o: *obj::Object, dt: f32 } {
        if v.room < 0 or o.dirty & obj::DIRTY_POSITION != 0 {
            v.room = walkmap::room_at{ m = &w.walk, x = o.position.x, y = o.position.y, z = o.position.z + 0.5 }
        }
        match o.ext {
            creature{ c } => {
                animate_creature{ &sc, &w, v, o }
                if w.log.trace and w.clock.frame % 4 == 0 { trace_gait{ &sc, &w, v, o, c } }
                if v.count > 1 and v.saber != 3 { animate_sabers{ &sc, &w, v, o, c } }
            }
            door{ d } => { animate_door{ &sc, &w, v, state = @as(u32, d.state) } }
            placeable{ p } => { animate_placeable{ &sc, &w, v, anim = p.anim } }
            trigger{ t } => { animate_mine{ &sc, &w, v, shown = traps::is_known{ w = &w, o } } }
            else => {}
        }
        let mut i: usize = 0
        while i < v.count {
            scene::advance_owned{ &sc, &w, part = v.first + i, dt, owner = if i == 0 and o.kind == obj::Kind::creature { o.id } else { obj::INVALID } }
            i = i + 1
        }
    }

    // The gait trace (`--log trace`, every fourth frame): a walking or running creature's cycles a second on the ground
    // (speed / WALKDIST or RUNDIST) and on its feet (the player's rate / the cycle's length). They are equal
    // unless the rate hit its clamp: when they differ the feet slide.
    fn trace_gait { mut sc: scene::Scene, mut w: world::World, v: *scene::Visual, o: *obj::Object, c: *obj::Creature } {
        if o.animation != obj::ANIM_RUN and o.animation != obj::ANIM_WALK { return }
        let p0 = scene::part_at{ sc = &sc, i = v.first }
        let mut rate: f32 = 0.0
        if p0.player.current is some{ value = tr } { rate = tr.speed }
        let len = scene::length_of{ &sc, &w, part = v.first, name = p0.anim[..p0.anim_len] }
        let ground = movement::gait_cycles{ w = &w, c, run = o.animation == obj::ANIM_RUN, speed = c.speed }
        world::prefix{ w = &w }
        _ = @fmt(&w.io, "gait {} anim {} speed {} rate {} cycle {} s feet {} ground {} cycles/s\n", o.tag, o.animation, c.speed, rate, len, if len > 0.0 { rate / len } else { 0.0 }, ground)
    }

    // The playback rate of animation `name` on a creature: its anim_speed, or for a walk or run cycle the cycles
    // a second the ground speed asks for times the cycle's length, so the feet keep up with the ground
    // (CSWCCreature::UpdateMovementAnimation: speed x length / WALKDIST or RUNDIST). The floor is the
    // original's: a walker starting off crawls at a tenth of the pace.
    fn cycle_rate { mut sc: scene::Scene, mut w: world::World, v: *scene::Visual, o: *obj::Object, name: []u8 } -> f32 {
        if o.anim_cycles <= 0.0 { return o.anim_speed }
        let length = scene::length_of{ &sc, &w, part = v.first, name }
        if length <= 0.0 { return 1.0 }
        return math::clamp{ x = o.anim_cycles * length, lo = 0.1, hi = 2.5 }
    }

    // The body plays the object's animation (with the `c` prefix for S and L models; pause1 when
    // the model lacks it); a head plays the same name when its model has it.
    fn animate_creature { mut sc: scene::Scene, mut w: world::World, v: *mut scene::Visual, o: *obj::Object } {
        if v.animation == o.animation and v.cycles == o.anim_cycles { return }
        v.animation = o.animation
        v.cycles = o.anim_cycles
        let mut named: [34]u8
        let mut base = animname::name_of{ id = o.animation }
        let mut looping = animname::loops{ id = o.animation }
        let mut prefixed = v.creature_prefix
        if animname::is_row{ id = o.animation } {
            // An animations.2da row (the combat animations): its own name, no prefix.
            let row = animname::row_of{ id = o.animation }
            base = twoda::get_string{ t = w.tables.animations, row, column = "name" } ifnull ""
            looping = (twoda::get_int{ t = w.tables.animations, row, column = "fireforget" } ifnull 1) == 0
            prefixed = false
        } else if base.len == 0 {
            // A conversation's animation numbers and the cutscene models' (animname::name_in).
            base = animname::name_in{ w = &w, id = o.animation, into = named[..] }
            looping = animname::loops_in{ w = &w, id = o.animation }
        }
        // Cutscene models name theirs `cutNNNw` whatever their kind.
        let cut = ci::starts_with{ s = base, prefix = "cut" }
        if cut { prefixed = false }
        // A scene animation is authored in area space and the body's own are not, so a blend into or out
        // of one (or between two shots') would carry the body from wherever the other left it: the stunt
        // body glided in from the origin at every camera cut. A cut changes the pose at once.
        let first = scene::part_at{ sc = &sc, i = v.first }
        let was_cut = ci::starts_with{ s = first.anim[..first.anim_len], prefix = "cut" }
        let transition: f32 = if cut or was_cut { 0.0 } else { 0.25 }
        let mut buf: [34]u8
        let name = with_prefix{ into = buf[..], name = if base.len > 0 { base } else { "pause1" }, prefix = prefixed }
        let mut fallback: [34]u8
        let pause = with_prefix{ into = fallback[..], name = "pause1", prefix = v.creature_prefix }
        let rate = cycle_rate{ &sc, &w, v, o, name }
        if not scene::play{ &sc, &w, part = v.first, name, looping, speed = rate, transition } {
            _ = scene::play{ &sc, &w, part = v.first, name = pause, looping = true, speed = 1.0, transition }
        }
        // The head part (a B body's second part hangs at the headhook).
        if v.count > 1 {
            let head = scene::part_at{ sc = &sc, i = v.first + 1 }
            if slice::eq_bytes{ a = head.hook, b = mdl_anim::HOOK_HEAD } {
                if not scene::play{ &sc, &w, part = v.first + 1, name, looping, speed = rate, transition = 0.25 } {
                    _ = scene::play{ &sc, &w, part = v.first + 1, name = "pause1", looping = true, speed = 1.0, transition = 0.25 }
                }
            }
        }
    }

    // Whether the creature's blades should be lit: a script's override, else while it fights.
    fn saber_wanted { w: *world::World, v: *scene::Visual, o: *obj::Object, c: *obj::Creature } -> bool {
        if v.saber_force != 0 { return v.saber_force == 2 }
        if c.dead { return false }
        if c.in_combat { return true }
        if fight::of{ o } is some{ value = f } { return f.round.started }
        return false
    }

    // A lightsaber (a weapon model with a `powered` animation) is lit while its wielder fights and
    // dark otherwise: `powerup` then `powered` when it lights, `powerdown` then `off` when it goes
    // out, with the item's sound; a creature met already fighting has it lit at once.
    fn animate_sabers { mut sc: scene::Scene, mut w: world::World, v: *mut scene::Visual, o: *obj::Object, c: *obj::Creature } {
        let want = saber_wanted{ w = &w, v, o, c }
        let known = v.saber
        if known == (if want { 2 } else { 1 }) { return }
        let mut blades: usize = 0
        let mut i: usize = 1
        while i < v.count {
            let part = v.first + i
            i = i + 1
            let p = scene::part_at{ sc = &sc, i = part }
            let model = scene::loaded_at{ sc = &sc, i = p.loaded }.model
            if mdl::find_animation{ model, name = "powered" } == null { continue }
            blades = blades + 1
            if known == 0 {
                _ = scene::play{ &sc, &w, part, name = if want { "powered" } else { "off" }, looping = true, speed = 1.0, transition = 0.0 }
            } else if want {
                _ = scene::play{ &sc, &w, part, name = "powerup", looping = false, speed = 1.0, transition = 0.0 }
                set_next{ sc = &sc, part, name = "powered" }
            } else {
                _ = scene::play{ &sc, &w, part, name = "powerdown", looping = false, speed = 1.0, transition = 0.0 }
                set_next{ sc = &sc, part, name = "off" }
            }
        }
        if blades == 0 {
            v.saber = 3
            return
        }
        v.saber = if want { 2 } else { 1 }
        if known != 0 { fight::saber_sound{ &w, id = o.id, lit = want } }
    }

    fn with_prefix { into: []mut u8, name: []u8, prefix: bool } -> []u8 {
        let mut n: usize = 0
        if prefix {
            into[0] = 'c'
            n = 1
        }
        let mut i: usize = 0
        while i < name.len and n < into.len {
            into[n] = name[i]
            n = n + 1
            i = i + 1
        }
        return into[..n]
    }

    // closed -> opening1 then opened1 (and back with closing1 then closed); a door first seen
    // open shows opened1 at once.
    fn animate_door { mut sc: scene::Scene, mut w: world::World, v: *mut scene::Visual, state: u32 } {
        if v.state == state { return }
        let first = v.state == 0xFFFFFFFF
        v.state = state
        let part = v.first
        if state == 0 {
            if first or not scene::play{ &sc, &w, part, name = "closing1", looping = false, speed = 1.0, transition = 0.0 } {
                _ = scene::play{ &sc, &w, part, name = "closed", looping = true, speed = 1.0, transition = 0.0 }
            } else { set_next{ sc = &sc, part, name = "closed" } }
            return
        }
        let opening: []u8 = if state == 2 { "opening2" } else { "opening1" }
        let opened: []u8 = if state == 2 { "opened2" } else { "opened1" }
        if first or not scene::play{ &sc, &w, part, name = opening, looping = false, speed = 1.0, transition = 0.0 } {
            _ = scene::play{ &sc, &w, part, name = opened, looping = true, speed = 1.0, transition = 0.0 }
        } else { set_next{ sc = &sc, part, name = opened } }
    }

    fn set_next { sc: *scene::Scene, part: usize, name: []u8 } {
        let p = scene::part_at{ sc, i = part }
        let mut i: usize = 0
        while i < name.len and i < 32 {
            p.next[i] = name[i]
            i = i + 1
        }
        p.next_len = i
    }

    // A mine plays `default` (its marks at alpha 0) until the party knows of it, then `detect` (the
    // marks fade in, lit red): the original's animations 10143 and 10144 (re/movement.md 7.1).
    fn animate_mine { mut sc: scene::Scene, mut w: world::World, v: *mut scene::Visual, shown: bool } {
        let state: u32 = if shown { 1 } else { 0 }
        if v.state == state { return }
        v.state = state
        _ = scene::play{ &sc, &w, part = v.first, name = if shown { "detect" } else { "default" }, looping = not shown, speed = 1.0, transition = 0.0 }
    }

    // A placeable plays `default` (or nothing), or the animation its state names (on, off, open,
    // close, animloopN).
    fn animate_placeable { mut sc: scene::Scene, mut w: world::World, v: *mut scene::Visual, anim: u32 } {
        if v.state == anim { return }
        v.state = anim
        let name = animname::name_of{ id = anim }
        if anim == obj::ANIM_STAND or name.len == 0 {
            _ = scene::play{ &sc, &w, part = v.first, name = "default", looping = true, speed = 1.0, transition = 0.0 }
            return
        }
        _ = scene::play{ &sc, &w, part = v.first, name, looping = animname::loops{ id = anim }, speed = 1.0, transition = 0.0 }
    }

    // The visual's draws: each part under its parent's hook.
    // The world transform of each of a visual's parts (the root's at the object, an attachment's
    // at its parent's hook): `out[i]` for part `v.first + i`, as many as `out` holds (8).
    fn part_transforms { sc: *scene::Scene, v: *scene::Visual, o: *obj::Object, out: []mut math::Mat4 } -> usize {
        let yaw = obj::model_yaw{ orientation = o.orientation }
        let mut instance = math::mat4::from_rotation_translation{
            r = math::quat::from_axis_angle{ axis = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }, angle = yaw }, t = o.position,
        }
        // A cutscene's stunt model is authored in area space: its animation moves it from the origin.
        if v.stunt { instance = math::mat4::identity{} }
        let mut i: usize = 0
        while i < v.count and i < out.len {
            let p = scene::part_at{ sc, i = v.first + i }
            let mut t = instance
            if p.parent >= 0 {
                let parent_index = @as(usize, p.parent) - v.first
                if parent_index < i {
                    let parent = scene::part_at{ sc, i = @as(usize, p.parent) }
                    let parent_model = scene::loaded_at{ sc, i = parent.loaded }.model
                    let hook = mdl_anim::hook_transform{ model = parent_model, pose = parent.pose, name = p.hook } ifnull { math::mat4::identity{} }
                    t = math::mat4::mul{ a = out[parent_index], b = hook }
                }
            }
            out[i] = t
            i = i + 1
        }
        return i
    }

    fn draw { sc: *scene::Scene, v: *scene::Visual, o: *obj::Object, mut frame: render::Frame, view: u32 } {
        let mut transforms: [8]math::Mat4
        let n = part_transforms{ sc, v, o, out = transforms[..] }
        // A creature in stealth mode, its weapons too, wears the stealth texture.
        let look = if scene::is_hiding{ o } { scene::look_material{ sc } } else { null }
        let mut i: usize = 0
        while i < n {
            let p = scene::part_at{ sc, i = v.first + i }
            let l = scene::loaded_at{ sc, i = p.loaded }
            _ = mdl_render::add_draws_look{ &frame, view, model = l.model, pose = p.pose, g = l.gpu, transform = transforms[i], materials = l.materials, time = sc.time, look }
            i = i + 1
        }
    }

    // Where a visual puts the node called `hook` in world space, looked for in its parts in order
    // (the body's `Impact` or `headhook`, then a weapon's `bullethook`); `which` picks the nth part
    // that has one (0: the first, so a second weapon's hook is 1). The matrix's position is the node.
    fn hook_world { sc: *scene::Scene, v: *scene::Visual, o: *obj::Object, hook: []u8, which: usize } -> ?math::Mat4 {
        let mut transforms: [8]math::Mat4
        let n = part_transforms{ sc, v, o, out = transforms[..] }
        let mut seen: usize = 0
        let mut i: usize = 0
        while i < n {
            let p = scene::part_at{ sc, i = v.first + i }
            let l = scene::loaded_at{ sc, i = p.loaded }
            if mdl_anim::hook_transform{ model = l.model, pose = p.pose, name = hook } is some{ value = local } {
                if seen == which { return math::mat4::mul{ a = transforms[i], b = local } }
                seen = seen + 1
            }
            i = i + 1
        }
        return null
    }
}
