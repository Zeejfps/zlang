// Keyboard control of the party leader (docs/re/movement.md 1.2-1.4): the forward and strafe
// axes, turned by the camera's yaw, integrated into a velocity, the leader turning at the
// camerastyle rates and moving along its facing on the walkmesh with sliding; its new position
// goes straight into the world object, with the trigger bookkeeping. The target actions (R, 1-3) and
// clicks are the HUD's (lib/hud), not this file's.
namespace ctl {
    struct Keys {
        forward: bool,
        back: bool,
        strafe_left: bool,
        strafe_right: bool,
        turn_left: bool,            // camera rotate keys
        turn_right: bool,
        freelook: bool,             // free look: the keys do not move the leader (W and S tilt the view, cam::Input)
        walk: bool,                 // the walk modifier (B) is held: half the input, the walk animation
        action: bool,               // a minigame's fire key went down this frame (Space)
    }

    fn no_keys {} -> Keys {
        return Keys{ forward = false, back = false, strafe_left = false, strafe_right = false, turn_left = false, turn_right = false, freelook = false, walk = false, action = false }
    }

    struct Control {
        vx: f32,                    // velocity, m/s
        vy: f32,
        min_turn: f32,              // degrees per second (camerastyle MinTurnRate, MaxTurnRate)
        max_turn: f32,
        last: u32,                  // the creature moved last frame: when the leader changes, the old one stops
        combat_movement: bool,      // the "Combat Movement" option: in combat mode the keys may break the leader's orders
    }

    fn new {} -> Control { return Control{ vx = 0.0, vy = 0.0, min_turn = 150.0, max_turn = 1500.0, last = obj::INVALID, combat_movement = true } }

    fn set_style { mut ctl: Control, t: twoda::Table, row: u32 } {
        ctl.min_turn = twoda::get_float{ t, row = @as(usize, row), column = "minturnrate" } ifnull 150.0
        ctl.max_turn = twoda::get_float{ t, row = @as(usize, row), column = "maxturnrate" } ifnull 1500.0
    }

    // Gives up a creature the keys were moving: standing, unless an action has it now.
    fn release { mut w: world::World, id: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        if o.actions.len > 0 or not c.moving { return }
        movement::stop{ &w, id }
        world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
    }

    // The camera's rotate input for these keys (positive turns left).
    fn turn_input { keys: Keys } -> f32 {
        let mut t: f32 = 0.0
        if keys.turn_left { t = t + 1.0 }
        if keys.turn_right { t = t - 1.0 }
        return t
    }

    // One frame of control: `yaw` is the camera's (radians, 0 along +y).
    fn update { mut ctl: Control, mut w: world::World, keys: Keys, yaw: f32, dt: f32 } {
        let id = w.pc
        if ctl.last != id {
            // A creature that was walking when control passed on would run on in place: nothing
            // else resets what the keys started.
            release{ &w, id = ctl.last }
            ctl.last = id
        }
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        if c.dead or dt <= 0.0 { return }
        let step = math::min{ a = dt, b = 1.0 }
        // The input vector in the camera's frame (x right, y forward), normalised on diagonals.
        // In free look the inputs are 0 (movement.md 1.2 step 2): W and S tilt the view, A and D (strafe) do nothing.
        let mut ix: f32 = 0.0
        let mut iy: f32 = 0.0
        if not keys.freelook {
            if keys.forward { iy = iy + 1.0 }
            if keys.back { iy = iy - 1.0 }
            if keys.strafe_right { ix = ix + 1.0 }
            if keys.strafe_left { ix = ix - 1.0 }
        }
        if ix != 0.0 and iy != 0.0 {
            ix = ix * 0.70710678
            iy = iy * 0.70710678
        }
        // The walk modifier (keymap action 265, "Run / Walk") halves the input vector (movement.md 1.2 step 3).
        if keys.walk {
            ix = ix * 0.5
            iy = iy * 0.5
        }
        // A leader with orders in combat mode does not hear the keys unless the Combat Movement option is on
        // (ProcessInput 0x006227e0, movement.md 1.4).
        if o.actions.len > 0 and c.combat_mode and not ctl.combat_movement {
            ix = 0.0
            iy = 0.0
        }
        let has_input = ix != 0.0 or iy != 0.0
        // Otherwise input cancels whatever the leader was doing (movement.md 1.4, CancelServerActions; ours: at once,
        // where the original waits 0.3 s first).
        if has_input and o.actions.len > 0 { fight::cancel_actions{ &w, id } }
        let o2 = world::object{ w = &w, id } ifnull { return }
        let c2 = obj::creature{ o = o2 } ifnull { return }
        let fx = -math::sinf{ x = yaw }
        let fy = math::cosf{ x = yaw }
        let ux = fx * iy + fy * ix
        let uy = fy * iy - fx * ix
        let scale = fight::speed_scale{ o = o2 }
        // In stealth (or another walk-only limit) the leader walks (movement.md 1.2, GetMaxSpeed).
        let walking = stealth::walk_only{ c = c2 }
        let rated = if walking { movement::walk_pace{ w = &w, c = c2, scale } } else { c2.run_rate * scale }
        // The leader is driven by the keys, and its top speed and push come from the appearance it shows (the
        // client creature's block, GetMaxSpeed 0x00679510: appearance.2da DriveMaxSpeed and DriveAccl), not from its
        // rate: every humanoid row says 5.4 and 50, the Envirosuit (row 181, EffectDisguise in the airlocks of
        // Manaan) 1.5 and 5, which is how the underwater walk is slow. Faster than the rate is not taken.
        let shown = if c2.disguise != 0 { c2.disguise } else { c2.appearance }
        let drive = twoda::get_float{ t = w.tables.appearance, row = @as(usize, shown), column = "drivemaxspeed" } ifnull 0.0
        let accl = twoda::get_float{ t = w.tables.appearance, row = @as(usize, shown), column = "driveaccl" } ifnull 50.0
        let vmax = if drive > 0.0 and drive * scale < rated { drive * scale } else { rated }
        // Turning toward the desired heading, fast when slow (movement.md 1.2 step 5).
        let speed = math::sqrtf{ x = ctl.vx * ctl.vx + ctl.vy * ctl.vy }
        if has_input and speed > 0.1 {
            let want = math::atan2f{ y = uy, x = ux }
            let have = math::atan2f{ y = o2.orientation.y, x = o2.orientation.x }
            let mut delta = want - have
            while delta > math::PI { delta = delta - 2.0 * math::PI }
            while delta < -math::PI { delta = delta + 2.0 * math::PI }
            let rate = ctl.min_turn + (ctl.max_turn - ctl.min_turn) * (1.0 - math::min{ a = speed / vmax, b = 1.0 })
            let max_step = math::radians{ degrees = rate * step }
            let turn = math::clamp{ x = delta, lo = -max_step, hi = max_step }
            let heading = have + turn
            world::set_orientation{ o = o2, v = math::Vec3{ x = math::cosf{ x = heading }, y = math::sinf{ x = heading }, z = 0.0 } }
        } else if has_input and speed <= 0.1 {
            // From standstill the original starts the velocity first; face the input at once so
            // the first step goes where the keys say (ours).
            world::set_orientation{ o = o2, v = math::Vec3{ x = ux, y = uy, z = 0.0 } }
        }
        // Velocity: v approaches u * vmax with the time constant vmax / K (movement.md 1.2 step 6).
        if not has_input and math::abs{ x = ctl.vx } < 0.25 and math::abs{ x = ctl.vy } < 0.25 {
            ctl.vx = 0.0
            ctl.vy = 0.0
        } else {
            // K is the appearance's DriveAccl (50 for the humanoids: full speed in about 0.3 s), 15 in stealth, and
            // below 1.8 m/s scaled by vmax / 1.8 (CSWCCreature::GetAcceleration 0x00610590, movement.md 1.2).
            let mut k: f32 = if c2.stealth { 15.0 } else if accl > 0.0 { accl } else { 50.0 }
            if vmax < 1.8 { k = k * vmax / 1.8 }
            let decay = math::expf{ x = -step * k / vmax }
            ctl.vx = ux * vmax + (ctl.vx - ux * vmax) * decay
            ctl.vy = uy * vmax + (ctl.vy - uy * vmax) * decay
        }
        let v = math::sqrtf{ x = ctl.vx * ctl.vx + ctl.vy * ctl.vy }
        c2.speed = v
        if v > 1.0 {
            // Move along the facing by |v| dt (movement.md 1.2 step 7; any distance: the 0.033 m floor is only for a
            // debug speed of 5000 m/s or more), sliding along what blocks (MoveDirect). A failed move leaves the
            // velocity as it was: the leader runs on the spot against a wall. A leader with orders, one who cannot
            // move or one who is helpless is not moved (MoveDirect reports success without moving).
            let d = v * step
            let from = o2.position
            let dx = o2.orientation.x
            let dy = o2.orientation.y
            let to = math::Vec3{ x = from.x + dx * d, y = from.y + dy * d, z = from.z }
            if o2.actions.len == 0 and movement::can_move{ c = c2 } {
                if move_direct{ &w, id, from, to } is some{ value = moved } {
                    if world::object{ w = &w, id } is some{ value = om } { world::set_position{ o = om, p = moved } }
                    movement::cross_volumes{ &w, id, from, to = moved }
                }
            }
            let o3 = world::object{ w = &w, id } ifnull { return }
            // The creature walks or runs for the AI update that follows (ai::update_creature puts a
            // creature that is not `moving` and has no action back to standing).
            c2.moving = true
            // Run above 0.6 of the run rate, walk at or below it (the client's drive animation, movement.md 3.6);
            // in stealth always walk, with the stealth walk. The cycle plays at the velocity over the distance one cycle covers.
            let run_from = c2.run_rate * 0.6 * scale
            let run = v > run_from and not walking
            world::set_gait{ o = o3, id = movement::gait_of{ c = c2, run }, cycles = movement::gait_cycles{ w = &w, c = c2, run, speed = v, drive = true } }
        } else if o2.actions.len == 0 {
            c2.moving = false
            if o2.animation == obj::ANIM_RUN or o2.animation == obj::ANIM_WALK or o2.animation == obj::ANIM_STEALTH_WALK {
                world::set_animation{ o = o2, id = obj::ANIM_STAND, speed = 1.0 }
            }
        }
    }

    // Where the leader's step from `from` toward `to` ends (CSWCCreature::MoveDirect 0x00614b90, movement.md 1.3): up to six
    // walk tests. A clear one is the move. A blocked one reports the edge it hit: a wall's or a ledge's, a door's or a
    // placeable's walkmesh, or another creature's circle (its tangent where the step meets it; the player's creature
    // pushes nobody aside, and its own spot is not moved, as the original's 1 m search tries only the spot itself).
    // Away from a corner the target is put on that edge's line, so the leader slides along it; at a corner it becomes
    // a 0.06 m step to the side. From the second try a slide whose edge turns back against the last one's ends the
    // move, or at a corner becomes a 0.03 m step to the side. Null: no move this frame.
    fn move_direct { mut w: world::World, id: u32, from: math::Vec3, to: math::Vec3 } -> ?math::Vec3 {
        let o = world::object{ w = &w, id } ifnull { return null }
        let c = obj::creature{ o } ifnull { return null }
        let sx = to.x - from.x
        let sy = to.y - from.y
        let sl = math::sqrtf{ x = sx * sx + sy * sy }
        if sl < 0.000001 { return null }
        let dir_x = sx / sl
        let dir_y = sy / sl
        let mut target = to
        let mut last_nx: f32 = 0.0
        let mut last_ny: f32 = 0.0
        let mut tries: u32 = 0
        while tries < 6 {
            tries = tries + 1
            let mut edge: ?walkmap::Edge = null
            let z = walkmap::step_to{ m = &w.walk, from, to = target }
            if z != null {
                let dest = math::Vec3{ x = target.x, y = target.y, z }
                let hit = crowd::first_blocker{ w = &w, o, c, from, to = dest, skip = obj::INVALID, skip2 = obj::INVALID, pushable = false } ifnull { return dest }
                edge = walkmap::Edge{ point = hit.point, normal = hit.normal, vertex = false }
            } else {
                edge = walkmap::wall_hit{ m = &w.walk, from, to = target }
            }
            // No edge reported: the same target is tried again.
            let e = edge ifnull { continue }
            // Which way the edge runs (its normal turned left), seen walking back from the target.
            let along_now = dir_x * e.normal.y - dir_y * e.normal.x
            let along_before = dir_x * last_ny - dir_y * last_nx
            // The side a corner's sideways step goes to.
            let side: f32 = if e.normal.x * dir_y - e.normal.y * dir_x <= 0.0 { 1.0 } else { -1.0 }
            if tries >= 2 and ((along_now > 0.0 and along_before < 0.0) or (along_now < 0.0 and along_before > 0.0)) {
                if not e.vertex { return null }
                target = math::Vec3{ x = from.x - dir_y * 0.03 * side, y = from.y + dir_x * 0.03 * side, z = from.z }
            } else if e.vertex {
                target = math::Vec3{ x = from.x - dir_y * 0.06 * side, y = from.y + dir_x * 0.06 * side, z = from.z }
            } else {
                let into = (target.x - e.point.x) * e.normal.x + (target.y - e.point.y) * e.normal.y
                target = math::Vec3{ x = target.x - e.normal.x * into, y = target.y - e.normal.y * into, z = from.z }
            }
            last_nx = e.normal.x
            last_ny = e.normal.y
        }
        return null
    }
}
