// Keyboard control of the party leader (docs/re/movement.md 1.2-1.4): the forward and strafe
// axes, turned by the camera's yaw, integrated into a velocity, the leader turning at the
// camerastyle rates and moving along its facing on the walkmesh with sliding; its new position
// goes straight into the world object, with the trigger bookkeeping. The target actions (R, 1-3) and
// clicks are the HUD's (lib/hud), not this file's.
namespace ctl {
    struct Keys {
        forward: bool,
        back: bool,
        strafe_left: bool,
        strafe_right: bool,
        turn_left: bool,            // camera rotate keys
        turn_right: bool,
        freelook: bool,             // free look: the leader keeps its facing (the mouse turns it) and moves along the keys
        walk: bool,                 // the walk modifier (B) is held: half the input, the walk animation
        action: bool,               // a minigame's fire key went down this frame (Space)
    }

    fn no_keys {} -> Keys {
        return Keys{ forward = false, back = false, strafe_left = false, strafe_right = false, turn_left = false, turn_right = false, freelook = false, walk = false, action = false }
    }

    struct Control {
        vx: f32,                    // velocity, m/s
        vy: f32,
        min_turn: f32,              // degrees per second (camerastyle MinTurnRate, MaxTurnRate)
        max_turn: f32,
        last: u32,                  // the creature moved last frame: when the leader changes, the old one stops
    }

    fn new {} -> Control { return Control{ vx = 0.0, vy = 0.0, min_turn = 150.0, max_turn = 1500.0, last = obj::INVALID } }

    fn set_style { mut ctl: Control, t: twoda::Table, row: u32 } {
        ctl.min_turn = twoda::get_float{ t, row = @as(usize, row), column = "minturnrate" } ifnull 150.0
        ctl.max_turn = twoda::get_float{ t, row = @as(usize, row), column = "maxturnrate" } ifnull 1500.0
    }

    // Gives up a creature the keys were moving: standing, unless an action has it now.
    fn release { mut w: world::World, id: u32 } {
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        if o.actions.len > 0 or not c.moving { return }
        movement::stop{ &w, id }
        world::set_animation{ o, id = obj::ANIM_STAND, speed = 1.0 }
    }

    // The camera's rotate input for these keys (positive turns left).
    fn turn_input { keys: Keys } -> f32 {
        let mut t: f32 = 0.0
        if keys.turn_left { t = t + 1.0 }
        if keys.turn_right { t = t - 1.0 }
        return t
    }

    // One frame of control: `yaw` is the camera's (radians, 0 along +y).
    fn update { mut ctl: Control, mut w: world::World, keys: Keys, yaw: f32, dt: f32 } {
        let id = w.pc
        if ctl.last != id {
            // A creature that was walking when control passed on would run on in place: nothing
            // else resets what the keys started.
            release{ &w, id = ctl.last }
            ctl.last = id
        }
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        if c.dead or dt <= 0.0 { return }
        let step = math::min{ a = dt, b = 1.0 }
        // The input vector in the camera's frame (x right, y forward), normalised on diagonals.
        let mut ix: f32 = 0.0
        let mut iy: f32 = 0.0
        if keys.forward { iy = iy + 1.0 }
        if keys.back { iy = iy - 1.0 }
        if keys.strafe_right { ix = ix + 1.0 }
        if keys.strafe_left { ix = ix - 1.0 }
        if ix != 0.0 and iy != 0.0 {
            ix = ix * 0.70710678
            iy = iy * 0.70710678
        }
        // The walk modifier (keymap action 265, "Run / Walk") halves the input vector (movement.md 1.2 step 3).
        if keys.walk {
            ix = ix * 0.5
            iy = iy * 0.5
        }
        let has_input = ix != 0.0 or iy != 0.0
        // Input cancels whatever the leader was doing (movement.md 1.4; ours: at once).
        if has_input and o.actions.len > 0 { actions::clear_all{ &w, id } }
        let o2 = world::object{ w = &w, id } ifnull { return }
        let c2 = obj::creature{ o = o2 } ifnull { return }
        let fx = -math::sinf{ x = yaw }
        let fy = math::cosf{ x = yaw }
        let ux = fx * iy + fy * ix
        let uy = fy * iy - fx * ix
        let scale = fight::speed_scale{ o = o2 }
        // In stealth (or another walk-only limit) the leader walks (movement.md 1.2, GetMaxSpeed).
        let walking = stealth::walk_only{ c = c2 }
        let vmax = (if walking { c2.walk_rate } else { c2.run_rate }) * scale
        // Turning toward the desired heading, fast when slow (movement.md 1.2 step 5).
        let speed = math::sqrtf{ x = ctl.vx * ctl.vx + ctl.vy * ctl.vy }
        if keys.freelook {
            // Free look: the mouse turns the leader, the keys only move him.
        } else if has_input and speed > 0.1 {
            let want = math::atan2f{ y = uy, x = ux }
            let have = math::atan2f{ y = o2.orientation.y, x = o2.orientation.x }
            let mut delta = want - have
            while delta > math::PI { delta = delta - 2.0 * math::PI }
            while delta < -math::PI { delta = delta + 2.0 * math::PI }
            let rate = ctl.min_turn + (ctl.max_turn - ctl.min_turn) * (1.0 - math::min{ a = speed / vmax, b = 1.0 })
            let max_step = math::radians{ degrees = rate * step }
            let turn = math::clamp{ x = delta, lo = -max_step, hi = max_step }
            let heading = have + turn
            world::set_orientation{ o = o2, v = math::Vec3{ x = math::cosf{ x = heading }, y = math::sinf{ x = heading }, z = 0.0 } }
        } else if has_input and speed <= 0.1 {
            // From standstill the original starts the velocity first; face the input at once so
            // the first step goes where the keys say (ours).
            world::set_orientation{ o = o2, v = math::Vec3{ x = ux, y = uy, z = 0.0 } }
        }
        // Velocity: v approaches u * vmax (movement.md 1.2 step 6; K = 15, ours).
        if not has_input and math::abs{ x = ctl.vx } < 0.25 and math::abs{ x = ctl.vy } < 0.25 {
            ctl.vx = 0.0
            ctl.vy = 0.0
        } else {
            let k: f32 = 15.0
            let decay = math::expf{ x = -step * k / vmax }
            ctl.vx = ux * vmax + (ctl.vx - ux * vmax) * decay
            ctl.vy = uy * vmax + (ctl.vy - uy * vmax) * decay
        }
        let v = math::sqrtf{ x = ctl.vx * ctl.vx + ctl.vy * ctl.vy }
        c2.speed = v
        if v > 1.0 {
            // Move along the facing by |v| dt (movement.md 1.2 step 7), sliding along what blocks.
            let d = v * step
            let from = o2.position
            let mut dx = o2.orientation.x
            let mut dy = o2.orientation.y
            if keys.freelook {
                dx = ctl.vx / v
                dy = ctl.vy / v
            }
            let to = math::Vec3{ x = from.x + dx * d, y = from.y + dy * d, z = from.z }
            let moved = slide{ &w, from, to }
            if moved != null {
                world::set_position{ o = o2, p = moved }
                movement::cross_volumes{ &w, id, from, to = moved }
            } else {
                ctl.vx = 0.0
                ctl.vy = 0.0
            }
            let o3 = world::object{ w = &w, id } ifnull { return }
            // The creature walks or runs for the AI update that follows (ai::update_creature puts a
            // creature that is not `moving` and has no action back to standing).
            c2.moving = true
            // Walk below the midpoint of the creature's walk and run rates, run above (ours: the original
            // blends by speed, movement.md 3.6); in stealth always walk.
            let run_from = (c2.walk_rate + c2.run_rate) * 0.5 * scale
            let run = v >= run_from and not walking
            world::set_animation{ o = o3, id = if run { obj::ANIM_RUN } else { obj::ANIM_WALK }, speed = movement::anim_rate{ w = &w, c = c2, run, speed = v } }
        } else if o2.actions.len == 0 {
            c2.moving = false
            if o2.animation == obj::ANIM_RUN or o2.animation == obj::ANIM_WALK {
                world::set_animation{ o = o2, id = obj::ANIM_STAND, speed = 1.0 }
            }
        }
    }

    // Where a step from `from` toward `to` ends: the whole step, else its x or y part alone
    // (ours, for the original's six slide attempts along the edge it hit), else null.
    fn slide { mut w: world::World, from: math::Vec3, to: math::Vec3 } -> ?math::Vec3 {
        let z = walkmap::step_to{ m = &w.walk, from, to }
        if z != null { return math::Vec3{ x = to.x, y = to.y, z } }
        let tx = math::Vec3{ x = to.x, y = from.y, z = from.z }
        let zx = walkmap::step_to{ m = &w.walk, from, to = tx }
        let ty = math::Vec3{ x = from.x, y = to.y, z = from.z }
        let zy = walkmap::step_to{ m = &w.walk, from, to = ty }
        let dx = math::abs{ x = to.x - from.x }
        let dy = math::abs{ x = to.y - from.y }
        if zx != null and (zy == null or dx >= dy) { return math::Vec3{ x = tx.x, y = tx.y, z = zx } }
        if zy != null { return math::Vec3{ x = ty.x, y = ty.y, z = zy } }
        return null
    }
}
