// The area's sound (docs/design/audio.md, "How the engine should use it"): its music
// (ambientmusic.2da, replayed after MusicDelay), its ambient bed (ambientsound.2da, looping),
// the placed sound objects (UTS: continuous loops or sounds at intervals, positional or not),
// and the outbox's sound notes (PlaySound, SoundObjectPlay/Stop). The listener is the camera.
//
//   let mut amb = ambience::make{ heap = &h, m = mixer }
//   ambience::start_area{ &amb, &w }
//   each frame: ambience::take{ &amb, &w, note } for each outbox note; ambience::update{ &amb, &w, eye, forward, dt }
namespace ambience {
    // A placed sound object's player.
    struct Placed {
        id: u32,
        handle: mix::Handle,
        wait: f32,                      // seconds until its next sound
        next: usize,                    // its next sound in order (not Random)
        playing: bool,                  // a continuous loop is on
        started: bool,                  // a continuous loop has played: starting it again is a return
    }

    // A creature stirred up by a hostile act (docs/re/combat.md 3.6, "Battle music"): the battle track plays
    // until the first of these countdowns runs out.
    struct Excited {
        id: u32,
        ms: i32,                        // left of excitedduration.2da's 10 s since its last hostile act
        stirs: u32,                     // its fight state's count of hostile acts that stirred it, when last looked at
    }

    struct Ambience {
        heap: *mut heap::Heap,
        m: *mut mix::Mixer,
        music: mix::Handle,
        music_bytes: []mut u8,
        music_wait: f32,                // seconds until the track plays again; < 0 none pending
        music_delay: f32,
        ambient: mix::Handle,
        ambient_bytes: []mut u8,
        placed: list::List(Placed, heap::Heap),
        sounds: map::Map(resref::ResRef, usize, heap::Heap),      // wave index by name
        waves: list::List([]mut u8, heap::Heap),                  // their bytes (empty: none)
        names: list::List(resref::ResRef, heap::Heap),            // their names, for the sound log (a voice's tag is its index + 1)
        rng: u32,
        started: u32,                   // sounds started, for the report
        listener: math::Vec3,
        bg_off: bool,                   // a script stopped the background music (MusicBackgroundStop)
        battle: bool,                   // the battle track is the one playing (MusicBattlePlay)
        stinger: mix::Handle,           // the stinger that closed the last battle
        stinger_bytes: []mut u8,
        excited: list::List(Excited, heap::Heap),
        battle_clock: u64,              // the world clock (ms) when the creatures were last looked at
        ambient_off: bool,              // a script stopped the ambient bed (AmbientSoundStop)
        bias: f32,                      // the settings' 2D3D Bias (loudness)
        mode: u8,                       // the sound mode applied (set_mode)
        suspended: bool,                // modes 5 / 6: the window is inactive (suspend)
    }

    fn make { heap: *mut heap::Heap, m: *mut mix::Mixer } -> Ambience {
        return Ambience{
            heap, m, music = mix::Handle{ slot = 0, id = 0 }, music_bytes = slice::empty(u8){}, music_wait = -1.0,
            music_delay = 0.0, ambient = mix::Handle{ slot = 0, id = 0 }, ambient_bytes = slice::empty(u8){},
            placed = list::new(Placed, heap::Heap){ realloc = heap::alloc, heap },
            sounds = map::new(resref::ResRef, usize, heap::Heap){ realloc = heap::alloc, heap, hash = resref::hash, eq = resref::eq },
            waves = list::new([]mut u8, heap::Heap){ realloc = heap::alloc, heap },
            names = list::new(resref::ResRef, heap::Heap){ realloc = heap::alloc, heap },
            rng = 12345, started = 0, listener = math::vec3::zero{},
            bg_off = false, battle = false, ambient_off = false,
            stinger = mix::Handle{ slot = 0, id = 0 }, stinger_bytes = slice::empty(u8){},
            excited = list::new(Excited, heap::Heap){ realloc = heap::alloc, heap }, battle_clock = 0, bias = 1.5, mode = MODE_PLAY, suspended = false,
        }
    }

    fn random { mut a: Ambience } -> f32 {
        a.rng = @wrap_add(@wrap_mul(a.rng, 214013), 2531011)
        return @as(f32, (a.rng >> 16) & 0x7FFF) / 32768.0
    }

    // A file from streammusic/ (music and ambient beds) in the heap; empty if there is none.
    fn read_stream { mut a: Ambience, mut w: world::World, name: []u8 } -> []mut u8 {
        if name.len == 0 { return slice::empty(u8){} }
        let path = res::music_path(heap::Heap){ rm = w.rm.*, name, realloc = heap::alloc, heap = a.heap } iferr { return slice::empty(u8){} }
        defer _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = a.heap, mem = path, count = 0 }
        return fs::read_all(heap::Heap){ fs = &w.fs, heap = a.heap, realloc = heap::alloc, path } iferr { slice::empty(u8){} }
    }

    // A wave by name through the resource search (sound objects, PlaySound), loaded once. The
    // bytes are kept in a list and found by index: a value looked up with a key from a local
    // would be "derived from" it (friction/models.md).
    fn wave { mut a: Ambience, mut w: world::World, name: resref::ResRef } -> []u8 {
        let have = map::get{ m = a.sounds, key = name }
        if have != null { return list::items{ list = a.waves }[have] }
        let mut key = name
        let found = res::load{ fs = &w.fs, rm = w.rm.*, name = resref::bytes{ r = &key }, kind = restype::Type::wav, realloc = heap::alloc, heap = a.heap } iferr { null }
        let bytes: []mut u8 = found ifnull { slice::empty(u8){} }
        list::push{ list = &a.waves, item = bytes } iferr { return slice::empty(u8){} }
        list::push{ list = &a.names, item = name } iferr {}
        map::put{ m = &a.sounds, key = name, value = a.waves.len - 1 } iferr {}
        return list::items{ list = a.waves }[a.waves.len - 1]
    }

    // The mixer priority of a prioritygroups.2da row: the table's 0 is the most important, the
    // mixer's 255. A row the table lacks is its Default (255, the least important).
    fn priority_of { w: *world::World, row: u32 } -> u8 {
        let p = twoda::get_int{ t = w.tables.prioritygroups, row = @as(usize, row), column = "priority" } ifnull 255
        if p < 0 or p > 255 { return 0 }
        return @trunc(u8, 255 - p)
    }

    // A sound effect's amplitude as the original sets it (CExoSoundSourceInternal::SetVolume,
    // docs/re/app.md "Voices"): its own volume times its prioritygroups.2da row's (both out of
    // 127), and for a 3D sound that squared (Miles' 3D volume) with the player's volume in it,
    // which the mixer squares too (Params.squared). swkotor.ini's "2D3D Bias" (1.5 as installed)
    // tilts the balance: over 1 a 2D sound is scaled by 2 - bias (half, as installed), under 1 a 3D
    // sound by the bias before squaring.
    fn loudness { a: *Ambience, w: *world::World, volume: f32, row: u32, positional: bool } -> f32 {
        let v = volume * group_volume{ w, row }
        if positional {
            let b = if a.bias < 1.0 { v * a.bias } else { v }
            return b * b
        }
        return if a.bias > 1.0 { v * (2.0 - a.bias) } else { v }
    }

    // A prioritygroups.2da row's Volume, out of 127 (blank: 127).
    fn group_volume { w: *world::World, row: u32 } -> f32 {
        let g = twoda::get_int{ t = w.tables.prioritygroups, row = @as(usize, row), column = "volume" } ifnull 127
        return @as(f32, if g < 0 { 0 } else { g }) / 127.0
    }

    // Which of the player's volumes a row's sounds follow (0x005d6a90 / 0x005d6ad0): the chat rows
    // (8, 9), the creature vocalizations (16, 17) and the bark bubbles (26) Voiceover, the music rows
    // (1, 2) Music, every other Sound Effects.
    fn volume_group { row: u32 } -> mix::Group {
        if row == 8 or row == 9 or row == 16 or row == 17 or row == 26 { return mix::Group::voice }
        if row == 1 or row == 2 { return mix::Group::music }
        return mix::Group::sfx
    }

    // Hands the mixer each prioritygroups.2da row's MaxPlaying and Interrupt (0x005d7bd0; a blank
    // MaxPlaying is 255, no limit, and a blank Interrupt is 1). FadeTime is loaded there but nothing reads it.
    fn apply_limits { m: *mut mix::Mixer, w: *world::World } {
        let n = twoda::rows{ t = w.tables.prioritygroups }
        let mut row: usize = 0
        while row < n and row < mix::LIMITS {
            let most = twoda::get_int{ t = w.tables.prioritygroups, row, column = "maxplaying" } ifnull 255
            let interrupt = (twoda::get_int{ t = w.tables.prioritygroups, row, column = "interrupt" } ifnull 1) != 0
            mix::set_group_limit{ m, group = @trunc(u8, row), max_playing = if most < 0 or most > 255 { 255 } else { @trunc(u8, most) }, interrupt }
            row = row + 1
        }
    }

    // The GUI's sounds (guisounds.2da) play as prioritygroups.2da row 11 `GUI` (CSWGuiManager::
    // LoadGuiSounds 0x00409f00): 2D sources at the row's priority and Volume with the 2D3D Bias's
    // scale (loudness), at most two at once, a new click stopping the latest (MaxPlaying 2, Interrupt 1).
    const ROW_GUI: u32 = 11
    fn tune_gui { mut g: gui::Gui, m: *mut mix::Mixer, w: *world::World, bias: f32 } {
        apply_limits{ m, w }
        let v = group_volume{ w, row = ROW_GUI }
        gui::set_sound_class{ &g, group = @trunc(u8, ROW_GUI), priority = priority_of{ w, row = ROW_GUI }, volume = if bias > 1.0 { v * (2.0 - bias) } else { v } }
    }

    // The streams' rows (the original plays them on stream voices of their own that no sound
    // effect can take; ours share the 2D voices, so they get their rows' high priorities).
    const ROW_STINGERS: u32 = 1
    const ROW_MUSIC: u32 = 2
    const ROW_AREA_AMBIENT: u32 = 4

    // A stream's level (0x005dc930): its own volume (127 unless set) times its row's Volume, out of
    // 127 each, times the player's volume for the row (linear, and no 2D3D Bias for a stream).
    // Music plays at 64 of 127, the area's ambient bed at 95, a conversation's voice at 90.
    fn stream_params { w: *world::World, row: u32 } -> mix::Params {
        let mut p = mix::sound_2d{ group = volume_group{ row }, volume = group_volume{ w, row } }
        p.priority = priority_of{ w, row }
        p.play_group = @trunc(u8, row)
        return p
    }

    // The mixer tag of a wave `wave` has loaded: its index + 1.
    fn tag_of { a: *Ambience, name: resref::ResRef } -> u32 {
        let have = map::get{ m = a.sounds, key = name } ifnull { return 0 }
        return @trunc(u32, have + 1)
    }

    // `--log sound`: the mixer's steals and refusals since the last frame, by name, and what the play
    // groups' limits did.
    fn report_events { mut a: Ambience, mut w: world::World } {
        let events = mix::take_events{ m = a.m }
        let mut i: usize = 0
        while i < events.len {
            let e = events[i]
            i = i + 1
            world::prefix{ w = &w }
            let mut new_name = name_of{ a = &a, tag = e.tag }
            if e.group {
                let mut old_name = name_of{ a = &a, tag = e.old_tag }
                let what: []u8 = if e.stolen { "interrupted" } else { "held back by" }
                _ = @fmt(&w.io, "sound group: {} {} {} (its play group full)\n", resref::bytes{ r = &new_name }, what, resref::bytes{ r = &old_name })
            } else if e.stolen {
                let mut old_name = name_of{ a = &a, tag = e.old_tag }
                _ = @fmt(&w.io, "sound steal: {} (priority {}) took the voice of {} (priority {}, looping {}, {} s in)\n", resref::bytes{ r = &new_name }, e.priority,
                    resref::bytes{ r = &old_name }, e.old_priority, e.old_looping, e.old_played)
            } else {
                _ = @fmt(&w.io, "sound refused: {} (priority {}): no voice\n", resref::bytes{ r = &new_name }, e.priority)
            }
        }
    }

    fn name_of { a: *Ambience, tag: u32 } -> resref::ResRef {
        let names = list::items{ list = a.names }
        if tag == 0 or @as(usize, tag) > names.len { return resref::truncate{ name = "(stream)" } }
        return names[tag - 1]
    }

    // Frees a stream's bytes. The mixer (on its own thread) may be reading them: any voice that
    // still does ends first (mix.ctx, the memory rule).
    fn stop_bytes { mut a: Ambience, bytes: []mut u8 } {
        mix::release{ m = a.m, bytes }
        if bytes.len > 0 { _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = a.heap, mem = bytes, count = 0 } }
    }

    // Stops every sound of the area being left and forgets its sound objects (the waves stay
    // cached in the heap; ours: a module's are few).
    fn stop_area { mut a: Ambience } {
        mix::stop_all{ m = a.m, group = null, fade = 0.0 }
        stop_bytes{ &a, bytes = a.music_bytes }
        a.music_bytes = slice::empty(u8){}
        stop_bytes{ &a, bytes = a.ambient_bytes }
        a.ambient_bytes = slice::empty(u8){}
        stop_bytes{ &a, bytes = a.stinger_bytes }
        a.stinger_bytes = slice::empty(u8){}
        a.music_wait = -1.0
        list::clear{ list = &a.placed }
        list::clear{ list = &a.excited }
    }

    // The sound modes (CExoSoundInternal::SetSoundMode 0x005d8560; docs/re/app.md, "Sound modes"):
    // what the screen on top does to the world's sounds. In a pause (mode 2: the player's pause)
    // every sound stops but the stingers', the music's, the ambient bed's and the GUI's (rows 1, 2,
    // 4, 11); behind a menu screen (mode 4: the in-game menu, a store, the galaxy map, the party
    // selection, the upgrade bench) the ambient bed stops too. Leaving the mode lets them go on.
    // Mode 1 (fade_before_load) turns the ambient bed and the global one-shots (rows 4 and 21)
    // down over 500 ms before a saved game loads in the game, linearly in time, and leaving it turns
    // them up again from silence over 500 ms (0x005d6a10 / 0x005d6a50, CExoSoundInternal::Update).
    // Mode 3 (a film, a save being written, a loading screen without load music) stops every sound.
    // Modes 5 and 6 are not a screen's: the window losing and regaining activation (suspend).
    const MODE_PLAY: u8 = 0
    const MODE_FADE: u8 = 1
    const MODE_PAUSE: u8 = 2
    const MODE_MOVIE: u8 = 3
    const MODE_MENU: u8 = 4
    const KEEP_PAUSE: u32 = (1 << ROW_STINGERS) | (1 << ROW_MUSIC) | (1 << ROW_AREA_AMBIENT) | (1 << ROW_GUI)
    const KEEP_MENU: u32 = (1 << ROW_STINGERS) | (1 << ROW_MUSIC) | (1 << ROW_GUI)
    const ROW_SINGLE_SHOT_GLOBAL: u32 = 21
    const FADE_ROWS: u32 = (1 << ROW_AREA_AMBIENT) | (1 << ROW_SINGLE_SHOT_GLOBAL)
    const FADE_SECONDS: f32 = 0.5

    // Returns how many sounds it stopped.
    fn set_mode { mut a: Ambience, mode: u8 } -> u32 {
        if mode == a.mode { return 0 }
        if a.mode == MODE_FADE {
            mix::fade_rows{ m = a.m, rows = FADE_ROWS, level = 0.0, seconds = 0.0 }
            mix::fade_rows{ m = a.m, rows = FADE_ROWS, level = 1.0, seconds = FADE_SECONDS }
        }
        // While the window is inactive everything stays stopped: the new mode is applied when it comes back.
        if a.suspended {
            a.mode = mode
            if mode == MODE_FADE { mix::fade_rows{ m = a.m, rows = FADE_ROWS, level = 0.0, seconds = FADE_SECONDS } }
            return 0
        }
        if a.mode == MODE_PAUSE or a.mode == MODE_MOVIE or a.mode == MODE_MENU { mix::release_world{ m = a.m } }
        a.mode = mode
        return apply_mode{ &a }
    }

    // What entering the mode does (SetSoundMode's tail: 0x005d6a10 for 1, 0x005d82c0(0) for 2, 3 and 4).
    fn apply_mode { mut a: Ambience } -> u32 {
        if a.mode == MODE_FADE { mix::fade_rows{ m = a.m, rows = FADE_ROWS, level = 0.0, seconds = FADE_SECONDS } }
        if a.mode == MODE_PAUSE { return mix::hold_world{ m = a.m, keep = KEEP_PAUSE } }
        if a.mode == MODE_MOVIE { return mix::hold_world{ m = a.m, keep = 0 } }
        if a.mode == MODE_MENU { return mix::hold_world{ m = a.m, keep = KEEP_MENU } }
        return 0
    }

    // Modes 5 and 6 (OnAppDeactivate 0x00401d90, OnAppActivate 0x00401e00): the window lost activation,
    // every sound stops and any started meanwhile is stopped at once (0x005d82c0(1), +0x144); it came back,
    // everything goes on and the mode on top is applied again (its stack popped and pushed back). (The
    // original's 5 spares a pause's or a menu's exempt sources, not its streams; ours stops all.) Returns
    // how many sounds it stopped.
    fn suspend { mut a: Ambience, on: bool } -> u32 {
        if on == a.suspended { return 0 }
        a.suspended = on
        if on { return mix::suspend_world{ m = a.m, on = true } }
        _ = mix::suspend_world{ m = a.m, on = false }
        return apply_mode{ &a }
    }

    // The area's music and ambient bed, and a player for each sound object.
    fn start_area { mut a: Ambience, mut w: world::World } {
        apply_limits{ m = a.m, w = &w }
        let ao = world::object{ w = &w, id = w.area } ifnull { return }
        let area = obj::area{ o = ao } ifnull { return }
        a.music_delay = @as(f32, area.music_delay) / 1000.0
        a.bg_off = false
        a.battle = false
        a.ambient_off = false
        list::clear{ list = &a.excited }
        a.battle_clock = clock::now_ms{ c = w.clock }
        play_music{ &a, &w, row = background_row{ area } }
        start_ambient{ &a, &w }
        let all = list::items{ list = w.objects.all }
        let mut i: usize = 0
        while i < all.len {
            let o = all[i]
            i = i + 1
            if o.kind != obj::Kind::sound or o.destroyed { continue }
            list::push{ list = &a.placed, item = Placed{ id = o.id, handle = mix::Handle{ slot = 0, id = 0 }, wait = random{ &a } * 2.0, next = 0, playing = false, started = false } } iferr {}
        }
    }

    // Starts ambientmusic.2da row `row` (stopping what plays); row 0 or a blank resource: silence.
    fn play_music { mut a: Ambience, mut w: world::World, row: i32 } {
        mix::stop{ m = a.m, h = a.music, fade = 0.0 }      // its bytes go next: a fade would read them freed
        stop_bytes{ &a, bytes = a.music_bytes }
        a.music_bytes = slice::empty(u8){}
        a.music_wait = -1.0
        if row <= 0 { return }
        let name = twoda::get_string{ t = w.tables.ambientmusic, row = @as(usize, row), column = "resource" } ifnull ""
        a.music_bytes = read_stream{ &a, &w, name }
        if a.music_bytes.len == 0 { return }
        // prioritygroups.2da's Streams_Music volume, 64 of 127 (audio.md).
        a.music = mix::play{ m = a.m, bytes = a.music_bytes, p = stream_params{ w = &w, row = ROW_MUSIC } } iferr { mix::Handle{ slot = 0, id = 0 } }
        a.started = a.started + 1
        if w.log.module {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "music {} ({} bytes)\n", name, a.music_bytes.len)
        }
    }

    // ---- what scripts change (MusicBackgroundPlay and its relatives, AmbientSoundPlay, SoundObject*)
    //
    // The routines have already changed the area's rows and the sound object's fields; these make
    // the sound follow. The state they keep is three flags: a script stopped the background music
    // (bg_off), the battle track plays instead of it (battle), a script stopped the ambient bed
    // (ambient_off). start_area clears them.

    // The row of ambientmusic.2da the area plays in the background at this time of day (0: none).
    fn background_row { area: *obj::Area } -> i32 {
        return if area.is_night { area.music_night } else { area.music_day }
    }

    fn area_of { w: *world::World } -> ?*mut obj::Area {
        let ao = world::object{ w, id = w.area } ifnull { return null }
        return obj::area{ o = ao }
    }

    // Switches the music to ambientmusic.2da row `row` (play_music stops the old track at once:
    // it gives its bytes back).
    fn change_music { mut a: Ambience, mut w: world::World, row: i32 } {
        play_music{ &a, &w, row }
    }

    // The area's ambient bed for the time of day (ambientsound.2da's resource, looping at the
    // area's volume out of 127), replacing the one playing.
    fn start_ambient { mut a: Ambience, mut w: world::World } {
        mix::stop{ m = a.m, h = a.ambient, fade = 0.0 }
        stop_bytes{ &a, bytes = a.ambient_bytes }
        a.ambient_bytes = slice::empty(u8){}
        let area = area_of{ w = &w } ifnull { return }
        let row = if area.is_night { area.ambient_night } else { area.ambient_day }
        let volume = if area.is_night { area.ambient_night_volume } else { area.ambient_day_volume }
        let bed = twoda::get_string{ t = w.tables.ambientsound, row = @as(usize, if row < 0 { 0 } else { row }), column = "resource" } ifnull ""
        a.ambient_bytes = read_stream{ &a, &w, name = bed }
        if a.ambient_bytes.len == 0 { return }
        // The area's AmbientSndDayVol / NightVol as the stream's own volume, times row 4's 95 (stream_params).
        let mut p = stream_params{ w = &w, row = ROW_AREA_AMBIENT }
        p.volume = p.volume * @as(f32, volume) / 127.0
        p.looping = true
        a.ambient = mix::play{ m = a.m, bytes = a.ambient_bytes, p } iferr { mix::Handle{ slot = 0, id = 0 } }
        a.started = a.started + 1
    }

    // MusicBackgroundPlay / MusicBackgroundStop. The track that plays when a battle ends is this one.
    fn background_music { mut a: Ambience, mut w: world::World, play: bool } {
        let was_off = a.bg_off
        a.bg_off = not play
        if a.battle { return }
        if not play {
            change_music{ &a, &w, row = 0 }
            return
        }
        // Already on: leave it be, it would only start over.
        if not was_off and a.music_bytes.len > 0 { return }
        let area = area_of{ w = &w } ifnull { return }
        change_music{ &a, &w, row = background_row{ area } }
    }

    // MusicBattlePlay / MusicBattleStop: the area's battle track instead of the background one
    // (an area without one keeps its background music), and the background one again after, with the
    // battle track's stinger over it (the client's 0x0068e610, re/combat.md 3.6).
    fn battle_music { mut a: Ambience, mut w: world::World, play: bool } {
        let area = area_of{ w = &w } ifnull { return }
        if play {
            if a.battle or area.music_battle <= 0 { return }
            a.battle = true
            if w.log.module {
                world::prefix{ w = &w }
                _ = @fmt(&w.io, "battle music on\n")
            }
            change_music{ &a, &w, row = area.music_battle }
            return
        }
        if not a.battle { return }
        a.battle = false
        if w.log.module {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "battle music off\n")
        }
        change_music{ &a, &w, row = if a.bg_off { 0 } else { background_row{ area } } }
        play_stinger{ &a, &w, row = area.music_battle }
    }

    // One of the row's stingers (ambientmusic.2da stinger1..3, files of streamsounds/) at the music
    // stingers' volume (prioritygroups.2da Music_Stingers: 64 of 127), picked at random among those
    // the row names. One plays at a time.
    fn play_stinger { mut a: Ambience, mut w: world::World, row: i32 } {
        if row <= 0 { return }
        let mut names: [3][]u8 = ["", "", ""]
        let columns: [3][]u8 = ["stinger1", "stinger2", "stinger3"]
        let mut n: usize = 0
        let mut i: usize = 0
        while i < 3 {
            let name = twoda::get_string{ t = w.tables.ambientmusic, row = @as(usize, row), column = columns[i] } ifnull ""
            if name.len > 0 and not slice::eq_bytes{ a = name, b = "****" } {
                names[n] = name
                n = n + 1
            }
            i = i + 1
        }
        if n == 0 { return }
        let name = names[@as(usize, random{ &a } * @as(f32, n)) % n]
        mix::stop{ m = a.m, h = a.stinger, fade = 0.0 }
        stop_bytes{ &a, bytes = a.stinger_bytes }
        a.stinger_bytes = read_stinger{ &a, &w, name }
        if a.stinger_bytes.len == 0 { return }
        a.stinger = mix::play{ m = a.m, bytes = a.stinger_bytes, p = stream_params{ w = &w, row = ROW_STINGERS } } iferr { mix::Handle{ slot = 0, id = 0 } }
        a.started = a.started + 1
        if w.log.module {
            world::prefix{ w = &w }
            _ = @fmt(&w.io, "stinger {} ({} bytes)\n", name, a.stinger_bytes.len)
        }
    }

    // A file from streamsounds/ in the heap; empty if there is none.
    fn read_stinger { mut a: Ambience, mut w: world::World, name: []u8 } -> []mut u8 {
        let path = res::sound_path(heap::Heap){ rm = w.rm.*, name, realloc = heap::alloc, heap = a.heap } iferr { return slice::empty(u8){} }
        defer _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = a.heap, mem = path, count = 0 }
        return fs::read_all(heap::Heap){ fs = &w.fs, heap = a.heap, realloc = heap::alloc, path } iferr { slice::empty(u8){} }
    }

    // ---- the fights themselves (re/combat.md 3.6, "Battle music")
    //
    // Nothing in the scripts plays the battle track of an ordinary fight: the engine does. Every hostile
    // act stirs the creatures it concerns up for excitedduration.2da's 10 s (CSWSCreature 0x004f3580,
    // from SignalCombatWith's pull-in: fight::pull_in counts each one's stirs, the creature and its
    // faction-mates within 30 m for the party or their sight range for others), and a creature so
    // stirred that perceives a hostile creature within 30 m turns the area's battle music on. An attack
    // stirs no one as it starts (the attacker signals only itself), so the music starts at its first
    // impact, or at damage. When one such creature's 10 s run out, the battle music goes off
    // (0x004ed110, from the creature's update), and with it a stinger; the next hostile act turns it on
    // again.

    const EXCITED_MS: i32 = 10000
    const HOSTILE_RANGE: f32 = 30.0
    const BATTLE_REPLAY_S: f32 = 1.0    // the battle track starts over a second after it ends

    // Whether `o` perceives a living creature hostile to it within 30 m (GetNearestEnemy 0x004f2de0: its
    // perception list's seen entries).
    fn hostile_near { w: *world::World, o: *obj::Object } -> bool {
        let all = list::items{ list = w.objects.all }
        let mut i: usize = 0
        while i < all.len {
            let h = all[i]
            i = i + 1
            if h.id == o.id or h.kind != obj::Kind::creature or h.area != w.area or h.destroyed { continue }
            let hc = obj::creature{ o = h } ifnull { continue }
            if hc.dead or h.hp < 1 { continue }
            if world::standing{ w, from = o.faction, toward = h.faction } >= 11 { continue }
            if math::vec3::distance{ a = o.position, b = h.position } > HOSTILE_RANGE { continue }
            let seen = perception::entry_of{ w, viewer = o.id, target = h.id } ifnull { continue }
            if seen.seen { return true }
        }
        return false
    }

    // Drops a record (the last takes its place).
    fn forget_excited { mut a: Ambience, index: usize } {
        let n = a.excited.len
        if index + 1 < n {
            let items = list::items{ list = a.excited }
            items[index] = items[n - 1]
        }
        _ = list::pop{ list = &a.excited }
    }

    // Once a frame: finds the creatures a hostile act stirred up since the last look, switches the
    // battle music on for those with an enemy near, and runs the 10 s down.
    fn update_battle { mut a: Ambience, mut w: world::World } {
        let now = clock::now_ms{ c = w.clock }
        let elapsed: i32 = if now > a.battle_clock { @as(i32, now - a.battle_clock) } else { 0 }
        a.battle_clock = now
        if elapsed <= 0 { return }
        let all = list::items{ list = w.objects.all }
        let mut i: usize = 0
        while i < all.len {
            let o = all[i]
            i = i + 1
            if o.kind != obj::Kind::creature or o.area != w.area or o.destroyed { continue }
            let c = obj::creature{ o } ifnull { continue }
            if c.dead { continue }
            let f = c.fighter ifnull { continue }
            // Its record, if it has one.
            let recs = list::items{ list = a.excited }
            let mut at: usize = recs.len
            let mut k: usize = 0
            while k < recs.len {
                if recs[k].id == o.id { at = k }
                k = k + 1
            }
            if f.stirs == 0 and at == recs.len { continue }
            // Stirred since the last look (a creature seen for the first time counts while it is in
            // combat: its record went with an earlier visit to another area).
            let fresh = if at == recs.len { f.combat_ms > 0 } else { f.stirs != recs[at].stirs }
            if at == recs.len {
                list::push{ list = &a.excited, item = Excited{ id = o.id, ms = 0, stirs = f.stirs } } iferr { continue }
            }
            let now_recs = list::items{ list = a.excited }
            now_recs[at].stirs = f.stirs
            if not fresh { continue }
            if now_recs[at].ms < EXCITED_MS { now_recs[at].ms = EXCITED_MS }
            if hostile_near{ w = &w, o } { battle_music{ &a, &w, play = true } }
        }
        // The countdowns: a creature that is gone or dead no longer counts down (its update stops).
        let mut r: usize = 0
        while r < a.excited.len {
            let recs = list::items{ list = a.excited }
            let o = world::object{ w = &w, id = recs[r].id }
            let mut alive = false
            if o != null {
                if obj::creature{ o } is some{ value = c } { alive = not o.destroyed and o.area == w.area and not c.dead }
            }
            if not alive {
                forget_excited{ &a, index = r }
                continue
            }
            if recs[r].ms > 0 {
                recs[r].ms = recs[r].ms - elapsed
                if recs[r].ms <= 0 {
                    recs[r].ms = 0
                    battle_music{ &a, &w, play = false }
                }
            }
            r = r + 1
        }
    }

    // A music row of the area changed: the sound follows if that is the track it plays now.
    fn music_changed { mut a: Ambience, mut w: world::World, kind: outbox::Music, row: i32 } {
        let area = area_of{ w = &w } ifnull { return }
        if kind == outbox::Music::battle {
            if a.battle { change_music{ &a, &w, row } }
            return
        }
        if a.battle or a.bg_off { return }
        let night = kind == outbox::Music::night
        if night == area.is_night { change_music{ &a, &w, row } }
    }

    // AmbientSoundPlay / AmbientSoundStop.
    fn ambient_bed { mut a: Ambience, mut w: world::World, play: bool } {
        a.ambient_off = not play
        if play { start_ambient{ &a, &w } } else {
            mix::stop{ m = a.m, h = a.ambient, fade = 0.0 }
            stop_bytes{ &a, bytes = a.ambient_bytes }
            a.ambient_bytes = slice::empty(u8){}
        }
    }

    // An ambient row or volume of the area changed: the bed follows if it is the one playing.
    fn ambient_changed { mut a: Ambience, mut w: world::World, night: bool } {
        let area = area_of{ w = &w } ifnull { return }
        if a.ambient_off or night != area.is_night { return }
        start_ambient{ &a, &w }
    }

    // SoundObjectSetVolume: a sound playing now takes the new volume (out of 127).
    fn set_sound_volume { mut a: Ambience, id: u32, volume: i32 } {
        let placed = list::items{ list = a.placed }
        let mut i: usize = 0
        while i < placed.len {
            if placed[i].id == id { mix::set_volume{ m = a.m, h = placed[i].handle, volume = @as(f32, volume) / 127.0 } }
            i = i + 1
        }
    }

    // SoundObjectFadeAndStop (SoundObjectStop is the same with a short fade).
    fn fade_sound { mut a: Ambience, id: u32, seconds: f32 } {
        let placed = list::items{ list = a.placed }
        let mut i: usize = 0
        while i < placed.len {
            if placed[i].id == id {
                mix::stop{ m = a.m, h = placed[i].handle, fade = seconds }
                placed[i].playing = false
            }
            i = i + 1
        }
    }

    // A wave's length in ms as its header says (0 for an MP3, whose header doesn't).
    fn length_ms { bytes: []u8 } -> u64 {
        let info = wav::probe{ bytes } iferr { return 0 }
        if info.rate == 0 { return 0 }
        return info.frames * 1000 / @as(u64, info.rate)
    }

    // One outbox note, if it is a sound.
    fn take { mut a: Ambience, mut w: world::World, note: outbox::Note } {
        match note {
            play_sound{ name, object, position, positional, group } => {
                let bytes = wave{ &a, &w, name }
                if w.log.sound {
                    world::prefix{ w = &w }
                    let mut shown = name
                    let missing: []u8 = if bytes.len == 0 { " (missing)" } else { "" }
                    _ = @fmt(&w.io, "sound play {} row {}{}\n", resref::bytes{ r = &shown }, group, missing)
                }
                if bytes.len == 0 { return }
                let kind = volume_group{ row = @as(u32, group) }
                let mut p = if positional { mix::sound_3d{ group = kind, volume = 1.0, position, min_distance = 3.0, max_distance = 30.0 } } else { mix::sound_2d{ group = kind, volume = 1.0 } }
                p.tag = tag_of{ a = &a, name }
                p.priority = priority_of{ w = &w, row = @as(u32, group) }
                p.volume = loudness{ a = &a, w = &w, volume = 1.0, row = @as(u32, group), positional }
                p.play_group = group
                p.squared = positional
                _ = mix::play{ m = a.m, bytes, p } iferr { mix::Handle{ slot = 0, id = 0 } }
                a.started = a.started + 1
                // An opening container's panel waits for its Opened sound too (the length
                // PlayVoiceStream returns to USEOBJECT, 0x0057e8c0).
                if object != obj::INVALID { container::hold_opening{ &w, placeable = object, ms = length_ms{ bytes } } }
            }
            sound_object{ id, play, volume } => {
                if volume >= 0 {
                    set_sound_volume{ &a, id, volume }
                } else if not play {
                    fade_sound{ &a, id, seconds = 0.2 }
                }
            }
            sound_fade{ id, seconds } => { fade_sound{ &a, id, seconds } }
            music{ kind, play } => {
                if kind == outbox::Music::battle { battle_music{ &a, &w, play } } else { background_music{ &a, &w, play } }
            }
            music_row{ kind, row } => { music_changed{ &a, &w, kind, row } }
            ambient{ play } => { ambient_bed{ &a, &w, play } }
            ambient_row{ night } => { ambient_changed{ &a, &w, night } }
            else => {}
        }
    }

    // Moves the listener to the camera, replays the music after its delay, and runs the sound
    // objects' schedules.
    fn update { mut a: Ambience, mut w: world::World, eye: math::Vec3, forward: math::Vec3, dt: f32 } {
        mix::set_listener{ m = a.m, position = eye, forward, up = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 } }
        a.listener = eye
        if a.music_bytes.len > 0 and not mix::is_playing{ m = a.m, h = a.music } {
            if a.music_wait < 0.0 { a.music_wait = if a.battle { BATTLE_REPLAY_S } else { a.music_delay } } else {
                a.music_wait = a.music_wait - dt
                if a.music_wait <= 0.0 {
                    a.music = mix::play{ m = a.m, bytes = a.music_bytes, p = stream_params{ w = &w, row = ROW_MUSIC } } iferr { mix::Handle{ slot = 0, id = 0 } }
                    a.music_wait = -1.0
                }
            }
        }
        update_battle{ &a, &w }
        if w.log.sound { report_events{ &a, &w } }
        if a.stinger_bytes.len > 0 and not mix::is_playing{ m = a.m, h = a.stinger } {
            stop_bytes{ &a, bytes = a.stinger_bytes }
            a.stinger_bytes = slice::empty(u8){}
        }
        let placed = list::items{ list = a.placed }
        let mut i: usize = 0
        while i < placed.len {
            update_placed{ &a, &w, p = &placed[i], dt }
            i = i + 1
        }
    }

    fn update_placed { mut a: Ambience, mut w: world::World, p: *mut Placed, dt: f32 } {
        let o = world::object{ w = &w, id = p.id } ifnull { return }
        let s = obj::sound{ o } ifnull { return }
        if not s.active or s.sounds.len == 0 { return }
        if s.continuous {
            if p.playing and mix::is_playing{ m = a.m, h = p.handle } {
                // Out of earshot, a loop gives its voice back and starts again on the way back in (as the original's
                // CExoSoundInternal::Update, docs/re/app.md "Voices"; the 4 m between the two is ours, against flapping).
                if s.positional and math::vec3::distance{ a = o.position, b = a.listener } > s.max_distance + 6.0 {
                    mix::stop{ m = a.m, h = p.handle, fade = 0.1 }
                    p.playing = false
                    return
                }
                // A script changing the pitch of a running loop (the swoop engine sounds follow the gears).
                if s.fixed_variance > 0.0 { mix::set_pitch{ m = a.m, h = p.handle, pitch = s.fixed_variance } }
                return
            }
            if s.positional and math::vec3::distance{ a = o.position, b = a.listener } > s.max_distance + 2.0 { return }
            p.handle = start_one{ &a, &w, s, o, index = 0, looping = true, first = not p.started }
            p.playing = mix::is_playing{ m = a.m, h = p.handle }
            if p.playing { p.started = true }
            return
        }
        if mix::is_playing{ m = a.m, h = p.handle } { return }
        p.wait = p.wait - dt
        if p.wait > 0.0 { return }
        // Out of earshot: try again in a second (ours: no voice for what can't be heard).
        if s.positional and math::vec3::distance{ a = o.position, b = a.listener } > s.max_distance {
            p.wait = 1.0
            return
        }
        let index = if s.random { @as(usize, random{ &a } * @as(f32, s.sounds.len)) % s.sounds.len } else { p.next % s.sounds.len }
        p.next = index + 1
        p.handle = start_one{ &a, &w, s, o, index, looping = false, first = true }
        let variation = @as(f32, s.interval_variation) * (random{ &a } * 2.0 - 1.0)
        p.wait = math::max{ a = (@as(f32, s.interval) + variation) / 1000.0, b = 1.0 }
        if not s.looping and not s.continuous and index + 1 >= s.sounds.len and not s.random { s.active = false }
    }

    // `first`: not a loop coming back after it lost its voice or went out of earshot (the original parks
    // those and starts them again only when their group has room, never interrupting).
    fn start_one { mut a: Ambience, mut w: world::World, s: *obj::Sound, o: *obj::Object, index: usize, looping: bool, first: bool } -> mix::Handle {
        let bytes = wave{ &a, &w, name = s.sounds[index] }
        let none = mix::Handle{ slot = 0, id = 0 }
        if bytes.len == 0 { return none }
        let volume = loudness{ a = &a, w = &w, volume = @as(f32, s.volume) / 127.0, row = s.priority, positional = s.positional }
        let kind = volume_group{ row = s.priority }
        let mut p = if s.positional {
            let mut at = o.position
            at.z = at.z + s.elevation
            mix::sound_3d{ group = kind, volume, position = at, min_distance = s.min_distance, max_distance = s.max_distance }
        } else { mix::sound_2d{ group = kind, volume } }
        p.looping = looping
        p.squared = s.positional
        if s.priority < 255 { p.play_group = @trunc(u8, s.priority) }
        p.may_interrupt = first
        p.tag = tag_of{ a = &a, name = s.sounds[index] }
        p.priority = priority_of{ w = &w, row = s.priority }
        // SoundObjectSetFixedVariance: a constant multiplier on the sound's pitch.
        if s.fixed_variance > 0.0 { p.pitch = s.fixed_variance }
        if w.log.sound {
            world::prefix{ w = &w }
            let mut name = s.sounds[index]
            _ = @fmt(&w.io, "sound object {}: {} row {} volume {} positional {} looping {}\n", o.id, resref::bytes{ r = &name }, s.priority, p.volume, s.positional, looping)
        }
        let h = mix::play{ m = a.m, bytes, p } iferr { return none }
        a.started = a.started + 1
        return h
    }
}
