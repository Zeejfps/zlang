// The Ebon Hawk's gunner turret (docs/re/minigames-swoop-turret.md 4.3 to 4.5): where the guns
// sit on the vehicles, the player's aim, bullets, the enemies' fire, and the hits. The run
// (run.ctx) holds the state; the host (game/minigame*.ctx) shows it and plays the sounds.
//
// The turret does not move along its rail: the player's offset is two angles, `x` the pitch up
// from the horizon and `z` the yaw (counter-clockwise from above), and every model flagged
// rotating (the turret, the cockpit's HUD, the camera) is turned by them about the track's
// `modelhook`. The Hawk's own model stays put. A shot leaves the muzzle (node `bullethook` of the
// gun model, which hangs on the vehicle's node `gunbank<id>`) along the muzzle's +Y.
namespace mg {
    const MAX_BULLETS: usize = 96
    const MAX_SOUNDS: usize = 32

    // The mouse: counts per frame over this make a full-speed turn (the original's 20).
    const MOUSE_DIVISOR: f32 = 20.0
    // Bullets hit what their path touches within this many units of a model's hit mesh.
    const BULLET_RADIUS: f32 = 1.0
    // A bullet's explosion lasts as long as its model's `explode` animation; this if it has none.
    const EXPLODE_FALLBACK: f32 = 0.5

    // How one bank of a vehicle is built, read from the models once.
    struct BankGear {
        ready: bool,
        rotating: bool,                 // the model carrying the gun bank turns with the aim
        mount: math::Mat4,              // node gunbank<id> in that model
        muzzle: math::Mat4,             // node bullethook in the gun model
        event_time: f32,                // seconds after `fire` starts that the gun's `fire<id>` event spawns the bullet
        fire_length: f32,               // the gun's `fire` animation
        explode_length: f32,            // the bullet model's `explode` animation
    }

    // What a vehicle's models give the run.
    struct Gear {
        banks: [4]BankGear,
        has_box: bool,
        box: math::Aabb,                // the `hitbullet` mesh in its model's space
        box_rotating: bool,
        die_length: f32,                // the longest `die` animation of its models
    }

    // One bank's trigger: the cooldown to the next shot and the shot in progress (the gun is
    // playing `fire`; its bullet leaves when the animation reaches the event).
    struct GunState { cooldown: f32, firing: bool, t: f32, spawned: bool }

    struct Bullet {
        live: bool,
        owner: usize,                   // the object that fired it
        bank: usize,
        serial: u32,                    // which shot, so the host can tell a new bullet in a used slot
        position: math::Vec3, previous: math::Vec3, direction: math::Vec3,
        speed: f32, life: f32,
        damage: i32, target: u32,       // target: bit 1 the player's side, bit 2 the enemies
        model: resref::ResRef, hit_sound: resref::ResRef,
        exploding: bool, explode_left: f32,
    }

    // A sound for the host to play: a resource name, a volume 0..1, and where, if it has a place.
    struct Sound { name: resref::ResRef, volume: f32, positional: bool, position: math::Vec3 }

    fn no_bank_gear {} -> BankGear {
        return BankGear{
            ready = false, rotating = false, mount = math::mat4::identity{}, muzzle = math::mat4::identity{},
            event_time = 0.0, fire_length = 0.0, explode_length = EXPLODE_FALLBACK,
        }
    }

    fn no_gear {} -> Gear {
        return Gear{ banks = [no_bank_gear{}; 4], has_box = false, box = math::aabb::empty{}, box_rotating = false, die_length = 0.0 }
    }

    fn no_gun {} -> GunState { return GunState{ cooldown = 0.0, firing = false, t = 0.0, spawned = false } }

    fn no_bullet {} -> Bullet {
        return Bullet{
            live = false, owner = 0, bank = 0, serial = 0, position = math::vec3::zero{}, previous = math::vec3::zero{},
            direction = math::Vec3{ x = 0.0, y = 1.0, z = 0.0 }, speed = 0.0, life = 0.0, damage = 0, target = 0,
            model = resref::empty{}, hit_sound = resref::empty{}, exploding = false, explode_left = 0.0,
        }
    }

    // ---- reading the models

    // The node called `prefix` and the digit `n`.
    fn find_numbered { model: *mdl::Model, prefix: []u8, n: u32 } -> ?u32 {
        let mut buf: [24]u8
        let mut i: usize = 0
        while i < prefix.len and i < 20 {
            buf[i] = prefix[i]
            i = i + 1
        }
        buf[i] = '0' + @trunc(u8, n % 10)
        return mdl::find_node{ model, name = buf[..i + 1] }
    }

    // The model a resource name in the area's data names. (A pointer: the lookup's answer lives
    // in the model cache, not in the name.)
    fn model_named { lookup: &fn{ name: []u8 } -> ?*mdl::Model, r: *resref::ResRef } -> ?*mdl::Model {
        if resref::is_empty{ r = r.* } { return null }
        return lookup{ name = resref::bytes{ r } }
    }

    // The box of one node's mesh in its model's bind pose.
    fn node_box { model: *mdl::Model, pose: mdl_anim::Pose, node: u32 } -> math::Aabb {
        let mut box = math::aabb::empty{}
        let mi = model.nodes[node].mesh ifnull { return box }
        let mesh = &model.meshes[mi]
        let m = pose.world[node]
        let mut v: usize = 0
        while v + 2 < mesh.positions.len {
            box = math::aabb::extend{ b = box, p = math::mat4::transform_point{ m, p = math::Vec3{ x = mesh.positions[v], y = mesh.positions[v + 1], z = mesh.positions[v + 2] } } }
            v = v + 3
        }
        return box
    }

    // The gun bank mounts, the hit mesh and the death of one of a follower's models.
    fn gear_from_model(S) {
        realloc: alloc::Fn(S), mut heap: S, mut g: Gear, f: *Follower, model: *mdl::Model, rotating: bool,
        lookup: &fn{ name: []u8 } -> ?*mdl::Model,
    } -> ! {
        let pose = try mdl_anim::make_pose(S){ realloc, &heap, model }
        mdl_anim::reset{ model, pose }
        mdl_anim::finish{ model, pose }
        let mut b: usize = 0
        while b < f.bank_count {
            if not g.banks[b].ready {
                if find_numbered{ model, prefix = "gunbank", n = f.banks[b].id } is some{ value = node } {
                    g.banks[b].mount = pose.world[node]
                    g.banks[b].rotating = rotating
                    g.banks[b].ready = true
                }
            }
            b = b + 1
        }
        if not g.has_box {
            if mdl::find_node{ model, name = "hitbullet" } is some{ value = node } {
                let box = node_box{ model, pose, node }
                if not math::aabb::is_empty{ b = box } {
                    g.box = box
                    g.has_box = true
                    g.box_rotating = rotating
                }
            }
        }
        if mdl_anim::find{ model, name = "die", lookup } is some{ value = found } {
            g.die_length = math::max{ a = g.die_length, b = found.animation.length }
        }
    }

    // The muzzle of a bank's gun model, the time of its shot in the `fire` animation, and how
    // long the bullet's explosion runs.
    fn bank_from_models(S) {
        realloc: alloc::Fn(S), mut heap: S, mut bg: BankGear, bank: *Bank, lookup: &fn{ name: []u8 } -> ?*mdl::Model,
    } -> ! {
        if model_named{ lookup, r = &bank.gun_model } is some{ value = gun } {
            let pose = try mdl_anim::make_pose(S){ realloc, &heap, model = gun }
            mdl_anim::reset{ model = gun, pose }
            mdl_anim::finish{ model = gun, pose }
            let node = find_numbered{ model = gun, prefix = "bullethook", n = bank.id } ifnull { find_numbered{ model = gun, prefix = "bullethook", n = 0 } }
            if node is some{ value = nd } { bg.muzzle = pose.world[nd] }
            if mdl_anim::find{ model = gun, name = "fire", lookup } is some{ value = found } {
                bg.fire_length = found.animation.length
                let events = found.animation.events
                let mut i: usize = 0
                while i < events.len {
                    if ci::starts_with{ s = events[i].name, prefix = "fire" } {
                        bg.event_time = events[i].time
                        break
                    }
                    i = i + 1
                }
            }
        }
        if model_named{ lookup, r = &bank.bullet_model } is some{ value = shot } {
            if mdl_anim::find{ model = shot, name = "explode", lookup } is some{ value = found } {
                if found.animation.length > 0.0 { bg.explode_length = found.animation.length }
            }
        }
    }

    // What the models of follower `f` give the run.
    fn make_gear(S) {
        realloc: alloc::Fn(S), mut heap: S, f: *Follower, lookup: &fn{ name: []u8 } -> ?*mdl::Model,
    } -> !Gear {
        let mut g = no_gear{}
        let mut m: usize = 0
        while m < f.model_count {
            if model_named{ lookup, r = &f.models[m].name } is some{ value = model } {
                try gear_from_model(S){ realloc, &heap, &g, f, model, rotating = f.models[m].rotating, lookup }
            }
            m = m + 1
        }
        let mut b: usize = 0
        while b < f.bank_count {
            try bank_from_models(S){ realloc, &heap, bg = &g.banks[b], bank = &f.banks[b], lookup }
            b = b + 1
        }
        return g
    }

    // ---- places

    // The turning of the aim: yaw about the vertical after pitch about the model's X axis.
    fn turret_rotation { offset: math::Vec3 } -> math::Mat4 {
        let pitch = math::quat::from_axis_angle{ axis = math::Vec3{ x = 1.0, y = 0.0, z = 0.0 }, angle = math::radians{ degrees = offset.x } }
        let yaw = math::quat::from_axis_angle{ axis = math::Vec3{ x = 0.0, y = 0.0, z = 1.0 }, angle = math::radians{ degrees = offset.z } }
        return math::mat4::mul{ a = math::mat4::rotation{ q = yaw }, b = math::mat4::rotation{ q = pitch } }
    }

    // Where one of an object's models stands: the player's rotating models turn with the aim in
    // a turret and are displaced by the offset in a race; everything else is at its rail's point.
    fn part_matrix { run: *Run, n: usize, rotating: bool } -> math::Mat4 {
        let o = &run.objs[n]
        if o.kind == ObjKind::player {
            if run.area.kind != TURRET { return player_matrix{ run } }
            let base = follower_matrix{ run, o }
            if rotating { return math::mat4::mul{ a = base, b = turret_rotation{ offset = run.offset } } }
            return base
        }
        return follower_matrix{ run, o }
    }

    fn follower_of { run: *Run, n: usize } -> *mut Follower {
        let o = &run.objs[n]
        if o.kind == ObjKind::player { return &run.area.player }
        return &run.area.enemies[o.index]
    }

    // What the enemies shoot at: the middle of the Hawk's hit mesh.
    fn target_point { run: *Run } -> math::Vec3 {
        let g = &run.gears[PLAYER]
        if not g.has_box { return run.objs[PLAYER].position }
        return math::mat4::transform_point{ m = part_matrix{ run, n = PLAYER, rotating = g.box_rotating }, p = math::aabb::center{ b = g.box } }
    }

    // The muzzle of bank `b` of object `n` now: its position and the way it points.
    fn muzzle_of { run: *Run, n: usize, b: usize } -> math::Mat4 {
        let bg = run.gears[n].banks[b]
        return math::mat4::mul{ a = math::mat4::mul{ a = part_matrix{ run, n, rotating = bg.rotating }, b = bg.mount }, b = bg.muzzle }
    }

    // ---- sounds

    fn push_sound { mut run: Run, name: resref::ResRef, volume: f32, positional: bool, position: math::Vec3 } {
        if resref::is_empty{ r = name } or run.sound_count >= MAX_SOUNDS { return }
        run.sounds[run.sound_count] = Sound{ name, volume, positional, position }
        run.sound_count = run.sound_count + 1
    }

    fn take_sound { mut run: Run } -> ?Sound {
        if run.sound_count == 0 { return null }
        let s = run.sounds[0]
        let mut i: usize = 1
        while i < run.sound_count {
            run.sounds[i - 1] = run.sounds[i]
            i = i + 1
        }
        run.sound_count = run.sound_count - 1
        return s
    }

    // ---- random numbers (xorshift32: the enemies' aim error)

    fn random_unit { mut run: Run } -> f32 {
        let mut x = run.rng
        if x == 0 { x = 0x9E3779B9 }
        x = x ^ (x << 13)
        x = x ^ (x >> 17)
        x = x ^ (x << 5)
        run.rng = x
        return @as(f32, x >> 8) / 16777216.0
    }

    // ---- the guns

    // Pulls the trigger of bank `b`: if it has cooled, the gun starts its `fire` animation and
    // the bullet leaves at the animation's event. Returns whether it started.
    fn pull_trigger { mut run: Run, n: usize, b: usize } -> bool {
        let f = follower_of{ run = &run, n }
        let bg = run.gears[n].banks[b]
        let g = &run.objs[n].guns[b]
        if not bg.ready or g.firing or g.cooldown > 0.0 { return false }
        g.cooldown = f.banks[b].rate_of_fire
        g.firing = true
        g.t = 0.0
        g.spawned = false
        push_gun_request{ &run, object = id_of{ n }, bank = b, name = "fire", queue = false }
        push_gun_request{ &run, object = id_of{ n }, bank = b, name = "ready", queue = true }
        return true
    }

    // Whether, and at what, an enemy's bank `b` can fire: the Hawk within the bank's sensing
    // radius and inside its horizontal and vertical spread about the way the gun points at rest.
    fn enemy_aim { run: *Run, n: usize, b: usize } -> ?math::Vec3 {
        let bank = follower_of{ run, n }.banks[b]
        let bg = run.gears[n].banks[b]
        let goal = target_point{ run }
        let mount = math::mat4::mul{ a = part_matrix{ run, n, rotating = bg.rotating }, b = bg.mount }
        let from = math::mat4::get_translation{ m = mount }
        if math::vec3::distance{ a = from, b = goal } > bank.sensing_radius { return null }
        let local = math::mat4::transform_point{ m = math::mat4::inverse_affine{ m = mount }, p = goal }
        let across = math::sqrtf{ x = local.x * local.x + local.y * local.y }
        let horizontal = math::degrees{ radians = math::atan2f{ y = local.x, x = local.y } }
        let vertical = math::degrees{ radians = math::atan2f{ y = local.z, x = across } }
        if math::abs{ x = horizontal } > bank.horiz_spread or math::abs{ x = vertical } > bank.vert_spread { return null }
        return goal
    }

    // The bullet of a shot whose event has come: from the muzzle, straight along it for the
    // player, at the Hawk (with the bank's inaccuracy as an error in proportion to the distance)
    // for an enemy.
    fn spawn_bullet { mut run: Run, n: usize, b: usize } {
        let mut slot: usize = 0
        while slot < MAX_BULLETS and run.bullets[slot].live { slot = slot + 1 }
        if slot >= MAX_BULLETS { return }
        let bank = follower_of{ run = &run, n }.banks[b]
        let m = muzzle_of{ run = &run, n, b }
        let from = math::mat4::get_translation{ m }
        let mut dir = math::vec3::normalize{ v = math::mat4::transform_dir{ m, v = math::Vec3{ x = 0.0, y = 1.0, z = 0.0 } } }
        if run.objs[n].kind == ObjKind::enemy {
            let goal = target_point{ run = &run }
            let miss = bank.inaccuracy * math::vec3::distance{ a = from, b = goal }
            let jitter = math::Vec3{ x = random_unit{ &run } - 0.5, y = random_unit{ &run } - 0.5, z = random_unit{ &run } - 0.5 }
            let aimed = math::vec3::add_scaled{ a = goal, b = math::vec3::normalize{ v = jitter }, s = miss * random_unit{ &run } }
            dir = math::vec3::normalize{ v = math::vec3::sub{ a = aimed, b = from } }
        }
        run.bullet_serial = run.bullet_serial + 1
        run.bullets[slot] = Bullet{
            live = true, owner = n, bank = b, serial = run.bullet_serial, position = from, previous = from, direction = dir,
            speed = bank.speed, life = bank.lifespan, damage = @as(i32, bank.damage), target = bank.target_type,
            model = bank.bullet_model, hit_sound = bank.collision_sound, exploding = false, explode_left = 0.0,
        }
        push_sound{ &run, name = bank.fire_sound, volume = 1.0, positional = run.objs[n].kind == ObjKind::enemy, position = from }
    }

    // A gun's shot in progress and its cooldown.
    fn step_guns { mut run: Run, dt: f32 } {
        let mut n: usize = 0
        while n < run.count {
            let o = &run.objs[n]
            if (o.kind == ObjKind::player or o.kind == ObjKind::enemy) and not o.removed {
                let f = follower_of{ run = &run, n }
                let mut b: usize = 0
                while b < f.bank_count {
                    let g = &o.guns[b]
                    if g.cooldown > 0.0 { g.cooldown = g.cooldown - dt }
                    if g.firing {
                        g.t = g.t + dt
                        let bg = run.gears[n].banks[b]
                        if not g.spawned and g.t >= bg.event_time {
                            g.spawned = true
                            spawn_bullet{ &run, n, b }
                        }
                        if g.t >= math::max{ a = bg.fire_length, b = bg.event_time } { g.firing = false }
                    }
                    b = b + 1
                }
            }
            n = n + 1
        }
    }

    // ---- bullets

    // Whether the path a to b meets the hit mesh `box` of a model standing at `m`.
    fn path_meets { m: math::Mat4, box: math::Aabb, a: math::Vec3, b: math::Vec3 } -> bool {
        let inv = math::mat4::inverse_affine{ m }
        let la = math::mat4::transform_point{ m = inv, p = a }
        let lb = math::mat4::transform_point{ m = inv, p = b }
        let fat = math::aabb::make{
            min = math::vec3::sub{ a = box.min, b = math::vec3::splat{ s = BULLET_RADIUS } },
            max = math::vec3::add{ a = box.max, b = math::vec3::splat{ s = BULLET_RADIUS } },
        }
        return math::ray::intersect_aabb{ ray = math::ray::make{ origin = la, dir = math::vec3::sub{ a = lb, b = la } }, box = fat, max_t = 1.0 } != null
    }

    // The first object of the classes a bullet is aimed at that its last step crossed.
    fn bullet_target { run: *Run, bl: *Bullet } -> ?usize {
        let mut n: usize = 0
        while n < run.count {
            let o = &run.objs[n]
            n = n + 1
            let class: u32 = if o.kind == ObjKind::player { 1 } else if o.kind == ObjKind::enemy { 2 } else { 0 }
            if class == 0 or (bl.target & class) == 0 or o.dead or o.removed { continue }
            let g = &run.gears[n - 1]
            if not g.has_box { continue }
            if path_meets{ m = part_matrix{ run, n = n - 1, rotating = g.box_rotating }, box = g.box, a = bl.previous, b = bl.position } { return n - 1 }
        }
        return null
    }

    // A bullet reaches an object: it bursts, and the object's OnHitBullet runs, or by default
    // loses the bullet's damage.
    fn bullet_hit { mut run: Run, slot: usize, n: usize } {
        let bl = &run.bullets[slot]
        bl.exploding = true
        bl.explode_left = run.gears[bl.owner].banks[bl.bank].explode_length
        run.last_bullet_damage = bl.damage
        run.last_bullet_target = id_of{ n }
        run.last_bullet_shooter = id_of{ n = bl.owner }
        push_sound{ &run, name = bl.hit_sound, volume = 1.0, positional = n != PLAYER, position = bl.position }
        if resref::is_empty{ r = script_of{ run = &run, slot = ON_HIT_BULLET, object = id_of{ n } } } {
            default_bullet_hit{ &run, n }
        } else {
            push_event{ &run, slot = ON_HIT_BULLET, object = id_of{ n } }
        }
    }

    // The engine's OnHitBullet: the last bullet's damage off the object.
    fn default_bullet_hit { mut run: Run, n: usize } {
        damage_object{ &run, n, delta = -run.last_bullet_damage }
    }

    fn step_bullets { mut run: Run, dt: f32 } {
        let mut i: usize = 0
        while i < MAX_BULLETS {
            let bl = &run.bullets[i]
            if bl.live {
                if bl.exploding {
                    bl.explode_left = bl.explode_left - dt
                    if bl.explode_left <= 0.0 { bl.live = false }
                } else {
                    bl.previous = bl.position
                    bl.position = math::vec3::add_scaled{ a = bl.position, b = bl.direction, s = bl.speed * dt }
                    bl.life = bl.life - dt
                    let hit = bullet_target{ run = &run, bl }
                    if hit is some{ value = n } {
                        bullet_hit{ &run, slot = i, n }
                    } else if bl.life <= 0.0 {
                        bl.live = false
                    }
                }
            }
            i = i + 1
        }
    }

    // ---- the turret's step

    // The aim, in degrees, wrapped to 0..360.
    fn wrap_degrees { x: f32 } -> f32 {
        let r = math::fmodf{ x, y = 360.0 }
        return if r < 0.0 { r + 360.0 } else { r }
    }

    // Keys turn the aim at the movement rate with the lateral model's inertia; the mouse adds
    // its counts straight to the angle (the original divides them by 20, clamps to 1, and takes
    // that much of a full-speed turn). Pitch is held in the tunnel's bounds; yaw wraps.
    fn step_aim { mut run: Run, dt: f32 } {
        let a = run.area
        let movement = a.movement_per_sec
        if movement <= 0.0 { return }
        let up = math::clamp{ x = run.input.y, lo = -1.0, hi = 1.0 }
        let left = -math::clamp{ x = run.input.x, lo = -1.0, hi = 1.0 }
        let sp = step_axis{ x = run.offset.x, v = run.velocity.x, u = up, lateral = run.lateral_accel, movement, inertia = true, dt }
        let sy = step_axis{ x = run.offset.z, v = run.velocity.z, u = left, lateral = run.lateral_accel, movement, inertia = true, dt }
        run.offset.x = sp[0]
        run.velocity.x = sp[1]
        run.offset.z = sy[0]
        run.velocity.z = sy[1]
        let ax = if a.mouse.axis_x > 0 { a.mouse.axis_x } else { 3 }
        let ay = if a.mouse.axis_y > 0 { a.mouse.axis_y } else { 1 }
        let hx = math::clamp{ x = run.input.aim_x / MOUSE_DIVISOR, lo = -1.0, hi = 1.0 } * (if a.mouse.flip_x { -1.0 } else { 1.0 })
        let hy = math::clamp{ x = run.input.aim_y / MOUSE_DIVISOR, lo = -1.0, hi = 1.0 } * (if a.mouse.flip_y { -1.0 } else { 1.0 })
        add_axis{ v = &run.offset, i = ax, d = -hx * movement * dt }
        add_axis{ v = &run.offset, i = ay, d = -hy * movement * dt }
        let cp = clamp_axis{ x = run.offset.x, v = run.velocity.x, pos = run.tunnel_pos.x, neg = run.tunnel_neg.x, origin = run.origin.x, infinite = run.tunnel_infinite[0] }
        run.offset.x = cp[0]
        run.velocity.x = cp[1]
        if run.tunnel_infinite[2] {
            run.offset.z = wrap_degrees{ x = run.offset.z }
        } else {
            let cz = clamp_axis{ x = run.offset.z, v = run.velocity.z, pos = run.tunnel_pos.z, neg = run.tunnel_neg.z, origin = run.origin.z, infinite = false }
            run.offset.z = cz[0]
            run.velocity.z = cz[1]
        }
    }

    fn add_axis { mut v: math::Vec3, i: u32, d: f32 } {
        if i == 1 { v.x = v.x + d } else if i == 2 { v.y = v.y + d } else { v.z = v.z + d }
    }

    // One step of the turret after the aim and the rails have moved: the player's trigger, the
    // enemies' decisions, the shots in progress, the bullets.
    fn step_turret { mut run: Run, dt: f32 } {
        if run.input.fire and not run.objs[PLAYER].dead {
            let f = &run.area.player
            let mut started = false
            let mut b: usize = 0
            while b < f.bank_count {
                if pull_trigger{ &run, n = PLAYER, b } { started = true }
                b = b + 1
            }
            if started { push_event{ &run, slot = ON_FIRE, object = id_of{ n = PLAYER } } }
        }
        let mut n: usize = 1
        while n < run.count {
            let o = &run.objs[n]
            if o.kind == ObjKind::enemy and not o.dead and not o.removed and not run.objs[PLAYER].dead {
                let f = &run.area.enemies[o.index]
                let mut b: usize = 0
                while b < f.bank_count {
                    if not o.guns[b].firing and o.guns[b].cooldown <= 0.0 {
                        if enemy_aim{ run = &run, n, b } != null { _ = pull_trigger{ &run, n, b } }
                    }
                    b = b + 1
                }
            }
            n = n + 1
        }
        step_guns{ &run, dt }
        step_bullets{ &run, dt }
    }

    // ---- a gunner for headless runs

    // The controls of a gunner who turns toward the nearest fighter and fires when the guns are
    // on it: for tests and unattended runs (the real player aims with the mouse).
    fn gunner_input { run: *Run } -> Input {
        let none = Input{ x = 0.0, y = 0.0, fire = false, aim_x = 0.0, aim_y = 0.0 }
        let mut best: usize = 0
        let mut best_d: f32 = 1.0e30
        let mut n: usize = 1
        while n < run.count {
            let o = &run.objs[n]
            if o.kind == ObjKind::enemy and not o.dead and not o.removed {
                let d = math::vec3::distance{ a = o.position, b = run.objs[PLAYER].position }
                if d < best_d {
                    best_d = d
                    best = n
                }
            }
            n = n + 1
        }
        if best == 0 { return none }
        // aim the gun bank 0 at it: yaw about Z, pitch from the gun's own tilt
        let goal = math::vec3::sub{ a = run.objs[best].position, b = run.objs[PLAYER].position }
        let want_yaw = math::degrees{ radians = math::atan2f{ y = -goal.x, x = goal.y } }
        let across = math::sqrtf{ x = goal.x * goal.x + goal.y * goal.y }
        let mut tilt: f32 = 0.0
        if run.gears[PLAYER].banks[0].ready {
            let d = math::mat4::transform_dir{ m = run.gears[PLAYER].banks[0].mount, v = math::Vec3{ x = 0.0, y = 1.0, z = 0.0 } }
            tilt = math::degrees{ radians = math::atan2f{ y = d.z, x = math::sqrtf{ x = d.x * d.x + d.y * d.y } } }
        }
        let want_pitch = math::degrees{ radians = math::atan2f{ y = goal.z, x = across } } - tilt
        let mut dyaw = want_yaw - run.offset.z
        while dyaw > 180.0 { dyaw = dyaw - 360.0 }
        while dyaw < -180.0 { dyaw = dyaw + 360.0 }
        let dpitch = want_pitch - run.offset.x
        // x is right (which turns the yaw down), y is up
        return Input{
            x = math::clamp{ x = -dyaw / 6.0, lo = -1.0, hi = 1.0 },
            y = math::clamp{ x = dpitch / 6.0, lo = -1.0, hi = 1.0 },
            fire = math::abs{ x = dyaw } < 4.0 and math::abs{ x = dpitch } < 4.0,
            aim_x = 0.0, aim_y = 0.0,
        }
    }
}
