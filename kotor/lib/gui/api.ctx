// What panel owners call: find a control by tag, set its text, state and value, fill list boxes,
// the GUI's sounds and cursors, tooltips (docs/design/gui.md).
namespace gui {
    // ---- cursors: the pictures the install has (gui_mp_<stem>u / d / dp); `d` is the look while
    // the left button is down. Ids are indices into CURSOR_STEMS.
    const CURSOR_DEFAULT: u32 = 0
    const CURSOR_ATTACK: u32 = 1
    const CURSOR_BASH: u32 = 2
    const CURSOR_DISMINE: u32 = 3
    const CURSOR_DOOR: u32 = 4
    const CURSOR_INVALID: u32 = 5
    const CURSOR_KILL: u32 = 6
    const CURSOR_PICKUP: u32 = 7
    const CURSOR_RECMINE: u32 = 8
    const CURSOR_SELECT: u32 = 9
    const CURSOR_TALK: u32 = 10
    const CURSOR_USE: u32 = 11
    const CURSOR_LOCK: u32 = 12
    const CURSOR_TRANS: u32 = 13
    const CURSOR_MAGIC: u32 = 14
    const CURSOR_WALK: u32 = 15
    const CURSOR_COUNT: u32 = 16

    fn cursor_stem { id: u32 } -> []u8 {
        if id == CURSOR_ATTACK { return "attack" }
        if id == CURSOR_BASH { return "bash" }
        if id == CURSOR_DISMINE { return "dismine" }
        if id == CURSOR_DOOR { return "door" }
        if id == CURSOR_INVALID { return "invalid" }
        if id == CURSOR_KILL { return "kill" }
        if id == CURSOR_PICKUP { return "pickup" }
        if id == CURSOR_RECMINE { return "recmine" }
        if id == CURSOR_SELECT { return "select" }
        if id == CURSOR_TALK { return "talk" }
        if id == CURSOR_USE { return "use" }
        if id == CURSOR_LOCK { return "lock" }
        if id == CURSOR_TRANS { return "trans" }
        if id == CURSOR_MAGIC { return "magic" }
        if id == CURSOR_WALK { return "walk" }
        return "default"
    }

    // Loads the GUI's sounds (guisounds.2da) and cursor pictures. Call once after `make`; missing
    // ones are skipped.
    fn load_defaults { mut g: Gui, mut fs: Fs, mut dev: gpu::Device } -> ! {
        let mut id: u32 = 0
        while id < CURSOR_COUNT {
            let stem = cursor_stem{ id }
            let mut up: u32 = 0
            while up < 2 {
                let mut buf: [24]u8
                let pre: []u8 = "gui_mp_"
                slice::copy(u8){ dst = buf[..pre.len], src = pre }
                slice::copy(u8){ dst = buf[pre.len..pre.len + stem.len], src = stem }
                buf[pre.len + stem.len] = if up == 0 { 'u' } else { 'd' }
                let n = pre.len + stem.len + 1
                g.cursors[@as(usize, id * 2 + up)].tex = resolve_img{ &g, &fs, &dev, name = buf[..n] }
                up = up + 1
            }
            id = id + 1
        }
        let bytes = try res::load{ &fs, rm = g.rm, name = "guisounds", kind = restype::Type::twoda, realloc = heap::alloc, heap = g.heap } ifnull { return }
        defer _ = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = g.heap, mem = bytes, count = 0 }
        let t = try twoda::parse{ data = bytes, realloc = heap::alloc, heap = g.heap }
        defer twoda::free{ t, realloc = heap::alloc, heap = g.heap }
        let mut row: usize = 0
        while row < twoda::rows{ t } and row < SOUNDS {
            let name = twoda::get_string{ t, row, column = "soundresref" } ifnull ""
            if name.len > 0 {
                let wav = res::load{ &fs, rm = g.rm, name, kind = restype::Type::wav, realloc = heap::alloc, heap = g.heap } iferr { null }
                let b = wav ifnull { slice::empty(u8){} }
                if b.len > 0 { g.sounds[row] = Sound{ bytes = b, ok = true } }
            }
            row = row + 1
        }
    }

    // Which cursor the pointer shows (a CURSOR_* id).
    fn set_cursor { mut g: Gui, id: u32 } { g.cursor = if id < CURSOR_COUNT { id } else { 0 } }

    fn set_cursor_visible { mut g: Gui, visible: bool } { g.cursor_visible = visible }

    // ---- finding and changing controls

    fn find_control { mut g: Gui, panel: u32, tag: []u8 } -> ?*mut Control {
        let p = find_panel{ &g, id = panel } ifnull { return null }
        let i = find_by_tag{ p, tag }
        if i < 0 { return null }
        return list::at{ list = p.controls, i = @as(usize, i) }
    }

    // Whether the panel has a control tagged `tag`.
    fn has_control { mut g: Gui, panel: u32, tag: []u8 } -> bool {
        return find_control{ &g, panel, tag } != null
    }

    // Sets a label, button or edit box's text to `text` as given (no token expansion).
    fn set_text { mut g: Gui, panel: u32, tag: []u8, text: []u8 } -> ! {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.text.present = true
        try assign_text{ &g, c, s = text }
    }

    // Sets the text to dialog.tlk's StrRef `strref`, tokens expanded.
    fn set_strref { mut g: Gui, panel: u32, tag: []u8, strref: u32 } -> ! {
        let c = find_control{ &g, panel, tag } ifnull { return }
        let s = try tlk_text{ &g, strref }
        free_string{ &g, s = c.text.buf }
        c.text.present = true
        c.text.buf = s
        c.text.text = s
        c.text.strref = strref
    }

    // Sets the text to `text` with its `<tokens>` expanded.
    fn set_text_tokens { mut g: Gui, panel: u32, tag: []u8, text: []u8 } -> ! {
        let c = find_control{ &g, panel, tag } ifnull { return }
        let s = try expand_tokens{ &g, src = text }
        free_string{ &g, s = c.text.buf }
        c.text.present = true
        c.text.buf = s
        c.text.text = s
    }

    fn set_text_color { mut g: Gui, panel: u32, tag: []u8, color: render::Color } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.text.color = color
        c.text.file_color = color
    }

    fn set_visible { mut g: Gui, panel: u32, tag: []u8, visible: bool } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.flags = if visible { c.flags | F_VISIBLE } else { clear_bits{ f = c.flags, bits = F_VISIBLE } }
    }

    // Moves and resizes a control, in the panel's pixels as the file gives them. Hit tests and
    // drawing follow at once.
    fn set_extent { mut g: Gui, panel: u32, tag: []u8, x: i32, y: i32, w: i32, h: i32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.x = x
        c.y = y
        c.w = w
        c.h = h
    }

    // Where a control is in its panel's pixels (the file's LEFT, TOP, WIDTH, HEIGHT unless moved).
    fn control_extent { mut g: Gui, panel: u32, tag: []u8 } -> ?render::Rect {
        let c = find_control{ &g, panel, tag } ifnull { return null }
        return rect_of{ x = c.x, y = c.y, w = c.w, h = c.h }
    }

    // Whether the pointer is over the control or it has the keyboard focus.
    fn is_hilighted { mut g: Gui, panel: u32, tag: []u8 } -> bool {
        let c = find_control{ &g, panel, tag } ifnull { return false }
        return (c.flags & F_HILIGHT) != 0
    }

    // A disabled control draws its text dim, ignores the pointer and the keys.
    fn set_enabled { mut g: Gui, panel: u32, tag: []u8, enabled: bool } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        if enabled {
            c.flags = c.flags | F_ENABLED
            c.text.color = c.text.file_color
        } else {
            c.flags = clear_bits{ f = c.flags, bits = F_ENABLED | F_HILIGHT }
            c.text.color = color_disabled{}
        }
    }

    fn set_value { mut g: Gui, panel: u32, tag: []u8, value: i32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.value = value
    }

    fn set_max { mut g: Gui, panel: u32, tag: []u8, max: i32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.max = max
    }

    fn value_of { mut g: Gui, panel: u32, tag: []u8 } -> i32 {
        let c = find_control{ &g, panel, tag } ifnull { return 0 }
        return c.value
    }

    fn set_checked { mut g: Gui, panel: u32, tag: []u8, on: bool } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.flags = if on { c.flags | F_CHECKED } else { clear_bits{ f = c.flags, bits = F_CHECKED } }
    }

    fn is_checked { mut g: Gui, panel: u32, tag: []u8 } -> bool {
        let c = find_control{ &g, panel, tag } ifnull { return false }
        return (c.flags & F_CHECKED) != 0
    }

    // CSWGuiBorderInfo::SetFill: the control's fill (its progress fill for a progress bar) becomes the
    // texture `name`, as the engine does for the target block's frames and health bar.
    fn set_fill { mut g: Gui, mut fs: Fs, mut dev: gpu::Device, panel: u32, tag: []u8, name: []u8 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        let img = resolve_img{ &g, &fs, &dev, name }
        if c.kind == K_PROGRESS { c.progress.fill = img } else { c.border.fill = img }
    }

    // The alpha a control's frame (its BORDER and its HILIGHT) is drawn with: the engine's border alpha field,
    // which SetState sets to 0.5 on a slot with nothing in it (the tint of the file stays).
    fn set_frame_alpha { mut g: Gui, panel: u32, tag: []u8, alpha: f32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.border.color.a = alpha
        c.hilight.color.a = alpha
        if alpha < 1.0 { c.border.tinted = true; c.hilight.tinted = true }
    }

    // AddChild: `tag`'s control becomes a child of `parent`, so the pointer on the child lights the parent too (the
    // engine makes a target slot's frame the parent of its icon and arrows).
    fn set_parent { mut g: Gui, panel: u32, tag: []u8, parent: []u8 } {
        let p = find_panel{ &g, id = panel } ifnull { return }
        let pi = find_by_tag{ p, tag = parent }
        let ci = find_by_tag{ p, tag }
        if pi < 0 or ci < 0 { return }
        list::at{ list = p.controls, i = @as(usize, ci) }.parent = list::at{ list = p.controls, i = @as(usize, pi) }.id
    }

    // Turns a control's stretched fill, and its hilight's, by `turns` quarter turns. The engine gives the
    // action slots' down arrows 180 degrees of the one arrow picture (CSWGuiActionSlot::Init, 0x0068b9d0).
    fn set_fill_turns { mut g: Gui, panel: u32, tag: []u8, turns: i32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.border.fill_turns = turns
        c.hilight.fill_turns = turns
    }

    // Shows `texture` (w x h pixels) as the control's fill in place of the file's: a portrait, a
    // save's screenshot.
    fn set_picture { mut g: Gui, panel: u32, tag: []u8, texture: render::Texture, w: f32, h: f32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.override_fill = Img{ tex = texture, w, h, ok = true, additive = false }
        if not c.border.present { c.border = no_border{}; c.border.present = true }
    }

    fn clear_picture { mut g: Gui, panel: u32, tag: []u8 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.override_fill = no_img{}
        c.picture_alpha = 1.0
    }

    // The alpha the control's picture is drawn with (1.0 normally); the next set_picture keeps it.
    fn set_picture_alpha { mut g: Gui, panel: u32, tag: []u8, alpha: f32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.picture_alpha = alpha
    }

    fn set_tooltip { mut g: Gui, panel: u32, tag: []u8, text: []u8 } -> ! {
        let c = find_control{ &g, panel, tag } ifnull { return }
        let s = try copy_string{ &g, s = text }
        free_string{ &g, s = c.tooltip_buf }
        c.tooltip_buf = s
        c.tooltip = s
    }

    // Gives the keyboard focus (and the hilight) to the control tagged `tag`.
    fn set_focus { mut g: Gui, panel: u32, tag: []u8 } {
        let p = find_panel{ &g, id = panel } ifnull { return }
        let i = find_by_tag{ p, tag }
        if i >= 0 { set_focus_index{ &g, p, ci = i, sound = false } }
    }

    // The original draws a 3D view where its control is in the file, so the controls after it cover
    // it. A caller that draws the view itself (over the GUI, once draw_panels is done) says which
    // control it stands for: the ones after `tag` are held back by draw_panels and drawn by
    // draw_overlay once the view is in the frame. "" puts everything back.
    fn set_overlay_after { mut g: Gui, panel: u32, tag: []u8 } {
        let p = find_panel{ &g, id = panel } ifnull { return }
        p.overlay_from = if tag.len == 0 { -1 } else { find_by_tag{ p, tag } + 1 }
        if p.overlay_from == 0 { p.overlay_from = -1 }
    }

    // The original's panels see the arrow keys (events 0x3d..0x40) before their active control
    // does, and some use them (the portrait arrows, the +/- of the abilities and skills). A panel
    // that asks gets an `arrow` event for each press, then the focus moves or the slider steps as
    // always.
    fn set_key_events { mut g: Gui, panel: u32, on: bool } {
        let p = find_panel{ &g, id = panel } ifnull { return }
        p.key_events = on
    }

    fn set_backdrop { mut g: Gui, mut fs: Fs, mut dev: gpu::Device, panel: u32, kind: u32 } {
        let p = find_panel{ &g, id = panel } ifnull { return }
        p.backdrop = kind
        ensure_backdrop{ &g, &fs, &dev, kind }
    }

    // Whether the panel draws its own colour and border fill (off lets a 3D view drawn under the
    // GUI show through).
    fn set_background { mut g: Gui, panel: u32, on: bool } {
        let p = find_panel{ &g, id = panel } ifnull { return }
        p.background = on
    }

    fn set_max_chars { mut g: Gui, panel: u32, tag: []u8, max: i32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.max_chars = max
    }

    // The panel's id of control position (for tools): its extent in screen pixels.
    fn control_rect { mut g: Gui, panel: u32, tag: []u8 } -> ?render::Rect {
        let p = find_panel{ &g, id = panel } ifnull { return null }
        let i = find_by_tag{ p, tag }
        if i < 0 { return null }
        let c = list::at{ list = p.controls, i = @as(usize, i) }
        return rect_of{ x = p.sx + c.x, y = p.sy + c.y, w = c.w, h = c.h }
    }

    // ---- list boxes

    // Where row `row` of the list is on the screen (GUI pixels), or null when it isn't visible.
    fn row_rect { mut g: Gui, panel: u32, tag: []u8, row: i32 } -> ?render::Rect {
        let p = find_panel{ &g, id = panel } ifnull { return null }
        let i = find_by_tag{ p, tag }
        if i < 0 { return null }
        let c = list::at{ list = p.controls, i = @as(usize, i) }
        let l = list_layout{ p, c }
        let k = row - c.first_row
        if k < 0 or k >= l.visible or row >= @as(i32, c.row_count) { return null }
        let s = row_slot{ l, padding = c.padding, k }
        return rect_of{ x = p.sx + l.ax + c.padding, y = p.sy + l.ay + s.y, w = l.aw - 2 * c.padding, h = s.h }
    }

    // Makes the rows of the list box act as buttons: a click on a row activates it (row_activated) at
    // once, and the pointer over one sends row_hover. The item lists (inventory, equipment, loot) are such.
    fn set_click_rows { mut g: Gui, panel: u32, tag: []u8 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.click_rows = true
    }

    // Makes the list box show one wrapped text instead of rows (message boxes, descriptions). A
    // text taller than the box scrolls by lines (the wheel, the scroll bar, up and down); a new
    // text starts at the top, as the original's ClearItems (0x00419a90) puts it back there.
    fn set_list_text { mut g: Gui, panel: u32, tag: []u8, text: []u8 } -> ! {
        let c = find_control{ &g, panel, tag } ifnull { return }
        // The same text again (a panel refreshing) keeps where it was scrolled to.
        if c.text_mode and c.row_count == 1 and slice::eq_bytes{ a = c.rows[0].text, b = text } { return }
        list_clear{ &g, panel, tag }
        c.text_mode = true
        _ = try list_add{ &g, panel, tag, text, user = 0 }
    }

    // Adds a control to a panel that looks like one it has: a copy of `from` under the new tag
    // `tag`, at x, y in the panel's pixels (the file's units). For options the original's panels
    // lack: a button or a check box like their neighbours. The copy has no text of its own yet
    // (set it with set_text), no links for the arrow keys and no ancestors. False when the panel
    // has no `from`.
    fn clone_control { mut g: Gui, panel: u32, from: []u8, tag: []u8, x: i32, y: i32 } -> !bool {
        let p = find_panel{ &g, id = panel } ifnull { return false }
        let i = find_by_tag{ p, tag = from }
        if i < 0 { return false }
        let mut c: Control = list::at{ list = p.controls, i = @as(usize, i) }.*
        let items = list::items{ list = p.controls }
        let mut top: i32 = 0
        let mut k: usize = 0
        while k < items.len {
            if items[k].id > top { top = items[k].id }
            k = k + 1
        }
        c.tag = tag
        c.id = top + 1
        c.parent = -1
        c.x = x
        c.y = y
        c.flags = clear_bits{ f = c.flags, bits = F_HILIGHT }
        c.text.text = ""
        c.text.buf = slice::empty(u8){}
        c.text.strref = 0xFFFFFFFF
        c.tooltip = ""
        c.tooltip_buf = slice::empty(u8){}
        c.rows = slice::empty(Row){}
        c.row_count = 0
        c.first_row = 0
        c.selected_row = -1
        c.moveto = [-1; 4]
        try list::push{ list = &p.controls, item = c }
        return true
    }

    // Makes a label an edit box: it takes typed text while it has the focus (save names).
    fn make_edit { mut g: Gui, panel: u32, tag: []u8 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.kind = K_EDIT
        c.flags = c.flags | F_VISIBLE | F_ENABLED
    }

    // Puts a picture in the panel's own fill (the loading screen's area picture).
    fn set_panel_picture { mut g: Gui, panel: u32, img: Img } {
        let p = find_panel{ &g, id = panel } ifnull { return }
        if not p.border.present { p.border = no_border{}; p.border.present = true }
        p.border.fill = img
        p.border.fill_style = FILL_STRETCHED
    }

    // Makes room for the message's lines: the list box, the panel and the buttons below grow.
    fn grow_message_box { mut g: Gui, panel: u32 } {
        let p = find_panel{ &g, id = panel } ifnull { return }
        let li = find_by_tag{ p, tag = "LB_MESSAGE" }
        if li < 0 { return }
        let c = list::at{ list = p.controls, i = @as(usize, li) }
        if c.proto < 0 or c.row_count == 0 { return }
        // The box is fitted with no scroll bar (FitToText 0x006253a0 gives it width 0) and grows
        // until the text fits, so the bar never comes back.
        c.bar_off = true
        let pc = list::at{ list = p.controls, i = @as(usize, c.proto) }
        if pc.text.font < 0 or @as(usize, pc.text.font) >= g.fonts.len { return }
        let font = list::items{ list = g.fonts }[@as(usize, pc.text.font)].font
        let l = list_layout{ p, c }
        let n = layout{ font, text = c.rows[0].text, width = l.aw - 2 * c.padding, lines = g.lines }
        let need = lines_height{ font, count = n } + 2 * c.padding
        if need <= c.h { return }
        let extra = need - c.h
        c.h = c.h + extra
        p.h = p.h + extra
        let cs = list::items{ list = p.controls }
        let mut i: usize = 0
        while i < cs.len {
            if cs[i].kind == K_BUTTON and (cs[i].flags & F_INTERNAL) == 0 { cs[i].y = cs[i].y + extra }
            i = i + 1
        }
        place{ &g, p }
    }

    // A confirmation or notice (confirm.gui): `text` over OK and, if `cancel`, Cancel. Modal,
    // centred. The owner takes the activate events of BTN_OK / BTN_CANCEL and closes the panel.
    fn message_box { mut g: Gui, mut fs: Fs, mut dev: gpu::Device, text: []u8, cancel: bool } -> !u32 {
        let id = try open{ &g, &fs, &dev, name = "confirm", mode = Mode::dialog, modal = true }
        try set_list_text{ &g, panel = id, tag = "LB_MESSAGE", text }
        grow_message_box{ &g, panel = id }
        if not cancel {
            set_visible{ &g, panel = id, tag = "BTN_CANCEL", visible = false }
        }
        set_focus{ &g, panel = id, tag = "BTN_OK" }
        play_sound{ &g, n = 4 }
        return id
    }

    fn list_clear { mut g: Gui, panel: u32, tag: []u8 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        let mut r: usize = 0
        while r < @as(usize, c.row_count) {
            free_string{ &g, s = c.rows[r].text }
            r = r + 1
        }
        c.row_count = 0
        c.first_row = 0
        c.text_step = 0
        c.selected_row = -1
        c.hover_row = -1
    }

    // Has the list box draw its scroll bar only while its rows overflow, as the conversation's
    // replies do (0x006a86a0); other lists show theirs always.
    fn set_bar_when_needed { mut g: Gui, panel: u32, tag: []u8 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.bar_when_needed = true
    }

    // Appends a row showing `text`; `user` is the owner's value for it. Returns its index.
    fn list_add { mut g: Gui, panel: u32, tag: []u8, text: []u8, user: i64 } -> !i32 {
        let c = find_control{ &g, panel, tag } ifnull { return -1 }
        if @as(usize, c.row_count) >= c.rows.len {
            let n = if c.rows.len == 0 { 16 } else { c.rows.len * 2 }
            c.rows = try alloc::resize(Row, heap::Heap){ realloc = heap::alloc, heap = g.heap, mem = c.rows, count = n }
        }
        let copy = try copy_string{ &g, s = text }
        c.rows[@as(usize, c.row_count)] = Row{ text = copy, user, color = white_color{}, has_color = false, icon = no_img{}, enabled = true, checked = false, frame = 0 }
        c.row_count = c.row_count + 1
        return @as(i32, c.row_count) - 1
    }

    fn list_set_color { mut g: Gui, panel: u32, tag: []u8, row: i32, color: render::Color } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        if row < 0 or row >= @as(i32, c.row_count) { return }
        c.rows[@as(usize, row)].color = color
        c.rows[@as(usize, row)].has_color = true
    }

    // How an item row's frames are tinted (FRAME_*): the original's item entry paints its frame, hilight frame
    // and icon frame in the menu blue / yellow, or magenta for a new item, or red for one that cannot be worn.
    fn list_set_frame { mut g: Gui, panel: u32, tag: []u8, row: i32, frame: u8 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        if row < 0 or row >= @as(i32, c.row_count) { return }
        c.rows[@as(usize, row)].frame = frame
    }

    // The alpha of the normal frame of the list's item rows (0 hides it; the hilight frame is not touched).
    fn list_set_frame_alpha { mut g: Gui, panel: u32, tag: []u8, alpha: f32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        c.row_frame_alpha = alpha
    }

    fn list_set_icon { mut g: Gui, panel: u32, tag: []u8, row: i32, texture: render::Texture, w: f32, h: f32 } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        if row < 0 or row >= @as(i32, c.row_count) { return }
        c.rows[@as(usize, row)].icon = Img{ tex = texture, w, h, ok = true, additive = false }
    }

    fn list_set_checked { mut g: Gui, panel: u32, tag: []u8, row: i32, checked: bool } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        if row < 0 or row >= @as(i32, c.row_count) { return }
        c.rows[@as(usize, row)].checked = checked
    }

    fn list_is_checked { mut g: Gui, panel: u32, tag: []u8, row: i32 } -> bool {
        let c = find_control{ &g, panel, tag } ifnull { return false }
        if row < 0 or row >= @as(i32, c.row_count) { return false }
        return c.rows[@as(usize, row)].checked
    }

    fn list_set_enabled { mut g: Gui, panel: u32, tag: []u8, row: i32, enabled: bool } {
        let c = find_control{ &g, panel, tag } ifnull { return }
        if row < 0 or row >= @as(i32, c.row_count) { return }
        c.rows[@as(usize, row)].enabled = enabled
    }

    // Selects a row (no event); -1 clears.
    fn list_select { mut g: Gui, panel: u32, tag: []u8, row: i32 } {
        let p = find_panel{ &g, id = panel } ifnull { return }
        let i = find_by_tag{ p, tag }
        if i < 0 { return }
        let c = list::at{ list = p.controls, i = @as(usize, i) }
        c.selected_row = if row < @as(i32, c.row_count) { row } else { -1 }
        if c.selected_row >= 0 { ensure_row_visible{ p, c } }
    }

    fn list_selected { mut g: Gui, panel: u32, tag: []u8 } -> i32 {
        let c = find_control{ &g, panel, tag } ifnull { return -1 }
        return c.selected_row
    }

    fn list_count { mut g: Gui, panel: u32, tag: []u8 } -> i32 {
        let c = find_control{ &g, panel, tag } ifnull { return 0 }
        return @as(i32, c.row_count)
    }

    // ---- tooltips

    // After the pointer rests on a control with tooltip text for the delay, the tooltip shows; at once while the
    // ToolTips key (T) is held.
    fn update_tooltip { mut g: Gui } {
        let delay = if g.tooltip_key { 0.0 } else { g.tooltip_delay }
        if not g.tooltips or g.hover_time < delay or g.tooltip_ref.panel != 0 { return }
        if g.hover.panel == 0 or g.hover.control < 0 { return }
        let p = panel_of{ &g, r = g.hover } ifnull { return }
        let c = list::at{ list = p.controls, i = @as(usize, g.hover.control) }
        if c.tooltip.len > 0 { g.tooltip_ref = g.hover }
    }

    // The ToolTips key went down or up.
    fn set_tooltip_key { mut g: Gui, held: bool } {
        g.tooltip_key = held
    }

    fn set_tooltip_delay { mut g: Gui, seconds: f32, enabled: bool } {
        g.tooltip_delay = seconds
        g.tooltips = enabled
    }

    fn draw_tooltip { mut g: Gui, mut frame: render::Frame, screen: render::Rect } {
        if g.tooltip_ref.panel == 0 { return }
        let p = panel_of{ &g, r = g.tooltip_ref } ifnull { return }
        if g.tooltip_ref.control < 0 or @as(usize, g.tooltip_ref.control) >= p.controls.len { return }
        let c = list::at{ list = p.controls, i = @as(usize, g.tooltip_ref.control) }
        if c.tooltip.len == 0 or g.fonts.len == 0 { return }
        // The small dialog font when loaded, else the first one.
        let mut slot: usize = 0
        let fonts = list::items{ list = g.fonts }
        let mut i: usize = 0
        while i < fonts.len {
            if fonts[i].ok and resref::matches{ r = fonts[i].name, name = "dialogfont10x10" } { slot = i }
            i = i + 1
        }
        if not fonts[slot].ok { return }
        let font = fonts[slot].font
        let n = layout{ font, text = c.tooltip, width = 280, lines = g.lines }
        let tw = lines_width{ lines = g.lines, count = n }
        let w = tw + 8
        let h = lines_height{ font, count = n } + 8
        let mut x = g.mouse_x + 15
        let mut y = g.mouse_y + 15
        if x + w > g.ui_w - 2 { x = g.ui_w - 2 - w }
        if y + h > g.ui_h - 2 { y = g.ui_h - 2 - h }
        if x < 2 { x = 2 }
        if y < 2 { y = 2 }
        put_fill{ &frame, x = @as(f32, x - 1), y = @as(f32, y - 1), w = @as(f32, w + 2), h = @as(f32, h + 2), color = color_menu{}, clip = screen }
        put_fill{ &frame, x = @as(f32, x), y = @as(f32, y), w = @as(f32, w), h = @as(f32, h), color = render::Color{ r = 0.0, g = 0.0, b = 0.0, a = 0.92 }, clip = screen }
        draw_lines{ &frame, font, text = c.tooltip, lines = g.lines, count = n, x = x + 4, y = y + 4, w = tw, h = h - 8, align = A_LEFT | A_TOP, color = white_color{}, clip = screen }
    }
}
