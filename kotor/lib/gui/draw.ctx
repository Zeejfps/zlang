// Drawing borders, text and every control type into a render::Frame's UI pass
// (docs/re/gui.md sections 3 to 6). Coordinates are GUI pixels (the UI pass's own size), y down.
namespace gui {
    const PI: f32 = 3.14159265
    const HALF_PI: f32 = 1.57079633

    // Text colours the code sets (docs/re/gui.md "Text colours set by code").
    fn color_hilight {} -> render::Color { return render::Color{ r = 0.98, g = 1.0, b = 0.0, a = 1.0 } }
    fn color_disabled {} -> render::Color { return render::Color{ r = 0.0, g = 0.33, b = 0.49, a = 1.0 } }
    fn color_menu {} -> render::Color { return render::Color{ r = 0.0, g = 0.66, b = 0.98, a = 1.0 } }

    fn rect_of { x: i32, y: i32, w: i32, h: i32 } -> render::Rect {
        return render::Rect{ x = @as(f32, x), y = @as(f32, y), w = @as(f32, w), h = @as(f32, h) }
    }

    // How a picture meets what is behind it: its TXI's `blending additive` adds, anything else blends
    // by alpha (the original's default pair; `punchthrough` is not used by any GUI picture).
    fn quad_blend { img: Img } -> render::Blend {
        return if img.additive { render::Blend::additive } else { render::Blend::alpha }
    }

    // A textured quad; `angle` turns it counterclockwise about its centre.
    fn put_image {
        mut frame: render::Frame, img: Img, x: f32, y: f32, w: f32, h: f32, color: render::Color, angle: f32, clip: render::Rect,
    } {
        if not img.ok or w <= 0.0 or h <= 0.0 { return }
        render::add_quad{ &frame, quad = render::Quad{
            rect = render::Rect{ x, y, w, h }, uv = render::upright{}, color,
            image = render::Image::texture{ t = img.tex }, blend = quad_blend{ img }, clip = clip, angle,
        } }
    }

    fn put_fill { mut frame: render::Frame, x: f32, y: f32, w: f32, h: f32, color: render::Color, clip: render::Rect } {
        if w <= 0.0 or h <= 0.0 { return }
        render::add_quad{ &frame, quad = render::Quad{
            rect = render::Rect{ x, y, w, h }, uv = render::upright{}, color,
            image = render::Image::none, blend = render::Blend::alpha, clip = clip, angle = 0.0,
        } }
    }

    // How many device pixels one GUI pixel spans along each axis: the render size over the GUI's pixel
    // space. 1 in the original's; 1.5 at 1440x1080 with the scale on 1.5; not exactly the scale when
    // the window does not divide by it (the pixel space is whole pixels).
    struct Grid { sx: f32, sy: f32 }

    fn grid_of { g: Gui } -> Grid {
        if g.ui_w <= 0 or g.ui_h <= 0 or g.win_w <= 0 or g.win_h <= 0 { return Grid{ sx = 1.0, sy = 1.0 } }
        return Grid{ sx = @as(f32, g.win_w) / @as(f32, g.ui_w), sy = @as(f32, g.win_h) / @as(f32, g.ui_h) }
    }

    // A GUI coordinate moved to the nearest device pixel boundary, as a GUI coordinate again. A
    // border's pieces that start between device pixels would cover a row of pixels more, or less,
    // than their neighbours do and have the edge's one-texel line fall on a pixel centre exactly
    // (where the rasteriser's tie rule decides): one side of a button thick and bright, the
    // opposite thin and dim. On a whole boundary the pieces tile exactly and every side looks alike.
    fn snap { v: f32, s: f32 } -> f32 {
        return math::floorf{ x = v * s + 0.5 } / s
    }

    // A picture over the GUI rectangle (x0, y0) to (x1, y1) with its boundaries on device pixels,
    // turned `turns` quarter turns counterclockwise about its centre. The rectangle is the one the
    // picture fills after turning; the quad itself is laid out before it, so an odd number of turns
    // swaps its width and height.
    fn put_piece {
        mut frame: render::Frame, img: Img, grid: Grid, x0: f32, y0: f32, x1: f32, y1: f32, turns: i32,
        color: render::Color, clip: render::Rect,
    } {
        let a = snap{ v = x0, s = grid.sx }
        let b = snap{ v = x1, s = grid.sx }
        let c = snap{ v = y0, s = grid.sy }
        let d = snap{ v = y1, s = grid.sy }
        let w = b - a
        let h = d - c
        let angle = if turns == 0 { 0.0 } else if turns == 1 { HALF_PI } else if turns == 2 { PI } else { PI + HALF_PI }
        if (turns & 1) == 0 {
            put_image{ &frame, img, x = a, y = c, w, h, color, angle, clip }
        } else {
            let cx = (a + b) / 2.0
            let cy = (c + d) / 2.0
            put_image{ &frame, img, x = cx - h / 2.0, y = cy - w / 2.0, w = h, h = w, color, angle, clip }
        }
    }

    // How thick a border is: the corner size, the edge thickness and the length of one edge
    // segment, in pixels (CSWGuiBorder::Draw: DIMENSION when set, else the textures' own sizes).
    struct Metrics { corner: i32, thick: i32, seg: i32 }

    fn border_metrics { b: Border } -> Metrics {
        let mut m = Metrics{ corner = b.dimension, thick = b.dimension, seg = 0 }
        if b.dimension > 0 {
            m.seg = if b.edge.ok { @as(i32, b.edge.w) } else { b.dimension }
        } else if b.corner.ok and b.edge.ok {
            m.corner = @as(i32, b.corner.w)
            m.thick = @as(i32, b.edge.h)
            m.seg = @as(i32, b.edge.w)
        } else {
            m.corner = 0
            m.thick = 0
        }
        if m.seg <= 0 { m.seg = 1 }
        return m
    }

    // The rectangle the text of a control with border `b` goes in: inside the corners, grown by
    // INNEROFFSET (vertically fully, horizontally by at most the thickness) (0x00415240).
    struct Area { x: i32, y: i32, w: i32, h: i32 }

    fn text_area { b: Border, x: i32, y: i32, w: i32, h: i32 } -> Area {
        let m = border_metrics{ b }
        let mut a = Area{ x = x + m.corner, y = y + m.corner, w = w - 2 * m.corner, h = h - 2 * m.corner }
        if a.w <= 0 or a.h <= 0 { a = Area{ x = x + w / 2, y = y + h / 2, w = 0, h = 0 } }
        let gh = if b.inner_offset < m.thick { b.inner_offset } else { m.thick }
        a.x = a.x - gh
        a.w = a.w + 2 * gh
        a.y = a.y - b.inner_offset
        a.h = a.h + 2 * b.inner_offset
        return a
    }

    fn mul_alpha { c: render::Color, a: f32 } -> render::Color {
        return render::Color{ r = c.r, g = c.g, b = c.b, a = c.a * a }
    }

    // One border around (x, y, w, h): corners, edges, then the fill (0x004168c0). `override` is
    // a picture code gave the control, drawn as the fill when ok.
    fn draw_border {
        mut g: Gui, mut frame: render::Frame, b: Border, x: i32, y: i32, w: i32, h: i32, alpha: f32,
        clip: render::Rect, override: Img,
    } {
        if not b.present or w <= 0 or h <= 0 { return }
        let tint = if b.tinted { b.color } else { white_color{} }
        let a_frame = alpha * (if (b.pulsing & 1) != 0 { g.pulse_border } else { 1.0 })
        let a_fill = alpha * (if (b.pulsing & 2) != 0 { g.pulse_border } else { 1.0 })
        let m = border_metrics{ b }
        let mut csz = m.corner
        if csz * 2 > w { csz = w / 2 }
        if csz * 2 > h { csz = h / 2 }
        let ct = mul_alpha{ c = tint, a = a_frame }
        let fx = @as(f32, x)
        let fy = @as(f32, y)
        let fw = @as(f32, w)
        let fh = @as(f32, h)
        let grid = grid_of{ g }
        if b.corner.ok and csz > 0 {
            let c = @as(f32, csz)
            put_piece{ &frame, img = b.corner, grid, x0 = fx, y0 = fy, x1 = fx + c, y1 = fy + c, turns = 0, color = ct, clip }
            put_piece{ &frame, img = b.corner, grid, x0 = fx, y0 = fy + fh - c, x1 = fx + c, y1 = fy + fh, turns = 1, color = ct, clip }
            put_piece{ &frame, img = b.corner, grid, x0 = fx + fw - c, y0 = fy + fh - c, x1 = fx + fw, y1 = fy + fh, turns = 2, color = ct, clip }
            put_piece{ &frame, img = b.corner, grid, x0 = fx + fw - c, y0 = fy, x1 = fx + fw, y1 = fy + c, turns = 3, color = ct, clip }
        }
        if b.edge.ok and m.thick > 0 {
            let t = m.thick
            // Horizontal edges: the gap between the corners cut into whole segments.
            let gap_h = w - 2 * csz
            let gap_v = h - 2 * csz
            draw_edge_run{ &frame, img = b.edge, grid, x0 = x + csz, y0 = y, gap = gap_h, seg = m.seg, thick = t, side = 0, color = ct, clip }
            draw_edge_run{ &frame, img = b.edge, grid, x0 = x + csz, y0 = y + h - t, gap = gap_h, seg = m.seg, thick = t, side = 2, color = ct, clip }
            draw_edge_run{ &frame, img = b.edge, grid, x0 = x, y0 = y + csz, gap = gap_v, seg = m.seg, thick = t, side = 1, color = ct, clip }
            draw_edge_run{ &frame, img = b.edge, grid, x0 = x + w - t, y0 = y + csz, gap = gap_v, seg = m.seg, thick = t, side = 3, color = ct, clip }
        }
        // The fill: inside the corners, or the whole extent without a corner texture.
        let inset = if b.corner.ok { csz } else { 0 }
        let ax = x + inset
        let ay = y + inset
        let aw = w - 2 * inset
        let ah = h - 2 * inset
        let fill = if override.ok { override } else { b.fill }
        if fill.ok and aw > 0 and ah > 0 {
            let fc = mul_alpha{ c = tint, a = a_fill }
            let style = if override.ok { FILL_STRETCHED } else { b.fill_style }
            if style == FILL_STRETCHED {
                put_piece{ &frame, img = fill, grid, x0 = @as(f32, ax), y0 = @as(f32, ay), x1 = @as(f32, ax + aw), y1 = @as(f32, ay + ah), turns = if override.ok { 0 } else { b.fill_turns & 3 }, color = fc, clip }
            } else if style == FILL_CENTRED {
                let mut tw = @as(i32, fill.w)
                let mut th = @as(i32, fill.h)
                if tw > aw { tw = aw }
                if th > ah { th = ah }
                let tx = ax + (aw - tw) / 2
                let ty = ay + (ah - th) / 2
                put_piece{ &frame, img = fill, grid, x0 = @as(f32, tx), y0 = @as(f32, ty), x1 = @as(f32, tx + tw), y1 = @as(f32, ty + th), turns = 0, color = fc, clip }
            } else {
                // Tiled: whole tiles of the texture's size, each stretched to fill exactly.
                let tw = if fill.w < 1.0 { 1 } else { @as(i32, fill.w) }
                let th = if fill.h < 1.0 { 1 } else { @as(i32, fill.h) }
                let mut nx = aw / tw
                let mut ny = ah / th
                if nx < 1 { nx = 1 }
                if ny < 1 { ny = 1 }
                let cw = @as(f32, aw) / @as(f32, nx)
                let chh = @as(f32, ah) / @as(f32, ny)
                let mut j: i32 = 0
                while j < ny {
                    let mut i: i32 = 0
                    while i < nx {
                        // Each tile's far side is the next one's near side, worked out the same way so the two meet.
                        let tx0 = @as(f32, ax) + cw * @as(f32, i)
                        let ty0 = @as(f32, ay) + chh * @as(f32, j)
                        let tx1 = @as(f32, ax) + cw * @as(f32, i + 1)
                        let ty1 = @as(f32, ay) + chh * @as(f32, j + 1)
                        put_piece{ &frame, img = fill, grid, x0 = tx0, y0 = ty0, x1 = tx1, y1 = ty1, turns = 0, color = fc, clip }
                        i = i + 1
                    }
                    j = j + 1
                }
            }
        }
    }

    // A run of edge segments along one side. `side`: 0 top, 1 left, 2 bottom, 3 right; the art is
    // the top edge and turns a quarter for each step. (x0, y0) is the run's first pixel.
    fn draw_edge_run {
        mut frame: render::Frame, img: Img, grid: Grid, x0: i32, y0: i32, gap: i32, seg: i32, thick: i32, side: i32,
        color: render::Color, clip: render::Rect,
    } {
        if gap <= 0 { return }
        let mut n = gap / seg
        if n == 0 and gap * 2 >= seg { n = 1 }
        if n == 0 { return }
        let base = gap / n
        let extra = gap - base * n
        let mut off: i32 = 0
        let mut k: i32 = 0
        while k < n {
            let len = base + (if k < extra { 1 } else { 0 })
            if side == 0 or side == 2 {
                put_piece{
                    &frame, img, grid, x0 = @as(f32, x0 + off), y0 = @as(f32, y0), x1 = @as(f32, x0 + off + len), y1 = @as(f32, y0 + thick),
                    turns = (if side == 0 { 0 } else { 2 }), color, clip,
                }
            } else {
                // The art is the top edge turned a quarter (left) or three (right).
                put_piece{
                    &frame, img, grid, x0 = @as(f32, x0), y0 = @as(f32, y0 + off), x1 = @as(f32, x0 + thick), y1 = @as(f32, y0 + off + len),
                    turns = (if side == 1 { 1 } else { 3 }), color, clip,
                }
            }
            off = off + len
            k = k + 1
        }
    }

    // ---- text of one control

    // The colour a control's text is drawn in now.
    fn text_color { mut g: Gui, c: *Control } -> render::Color {
        let mut col = c.text.color
        if (c.flags & F_PULSE_TEXT) != 0 or c.text.pulsing { col = mul_alpha{ c = col, a = g.pulse_border } }
        return col
    }

    // Lays out and draws `text` in the rectangle by the control's font and alignment.
    fn draw_text_in {
        mut g: Gui, mut frame: render::Frame, t: Text, text: []u8, color: render::Color,
        x: i32, y: i32, w: i32, h: i32, clip: render::Rect,
    } {
        if text.len == 0 { return }
        if t.font < 0 or @as(usize, t.font) >= g.fonts.len { return }
        let font = list::items{ list = g.fonts }[@as(usize, t.font)].font
        let n = layout{ font, text, width = w, lines = g.lines }
        draw_lines{ &frame, font, text, lines = g.lines, count = n, x, y, w, h, align = t.align, color, clip }
    }

    // ---- controls

    fn border_for { c: *Control, hilighted: bool } -> Border {
        if c.kind == K_CHECK {
            let on = (c.flags & F_CHECKED) != 0
            if on {
                if hilighted and c.hilight_selected.present { return c.hilight_selected }
                if c.selected.present { return c.selected }
            }
        }
        if hilighted and c.hilight.present { return c.hilight }
        return c.border
    }

    fn draw_control {
        mut g: Gui, mut frame: render::Frame, p: *Panel, c: *Control, alpha: f32, clip: render::Rect,
    } {
        let x = p.sx + c.x
        let y = p.sy + c.y
        let hl = (c.flags & F_HILIGHT) != 0
        let k = c.kind
        if k == K_LIST {
            draw_list{ &g, &frame, p, c, alpha, clip }
            return
        }
        if k == K_PROGRESS {
            draw_progress{ &g, &frame, c, x, y, alpha, clip }
            return
        }
        if k == K_CHECK and (c.flags & F_MENU_CHECK) != 0 {
            draw_menu_check{ &g, &frame, b = border_for{ c, hilighted = hl }, t = c.text, text = c.text.text, flags = c.flags, x, y, w = c.w, h = c.h, alpha, clip }
            return
        }
        let b = border_for{ c, hilighted = hl and (k == K_BUTTON or k == K_CHECK or k == K_PROTO or k == K_SLIDER or k == K_EDIT) }
        draw_border{ &g, &frame, b, x, y, w = c.w, h = c.h, alpha = if c.override_fill.ok { alpha * c.picture_alpha } else { alpha }, clip, override = c.override_fill }
        if k == K_SLIDER { draw_slider_thumb{ &frame, c, x, y, alpha, clip } }
        if c.text.present and c.text.text.len > 0 or k == K_EDIT {
            let a = text_area{ b = c.border, x, y, w = c.w, h = c.h }
            let mut col = text_color{ &g, c }
            col = mul_alpha{ c = col, a = alpha }
            if k == K_EDIT and hl {
                // A caret after the typed text while the box has the focus.
                draw_edit_text{ &g, &frame, c, a, col, clip }
            } else {
                draw_text_in{ &g, &frame, t = c.text, text = c.text.text, color = col, x = a.x, y = a.y, w = a.w, h = a.h, clip }
            }
        }
    }

    // ---- check boxes of the options panels

    // Where an options check box puts its parts in its extent (FUN_006de000, the subclass's
    // SetExtent): a square MENU_CHECK_SIZE wide at the left edge, two pixels below the vertical
    // middle, and the text in the rest from MENU_CHECK_TEXT_X on. The control itself, its hit
    // area, stays the whole extent.
    const MENU_CHECK_SIZE: i32 = 25
    const MENU_CHECK_TEXT_X: i32 = 30

    fn menu_check_box_y { h: i32 } -> i32 { return 2 + (h - MENU_CHECK_SIZE) / 2 }

    // The text colour the subclass's Render forces each frame (FUN_006de0e0): yellow and pulsing
    // while hilighted, dim blue while disabled, else menu blue.
    fn menu_check_text_color { mut g: Gui, flags: u32, alpha: f32 } -> render::Color {
        let mut col = color_menu{}
        if (flags & F_HILIGHT) != 0 {
            col = mul_alpha{ c = color_hilight{}, a = g.pulse_border }
        } else if (flags & F_ENABLED) == 0 {
            col = color_disabled{}
        }
        return mul_alpha{ c = col, a = alpha }
    }

    // `b` is the border for the control's state (border_for) and `flags` its state; the text,
    // when it has any, goes beside the bullet.
    fn draw_menu_check {
        mut g: Gui, mut frame: render::Frame, b: Border, t: Text, text: []u8, flags: u32,
        x: i32, y: i32, w: i32, h: i32, alpha: f32, clip: render::Rect,
    } {
        draw_border{ &g, &frame, b, x, y = y + menu_check_box_y{ h }, w = MENU_CHECK_SIZE, h = MENU_CHECK_SIZE, alpha, clip, override = no_img{} }
        if t.present and text.len > 0 {
            let col = menu_check_text_color{ &g, flags, alpha }
            draw_text_in{ &g, &frame, t, text, color = col, x = x + MENU_CHECK_TEXT_X, y, w = w - MENU_CHECK_TEXT_X, h, clip }
        }
    }

    fn draw_edit_text { mut g: Gui, mut frame: render::Frame, c: *Control, a: Area, col: render::Color, clip: render::Rect } {
        let n = c.text.text.len
        if n + 1 > 255 { return }
        let mut buf: [256]u8
        slice::copy(u8){ dst = buf[..n], src = c.text.text }
        buf[n] = '_'
        draw_text_in{ &g, &frame, t = c.text, text = buf[..n + 1], color = col, x = a.x, y = a.y, w = a.w, h = a.h, clip }
    }

    fn draw_progress { mut g: Gui, mut frame: render::Frame, c: *Control, x: i32, y: i32, alpha: f32, clip: render::Rect } {
        draw_border{ &g, &frame, b = c.border, x, y, w = c.w, h = c.h, alpha, clip, override = no_img{} }
        // The PROGRESS border fills the inner rectangle's long axis by CURVALUE / MAXVALUE.
        let a = text_area{ b = c.border, x, y, w = c.w, h = c.h }
        let mut ax = a.x
        let mut ay = a.y
        let mut aw = a.w
        let mut ah = a.h
        if c.max > 0 {
            let mut v = c.value
            if v < 0 { v = 0 }
            if v > c.max { v = c.max }
            let frac = @as(f32, v) / @as(f32, c.max)
            if ah > aw {
                let len = @as(i32, frac * @as(f32, ah))
                if not c.from_left { ay = ay + (ah - len) }
                ah = len
            } else {
                let len = @as(i32, frac * @as(f32, aw))
                if not c.from_left { ax = ax + (aw - len) }
                aw = len
            }
        }
        if aw > 0 and ah > 0 {
            draw_border{ &g, &frame, b = c.progress, x = ax, y = ay, w = aw, h = ah, alpha, clip, override = no_img{} }
        }
    }

    // The thumb keeps its picture's size along the slider and fills the slider across it, so a
    // 32 pixel tall thumb on a 24 pixel track is squeezed to 24 (CSWGuiSlider::SetExtent, 0x00418f20:
    // the thumb's rectangle is the extent's cross size by the picture's length, at
    // (extent - length) * value / max along the track; DRAWSTYLE 0 stretches the picture to it).
    fn draw_slider_thumb { mut frame: render::Frame, c: *Control, x: i32, y: i32, alpha: f32, clip: render::Rect } {
        if not c.thumb.ok { return }
        let horizontal = c.w >= c.h
        let tw = @as(i32, c.thumb.w)
        let th = @as(i32, c.thumb.h)
        let mx = if c.max > 0 { c.max } else { 1 }
        let mut v = c.value
        if v < 0 { v = 0 }
        if v > mx { v = mx }
        let col = render::Color{ r = 1.0, g = 1.0, b = 1.0, a = alpha }
        if horizontal {
            let len = if tw < c.w { tw } else { c.w }
            let pos = if tw < c.w { x + (c.w - tw) * v / mx } else { x }
            put_image{ &frame, img = c.thumb, x = @as(f32, pos), y = @as(f32, y), w = @as(f32, len), h = @as(f32, c.h), color = col, angle = 0.0, clip }
        } else {
            let len = if th < c.h { th } else { c.h }
            let pos = if th < c.h { y + (c.h - th) * v / mx } else { y }
            put_image{ &frame, img = c.thumb, x = @as(f32, x), y = @as(f32, pos), w = @as(f32, c.w), h = @as(f32, len), color = col, angle = 0.0, clip }
        }
    }

    // ---- list boxes

    // Where a list box's pieces are, in the panel's pixels.
    struct ListLayout {
        ax: i32, ay: i32, aw: i32, ah: i32,         // the row area
        row_h: i32, stride: i32, visible: i32,
        stretch: i32, extra: i32,
        sx: i32, sy: i32, sw: i32, sh: i32,         // the scroll bar
        has_bar: bool,
    }

    fn proto_height { p: *Panel, c: *Control } -> i32 {
        if c.cell_art.on { return CELL_ROW_H }
        // The list's row height is its tallest row's (UpdateLayout 0x0041b140), and an item entry is always ENTRY_BOX tall.
        if c.entry_rows { return ENTRY_BOX }
        if c.proto < 0 { return 16 }
        let pc = list::at{ list = p.controls, i = @as(usize, c.proto) }
        return if pc.h > 0 { pc.h } else { 16 }
    }

    fn list_layout { p: *Panel, c: *Control } -> ListLayout {
        let mut l = ListLayout{
            ax = c.x, ay = c.y, aw = c.w, ah = c.h, row_h = 16, stride = 16, visible = 1, stretch = 0, extra = 0,
            sx = 0, sy = 0, sw = 0, sh = 0, has_bar = false,
        }
        if c.scrollbar >= 0 {
            let sb = list::at{ list = p.controls, i = @as(usize, c.scrollbar) }
            l.has_bar = sb.w > 0 and not c.bar_off
            l.sx = sb.x
            l.sy = sb.y
            l.sw = sb.w
            l.sh = sb.h
            if l.has_bar {
                // The bar sits at one end of the box; the rows take the rest.
                l.aw = c.w - sb.w
                if c.scroll_left { l.ax = c.x + sb.w }
            }
        }
        l.row_h = proto_height{ p, c }
        l.stride = l.row_h + c.padding
        if l.stride < 1 { l.stride = 1 }
        l.visible = l.ah / l.stride
        if l.visible < 1 { l.visible = 1 }
        let spare = l.ah - l.visible * l.stride - c.padding
        if spare > 0 {
            l.stretch = spare / l.visible
            l.extra = spare - l.stretch * l.visible
        }
        return l
    }

    // The y of visible row slot `k` (0 is the first) and its height, relative to the list's area.
    struct Slot { y: i32, h: i32 }

    fn row_slot { l: ListLayout, padding: i32, k: i32 } -> Slot {
        let mut y = padding
        let mut i: i32 = 0
        while i < k {
            y = y + l.stride + l.stretch + (if i < l.extra { 1 } else { 0 })
            i = i + 1
        }
        return Slot{ y, h = l.row_h + l.stretch + (if k < l.extra { 1 } else { 0 }) }
    }

    fn draw_list { mut g: Gui, mut frame: render::Frame, p: *Panel, c: *Control, alpha: f32, clip: render::Rect } {
        let l = list_layout{ p, c }
        let ox = p.sx
        let oy = p.sy
        draw_border{ &g, &frame, b = c.border, x = ox + c.x, y = oy + c.y, w = c.w, h = c.h, alpha, clip, override = no_img{} }
        let area_clip = rect_of{ x = ox + l.ax, y = oy + l.ay, w = l.aw, h = l.ah }
        if c.list_tinted {
            put_fill{ &frame, x = area_clip.x, y = area_clip.y, w = area_clip.w, h = area_clip.h, color = render::Color{ r = c.list_color.r, g = c.list_color.g, b = c.list_color.b, a = alpha }, clip }
        }
        let rc = intersect{ a = area_clip, b = clip }
        let count = @as(i32, c.row_count)
        if c.text_mode {
            // One wrapped text in the prototype's font, colour and alignment. A text taller than
            // the box is one tall row moved up by whole lines (text_scroll).
            if count > 0 and c.proto >= 0 {
                let pc = list::at{ list = p.controls, i = @as(usize, c.proto) }
                let col = mul_alpha{ c = pc.text.color, a = alpha }
                let ts = text_scroll{ &g, p, c, l }
                let tx = ox + l.ax + c.padding
                let tw = l.aw - 2 * c.padding
                if ts.on {
                    draw_text_in{ &g, &frame, t = pc.text, text = c.rows[0].text, color = col, x = tx, y = oy + l.ay + ts.top, w = tw, h = ts.text_h, clip = rc }
                } else {
                    draw_text_in{ &g, &frame, t = pc.text, text = c.rows[0].text, color = col, x = tx, y = oy + l.ay + c.padding, w = tw, h = l.ah - 2 * c.padding, clip = rc }
                }
            }
            if bar_shown{ c, l, count } { draw_scrollbar{ &g, &frame, p, c, l, alpha, clip } }
            return
        }
        let mut k: i32 = 0
        while k < l.visible {
            let idx = c.first_row + k
            if idx >= count { break }
            let s = row_slot{ l, padding = c.padding, k }
            draw_row{ &g, &frame, p, c, idx, x = ox + l.ax + c.padding, y = oy + l.ay + s.y, w = l.aw - 2 * c.padding, h = s.h, alpha, clip = rc }
            k = k + 1
        }
        if bar_shown{ c, l, count } { draw_scrollbar{ &g, &frame, p, c, l, alpha, clip } }
    }

    // Whether the list draws its scroll bar. The original shows it whenever the list has one
    // (list flag 0x20, set by the constructor 0x0041be40), whether or not there is anything to
    // scroll; the conversation's replies show it only while they overflow (0x006a86a0), and a
    // message box whose text fits gives it no width (bar_off, CSWGuiMessageBox::FitToText).
    fn bar_shown { c: *Control, l: ListLayout, count: i32 } -> bool {
        if not l.has_bar { return false }
        if c.bar_when_needed { return count > l.visible }
        return true
    }

    // ---- one tall text (descriptions, message boxes)

    // A text-mode list whose text is taller than its box scrolls like the original's list with one
    // row taller than the row area (IsPixelScrolling 0x0041a290, LayoutPixelScroll 0x0041a2d0):
    // the row is the whole wrapped text, and the scroll position counts lines. At step 0 the text
    // starts `padding` below the top; each step moves it up one line of the font; the last step
    // puts its end `padding` above the bottom. There are `lines - page + 1` steps, where `page` is
    // the whole lines the box holds.
    struct TextScroll {
        on: bool,                   // the text is taller than the box
        line_h: i32,
        text_h: i32,                // the whole wrapped text
        steps: i32,                 // scroll positions, at least 1
        page: i32,                  // whole lines in the box: a press on the track moves this many
        step: i32,                  // the position, clamped to 0..steps-1
        top: i32,                   // where the text's top is, relative to the row area
    }

    fn text_scroll { mut g: Gui, p: *Panel, c: *Control, l: ListLayout } -> TextScroll {
        let mut r = TextScroll{ on = false, line_h = 0, text_h = 0, steps = 1, page = 1, step = 0, top = c.padding }
        if not c.text_mode or c.row_count == 0 or c.proto < 0 { return r }
        let pc = list::at{ list = p.controls, i = @as(usize, c.proto) }
        if pc.text.font < 0 or @as(usize, pc.text.font) >= g.fonts.len { return r }
        let font = list::items{ list = g.fonts }[@as(usize, pc.text.font)].font
        let n = layout{ font, text = c.rows[0].text, width = l.aw - 2 * c.padding, lines = g.lines }
        r.line_h = lines_height{ font, count = 1 }
        if r.line_h <= 0 { return r }
        r.text_h = lines_height{ font, count = n }
        if l.ah >= r.text_h + c.padding { return r }
        r.on = true
        r.page = l.ah / r.line_h
        r.steps = @as(i32, n) - r.page + 1
        if r.steps < 1 { r.steps = 1 }
        r.step = c.text_step
        if r.step > r.steps - 1 { r.step = r.steps - 1 }
        if r.step < 0 { r.step = 0 }
        r.top = if r.step == r.steps - 1 { l.ah - r.text_h - c.padding } else { c.padding - r.step * r.line_h }
        return r
    }

    // ---- the scroll bar's values and thumb

    // The scroll bar's maximum, current and visible values as the list sets them (UpdateLayout
    // 0x0041b140, LayoutPixelScroll): rows give max = count - visible + 1 (at least 1), visible =
    // the rows shown, current = the top row; a tall text gives max = text height - box height + 1,
    // visible = the box height and current = the pixels scrolled, spread evenly over the steps
    // (the last step sets the text height, which the bar clamps to max).
    struct BarValues { max: i32, cur: i32, visible: i32 }

    fn bar_values { mut g: Gui, p: *Panel, c: *Control, l: ListLayout } -> BarValues {
        if c.text_mode {
            let ts = text_scroll{ &g, p, c, l }
            if not ts.on { return BarValues{ max = 1, cur = 0, visible = 1 } }
            let mx = ts.text_h - l.ah + 1
            let mut cur: i32 = 0
            if ts.step == ts.steps - 1 { cur = mx }
            else if ts.step > 0 { cur = @as(i32, @as(f32, ts.step) / @as(f32, ts.steps - 1) * @as(f32, ts.text_h - l.ah)) }
            return BarValues{ max = mx, cur, visible = l.ah }
        }
        let count = @as(i32, c.row_count)
        let mut mx = count - l.visible + 1
        if mx < 1 { mx = 1 }
        let mut vis = if l.visible < count { l.visible } else { count }
        if vis < 1 { vis = 1 }
        return BarValues{ max = mx, cur = c.first_row, visible = vis }
    }

    // The thumb's y (relative to the panel) and length (0x004193f0): the track lies between the
    // arrows; the thumb is visible / (visible + max) of it, at least 4 pixels, placed by current /
    // (max - 1); with max 1 or less it fills the track.
    fn thumb_of { l: ListLayout, b: BarValues } -> Slot {
        let track_y = l.sy + l.sw
        let track_h = l.sh - 2 * l.sw
        if b.max <= 1 { return Slot{ y = track_y, h = track_h } }
        let mut len = track_h * b.visible / (b.visible + b.max)
        if len < 4 { len = 4 }
        return Slot{ y = track_y + (track_h - len) * b.cur / (b.max - 1), h = len }
    }

    fn intersect { a: render::Rect, b: render::Rect } -> render::Rect {
        let x0 = if a.x > b.x { a.x } else { b.x }
        let y0 = if a.y > b.y { a.y } else { b.y }
        let x1 = if a.x + a.w < b.x + b.w { a.x + a.w } else { b.x + b.w }
        let y1 = if a.y + a.h < b.y + b.h { a.y + a.h } else { b.y + b.h }
        return render::Rect{ x = x0, y = y0, w = if x1 > x0 { x1 - x0 } else { 0.0 }, h = if y1 > y0 { y1 - y0 } else { 0.0 } }
    }

    // The tint of an item row's frame: the menu blue (yellow when hilighted), magenta for a new item
    // (0.95, 0, 0.85), red-orange for one the creature cannot wear (0.74, 0.11, 0).
    fn item_frame_color { frame: u8, hot: bool } -> render::Color {
        if frame == FRAME_NEW { return render::Color{ r = 0.95, g = 0.0, b = 0.85, a = 1.0 } }
        if frame == FRAME_REFUSED { return render::Color{ r = 0.74, g = 0.11, b = 0.0, a = 1.0 } }
        if frame == FRAME_MARKED { return render::Color{ r = 0.95, g = 0.0, b = 0.85, a = 1.0 } }
        if frame == FRAME_LOCKED { return render::Color{ r = 0.35, g = 0.35, b = 0.35, a = 1.0 } }
        if frame == FRAME_WAITING { return color_hilight{} }
        return if hot { color_hilight{} } else { color_menu{} }
    }

    fn draw_row {
        mut g: Gui, mut frame: render::Frame, p: *Panel, c: *Control, idx: i32, x: i32, y: i32, w: i32, h: i32,
        alpha: f32, clip: render::Rect,
    } {
        if c.cell_art.on {
            draw_cell_row{ &g, &frame, c, idx, x, y, w, h, alpha, clip }
            return
        }
        if c.proto < 0 { return }
        let pc = list::at{ list = p.controls, i = @as(usize, c.proto) }
        let row = c.rows[@as(usize, idx)]
        let selected = c.selected_row == idx
        let hover = c.hover_row == idx
        // The rows of an item list are buttons: only the one under the pointer is hilighted (the
        // pointer's hilight event un-hilights the selected row), the selected one when the pointer
        // is elsewhere.
        let lit = if c.click_rows { (if c.hover_row >= 0 { hover } else { selected }) } else { selected or hover }
        // Hilighted rows swap borders; a row that is selected and hovered uses the combined one.
        let mut b = pc.border
        // The options panels' rows are menu check boxes (style_menu_check): hilighted when hovered
        // or selected (SetSelectedIndex sends the selected row the hilight event).
        let menu_check = pc.kind == K_CHECK and (pc.flags & F_MENU_CHECK) != 0
        if pc.kind == K_CHECK {
            let hot = if menu_check { lit } else { hover }
            if row.checked {
                b = if hot and pc.hilight_selected.present { pc.hilight_selected } else if pc.selected.present { pc.selected } else { pc.border }
            } else {
                b = if hot and pc.hilight.present { pc.hilight } else { pc.border }
            }
        } else if selected and hover and pc.hilight_selected.present { b = pc.hilight_selected } else if selected and pc.selected.present { b = pc.selected } else if lit and pc.hilight.present { b = pc.hilight }
        if menu_check {
            let mut fl = F_ENABLED
            if lit { fl = fl | F_HILIGHT }
            if not row.enabled { fl = clear_bits{ f = fl, bits = F_ENABLED } }
            draw_menu_check{ &g, &frame, b, t = pc.text, text = row.text, flags = fl, x, y, w, h, alpha, clip }
            return
        }
        let mut row_alpha = alpha
        if row.frame != FRAME_FILE {
            // CSWGuiItemEntry::SetItem (0x006b6710) and 0x006b5060 paint the row's frames; the file's near-white is not used.
            b.tinted = true
            b.color = item_frame_color{ frame = row.frame, hot = lit }
            if not lit { row_alpha = alpha * c.row_frame_alpha * (if row.frame == FRAME_NEW { 0.5 } else { 1.0 }) }
            if row.frame == FRAME_WAITING { row_alpha = alpha * g.pulse_border }
        }
        if c.entry_rows {
            draw_entry_row{ &g, &frame, c, pc, row, b, lit, x, y, w, alpha, row_alpha, clip }
            return
        }
        draw_border{ &g, &frame, b, x, y, w, h, alpha = row_alpha, clip, override = no_img{} }
        let a = text_area{ b = pc.border, x, y, w, h }
        let mut ax = a.x
        let mut aw = a.w
        if row.icon.ok {
            let iw = @as(i32, row.icon.w)
            let ih = @as(i32, row.icon.h)
            put_image{ &frame, img = row.icon, x = @as(f32, ax), y = @as(f32, y + (h - ih) / 2), w = @as(f32, iw), h = @as(f32, ih), color = render::Color{ r = 1.0, g = 1.0, b = 1.0, a = alpha }, angle = 0.0, clip }
            ax = ax + iw + 4
            aw = aw - iw - 4
        }
        let mut col = pc.text.color
        if row.has_color { col = row.color }
        if (lit or row.frame == FRAME_WAITING) and pc.kind == K_BUTTON and not row.has_color { col = color_hilight{} }
        if not row.enabled { col = color_disabled{} }
        if (lit or row.frame == FRAME_WAITING) and pc.kind == K_BUTTON { col = mul_alpha{ c = col, a = g.pulse_border } }
        col = mul_alpha{ c = col, a = alpha }
        draw_text_in{ &g, &frame, t = pc.text, text = row.text, color = col, x = ax, y = a.y, w = aw, h = a.h, clip }
        if row.aside.len > 0 {
            let mut t = pc.text
            t.align = (t.align & 0xFFFFFFF8) | A_RIGHT
            draw_text_in{ &g, &frame, t, text = row.aside, color = col, x = ax, y = a.y, w = aw, h = a.h, clip }
        }
    }

    // An item entry (CSWGuiItemEntry: SetExtent 0x006b5270, Render 0x006b4d40), whatever the slot's
    // height: the button frames `b` over (x + ENTRY_BOX, y, w - ENTRY_BOX, ENTRY_BOX), the hexagon
    // frame and then the icon each stretched over the ENTRY_BOX square at the left, the name in the
    // frames' text area, and a stack's size in the square's bottom right corner.
    fn draw_entry_row {
        mut g: Gui, mut frame: render::Frame, c: *Control, pc: *Control, row: Row, b: Border, lit: bool,
        x: i32, y: i32, w: i32, alpha: f32, row_alpha: f32, clip: render::Rect,
    } {
        let box = ENTRY_BOX
        draw_border{ &g, &frame, b, x = x + box, y, w = w - box, h = box, alpha = row_alpha, clip, override = no_img{} }
        // The hexagon is a fill: the hilighted one pulses, a new item's normal one is half transparent;
        // the slot view's frame alpha (row_frame_alpha) leaves it alone.
        let ha = if lit { alpha * g.pulse_border } else if row.frame == FRAME_NEW { alpha * 0.5 } else { alpha }
        let hc = item_frame_color{ frame = row.frame, hot = lit }
        let bf = @as(f32, box)
        put_image{ &frame, img = row.hex, x = @as(f32, x), y = @as(f32, y), w = bf, h = bf, color = mul_alpha{ c = hc, a = ha }, angle = 0.0, clip }
        put_image{ &frame, img = row.icon, x = @as(f32, x), y = @as(f32, y), w = bf, h = bf, color = render::Color{ r = 1.0, g = 1.0, b = 1.0, a = alpha }, angle = 0.0, clip }
        let a = text_area{ b = pc.border, x = x + box, y, w = w - box, h = box }
        let mut col = pc.text.color
        if row.has_color { col = row.color }
        if lit and pc.kind == K_BUTTON and not row.has_color { col = color_hilight{} }
        if not row.enabled { col = color_disabled{} }
        if lit and pc.kind == K_BUTTON { col = mul_alpha{ c = col, a = g.pulse_border } }
        draw_text_in{ &g, &frame, t = pc.text, text = row.text, color = mul_alpha{ c = col, a = alpha }, x = a.x, y = a.y, w = a.w, h = a.h, clip }
        if row.count < 2 { return }
        // The count: fnt_d16x16 in menu blue, bottom centred in a 19 pixel high box against the
        // square's right edge, 21 pixels wide for one or two digits and 42 for more.
        let mut digits: [12]u8
        let n = put_digits{ into = digits[..], n = row.count }
        let tw = if n <= 2 { 21 } else { 42 }
        let mut t = pc.text
        t.font = c.entry_font
        t.align = A_CENTRE | A_BOTTOM
        draw_text_in{ &g, &frame, t, text = digits[..n], color = mul_alpha{ c = color_menu{}, a = alpha }, x = x + box - tw, y = y + 37, w = tw, h = 19, clip }
    }

    // Writes `n` (not negative) in decimal at the start of `into`; returns how many bytes.
    fn put_digits { into: []mut u8, n: i32 } -> usize {
        let mut tmp: [12]u8
        let mut k: usize = 0
        let mut v = if n < 0 { 0 } else { n }
        while true {
            tmp[k] = @as(u8, 48 + v % 10)
            k = k + 1
            v = v / 10
            if v == 0 or k >= tmp.len { break }
        }
        let mut i: usize = 0
        while i < k and i < into.len {
            into[i] = tmp[k - 1 - i]
            i = i + 1
        }
        return i
    }

    // The scroll bar of a list box (0x00419660): border, thumb and arrows; with DRAWMODE 1 only
    // the arrows, each while scrolling that way is possible.
    fn draw_scrollbar { mut g: Gui, mut frame: render::Frame, p: *Panel, c: *Control, l: ListLayout, alpha: f32, clip: render::Rect } {
        let sb = list::at{ list = p.controls, i = @as(usize, c.scrollbar) }
        let x = p.sx + l.sx
        let y = p.sy + l.sy
        let w = l.sw
        let h = l.sh
        let col = render::Color{ r = 1.0, g = 1.0, b = 1.0, a = alpha }
        let bv = bar_values{ &g, p, c, l }
        // DRAWMODE 1's arrows (0x00418010 / 0x00418030), from the bar's values as they are; the
        // down test lets a one-row window go one further.
        let can_up = bv.visible < bv.max and bv.cur >= 1
        let end = if bv.visible < 2 and bv.cur != bv.max { bv.max + 1 } else { bv.max }
        let can_down = bv.visible < bv.max and bv.cur + bv.visible < end
        if sb.draw_mode == 0 {
            draw_border{ &g, &frame, b = sb.border, x, y, w, h, alpha, clip, override = no_img{} }
            let t = thumb_of{ l, b = bv }
            if t.h > 0 and sb.thumb.ok {
                put_image{ &frame, img = sb.thumb, x = @as(f32, x), y = @as(f32, p.sy + t.y), w = @as(f32, w), h = @as(f32, t.h), color = col, angle = 0.0, clip }
            }
        }
        if sb.arrow.ok {
            let aw = @as(f32, w)
            if sb.draw_mode == 0 or can_up {
                put_image{ &frame, img = sb.arrow, x = @as(f32, x), y = @as(f32, y), w = aw, h = aw, color = col, angle = 0.0, clip }
            }
            if sb.draw_mode == 0 or can_down {
                put_image{ &frame, img = sb.arrow, x = @as(f32, x), y = @as(f32, y + h - w), w = aw, h = aw, color = col, angle = PI, clip }
            }
        }
    }
}
