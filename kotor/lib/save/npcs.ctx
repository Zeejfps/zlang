// The party's companions between modules and in saves (party-items-saves.md 3.3, 3.4): each NPC
// slot's creature is kept whole in the game in progress as AVAILNPC<n>.utc (SaveNPCState) when
// the player leaves a module or saves; the members of the active party are remembered in
// `w.party.saved_*` and made again from those files next to the player when a module is entered
// (RestoreParty), or wherever the file says when a save is loaded.
//
//   try save::keep_party{ &w }                  // before the module's objects go
//   try save::restore_party{ &w, at_saved = false }
namespace save {
    const KIND_UTC: u16 = 2027

    // "availnpc<n>" into `into`.
    fn npc_name { slot: usize, into: []mut u8 } -> []u8 {
        let base = "availnpc"
        let mut n: usize = 0
        while n < base.len {
            into[n] = base[n]
            n = n + 1
        }
        if slot >= 10 {
            into[n] = @trunc(u8, '0' + slot / 10)
            n = n + 1
        }
        into[n] = @trunc(u8, '0' + slot % 10)
        return into[..n + 1]
    }

    // SaveNPCState: the slot's creature, whole, into the game in progress.
    fn save_npc { mut w: world::World, slot: usize } -> ! {
        let id = w.party.npcs[slot]
        let o = world::object{ w = &w, id } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let mut b = try gffw::new(arena::Arena){ realloc = arena::alloc, heap = w.scratch, tag = "UTC " }
        try write_creature{ &b, &w, s = gffw::ROOT, o, c }
        let bytes = try gffw::finish{ &b, layout = gffw::ENGINE }
        let mut buf: [16]u8
        try put{ st = &w.gip, name = npc_name{ slot, into = buf[..] }, kind = KIND_UTC, bytes }
    }

    // Every spawned companion into the game in progress, and who is in the active party (in
    // order, the leader too) into `w.party.saved_*`.
    fn keep_party { mut w: world::World } -> ! {
        party::prune{ &w }
        let mut s: usize = 0
        while s < party::SLOTS {
            if world::is_valid{ w = &w, id = w.party.npcs[s] } { try save_npc{ &w, slot = s } }
            s = s + 1
        }
        w.party.saved_slots = [-1; 3]
        w.party.saved_count = 0
        w.party.saved_leader = -1
        let members = party::members{ w = &w }
        let mut k: usize = 0
        while k < members.len {
            let slot = party::slot_of{ w = &w, id = members[k] }
            if slot >= 0 and w.party.saved_count < 3 {
                w.party.saved_slots[w.party.saved_count] = slot
                w.party.saved_count = w.party.saved_count + 1
                if k == 0 { w.party.saved_leader = slot }
            }
            k = k + 1
        }
    }

    // A companion made again from its AVAILNPC file (null when there is none).
    fn npc_from_store { mut w: world::World, slot: usize } -> !?u32 {
        let mut buf: [16]u8
        let bytes = get{ st = &w.gip, name = npc_name{ slot, into = buf[..] }, kind = KIND_UTC } ifnull { return null }
        let doc = try gff::parse{ data = bytes, realloc = arena::alloc, heap = w.scratch }
        let saved_id = @trunc(u32, gff::get_number{ doc, s = gff::ROOT, label = "ObjectId" } ifnull 0)
        let fresh = saved_id != 0 and saved_id != obj::INVALID and not world::id_taken{ w = &w, id = saved_id }
        let o = try world::add_object{ &w, kind = obj::Kind::creature, id = if fresh { saved_id } else { 0 }, character = false }
        o.area = w.area
        o.position = math::Vec3{ x = tmpl::real{ doc = &doc, s = gff::ROOT, label = "XPosition", default = 0.0 }, y = tmpl::real{ doc = &doc, s = gff::ROOT, label = "YPosition", default = 0.0 }, z = tmpl::real{ doc = &doc, s = gff::ROOT, label = "ZPosition", default = 0.0 } }
        world::set_orientation{ o, v = math::Vec3{ x = tmpl::real{ doc = &doc, s = gff::ROOT, label = "XOrientation", default = 0.0 }, y = tmpl::real{ doc = &doc, s = gff::ROOT, label = "YOrientation", default = 1.0 }, z = 0.0 } }
        try tmpl::read{ &w, o, doc = &doc, s = gff::ROOT }
        // Its OnSpawn runs again on its first update: the original makes it with GetNPCObject
        // (0x00564700), a new creature (spawn flag +0x34c clear) read by LoadFromTemplate, which
        // leaves CreatnScrptFird unread (only LoadCreature reads it).
        if obj::creature{ o } is some{ value = c } { c.spawn_fired = false }
        return o.id
    }

    // SwitchPlayerCharacter puts the player's own character aside (CSWPartyTable::SwitchPlayerCharacter 0x005667c0 writes it
    // to GAMEINPROGRESS:PC): the whole creature, its equipment too, as "pc" in the game in progress, so a module change and
    // a save carry it. The caller removes the object.
    fn park_player { mut w: world::World } -> ! {
        let o = world::object{ w = &w, id = w.player } ifnull { return }
        let c = obj::creature{ o } ifnull { return }
        let mut b = try gffw::new(arena::Arena){ realloc = arena::alloc, heap = w.scratch, tag = "UTC " }
        try write_creature{ &b, &w, s = gffw::ROOT, o, c }
        let bytes = try gffw::finish{ &b, layout = gffw::ENGINE }
        try put{ st = &w.gip, name = "pc", kind = KIND_UTC, bytes }
    }

    // Whether a character is parked (park_player), and forgetting it.
    fn has_parked_player { w: *world::World } -> bool { return get{ st = &w.gip, name = "pc", kind = KIND_UTC } != null }

    // The parked player character made again at `at`, facing `facing` (null: none is parked). It is the player's character
    // from the moment it is read, as restore_player has it: its rules use the level history.
    fn pc_from_store { mut w: world::World, at: math::Vec3, facing: math::Vec3 } -> !?u32 {
        let bytes = get{ st = &w.gip, name = "pc", kind = KIND_UTC } ifnull { return null }
        let doc = try gff::parse{ data = bytes, realloc = arena::alloc, heap = w.scratch }
        let saved_id = @trunc(u32, gff::get_number{ doc, s = gff::ROOT, label = "ObjectId" } ifnull 0)
        let fresh = saved_id != 0 and saved_id != obj::INVALID and world::object{ w = &w, id = saved_id } == null
        let o = try world::add_object{ &w, kind = obj::Kind::creature, id = if fresh { saved_id } else { 0 }, character = not fresh }
        w.player = o.id
        o.area = w.area
        o.position = at
        world::set_orientation{ o, v = facing }
        try tmpl::read{ &w, o, doc = &doc, s = gff::ROOT }
        if obj::creature{ o } is some{ value = c } {
            c.is_pc = true
            c.spawn_fired = tmpl::hench_spawn_fired{ o, c }
            tmpl::set_rate{ &w, c, row = 0 }
        }
        o.ai_level = 4
        movement::place{ &w, id = o.id, at }
        remove{ st = &w.gip, name = "pc", kind = KIND_UTC }
        return o.id
    }

    // RestoreParty: the remembered members come back, from their AVAILNPC files (else their
    // blueprints), next to the player (or where the file says, for a loaded save), joined to the
    // party under the player's control.
    fn restore_party { mut w: world::World, at_saved: bool } -> ! {
        if w.party.saved_count == 0 { return }
        let pc = world::object{ w = &w, id = w.pc } ifnull { return }
        let base = pc.position
        let facing = pc.orientation
        let mut k: usize = 0
        while k < w.party.saved_count {
            let slot = w.party.saved_slots[k]
            k = k + 1
            if slot < 0 or slot >= @as(i32, party::SLOTS) { continue }
            let s = @as(usize, slot)
            let mut id = obj::INVALID
            let fresh = not world::is_valid{ w = &w, id = w.party.npcs[s] }
            if fresh {
                let made = try npc_from_store{ &w, slot = s }
                if made is some{ value = m } { id = m }
                if id == obj::INVALID and not resref::is_empty{ r = w.party.templates[s] } {
                    let mut blueprint = w.party.templates[s]
                    id = tmpl::spawn{ &w, kind = obj::Kind::creature, template = resref::bytes{ r = &blueprint }, position = base, orientation = facing } iferr { obj::INVALID }
                }
            } else {
                id = w.party.npcs[s]
            }
            let o = world::object{ w = &w, id } ifnull { continue }
            w.party.npcs[s] = id
            w.party.available[s] = true
            o.area = w.area
            o.faction = pc.faction
            o.ai_level = 4
            // RestoreParty makes each member with SpawnAvailableNPC, so a member made here runs its
            // OnSpawn (npc_from_store); one already in the world keeps its flag.
            if not fresh {
                if obj::creature{ o } is some{ value = c } { c.spawn_fired = tmpl::hench_spawn_fired{ o, c } }
            }
            actions::clear_all{ &w, id }
            // Behind the player, one to each side (ours: the original fades them in where the
            // file says and lets them catch up).
            let side: f32 = if k % 2 == 1 { -1.0 } else { 1.0 }
            let at = if at_saved { o.position } else { math::Vec3{
                x = base.x - facing.x * 1.5 + facing.y * side * 1.0,
                y = base.y - facing.y * 1.5 - facing.x * side * 1.0,
                z = base.z,
            } }
            if at_saved { movement::place_loaded{ &w, id, at } } else { movement::place{ &w, id, at } }
            if not at_saved { world::set_orientation{ o, v = facing } }
            _ = party::add{ &w, id }
        }
        if w.party.saved_leader >= 0 {
            let lead = w.party.npcs[@as(usize, w.party.saved_leader)]
            if world::is_valid{ w = &w, id = lead } {
                party::set_leader{ &w, id = lead }
                w.pc = lead
            }
        }
        w.party.saved_count = 0
    }

    // ---- the party's inventory (INVENTORY.res, GFF "INV ": ItemList of whole items)

    const KIND_RES: u16 = 0

    // SaveInventory: the party's inventory into the game in progress.
    fn keep_inventory { mut w: world::World } -> ! {
        let mut b = try gffw::new(arena::Arena){ realloc = arena::alloc, heap = w.scratch, tag = "INV " }
        let list = try gffw::put_list{ &b, owner = gffw::ROOT, label = "ItemList" }
        let items = list::items{ list = w.bag }
        let mut k: usize = 0
        while k < items.len {
            let io = world::object{ w = &w, id = items[k] }
            k = k + 1
            if io is some{ value = o } {
                if obj::item{ o } is some{ value = it } {
                    let e = try gffw::add_element{ &b, list, id = 0 }
                    try write_item{ &b, &w, s = e, o, i = it }
                }
            }
        }
        let bytes = try gffw::finish{ &b, layout = gffw::ENGINE }
        try put{ st = &w.gip, name = "inventory", kind = KIND_RES, bytes }
    }

    // The party's inventory from the game in progress (a loaded save): its items made whole, in
    // the bag, the player's (an inventory already there is replaced).
    fn restore_inventory { mut w: world::World } -> ! {
        let bytes = get{ st = &w.gip, name = "inventory", kind = KIND_RES } ifnull { return }
        let doc = try gff::parse{ data = bytes, realloc = arena::alloc, heap = w.scratch }
        // The bag's old items go. destroy() takes an item out of its holder's list, so walk a
        // copy of the ids and clear the bag first (walking the list itself skipped every other one).
        let old = try alloc::resize(u32, arena::Arena){ realloc = arena::alloc, heap = w.scratch, mem = slice::empty(u32){}, count = w.bag.len }
        slice::copy(u32){ dst = old, src = list::items{ list = w.bag } }
        list::clear{ list = &w.bag }
        let mut k: usize = 0
        while k < old.len {
            world::destroy{ &w, id = old[k] }
            k = k + 1
        }
        let list = gff::get_list{ doc, s = gff::ROOT, label = "ItemList" } ifnull { return }
        k = 0
        while k < list.len {
            let e = list[k]
            k = k + 1
            let id = tmpl::item_of{ &w, doc = &doc, s = e, label = "TemplateResRef", possessor = w.player } ifnull { continue }
            list::push{ list = &w.bag, item = id } iferr {}
        }
    }
}
