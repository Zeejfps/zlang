// serve's main, and what runs concurrently: the log's writer, the acceptor, and a task per
// connection (main.ctx's header says what the program does).

// The journal's buffer, and the writer's: a burst of lines this large waits for the disk.
const JOURNAL_SIZE: usize = 1048576

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, mut net: Net, mut threads: Threads, mut stop: Stop, mut clock: Clock, args: Args } -> i32 {
    let mut err = io::to_stderr{ &io }
    let options = parse_options{ args } iferr err{ error } {
        if error is bad_usage{ why } { _ = @fmt(&err, "serve: {}\n", why) }
        _ = @fmt(&err, "{}", USAGE)
        return 2
    }
    if not (fs::size{ &fs, path = options.root } is fs::is_directory) {
        _ = @fmt(&err, "serve: {} is no directory\n", options.root)
        return 1
    }
    let listener = net::listen{ &net, address = options.address, backlog = 0 } iferr err{ error } {
        // Address's writer is a Builder's only (docs/todo/friction.md, 45).
        let mut buf: [128]u8
        let mut heap = arena::new{ buf = buf[..] }
        let mut b = utf8::builder(arena::Arena){ realloc = arena::alloc, &heap }
        _ = @fmt(&b, "{}", options.address)
        _ = @fmt(&err, "serve: can't listen on {}: {}\n", utf8::view{ b }.bytes, error)
        return 1
    }
    defer net::close_listener{ &net, listener }
    let at = net::listener_address{ &net, listener } iferr { options.address }
    let buffers = mem::pages{ &mem, size = 2 * JOURNAL_SIZE } ifnull {
        _ = @fmt(&err, "serve: no memory for the log\n")
        return 1
    }
    let mut site = site::Site{
        root = options.root,
        started_ns = clock::read_monotonic{ &clock },
        stopping = 0,
        connections_most = options.connections,
        stats = site::Stats{ accepted = 0, refused = 0, open = 0, failed = 0, dropped = 0, requests = 0, status_2xx = 0, status_3xx = 0, status_4xx = 0, status_5xx = 0, bytes = 0 },
        journal = access::make_journal{ buffer = buffers[..JOURNAL_SIZE] },
    }
    let r = run{ &io, &fs, &mem, &net, &threads, &stop, &clock, listener, at, site = &site, batch = buffers[JOURNAL_SIZE..], grace_ns = options.grace_ns }
    if r is err{ error } {
        _ = @fmt(&err, "serve: {}\n", error)
        return 1
    }
    return 0
}

// A line of the server's own, through the journal as the access log's lines go: its time,
// `serve:`, and the text the builder `write` writes.
fn say { mut clock: Clock, site: *mut site::Site, write: &fn{ mut b: utf8::Builder(arena::Arena) } -> ! } {
    let mut buf: [2048]u8
    let mut heap = arena::new{ buf = buf[..] }
    let mut b = utf8::builder(arena::Arena){ realloc = arena::alloc, &heap }
    access::push_stamp{ &b, unix_ns = clock::read_wall{ &clock } } iferr {}
    utf8::push{ &b, s = " serve: " } iferr {}
    write{ &b } iferr {}
    utf8::push{ &b, s = "\n" } iferr {}
    access::append{ journal = &site.journal, bytes = utf8::view{ b }.bytes }
}

fn write_serving { mut b: utf8::Builder(arena::Arena), root: []u8, at: net::Address } -> ! {
    try @fmt(&b, "serving {} at http://{}/", root, at)
}

fn write_count { mut b: utf8::Builder(arena::Arena), text: []u8, n: u64, rest: []u8 } -> ! {
    try @fmt(&b, "{}{}{}", text, n, rest)
}

fn write_failure { mut b: utf8::Builder(arena::Arena), failure: error } -> ! {
    try @fmt(&b, "a connection failed: {}", failure)
}

// Serves until the program is asked to stop, then stops gracefully. The group and the tasks'
// handles are this function's locals: however it returns, every task has ended first.
//
// The connections' group keeps its failures (spec §17, `task`): a connection that fails ends
// alone, and its error waits in the group to be logged. Only the group's holder reads them: the
// acceptor while it runs (accept_into), and this function once the acceptor has ended.
fn run { mut io: Io, mut fs: Fs, mut mem: Mem, mut net: Net, mut threads: Threads, mut stop: Stop, mut clock: Clock, listener: net::Listener, at: net::Address, site: *mut site::Site, batch: []mut u8, grace_ns: u64 } -> ! {
    let mut writer: task::Task(!)
    try task::start_concurrent{ &threads, task = &writer, run = access::run_writer{ &io, &threads, journal = &site.journal, batch, _ } }
    // The writer ends once it has written every line: the last is the one that says so.
    defer access::close_journal{ journal = &site.journal }
    say{ &clock, site, write = write_serving{ root = site.root, at, _ } }

    let mut connections = task::Group{ failures = task::Failures::keep, .. }
    let mut acceptor: task::Task(!)
    try task::start_concurrent{ &threads, task = &acceptor, run = accept_into{ &fs, &mem, &net, &threads, &stop, &clock, listener, site, &connections, _ } }
    let reason = try stop::wait{ &stop }
    @atomic_store(&site.stopping, 1)
    // No new connections. The acceptor's own error, if it failed, is what the program ends with.
    let accepting = task::cancel{ &threads, task = &acceptor }
    let failed = if accepting is err{ error } { not (error is task::cancelled) } else { false }
    let grace = if reason is terminate { @min(grace_ns, 3000000000) } else { grace_ns }
    say{ &clock, site, write = write_count{ text = "stopping: ", n = @atomic_load_relaxed(&site.stats.open), rest = " connections open", _ } }
    if task::wait_all_for{ &threads, group = &connections, nanoseconds = grace } {
        // A keep group's wait_all doesn't fail: what its tasks failed with is still held.
        try task::wait_all{ &threads, group = &connections }
        read_failures{ &threads, &clock, site, &connections }
    } else {
        // What failed in the grace period is logged before cancel_all drops it; what the
        // cancel ends fails with `cancelled`, which is the stop's, not the connections'.
        read_failures{ &threads, &clock, site, &connections }
        say{ &clock, site, write = write_count{ text = "grace period over: cancelling ", n = @atomic_load_relaxed(&site.stats.open), rest = " connections", _ } }
        task::cancel_all{ &threads, group = &connections }
    }
    say{ &clock, site, write = write_count{ text = "stopped after ", n = @atomic_load_relaxed(&site.stats.requests), rest = " requests", _ } }
    if failed { return accepting }
}

// How long an accept waits before the acceptor looks at the connections' failures: a failure
// is logged at most this long after it happened, when no client connects meanwhile.
const LOOK_NS: u64 = 1000000000

// Accepts until cancelled, starting a task in `connections` for each. An error it can't go on
// after (the listener broke) asks the program to stop, as Ctrl-C would, and is its result.
// It logs the connections' failures after each accept, and once LOOK_NS pass without one.
fn accept_into { mut fs: Fs, mut mem: Mem, mut net: Net, mut threads: Threads, mut stop: Stop, mut clock: Clock, listener: net::Listener, site: *mut site::Site, mut connections: task::Group } -> ! {
    while true {
        read_failures{ &threads, &clock, site, &connections }
        let socket = task::run_within{ cancel = &threads, nanoseconds = LOOK_NS, run = net::accept{ &net, listener, _ } } iferr err{ error } {
            match error {
                task::deadline_passed => { continue }                   // no client: look again
                net::aborted => { continue }                            // a client gave up while queued
                net::too_many_open => {
                    thread::sleep{ &threads, nanoseconds = 100000000 }  // let connections end
                    continue
                }
                task::cancelled => { return error }
                else => {
                    stop::ask{ &stop, reason = stop::Reason::terminate } iferr {}
                    return error
                }
            }
        }
        _ = @atomic_add_relaxed(&site.stats.accepted, 1)
        if @atomic_load_relaxed(&site.stats.open) >= site.connections_most {
            _ = @atomic_add_relaxed(&site.stats.refused, 1)
            net::close{ &net, socket }                                  // too many: refuse it
            continue
        }
        task::start_concurrent_in{ &threads, group = &connections, run = connection{ &fs, &mem, &net, &clock, socket, site, _ } } iferr {
            _ = @atomic_add_relaxed(&site.stats.refused, 1)
            net::close{ &net, socket }                                  // no thread for it: refuse it
        }
    }
}

// Logs and counts the failures `connections` holds, without waiting for more, and says how
// many the group dropped since the last look: past the 64 it holds (task::KEPT), a failure is
// counted only. Only the group's holder calls it, one at a time, so the counters' loads and
// stores here race with nothing but /stats' reads.
fn read_failures { mut threads: Threads, mut clock: Clock, site: *mut site::Site, mut connections: task::Group } {
    while true {
        // A deadline of 0 gives a failure held already, and fails rather than wait for one.
        let failure = task::run_within{ cancel = &threads, nanoseconds = 0, run = task::wait_failure{ &threads, group = &connections, _ } } iferr { break } ifnull { break }
        _ = @atomic_add_relaxed(&site.stats.failed, 1)
        say{ &clock, site, write = write_failure{ failure, _ } }
    }
    let dropped = task::count_dropped{ &threads, group = &connections }
    let before = @atomic_load_relaxed(&site.stats.dropped)
    if dropped > before {
        @atomic_store_relaxed(&site.stats.dropped, dropped)
        say{ &clock, site, write = write_count{ text = "", n = dropped - before, rest = " more connections failed, unlogged: too many at once", _ } }
    }
}

// A connection's task. An ordinary end (http::Ending: the client finished sending or left the
// connection idle past its head's deadline between requests, a response closed it, or a request
// was refused) isn't a failure: it is how every connection ends. A request that serve_connection
// refused was answered with a status, and is logged here as a request is, since no handler saw
// it, with the connection's age for its duration, since when that head began isn't known. What
// fails the connection (a reset, a head that stalled past its deadline, a handler's error) is
// its error, and fails it alone: the group keeps it for read_failures, and the other
// connections go on.
fn connection { mut fs: Fs, mut mem: Mem, mut net: Net, mut clock: Clock, socket: net::Socket, site: *mut site::Site } -> ! {
    defer net::close{ &net, socket }
    _ = @atomic_add_relaxed(&site.stats.open, 1)
    defer _ = @atomic_subtract_relaxed(&site.stats.open, 1)
    let peer = net::peer_address{ &net, socket } iferr { net::Address{ ip = net::ANY_V4, port = 0 } }
    let mut buffer: [16384]u8
    let mut fields: [100]http::Header
    let mut headers = fields[..]
    let mut conn = http::open{ stream = http::Stream::plain{ socket }, buffer = buffer[..] }
    let began = clock::read_monotonic{ &clock }
    let ending = try http::serve_connection{ &net, &conn, &headers, limits = http::Limits{ .. }, handle = site::answer{ &fs, &mem, &clock, site, peer, _ } }
    if ending is refused{ status } {
        site::record{ site, line = access::Line{
            unix_ns = clock::read_wall{ &clock }, peer, method = "", target = "", version = 11, status, bytes = 0,
            took_ns = clock::read_monotonic{ &clock } - began, failure = null,
        } }
    }
}
