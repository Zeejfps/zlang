// What the server answers: files and directories under the served directory, and /stats.
//
// A connection's task (run.ctx) runs http::serve_connection with `answer` bound to the site
// and the client's address; `answer` runs on that task's thread for each request.
//
//   - GET and HEAD only: anything else is 405, with `Allow: GET, HEAD`.
//   - /stats is the counters (Stats) as JSON.
//   - Any other target is a path under the root (paths.ctx): 400 for one that isn't a path,
//     403 for one outside the root, 404 for one no file can have, or that isn't there.
//   - A file is sent with its Content-Length and its content type by extension (mime.ctx), its
//     body read and sent CHUNK bytes at a time, so a file of any size takes CHUNK bytes of the
//     request's heap and no more. A file that changes size while it is sent ends the connection
//     (the body is cut short, which the client sees), rather than send other bytes than it said.
//   - A directory named without its `/` is redirected (301) to the name with it, so that its
//     page's relative links resolve under it; with it, it is its index.html, or else a listing.
//
// Every response carries Date and Server. Once the program is stopping (Site.stopping), each
// response says `Connection: close`, so that a kept-alive client doesn't send its next request
// to a server about to stop.
namespace site {
    // What every connection's task shares: what is served, read only, and the counters, which
    // are changed and read with atomics only (spec §13, Atomics), since every task writes them.
    struct Site {
        root: []u8,                 // the served directory, without a `/` at its end
        started_ns: u64,            // when the server started, on the monotonic clock
        stopping: u32,              // 1 once the program is stopping
        connections_most: u64,      // connections served at once; past it, one is refused
        stats: Stats,
        journal: access::Journal,   // the access log's lines on their way out
    }

    struct Stats {
        accepted: u64,              // connections accepted
        refused: u64,               // connections closed at once: too many, or no thread for their task
        open: u64,                  // connections being served
        requests: u64,              // requests answered, those refused before a request line included
        status_2xx: u64,
        status_3xx: u64,
        status_4xx: u64,
        status_5xx: u64,
        bytes: u64,                 // body bytes sent
    }

    // A file's body is read and sent this many bytes at a time.
    const CHUNK: usize = 65536

    // A listing's longest name: no file system allows a longer one (a name of 255 UTF-16 units
    // is at most 765 bytes of UTF-8), so one past it is left out of the listing.
    const NAME_MOST: usize = 1024

    // A response's status and the body bytes sent of it so far, for its log line.
    struct Sent { status: u16, bytes: u64 }

    // Answers one request, then writes its log line and counts it.
    fn answer { mut fs: Fs, mut mem: Mem, mut clock: Clock, site: *mut Site, peer: net::Address, mut net: Net, exchange: http::Exchange } -> ! {
        let began = clock::read_monotonic{ &clock }
        let mut sent = Sent{ status = 0, bytes = 0 }
        let request = exchange.request
        // The request's buffers come from the C heap and go back to it when it is answered:
        // a worker's stack stays committed at the deepest it has been (serve/PLAN.md, Findings),
        // so a buffer on it would be paid for by every idle connection whose thread ever ran one.
        let mut h = heap::new{ &mem }
        let r = respond_to{ &fs, &h, &clock, site, &net, exchange, &sent }
        let mut failure: ?error = null
        if r is err{ error } {
            let any: error = error
            failure = any
        }
        record{ site, line = access::Line{
            unix_ns = clock::read_wall{ &clock },
            peer,
            method = request.method,
            target = request.target,
            version = request.version,
            status = if sent.status == 0 { 500 } else { sent.status },
            bytes = sent.bytes,
            took_ns = clock::read_monotonic{ &clock } - began,
            failure,
        } }
        return r
    }

    // Counts an answer, and writes its line.
    fn record { site: *mut Site, line: access::Line } {
        _ = @atomic_add_relaxed(&site.stats.requests, 1)
        _ = @atomic_add_relaxed(&site.stats.bytes, line.bytes)
        let s = line.status
        if s >= 500 {
            _ = @atomic_add_relaxed(&site.stats.status_5xx, 1)
        } else if s >= 400 {
            _ = @atomic_add_relaxed(&site.stats.status_4xx, 1)
        } else if s >= 300 {
            _ = @atomic_add_relaxed(&site.stats.status_3xx, 1)
        } else if s >= 200 {
            _ = @atomic_add_relaxed(&site.stats.status_2xx, 1)
        }
        access::write_line{ journal = &site.journal, line }
    }

    fn respond_to { mut fs: Fs, mut h: heap::Heap, mut clock: Clock, site: *mut Site, mut net: Net, exchange: http::Exchange, mut sent: Sent } -> ! {
        let request = exchange.request
        let head = slice::eq_bytes{ a = request.method, b = "HEAD" }
        if not head and not slice::eq_bytes{ a = request.method, b = "GET" } {
            return send_text{ &net, &clock, site, exchange, &sent, status = 405, allow = true, text = "method not allowed\n" }
        }
        if slice::eq_bytes{ a = paths::find_path{ target = request.target }, b = "/stats" } {
            return send_stats{ &net, &clock, site, exchange, &sent }
        }
        let decoded = make_bytes{ &h, count = request.target.len } ifnull { return alloc::out_of_memory }
        defer free_bytes{ &h, bytes = decoded }
        let resolved = paths::resolve{ target = request.target, into = decoded } iferr err{ error } {
            return match error {
                paths::outside => { send_text{ &net, &clock, site, exchange, &sent, status = 403, allow = false, text = "forbidden\n" } }
                paths::unservable => { send_text{ &net, &clock, site, exchange, &sent, status = 404, allow = false, text = "not found\n" } }
                else => { send_text{ &net, &clock, site, exchange, &sent, status = 400, allow = false, text = "bad request target\n" } }
            }
        }
        let full = make_bytes{ &h, count = site.root.len + 1 + resolved.path.len } ifnull { return alloc::out_of_memory }
        defer free_bytes{ &h, bytes = full }
        let path = join{ root = site.root, path = resolved.path, into = full }
        let size = fs::size{ &fs, path } iferr err{ error } {
            match error {
                fs::is_directory => {
                    if not resolved.slash {
                        return send_redirect{ &net, &clock, site, exchange, &sent, target = request.target }
                    }
                    return send_directory{ &fs, &h, &clock, site, &net, exchange, &sent, dir = path, shown = paths::find_path{ target = request.target } }
                }
                fs::not_found | fs::not_directory => {
                    return send_text{ &net, &clock, site, exchange, &sent, status = 404, allow = false, text = "not found\n" }
                }
                fs::permission_denied => {
                    return send_text{ &net, &clock, site, exchange, &sent, status = 403, allow = false, text = "forbidden\n" }
                }
                else => { return error }
            }
        }
        if resolved.slash {
            // A file named as a directory, `/a.txt/`: no directory is there.
            return send_text{ &net, &clock, site, exchange, &sent, status = 404, allow = false, text = "not found\n" }
        }
        return send_file{ &fs, &h, &clock, site, &net, exchange, &sent, path, size }
    }

    // `count` bytes from the request's heap; null if there isn't the memory. Freed with
    // free_bytes.
    fn make_bytes { mut h: heap::Heap, count: usize } -> ?[]mut u8 {
        return heap::alloc{ heap = &h, mem = slice::empty(u8){}, new = count, align = 1 }
    }

    fn free_bytes { mut h: heap::Heap, bytes: []mut u8 } {
        _ = heap::alloc{ heap = &h, mem = bytes, new = 0, align = 1 }
    }

    // `root` and `path` joined by a `/` into `into`; `root` alone for an empty path.
    fn join { root: []u8, path: []u8, into: []mut u8 } -> []u8 {
        slice::copy(u8){ dst = into[..root.len], src = root }
        if path.len == 0 { return into[..root.len] }
        into[root.len] = '/'
        slice::copy(u8){ dst = into[root.len + 1..root.len + 1 + path.len], src = path }
        return into[..root.len + 1 + path.len]
    }

    // A response's head, with the fields every response has, Date, Server and Content-Type,
    // and `extra`, one at most; and its body if it is `bytes`.
    fn send_head { mut net: Net, mut clock: Clock, site: *mut Site, exchange: http::Exchange, mut sent: Sent, status: u16, content_type: []u8, extra: []http::Header, body: http::Body } -> ! {
        let mut date: [29]u8
        let fields: [4]http::Header = [
            http::Header{ name = "Date", value = access::write_date{ unix_ns = clock::read_wall{ &clock }, into = date[..] } },
            http::Header{ name = "Server", value = "serve" },
            http::Header{ name = "Content-Type", value = content_type },
            if extra.len > 0 { extra[0] } else { http::Header{ name = "", value = "" } },
        ]
        let count: usize = if extra.len > 0 { 4 } else { 3 }
        sent.status = status
        let close = @atomic_load_relaxed(&site.stopping) != 0
        try http::send_response{ &net, conn = exchange.conn, status, headers = fields[..count], body, close }
        if body is bytes{ bytes } {
            if not slice::eq_bytes{ a = exchange.request.method, b = "HEAD" } { sent.bytes = bytes.len }
        }
    }

    // A short text body, for an error; with `allow`, the 405's Allow field.
    fn send_text { mut net: Net, mut clock: Clock, site: *mut Site, exchange: http::Exchange, mut sent: Sent, status: u16, allow: bool, text: []u8 } -> ! {
        let extra: []http::Header = if allow { [http::Header{ name = "Allow", value = "GET, HEAD" }] } else { [] }
        return send_head{ &net, &clock, site, exchange, &sent, status, content_type = "text/plain; charset=utf-8", extra, body = http::Body::bytes{ bytes = text } }
    }

    // 301 to the target's path with a `/` after it, and its query.
    fn send_redirect { mut net: Net, mut clock: Clock, site: *mut Site, exchange: http::Exchange, mut sent: Sent, target: []u8 } -> ! {
        let path = paths::find_path{ target }
        let mut location: [4096]u8
        let rest = target[path.len..]
        let n = path.len + 1 + rest.len
        // A Location this long would crowd the response's head out of the connection's buffer.
        if n > location.len { return send_text{ &net, &clock, site, exchange, &sent, status = 414, allow = false, text = "target too long\n" } }
        slice::copy(u8){ dst = location[..path.len], src = path }
        location[path.len] = '/'
        slice::copy(u8){ dst = location[path.len + 1..n], src = rest }
        let extra: [1]http::Header = [http::Header{ name = "Location", value = location[..n] }]
        return send_head{ &net, &clock, site, exchange, &sent, status = 301, content_type = "text/plain; charset=utf-8", extra = extra[..], body = http::Body::bytes{ bytes = "moved\n" } }
    }

    // A file's body, CHUNK bytes at a time; a response to HEAD has its head only.
    fn send_file { mut fs: Fs, mut h: heap::Heap, mut clock: Clock, site: *mut Site, mut net: Net, exchange: http::Exchange, mut sent: Sent, path: []u8, size: u64 } -> ! {
        let file = fs::open{ &fs, path, mode = fs::Mode::read } iferr err{ error } {
            return match error {
                fs::not_found | fs::not_directory => { send_text{ &net, &clock, site, exchange, &sent, status = 404, allow = false, text = "not found\n" } }
                fs::permission_denied | fs::is_directory => { send_text{ &net, &clock, site, exchange, &sent, status = 403, allow = false, text = "forbidden\n" } }
                else => { error }
            }
        }
        defer fs::close{ &fs, file } iferr {}
        try send_head{ &net, &clock, site, exchange, &sent, status = 200, content_type = mime::find_type{ name = path }, extra = [], body = http::Body::length{ n = size } }
        if not slice::eq_bytes{ a = exchange.request.method, b = "HEAD" } {
            let chunk = make_bytes{ &h, count = @as(usize, @min(size, @as(u64, CHUNK))) } ifnull { return alloc::out_of_memory }
            defer free_bytes{ &h, bytes = chunk }
            let mut left = size
            while left > 0 {
                let want = @as(usize, @min(left, @as(u64, CHUNK)))
                let got = try fs::read{ &fs, file, into = chunk[..want] }
                if got == 0 { break }       // it shrank: finish_body ends the connection
                try http::write_body{ &net, conn = exchange.conn, bytes = chunk[..got] }
                sent.bytes = sent.bytes + got
                left = left - got
            }
        }
        return http::finish_body{ &net, conn = exchange.conn }
    }

    // A directory's index.html, or else its listing.
    fn send_directory { mut fs: Fs, mut h: heap::Heap, mut clock: Clock, site: *mut Site, mut net: Net, exchange: http::Exchange, mut sent: Sent, dir: []u8, shown: []u8 } -> ! {
        // Room for the directory and a name of an entry, index.html's or a listed one's.
        let room = make_bytes{ &h, count = dir.len + 1 + NAME_MOST } ifnull { return alloc::out_of_memory }
        defer free_bytes{ &h, bytes = room }
        let index_path = join{ root = dir, path = "index.html", into = room }
        if fs::size{ &fs, path = index_path } is ok{ value } {
            return send_file{ &fs, &h, &clock, site, &net, exchange, &sent, path = index_path, size = value }
        }
        let names = fs::list(heap::Heap){ &fs, heap = &h, realloc = heap::alloc, path = dir } iferr err{ error } {
            return match error {
                fs::permission_denied => { send_text{ &net, &clock, site, exchange, &sent, status = 403, allow = false, text = "forbidden\n" } }
                fs::not_found | fs::not_directory => { send_text{ &net, &clock, site, exchange, &sent, status = 404, allow = false, text = "not found\n" } }
                else => { error }
            }
        }
        defer fs::list_free(heap::Heap){ heap = &h, realloc = heap::alloc, names }
        let mut page = utf8::builder(heap::Heap){ realloc = heap::alloc, heap = &h }
        defer utf8::free(heap::Heap){ b = &page }
        try write_listing{ &fs, &page, dir, shown, names, room }
        return send_head{ &net, &clock, site, exchange, &sent, status = 200, content_type = "text/html; charset=utf-8", extra = [], body = http::Body::bytes{ bytes = utf8::view{ b = page }.bytes } }
    }

    // A listing's page: each entry a link, a directory's with a `/` after it, `..` first below
    // the root. Names a request couldn't reach (paths.ctx) are left out.
    fn write_listing(S) { mut fs: Fs, mut page: utf8::Builder(S), dir: []u8, shown: []u8, names: [][]u8, room: []mut u8 } -> ! {
        try utf8::push{ b = &page, s = "<!doctype html>\n<meta charset=\"utf-8\">\n<title>Index of " }
        try push_html{ b = &page, text = shown }
        try utf8::push{ b = &page, s = "</title>\n<h1>Index of " }
        try push_html{ b = &page, text = shown }
        try utf8::push{ b = &page, s = "</h1>\n<ul>\n" }
        if shown.len > 1 { try utf8::push{ b = &page, s = "<li><a href=\"../\">../</a>\n" } }
        let mut href: [3 * NAME_MOST]u8
        for name in names {
            if not paths::is_servable{ segment = name } or name.len > NAME_MOST { continue }
            let path = join{ root = dir, path = name, into = room }
            let is_dir = fs::size{ &fs, path } is fs::is_directory
            let n = url::encode_percent{ text = name, into = href[..] }
            try utf8::push{ b = &page, s = "<li><a href=\"" }
            try utf8::push{ b = &page, s = utf8::of{ chars = href[..n] } }
            if is_dir { try utf8::push{ b = &page, s = "/" } }
            try utf8::push{ b = &page, s = "\">" }
            try push_html{ b = &page, text = name }
            if is_dir { try utf8::push{ b = &page, s = "/" } }
            try utf8::push{ b = &page, s = "</a>\n" }
        }
        try utf8::push{ b = &page, s = "</ul>\n" }
    }

    // Text as HTML's text: `&`, `<`, `>`, `"` and `'` as references, and bytes that aren't UTF-8
    // as U+FFFD (utf8::push_bytes).
    fn push_html(S) { mut b: utf8::Builder(S), text: []u8 } -> ! {
        let mut from: usize = 0
        for c at i in text {
            let entity: []u8 = match c {
                '&' => "&amp;", '<' => "&lt;", '>' => "&gt;", '"' => "&quot;", '\'' => "&#39;",
                else => "",
            }
            if entity.len > 0 {
                try utf8::push_bytes{ &b, s = text[from..i] }
                try utf8::push{ &b, s = utf8::of{ chars = entity } }
                from = i + 1
            }
        }
        try utf8::push_bytes{ &b, s = text[from..] }
    }

    // The counters as JSON. Each is read on its own, so they needn't agree to the request.
    fn send_stats { mut net: Net, mut clock: Clock, site: *mut Site, exchange: http::Exchange, mut sent: Sent } -> ! {
        let mut buf: [2048]u8
        let mut heap = arena::new{ buf = buf[..] }
        let mut b = utf8::builder(arena::Arena){ realloc = arena::alloc, &heap }
        let s = &site.stats
        let up = clock::read_monotonic{ &clock } - site.started_ns
        try @fmt(&b, "{{\"connections\": {{\"accepted\": {}, \"open\": {}, \"refused\": {}}}, ",
            @atomic_load_relaxed(&s.accepted), @atomic_load_relaxed(&s.open), @atomic_load_relaxed(&s.refused))
        try @fmt(&b, "\"requests\": {{\"total\": {}, \"2xx\": {}, \"3xx\": {}, \"4xx\": {}, \"5xx\": {}}}, ",
            @atomic_load_relaxed(&s.requests), @atomic_load_relaxed(&s.status_2xx), @atomic_load_relaxed(&s.status_3xx),
            @atomic_load_relaxed(&s.status_4xx), @atomic_load_relaxed(&s.status_5xx))
        try @fmt(&b, "\"bytes_sent\": {}, \"uptime_seconds\": {}.{:03}}}\n", @atomic_load_relaxed(&s.bytes), up / 1000000000, up / 1000000 % 1000)
        return send_head{ &net, &clock, site, exchange, &sent, status = 200, content_type = "application/json", extra = [], body = http::Body::bytes{ bytes = utf8::view{ b }.bytes } }
    }
}
