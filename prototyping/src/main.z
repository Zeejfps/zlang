
impl main {

    uses std.array as array;
    uses std.array.Array as Array;
    uses std.list(std.mem.heap) as heap_list;
    uses std.io as io;
    uses std.stdout as stdout;
    uses std.fmt as fmt;
    uses std.string as string;
    uses std.mem.heap as heap;
    
    func main() {
    
        // Lists
    
        var heap_allocator = heap.create_allocator();
        defer heap.destroy_allocator(heap_allocator);
        
        var my_list = heap_list.create<u8>(heap_allocator);
        defer heap_list.destroy(my_list);

        heap_list.push_item(my_list, 0);

        var first_item = heap_list.get_item(my_list, 0);
        
        std.io.out.write(std.fmt.to_string(first_item));
    } 
}
