// ============================================================================
// json.z  --  a real program written in the unified.z declaration form.
// ============================================================================
//
// The goal here is not the JSON parser. The goal is to find out where the one
// rule
//
//     Name <compile-time args> (runtime args) -> projection { body }
//
// bends, where it breaks, and where it turns out to be doing more work than
// unified.z claims for it.
//
// Everything below is written in unified.z's syntax as-is EXCEPT where marked
// [P#], which points at a numbered proposal in the FINDINGS section at the
// bottom. Where the existing syntax already covered something I expected to
// need an extension for, it is marked [W#] -- those are the load-bearing wins
// and they should not be lost in a later revision.
//
// ============================================================================


// ============================================================================
// imports  --  [P7] no new keyword: `::` is already a compile-time binding and
// `import` is an ordinary compile-time function. `use`/`import` as a statement
// form would be the only declaration in the language that is not `name :: v`.
// ============================================================================

std   :: import("std")
mem   :: std.mem                    // make, drop
io    :: std.io                     // write
list  :: std.list                   // List
fmt   :: std.fmt                    // Formattable, StringWriter, to_string

Allocator :: mem.Allocator
Writer    :: io.Writer
List      :: list.List


// ============================================================================
// std.sum / std.ops  --  ADOPTED, now in unified.z
// ============================================================================
//
// These two sections were the experiment's main output and their rationale has
// moved into unified.z (the HOLES table, and NOTE 6). What stays here is only
// the part unified.z cannot carry: WHERE the need showed up, which is the
// evidence that they are not speculative. See FINDINGS / WHERE SUMS WERE FORCED.
//
// Option, Result, Fn and Fn2 are now std.core; they are no longer declared here.

core   :: std.core
Option :: core.Option
Result :: core.Result
Fn     :: core.Fn
Fn2    :: core.Fn2

unwrap_or :: <T> (o: Option<T>, d: T) -> T {
    match (o) {
        none     { d }
        some (x) { x }
    }
}

is_some :: <T> (o: Option<T>) -> bool {
    match (o) { none { false }  some (_) { true } }
}


// ============================================================================
// std.iter
// ============================================================================
//
// [W1] A generic shape works exactly as NOTE 3 promises. `Iterator<T>` is one
// vtable per T, which is why it is allowed to be a shape at all.

Iterator :: <T> -> self {
    next: (&self) -> Option<T>
}

// [W2] `-> self {}` with only parameters is a plain record, with no new form.
// Params of a `-> self` def ARE the fields, so an empty body is a struct
// declaration. This is one of the strongest results in the whole experiment.
// [P8] make the empty body optional: `Span :: (lo: u32, hi: u32) -> self`.

Span :: (lo: u32, hi: u32) -> self

// A concrete iterator. Note `M` -- see FRICTION 1, it is pure plumbing.
ListIter :: <T, M> (xs: ptr<List<T, M>>) -> self {
    i := 0
    next :: (&self) -> Option<T> {
        if (self.i >= self.xs.count) { return Option<T>.none() }
        v := self.xs.items[self.i]
        self.i += 1
        Option<T>.some(v)
    }
}

iter :: <T, M> (xs: ptr<List<T, M>>) -> ListIter<T, M> { ListIter(xs) }

// Extrinsic, so it can never satisfy a shape (NOTE 4), which is right: `fold`
// is convenience, `next` is the abstraction.
fold :: <T, A, I: Iterator<T>, F: Fn2<A, T, A>> (it: ptr<I>, acc: A, f: F) -> A {
    a := acc
    loop {
        match (it.next()) {
            none    { return a }
            some(v) { a = f(a, v) }          // [P15]: f(a, v) is f.()(a, v)
        }
    }
}


// ============================================================================
// std.key  --  a POLICY, by unified.z's own test: slice<u8> has more than
// one legitimate ordering/hashing (case sensitive or not), so the caller must
// be able to choose.
// ============================================================================
//
// [P11] hash and equals go in ONE policy, not two. Two `= ?` params that
// the solver defaults independently can be defaulted inconsistently -- a
// case-folding hash with a case-sensitive equals is a silently broken map, and
// no type error catches it. Anything that must agree must be one block.
//
// This is a design rule the unified form makes cheap: grouping costs nothing
// because a policy is just a block.

Key :: <K> -> self {
    hash:   (k: K) -> u64
    equals: (a: K, b: K) -> bool
}

// Anonymous -> in the solver pool. This is what `Key<slice<u8>>` resolves to.
:: -> Key<slice<u8>> {
    hash = (k) -> u64 {                          // [P9] projection kept
        h := 14695981039346656037
        for (i := 0; i < k.len; i += 1) {
            h = (h ^ k.ptr[i]) * 1099511628211
        }
        h
    }
    equals = (a, b) -> bool {
        if (a.len != b.len) { return false }
        for (i := 0; i < a.len; i += 1) {
            if (a.ptr[i] != b.ptr[i]) { return false }
        }
        true
    }
}

// Named -> never searched, reachable only by hand: `Map<..., KY = ci_key>`.
ci_key :: -> Key<slice<u8>> {
    hash   = (k) -> u64  { fnv_lower(k) }
    equals = (a, b) -> bool { eq_lower(a, b) }
}


// ============================================================================
// std.map  --  open addressing, robin-hood-free, tombstoned.
// ============================================================================

Map :: <K, V, M: Allocator, KY: Key<K> = ?> (mem: M) -> self {

    // [W3] Nested declarations inside a block capture the block's compile-time
    // args for free. `Entry` is `Entry<K, V>` without ever saying so.
    Entry :: (key: K, value: V) -> self

    Slot :: -> oneof {
        empty: ()
        dead:  ()
        live:  Entry
    }

    cap   := 16
    count := 0
    slots := mem.make<Slot>(cap)                 // UFCS -> make<Slot>(mem, cap)

    // [W4] `-> {a, b}` -- partial projection as a multiple return -- turns out
    // to be the thing you reach for constantly in container code, and reads
    // better than a named result struct because the names are at the call site.
    probe :: (&self, k: K) -> {at: u32, found: bool} {
        i    := KY.hash(k) % self.cap
        free := self.cap                          // sentinel: none seen yet
        loop {
            match (self.slots[i]) {
                empty   { return { at = if (free < self.cap) { free } else { i },
                                   found = false } }
                dead    { if (free == self.cap) { free = i } }
                live(e) { if (KY.equals(e.key, k)) { return { at = i, found = true } } }
            }
            i = (i + 1) % self.cap
        }
    }

    put :: (&self, k: K, v: V) -> () {
        if ((self.count + 1) * 4 > self.cap * 3) { self.regrow() }
        r := self.probe(k)
        if (!r.found) { self.count += 1 }
        self.slots[r.at] = Slot.live(Entry(k, v))
    }

    get :: (&self, k: K) -> Option<V> {
        r := self.probe(k)
        if (!r.found) { return Option<V>.none() }
        match (self.slots[r.at]) {
            live(e) { Option<V>.some(e.value) }
            empty   { Option<V>.none() }          // FRICTION 3: unreachable,
            dead    { Option<V>.none() }          // but must still be written
        }
    }

    remove :: (&self, k: K) -> bool {
        r := self.probe(k)
        if (!r.found) { return false }
        self.slots[r.at] = Slot.dead()
        self.count -= 1
        true
    }

    regrow :: (&self) -> () {
        old     := self.slots
        old_cap := self.cap
        self.cap   = self.cap * 2
        self.slots = self.mem.make<Slot>(self.cap)
        self.count = 0
        for (i := 0; i < old_cap; i += 1) {
            match (old[i]) {
                live(e) { self.put(e.key, e.value) }
                empty   { }
                dead    { }
            }
        }
        self.mem.drop(old)
    }

    deinit :: (&self) -> () { self.mem.drop(self.slots); self.count = 0 }

    [] :: (&self, k: K) -> Option<V> { self.get(k) }    // [P15]
}


// ============================================================================
// json  --  the value type
// ============================================================================
//
// The allocator is a compile-time parameter, which is the whole point of the
// language, and it stays one here. An earlier pass erased it to `ptr<Allocator>`
// to keep the signatures short. That was the wrong default, and it is worth
// knowing what it cost, because `Json` is the element type of its own arrays
// and so the allocator field is stored in EVERY node:
//
//                          M = Heap        M = ptr<Allocator>
//     List<Json<M>, M>     16 bytes        32 bytes      (mem: 0 vs 16)
//     Map<..., M>          16 bytes        32 bytes
//     Json  (max + tag)    24 bytes        40 bytes
//
// -- roughly 40% larger per node, and every alloc through a vtable instead of
// a direct call.
//
// The reason erasure was tempting is not signature noise ([P4]'s `_` handles
// consumers). It is that `M` is VIRAL THROUGH CONTAINING TYPES: a struct with
// a `Json<M>` field must itself become generic, and so must anything holding
// THAT, all the way up. `_` cannot stop it, because a field's type is
// effectively projection position (FRICTION 12).
//
// The answer is to collapse the parameter ONCE, in the application, with an
// alias -- see `Doc` in main. Library code that produces a Json stays generic
// in one parameter; everything downstream names the alias. The residual cost
// is real but narrow: ONE ALLOCATOR PER DOCUMENT TYPE. `Json<Heap>` and
// `Json<Arena>` cannot be compared, merged, or stored in one list. See
// FRICTION 2.

Json :: <M: Allocator> -> oneof {
    null:   ()
    truth:  bool
    number: f64
    text:   slice<u8>
    array:  List<Json<M>, M>
    object: Map<slice<u8>, Json<M>, M>              // [W5] KY defaults here too
}


// ============================================================================
// json.lex
// ============================================================================

Token :: -> oneof {
    lbrace: ();  rbrace:   ()
    lbrack: ();  rbrack:   ()
    colon:  ();  comma:    ()
    text:   slice<u8>
    number: f64
    truth:  bool
    null:   ()
    eof:    ()
}

Error :: (at: u32, why: slice<u8>) -> self

Lexer :: (src: slice<u8>) -> self {

    pos := 0

    at_end :: (&self) -> bool { self.pos >= self.src.len }
    peek   :: (&self) -> u8   { self.src.ptr[self.pos] }

    skip_space :: (&self) -> () {
        while (!self.at_end()) {
            c := self.peek()
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') { return }
            self.pos += 1
        }
    }

    fail :: (&self, why: slice<u8>) -> Result<Token, Error> {
        Result<Token, Error>.err(Error(self.pos, why))
    }

    next :: (&self) -> Result<Token, Error> {
        self.skip_space()
        if (self.at_end()) { return ok(Token.eof()) }    // FRICTION 4

        c := self.peek()
        if (c == '{') { self.pos += 1; return ok(Token.lbrace()) }
        if (c == '}') { self.pos += 1; return ok(Token.rbrace()) }
        if (c == '[') { self.pos += 1; return ok(Token.lbrack()) }
        if (c == ']') { self.pos += 1; return ok(Token.rbrack()) }
        if (c == ':') { self.pos += 1; return ok(Token.colon())  }
        if (c == ',') { self.pos += 1; return ok(Token.comma())  }
        if (c == '"') { return self.lex_text() }
        if (c == '-' || (c >= '0' && c <= '9')) { return self.lex_number() }
        if (self.word("true"))  { return ok(Token.truth(true))  }
        if (self.word("false")) { return ok(Token.truth(false)) }
        if (self.word("null"))  { return ok(Token.null())       }
        self.fail("unexpected character")
    }

    word :: (&self, w: slice<u8>) -> bool {
        if (self.pos + w.len > self.src.len) { return false }
        for (i := 0; i < w.len; i += 1) {
            if (self.src.ptr[self.pos + i] != w.ptr[i]) { return false }
        }
        self.pos += w.len
        true
    }

    lex_text :: (&self) -> Result<Token, Error> {
        self.pos += 1
        start := self.pos
        while (!self.at_end() && self.peek() != '"') {
            if (self.peek() == '\\') { self.pos += 1 }
            self.pos += 1
        }
        if (self.at_end()) { return self.fail("unterminated string") }
        s := slice(self.src.ptr + start, self.pos - start)
        self.pos += 1
        ok(Token.text(s))
    }

    lex_number :: (&self) -> Result<Token, Error> {
        start := self.pos
        if (self.peek() == '-') { self.pos += 1 }
        while (!self.at_end() && is_digit(self.peek())) { self.pos += 1 }
        if (!self.at_end() && self.peek() == '.') {
            self.pos += 1
            while (!self.at_end() && is_digit(self.peek())) { self.pos += 1 }
        }
        ok(Token.number(parse_f64(slice(self.src.ptr + start, self.pos - start))))
    }
}

is_digit :: (c: u8) -> bool { c >= '0' && c <= '9' }


// ============================================================================
// json.parse
// ============================================================================
//
// FRICTION 5. The natural `Parser` primes its lookahead token at construction,
// and priming can fail. A `-> self` block has nowhere to put fallible setup:
// fields initialise in declaration order and there is no constructor body.
//
// [P14] is the general fix -- let the projection wrap self:
//
//     Parser :: (src: slice<u8>) -> Result<self, Error> { ... }
//
// which is just the existing projection rule with `self` allowed inside a type
// rather than only alone. Here I dodge it with a lazily-filled lookahead, which
// is what you would end up writing in C anyway, and costs one Option per peek.

Parser :: <M: Allocator> (lex: ptr<Lexer>, mem: M) -> self {

    look := Option<Token>.none()

    peek :: (&self) -> Result<Token, Error> {
        match (self.look) {
            some (t) { return ok(t) }
            none     { }
        }
        t := try self.lex.next()                  // [P13] `try` propagates err
        self.look = Option<Token>.some(t)
        ok(t)
    }

    bump :: (&self) -> Result<Token, Error> {
        t := try self.peek()
        self.look = Option<Token>.none()
        ok(t)
    }

    expect :: (&self, want: Token, why: slice<u8>) -> Result<(), Error> {
        t := try self.bump()
        if (tag_of(t) != tag_of(want)) {           // FRICTION 7: no tag test
            return Result<(), Error>.err(Error(self.lex.pos, why))
        }
        ok(())
    }

    value :: (&self) -> Result<Json<M>, Error> {
        t := try self.bump()
        match (t) {
            null      { ok(Json.null())      }
            truth (b) { ok(Json.truth(b))    }
            number(n) { ok(Json.number(n))   }
            text  (s) { ok(Json.text(s))     }
            lbrack    { self.array()         }
            lbrace    { self.object()        }
            rbrack    { self.oops("unexpected ]") }
            rbrace    { self.oops("unexpected }") }
            colon     { self.oops("unexpected :") }
            comma     { self.oops("unexpected ,") }
            eof       { self.oops("unexpected end of input") }
        }
    }

    array :: (&self) -> Result<Json<M>, Error> {
        xs := List<Json<M>, M>(self.mem)
        t  := try self.peek()
        match (t) { rbrack { self.bump(); return ok(Json.array(xs)) }  _ { } }
        loop {
            v := try self.value()
            xs.push(v)
            n := try self.bump()
            match (n) {
                comma  { }
                rbrack { return ok(Json.array(xs)) }
                _      { return self.oops("expected , or ]") }
            }
        }
    }

    object :: (&self) -> Result<Json<M>, Error> {
        m := Map<slice<u8>, Json<M>, M>(self.mem)
        t := try self.peek()
        match (t) { rbrace { self.bump(); return ok(Json.object(m)) }  _ { } }
        loop {
            k := try self.bump()
            key := match (k) {
                text (s) { s }
                _        { return self.oops("expected object key") }
            }
            try self.expect(Token.colon(), "expected :")
            v := try self.value()
            m.put(key, v)
            n := try self.bump()
            match (n) {
                comma  { }
                rbrace { return ok(Json.object(m)) }
                _      { return self.oops("expected , or }") }
            }
        }
    }

    oops :: <T> (&self, why: slice<u8>) -> Result<T, Error> {
        Result<T, Error>.err(Error(self.lex.pos, why))
    }
}

parse :: <M: Allocator> (mem: M, src: slice<u8>) -> Result<Json<M>, Error> {
    lx := Lexer(src)
    p  := Parser(&lx, mem)
    v  := try p.value()
    t  := try p.bump()
    match (t) { eof { ok(v) }  _ { p.oops("trailing input") } }
}


// ============================================================================
// json.print  --  a derived Formattable instance, as an ordinary def (NOTE 5)
// ============================================================================

:: <M> -> fmt.Formattable<Json<M>> {
    format = (v, w) -> () {
        match (v) {
            null      { w.write("null") }
            truth (b) { w.write(if (b) { "true" } else { "false" }) }
            number(n) { fmt.Formattable<f64>.format(n, w) }
            text  (s) { w.write("\""); write_escaped(s, w); w.write("\"") }

            array (xs) {
                w.write("[")
                for (i := 0; i < xs.count; i += 1) {
                    if (i > 0) { w.write(",") }
                    self.format(xs[i], w)          // this instance; see NOTE 7
                }
                w.write("]")
            }

            object (m) {
                w.write("{")
                first := true
                for (i := 0; i < m.cap; i += 1) {
                    match (m.slots[i]) {
                        live (e) {
                            if (!first) { w.write(",") }
                            first = false
                            w.write("\""); write_escaped(e.key, w); w.write("\":")
                            self.format(e.value, w)
                        }
                        empty { }
                        dead  { }
                    }
                }
                w.write("}")
            }
        }
    }
}

// ----------------------------------------------------------------------------
// `spaced` -- a SECOND Formattable<Json>. Named, so it is never searched; the
// caller reaches it by hand with `<F = spaced>`.
//
// It differs from the pooled instance in exactly one character: `", "` instead
// of `","`. Everything else delegates. It is what found FRICTION 11.
//
// READ THE THREE SELF-REFERENCES BELOW. Two are recursion (`self`) and one is
// deliberate delegation (`Formattable<Json>`). Before `self` existed all three
// were the same text, and two of them were silently wrong -- which is what
// FRICTION 11 was.
// ----------------------------------------------------------------------------

spaced :: <M> -> fmt.Formattable<Json<M>> {
    format = (v, w) -> () {
        match (v) {

            array (xs) {
                w.write("[")
                for (i := 0; i < xs.count; i += 1) {
                    if (i > 0) { w.write(", ") }          // the only difference
                    self.format(xs[i], w)
                    //  ^^^^ THIS INSTANCE. `xs[i]` is a Json, so printing it
                    //  must stay in `spaced` or the space is lost one level
                    //  down. `self` is available because this block has no
                    //  runtime group: it IS its value, so there is exactly one
                    //  and nothing needs passing.
                }
                w.write("]")
            }

            object (m) {
                w.write("{")
                first := true
                for (i := 0; i < m.cap; i += 1) {
                    match (m.slots[i]) {
                        live (e) {
                            if (!first) { w.write(", ") }
                            first = false
                            w.write("\""); write_escaped(e.key, w); w.write("\": ")
                            self.format(e.value, w)            // this instance, same reason
                        }
                        empty { }
                        dead  { }
                    }
                }
                w.write("}")
            }

            _ { fmt.Formattable<Json<M>>.format(v, w) }
            //  ^^^^^^^^^^^^^^^^^^^^^^^ THE DEFAULT, on purpose. null, bool,
            //  number and string contain no Json, so there is nothing to
            //  recurse into and delegating is exactly right. Both spellings
            //  are needed in one instance, and they now read differently.
        }
    }
}

// WHAT IT PRINTS.  Source: {"name":"z","tags":[1,2,3],"ok":true}
//
//     to_string(heap, doc)                 {"name":"z","tags":[1,2,3],"ok":true}
//     to_string<F = spaced>(heap, doc)     {"name": "z", "tags": [1, 2, 3], "ok": true}
//
// The override now reaches all the way down. Written with
// `fmt.Formattable<Json>.format` in the array arm instead, it would print
//
//                                          {"name": "z", "tags": [1,2,3], "ok": true}
//                                                                 ^^^^^^^
// -- spaced at the top level, default underneath, with no type error available
// to catch it, because both spellings have the same type and one of them is
// what you wanted. That was FRICTION 11.
//
// A NAMED instance could also have written `spaced.format(...)`, which is
// ordinary recursion and needs no new rule. `self` is preferred because the
// anonymous pooled instances have no name by construction, and because a
// parameterised instance would otherwise have to re-thread its own
// compile-time arguments by hand. See NOTE 7 in unified.z.

write_escaped :: (s: slice<u8>, w: ptr<Writer>) -> () {
    for (i := 0; i < s.len; i += 1) {
        c := s.ptr[i]
        if (c == '"')  { w.write("\\\""); continue }
        if (c == '\\') { w.write("\\\\"); continue }
        if (c == '\n') { w.write("\\n");  continue }
        w.write_bytes(&c, 1)
    }
}


// ============================================================================
// a small query layer, to exercise closures and iterators
// ============================================================================

// [P15] in action: a closure is a block with a `()` member, so it satisfies
// `Fn2` structurally and needs no function-type machinery.
// A pure consumer, so [P4] applies: `_` declines to name the allocator.
sum_numbers :: (a: f64, v: Json<_>) -> f64 {
    match (v) { number (n) { a + n }  _ { a } }
}

// Erased callback. A shape in a RUNTIME group already means ptr<Shape>, so
// `f: Fn2<...>` is the fat pointer. Note the sugar is params-only: the type
// ARGUMENT in `List<Json, ptr<Allocator>>` below still spells the pointer.
// `M` must be NAMED here: it appears twice and the two must be the same type.
// Two `_` would be two independent fresh parameters. See FRICTION 12.
each_child :: <M> (v: Json<M>, f: Fn2<slice<u8>, Json<M>, ()>) -> () {
    match (v) {
        object (m) {
            for (i := 0; i < m.cap; i += 1) {
                match (m.slots[i]) { live (e) { f(e.key, e.value) }  _ { } }
            }
        }
        array (xs) {
            for (i := 0; i < xs.count; i += 1) { f("", xs[i]) }
        }
        _ { }
    }
}

// A named closure declaration -- two runtime groups, curried, per unified.z.
// Under [P15] this is sugar for a `-> self` block with a `()` member, so the
// last OPEN question in unified.z answers itself: it has its own type, and it
// becomes a shared type exactly when you write `ptr<Fn2<...>>`.
// `&u32`, not `ptr<u32>`: a place parameter, which is `&self` without the
// special case. It cannot be stored -- a `&T` field is forbidden -- so the
// signature now says "I write through this and do not keep it".
tally :: <M> (out: &u32) (k: slice<u8>, v: Json<M>) -> () {
    out += 1
}


// ============================================================================
// main
// ============================================================================

main :: () -> () {
    heap  := mem.Heap()
    arena := mem.Arena(page, 1 << 20)

    // ONE LINE COLLAPSES THE PARAMETER for the whole application. Everything
    // below says `Doc`; no signature here mentions an allocator; calls stay
    // direct and the allocator field stays out of every node.
    //
    // Note `ptr<Arena>` is still MONOMORPHIC -- the pointee type is known, so
    // dispatch is direct and only the pointer is stored. It is `ptr<Allocator>`,
    // a pointer to a SHAPE, that costs a fat pointer and indirect calls. The
    // pointer is here only because Arena has mutable state to share.
    Doc :: Json<ptr<Arena>>

    src := "{\"name\":\"z\",\"tags\":[1,2,3],\"ok\":true}"

    match (parse(&arena, src)) {          // -> Result<Doc, Error>
        err (e) {
            io.out.write("parse error at ")
            io.out.write(fmt.to_string(heap, e.at))
            io.out.write(": ")
            io.out.write(e.why)
        }
        ok (doc) {
            // round-trip
            io.out.write(fmt.to_string(heap, doc))

            // Override the solver by naming the instance, and the override
            // now reaches the children. See the note above `spaced`.
            //
            //   {"name": "z", "tags": [1, 2, 3], "ok": true}
            io.out.write(fmt.to_string<F = spaced>(heap, doc))

            // NO PYRAMID. `match` is an EXPRESSION, so a one-arm-plus-`_`
            // match BINDS rather than nesting -- each line either produces a
            // value or leaves. Four levels of arrow-code become four lines,
            // with nothing added to the language.
            obj  := match (doc)         { object (o) { o }  _ { return } }
            tags := match (obj["tags"]) { some   (t) { t }  _ { return } }
            xs   := match (tags)        { array  (a) { a }  _ { return } }

            // iterate an array through the Iterator shape
            it    := iter(&xs)
            total := fold(&it, 0.0, sum_numbers)
            io.out.write(fmt.to_string(heap, total))                  // 6

            // closure + erasure
            n := 0
            each_child(doc, &tally(&n))
            io.out.write(fmt.to_string(heap, n))                      // 3
        }
    }
}


// ============================================================================
// ============================================================================
//
//                                F I N D I N G S
//
// ============================================================================
// ============================================================================
//
//
// ----------------------------------------------------------------------------
// WHAT HELD UP  (do not lose these in a revision)
// ----------------------------------------------------------------------------
//
// [W1] Generic shapes. `Iterator<T>` as a shape works and NOTE 3's rule for
//      when that is allowed (multiply the vtables, do not add defaults) held
//      for every case I hit.
//
// [W2] `X :: (a: A, b: B) -> self {}` is a struct declaration, with no struct
//      form. "Runtime params of a `-> self` def ARE fields" is the single
//      highest-value line in unified.z. `Entry`, `Span` and `Error` above are
//      one line each and read better than a `struct` keyword would.
//
// [W3] Nested declarations capture the enclosing block's compile-time args.
//      `Entry` inside `Map` is `Entry<K,V>` without saying so, and `Slot` is a
//      sum over it. No `where`, no re-declaration.
//
// [W4] `-> {a, b}` gets used constantly, not occasionally. `probe` returning
//      `{at, found}` is the shape of half of all container internals and the
//      names land at the call site (`r.found`) rather than in a throwaway type.
//
// [W5] `= ?` solver params work in TYPE position, not just call position:
//      `Map<slice<u8>, Json, ptr<Allocator>>` leaves `KY` to the solver. This
//      falls out of policies being zero-sized compile-time bindings, and it
//      is what keeps the JSON type declaration readable.
//
// [W6] "A type in value position is the solver's default instance."
//      `Formattable<Json>.format(...)` inside the anonymous `-> Formattable<Json>`
//      instance is how a recursive instance calls itself. unified.z already
//      relies on this at line 223 and at `reverse_u8`, but never states it.
//      STATE IT -- it is a real rule and it is doing real work.
//
// [W7] The `Tracking` / `ptr<Allocator>` split from NOTE 2 is genuinely nice in
//      practice. Deciding erasure at the `a : ptr<Allocator> := &arena` line and
//      nowhere else is exactly right.
//
//
// ----------------------------------------------------------------------------
// WHERE IT FOUGHT BACK
// ----------------------------------------------------------------------------
//
// FRICTION 1 -- PLUMBING TYPE PARAMETERS. The worst practical problem in the
//   file. `M` in `List<T, M>` is never chosen by anyone, but it must be spelled
//   in every signature that mentions a list:
//
//       ListIter :: <T, M> (xs: ptr<List<T, M>>) -> self
//       fold     :: <T, A, I: Iterator<T>, F: Fn2<A, T, A>> (...)
//       sort     :: <T, M, O: Ord<T> = ?> (xs: ptr<List<T, M>>)   // unified.z
//
//   `sort` declares `M` purely so that `List<T, M>` parses. When the type is
//   recursive (`Json`) it is not merely noise, it is fatal -- see FRICTION 2.
//   -> [P4]
//
// FRICTION 2 -- MONOMORPHISATION IS VIRAL THROUGH CONTAINING TYPES.
//   DOWNGRADED. An earlier pass called this fatal and erased the allocator to
//   `ptr<Allocator>` in the Json declaration. That was wrong, and the erasure
//   cost ~40% per node plus indirect calls (see the note above `Json`).
//
//   What is true: `M` does not stay in signatures, it climbs into DATA. A
//   struct with a `Json<M>` field becomes `Config<M>`, whatever holds that
//   becomes generic too, and `_` cannot stop it because a field's type is
//   effectively projection position (FRICTION 12).
//
//   What is false: that erasure is the only way out. Collapse the parameter
//   once, in the application, with an alias -- `Doc :: Json<ptr<Arena>>`.
//   Library code that PRODUCES a Json stays generic in one parameter; every
//   consumer names the alias. This is the Zig answer and it costs one line.
//
//   THE RESIDUAL COST, which is real and narrow: ONE ALLOCATOR PER DOCUMENT
//   TYPE. `Json<Heap>` and `Json<Arena>` are different types and cannot be
//   compared, merged, or stored in one list. Erasure remains the right call
//   when you actually need that -- heterogeneous documents in one collection,
//   or a plugin boundary where the allocator is not known where the type is
//   declared. It should be the exception, chosen deliberately.
//
// FRICTION 3 -- NO REFUTABLE MATCH, and a pyramid that turned out not to be
//   one. `get` knows the slot is `live` because `probe` said `found`, but the
//   match must still name `empty` and `dead`. Every container grows a tail of
//   dead arms. Wanted: a single-arm form that is an assertion.
//
//   The related worry -- that pulling a value out of four nested sums means
//   four levels of arrow-code -- is NOT a gap. `match` is an expression, so a
//   one-arm-plus-`_` match binds:
//
//       obj  := match (doc)         { object (o) { o }  _ { return } }
//       tags := match (obj["tags"]) { some   (t) { t }  _ { return } }
//       xs   := match (tags)        { array  (a) { a }  _ { return } }
//
//   main used to nest five deep and now does not. `Parser.object` had been
//   using this idiom all along without anyone naming it. Nest only when the
//   failure arms do real work -- main's outer `err (e)` arm prints a message,
//   so it stays a match.
//
//   What is still worth considering is SUGAR, not a missing capability: the
//   `{ arm (v) { v }  _ { return } }` tail repeats. Swift spells it `guard`,
//   Rust `let ... else`. Note that `try` cannot cover it -- `try` propagates
//   the other arms to the caller, and here the arms have the wrong type to
//   propagate (a `Json<M>` cannot be returned from a function whose error
//   type is `Error`). A single-arm binder would need its own `else`.
//
// FRICTION 4 -- `ok(...)` / `err(...)` NEED THE TYPE. Written honestly it is
//   `Result<Token, Error>.ok(t)` at every one of the fourteen returns in the
//   lexer. Inference from the enclosing function's return type is the obvious
//   fix, but note it is inference flowing OUTWARD from the projection into the
//   body, which the language does not otherwise do. Worth deciding deliberately.
//
// FRICTION 5 -- NO FALLIBLE CONSTRUCTION. `-> self` has no constructor body:
//   fields initialise in declaration order and there is nowhere to run a step
//   that can fail, or that needs two fields already set. -> [P14]
//
// FRICTION 6 -- ARITY-INDEXED SHAPES. `Fn`, `Fn2`, `Fn3`. Unavoidable without
//   variadic compile-time args, and cheap enough to live with, but it is the
//   one place the language forces a numbered family of names.
//
// FRICTION 7 -- TAG COMPARISON. `expect(Token.colon())` wants "same variant,
//   ignore payload" and there is no way to say it; `tag_of` above is invented.
//   A sum type needs its discriminant to be a first-class value.
//
// FRICTION 8 -- NO MUTABILITY DISTINCTION. `get` and `put` both take `&self`.
//   Nothing in the language says `get` does not write, so nothing can alias-
//   check, and `ptr<Allocator>` handed to a printer is a fully mutable handle.
//   The binder pair `::`/`:=` already encodes immutable/mutable for BINDINGS;
//   there is no corresponding pair for POINTEES. This is a real hole with no
//   good candidate answer yet -- flagged rather than solved.
//
// FRICTION 9 -- NO VISIBILITY, and see [P5]: the fix is already in the grammar.
//
// FRICTION 11 -- A RECURSIVE INSTANCE COULD NOT NAME ITSELF.  RESOLVED -> [P16]
//
//   Found by trying to write `spaced`, above. A policy is chosen at the
//   CALL SITE, so when an instance recurses it must name a policy again --
//   and naming the type gets the SOLVER'S DEFAULT ([W6]), not the instance the
//   caller picked. `to_string<F = spaced>(mem, doc)` spaced the outermost value
//   and printed every child with the default, silently, one level down.
//
//   It was also invisible: in `spaced` the recursion and the deliberate
//   delegation were the same text, `fmt.Formattable<Json>.format(...)`, in
//   three places, and two of them were wrong.
//
//   Latent in unified.z too: its `Formattable<u8>` instance recursed via
//   `Formattable<u8>.format` and worked only because it happened to BE the
//   pooled instance. A second decimal instance would have recursed into the
//   wrong one.
//
//   FIRST ANSWER, and it is most of the fix: a NAMED instance can just say its
//   own name -- `spaced.format(...)` is ordinary recursion and needs nothing
//   new. That alone drops this from "cannot be expressed" to "expressible".
//   What it does not cover:
//     - anonymous instances have no name BY CONSTRUCTION, since naming one is
//       exactly what removes it from the pool -- so the DEFAULT instance for
//       every type is the one that cannot say its own name;
//     - a parameterised instance must re-thread its own compile-time args, and
//       `pretty.format(...)` instead of `pretty<indent>.format(...)` silently
//       resets every nested level.
//
//   ADOPTED: `self`, available lexically in a block with no runtime group.
//   Not a second meaning -- a receiver exists to say WHICH instance, and a
//   block with no runtime group already IS its value, so there is exactly one.
//
// FRICTION 12 -- `_` DOES NOT REACH PROJECTION POSITION. [P4] cleans up `sort`
//   because `M` appears only in a parameter type. It cannot clean up
//
//       ListIter :: <T, M> (xs: ptr<List<T, M>>) -> self
//       iter     :: <T, M> (xs: ptr<List<T, M>>) -> ListIter<T, M>
//
//   because `iter` must NAME the elided type to spell its own return type. So
//   `_` fixes the consumers of a plumbing parameter and not the wrappers, and
//   FRICTION 1 survives wherever a type is passed through rather than used.
//
//   Two further limits, both hit while parameterising `Json`:
//
//     - `_` CANNOT SAY "THE SAME TYPE I DID NOT NAME". Two `_` are two
//       independent fresh parameters, so
//           each_child :: (v: Json<_>, f: Fn2<slice<u8>, Json<_>, ()>) -> ()
//       does not mean what it reads as, and M has to be named. `sum_numbers`
//       one line above CAN use `_`, because it mentions the type once.
//
//     - A FIELD'S TYPE IS PROJECTION POSITION. `doc: Json<_>` inside a struct
//       would have to introduce a parameter on the struct, which is exactly
//       the propagation `_` was meant to stop. This is why FRICTION 2 needs an
//       alias rather than a wildcard.
//
// FRICTION 10 -- ORDER DEPENDENCE IS UNSTATED.  RESOLVED: order independence
//   is now stated in unified.z, forced a second time by ecs.z (`World` names a
//   `Signal` declared two hundred lines below it) and a third by coherence,
//   which is a whole-program property. `Slot` references `Entry`
//   declared after it; `Json` references `Map` declared after it; the anonymous
//   `Formattable<Json>` instance is found by a solver that must have seen the
//   whole file. Top-level and block-level declarations have to be order-
//   independent. unified.z never says so, and it interacts with the FORWARD
//   DECLARATIONS item already in OPEN.
//
//
// ----------------------------------------------------------------------------
// PROPOSALS
// ----------------------------------------------------------------------------
//
// STATUS. [P1] [P2] [P3] [P4] [P5] [P6] [P8] [P9] [P10] [P11] [P12] [P13] [P14]
// [P15] [P16] are ADOPTED and now live in unified.z; they are kept below because the
// argument for each is the evidence, and the evidence is here. [P7] (import as
// an ordinary compile-time binding) is stated in unified.z's keyword list but
// nothing in either file exercises it yet.
//
// Applying them turned up two things they did NOT fix: FRICTION 11 and 12.
// FRICTION 11 is now closed by [P16]; FRICTION 12 is open.
//
// [P1]  `-> oneof` : the sum projection. A block whose holes are disjunctive.
//         -> self   ALL holes filled (unfilled = abstract = shape/policy)
//         -> oneof  EXACTLY ONE hole filled
//       Construction reuses "`=` fills a declared hole in a literal"
//       (`Option<u8>{some = 3}`), and the derived `Option<u8>.some(3)`.
//       The projection quantifies over HOLES only; `::` members are methods in
//       either kind of block. Spelled `oneof` and not `one` -- `-> T` is already
//       glossed "one value escapes", and a bare `one` in a slot that otherwise
//       holds type names burns a plausible identifier. Spelled bare and not
//       `oneof self`, because a sum does not project the whole block. See the
//       std.sum header for the rejected alternatives.
//       This is the single largest gap in unified.z and the fix adds one word.
//
// [P2]  A match arm is spelled like a declaration: `name (binders) { body }`.
//       No new binding form, no `:` overload, and it composes with `_`.
//
// [P3]  NAMED COMPILE-TIME ARGUMENTS USE `=`, NOT `:`.
//       unified.z line 292 writes `to_string<F: hex_u8>` -- but line 22 says
//       "`:` is type ascription and nothing else", and `hex_u8` is a value.
//       `=` is already "a default in a parameter list"; passing one by name is
//       its exact mirror.  ->  `to_string<F = hex_u8>`, `sort<O = reverse_u8>`.
//       This is the clearest internal contradiction in the current file.
//
// [P4]  `_` AS AN ELIDED COMPILE-TIME ARG IN TYPE POSITION:
//         sort :: <T, O: Ord<T> = ?> (xs: ptr<List<T, _>>) -> ()
//       Reads as "some type I do not name", monomorphises per call, and kills
//       FRICTION 1 everywhere it is not load-bearing. `_` is already wanted as
//       a match wildcard (FRICTION 3), so it is one symbol for one idea:
//       "a binding position I decline to name".
//
// [P5]  PARTIAL PROJECTION IS VISIBILITY. This is already in the grammar and
//       unified.z does not notice it:
//         mem :: -> {make, drop} { make :: ...  drop :: ...  helper :: ... }
//       `-> self` exports everything, `-> {a, b}` exports two names. No `pub`,
//       no `export`, no new rule -- the projection was always the export list.
//       Same mechanism gives a struct private fields.
//
// [P6]  ONE RULE FOR A SHAPE NAME IN VALUE POSITION (answers OPEN #5):
//         shape in `<>`  ->  a static bound; monomorphised.   <M: Allocator>
//         shape in `()`  ->  ptr<Shape>; erased.              (m: Allocator)
//       So `print_u8 :: (m: Allocator) (v: u8)` takes a fat pointer, and the
//       static version is `print_u8 :: <M: Allocator> (m: M) (v: u8)`. The
//       bracket already means compile-time vs runtime; let it mean this too.
//
// [P7]  `import` is an ordinary compile-time function, not a statement.
//       `std :: import("std")` keeps "every declaration is `name :: v`" true.
//
// [P8]  Make the body optional when it would be empty:
//         Span :: (lo: u32, hi: u32) -> self
//       A record is then params-only, which is what it is.
//
// [P9]  LAMBDA LITERALS KEEP THEIR PROJECTION. unified.z writes
//         compare = (a, b) { if (a < b) { return -1 } ... }
//       which is the only callable in the language with no `->`. Write
//         compare = (a, b) -> i32 { ... }
//       and allow eliding the projection ONLY when filling a typed hole, which
//       is the same "elide what is already known" rule as `<T>` inference.
//
// [P10] STATE THE INSTANTIATION RULE, which the file uses but never says:
//         List           a declaration
//         List<u8>       apply compile-time args  ->  a TYPE
//         List<u8>(mem)  apply runtime args       ->  a VALUE
//       Everything about `Heap()` vs `Writer`, and about when `-> self` is a
//       type versus an instance, falls out of this one line.
//
// [P11] A POLICY IS A BLOCK, SO GROUP WHAT MUST AGREE. `Key<K>` carries
//       hash AND equals. Two independently-solved `= ?` params that must be
//       consistent is a silent-corruption bug the type system cannot see.
//
// [P12] SHAPE-vs-POLICY IS A PROPERTY OF THE BLOCK, NOT THE MEMBER. NOTE 1
//       states the test per-member ("first param is self"). A block with one
//       self member and one non-self member is currently well-formed and means
//       nothing. Make it an error, and say the test is: ALL holes take self ->
//       shape; NO hole takes self -> policy.
//
// [P13] `try e` propagates the `err` arm of a `Result` to the enclosing
//       function's projection. Needed by every non-trivial program; the only
//       alternative is `match` at every call, which the parser above shows is
//       unreadable. It is a keyword, but so is `defer`, which unified.z already
//       uses at line 283 without ever introducing it.
//
// [P14] LET THE PROJECTION WRAP `self`:
//         Parser :: (src: slice<u8>) -> Result<self, Error> { ... }
//       `self` is already "the block"; allowing it inside a type rather than
//       only bare is a one-line grammar change that buys fallible construction
//       (FRICTION 5), and also gives `-> Option<self>` and `-> ptr<self>` for
//       free.
//
// [P16] `self` IS AVAILABLE LEXICALLY IN A BLOCK WITH NO RUNTIME GROUP, which
//       is every module and every policy instance. It lets an instance
//       recurse into ITSELF rather than into the solver's default, and makes
//       recursion and delegation read differently:
//
//         self.format(child, w)             the instance I am
//         Formattable<Json>.format(v, w)    the solver's default
//
//       Both are needed -- `reverse_u8` wants the second on purpose. It costs
//       no keyword and is arguably not even a change: `self` already means
//       "the block", and the receiver only ever existed to say which instance.
//       A block with a runtime group is a TYPE, so its members must still take
//       `&self`; bare `self` there is an error, not an implicit receiver.
//       Side effect: settles whether a module's members may say `self`. They
//       may, and it means the module.
//
// [P15] DROP `operator`; OPERATORS ARE MEMBERS WITH SYMBOLIC NAMES.
//         [] :: (&self, i: u32) -> T
//         () :: (&self, v: u8)  -> ()
//       This removes the language's only two-token name AND explains closures:
//       a closure is a block with a `()` member, `Fn<A,R>` is an ordinary
//       shape, and both remaining OPEN questions about `print_u8` answer
//       themselves (it has its own type; erasure is `ptr<Fn<A,R>>`, written
//       exactly like every other shape coercion). Best value-per-character
//       change available.
//
//
// ----------------------------------------------------------------------------
// DEFECTS IN unified.z ITSELF  --  all fixed in the current revision
// ----------------------------------------------------------------------------
//
// Line numbers below refer to the PRE-revision file; the rewrite renumbered
// everything. Kept as a record of what writing a program actually caught.
//
//   line 292  `to_string<F: hex_u8>` contradicted line 22, which says `:` is
//             type ascription and nothing else. `hex_u8` is a value.  -> [P3]
//   line 173  `operator []`, the only two-token name.                 -> [P15]
//   line 188  `compare = (a, b) { ... }`, the only callable with no
//             projection.                                             -> [P9]
//   line 288  `io.out` was used and never declared.
//   line 283  `defer` was used and never introduced.
//   line 145  the UFCS comment read `mem.make<T>(mem, capacity)`; the
//             expansion is `make<T>(mem, capacity)`.
//   line 197  `Ord<u8>.compare(b, a)` inside `reverse_u8 :: -> Ord<u8>` reads
//             as infinite recursion unless [W6] is stated. It now is.
//
// WITHDRAWN. An earlier pass here claimed the field `mem` shadowed the module
// `mem` in `List` and resolved "by accident". It does not: bare `mem` at line
// 145 is the runtime PARAM, which a field initialiser sees directly, and
// `self.mem` in the methods is the same name reached the other way. Both are
// correct. What was actually missing is the rule underneath -- UFCS resolves
// the free function by ordinary lookup in the CALLER's scope -- which is now
// stated, and which turns out to be the same fact NOTE 4 already depends on.
//
//
// ----------------------------------------------------------------------------
// THE ONE-PARAGRAPH VERDICT
// ----------------------------------------------------------------------------
//
// (Written before the revision; it still stands, with one item moved.)
//
// The unification is real and it survives contact with a non-trivial program.
// "Params of a `-> self` def are fields" plus "an unfilled hole is abstract"
// genuinely replaces struct, module, trait, impl and enum-of-one, and the
// shape/policy split is a better answer than Rust's or Go's. The two things
// standing between this and a language you could write in were a sum projection
// ([P1], [P2], `_`, `try`) and an answer to what monomorphisation does to
// recursive data (FRICTION 2). The first is done. The second is not, and it has
// since been joined by FRICTION 11 -- which turned out to be much smaller than
// it first looked, and closed by giving the policy story the `self` it was
// missing. What is left is the monomorphisation one, and it is not syntax.
// ============================================================================
