// ============================================================================
// json.z  --  a real program written in the unified.z declaration form.
// ============================================================================
//
// The goal here is not the JSON parser. The goal is to find out where the one
// rule
//
//     Name <compile-time args> (runtime args) -> projection { body }
//
// bends, where it breaks, and where it turns out to be doing more work than
// unified.z claims for it.
//
// Everything below is written in unified.z's syntax as-is EXCEPT where marked
// [P#], which points at a numbered proposal in the FINDINGS section at the
// bottom. Where the existing syntax already covered something I expected to
// need an extension for, it is marked [W#] -- those are the load-bearing wins
// and they should not be lost in a later revision.
//
// ============================================================================


// ============================================================================
// imports  --  [P7] no new keyword: `::` is already a compile-time binding and
// `import` is an ordinary compile-time function. `use`/`import` as a statement
// form would be the only declaration in the language that is not `name :: v`.
// ============================================================================

std   :: import("std")
mem   :: std.mem                    // make, drop
io    :: std.io                     // write
list  :: std.list                   // List
fmt   :: std.fmt                    // Formattable, StringWriter, to_string

Allocator :: mem.Allocator
Writer    :: io.Writer
List      :: list.List


// ============================================================================
// std.sum  --  [P1] THE MISSING PROJECTION
// ============================================================================
//
// unified.z has no sum type, and a JSON value is a sum type, so this is the
// first wall. It is also the most interesting one, because the fix is not a
// new construct -- it is a second reading of the hole that is already there.
//
//     -> self    the block escapes.  ALL holes must be filled to instantiate.
//                Unfilled -> abstract -> usable only as a bound or behind ptr.
//
//     -> one     the block escapes.  EXACTLY ONE hole is filled.
//                Unfilled -> nothing; a sum is never abstract.
//
// Same block, same holes, same `name : T` syntax. The projection alone decides
// whether the holes are conjunctive or disjunctive. `Allocator` and `Option`
// are then literally the same declaration shape read two ways, which is a much
// better story than "there is also an enum".

Option :: <T> -> one {
    none: ()
    some: T
}

Result :: <T, E> -> one {
    ok:  T
    err: E
}

// CONSTRUCTION needs no new rule either. unified.z already says `=` fills a
// declared hole in a literal:
//
//     Option<u8>{ some = 3 }
//
// and since a variant is a hole of type T, the variant name is also a function
// (T) -> Self, derived, not declared:
//
//     Option<u8>.some(3)
//
// DESTRUCTURING is [P2]: a match arm is spelled exactly like a declaration --
// a name, a runtime group binding the payload, a body. Nothing new to learn.
//
//     match (v) {
//         none     { ... }
//         some (x) { ... use x ... }
//     }

unwrap_or :: <T> (o: Option<T>, d: T) -> T {
    match (o) {
        none     { d }
        some (x) { x }
    }
}

is_some :: <T> (o: Option<T>) -> bool {
    match (o) { none { false }  some (_) { true } }
}


// ============================================================================
// std.ops  --  [P15] OPERATORS ARE MEMBERS WITH SYMBOLIC NAMES
// ============================================================================
//
// unified.z spells indexing `operator [] :: (&self, i: u32) -> T`. That is the
// only two-token name in the language and the only place `operator` appears.
// Drop the keyword: the member is just named `[]`.
//
//     [] :: (&self, i: u32) -> T
//
// This pays for itself immediately, because it also explains closures. A
// closure in unified.z is "a block holding `m` with a call still pending" --
// but a block cannot have a call pending, blocks have members. What it
// actually is, is a block with one member named `()`:

Fn :: <A, R> -> self {
    (): (&self, a: A) -> R
}

Fn2 :: <A, B, R> -> self {
    (): (&self, a: A, b: B) -> R
}

// and `print_u8 :: (m: Allocator) (v: u8) -> ()` from unified.z desugars to
//
//     print_u8 :: (m: Allocator) -> self { (): (&self, v: u8) -> () { ... } }
//
// which is an ordinary `-> self` block, satisfies `Fn<u8, ()>` structurally,
// coerces to `ptr<Fn<u8, ()>>` for erasure, and needs no answer to the last
// OPEN question in unified.z: `print_u8(mem)` is its own type, and it is
// shared-type only when you write the coercion, exactly like every other shape.
//
// Cost: one shape per arity (Fn, Fn2, Fn3). See FRICTION 6.


// ============================================================================
// std.iter
// ============================================================================
//
// [W1] A generic shape works exactly as NOTE 3 promises. `Iterator<T>` is one
// vtable per T, which is why it is allowed to be a shape at all.

Iterator :: <T> -> self {
    next: (&self) -> Option<T>
}

// [W2] `-> self {}` with only parameters is a plain record, with no new form.
// Params of a `-> self` def ARE the fields, so an empty body is a struct
// declaration. This is one of the strongest results in the whole experiment.
// [P8] make the empty body optional: `Span :: (lo: u32, hi: u32) -> self`.

Span :: (lo: u32, hi: u32) -> self {}

// A concrete iterator. Note `M` -- see FRICTION 1, it is pure plumbing.
ListIter :: <T, M> (xs: ptr<List<T, M>>) -> self {
    i := 0
    next :: (&self) -> Option<T> {
        if (self.i >= self.xs.count) { return Option<T>.none() }
        v := self.xs.items[self.i]
        self.i += 1
        Option<T>.some(v)
    }
}

iter :: <T, M> (xs: ptr<List<T, M>>) -> ListIter<T, M> { ListIter(xs) }

// Extrinsic, so it can never satisfy a shape (NOTE 4), which is right: `fold`
// is convenience, `next` is the abstraction.
fold :: <T, A, I: Iterator<T>, F: Fn2<A, T, A>> (it: ptr<I>, acc: A, f: F) -> A {
    a := acc
    loop {
        match (it.next()) {
            none    { return a }
            some(v) { a = f(a, v) }          // [P15]: f(a, v) is f.()(a, v)
        }
    }
}


// ============================================================================
// std.key  --  a DICTIONARY, by unified.z's own test: slice<u8> has more than
// one legitimate ordering/hashing (case sensitive or not), so the caller must
// be able to choose.
// ============================================================================
//
// [P11] hash and equals go in ONE dictionary, not two. Two `= ?` params that
// the solver defaults independently can be defaulted inconsistently -- a
// case-folding hash with a case-sensitive equals is a silently broken map, and
// no type error catches it. Anything that must agree must be one block.
//
// This is a design rule the unified form makes cheap: grouping costs nothing
// because a dictionary is just a block.

Key :: <K> -> self {
    hash:   (k: K) -> u64
    equals: (a: K, b: K) -> bool
}

// Anonymous -> in the solver pool. This is what `Key<slice<u8>>` resolves to.
:: -> Key<slice<u8>> {
    hash = (k) -> u64 {                          // [P9] projection kept
        h := 14695981039346656037
        for (i := 0; i < k.len; i += 1) {
            h = (h ^ k.ptr[i]) * 1099511628211
        }
        h
    }
    equals = (a, b) -> bool {
        if (a.len != b.len) { return false }
        for (i := 0; i < a.len; i += 1) {
            if (a.ptr[i] != b.ptr[i]) { return false }
        }
        true
    }
}

// Named -> never searched, reachable only by hand: `Map<..., KY = ci_key>`.
ci_key :: -> Key<slice<u8>> {
    hash   = (k) -> u64  { fnv_lower(k) }
    equals = (a, b) -> bool { eq_lower(a, b) }
}


// ============================================================================
// std.map  --  open addressing, robin-hood-free, tombstoned.
// ============================================================================

Map :: <K, V, M: Allocator, KY: Key<K> = ?> (mem: M) -> self {

    // [W3] Nested declarations inside a block capture the block's compile-time
    // args for free. `Entry` is `Entry<K, V>` without ever saying so.
    Entry :: (key: K, value: V) -> self {}

    Slot :: -> one {
        empty: ()
        dead:  ()
        live:  Entry
    }

    cap   := 16
    count := 0
    slots := mem.make<Slot>(cap)                 // UFCS -> make<Slot>(mem, cap)

    // [W4] `-> {a, b}` -- partial projection as a multiple return -- turns out
    // to be the thing you reach for constantly in container code, and reads
    // better than a named result struct because the names are at the call site.
    probe :: (&self, k: K) -> {at: u32, found: bool} {
        i    := KY.hash(k) % self.cap
        free := self.cap                          // sentinel: none seen yet
        loop {
            match (self.slots[i]) {
                empty   { return { at = if (free < self.cap) { free } else { i },
                                   found = false } }
                dead    { if (free == self.cap) { free = i } }
                live(e) { if (KY.equals(e.key, k)) { return { at = i, found = true } } }
            }
            i = (i + 1) % self.cap
        }
    }

    put :: (&self, k: K, v: V) -> () {
        if ((self.count + 1) * 4 > self.cap * 3) { self.regrow() }
        r := self.probe(k)
        if (!r.found) { self.count += 1 }
        self.slots[r.at] = Slot.live(Entry(k, v))
    }

    get :: (&self, k: K) -> Option<V> {
        r := self.probe(k)
        if (!r.found) { return Option<V>.none() }
        match (self.slots[r.at]) {
            live(e) { Option<V>.some(e.value) }
            empty   { Option<V>.none() }          // FRICTION 3: unreachable,
            dead    { Option<V>.none() }          // but must still be written
        }
    }

    remove :: (&self, k: K) -> bool {
        r := self.probe(k)
        if (!r.found) { return false }
        self.slots[r.at] = Slot.dead()
        self.count -= 1
        true
    }

    regrow :: (&self) -> () {
        old     := self.slots
        old_cap := self.cap
        self.cap   = self.cap * 2
        self.slots = self.mem.make<Slot>(self.cap)
        self.count = 0
        for (i := 0; i < old_cap; i += 1) {
            match (old[i]) {
                live(e) { self.put(e.key, e.value) }
                empty   { }
                dead    { }
            }
        }
        self.mem.drop(old)
    }

    deinit :: (&self) -> () { self.mem.drop(self.slots); self.count = 0 }

    [] :: (&self, k: K) -> Option<V> { self.get(k) }    // [P15]
}


// ============================================================================
// json  --  the value type
// ============================================================================
//
// FRICTION 1 in its sharpest form. The honest declaration is
//
//     Json :: <M: Allocator> -> one { ... array: List<Json<M>, M> ... }
//
// and then M infects every signature in the parser, the printer, and every
// caller of any of them, forever, for a parameter nobody ever chooses. So the
// value type takes the erased allocator instead. NOTE 2 says the static/dynamic
// trade is "visible in the code instead of hidden in a keyword" -- correct, and
// this is what that visibility costs when the type is recursive.

Json :: -> one {
    null:   ()
    truth:  bool
    number: f64
    text:   slice<u8>
    array:  List<Json, ptr<Allocator>>
    object: Map<slice<u8>, Json, ptr<Allocator>>    // [W5] KY defaults here too
}


// ============================================================================
// json.lex
// ============================================================================

Token :: -> one {
    lbrace: ();  rbrace:   ()
    lbrack: ();  rbrack:   ()
    colon:  ();  comma:    ()
    text:   slice<u8>
    number: f64
    truth:  bool
    null:   ()
    eof:    ()
}

Error :: (at: u32, why: slice<u8>) -> self {}

Lexer :: (src: slice<u8>) -> self {

    pos := 0

    at_end :: (&self) -> bool { self.pos >= self.src.len }
    peek   :: (&self) -> u8   { self.src.ptr[self.pos] }

    skip_space :: (&self) -> () {
        while (!self.at_end()) {
            c := self.peek()
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') { return }
            self.pos += 1
        }
    }

    fail :: (&self, why: slice<u8>) -> Result<Token, Error> {
        Result<Token, Error>.err(Error(self.pos, why))
    }

    next :: (&self) -> Result<Token, Error> {
        self.skip_space()
        if (self.at_end()) { return ok(Token.eof()) }    // FRICTION 4

        c := self.peek()
        if (c == '{') { self.pos += 1; return ok(Token.lbrace()) }
        if (c == '}') { self.pos += 1; return ok(Token.rbrace()) }
        if (c == '[') { self.pos += 1; return ok(Token.lbrack()) }
        if (c == ']') { self.pos += 1; return ok(Token.rbrack()) }
        if (c == ':') { self.pos += 1; return ok(Token.colon())  }
        if (c == ',') { self.pos += 1; return ok(Token.comma())  }
        if (c == '"') { return self.lex_text() }
        if (c == '-' || (c >= '0' && c <= '9')) { return self.lex_number() }
        if (self.word("true"))  { return ok(Token.truth(true))  }
        if (self.word("false")) { return ok(Token.truth(false)) }
        if (self.word("null"))  { return ok(Token.null())       }
        self.fail("unexpected character")
    }

    word :: (&self, w: slice<u8>) -> bool {
        if (self.pos + w.len > self.src.len) { return false }
        for (i := 0; i < w.len; i += 1) {
            if (self.src.ptr[self.pos + i] != w.ptr[i]) { return false }
        }
        self.pos += w.len
        true
    }

    lex_text :: (&self) -> Result<Token, Error> {
        self.pos += 1
        start := self.pos
        while (!self.at_end() && self.peek() != '"') {
            if (self.peek() == '\\') { self.pos += 1 }
            self.pos += 1
        }
        if (self.at_end()) { return self.fail("unterminated string") }
        s := slice(self.src.ptr + start, self.pos - start)
        self.pos += 1
        ok(Token.text(s))
    }

    lex_number :: (&self) -> Result<Token, Error> {
        start := self.pos
        if (self.peek() == '-') { self.pos += 1 }
        while (!self.at_end() && is_digit(self.peek())) { self.pos += 1 }
        if (!self.at_end() && self.peek() == '.') {
            self.pos += 1
            while (!self.at_end() && is_digit(self.peek())) { self.pos += 1 }
        }
        ok(Token.number(parse_f64(slice(self.src.ptr + start, self.pos - start))))
    }
}

is_digit :: (c: u8) -> bool { c >= '0' && c <= '9' }


// ============================================================================
// json.parse
// ============================================================================
//
// FRICTION 5. The natural `Parser` primes its lookahead token at construction,
// and priming can fail. A `-> self` block has nowhere to put fallible setup:
// fields initialise in declaration order and there is no constructor body.
//
// [P14] is the general fix -- let the projection wrap self:
//
//     Parser :: (src: slice<u8>) -> Result<self, Error> { ... }
//
// which is just the existing projection rule with `self` allowed inside a type
// rather than only alone. Here I dodge it with a lazily-filled lookahead, which
// is what you would end up writing in C anyway, and costs one Option per peek.

Parser :: (lex: ptr<Lexer>, mem: ptr<Allocator>) -> self {

    look := Option<Token>.none()

    peek :: (&self) -> Result<Token, Error> {
        match (self.look) {
            some (t) { return ok(t) }
            none     { }
        }
        t := try self.lex.next()                  // [P13] `try` propagates err
        self.look = Option<Token>.some(t)
        ok(t)
    }

    bump :: (&self) -> Result<Token, Error> {
        t := try self.peek()
        self.look = Option<Token>.none()
        ok(t)
    }

    expect :: (&self, want: Token, why: slice<u8>) -> Result<(), Error> {
        t := try self.bump()
        if (tag_of(t) != tag_of(want)) {           // FRICTION 7: no tag test
            return Result<(), Error>.err(Error(self.lex.pos, why))
        }
        ok(())
    }

    value :: (&self) -> Result<Json, Error> {
        t := try self.bump()
        match (t) {
            null      { ok(Json.null())      }
            truth (b) { ok(Json.truth(b))    }
            number(n) { ok(Json.number(n))   }
            text  (s) { ok(Json.text(s))     }
            lbrack    { self.array()         }
            lbrace    { self.object()        }
            rbrack    { self.oops("unexpected ]") }
            rbrace    { self.oops("unexpected }") }
            colon     { self.oops("unexpected :") }
            comma     { self.oops("unexpected ,") }
            eof       { self.oops("unexpected end of input") }
        }
    }

    array :: (&self) -> Result<Json, Error> {
        xs := List<Json, ptr<Allocator>>(self.mem)
        t  := try self.peek()
        match (t) { rbrack { self.bump(); return ok(Json.array(xs)) }  _ { } }
        loop {
            v := try self.value()
            xs.push(v)
            n := try self.bump()
            match (n) {
                comma  { }
                rbrack { return ok(Json.array(xs)) }
                _      { return self.oops("expected , or ]") }
            }
        }
    }

    object :: (&self) -> Result<Json, Error> {
        m := Map<slice<u8>, Json, ptr<Allocator>>(self.mem)
        t := try self.peek()
        match (t) { rbrace { self.bump(); return ok(Json.object(m)) }  _ { } }
        loop {
            k := try self.bump()
            key := match (k) {
                text (s) { s }
                _        { return self.oops("expected object key") }
            }
            try self.expect(Token.colon(), "expected :")
            v := try self.value()
            m.put(key, v)
            n := try self.bump()
            match (n) {
                comma  { }
                rbrace { return ok(Json.object(m)) }
                _      { return self.oops("expected , or }") }
            }
        }
    }

    oops :: <T> (&self, why: slice<u8>) -> Result<T, Error> {
        Result<T, Error>.err(Error(self.lex.pos, why))
    }
}

parse :: (mem: ptr<Allocator>, src: slice<u8>) -> Result<Json, Error> {
    lx := Lexer(src)
    p  := Parser(&lx, mem)
    v  := try p.value()
    t  := try p.bump()
    match (t) { eof { ok(v) }  _ { p.oops("trailing input") } }
}


// ============================================================================
// json.print  --  a derived Formattable instance, as an ordinary def (NOTE 5)
// ============================================================================

:: -> fmt.Formattable<Json> {
    format = (v, w) -> () {
        match (v) {
            null      { w.write("null") }
            truth (b) { w.write(if (b) { "true" } else { "false" }) }
            number(n) { fmt.Formattable<f64>.format(n, w) }
            text  (s) { w.write("\""); write_escaped(s, w); w.write("\"") }

            array (xs) {
                w.write("[")
                for (i := 0; i < xs.count; i += 1) {
                    if (i > 0) { w.write(",") }
                    // [W6] a type used in value position IS the solved default
                    // instance. This is the same move unified.z already makes
                    // at `Formattable<u8>.format(v / 10, w)`, and it is what
                    // makes recursive instances possible at all.
                    fmt.Formattable<Json>.format(xs[i], w)
                }
                w.write("]")
            }

            object (m) {
                w.write("{")
                first := true
                for (i := 0; i < m.cap; i += 1) {
                    match (m.slots[i]) {
                        live (e) {
                            if (!first) { w.write(",") }
                            first = false
                            w.write("\""); write_escaped(e.key, w); w.write("\":")
                            fmt.Formattable<Json>.format(e.value, w)
                        }
                        empty { }
                        dead  { }
                    }
                }
                w.write("}")
            }
        }
    }
}

write_escaped :: (s: slice<u8>, w: ptr<Writer>) -> () {
    for (i := 0; i < s.len; i += 1) {
        c := s.ptr[i]
        if (c == '"')  { w.write("\\\""); continue }
        if (c == '\\') { w.write("\\\\"); continue }
        if (c == '\n') { w.write("\\n");  continue }
        w.write_bytes(&c, 1)
    }
}


// ============================================================================
// a small query layer, to exercise closures and iterators
// ============================================================================

// [P15] in action: a closure is a block with a `()` member, so it satisfies
// `Fn2` structurally and needs no function-type machinery.
sum_numbers :: (a: f64, v: Json) -> f64 {
    match (v) { number (n) { a + n }  _ { a } }
}

// Erased callback: `ptr<Fn2<...>>` is a fat pointer, same as ptr<Allocator>.
each_child :: (v: Json, f: ptr<Fn2<slice<u8>, Json, ()>>) -> () {
    match (v) {
        object (m) {
            for (i := 0; i < m.cap; i += 1) {
                match (m.slots[i]) { live (e) { f(e.key, e.value) }  _ { } }
            }
        }
        array (xs) {
            for (i := 0; i < xs.count; i += 1) { f("", xs[i]) }
        }
        _ { }
    }
}

// A named closure declaration -- two runtime groups, curried, per unified.z.
// Under [P15] this is sugar for a `-> self` block with a `()` member, so the
// last OPEN question in unified.z answers itself: it has its own type, and it
// becomes a shared type exactly when you write `ptr<Fn2<...>>`.
tally :: (out: ptr<u32>) (k: slice<u8>, v: Json) -> () {
    out^ += 1
}


// ============================================================================
// main
// ============================================================================

main :: () -> () {
    heap  := mem.Heap()
    arena := mem.Arena(page, 1 << 20)

    // The parser is allocator-erased by construction (see Json, above), so the
    // coercion happens once, here, and every Json value shares one type.
    a : ptr<Allocator> := &arena

    src := "{\"name\":\"z\",\"tags\":[1,2,3],\"ok\":true}"

    match (parse(a, src)) {
        err (e) {
            io.out.write("parse error at ")
            io.out.write(fmt.to_string(heap, e.at))
            io.out.write(": ")
            io.out.write(e.why)
        }
        ok (doc) {
            // round-trip
            io.out.write(fmt.to_string(heap, doc))

            // dictionary override by name, spelled with `=` not `:`  [P3]
            io.out.write(fmt.to_string<F = compact_json>(heap, doc))

            // iterate an array through the Iterator shape
            match (doc) {
                object (m) {
                    match (m["tags"]) {
                        some (tags) {
                            match (tags) {
                                array (xs) {
                                    it    := iter(&xs)
                                    total := fold(&it, 0.0, sum_numbers)
                                    io.out.write(fmt.to_string(heap, total))  // 6
                                }
                                _ { }
                            }
                        }
                        none { }
                    }

                    // closure + erasure
                    n := 0
                    each_child(doc, &tally(&n))
                    io.out.write(fmt.to_string(heap, n))                      // 3
                }
                _ { }
            }
        }
    }
}


// ============================================================================
// ============================================================================
//
//                                F I N D I N G S
//
// ============================================================================
// ============================================================================
//
//
// ----------------------------------------------------------------------------
// WHAT HELD UP  (do not lose these in a revision)
// ----------------------------------------------------------------------------
//
// [W1] Generic shapes. `Iterator<T>` as a shape works and NOTE 3's rule for
//      when that is allowed (multiply the vtables, do not add defaults) held
//      for every case I hit.
//
// [W2] `X :: (a: A, b: B) -> self {}` is a struct declaration, with no struct
//      form. "Runtime params of a `-> self` def ARE fields" is the single
//      highest-value line in unified.z. `Entry`, `Span` and `Error` above are
//      one line each and read better than a `struct` keyword would.
//
// [W3] Nested declarations capture the enclosing block's compile-time args.
//      `Entry` inside `Map` is `Entry<K,V>` without saying so, and `Slot` is a
//      sum over it. No `where`, no re-declaration.
//
// [W4] `-> {a, b}` gets used constantly, not occasionally. `probe` returning
//      `{at, found}` is the shape of half of all container internals and the
//      names land at the call site (`r.found`) rather than in a throwaway type.
//
// [W5] `= ?` solver params work in TYPE position, not just call position:
//      `Map<slice<u8>, Json, ptr<Allocator>>` leaves `KY` to the solver. This
//      falls out of dictionaries being zero-sized compile-time bindings, and it
//      is what keeps the JSON type declaration readable.
//
// [W6] "A type in value position is the solver's default instance."
//      `Formattable<Json>.format(...)` inside the anonymous `-> Formattable<Json>`
//      instance is how a recursive instance calls itself. unified.z already
//      relies on this at line 223 and at `reverse_u8`, but never states it.
//      STATE IT -- it is a real rule and it is doing real work.
//
// [W7] The `Tracking` / `ptr<Allocator>` split from NOTE 2 is genuinely nice in
//      practice. Deciding erasure at the `a : ptr<Allocator> := &arena` line and
//      nowhere else is exactly right.
//
//
// ----------------------------------------------------------------------------
// WHERE IT FOUGHT BACK
// ----------------------------------------------------------------------------
//
// FRICTION 1 -- PLUMBING TYPE PARAMETERS. The worst practical problem in the
//   file. `M` in `List<T, M>` is never chosen by anyone, but it must be spelled
//   in every signature that mentions a list:
//
//       ListIter :: <T, M> (xs: ptr<List<T, M>>) -> self
//       fold     :: <T, A, I: Iterator<T>, F: Fn2<A, T, A>> (...)
//       sort     :: <T, M, O: Ord<T> = ?> (xs: ptr<List<T, M>>)   // unified.z
//
//   `sort` declares `M` purely so that `List<T, M>` parses. When the type is
//   recursive (`Json`) it is not merely noise, it is fatal -- see FRICTION 2.
//   -> [P4]
//
// FRICTION 2 -- MONOMORPHISATION INFECTS RECURSIVE TYPES. A `Json` parameterised
//   by its allocator is `Json<M>`, its arrays are `List<Json<M>, M>`, and M
//   appears in the parser, the printer, the error type and every user function.
//   Two documents from different allocators are different types and cannot be
//   compared, merged, or stored together. The only livable answer is to erase
//   at the type declaration (`ptr<Allocator>`), which means the language's
//   headline feature -- static allocator dispatch -- is unavailable for exactly
//   the data structures people write most. This is not a syntax bug, but it is
//   the biggest thing the design has not confronted, and it belongs in OPEN.
//
// FRICTION 3 -- NO REFUTABLE MATCH. `get` knows the slot is `live` because
//   `probe` said `found`, but the match must still name `empty` and `dead`.
//   Every container gets a tail of dead arms. Wanted: a single-arm form that
//   is an assertion, and a `_` catch-all. `_` is used above; it is not in
//   unified.z and should be.
//
// FRICTION 4 -- `ok(...)` / `err(...)` NEED THE TYPE. Written honestly it is
//   `Result<Token, Error>.ok(t)` at every one of the fourteen returns in the
//   lexer. Inference from the enclosing function's return type is the obvious
//   fix, but note it is inference flowing OUTWARD from the projection into the
//   body, which the language does not otherwise do. Worth deciding deliberately.
//
// FRICTION 5 -- NO FALLIBLE CONSTRUCTION. `-> self` has no constructor body:
//   fields initialise in declaration order and there is nowhere to run a step
//   that can fail, or that needs two fields already set. -> [P14]
//
// FRICTION 6 -- ARITY-INDEXED SHAPES. `Fn`, `Fn2`, `Fn3`. Unavoidable without
//   variadic compile-time args, and cheap enough to live with, but it is the
//   one place the language forces a numbered family of names.
//
// FRICTION 7 -- TAG COMPARISON. `expect(Token.colon())` wants "same variant,
//   ignore payload" and there is no way to say it; `tag_of` above is invented.
//   A sum type needs its discriminant to be a first-class value.
//
// FRICTION 8 -- NO MUTABILITY DISTINCTION. `get` and `put` both take `&self`.
//   Nothing in the language says `get` does not write, so nothing can alias-
//   check, and `ptr<Allocator>` handed to a printer is a fully mutable handle.
//   The binder pair `::`/`:=` already encodes immutable/mutable for BINDINGS;
//   there is no corresponding pair for POINTEES. This is a real hole with no
//   good candidate answer yet -- flagged rather than solved.
//
// FRICTION 9 -- NO VISIBILITY, and see [P5]: the fix is already in the grammar.
//
// FRICTION 10 -- ORDER DEPENDENCE IS UNSTATED. `Slot` references `Entry`
//   declared after it; `Json` references `Map` declared after it; the anonymous
//   `Formattable<Json>` instance is found by a solver that must have seen the
//   whole file. Top-level and block-level declarations have to be order-
//   independent. unified.z never says so, and it interacts with the FORWARD
//   DECLARATIONS item already in OPEN.
//
//
// ----------------------------------------------------------------------------
// PROPOSALS
// ----------------------------------------------------------------------------
//
// [P1]  `-> one` : the sum projection. A block whose holes are disjunctive.
//         -> self   ALL holes filled (unfilled = abstract = shape/dictionary)
//         -> one    EXACTLY ONE hole filled
//       Construction reuses "`=` fills a declared hole in a literal"
//       (`Option<u8>{some = 3}`), and the derived `Option<u8>.some(3)`.
//       This is the single largest gap in unified.z and the fix adds one word.
//
// [P2]  A match arm is spelled like a declaration: `name (binders) { body }`.
//       No new binding form, no `:` overload, and it composes with `_`.
//
// [P3]  NAMED COMPILE-TIME ARGUMENTS USE `=`, NOT `:`.
//       unified.z line 292 writes `to_string<F: hex_u8>` -- but line 22 says
//       "`:` is type ascription and nothing else", and `hex_u8` is a value.
//       `=` is already "a default in a parameter list"; passing one by name is
//       its exact mirror.  ->  `to_string<F = hex_u8>`, `sort<O = reverse_u8>`.
//       This is the clearest internal contradiction in the current file.
//
// [P4]  `_` AS AN ELIDED COMPILE-TIME ARG IN TYPE POSITION:
//         sort :: <T, O: Ord<T> = ?> (xs: ptr<List<T, _>>) -> ()
//       Reads as "some type I do not name", monomorphises per call, and kills
//       FRICTION 1 everywhere it is not load-bearing. `_` is already wanted as
//       a match wildcard (FRICTION 3), so it is one symbol for one idea:
//       "a binding position I decline to name".
//
// [P5]  PARTIAL PROJECTION IS VISIBILITY. This is already in the grammar and
//       unified.z does not notice it:
//         mem :: -> {make, drop} { make :: ...  drop :: ...  helper :: ... }
//       `-> self` exports everything, `-> {a, b}` exports two names. No `pub`,
//       no `export`, no new rule -- the projection was always the export list.
//       Same mechanism gives a struct private fields.
//
// [P6]  ONE RULE FOR A SHAPE NAME IN VALUE POSITION (answers OPEN #5):
//         shape in `<>`  ->  a static bound; monomorphised.   <M: Allocator>
//         shape in `()`  ->  ptr<Shape>; erased.              (m: Allocator)
//       So `print_u8 :: (m: Allocator) (v: u8)` takes a fat pointer, and the
//       static version is `print_u8 :: <M: Allocator> (m: M) (v: u8)`. The
//       bracket already means compile-time vs runtime; let it mean this too.
//
// [P7]  `import` is an ordinary compile-time function, not a statement.
//       `std :: import("std")` keeps "every declaration is `name :: v`" true.
//
// [P8]  Make the body optional when it would be empty:
//         Span :: (lo: u32, hi: u32) -> self
//       A record is then params-only, which is what it is.
//
// [P9]  LAMBDA LITERALS KEEP THEIR PROJECTION. unified.z writes
//         compare = (a, b) { if (a < b) { return -1 } ... }
//       which is the only callable in the language with no `->`. Write
//         compare = (a, b) -> i32 { ... }
//       and allow eliding the projection ONLY when filling a typed hole, which
//       is the same "elide what is already known" rule as `<T>` inference.
//
// [P10] STATE THE INSTANTIATION RULE, which the file uses but never says:
//         List           a declaration
//         List<u8>       apply compile-time args  ->  a TYPE
//         List<u8>(mem)  apply runtime args       ->  a VALUE
//       Everything about `Heap()` vs `Writer`, and about when `-> self` is a
//       type versus an instance, falls out of this one line.
//
// [P11] A DICTIONARY IS A BLOCK, SO GROUP WHAT MUST AGREE. `Key<K>` carries
//       hash AND equals. Two independently-solved `= ?` params that must be
//       consistent is a silent-corruption bug the type system cannot see.
//
// [P12] SHAPE-vs-DICTIONARY IS A PROPERTY OF THE BLOCK, NOT THE MEMBER. NOTE 1
//       states the test per-member ("first param is self"). A block with one
//       self member and one non-self member is currently well-formed and means
//       nothing. Make it an error, and say the test is: ALL holes take self ->
//       shape; NO hole takes self -> dictionary.
//
// [P13] `try e` propagates the `err` arm of a `Result` to the enclosing
//       function's projection. Needed by every non-trivial program; the only
//       alternative is `match` at every call, which the parser above shows is
//       unreadable. It is a keyword, but so is `defer`, which unified.z already
//       uses at line 283 without ever introducing it.
//
// [P14] LET THE PROJECTION WRAP `self`:
//         Parser :: (src: slice<u8>) -> Result<self, Error> { ... }
//       `self` is already "the block"; allowing it inside a type rather than
//       only bare is a one-line grammar change that buys fallible construction
//       (FRICTION 5), and also gives `-> Option<self>` and `-> ptr<self>` for
//       free.
//
// [P15] DROP `operator`; OPERATORS ARE MEMBERS WITH SYMBOLIC NAMES.
//         [] :: (&self, i: u32) -> T
//         () :: (&self, v: u8)  -> ()
//       This removes the language's only two-token name AND explains closures:
//       a closure is a block with a `()` member, `Fn<A,R>` is an ordinary
//       shape, and both remaining OPEN questions about `print_u8` answer
//       themselves (it has its own type; erasure is `ptr<Fn<A,R>>`, written
//       exactly like every other shape coercion). Best value-per-character
//       change available.
//
//
// ----------------------------------------------------------------------------
// DEFECTS IN unified.z ITSELF
// ----------------------------------------------------------------------------
//
//   line 145  comment reads `// UFCS -> mem.make<T>(mem, capacity)`;
//             should be `make<T>(mem, capacity)`.
//
//   line 145  `mem.make<T>(capacity)` -- `mem` here is the field, but the
//             module is ALSO named `mem`, and UFCS resolves the method through
//             it. A field and a module with the same name, in one expression,
//             where the resolution goes field-then-module. It works, but it is
//             an accident. Line 160 in the same block writes `self.mem.make`.
//             Pick one, and rename the module or the field.
//
//   line 288  `io.out` is never declared; `io` has only `write`.
//
//   line 292  `to_string<F: hex_u8>` contradicts line 22.  -> [P3]
//
//   line 283  `defer` is used and never introduced.
//
//   line 197  `Ord<u8>.compare(b, a)` inside `reverse_u8 :: -> Ord<u8>`: a
//             named instance calling the pooled one by writing the type. Fine,
//             but it is [W6] and needs stating, otherwise it reads as infinite
//             recursion.
//
//   line 173  `operator []` -- see [P15].
//
//   line 188  `compare = (a, b) { ... }` -- see [P9].
//
//
// ----------------------------------------------------------------------------
// THE ONE-PARAGRAPH VERDICT
// ----------------------------------------------------------------------------
//
// The unification is real and it survives contact with a non-trivial program.
// "Params of a `-> self` def are fields" plus "an unfilled hole is abstract"
// genuinely replaces struct, module, trait, impl and enum-of-one, and the
// shape/dictionary split is a better answer than Rust's or Go's. The two things
// standing between this and a language you could write in are a sum projection
// ([P1], [P2], `_`, `try`) and an answer to what monomorphisation does to
// recursive data (FRICTION 2). Everything else in this file is tightening.
// ============================================================================
