// ============================================================================
// unified.z  --  one declaration form for module / struct / func / trait
// ============================================================================
//
// THE RULE
//
//     Name <compile-time args> (runtime args) -> projection { body }
//
// Every declaration takes args and builds a block of named values.
// The projection says what escapes the block:
//
//     -> ()        nothing escapes            procedure
//     -> T         one value escapes          function
//     -> self      the whole block escapes    struct / module / interface
//     -> {a, b}    part of it escapes         multiple return
//
// BRACKETS
//     <>   compile-time args      List<u8>, ptr<T>
//     ()   runtime args           Heap()
//     []   indexing               xs[0]
//
// BINDING
//     ::   binds at compile time      :=   binds at runtime
//     A runtime param of a `-> self` def IS a field: the block is what you
//     kept, so the params are in it.
//     A field bound with `::` costs zero bytes; it lives in the type.
//     No runtime group at all (`x :: -> T {...}`) means the thing IS its
//     value, already evaluated. An explicit empty `()` means you call it.
//
// COMPILE-TIME ARGS COME IN TWO KINDS
//     <T>                      inferred from a runtime argument's type
//     <F: Formattable<T> = ?>  solved by search: nothing at the call site
//                              mentions it, so the solver goes and finds it
//
// A DECLARATION WITH NO NAME is what the solver searches. `::` with nothing
// on its left is an anonymous compile-time binding; it goes in the pool.
// Give it a name and it is reachable only by hand.
//
// TWO KINDS OF ABSTRACTION, ONE SYNTAX. See NOTE 1 -- this is the load-
// bearing idea in the file.
//     first param is `self`  ->  SHAPE.      Intrinsic to a type, matched
//                                structurally, coercible to ptr<Shape>.
//     first param is not     ->  DICTIONARY. Extrinsic, several may exist,
//                                the caller picks, the solver defaults it.
//
// ============================================================================


// ============================================================================
// std.mem  --  Allocator is a SHAPE: an allocator is an object with state.
// ============================================================================

Allocator :: -> self {
    alloc: (self, n: u32) -> ptr<()>
    free:  (self, p: ptr<()>) -> ()
}

// No fields -> zero-sized -> the field costs 0 bytes wherever it is stored
// and every call through it is direct.
Heap :: () -> self {
    alloc :: (self, n: u32) -> ptr<()> { c_malloc(n) }
    free  :: (self, p: ptr<()>) -> ()  { c_free(p)   }
}

Arena :: (base: ptr<u8>, size: u32) -> self {
    top := 0
    alloc :: (self, n: u32) -> ptr<()> {
        p := self.base + self.top
        self.top += n
        p
    }
    free :: (self, p: ptr<()>) -> () { }
}

// Wraps any allocator, and is itself one.
Tracking :: <M: Allocator> (inner: M) -> self {
    alloc :: (self, n: u32) -> ptr<()> { log("alloc %", n); self.inner.alloc(n) }
    free  :: (self, p: ptr<()>) -> ()  { log("free");       self.inner.free(p)  }
}

// `M: Allocator` means "any type structurally providing that shape".
// ptr<Allocator> provides it too -- that is the entire static/dynamic switch,
// with no keyword. See NOTE 2.
make :: <T, M: Allocator> (m: M, n: u32) -> ptr<T> { m.alloc(n * size_of<T>()) }
drop :: <T, M: Allocator> (m: M, p: ptr<T>) -> ()  { m.free(p) }


// ============================================================================
// std.io  --  also a SHAPE.
// ============================================================================

Writer :: -> self {
    write_bytes: (self, p: ptr<u8>, n: u32) -> ()
}


// ============================================================================
// std.list  --  methods live in the block. See NOTE 3.
// ============================================================================

List :: <T, M: Allocator> (mem: M) -> self {
    capacity := 10
    count    := 0
    items    := make<T>(mem, capacity)

    push :: (self, item: T) -> () {
        if (self.count + 1 > self.capacity) { self.expand() }
        self.items[self.count] = item
        self.count += 1
    }

    pop :: (self) -> T {
        self.count -= 1
        self.items[self.count]
    }

    expand :: (self) -> () {
        new_cap   := self.capacity * 2
        new_items := make<T>(self.mem, new_cap)
        for (i := 0; i < self.count; i += 1) { new_items[i] = self.items[i] }
        drop(self.mem, self.items)
        self.items    = new_items
        self.capacity = new_cap
    }

    deinit :: (self) -> () {
        drop(self.mem, self.items)
        self.items = nil
        self.count = 0
    }

    operator [] :: (self, i: u32) -> T { self.items[i] }
}


// ============================================================================
// std.ord  --  Ord is a DICTIONARY: u8 has no one true ordering, and the
// caller must be able to pick. Nothing is attached to u8.
// ============================================================================

Ord :: <T> -> self {
    compare: (a: T, b: T) -> i32     // < 0 before, 0 equal, > 0 after
}

// Anonymous -> in the solver pool. This is what `Ord<u8>` resolves to.
:: -> Ord<u8> {
    compare = (a, b) {
        if (a < b) { return -1 }
        if (a > b) { return  1 }
        return 0
    }
}

// Named -> never searched. Reachable only by hand.
reverse_u8 :: -> Ord<u8> {
    compare = (a, b) { Ord<u8>.compare(b, a) }
}

sort :: <T, M, O: Ord<T> = ?> (xs: ptr<List<T, M>>) -> () {
    for (i := 1; i < xs.count; i += 1) {
        v := xs.items[i]
        j := i
        while (j > 0 && O.compare(xs.items[j - 1], v) > 0) {
            xs.items[j] = xs.items[j - 1]
            j -= 1
        }
        xs.items[j] = v
    }
}


// ============================================================================
// std.fmt  --  also a DICTIONARY: you want hex and decimal for the same u8.
// ============================================================================

Formattable :: <T> -> self {
    format: (v: T, w: ptr<Writer>) -> ()
}

:: -> Formattable<u8> {
    format = (v, w) {
        if (v >= 10) { Formattable<u8>.format(v / 10, w) }
        d := '0' + (v % 10)
        w.write_bytes(&d, 1)
    }
}

hex_u8 :: -> Formattable<u8> {
    format = (v, w) {
        digits :: "0123456789abcdef"
        hi := digits[v / 16]
        lo := digits[v % 16]
        w.write_bytes(&hi, 1)
        w.write_bytes(&lo, 1)
    }
}

// A derived instance is an ordinary def: args on the left, result on the
// right. The solver matches the return type. No special impl syntax, no
// pattern on the left-hand side. See NOTE 4.
:: <T, M, F: Formattable<T> = ?> -> Formattable<List<T, M>> {
    format = (v, w) {
        w.write_bytes("[", 1)
        for (i := 0; i < v.count; i += 1) {
            if (i > 0) { w.write_bytes(", ", 2) }
            F.format(v.items[i], w)
        }
        w.write_bytes("]", 1)
    }
}


// ============================================================================
// std.fmt.str
// ============================================================================

// A Writer, structurally. No closures, no capture, memcpy-movable.
StringWriter :: <M: Allocator> (mem: M) -> self {
    buf := List<u8>(mem)

    write_bytes :: (self, p: ptr<u8>, n: u32) -> () {
        for (i := 0; i < n; i += 1) { self.buf.push(p[i]) }
    }

    finish :: (self) -> slice<u8> { slice(self.buf.items, self.buf.count) }
}

to_string :: <T, M: Allocator, F: Formattable<T> = ?> (mem: M, v: T) -> slice<u8> {
    b := StringWriter(mem)
    F.format(v, &b)          // &b coerces to ptr<Writer>; the fat pointer is
    b.finish()               // built right here, and only here
}


// ============================================================================
// main
// ============================================================================

main :: () -> () {
    mem := Heap()                      // zero-sized
    xs  := List<u8>(mem)               // M = Heap; every alloc call is direct
    defer xs.deinit()

    xs.push(2)
    xs.push(1)

    io.write(io.out, to_string(mem, xs[0]))              // "2"
    io.write(io.out, to_string(mem, xs))                 // "[2, 1]"

    // `with` matches by type: hex_u8 is a Formattable<u8>, so it binds F.
    io.write(io.out, to_string(mem, xs[0]) with hex_u8)  // "02"
    io.write(io.out, to_string(mem, xs)    with hex_u8)  // "[02, 01]"
    io.write(io.out, to_string<F: hex_u8>(mem, xs[0]))   // same, positionally

    sort(&xs)                          // Ord<u8> from the pool
    sort<O: reverse_u8>(&xs)           // by hand

    // Static composition: Tracking<Heap> is a distinct type, calls still direct.
    audited := Tracking(Heap())
    zs := List<u8>(audited)
    defer zs.deinit()

    // Dynamic: the annotation is the coercion. Same List, no second decl,
    // no `dyn`. Now the calls go through a fat pointer.
    arena := Arena(page, 4096)
    boxed : ptr<Allocator> = &arena
    ys := List<u8>(boxed)
    defer ys.deinit()

    // Closures are what is left over: a block holding `m` with a call still
    // pending. A closure is a struct; that is the whole point.
    print_u8 :: (m: Allocator) (v: u8) -> () { io.write(io.out, to_string(m, v)) }
    p := print_u8(mem)
    p(7)
}


// ============================================================================
// NOTE 1 -- shapes vs dictionaries, and why one syntax is enough.
//
// Rust conflates these and pays for it with orphan rules. Go has only shapes.
// Haskell has only dictionaries. You can have both, told apart by one word:
//
//   SHAPE       first param is `self`. An allocator, a writer, a socket --
//               things where the abstraction is a property of the object and
//               there is exactly one sensible answer per type. Satisfied
//               structurally by any type with matching methods, so it needs
//               no registration. Coerce to ptr<Shape> for dynamic dispatch.
//
//   DICTIONARY  no `self`. Ord<u8>, Formattable<u8> -- things where several
//               answers exist and the caller must be able to choose. A free-
//               standing value, defaulted by the solver, overridden by `with`.
//               Works on primitives and foreign types, since nothing has to be
//               attached to them.
//
// The test is not stylistic: can there legitimately be two of these for one
// type? Two orderings of u8, yes -> dictionary. Two ways for an Arena to
// allocate, no -> shape.
//
// ----------------------------------------------------------------------------
// NOTE 2 -- static vs dynamic is a type, not a keyword.
//
//     List<u8>(mem)      M = Heap            direct calls, 0-byte field
//     List<u8>(audited)  M = Tracking<Heap>  direct calls, still monomorphic
//     List<u8>(boxed)    M = ptr<Allocator>  fat pointer, indirect calls
//
// One declaration, three behaviors. The cost of the first two: they are
// different types and cannot share an array. That is the trade, and it is now
// visible in the code instead of hidden in a keyword.
//
// ----------------------------------------------------------------------------
// NOTE 3 -- methods live inside the block, and that is forced.
//
// The earlier draft wrote `push :: <T, M> (self: ptr<List<T, M>>, item: T)` at
// top level and restated the type params on every function. Putting methods in
// the block deletes that boilerplate -- T, M and the fields are already in
// scope -- and it is also what makes structural matching possible: a shape is
// satisfied by a type's own methods, so they have to be the type's.
//
// The price: no extension methods. You cannot add a method to a type you do
// not own. That is exactly the case dictionaries cover, so nothing is lost --
// intrinsic abstraction goes inside, extrinsic abstraction goes outside.
//
// ----------------------------------------------------------------------------
// NOTE 4 -- two problems from the last draft are gone.
//
// (a) The derived Formattable used to need a pattern on the left-hand side:
//         Formattable<List<T,M>> :: <T, M, F: Formattable<T> = ?> { ... }
//     a second, unification-shaped mechanism. Writing it as an anonymous def
//     with a return type makes it an ordinary declaration; the solver matches
//     the return type, which it already had to do for `= ?` params.
//
// (b) StringWriter used to hold a `writer` closure capturing the sibling field
//     `buf`, which made `-> self` blocks self-referential and not movable.
//     With methods taking `self`, nothing captures anything, and every struct
//     stays memcpy-movable. Closures still exist, but only where you actually
//     asked for one (`print_u8(mem)`).
//
// ----------------------------------------------------------------------------
// OPEN
//
//   - COHERENCE. Two anonymous `-> Ord<u8>` in different files is an
//     ambiguity. Error at the use site, or first-wins, or one-per-module? This
//     is the biggest unanswered question in the file.
//   - Does `capacity :: 10` (compile-time field, 0 bytes) make List<u8> with
//     cap 10 a different type from cap 20? Zig says yes.
//   - Is the ptr<Shape> coercion implicit at call sites (`F.format(v, &b)`) or
//     does it require the annotation, as `boxed` does? Implicit is nicer to
//     write and hides a representation change.
//   - Is `print_u8(mem)` its own type, or a `(u8) -> ()`? Own type = free.
//     Shared type = erasure, i.e. the same fat-pointer trick as ptr<Shape>.
// ============================================================================
