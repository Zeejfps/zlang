// ============================================================================
// unified.z  --  the declaration form, worked as source
// ============================================================================
//
// Every declaration below is written in one form:
//
//     Name <compile-time args> (runtime args) -> projection { body }
//
// What that form MEANS -- the projections, holes, elements, keywords, operator
// policies, coherence, and NOTE 1-9 arguing for each -- is in rules.txt. What
// its words mean is in glossary.z. This file is the source those rules were
// derived from and are checked against: a core, an allocator layer, a list, an
// iterator, an ordering, a formatter, and a main that uses them.
//
// ============================================================================

// ============================================================================
// std.core
// ============================================================================

Option :: <T> -> oneof {
    none: ()
    some: T
}

Result :: <T, E> -> oneof {
    ok:  T
    err: E
}

// `try e` yields the `ok` payload, or returns the `err` arm to the caller's
// projection. It is the only reason `Result` is worth having over a match.

// A closure is a block with a `()` member, so a callable is an ordinary shape.
// One per arity is the cost; see OPEN.
Fn  :: <A, R>    -> self { (): (&self, a: A)       -> R }
Fn2 :: <A, B, R> -> self { (): (&self, a: A, b: B) -> R }


// ============================================================================
// std.num  --  arithmetic is built in, and stops there
// ============================================================================
//
// `+ - * / %`, `== !=`, `< <= > >=` and unary `-` are INSTRUCTIONS on the
// primitives, and they desugar to nothing. There is no operator overloading
// and no `operator` keyword, so a fixed precedence table is the whole of the
// grammar for them.
//
// THIS IS WHAT REMOVING THE POOL COST, and it is worth naming rather than
// hiding. Arithmetic was a policy: `a + b` meant `Add<A, B>.add(a, b)`, with
// the operand types as the search key, which is how `2.0 * v` worked when
// nobody owns f32. That reading needs a type in value position to mean "the
// instance the solver picked" -- and with every instance named, `+` has
// nothing to name. Operator overloading IS the solver; it does not survive it.
//
// So a user type gets ordinary members, and the call site says which type's
// arithmetic it is asking for.

Vec2 :: (x: f32, y: f32) -> self {
    add   :: (self, b: Vec2) -> Vec2 { Vec2(self.x + b.x, self.y + b.y) }
    sub   :: (self, b: Vec2) -> Vec2 { Vec2(self.x - b.x, self.y - b.y) }
    scale :: (self, s: f32)  -> Vec2 { Vec2(self.x * s,   self.y * s)   }
    eq    :: (self, b: Vec2) -> bool { self.x == b.x && self.y == b.y   }
}

// The second addition that made arithmetic a policy in the first place. It is
// now what it always was underneath -- another name -- and the reading at the
// call site is the same one `v.add(w)` gets.
saturating :: -> self {
    add :: (a: Vec2, b: Vec2) -> Vec2 { Vec2(clamp(a.x + b.x), clamp(a.y + b.y)) }
}


// ============================================================================
// std.mem
// ============================================================================

// Nothing but holes -- two names with types and no binder. Uninstantiable,
// therefore usable only as a bound or behind a pointer.
Allocator :: -> self {
    alloc: (&self, n: u32) -> ptr
    free:  (&self, p: ptr) -> ()
}

// The typed layer is an ordinary module of free functions. It is not part of
// the shape, so anyone can extend it -- and being outside it, it is called
// like what it is: `mem.make<T>(allocator, n)`, never `allocator.make<T>(n)`.
// See NOTE 4.
mem :: -> self {
    make :: <T, M: Allocator> (allocator: M, n: u32) -> ptr<T> {
        allocator.alloc(n * size_of<T>())
    }
    drop :: <T, M: Allocator> (allocator: M, p: ptr<T>) -> () { allocator.free(p) }
}

// No fields -> zero-sized -> the field costs 0 bytes wherever it is stored
// and every call through it is direct.
Heap :: () -> self {
    alloc :: (&self, n: u32) -> ptr { c_malloc(n) }
    free  :: (&self, p: ptr) -> ()  { c_free(p)   }
}

Arena :: (base: ptr<u8>, size: u32) -> self {
    top := 0
    alloc :: (&self, n: u32) -> ptr {
        p := self.base + self.top
        self.top += n
        p
    }
    free :: (&self, p: ptr) -> () { }
}

// Wraps any allocator, and is itself one.
Tracking :: <M: Allocator> (inner: M) -> self {
    alloc :: (&self, n: u32) -> ptr { log("alloc %", n); self.inner.alloc(n) }
    free  :: (&self, p: ptr) -> ()  { log("free");       self.inner.free(p)  }
}


// ============================================================================
// std.io  --  the projection is the export list
// ============================================================================

Writer :: -> self {
    write_bytes: (&self, p: ptr<u8>, n: u32) -> ()
}

io :: -> {out, err, write} {

    // Not in the projection, so it does not escape. `out` does, which makes
    // its type opaque outside this block at no cost.
    FileWriter :: (fd: i32) -> self {
        write_bytes :: (&self, p: ptr<u8>, n: u32) -> () { c_write(self.fd, p, n) }
    }

    out :: FileWriter(1)
    err :: FileWriter(2)

    write :: <W: Writer> (w: W, s: slice<u8>) -> () { w.write_bytes(s.ptr, s.len) }
}


// ============================================================================
// std.list  --  methods live in the block. See NOTE 4.
// ============================================================================

// `M: Allocator` means "any type structurally providing that shape".
// ptr<Allocator> provides it too -- that is the entire static/dynamic switch,
// with no keyword. See NOTE 2.
// THE PROJECTION IS CLOSED, which is only possible because `[]` exists:
// `items` and `capacity` do not escape, so no caller can see the storage, and
// `[]` hands out the element's address rather than a copy. `span` is there for
// the same reason
// -- building a slice needs the base pointer, and closing the projection means
// asking for it by name instead of reaching in.
List :: <T, M: Allocator> (allocator: M) -> {push, pop, count, [], span, deinit} {
    capacity := 10
    count    := 0

    // A field initialiser sees the runtime params directly; methods reach them
    // through `self`. The VALUE is `allocator`; the module of free functions
    // over it is `mem`, and the two never collide.
    items    := mem.make<T>(allocator, capacity)

    push :: (&self, item: T) -> () {
        if (self.count + 1 > self.capacity) { self.expand() }
        self.items[self.count] = item
        self.count += 1
    }

    // Returning `T` was a lie about the empty list. This is what `-> oneof`
    // buys in the first ten lines of a standard library.
    pop :: (&self) -> Option<T> {
        if (self.count == 0) { return Option<T>.none() }
        self.count -= 1
        Option<T>.some(self.items[self.count])
    }

    expand :: (&self) -> () {
        new_cap   := self.capacity * 2
        new_items := mem.make<T>(self.allocator, new_cap)
        for (i := 0; i < self.count; i += 1) { new_items[i] = self.items[i] }
        mem.drop(self.allocator, self.items)
        self.items    = new_items
        self.capacity = new_cap
    }

    deinit :: (&self) -> () {
        mem.drop(self.allocator, self.items)
        self.items = nil
        self.count = 0
    }

    // The ELEMENT'S ADDRESS escapes, so `xs[i].* = v` and `xs[i].* += 1` are
    // writable and `xs[i]` already IS the ptr<T>. There is no `-> &T`, so the
    // body takes the address itself. See ELEMENTS in rules.txt.
    [] :: (&self, i: u32) -> ptr<T> { &self.items[i] }

    span :: (&self) -> slice<T> { slice(self.items, self.count) }
}


// ============================================================================
// std.ord  --  Ord is a POLICY: u8 has no one true ordering, and the
// caller must be able to pick. Nothing is attached to u8. It is not what `<`
// means -- `<` is an instruction on the primitives -- it is what a function
// that must be TOLD an ordering takes.
// ============================================================================

Ord :: <T> -> self {
    compare: (a: T, b: T) -> i32     // no self -> policy
}

// `Key<K>` in std.map carries hash AND equals in one block, because those two
// must agree ([P11] in json.z). It is a separate policy for that reason, not
// because equality needed abstracting: `a == b` on a primitive is an
// instruction, and a user type publishes an `eq` member.

// The ordinary ordering of u8. A NAME, like every instance -- there is no
// pool, so `Ord<u8>` is a type and never stands for a value.
ord_u8 :: -> Ord<u8> {
    compare = (a, b) -> i32 {
        if (a < b) { return -1 }
        if (b < a) { return  1 }
        return 0
    }
}

// A second ordering, which is the whole reason Ord is a policy rather than a
// member of u8. It delegates by naming the other instance, which is ordinary
// name lookup and needs no rule.
reverse_u8 :: -> Ord<u8> {
    compare = (a, b) -> i32 { ord_u8.compare(b, a) }
}

// `_` for the allocator: sort does not care which one, and naming a parameter
// only so that `List<T, M>` parses is the noisiest thing in the old draft.
// Every line that used to say `xs.items[j]` now says `xs[j].*`, and `sort` no
// longer knows WHICH pointer a List has in it. The `.*` is the cost of cutting
// places: `v := xs[i]` would bind a pointer into the array the loop below then
// overwrites, and only the `O.compare` call -- arguments do not auto-deref --
// would catch it.
sort :: <T, O: Ord<T>> (xs: ptr<List<T, _>>) -> () {
    for (i := 1; i < xs.count; i += 1) {
        v := xs[i].*
        j := i
        while (j > 0 && O.compare(xs[j - 1].*, v) > 0) {
            xs[j].* = xs[j - 1].*
            j -= 1
        }
        xs[j].* = v
    }
}


// ============================================================================
// std.fmt  --  also a POLICY: you want hex and decimal for the same u8.
// Every one is named, and every call site says which it meant.
// ============================================================================

Formattable :: <T> -> self {
    format: (v: T, w: ptr<Writer>) -> ()
}

fmt_u8 :: -> Formattable<u8> {
    format = (v, w) -> () {
        if (v >= 10) { fmt_u8.format(v / 10, w) }   // recursion is a NAME now
        d := '0' + (v % 10)
        w.write_bytes(&d, 1)
    }
}

hex_u8 :: -> Formattable<u8> {
    format = (v, w) -> () {
        digits :: "0123456789abcdef"
        hi := digits[v / 16]
        lo := digits[v % 16]
        w.write_bytes(&hi, 1)
        w.write_bytes(&lo, 1)
    }
}

// What used to be a DERIVED INSTANCE, which the solver built by unifying
// against this return type and then solved `F` for in turn. It is an ordinary
// compile-time function: you apply it, and the application is the instance.
// `to_string<F = list_fmt<F = fmt_u8>>(heap, xs)`.
list_fmt :: <T, M, F: Formattable<T>> -> Formattable<List<T, M>> {
    format = (v, w) -> () {
        io.write(w, "[")
        for (i := 0; i < v.count; i += 1) {
            if (i > 0) { io.write(w, ", ") }
            F.format(v[i].*, w)
        }
        io.write(w, "]")
    }
}

vec2_fmt :: -> Formattable<Vec2> {
    format = (v, w) -> () {
        io.write(w, "(")
        fmt_f32.format(v.x, w)
        io.write(w, ", ")
        fmt_f32.format(v.y, w)
        io.write(w, ")")
    }
}


// ============================================================================
// std.fmt.str
// ============================================================================

// A Writer, structurally. No closures, no capture, memcpy-movable.
StringWriter :: <M: Allocator> (allocator: M) -> self {
    buf := List<u8>(allocator)

    write_bytes :: (&self, p: ptr<u8>, n: u32) -> () {
        for (i := 0; i < n; i += 1) { self.buf.push(p[i]) }
    }

    finish :: (&self) -> slice<u8> { self.buf.span() }
}

to_string :: <T, M: Allocator, F: Formattable<T>> (allocator: M, v: T) -> slice<u8> {
    b := StringWriter(allocator)
    F.format(v, &b)          // &b coerces to ptr<Writer>; the fat pointer is
    b.finish()               // built right here, and only here
}


// ============================================================================
// main
// ============================================================================

main :: () -> () {
    heap := Heap()                     // zero-sized
    xs   := List<u8>(heap)             // M = Heap; every alloc call is direct
    defer xs.deinit()

    xs.push(2)
    xs.push(1)

    // EVERY POLICY IS NAMED. There is no default and nothing is searched for,
    // so the element formatter and the list formatter are both visible, and
    // the second is the first applied to it.
    io.write(io.out, to_string<F = fmt_u8>(heap, xs[0].*))               // "2"
    io.write(io.out, to_string<F = list_fmt<F = fmt_u8>>(heap, xs))      // "[2, 1]"
    io.write(io.out, to_string<F = hex_u8>(heap, xs[0].*))               // "02"
    io.write(io.out, to_string<F = list_fmt<F = hex_u8>>(heap, xs))      // "[02, 01]"

    sort<O = ord_u8>(&xs)
    sort<O = reverse_u8>(&xs)

    match (xs.pop()) {
        some (v) { io.write(io.out, to_string<F = fmt_u8>(heap, v)) }
        none     { io.write(io.err, "empty") }
    }

    // Static composition: Tracking<Heap> is a distinct type, calls still direct.
    audited := Tracking(Heap())
    zs := List<u8>(audited)
    defer zs.deinit()

    // Dynamic: the annotation is the coercion. Same List, no second decl,
    // no `dyn`. Now the calls go through a fat pointer.
    arena := Arena(page, 4096)
    boxed : ptr<Allocator> := &arena
    ys := List<u8>(boxed)
    defer ys.deinit()

    // Arithmetic on a user type is a member call. `2.0 * v` has no spelling
    // -- `v.scale(2.0)` is the same operation asked for from the type that
    // owns it, which is the trade the pool paid for and no longer buys.
    v := Vec2(1.0, 2.0).add(Vec2(3.0, 4.0))
    w := v.scale(2.0)
    if (w.eq(Vec2(8.0, 12.0))) { io.write(io.out, "yes") }
    io.write(io.out, to_string<F = vec2_fmt>(heap, saturating.add(v, w)))

    // A closure is what is left over: a block holding `allocator` with one member
    // named `()`. A closure is a struct; that is the whole point.
    print_u8 :: <M: Allocator> (allocator: M) -> self {
        () :: (&self, v: u8) -> () {
            io.write(io.out, to_string<F = fmt_u8>(self.allocator, v))
        }
    }
    p := print_u8(heap)
    p(7)                               // -> p.()(7)

    // ...and since it is a block with a `()` member, it satisfies Fn<u8, ()>
    // structurally, and erases exactly like every other shape.
    f : ptr<Fn<u8, ()>> := &p
    f(8)
}
