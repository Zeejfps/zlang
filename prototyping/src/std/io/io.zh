module std.io {
    uses std.string.String as String;

    // Same fat-struct shape as std.mem.Allocator: an opaque impl pointer plus
    // the function table. This is already dynamic dispatch by hand.
    struct Writer {
        impl:        ptr;
        write_bytes: func(impl: ptr, data: ptr<u8>, length: u32);
    }

    var out: ptr<Writer>;

    func write_bytes(w: ptr<Writer>, data: ptr<u8>, length: u32);
    func write(w: ptr<Writer>, str: ptr<String>);
}
