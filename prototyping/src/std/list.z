module std.list {

    use std.mem.Allocator as Allocator;
    use std.array.Array<T> as Array<T>;

    struct List<T> {
        allocator: ptr<Allocator>;
        capacity: u32;
        item_count: u32;
        items: ptr<T>;
    }

    func create<T>(allocator: ptr<Allocator>) -> ptr<List<T>> {
        var list = allocator.alloc<List<T>>();
        list.allocator = allocator;
        list.capacity = 10;
        list.items = allocator.malloc<T>(list.capacity);
        list.item_count = 0;
        return list;
    }

    func destroy<T>(list: ptr<List<T>>){
        var allocator = list.allocator;
        allocator.free(list.items);
        allocator.free(list);
        list.item_count = 0;
        list.capacity = 0;
        list.allocator = nil;
    }

    func push_item<T>(list: ptr<List<T>>, item: T) {
        var new_count = list.item_count + 1;
        if (new_count > list.capacity) {
            expand(list);
        }
        list.items[list.item_count] = item;
        list.item_count += 1;
    }

    func pop_item<T>(list: ptr<List<T>>) -> T {
        var item = list.items[list.item_count];
        list.item_count -= 1;
        return item;
    }

    func insert_item<T>(list: ptr<List<T>>, item: T, index: u32);
    func remove_item<T>(list: ptr<List<T>>, item: T) -> bool;
    
    func get_item<T>(list: ptr<List<T>>, index: u32) -> T {
        list.items[index];
    }

    func expand(list: ptr<List<T>>) {
        var items = list.items;
        var allocator = list.allocator;
        var new_capacity = list.capacity * 2;
        var new_items = allocator.alloc<T>(new_capacity);
        for (var i = 0; i < list.item_count; i++) {
            new_items[i] = items[i];
        }
        allocator.free(items);
        list.items = new_items;
    }

    operator [] <T>(list: ptr<List<T>>, index: u32) -> T {
        return list.items[index];
    }
}