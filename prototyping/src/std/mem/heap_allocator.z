
module std.mem.HeapAllocator {

    const var HeapAllocatorInstance: Allocator = {
        
    }

    struct HeapAllocator {
        buffer: u8[]
    }
    
    func create() -> ptr<Allocator> {
        var allocator = mem.alloc<HeapAllocator>(data:))
        return {
            impl: allocator,
            alloc: &alloc,
            free: &free,
        }
    }
    
    func alloc<T>(impl: ptr, size: u32) -> ptr<T> {
        var heap_allocator = impl as ptr<HeapAllocator>
        return heap_allocator.ptr
    }
    
    func free<T>(impl: ptr, data: ptr<T>){
        var heap_allocator = impl as ptr<HeapAllocator>
    }
}
