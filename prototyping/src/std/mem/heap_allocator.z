
module std.mem.heap {
   
    uses std.mem.allocators;

    #metadata {
        "extern": [
            {
                "func": "c_malloc",
                "export_name" : "malloc",
                "lib": "kernel32.dll",
                "calling_conv": "win32"
            },
            {
                "func": "c_free",
                "export_name" : "malloc",
                "lib": "kernel32.dll",
                "calling_conv": "win32"
            },
        ]
    }

    extern func c_malloc(size: u64) -> ptr;                                                           
    extern func c_free(ptr: ptr);  
    
    func create_allocator() -> ptr<Allocator> {
        return {
            impl: null,
            alloc: &alloc,
            free: &free,
        }
    }
    
    func alloc(impl: ptr, size: u32) -> ptr {
        c_malloc(size)
    }
    
    func free(impl: ptr, data: ptr){
        c_free(data);
    }
}
