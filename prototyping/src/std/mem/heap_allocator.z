
module std.mem.HeapAllocator {

    const var HeapAllocatorInstance: Allocator = {
        
    }

    struct HeapAllocator {
        buffer: u8[]
    }
    
    func create() -> Allocator {
        var heap_allocator = malloc<HeapAllocatorData>()
        return {
            data: data,
            alloc: &alloc,
            free: &free,
        }
    }
    
    func alloc<T>(data: ptr, size: u32) -> ptr<T> {
        var heap_allocator = data as ptr<HeapAllocatorData>
        return heap_allocator.ptr
    }
    
    func free<T>(data: ptr){
        var heap_allocator = data as ptr<HeapAllocatorData>
    }
}
