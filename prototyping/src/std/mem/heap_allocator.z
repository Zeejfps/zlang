
module std.mem.heap {
   
    uses std.mem.allocators;
   
    var g_allocator: ptr<Allocator> = null;
    
    func allocator() -> ptr<Allocator> {
        if (g_allocator == null) {
            g_allocator = create_allocator(null, &alloc, &free);
        }
    }

    extern func c_malloc(size: u64) -> ptr;                                                           
    extern func c_free(ptr: ptr);  
    
    func create() -> ptr<Allocator> {
        var allocator = mem.alloc<HeapAllocator>(data:))
        return {
            impl: allocator,
            alloc: &alloc,
            free: &free,
        }
    }
    
    func alloc(impl: ptr, size: u32) -> ptr {
        var heap_allocator = impl as ptr<HeapAllocator>
        return heap_allocator.ptr
    }
    
    func free(impl: ptr, data: ptr){
        var heap_allocator = impl as ptr<HeapAllocator>
    }
}
