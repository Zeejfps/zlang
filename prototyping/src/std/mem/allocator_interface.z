impl std.mem {
    struct Allocator {
        data:   ptr
        alloc:  func(data: ptr, size: u32) -> ptr;
        resize: func(data: ptr, start: ptr, old_size: u32, new_size: u32) -> ptr;
        free:   func(data: ptr, start: ptr, size: u32);
    }

    func alloc<T>(allocator: ptr<Allocator>) -> ptr<T> {
        const size = sizeof(T);
        const mem = allocator.alloc(allocator.data, size);
        return mem as ptr<T>;
    }

    func malloc<T>(allocator: ptr<Allocator>, count: u32) -> ptr<T> {
        const size = sizeof(T) * count;
        const mem = allocator.alloc(allocator.data, size);
        return mem as ptr<T>;
    }

    func free<T>(allocator: ptr<Allocator>, item: ptr<T>) {
        const size = sizeof(T);
        return allocator.free(allocator.data, item, size)
    }

    func free<T>(allocator: ptr<Allocator>, items: ptr<T>, count: u32) {
        const size = sizeof(T) * count;
        return allocator.free(allocator.data, items, size)
    }
}