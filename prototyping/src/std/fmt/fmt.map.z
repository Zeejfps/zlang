impl<Mem: std.mem, K, V> std.fmt.Formattable<ptr<std.map<Mem>.Map<K, V>>>
    requires(
        KF: std.fmt.Formattable<K>,
        VF: std.fmt.Formattable<V>,
        KO: std.ord.Ord<K>,
    )
{
    uses std.io.Writer as Writer;
    uses std.io as io;
    uses std.map<Mem = Mem> as map;

    func format(value: ptr<map.Map<K, V>>, w: ptr<Writer>) {
        io.write_bytes(w, "{", 1);

        var count = map.count(value);
        for (var i = 0; i < count; i++) {
            if (i > 0) {
                io.write_bytes(w, ", ", 2);
            }
            var entry = map.entry_at(value, sorted_index(value, i));

            // KF and VF are two separate witnesses of the SAME trait at
            // different types. This is why naming them beats an anonymous
            // K: std.fmt.Formattable, V: std.fmt.Formattable bound.
            KF.format(entry.key, w);
            io.write_bytes(w, ": ", 2);
            VF.format(entry.value, w);
        }

        io.write_bytes(w, "}", 1);
    }

    // KO is in scope for every func in the impl, not just format.
    func sorted_index(value: ptr<map.Map<K, V>>, rank: u32) -> u32 {
        // TODO: order entries by KO.compare(a.key, b.key)
        return rank;
    }
}
