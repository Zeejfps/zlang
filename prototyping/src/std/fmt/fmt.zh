// A trait is a module whose parameter is a type. Impls are indexed by that
// parameter, and the solver searches them.
//
//   requires(...)  declares a witness, by a name that stays internal
//   with(...)      seeds the solver for one call, matching supplied impls to
//                  open slots by trait + type -- including slots opened by
//                  sub-goals, which is how a seed reaches nested impls
trait std.fmt.Formattable<T> {
    uses std.io.Writer as Writer;
    func format(value: T, w: ptr<Writer>);
}
