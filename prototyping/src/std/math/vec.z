impl std.math.vec {

    struct Vec2<T: Number> {
        c1: T
        c2: T
        
        operator + <T: Number>(v2: ptr<Vec2<T>>) {
            this.c1 + v2.c1,
            this.c2 + v2.c2
        }
    
        operator += <T: Number>(v2: ptr<Vec2<T>>) {
            this.c1 += v2.c1;
            this.c2 += v2.c2;
        }
    }

    func add<T: Number>(v1: ptr<Vec2<T>>, v2: ptr<Vec2<T>>) -> Vec2<T> {
        return {
            c1 = v1.c1 + v2.c1,
            c2 = v1.c2 + v2.c2
        }
    }
}


