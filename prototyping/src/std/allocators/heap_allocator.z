
module std.mem.heap : std.mem {
   
    #metadata {
        "extern": [
            {
                "func": "c_malloc",
                "export_name" : "malloc",
                "lib": "kernel32.dll",
                "calling_conv": "cdecl"
            },
            {
                "func": "c_free",
                "export_name" : "free",
                "lib": "kernel32.dll",
                "calling_conv": "cdecl"
            },
        ]
    }
    
    var g_allocator = std.mem.Allocator();
    var g_is_initialized = false;

    extern func c_malloc(size: u64) -> ptr;                                                           
    extern func c_free(ptr: ptr);  
    
    func allocator() -> ptr<Allocator> {
        if (!g_is_initialized){
            std.mem.allocator.init_allocator(&g_allocator, alloc, free);
            g_is_initialized = true;
        }
        return &g_allocator;
    }
    
    func alloc(impl: ptr, size: u32) -> ptr {
        c_malloc(size)
    }
    
    func free(impl: ptr, data: ptr){
        c_free(data);
    }
}
