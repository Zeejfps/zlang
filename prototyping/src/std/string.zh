module std.string {
    uses std.array.Array;
    uses std.slice.Slice;
    uses std.mem.Allocator;

    struct String;
    type Char = u16;

    func create(literal: Array<u8>) -> ptr<String>;
    func create(literal: ptr<Array<u8>>, allocator: ptr<Allocator>) -> ptr<String>;
    func destroy(str: ptr<String>);
    func length(str: ptr<String>) -> u32;
    func slice(str: ptr<String>, start_index: u32) -> Slice<Char>;
    func slice(str: ptr<String>, start_index: u32, length: u32) -> Slice<Char>;
    func get_char(str: ptr<String> , index: u32) -> Char;
}

