module std.mem {

    const var default_allocator: ptr<Allocator>;
    
    struct Allocator;

    func alloc<T>(allocator: ptr<Allocator>) -> ptr<T>;
    func malloc<T>(allocator: ptr<Allocator>, count: u32) -> ptr<T>;
    func free<T>(allocator: ptr<Allocator>, data: ptr<T>);
    func mfree<T>(allocator: ptr<Allocator>, data: ptr<T>, length: u32);
}