// Canonical: this is what the solver finds for std.ord.Ord<u8>.
impl std.ord.Ord<u8> {
    func compare(a: u8, b: u8) -> i32 {
        if (a < b) { return -1; }
        if (a > b) { return 1; }
        return 0;
    }
}

// Named, so never a search candidate. Reachable only by hand, via with().
impl std.ord.Ord<u8> as std.ord.reverse_u8 {
    func compare(a: u8, b: u8) -> i32 {
        if (a < b) { return 1; }
        if (a > b) { return -1; }
        return 0;
    }
}
