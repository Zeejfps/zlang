impl std.array {
    uses std.mem as mem;
    uses std.mem.Allocator as Allocator;

    struct Array<T> {
        allocator: ptr<Allocator>;
        length: u32;
        data: ptr<T>;
    }

    func init<T>(array: ptr<Array<T>>, len: u32, allocator: ptr<Allocator>) {
        array.length = len;
        array.data = mem.malloc<T>(allocator, len);
        array.allocator = allocator;
    }
    
    func deinit<T>(array: ptr<Array<T>>) {
        var allocator = array.allocator;
        mem.mfree(allocator, array.data, array.length);
        array.data = null;
        array.length = 0;
        array.allocator = null;
    }

    func create<T>(len: u32, allocator: ptr<Allocator>) -> ptr<Array<T>> {
        var array = mem.alloc<Array<T>>(allocator)
        init(array, len);
        return array;
    }

    func destroy<T>(array: ptr<Array<T>>) {
        deinit(array);
        mem.free(allocator, array);
    }
}