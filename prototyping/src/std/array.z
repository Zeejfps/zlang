module std.array {
    uses std.mem as mem;
    uses std.mem.Allocator as Allocator;

    struct Array<T> {
        allocator: Allocator*;
        length: u32;
        data: ptr<T>;
    }

    func create<T>(len: u32, allocator: Allocator) -> Array<T> {
        data = mem.malloc<T>(allocator, len);
        var array = {
            length = len,
            data = data,
            allocator = allocator,
        };
        return array;
    }

    func destroy<T>(array: ptr<Array<T>>) {
        var allocator = array.allocator;
        mem.free(allocator, array.data, array.length);
        array.data = null;
        array.length = 0;
        array.allocator = null;
    }
}