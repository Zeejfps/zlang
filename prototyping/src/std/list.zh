module std.list(Mem: std.mem) {
    uses std.array.Array as Array
    uses Mem.Allocator as Allocator;

    struct List<T>;

    func create<T>(allocator: ptr<Allocator>) -> ptr<List<T>>;
    func destroy<T>(list: ptr<List<T>>);
    func push_item<T>(list: ptr<List<T>>, item: T);
    func pop_item<T>(list: ptr<List<T>>) -> T;
    func insert_item<T>(list: ptr<List<T>>, item: T, index: u32);
    func remove_item<T>(list: ptr<List<T>>, item: T) -> bool;
    func get_item<T>(list: ptr<List<T>>, index: u32) -> T;
    
    operator [] <T>(list: ptr<List<T>>, index: u32) -> T;
}