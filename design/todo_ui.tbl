// todo_ui.tbl: a declarative UI over the todo app in todo.tbl.

use todo::{App, Todo, TodoLine, add, stats};
use tables::{update};
use ui;
use ui::{column, row, text, text_input, button, checkbox};

fn set_done(app: App, id: id<Todo>, done: bool) {
    update(app.todos, id, done: done);
}

// A view's body declares elements rather than running steps.
// The view re-runs when anything it read changes: a table, its state, or an argument.
view TodoScreen(app: App) {
    // State lives as long as this view is on screen.
    state draft: str = "";
    state show_done: bool = false;

    // A call that begins a statement can take a trailing block of children.
    // In a header like `for x in items() {`, the `{` is always the loop body.
    column(gap: 8) {
        row(gap: 4) {
            text_input(value: draft, on_change: fn(s: str) { draft = s; });
            button("Add", on_click: fn() {
                add(app, draft);
                draft = "";
            });
        }

        checkbox("Show done", value: show_done, on_change: fn(b: bool) { show_done = b; });

        // `for` and `if` work in views too. Each pass emits its elements.
        for t in app.todos where show_done || !t.done {
            // A Todo row is passed where a TodoLine is expected.
            TodoRow(app, t);
        }

        let s = stats(app);
        text("{s.open} of {s.total} open");
    }
}

// Views compose like functions.
view TodoRow(app: App, line: TodoLine) {
    row(gap: 4) {
        checkbox(value: line.done, on_change: fn(b: bool) { set_done(app, line.id, b); });
        text(line.text, strike: line.done);
    }
}

fn main() {
    let app = App();
    add(app, "try the ui");
    let screen = TodoScreen(app);
    ui::run(screen);
}
