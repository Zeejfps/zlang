// game.tbl: a tiny ECS-style simulation.
// An entity is a row in the Entity table. Components are tables keyed by
// that row's id. Systems are plain functions that query across those tables.

// No columns of its own. With no key column, it gets an implicit
// `id: id<Entity> key`, so its rows exist only to give out ids.
table Entity {}

// `key` marks the column that identifies a row. Here the key is also
// an Entity's id, so rows in different tables with the same `entity`
// belong to the same entity.
table Position {
    entity: id<Entity> key;
    x: float;
    y: float;
}

table Velocity {
    entity: id<Entity> key;
    dx: float;
    dy: float;
}

table Health {
    entity: id<Entity> key;
    hp: int required;
    max: int required;
}

// A tag: a table with only a key. Whether a row exists is the data.
table Player {
    entity: id<Entity> key;
}

context World {
    entities: table<Entity>;
    positions: table<Position>;
    velocities: table<Velocity>;
    healths: table<Health>;
    players: table<Player>;
}

// A `for` with several bindings joins them on their key columns, which must
// have the same type. This visits only entities with both a Position and a Velocity.
// Loop variables are references to the rows, so assigning writes back.
fn movement(world: World, dt: float) {
    for p in world.positions, v in world.velocities {
        p.x += v.dx * dt;
        p.y += v.dy * dt;
    }
}

fn poison(world: World) {
    for h in world.healths where h.hp > 0 {
        h.hp -= 1;
    }
}

// Deleting an Entity also deletes every row in the context keyed by its id.
// A delete inside the loop is deferred until the loop ends.
fn reap(world: World) {
    for h in world.healths where h.hp <= 0 {
        world.entities.delete(h.entity);
    }
}

// `_` joins on a table without binding its row. Here it filters to players.
fn report(world: World) {
    for p in world.positions, _ in world.players {
        print("player {p.entity} at {p.x}, {p.y}");
    }
}

// Position without its key, for callers that don't have an entity yet.
projection Point from Position {
    x;
    y;
}

// `..p: Point` takes Point's fields as named parameters, and `p` is the
// assembled value in the body. Callers pass `x:` and `y:`, or `..some_point`.
fn spawn_rock(world: World, ..p: Point) -> id<Entity> {
    let e = world.entities.insert();
    world.positions.insert(entity: e, ..p);
    return e;
}

fn main() {
    let world = World();

    // Inserting into a table with an implicit id returns the new id.
    // The key is a column like any other, so it is passed by name.
    let hero = world.entities.insert();
    world.positions.insert(entity: hero, x: 0.0, y: 0.0);
    world.velocities.insert(entity: hero, dx: 1.0, dy: 0.5);
    world.healths.insert(entity: hero, hp: 3, max: 3);
    world.players.insert(entity: hero);

    spawn_rock(world, x: 5.0, y: 5.0);

    for frame in 0..5 {
        movement(world, 1.0 / 60.0);
        poison(world);
        reap(world);
        report(world);
    }
}
