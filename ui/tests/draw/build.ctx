// Stage 0's test: the draw list, the recorder and number formatting. How to run it: ui/AGENTS.md.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "ui_test_draw", root = "." }
    build::add_sources{ &b, exe, dir = "../../core" }
    build::add_sources{ &b, exe, dir = "../../record" }
    build::add_sources{ &b, exe, dir = "../../test" }
}
