// Stage 11's checks: windows, dialogs, menus, context menus, the combo, tooltips, drag and drop
// (window.ctx, popup.ctx, menu.ctx and drag.ctx of ui/widgets), with goldens named
// golden/windows-*.txt.
//
//  - Goldens: a window at rest and with its close button focused by keys, in both themes; a menu
//    bar with a menu and a submenu open; an open combo; a dialog over a window; a drag's ghost; the
//    same window and menu at scale 1.5; the nodes of a window, a menu and a combo.
//  - Windows: a title drag moves the window by exactly the pointer's pixels at scales 1, 1.25 and
//    1.5, in one drag and in many, and its stored place converts back to the same pixels; a
//    window dragged off the surface keeps its title bar reachable; the grip resizes, never below
//    the least size; the arrow and a double click fold it, folded it keeps its place and its body
//    takes no pointer; the cross and Enter on the focused cross close it; of two overlapping
//    windows the top one takes the pointer and a press on the lower one raises it; content taller
//    than the body scrolls; a dialog over windows blocks them and gives the focus back.
//  - Menus: a click opens a menu, an item click closes all and is true once; a submenu follows the
//    pointer; the keyboard opens, steps (past a disabled item), enters and leaves a submenu, and
//    goes left and right along the bar; a disabled item cannot be picked; a check item flips; a
//    submenu that would leave the surface flips to the left.
//  - The combo picks by click and by keys, scrolls a long list and keeps the lit row in view.
//  - A context menu opens at the pointer on a right press, and below its target on the Menu key.
//  - A tooltip appears after `tip_delay` and not before, and not while a button is held.
//  - Drag and drop: the threshold, the ghost in the front overlay, a drop reported once with the
//    payload, a kind the target refuses, Escape, and a release over no target.
//
// How the goldens' numbers come about, at scale 1 in the tests' font (a character 7 pixels wide,
// a line 14 high): a window has a 1-pixel border, a title bar 28 high (its buttons 20 square,
// 4 from its ends, the title 4 after the arrow), a body padded 8, and a strip 8 high under the
// body holding the 16 by 8 grip; a menu bar is 28 high, padded 4 across and 2 down, its titles
// padded 8 across; a menu is padded 4, its items 24 high with a 16-unit mark column, at least
// 140 wide; a combo's list rows are 24 high.

fn check_windows { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, update: bool } {
    let out = alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 262144 } iferr { return }
    let scratch = alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 262144 } iferr { return }
    record_window{ &io, &fs, &t, &heap, out, scratch, update, dark = true }
    record_window{ &io, &fs, &t, &heap, out, scratch, update, dark = false }
    record_menu{ &io, &fs, &t, &heap, out, scratch, update }
    record_combo{ &io, &fs, &t, &heap, out, scratch, update }
    record_dialog{ &io, &fs, &t, &heap, out, scratch, update }
    record_ghost{ &io, &fs, &t, &heap, out, scratch, update }
    record_window_scaled{ &io, &fs, &t, &heap, out, scratch, update }
    record_window_nodes{ &io, &fs, &t, &heap, out, scratch, update }
    check_window_move{ &io, &t, &heap, scale = 1.0 }
    check_window_move{ &io, &t, &heap, scale = 1.25 }
    check_window_move{ &io, &t, &heap, scale = 1.5 }
    check_window_reach{ &io, &t, &heap }
    check_window_resize{ &io, &t, &heap, scale = 1.0 }
    check_window_resize{ &io, &t, &heap, scale = 1.5 }
    check_window_fold{ &io, &t, &heap }
    check_window_close{ &io, &t, &heap }
    check_window_order{ &io, &t, &heap }
    check_window_scroll{ &io, &t, &heap }
    check_dialog_modal{ &io, &t, &heap }
    check_menu_pointer{ &io, &t, &heap }
    check_menu_keys{ &io, &t, &heap }
    check_submenu_flip{ &io, &t, &heap }
    check_combo_pick{ &io, &t, &heap }
    check_context_menu{ &io, &t, &heap }
    check_window_tooltip{ &io, &t, &heap }
    check_drag_drop{ &io, &t, &heap }
}

// ---- the scenes

enum Part: u8 { windows, menus, combo, dialog, drag, context, tip }

// What a scene shows and what its widgets changed.
struct Desk {
    part: Part,
    a_open: bool, b_open: bool, dialog: bool,
    a: ui::WindowOpts, b: ui::WindowOpts,
    rows: u32,                          // labels in window A's body
    behind: u32, a_clicks: u32, b_clicks: u32, ok_clicks: u32,
    opened: u32, saved: u32, cut: u32, pasted: u32, recent: i32, undone: u32,
    autosave: bool,
    bar_left: f32,                      // where the menu bar starts across, in units
    fruit: i32,
    copied: u32,
    tip_clicks: u32,
    drops_a: u32, drops_b: u32, dropped: i64, over_a: bool, over_b: bool, ghost: bool,
}

fn make_desk { part: Part } -> Desk {
    return Desk{
        part, a_open = true, b_open = true, dialog = false,
        a = ui::WindowOpts{ x = 40.0, y = 40.0, width = 200.0, height = 150.0, .. },
        b = ui::WindowOpts{ x = 140.0, y = 90.0, width = 200.0, height = 150.0, .. },
        rows = 2, behind = 0, a_clicks = 0, b_clicks = 0, ok_clicks = 0,
        opened = 0, saved = 0, cut = 0, pasted = 0, recent = -1, undone = 0, autosave = false, bar_left = 0.0,
        fruit = 15, copied = 0, tip_clicks = 0,
        drops_a = 0, drops_b = 0, dropped = 0, over_a = false, over_b = false, ghost = false,
    }
}

const FRUITS: [20][]u8 = [
    "Apple", "Apricot", "Banana", "Blackberry", "Blueberry", "Cherry", "Coconut", "Cranberry", "Date", "Fig",
    "Grape", "Guava", "Kiwi", "Lemon", "Lime", "Mango", "Melon", "Orange", "Peach", "Pear",
]

fn show_desk { mut ui: ui::Ui, mut s: Desk } {
    match s.part {
        windows => show_windows{ &ui, &s }
        menus => show_menus{ &ui, &s }
        combo => show_fruit{ &ui, &s }
        dialog => {
            show_windows{ &ui, &s }
            show_dialog{ &ui, &s }
        }
        drag => show_drag{ &ui, &s }
        context => show_context{ &ui, &s }
        tip => show_tip{ &ui, &s }
    }
}

// A button behind everything, and the two windows: Tasks (A) with a button and `rows` labels,
// Notes (B) with a button.
fn show_windows { mut ui: ui::Ui, mut s: Desk } {
    let opts = ui::Opts{ .. }
    if ui::add_button{ &ui, label = "Behind", opts = ui::Opts{ box = ui::place{ x = 60.0, y = 120.0, w = 80.0, h = 28.0 }, .. } } { s.behind = s.behind + 1 }
    let a = ui::begin_window{ &ui, title = "Tasks", open = &s.a_open, window = s.a, opts }
    if a.open {
        if ui::add_button{ &ui, label = "A1", opts } { s.a_clicks = s.a_clicks + 1 }
        for i in 0..s.rows {
            _ = @fmt(&ui, "Row {}", i)
            let text = ui::take_text{ &ui }
            ui::add_label{ &ui, text, opts }
        }
    }
    ui::end{ &ui, scope = a }
    let b = ui::begin_window{ &ui, title = "Notes", open = &s.b_open, window = s.b, opts }
    if b.open {
        if ui::add_button{ &ui, label = "B1", opts } { s.b_clicks = s.b_clicks + 1 }
    }
    ui::end{ &ui, scope = b }
}

fn show_dialog { mut ui: ui::Ui, mut s: Desk } {
    let opts = ui::Opts{ .. }
    let d = ui::begin_dialog{ &ui, title = "Confirm", open = &s.dialog, opts }
    if d.open {
        ui::add_label{ &ui, text = "Save the changes?", opts }
        if ui::add_button{ &ui, label = "OK", opts } {
            s.ok_clicks = s.ok_clicks + 1
            s.dialog = false
        }
    }
    ui::end{ &ui, scope = d }
}

// A menu bar at the top of a column `bar_left` units across: File (Open, Save disabled, Recent
// with two files, a separator, Autosave), Edit (Cut, Paste) and View (Undo).
fn show_menus { mut ui: ui::Ui, mut s: Desk } {
    let opts = ui::Opts{ .. }
    let col = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ width = ui::GROW, padding = ui::Insets{ left = s.bar_left, .. }, .. } }
    let bar = ui::begin_menu_bar{ &ui, opts }
    {
        let file = ui::begin_menu{ &ui, label = "File", opts }
        if file.open {
            if ui::add_menu_item{ &ui, label = "Open", opts } { s.opened = s.opened + 1 }
            if ui::add_menu_item{ &ui, label = "Save", opts = ui::Opts{ enabled = false, .. } } { s.saved = s.saved + 1 }
            let recent = ui::begin_menu{ &ui, label = "Recent", opts }
            if recent.open {
                if ui::add_menu_item{ &ui, label = "notes.txt", opts } { s.recent = 0 }
                if ui::add_menu_item{ &ui, label = "plan.md", opts } { s.recent = 1 }
            }
            ui::end{ &ui, scope = recent }
            ui::add_menu_separator{ &ui }
            _ = ui::add_menu_check{ &ui, label = "Autosave", value = &s.autosave, opts }
        }
        ui::end{ &ui, scope = file }
    }
    {
        let edit = ui::begin_menu{ &ui, label = "Edit", opts }
        if edit.open {
            if ui::add_menu_item{ &ui, label = "Cut", opts } { s.cut = s.cut + 1 }
            if ui::add_menu_item{ &ui, label = "Paste", opts } { s.pasted = s.pasted + 1 }
        }
        ui::end{ &ui, scope = edit }
    }
    {
        let view = ui::begin_menu{ &ui, label = "View", opts }
        if view.open {
            if ui::add_menu_item{ &ui, label = "Undo", opts } { s.undone = s.undone + 1 }
        }
        ui::end{ &ui, scope = view }
    }
    ui::end{ &ui, scope = bar }
    ui::end{ &ui, scope = col }
}

fn show_fruit { mut ui: ui::Ui, mut s: Desk } {
    let col = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ padding = ui::inset{ by = 10.0 }, gap = 8.0, .. } }
    _ = ui::add_combo{ &ui, label = "fruit", value = &s.fruit, items = FRUITS[..], opts = ui::Opts{ .. } }
    if ui::add_button{ &ui, label = "Behind", opts = ui::Opts{ .. } } { s.behind = s.behind + 1 }
    ui::end{ &ui, scope = col }
}

// A target box with a context menu (Copy, Paste disabled).
fn show_context { mut ui: ui::Ui, mut s: Desk } {
    let opts = ui::Opts{ .. }
    let target = ui::make_id{ ui, name = "target" }
    let it = ui::press{ &ui, id = target, opts = ui::PressOpts{ .. } }
    let el = ui::begin_element{ &ui, id = target, axis = ui::Axis::row, box = ui::Box{ place = ui::Place{ x = 20.0, y = 20.0, .. }, width = ui::fix{ size = 120.0 }, height = ui::fix{ size = 60.0 }, fill = ui.theme.control, .. } }
    ui::end{ &ui, scope = el }
    ui::describe{ &ui, id = target, role = ui::Role::panel, label = "target", value = 0.0, flags = if it.focused { ui::NODE_FOCUSED } else { 0 } }
    let menu = ui::begin_context_menu{ &ui, id = "target menu", target, opts }
    if menu.open {
        if ui::add_menu_item{ &ui, label = "Copy", opts } { s.copied = s.copied + 1 }
        _ = ui::add_menu_item{ &ui, label = "Paste", opts = ui::Opts{ enabled = false, .. } }
    }
    ui::end{ &ui, scope = menu }
}

// A button with a tooltip, and another button to hold.
fn show_tip { mut ui: ui::Ui, mut s: Desk } {
    let col = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ padding = ui::inset{ by = 10.0 }, gap = 8.0, .. } }
    if ui::add_button{ &ui, label = "Hold", opts = ui::Opts{ .. } } { s.tip_clicks = s.tip_clicks + 1 }
    _ = ui::add_button{ &ui, label = "Tipped", opts = ui::Opts{ tip = "A tip", .. } }
    ui::end{ &ui, scope = col }
}

// A source chip carrying a fruit (value 7) and two targets: A takes fruit, B takes vegetables.
fn show_drag { mut ui: ui::Ui, mut s: Desk } {
    let t = ui.theme
    let src = ui::make_id{ ui, name = "chip" }
    let it = ui::press{ &ui, id = src, opts = ui::PressOpts{ .. } }
    let chip = ui::begin_element{ &ui, id = src, axis = ui::Axis::row, box = ui::Box{ place = ui::Place{ x = 20.0, y = 20.0, .. }, width = ui::fix{ size = 60.0 }, height = ui::fix{ size = 28.0 }, fill = t.control, .. } }
    ui::end{ &ui, scope = chip }
    ui::describe{ &ui, id = src, role = ui::Role::button, label = "chip", value = 0.0, flags = 0 }
    let ghost = ui::begin_drag{ &ui, it, payload = ui::Payload{ kind = "fruit", value = 7 } }
    s.ghost = ghost.open
    if ghost.open { ui::add_label{ &ui, text = "Pear", opts = ui::Opts{ .. } } }
    ui::end{ &ui, scope = ghost }
    add_target{ &ui, &s, name = "fruit bin", kind = "fruit", x = 20.0, first = true }
    add_target{ &ui, &s, name = "veg bin", kind = "veg", x = 160.0, first = false }
}

fn add_target { mut ui: ui::Ui, mut s: Desk, name: []u8, kind: []u8, x: f32, first: bool } {
    let t = ui.theme
    let id = ui::make_id{ ui, name }
    let drop = ui::accept_drop{ &ui, target = id, kind }
    let fill = if drop.over { t.selection } else { t.surface }
    let el = ui::begin_element{ &ui, id, axis = ui::Axis::row, box = ui::Box{ place = ui::Place{ x, y = 100.0, .. }, width = ui::fix{ size = 120.0 }, height = ui::fix{ size = 80.0 }, fill, .. } }
    ui::end{ &ui, scope = el }
    ui::describe{ &ui, id, role = ui::Role::panel, label = name, value = 0.0, flags = 0 }
    if first { s.over_a = drop.over } else { s.over_b = drop.over }
    if drop.dropped {
        if first { s.drops_a = s.drops_a + 1 } else { s.drops_b = s.drops_b + 1 }
        s.dropped = drop.value
    }
}

// ---- helpers

fn find_rect { ui: ui::Ui, path: []u8 } -> ui::Rect {
    let n = ui::find_node{ ui, path } ifnull { return ui::Rect{ x = -1, y = -1, w = -1, h = -1 } }
    return n.rect
}

fn has_node { ui: ui::Ui, path: []u8 } -> bool {
    return ui::find_node{ ui, path } != null
}

fn is_rect { r: ui::Rect, x: i32, y: i32, w: i32, h: i32 } -> bool {
    return r.x == x and r.y == y and r.w == w and r.h == h
}

// Presses the left button at the node's centre, moves by (dx, dy) in `steps` equal frames, and
// releases: the driver's drag in several moves.
fn drag_in_steps { mut d: ui_test::Driver, mut ui: ui::Ui, path: []u8, dx: i32, dy: i32, steps: i32, show: &fn{ mut ui: ui::Ui } } -> bool {
    let at = ui_test::find_center{ ui, path } ifnull { return false }
    _ = ui_test::move_pointer{ &ui, x = at.x, y = at.y }
    ui_test::step_frame{ &d, &ui, show }
    _ = ui_test::push_button{ &ui, button = 0, down = true, clicks = 1 }
    ui_test::step_frame{ &d, &ui, show }
    for k in 1..steps + 1 {
        _ = ui_test::move_pointer{ &ui, x = at.x + dx * k / steps, y = at.y + dy * k / steps }
        ui_test::step_frame{ &d, &ui, show }
    }
    _ = ui_test::push_button{ &ui, button = 0, down = false, clicks = 1 }
    ui_test::step_frame{ &d, &ui, show }
    return true
}

// A right click at (x, y): move, press and release over three frames.
fn click_right { mut d: ui_test::Driver, mut ui: ui::Ui, x: i32, y: i32, show: &fn{ mut ui: ui::Ui } } {
    _ = ui_test::move_pointer{ &ui, x, y }
    ui_test::step_frame{ &d, &ui, show }
    _ = ui_test::push_button{ &ui, button = 1, down = true, clicks = 1 }
    ui_test::step_frame{ &d, &ui, show }
    _ = ui_test::push_button{ &ui, button = 1, down = false, clicks = 1 }
    ui_test::step_frame{ &d, &ui, show }
}

// Moves the pointer onto the node at `path` and runs a frame.
fn hover_node { mut d: ui_test::Driver, mut ui: ui::Ui, path: []u8, show: &fn{ mut ui: ui::Ui } } -> bool {
    let at = ui_test::find_center{ ui, path } ifnull { return false }
    _ = ui_test::move_pointer{ &ui, x = at.x, y = at.y }
    ui_test::step_frame{ &d, &ui, show }
    return true
}

// A key tapped and a frame run.
fn press_window_key { mut d: ui_test::Driver, mut ui: ui::Ui, key: ui::Key, show: &fn{ mut ui: ui::Ui } } {
    _ = ui_test::tap_key{ &ui, key, mods = 0 }
    ui_test::step_frame{ &d, &ui, show }
}

// Where in the draw list the first rect shape filled with `color` is; -1 when there is none.
fn find_fill { ui: ui::Ui, color: ui::Color } -> i32 {
    for i in 0..@as(usize, ui.draw.count) {
        match ui.draw.cmds[i] {
            rect{ style } => {
                let f = style.fill
                if f.r == color.r and f.g == color.g and f.b == color.b and f.a == color.a { return @as(i32, i) }
            }
            else => {}
        }
    }
    return -1
}

// Where in the draw list the first rect shape at exactly `r` is; -1 when there is none.
fn find_shape_at { ui: ui::Ui, r: ui::Rect } -> i32 {
    for i in 0..@as(usize, ui.draw.count) {
        match ui.draw.cmds[i] {
            rect{ rect } => { if rect.x == r.x and rect.y == r.y and rect.w == r.w and rect.h == r.h { return @as(i32, i) } }
            else => {}
        }
    }
    return -1
}

// ---- goldens

// A window at rest, and with its close button focused by keys (Tab past Behind and the
// arrow), in one theme.
fn record_window { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8, update: bool, dark: bool } {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = make_ui{ &heap, dark } iferr { return }
    let mut d = make_driver{ &heap, width = 320, height = 240, scale = 1.0 } iferr { return }
    let mut s = make_desk{ part = Part::windows }
    s.b_open = false
    ui_test::step_frames{ &d, ui = &gui, show = show_desk{ &s, _ }, count = 2 }
    write_frame{ &sink, ui = gui, name = "a window at rest" } iferr { return }
    let r = find_rect{ ui = gui, path = "Tasks" }
    let bar = find_rect{ ui = gui, path = "Tasks/.title" }
    let close = find_rect{ ui = gui, path = "Tasks/.close" }
    let grip = find_rect{ ui = gui, path = "Tasks/.grip" }
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = 0 }      // Behind
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = 0 }      // the arrow
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = 0 }      // the cross
    ui_test::step_frames{ &d, ui = &gui, show = show_desk{ &s, _ }, count = 2 }
    write_frame{ &sink, ui = gui, name = "its close button focused by keys" } iferr { return }
    let focused = has_node_flag{ ui = gui, path = "Tasks/.close", flag = ui::NODE_FOCUSED }
    ui_test::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = if dark { "windows-window-dark" } else { "windows-window-light" }, actual = ui_rec::get_text{ sink }, scratch, update }
    ui_test::expect{ &io, &t, ok = is_rect{ r, x = 40, y = 40, w = 200, h = 150 } and is_rect{ r = bar, x = 41, y = 41, w = 198, h = 28 },
        what = "window: 200 by 150 at (40, 40), its title bar inside its 1-pixel border, 28 high" }
    ui_test::expect{ &io, &t, ok = is_rect{ r = close, x = 215, y = 45, w = 20, h = 20 } and is_rect{ r = grip, x = 223, y = 181, w = 16, h = 8 },
        what = "window: the close button 20 square 4 from the bar's end, the grip 16 by 8 in the corner" }
    ui_test::expect{ &io, &t, ok = focused, what = "window: Tab reaches the close button" }
    ui_test::expect{ &io, &t, ok = d.unclean == 0 and sink.lost == 0, what = "window golden: every frame is clean" }
}

// The menu bar with File open by a click and its Recent submenu open by the pointer.
fn record_menu { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8, update: bool } {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = make_ui{ &heap, dark = true } iferr { return }
    let mut d = make_driver{ &heap, width = 400, height = 240, scale = 1.0 } iferr { return }
    let mut s = make_desk{ part = Part::menus }
    s.autosave = true
    ui_test::step_frame{ &d, ui = &gui, show = show_desk{ &s, _ } }
    _ = ui_test::click{ &d, ui = &gui, path = "File", show = show_desk{ &s, _ } }
    _ = hover_node{ &d, ui = &gui, path = "Recent", show = show_desk{ &s, _ } }
    _ = hover_node{ &d, ui = &gui, path = "notes.txt", show = show_desk{ &s, _ } }
    write_frame{ &sink, ui = gui, name = "File and Recent open, notes.txt lit" } iferr { return }
    ui_test::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "windows-menu", actual = ui_rec::get_text{ sink }, scratch, update }
    let file = find_rect{ ui = gui, path = "menu bar/File" }
    let open = find_rect{ ui = gui, path = "File/Open" }
    let recent = find_rect{ ui = gui, path = "File/Recent" }
    let notes = find_rect{ ui = gui, path = "Recent/notes.txt" }
    ui_test::expect{ &io, &t, ok = open.y >= file.y + file.h and open.x > file.x and open.h == 24,
        what = "menu golden: the menu is below its title, its items 24 high" }
    ui_test::expect{ &io, &t, ok = notes.x > recent.x + recent.w and notes.y > recent.y - 8 and notes.y < recent.y + 8,
        what = "menu golden: the submenu is beside its item, level with it" }
    ui_test::expect{ &io, &t, ok = count_text{ ui = gui } == 9, what = "menu golden: the text is three titles, four items of File and two of Recent: no mark is text" }
    ui_test::expect{ &io, &t, ok = d.unclean == 0 and sink.lost == 0, what = "menu golden: every frame is clean" }
}

// The combo's list open on the chosen row (15, Mango) of twenty.
fn record_combo { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8, update: bool } {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = make_ui{ &heap, dark = true } iferr { return }
    let mut d = make_driver{ &heap, width = 320, height = 320, scale = 1.0 } iferr { return }
    let mut s = make_desk{ part = Part::combo }
    ui_test::step_frame{ &d, ui = &gui, show = show_desk{ &s, _ } }
    _ = ui_test::click{ &d, ui = &gui, path = "fruit", show = show_desk{ &s, _ } }
    _ = ui_test::move_pointer{ ui = &gui, x = 300, y = 10 }
    ui_test::step_frames{ &d, ui = &gui, show = show_desk{ &s, _ }, count = 2 }
    write_frame{ &sink, ui = gui, name = "the list open on Mango" } iferr { return }
    ui_test::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "windows-combo", actual = ui_rec::get_text{ sink }, scratch, update }
    ui_test::expect{ &io, &t, ok = d.unclean == 0 and sink.lost == 0, what = "combo golden: every frame is clean" }
}

// A dialog over a window, the scrim between them.
fn record_dialog { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8, update: bool } {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = make_ui{ &heap, dark = false } iferr { return }
    let mut d = make_driver{ &heap, width = 400, height = 300, scale = 1.0 } iferr { return }
    let mut s = make_desk{ part = Part::dialog }
    s.b_open = false
    s.dialog = true
    ui_test::step_frames{ &d, ui = &gui, show = show_desk{ &s, _ }, count = 2 }
    write_frame{ &sink, ui = gui, name = "a dialog over a window" } iferr { return }
    ui_test::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "windows-dialog", actual = ui_rec::get_text{ sink }, scratch, update }
    let scrim = find_fill{ ui = gui, color = gui.theme.scrim }
    let window = find_shape_at{ ui = gui, r = find_rect{ ui = gui, path = "Tasks" } }
    let card = find_shape_at{ ui = gui, r = find_rect{ ui = gui, path = "Confirm" } }
    ui_test::expect{ &io, &t, ok = window >= 0 and scrim > window and card > scrim, what = "dialog golden: the window, then the scrim, then the card" }
    ui_test::expect{ &io, &t, ok = d.unclean == 0 and sink.lost == 0, what = "dialog golden: every frame is clean" }
}

// A drag's ghost over a target that takes it.
fn record_ghost { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8, update: bool } {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = make_ui{ &heap, dark = true } iferr { return }
    let mut d = make_driver{ &heap, width = 320, height = 240, scale = 1.0 } iferr { return }
    let mut s = make_desk{ part = Part::drag }
    ui_test::step_frame{ &d, ui = &gui, show = show_desk{ &s, _ } }
    _ = ui_test::move_pointer{ ui = &gui, x = 50, y = 34 }
    ui_test::step_frame{ &d, ui = &gui, show = show_desk{ &s, _ } }
    _ = ui_test::push_button{ ui = &gui, button = 0, down = true, clicks = 1 }
    ui_test::step_frame{ &d, ui = &gui, show = show_desk{ &s, _ } }
    _ = ui_test::move_pointer{ ui = &gui, x = 80, y = 140 }
    ui_test::step_frames{ &d, ui = &gui, show = show_desk{ &s, _ }, count = 2 }
    write_frame{ &sink, ui = gui, name = "the ghost over the fruit bin" } iferr { return }
    ui_test::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "windows-ghost", actual = ui_rec::get_text{ sink }, scratch, update }
    // The ghost is the last thing drawn: its card and its label.
    let n = @as(usize, gui.draw.count)
    let last_text = n > 0 and gui.draw.cmds[n - 1] is text
    let card_ok = n > 1 and match gui.draw.cmds[n - 2] { rect{ rect } => rect.x == 92 and rect.y == 152, else => false }
    ui_test::expect{ &io, &t, ok = s.ghost and s.over_a and last_text and card_ok, what = "ghost: in the front overlay, 12 units below and right of the pointer, last drawn" }
    _ = ui_test::push_button{ ui = &gui, button = 0, down = false, clicks = 1 }
    ui_test::step_frame{ &d, ui = &gui, show = show_desk{ &s, _ } }
    ui_test::expect{ &io, &t, ok = d.unclean == 0 and sink.lost == 0, what = "ghost golden: every frame is clean" }
}

// A window and the open File menu at scale 1.5: every border the same on all four sides, the
// window 300 by 225 pixels at (60, 60), its title bar 42 high, the menu's items 36 high.
fn record_window_scaled { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8, update: bool } {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = make_ui{ &heap, dark = true } iferr { return }
    let mut d = make_driver{ &heap, width = 480, height = 360, scale = 1.5 } iferr { return }
    let mut s = make_desk{ part = Part::windows }
    s.b_open = false
    ui_test::step_frames{ &d, ui = &gui, show = show_desk{ &s, _ }, count = 2 }
    write_frame{ &sink, ui = gui, name = "a window at scale 1.5" } iferr { return }
    let mut even = has_even_sides{ ui = gui }
    let r = find_rect{ ui = gui, path = "Tasks" }
    let bar = find_rect{ ui = gui, path = "Tasks/.title" }
    let mut m = make_desk{ part = Part::menus }
    ui_test::step_frame{ &d, ui = &gui, show = show_desk{ s = &m, _ } }
    _ = ui_test::click{ &d, ui = &gui, path = "File", show = show_desk{ s = &m, _ } }
    write_frame{ &sink, ui = gui, name = "the File menu at scale 1.5" } iferr { return }
    even = even and has_even_sides{ ui = gui }
    let item = find_rect{ ui = gui, path = "File/Open" }
    ui_test::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "windows-scale", actual = ui_rec::get_text{ sink }, scratch, update }
    ui_test::expect{ &io, &t, ok = even, what = "scale 1.5: every border of a window and a menu is the same on every side it has" }
    ui_test::expect{ &io, &t, ok = is_rect{ r, x = 60, y = 60, w = 300, h = 225 } and bar.h == 42 and bar.x == 62 and item.h == 36,
        what = "scale 1.5: the window 300 by 225 at (60, 60), a 2-pixel border, its bar 42 high, menu items 36" }
    ui_test::expect{ &io, &t, ok = d.unclean == 0 and sink.lost == 0, what = "scale 1.5: every frame is clean" }
}

// The nodes of two windows, a menu with its submenu open, and a combo.
fn record_window_nodes { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8, update: bool } {
    let mut sink = ui_rec::make_sink{ bytes = out }
