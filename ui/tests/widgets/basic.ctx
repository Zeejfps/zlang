// ---- the scenes

enum Widget: u8 { button, checkbox, radio, slider, statics, all }

// What a scene shows and the application state its widgets change.
struct Scene {
    widget: Widget,
    enabled: bool,
    x: i32,                     // where the scene's column stands, in pixels across from 10
    checked: bool, choice: i32, value: f32, range: ui::Range,
    tip: []u8,
    clicks: u32, changes: u32,  // button clicks, and changes any other widget reported
    picture: ui::Region,
}

fn make_scene { widget: Widget } -> Scene {
    return Scene{
        widget, enabled = true, x = 0, checked = false, choice = 0, value = 0.25,
        range = ui::Range{ .. }, tip = "", clicks = 0, changes = 0,
        picture = ui::Region{ image = ui::Image{ id = 3, width = 32, height = 24 }, width = 32, height = 24, .. },
    }
}

// The scene's column: 216 units wide at (10, 10) units, moved across by `s.x` pixels. The
// column is placed in pixels so that a move of one pixel is exactly one at any scale.
fn show_scene { mut ui: ui::Ui, mut s: Scene } {
    let left = ui::add_pixels{ a = ui::to_pixel_position{ ui, position = 10.0 }, b = s.x }
    let top = ui::to_pixel_position{ ui, position = 10.0 }
    let w = ui::to_pixels{ ui, length = 216.0 }
    let h = ui::to_pixels{ ui, length = 600.0 }
    let mut box = ui::place_pixels{ rect = ui::Rect{ x = left, y = top, w, h } }
    box.gap = ui.theme.gap
    let col = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::column, box }
    let opts = ui::Opts{ enabled = s.enabled, tip = s.tip, .. }
    match s.widget {
        button => show_button{ &ui, &s, opts }
        checkbox => show_checkbox{ &ui, &s, opts }
        radio => show_radio{ &ui, &s, opts }
        slider => show_slider{ &ui, &s, opts }
        statics => show_statics{ &ui, &s, opts }
        all => {
            show_button{ &ui, &s, opts }
            show_checkbox{ &ui, &s, opts }
            show_radio{ &ui, &s, opts }
            show_slider{ &ui, &s, opts }
            show_statics{ &ui, &s, opts }
        }
    }
    ui::end{ &ui, scope = col }
}

fn show_button { mut ui: ui::Ui, mut s: Scene, opts: ui::Opts } {
    if ui::add_button{ &ui, label = "Save", opts } { s.clicks = s.clicks + 1 }
}

fn show_checkbox { mut ui: ui::Ui, mut s: Scene, opts: ui::Opts } {
    if ui::add_checkbox{ &ui, label = "Remember me", value = &s.checked, opts } { s.changes = s.changes + 1 }
}

fn show_radio { mut ui: ui::Ui, mut s: Scene, opts: ui::Opts } {
    let row = ui::begin_row{ &ui, opts = ui::Opts{ .. } }
    if ui::add_radio{ &ui, label = "Small", value = &s.choice, choice = 0, opts } { s.changes = s.changes + 1 }
    if ui::add_radio{ &ui, label = "Large", value = &s.choice, choice = 1, opts } { s.changes = s.changes + 1 }
    ui::end{ &ui, scope = row }
}

fn show_slider { mut ui: ui::Ui, mut s: Scene, opts: ui::Opts } {
    if ui::add_slider{ &ui, label = "volume", value = &s.value, range = s.range, opts } { s.changes = s.changes + 1 }
}

// The widgets that take no input: labels, progress bars, a picture, separators, a spacer in a
// row, a panel, and the six marks.
fn show_statics { mut ui: ui::Ui, mut s: Scene, opts: ui::Opts } {
    ui::add_label{ &ui, text = "Label", opts }
    ui::add_label{ &ui, text = "Named", opts = ui::Opts{ id = "named", enabled = opts.enabled, .. } }
    ui::add_progress{ &ui, value = 0.4, opts = ui::Opts{ id = "done", enabled = opts.enabled, .. } }
    ui::add_image{ &ui, region = s.picture, opts }
    ui::add_separator{ &ui, opts = ui::Opts{ .. } }
    let row = ui::begin_row{ &ui, opts = ui::Opts{ id = "bar", box = ui::Box{ width = ui::GROW, .. }, .. } }
    ui::add_label{ &ui, text = "Left", opts }
    ui::add_separator{ &ui, opts = ui::Opts{ .. } }
    ui::add_spacer{ &ui }
    ui::add_label{ &ui, text = "Right", opts }
    ui::end{ &ui, scope = row }
    let panel = ui::begin_panel{ &ui, opts = ui::Opts{ id = "panel", .. } }
    ui::add_label{ &ui, text = "In a panel", opts }
    ui::end{ &ui, scope = panel }
    let marks = ui::begin_row{ &ui, opts = ui::Opts{ .. } }
    add_mark{ &ui, icon = ui::Icon::check }
    add_mark{ &ui, icon = ui::Icon::cross }
    add_mark{ &ui, icon = ui::Icon::arrow_right }
    add_mark{ &ui, icon = ui::Icon::arrow_down }
    add_mark{ &ui, icon = ui::Icon::arrow_up }
    add_mark{ &ui, icon = ui::Icon::arrow_left }
    ui::end{ &ui, scope = marks }
}

// A mark in a box 16 units square, painted on its pixels.
fn add_mark { mut ui: ui::Ui, icon: ui::Icon } {
    let el = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 16.0 }, height = ui::fix{ size = 16.0 }, .. } }
    let side = ui::to_pixels{ ui, length = 16.0 }
    ui::paint_icon{ &ui, icon, rect = ui::Rect{ x = 0, y = 0, w = side, h = side }, color = ui.theme.text }
    ui::end{ &ui, scope = el }
}

// The path a scene's widget is found by.
fn get_path { widget: Widget } -> []u8 {
    return match widget {
        button => "Save", checkbox => "Remember me", radio => "Large", slider => "volume", statics => "named", all => "Save",
    }
}

// ---- goldens

// One widget in its six looks, a frame each: at rest; hovered; pressed; focused by the click (with
// the pointer gone), which draws no ring; focused by keys (Shift+Tab and Tab, which come back to
// it), which draws the ring; not enabled.
fn record_states {
    mut io: Io, mut fs: Fs, mut t: Test, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8,
    widget: Widget, dark: bool, name: []u8, theme: []u8,
} -> ! {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = try make_ui{ &heap, dark }
    let mut d = try make_driver{ &heap, width = 240, height = 80, scale = 1.0 }
    let mut s = make_scene{ widget }
    let path = get_path{ widget }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }                // 1
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }                // 2
    try write_frame{ &sink, ui = gui, name = "at rest" }
    let at = ui_test::find_center{ ui = gui, path } ifnull {
        // states: the widget's node is found
        @expect(&t, false)
        return
    }
    _ = ui_test::move_pointer{ ui = &gui, x = at.x, y = at.y }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }                // 3
    try write_frame{ &sink, ui = gui, name = "hovered" }
    let hand = d.requests.cursor == ui::Cursor::hand
    _ = ui_test::push_button{ ui = &gui, button = 0, down = true, clicks = 1 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }                // 4
    try write_frame{ &sink, ui = gui, name = "pressed" }
    _ = ui_test::push_button{ ui = &gui, button = 0, down = false, clicks = 1 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }                // 5: the click
    _ = ui_test::move_pointer{ ui = &gui, x = 1, y = 1 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }                // 6
    try write_frame{ &sink, ui = gui, name = "focused by a click" }
    let node = ui::find_node{ ui = gui, path } ifnull ui::Node{ .. }
    let focused = (node.flags & ui::NODE_FOCUSED) != 0
    let unringed = not has_border{ ui = gui, width = 2, color = gui.theme.focus_ring }
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = ui::MOD_SHIFT }
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }                // the keys move focus at its end
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    try write_frame{ &sink, ui = gui, name = "focused by keys" }
    let keyed = ui::find_node{ ui = gui, path } ifnull ui::Node{ .. }
    let ringed = (keyed.flags & ui::NODE_FOCUSED) != 0 and (has_border{ ui = gui, width = 2, color = gui.theme.focus_ring } or widget == Widget::slider)
    s.enabled = false
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }                // 7
    try write_frame{ &sink, ui = gui, name = "not enabled" }
    let off = ui::find_node{ ui = gui, path } ifnull ui::Node{ .. }
    let mut golden: [64]u8
    let n = join_name{ out = golden[..], a = "basic-", b = name, c = theme }
    @expect(&t, ui_check::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = golden[..n], actual = ui_rec::get_text{ sink }, scratch })
    // states: every frame is clean
    @expect(&t, d.unclean == 0 and sink.lost == 0)
    // states: the hand cursor over a widget that can be used
    @expect(&t, hand)
    // states: the widget has the focus after its click
    @expect(&t, focused)
    // states: focus that came by a click draws no ring
    @expect(&t, unringed)
    // states: focus that came by keys draws the ring
    @expect(&t, ringed)
    // states: a widget not enabled says so and has no focus
    @expect(&t, (off.flags & ui::NODE_DISABLED) != 0 and (off.flags & ui::NODE_FOCUSED) == 0)
}

fn join_name { out: []mut u8, a: []u8, b: []u8, c: []u8 } -> usize {
    let n = a.len + b.len + 1 + c.len
    if n > out.len { return 0 }
    slice::copy(u8){ dst = out[..a.len], src = a }
    slice::copy(u8){ dst = out[a.len..a.len + b.len], src = b }
    out[a.len + b.len] = '-'
    slice::copy(u8){ dst = out[a.len + b.len + 1..n], src = c }
    return n
}

// The widgets that take no input, enabled and not.
fn record_static {
    mut io: Io, mut fs: Fs, mut t: Test, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8,
    dark: bool, theme: []u8,
} -> ! {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = try make_ui{ &heap, dark }
    let mut d = try make_driver{ &heap, width = 240, height = 300, scale = 1.0 }
    let mut s = make_scene{ widget = Widget::statics }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    try write_frame{ &sink, ui = gui, name = "at rest" }
    s.enabled = false
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    try write_frame{ &sink, ui = gui, name = "not enabled" }
    let mut golden: [64]u8
    let n = join_name{ out = golden[..], a = "basic-", b = "static", c = theme }
    @expect(&t, ui_check::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = golden[..n], actual = ui_rec::get_text{ sink }, scratch })
    // static: every frame is clean
    @expect(&t, d.unclean == 0 and sink.lost == 0)
}

// A button's tooltip: not before the pointer has rested on it for the theme's half second, and
// below it from then on.
fn record_tooltip { mut io: Io, mut fs: Fs, mut t: Test, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8 } -> ! {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 240, height = 120, scale = 1.0 }
    let mut s = make_scene{ widget = Widget::button }
    s.tip = "Writes the file"
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let at = ui_test::find_center{ ui = gui, path = "Save" } ifnull { return ui_check::refused }
    _ = ui_test::move_pointer{ ui = &gui, x = at.x, y = at.y }
    // Hovered from frame 2; at 0.125 s a frame it has rested half a second in frame 6.
    let mut early = false
    for _ in 0..4 {
        ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
        if count_text{ ui = gui } > 1 { early = true }
    }
    // Hovered for 0.375 s at frame 5: it asks to be woken when the rest of the theme's 0.5 s is up.
    let asking = not d.requests.animating and ui_check::has_wake{ requests = d.requests, want = 0.125 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    try write_frame{ &sink, ui = gui, name = "the tooltip, half a second after the hover began" }
    @expect(&t, ui_check::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "basic-tooltip", actual = ui_rec::get_text{ sink }, scratch })
    // tooltip: shown after tip_delay and not before, with a frame asked for at the delay while waiting
    @expect(&t, not early and asking and count_text{ ui = gui } == 2)
    // tooltip: it is a node
    @expect(&t, ui::find_node{ ui = gui, path = "Writes the file" } != null)
    // tooltip: every frame is clean
    @expect(&t, d.unclean == 0)
}

// Every widget at scale 1.5, at rest and with the first one focused by Tab. Every border is the
// same number of pixels on all four sides, and the boxes are the sizes the length rule gives:
// 28 units is 42 pixels, 16 is 24, a 1-unit border 2, a 2-unit ring 3, 4 units 6, 8 units 12.
fn record_scaled { mut io: Io, mut fs: Fs, mut t: Test, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8 } -> ! {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 360, height = 640, scale = 1.5 }
    let mut s = make_scene{ widget = Widget::all }
    s.checked = true
    s.choice = 1
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    try write_frame{ &sink, ui = gui, name = "every widget at scale 1.5" }
    let mut even = has_even_borders{ ui = gui }
    let sizes = has_rect{ ui = gui, w = -1, h = 42 } and has_rect{ ui = gui, w = 24, h = 24 } and has_rect{ ui = gui, w = -1, h = 6 } and has_rect{ ui = gui, w = -1, h = 12 }
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    try write_frame{ &sink, ui = gui, name = "the button focused by Tab" }
    even = even and has_even_borders{ ui = gui }
    let ring = has_border{ ui = gui, width = 3, color = gui.theme.focus_ring }
    @expect(&t, ui_check::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "basic-scale", actual = ui_rec::get_text{ sink }, scratch })
    // scale 1.5: every border is the same on all four sides
    @expect(&t, even)
    // scale 1.5: controls 42 high, marks 24 square, a track 6 high, a bar 12 high
    @expect(&t, sizes)
    // scale 1.5: a focus ring of 2 units is 3 pixels
    @expect(&t, ring)
    // scale 1.5: every frame is clean
    @expect(&t, d.unclean == 0)
}

fn has_even_borders { ui: ui::Ui } -> bool {
    for i in 0..@as(usize, ui.draw.count) {
        match ui.draw.cmds[i] {
            rect{ style } => {
                let b = style.border
                if b.top != b.right or b.top != b.bottom or b.top != b.left { return false }
            }
            else => {}
        }
    }
    return true
}

// Whether a rect shape of the last frame is `w` by `h` pixels (-1: any).
fn has_rect { ui: ui::Ui, w: i32, h: i32 } -> bool {
    for i in 0..@as(usize, ui.draw.count) {
        match ui.draw.cmds[i] {
            rect{ rect } => { if (w < 0 or rect.w == w) and (h < 0 or rect.h == h) { return true } }
            else => {}
        }
    }
    return false
}

fn has_border { ui: ui::Ui, width: i32, color: ui::Color } -> bool {
    for i in 0..@as(usize, ui.draw.count) {
        match ui.draw.cmds[i] {
            rect{ style } => {
                let c = style.border_color.top
                if style.border.top == width and c.r == color.r and c.g == color.g and c.b == color.b { return true }
            }
            else => {}
        }
    }
    return false
}

// The nodes every widget describes, in a scene of all of them with a checkbox ticked.
fn record_nodes { mut io: Io, mut fs: Fs, mut t: Test, mut heap: arena::Arena, out: []mut u8, scratch: []mut u8 } -> ! {
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 240, height = 640, scale = 1.0 }
    let mut s = make_scene{ widget = Widget::all }
    s.checked = true
    s.value = 0.5
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    try write_nodes{ &sink, ui = gui, name = "every widget's node" }
    @expect(&t, ui_check::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "basic-nodes", actual = ui_rec::get_text{ sink }, scratch })
    // nodes: a named panel and row are nodes
    @expect(&t, ui::find_node{ ui = gui, path = "panel" } != null and ui::find_node{ ui = gui, path = "bar" } != null)
    // nodes: every frame is clean
    @expect(&t, d.unclean == 0)
}

// ---- properties

// No mark is text: the six marks alone draw lines only, and a ticked checkbox draws its label as
// its one text.
#test
fn draws_marks_as_lines_not_text { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 240, height = 80, scale = 1.0 }
    let mut s = make_scene{ widget = Widget::checkbox }
    s.checked = true
    ui_test::step_frame{ &d, ui = &gui, show = show_marks }
    let mut lines: u32 = 0
    for i in 0..@as(usize, gui.draw.count) {
        if gui.draw.cmds[i] is line { lines = lines + 1 }
    }
    // marks: the six marks are twelve lines and no text
    @expect(&t, count_text{ ui = gui } == 0 and lines == 12)
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    // marks: a ticked checkbox's only text is its label
    @expect(&t, count_text{ ui = gui } == 1)
    // marks: every frame is clean
    @expect(&t, d.unclean == 0)
}

fn show_marks { mut ui: ui::Ui } {
    let row = ui::begin_row{ &ui, opts = ui::Opts{ .. } }
    add_mark{ &ui, icon = ui::Icon::check }
    add_mark{ &ui, icon = ui::Icon::cross }
    add_mark{ &ui, icon = ui::Icon::arrow_right }
    add_mark{ &ui, icon = ui::Icon::arrow_down }
    add_mark{ &ui, icon = ui::Icon::arrow_up }
    add_mark{ &ui, icon = ui::Icon::arrow_left }
    ui::end{ &ui, scope = row }
}

// Every widget recorded at eight places a pixel apart draws the same shapes, each moved by exactly
// the offset: rectangles, text and line ends alike, sizes unchanged.
fn check_offsets { mut io: Io, mut t: Test, mut heap: arena::Arena, scale: f32 } -> ! {
    let first = try alloc::make(ui::Cmd, arena::Arena){ realloc = arena::alloc, &heap, count = 2048 }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 400, height = 960, scale }
    let mut s = make_scene{ widget = Widget::all }
    s.checked = true
    s.choice = 1
    s.value = 0.37
    let mut count: usize = 0
    let mut same = true
    for k in 0..8 {
        s.x = k
        ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
        ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
        let n = @as(usize, gui.draw.count)
        if k == 0 {
            count = n
            slice::copy(ui::Cmd){ dst = first[..n], src = gui.draw.cmds[..n] }
            continue
        }
        if n != count {
            same = false
            continue
        }
        for i in 0..n {
            if not is_moved{ a = first[i], b = gui.draw.cmds[i], dx = k } { same = false }
        }
    }
    // offsets: every widget at eight places a pixel apart draws the same shapes moved by the offset
    @expect(&t, count > 20 and same)
    // offsets: every frame is clean
    @expect(&t, d.unclean == 0)
}

// Whether `b` is `a` moved `dx` pixels across and nothing else.
fn is_moved { a: ui::Cmd, b: ui::Cmd, dx: i32 } -> bool {
    match a {
        rect{ rect = r, style = sa } => {
            let rect{ rect = q, style = sb } = b else { return false }
            return q.x == r.x + dx and q.y == r.y and q.w == r.w and q.h == r.h and is_same_style{ a = sa, b = sb }
        }
        text{ x, y, size } => {
            let text{ x = bx, y = by, size = bs } = b else { return false }
            return bx == x + dx and by == y and bs == size
        }
        line{ x0, y0, x1, y1, width } => {
            let line{ x0 = bx0, y0 = by0, x1 = bx1, y1 = by1, width = bw } = b else { return false }
            let f = @as(f32, dx)
            return bx0 == x0 + f and by0 == y0 and bx1 == x1 + f and by1 == y1 and bw == width
        }
        image{ rect = r } => {
            let image{ rect = q } = b else { return false }
            return q.x == r.x + dx and q.y == r.y and q.w == r.w and q.h == r.h
        }
        host => { return b is host }
    }
}

fn is_same_style { a: ui::RectStyle, b: ui::RectStyle } -> bool {
    return a.border.top == b.border.top and a.border.right == b.border.right and a.border.bottom == b.border.bottom and a.border.left == b.border.left
        and a.radius.top_left == b.radius.top_left and a.radius.bottom_right == b.radius.bottom_right
        and a.fill.r == b.fill.r and a.fill.g == b.fill.g and a.fill.b == b.fill.b and a.fill.a == b.fill.a
}

// ---- scripted

// A click on a checkbox flips it, once, and the call says so once; another click flips it back;
// Space flips it while it has the focus.
#test
fn flips_a_checkbox_by_click_and_space { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 240, height = 80, scale = 1.0 }
    let mut s = make_scene{ widget = Widget::checkbox }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let clicked = ui_test::click{ &d, ui = &gui, path = "Remember me", show = show_scene{ &s, _ } }
    // checkbox: a click ticks it, and the call says so once
    @expect(&t, clicked and s.checked and s.changes == 1)
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let node = ui::find_node{ ui = gui, path = "Remember me" } ifnull ui::Node{ .. }
    // checkbox: its node says it is ticked
    @expect(&t, (node.flags & ui::NODE_CHECKED) != 0 and node.value == 1.0)
    _ = ui_test::click{ &d, ui = &gui, path = "Remember me", show = show_scene{ &s, _ } }
    // checkbox: a second click clears it
    @expect(&t, not s.checked and s.changes == 2)
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::space, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    // checkbox: Space ticks it while it has the focus
    @expect(&t, s.checked and s.changes == 3)
    // checkbox: every frame is clean
    @expect(&t, d.unclean == 0)
}

// A drag of the knob by a quarter of the track (200 pixels at scale 1, 300 at 1.5) moves the value
// by a quarter of the range; a drag that ends between steps puts it on the nearest one.
#test
fn drags_a_slider_onto_its_steps { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    for k in 0..2 {
        let scale: f32 = if k == 0 { 1.0 } else { 1.5 }
        let mut gui = try make_ui{ &heap, dark = true }
        let mut d = try make_driver{ &heap, width = 400, height = 160, scale }
        let mut s = make_scene{ widget = Widget::slider }
        s.value = 0.5
        s.range = ui::Range{ min = 0.0, max = 1.0, step = 0.05, .. }
        ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
        let track = ui::to_pixels{ ui = gui, length = 200.0 }
        let dragged = ui_test::drag{ &d, ui = &gui, path = "volume", dx = track / 4, dy = 0, show = show_scene{ &s, _ } }
        // slider: a drag of a quarter of the track moves it by a quarter of the range
        @expect(&t, dragged and s.value > 0.7499 and s.value < 0.7501)
        let before = s.changes
        // The knob back at the middle (where the driver presses), then dragged back by 0.13 of the
        // track: 0.37, which is put on the nearest step of 0.05, 0.35.
        s.value = 0.5
        ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
        let back = ui::round_pixels{ v = @as(f32, track) * 0.13 }
        _ = ui_test::drag{ &d, ui = &gui, path = "volume", dx = -back, dy = 0, show = show_scene{ &s, _ } }
        // slider: a drag that ends between steps puts the value on a step
        @expect(&t, s.value > 0.3499 and s.value < 0.3501 and s.changes > before)
        ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
        let node = ui::find_node{ ui = gui, path = "volume" } ifnull ui::Node{ .. }
        // slider: its node holds the value
        @expect(&t, node.role == ui::Role::slider and node.value == s.value)
        // slider: every frame is clean
        @expect(&t, d.unclean == 0)
    }
}

// The keys step a focused slider: Right adds a step, Left takes one, End and Home go to the ends.
#test
fn steps_a_focused_slider_with_keys { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 240, height = 80, scale = 1.0 }
    let mut s = make_scene{ widget = Widget::slider }
    s.value = 0.5
    s.range = ui::Range{ min = 0.0, max = 1.0, step = 0.1, .. }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }      // Tab gives it focus at this frame's end
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::right, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let right = s.value > 0.5999 and s.value < 0.6001
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::left, mods = 0 }
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::left, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let left = s.value > 0.3999 and s.value < 0.4001
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::end, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let end = s.value == 1.0
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::home, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    // slider: Right, Left, End and Home step a focused slider
    @expect(&t, right and left and end and s.value == 0.0)
    // slider keys: every frame is clean
    @expect(&t, d.unclean == 0)
}

// Tab gives a button the focus (the frame after), then Enter and Space each work it once, and a
// button that does not have the focus takes neither.
#test
fn works_a_focused_button_with_enter_and_space { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 240, height = 80, scale = 1.0 }
    let mut s = make_scene{ widget = Widget::button }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::enter, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let unfocused = s.clicks == 0
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let node = ui::find_node{ ui = gui, path = "Save" } ifnull ui::Node{ .. }
    let focused = (node.flags & ui::NODE_FOCUSED) != 0
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::enter, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let entered = s.clicks == 1
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::space, mods = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    // button: Enter does nothing to a button without the focus
    @expect(&t, unfocused)
    // button: Tab gives it the focus
    @expect(&t, focused)
    // button: Enter and Space each work a focused button once
    @expect(&t, entered and s.clicks == 2)
    // button keys: every frame is clean
    @expect(&t, d.unclean == 0)
}

// A click on a radio button takes its choice, and a click on the chosen one changes nothing.
#test
fn takes_a_radio_buttons_choice { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, dark = false }
    let mut d = try make_driver{ &heap, width = 240, height = 80, scale = 1.0 }
    let mut s = make_scene{ widget = Widget::radio }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    _ = ui_test::click{ &d, ui = &gui, path = "Large", show = show_scene{ &s, _ } }
    let took = s.choice == 1 and s.changes == 1
    _ = ui_test::click{ &d, ui = &gui, path = "Large", show = show_scene{ &s, _ } }
    // radio: a click takes its choice once
    @expect(&t, took and s.choice == 1 and s.changes == 1)
    _ = ui_test::click{ &d, ui = &gui, path = "Small", show = show_scene{ &s, _ } }
    ui_test::step_frame{ &d, ui = &gui, show = show_scene{ &s, _ } }
    let small = ui::find_node{ ui = gui, path = "Small" } ifnull ui::Node{ .. }
    // radio: another click moves the choice, and the nodes say which
    @expect(&t, s.choice == 0 and (small.flags & ui::NODE_CHECKED) != 0)
    // radio: every frame is clean
    @expect(&t, d.unclean == 0)
}

// The themes: every state colour is given, and `derive_theme` fills one that is left at alpha 0
// from its base role and leaves the others.
#test
fn derives_a_theme_from_its_base_roles { mut t: Test, mut io: Io } -> ! {
    let dark = ui::make_dark_theme{}
    let light = ui::make_light_theme{}
    // themes: the built-in themes give every state colour and the stock metrics
    @expect(&t, dark.control_hovered.a == 255 and light.accent_hovered.a == 255 and dark.font_size == 14.0)
    let mut bare = dark
    bare.control_hovered = ui::Color{ a = 0, .. }
    let derived = ui::derive_theme{ theme = bare }
    let want = ui::mix_color{ a = dark.control, b = dark.text, amount = 0.06 }
    // themes: derive_theme fills a state colour left at alpha 0 and keeps the others
    @expect(&t, derived.control_hovered.r == want.r and derived.control_hovered.a == 255 and derived.control_pressed.r == dark.control_pressed.r)
    let half = ui::mix_color{ a = ui::Color{ r = 0, g = 0, b = 0, a = 0 }, b = ui::Color{ r = 255, g = 100, b = 1, a = 255 }, amount = 0.5 }
    // themes: mix_color rounds each channel to the nearest level
    @expect(&t, half.r == 128 and half.g == 50 and half.b == 1 and half.a == 128)
}

// ---- the focus ring: drawn for focus that came by keys, not for focus a click gave

struct Pair { clicks: u32 }

// Two buttons in a row.
fn show_pair { mut ui: ui::Ui, mut p: Pair } {
    let row = ui::begin_row{ &ui, opts = ui::Opts{ box = ui::place_pixels{ rect = ui::Rect{ x = 10, y = 10, w = 200, h = 40 } }, .. } }
    if ui::add_button{ &ui, label = "Save", opts = ui::Opts{ .. } } { p.clicks = p.clicks + 1 }
    if ui::add_button{ &ui, label = "Open", opts = ui::Opts{ .. } } { p.clicks = p.clicks + 1 }
    ui::end{ &ui, scope = row }
}

fn is_node_focused { ui: ui::Ui, path: []u8 } -> bool {
    let n = ui::find_node{ ui, path } ifnull { return false }
    return (n.flags & ui::NODE_FOCUSED) != 0
}

// The rectangle of the first focus ring drawn (a border of 2 in the ring's colour); one of -1s when
// there is none.
fn find_ring { ui: ui::Ui } -> ui::Rect {
    for i in 0..@as(usize, ui.draw.count) {
        match ui.draw.cmds[i] {
            rect{ rect, style } => {
                let c = style.border_color.top
                let f = ui.theme.focus_ring
                if style.border.top == 2 and c.r == f.r and c.g == f.g and c.b == f.b { return rect }
            }
            else => {}
        }
    }
    return ui::Rect{ x = -1, y = -1, w = -1, h = -1 }
}

fn has_ring { ui: ui::Ui } -> bool {
    return find_ring{ ui }.w >= 0
}

// A click focuses a button and draws no ring; Tab to it draws the ring; a click on another takes
// the ring away; Tab after a click draws the ring on the next stop.
#test
fn draws_the_focus_ring_only_for_keys { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 240, height = 80, scale = 1.0 }
    let mut p = Pair{ clicks = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_pair{ &p, _ } }
    _ = ui_test::click{ &d, ui = &gui, path = "Save", show = show_pair{ &p, _ } }
    _ = ui_test::move_pointer{ ui = &gui, x = 1, y = 70 }
    ui_test::step_frame{ &d, ui = &gui, show = show_pair{ &p, _ } }
    // focus ring: a click focuses the button and draws no ring
    @expect(&t, is_node_focused{ ui = gui, path = "Save" } and not has_ring{ ui = gui } and not ui::is_focus_visible{ ui = gui })
    // Shift+Tab and Tab come back to Save: focus that came by keys.
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = ui::MOD_SHIFT }
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = 0 }
    ui_test::step_frames{ &d, ui = &gui, show = show_pair{ &p, _ }, count = 2 }
    let save = ui::find_node{ ui = gui, path = "Save" } ifnull ui::Node{ .. }
    let keyed = find_ring{ ui = gui }
    // focus ring: Tab to the button draws the ring on it
    @expect(&t, is_node_focused{ ui = gui, path = "Save" } and keyed.x == save.rect.x and keyed.w == save.rect.w)
    _ = ui_test::click{ &d, ui = &gui, path = "Open", show = show_pair{ &p, _ } }
    ui_test::step_frame{ &d, ui = &gui, show = show_pair{ &p, _ } }
    // focus ring: a click on another button takes the ring away
    @expect(&t, is_node_focused{ ui = gui, path = "Open" } and not has_ring{ ui = gui })
    _ = ui_test::tap_key{ ui = &gui, key = ui::Key::tab, mods = 0 }
    ui_test::step_frames{ &d, ui = &gui, show = show_pair{ &p, _ }, count = 2 }
    let ring = find_ring{ ui = gui }
    // focus ring: Tab after a click draws the ring on the next stop (wrapping to Save)
    @expect(&t, is_node_focused{ ui = gui, path = "Save" } and ring.x == save.rect.x and ring.w == save.rect.w)
    // focus ring: every frame is clean
    @expect(&t, p.clicks == 2 and d.unclean == 0)
}

// Widgets left out of the tab order: First, then a button, a checkbox, a radio button, a slider, a
// text field, a number entry, a combo and a list with `tab_stop` false, then Last.
const SKIP_ITEMS: [2][]u8 = ["one", "two"]
struct Skips { a: bool, b: i32, v: f32, n: f32, combo: i32, text: [16]u8, len: usize, clicks: u32 }

fn show_skips { mut ui: ui::Ui, mut s: Skips } {
    let col = ui::begin_column{ &ui, opts = ui::Opts{ box = ui::place_pixels{ rect = ui::Rect{ x = 10, y = 10, w = 300, h = 500 } }, .. } }
    let off = ui::Opts{ tab_stop = false, .. }
    _ = ui::add_button{ &ui, label = "First", opts = ui::Opts{ .. } }
    if ui::add_button{ &ui, label = "Skipped", opts = off } { s.clicks = s.clicks + 1 }
    _ = ui::add_checkbox{ &ui, label = "box", value = &s.a, opts = off }
    _ = ui::add_radio{ &ui, label = "radio", value = &s.b, choice = 1, opts = off }
    _ = ui::add_slider{ &ui, label = "slider", value = &s.v, range = ui::Range{ .. }, opts = off }
    let mut buf = ui::TextBuf{ bytes = s.text[..], len = s.len }
    _ = ui::add_text_field{ &ui, label = "field", text = &buf, rules = ui::TextRules{ .. }, opts = off }
    s.len = buf.len
    _ = ui::add_number{ &ui, label = "number", value = &s.n, range = ui::Range{ max = 10.0, step = 1.0, digits = 0, .. }, opts = off }
    _ = ui::add_combo{ &ui, label = "combo", value = &s.combo, items = SKIP_ITEMS[..], opts = off }
    let list = ui::begin_list{ &ui, id = "list", count = 2, row_height = 20.0, opts = ui::Opts{ box = ui::Box{ height = ui::fix{ size = 44.0 }, .. }, tab_stop = false, .. } }
    for i in list.first..list.last {
        let row = ui::begin_list_row{ &ui, list, index = i, selected = false }
        ui::end{ &ui, scope = row.scope }
    }
    ui::end{ &ui, scope = list.scope }
    _ = ui::add_button{ &ui, label = "Last", opts = ui::Opts{ .. } }
    ui::end{ &ui, scope = col }
}

// Tab and Shift+Tab pass every stock widget whose options say it is no tab stop; a click still
// focuses one (a text field takes typing), and Tab from it goes on from its place.
#test
fn tabs_through_the_stock_widgets { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, dark = true }
    let mut d = try make_driver{ &heap, width = 320, height = 520, scale = 1.0 }
    let mut s: Skips
    s.a = false
    s.b = 0
    s.v = 0.0
    s.n = 0.0
    s.combo = 0
    s.len = 0
    s.clicks = 0
    ui_test::step_frame{ &d, ui = &gui, show = show_skips{ &s, _ } }
    // Focus moves at the end of the frame the key is in, so a widget says it has it in the next.
    let first = tap_and_see{ &d, ui = &gui, &s, mods = 0, path = "First" }
    let last = tap_and_see{ &d, ui = &gui, &s, mods = 0, path = "Last" }
    // tab stops: Tab goes to First, then to Last past the eight widgets that are no tab stops, the frame after each key
    @expect(&t, first and last)
    // tab stops: Shift+Tab from Last passes them too
    @expect(&t, tap_and_see{ &d, ui = &gui, &s, mods = ui::MOD_SHIFT, path = "First" })
    _ = ui_test::click{ &d, ui = &gui, path = "field", show = show_skips{ &s, _ } }
    _ = ui_test::type_text{ ui = &gui, text = "hi" }
    ui_test::step_frame{ &d, ui = &gui, show = show_skips{ &s, _ } }
    // tab stops: a click still focuses a field that is no tab stop, and it takes typing
    @expect(&t, is_node_focused{ ui = gui, path = "field" } and slice::eq_bytes{ a = s.text[..s.len], b = "hi" })
    // tab stops: Tab from it goes on from its place, to Last
    @expect(&t, tap_and_see{ &d, ui = &gui, &s, mods = 0, path = "Last" })
    _ = ui_test::click{ &d, ui = &gui, path = "Skipped", show = show_skips{ &s, _ } }
    ui_test::step_frame{ &d, ui = &gui, show = show_skips{ &s, _ } }
    let clicked = s.clicks == 1 and is_node_focused{ ui = gui, path = "Skipped" }
    // tab stops: a click works and focuses the button, and Shift+Tab from it goes back to First
    @expect(&t, clicked and tap_and_see{ &d, ui = &gui, &s, mods = ui::MOD_SHIFT, path = "First" })
    // tab stops: every frame is clean
    @expect(&t, d.unclean == 0)
}

// Tab (with `mods`) and two frames: true when `path` is not focused in the key's frame and is in
// the next.
fn tap_and_see { mut d: ui_test::Driver, mut ui: ui::Ui, mut s: Skips, mods: u8, path: []u8 } -> bool {
    _ = ui_test::tap_key{ &ui, key = ui::Key::tab, mods }
    ui_test::step_frame{ &d, &ui, show = show_skips{ &s, _ } }
    let before = is_node_focused{ ui, path }
    ui_test::step_frame{ &d, &ui, show = show_skips{ &s, _ } }
    return not before and is_node_focused{ ui, path }
}

// With hover as focus (KOTOR's screens), the hovered button takes the focus and shows the ring,
// and a press of it keeps the ring.
#test
fn keeps_the_ring_of_a_hover_focus { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, dark = true }
    gui.config.hover_focus = true
    let mut d = try make_driver{ &heap, width = 240, height = 80, scale = 1.0 }
    let mut p = Pair{ clicks = 0 }
    ui_test::step_frame{ &d, ui = &gui, show = show_pair{ &p, _ } }
    let at = ui_test::find_center{ ui = gui, path = "Open" } ifnull {
        // hover ring: the button is found
        @expect(&t, false)
        return
    }
    _ = ui_test::move_pointer{ ui = &gui, x = at.x, y = at.y }
    ui_test::step_frames{ &d, ui = &gui, show = show_pair{ &p, _ }, count = 2 }
    let hovered = is_node_focused{ ui = gui, path = "Open" } and has_ring{ ui = gui }
    _ = ui_test::push_button{ ui = &gui, button = 0, down = true, clicks = 1 }
    ui_test::step_frame{ &d, ui = &gui, show = show_pair{ &p, _ } }
    _ = ui_test::push_button{ ui = &gui, button = 0, down = false, clicks = 1 }
    ui_test::step_frames{ &d, ui = &gui, show = show_pair{ &p, _ }, count = 2 }
    // hover ring: a hover that gives focus shows the ring
    @expect(&t, hovered)
    // hover ring: a press under hover-focus keeps it
    @expect(&t, p.clicks == 1 and is_node_focused{ ui = gui, path = "Open" } and has_ring{ ui = gui })
    // hover ring: every frame is clean
    @expect(&t, d.unclean == 0)
}
