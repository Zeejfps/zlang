// ui_check: leaving out the tests that cannot run on this machine (no font file, no OpenGL
// context), visibly. `ctxc test` has no skip (spec section 20): a test passes by its checks or
// fails. So a package whose tests need what may be missing declares a `#test_main` fn of its own
// that finds out what is there and calls `run_tests_without`, which runs std's runner on the
// tests that can run and names each one it left out, with the reason, on a line of its own:
//
//     ui/tests/fonts/main.ctx:412: skip: falls_back_to_a_cjk_face: no CJK font at C:/Windows/Fonts/msyh.ttc (set UI_CJK_FONT)
//
// A test left out is "not selected" in the runner's summary line, never "passed".
namespace ui_check {
    // Runs the tests through std's runner (`test::main`), leaving out each one whose name contains
    // one of `without`; with an empty `without` it is std's runner itself. The arguments are the
    // runner's: a test's own process (`--run INDEX`) is passed straight on, and filters and options
    // are kept, so `ctxc test ui/tests/fonts NAME` and `--list` work as everywhere else.
    fn run_tests_without {
        mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut t: Test, args: Args, count: usize,
        case: &fn{ index: usize } -> test::Case, run: &fn{ index: usize } -> i32, without: [][]u8, reason: []u8,
    } -> i32 {
        let in_process = args.len > 0 and args[0] == "--run"
        if in_process or without.len == 0 { return test::main{ &io, &fs, &mem, &proc, &t, args, count, case, run } }
        let pages = mem::reserve{ &mem, size = 67108864 } ifnull {
            io::eprintln{ &io, s = "tests: out of memory" }
            return 1
        }
        let mut heap = arena::new{ buf = pages }
        // The runner's options, with the value of each that takes one, and the filters.
        let mut options = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut filters = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut i: usize = 0
        while i < args.len {
            let a = args[i]
            if a.len > 0 and a[0] == '-' {
                try! list::push{ list = &options, item = a }
                if (a == "--jobs" or a == "--timeout") and i + 1 < args.len {
                    try! list::push{ list = &options, item = args[i + 1] }
                    i = i + 1
                }
            } else {
                try! list::push{ list = &filters, item = a }
            }
            i = i + 1
        }
        // The tests the filters pick, as the runner would, split into those left out and the rest.
        let mut kept = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut left = list::new(usize){ realloc = arena::alloc, &heap }
        for k in 0..count {
            let name = case{ index = k }.name
            if not contains_any{ s = name, parts = list::items{ list = filters }, empty = true } { continue }
            if contains_any{ s = name, parts = without, empty = false } {
                try! list::push{ list = &left, item = k }
            } else {
                try! list::push{ list = &kept, item = name }
            }
        }
        if left.len == 0 { return test::main{ &io, &fs, &mem, &proc, &t, args, count, case, run } }
        for k in list::items{ list = left } {
            let c = case{ index = k }
            _ = @fmt(&io, "{}:{}: skip: {}: {}\n", c.file, c.line, c.name, reason)
            // A kept test's name is a filter: it must not pick a test left out as well.
            for name in list::items{ list = kept } {
                if contains{ s = c.name, part = name } {
                    _ = @fmt(&io, "tests: cannot leave out {}: its name contains {}, which is kept; rename one of them\n", c.name, name)
                    return 1
                }
            }
        }
        io::flush{ &io }
        if kept.len == 0 {
            _ = @fmt(&io, "tests: 0 run, {} skipped: {}\n", left.len, reason)
            return 0
        }
        let mut picked = list::new([]u8){ realloc = arena::alloc, &heap }
        for o in list::items{ list = options } { try! list::push{ list = &picked, item = o } }
        for name in list::items{ list = kept } { try! list::push{ list = &picked, item = name } }
        return test::main{ &io, &fs, &mem, &proc, &t, args = list::items{ list = picked }, count, case, run }
    }

    // Whether `s` contains one of `parts`; `empty` when there are none.
    fn contains_any { s: []u8, parts: [][]u8, empty: bool } -> bool {
        if parts.len == 0 { return empty }
        for p in parts {
            if contains{ s, part = p } { return true }
        }
        return false
    }

    fn contains { s: []u8, part: []u8 } -> bool {
        if part.len > s.len { return false }
        for i in 0..s.len - part.len + 1 {
            if s[i..i + part.len] == part { return true }
        }
        return false
    }

    // A font file's bytes: the path environment variable `variable` names, else the first of
    // `defaults` that can be read. `path` is the one read, or what was tried when none was.
    struct Found { path: []u8, bytes: ?[]u8 }

    // What a test that needs a font returns when the file is not there: its `#test_main` left it
    // out of the run unless the file went away since.
    error missing_font{ path: []u8 }

    fn find_font { mut fs: Fs, mut proc: Proc, mut heap: arena::Arena, variable: []u8, defaults: [][]u8 } -> Found {
        if let path = proc::env{ &proc, name = variable } {
            if path.len > 0 {
                let bytes = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr { return Found{ path, bytes = null } }
                return Found{ path, bytes }
            }
        }
        for path in defaults {
            let bytes = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr { continue }
            return Found{ path, bytes }
        }
        return Found{ path = if defaults.len > 0 { defaults[0] } else { "" }, bytes = null }
    }

    // The platform's fonts, the first that exists of each kind: a Latin face, a face with CJK
    // characters, and an italic face.
    const LATIN_WINDOWS: [1][]u8 = ["C:/Windows/Fonts/segoeui.ttf"]
    const LATIN_MACOS: [1][]u8 = ["/System/Library/Fonts/Helvetica.ttc"]
    const LATIN_LINUX: [2][]u8 = ["/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/TTF/DejaVuSans.ttf"]
    const CJK_WINDOWS: [3][]u8 = ["C:/Windows/Fonts/msyh.ttc", "C:/Windows/Fonts/YuGothR.ttc", "C:/Windows/Fonts/simsun.ttc"]
    const CJK_MACOS: [2][]u8 = ["/System/Library/Fonts/PingFang.ttc", "/System/Library/Fonts/Hiragino Sans GB.ttc"]
    const CJK_LINUX: [2][]u8 = ["/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc", "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc"]
    const ITALIC_WINDOWS: [1][]u8 = ["C:/Windows/Fonts/segoeuii.ttf"]
    const ITALIC_MACOS: [1][]u8 = ["/System/Library/Fonts/Supplemental/Arial Italic.ttf"]
    const ITALIC_LINUX: [2][]u8 = ["/usr/share/fonts/truetype/dejavu/DejaVuSans-Oblique.ttf", "/usr/share/fonts/TTF/DejaVuSans-Oblique.ttf"]

    // The Latin face: UI_FONT, else the platform's.
    fn find_latin_font { mut fs: Fs, mut proc: Proc, mut heap: arena::Arena } -> Found {
        let defaults = match target::OS { windows => { LATIN_WINDOWS[..] } macos => { LATIN_MACOS[..] } linux => { LATIN_LINUX[..] } }
        return find_font{ &fs, &proc, &heap, variable = "UI_FONT", defaults }
    }

    // A face with CJK characters: UI_CJK_FONT, else the platform's.
    fn find_cjk_font { mut fs: Fs, mut proc: Proc, mut heap: arena::Arena } -> Found {
        let defaults = match target::OS { windows => { CJK_WINDOWS[..] } macos => { CJK_MACOS[..] } linux => { CJK_LINUX[..] } }
        return find_font{ &fs, &proc, &heap, variable = "UI_CJK_FONT", defaults }
    }

    // An italic face: UI_ITALIC_FONT, else the platform's.
    fn find_italic_font { mut fs: Fs, mut proc: Proc, mut heap: arena::Arena } -> Found {
        let defaults = match target::OS { windows => { ITALIC_WINDOWS[..] } macos => { ITALIC_MACOS[..] } linux => { ITALIC_LINUX[..] } }
        return find_font{ &fs, &proc, &heap, variable = "UI_ITALIC_FONT", defaults }
    }
}
