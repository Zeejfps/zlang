// Stage 4's screenshot test: text in a real outline font through ui_fonts, staged and drawn by
// ui_gl, at scales 1 and 1.5, in a window of its own; it shares main.ctx's `Shot`, `write_shot`,
// `place_shot` and `BG`. The faces are ui_check's: UI_FONT the Latin face, UI_CJK_FONT one with
// CJK characters registered as the fallback, UI_ITALIC_FONT an italic face for overhang; each
// defaults to the platform's (C:/Windows/Fonts/segoeui.ttf for the Latin face on Windows).
//
// Writes text-gl-1x.png, text-gl-1.5x.png and text-gl.png (both, one above the other). Each line of
// text has a dim guide on the pixel row under its baseline, so a look tells whether glyphs of
// every size, and of the Latin and CJK faces, stand on one line. With no Latin face main.ctx's
// the test is skipped, with the reason; with no CJK or italic face that line is left out.
//
// Checks: nothing dropped anywhere; the device draws what was staged; the first frame uploads the
// atlas and a second identical frame uploads no atlas bytes, with the same pixels; no character of
// the mixed line is missing when the fallback is there; text sits where the core says it does (ink
// under the measured width, none past it).

const TEXT_WIDTH: f32 = 520.0
const TEXT_HEIGHT: f32 = 452.0
const TEXT_INK: ui::Color = ui::Color{ r = 232, g = 234, b = 240, a = 255 }
const TEXT_GUIDE: ui::Color = ui::Color{ r = 70, g = 90, b = 120, a = 255 }
const TEXT_PANEL: ui::Color = ui::Color{ r = 36, g = 40, b = 50, a = 255 }

const TEXT_PARAGRAPH: []u8 = "Wrapped in the real font: the core breaks at spaces and after hyphens, measuring each word by shaping it, so no line runs past the panel's edge."

#test
fn draws_text_in_an_outline_font { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut sdl: ui_sdl::Sdl, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    skip_without_gl_window{ &t, &sdl, &heap }
    let latin_path = ui_check::get_latin_font{ &t, &fs, &proc }
    let cjk = ui_check::find_cjk_font{ &fs, &proc }
    let italic = ui_check::find_italic_font{ &fs, &proc }
    _ = @fmt(&io, "text: font {}; fallback {}{}; italic {}{}\n", latin_path, cjk.path, if cjk.found { "" } else { " (absent)" },
        italic.path, if italic.found { "" } else { " (absent)" })
    let mut log: [16384]u8
    let mut out_buf: [1024]u8
    run_text{ &io, &fs, &sdl, &fonts, &t, &heap, latin = latin_path, cjk = if cjk.found { cjk.path } else { null },
        italic = if italic.found { italic.path } else { null }, out_dir = get_out_dir{ &t, &proc, buf = out_buf[..] }, log = log[..] } iferr err{ error } {
        say_gl_error{ &io, &sdl, error, log = log[..] }
        return error
    }
}

// Which fonts the list has: 0 the Latin face (with the CJK face as its fallback), 1 the italic face.
struct TextFaces { latin: ui_fonts::Face, has_cjk: bool, has_italic: bool }

fn run_text { mut io: Io, mut fs: Fs, mut sdl: ui_sdl::Sdl, mut fonts: ui_fonts::Fonts, mut t: Test, mut heap: arena::Arena,
              latin: []u8, cjk: ?[]u8, italic: ?[]u8, out_dir: []u8, log: []mut u8 } -> ! {
    // latin, cjk and italic are the faces' files, added mapped.
    try ui_sdl::init{ &sdl }
    defer ui_sdl::quit{ &sdl }
    let mut host = try ui_sdl::open_gl_window{ &sdl, realloc = arena::alloc, &heap, title = "ui text shots",
        width = 520, height = 452, hidden = true, resizable = false, clipboard = 4096 }
    defer ui_sdl::close_window{ &sdl, &host }
    let mut dev = try ui_gl::open{ get_proc = ui_sdl::get_gl_proc{ &sdl, _ }, realloc = arena::alloc, &heap, options = ui_gl::Options{ .. }, log }
    defer ui_gl::close{ &dev }

    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    defer ui_fonts::close{ &lib }
    let face = try ui_fonts::add_face_file{ &lib, path = latin, index = 0 }
    let mut faces = TextFaces{ latin = face, has_cjk = false, has_italic = false }
    if let path = cjk {
        let other = try ui_fonts::add_face_file{ &lib, path, index = 0 }
        ui_fonts::add_fallback{ &lib, face = other }
        faces.has_cjk = true
    }
    let mut list = try ui::draw::make{ realloc = arena::alloc, &heap, cmds = 256, text = 8192, clips = 8, fonts = 4 }
    let def = ui_fonts::describe_face{ lib, face } ifnull { return ui_fonts::closed }
    _ = ui::draw::add_font{ &list, font = def }
    if let path = italic {
        let slanted = try ui_fonts::add_face_file{ &lib, path, index = 0 }
        let italic_def = ui_fonts::describe_face{ lib, face = slanted } ifnull { return ui_fonts::closed }
        _ = ui::draw::add_font{ &list, font = italic_def }
        faces.has_italic = true
    }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let mut cache = try ui::text::make_cache{ realloc = arena::alloc, &heap, entries = 256, shaped = 256 }
    let mut staged = try ui_stage::make{ realloc = arena::alloc, &heap, cap = ui_stage::Capacity{
        rects = 256, glyphs = 4096, images = 16, shapes = 256, draws = 64, passes = 2,
        atlas_width = 512, atlas_height = 256, atlas_max_height = 1024, glyph_cache = 2048, raster_bytes = 16384 } }

    let one = try shoot_text_scale{ &io, &fs, &t, &heap, &dev, &staged, &list, &cache, &lib, provider, faces, scale = 1.0, name = "text-gl-1x", out_dir }
    let half = try shoot_text_scale{ &io, &fs, &t, &heap, &dev, &staged, &list, &cache, &lib, provider, faces, scale = 1.5, name = "text-gl-1.5x", out_dir }
    let width = ui::pick_max_u32{ a = one.width, b = half.width }
    let height = one.height + half.height
    let pixels = try alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = @as(usize, width) * @as(usize, height) * 4 }
    for i in 0..pixels.len / 4 {
        pixels[i * 4] = BG.r
        pixels[i * 4 + 1] = BG.g
        pixels[i * 4 + 2] = BG.b
        pixels[i * 4 + 3] = 255
    }
    place_shot{ into = pixels, width, top = 0, shot = one }
    place_shot{ into = pixels, width, top = one.height, shot = half }
    try write_shot{ &io, &fs, &heap, shot = Shot{ pixels, width, height }, name = "text-gl", out_dir }
    _ = @fmt(&io, "text: {} runs shaped, {} cache hits, {} glyphs rasterised, {} missing, {} too big, {} unknown\n",
        lib.stats.shaped, lib.stats.hits, lib.stats.rasterized, lib.stats.missing, lib.stats.too_big, lib.stats.unknown)
}

// A length in logical units as whole pixels at scale `s`, by the rule the core converts by.
fn scale_text_length { s: f32, length: f32 } -> i32 {
    return ui::scale_length{ length, scale = s }
}

// A font size in logical units as the whole pixel size text is drawn at.
fn scale_text_size { s: f32, size: f32 } -> i32 {
    return ui::scale_font_size{ size, scale = s }
}

// One line of text at `size` logical units with its top left at the pixel (`x`, `y`), and a guide
// on the pixel row under its baseline. Everything is whole pixels: the line box's height and its
// ascent come from the core as whole numbers, so the baseline is a pixel row whatever the size,
// and the guide (a one pixel line through that row's middle) lies on exactly that row. The y of
// the next line, in pixels.
fn add_text_line { mut list: ui::DrawList, mut cache: ui::text::Cache, provider: ui::TextProvider, font: ui::Font, s: f32, size: f32, x: i32, y: i32, text: []u8 } -> i32 {
    let pixels = scale_text_size{ s, size }
    let m = ui::text::get_line_metrics{ &cache, list, provider, font, size = pixels }
    let baseline = @as(f32, y + m.ascent)
    let width = ui::text::measure_text{ &cache, list, provider, font, size = pixels, text }
    let reach = 4.0 * s
    ui::draw::add_line{ &list, x0 = @as(f32, x) - reach, y0 = baseline + 0.5, x1 = @as(f32, x + width) + reach, y1 = baseline + 0.5,
        width = 1.0, color = TEXT_GUIDE, cap = ui::Cap::butt, clip = 0 }
    ui::draw::add_text{ &list, font, size = pixels, x, y, text, color = TEXT_INK, clip = 0 }
    return y + m.height
}

// The picture at `scale`, on a surface of that many pixels. The scene is written in logical units
// (16 units from the left, sizes of 11 to 40 units, a panel 300 units wide) and converted here;
// the lines then stack in whole pixels, each a whole line height below the last.
fn build_text_list { mut list: ui::DrawList, mut cache: ui::text::Cache, provider: ui::TextProvider, faces: TextFaces, scale: f32 } {
    let s = scale
    ui::draw::reset{ &list, width = ui::round_pixels{ v = TEXT_WIDTH * s }, height = ui::round_pixels{ v = TEXT_HEIGHT * s } }
    ui::text::reset_cache{ &cache }
    let latin = ui::Font{ index = 0 }
    let x = scale_text_length{ s, length = 16.0 }
    let mut y = scale_text_length{ s, length = 10.0 }
    y = add_text_line{ &list, &cache, provider, font = latin, s, size = 11.0, x, y, text = "11 px: The quick brown fox jumps over the lazy dog. 0123456789 (sharp?)" }
    y = add_text_line{ &list, &cache, provider, font = latin, s, size = 13.0, x, y, text = "13 px: Sphinx of black quartz, judge my vow! @#$%&*[]{}" }
    y = add_text_line{ &list, &cache, provider, font = latin, s, size = 16.0, x, y, text = "16 px: Settings  Open\xE2\x80\xA6  Save as  Cancel  \xC3\x84\xC3\xB6\xC3\xBC \xC3\xA9t\xC3\xA9 \xE2\x80\x94 \xE2\x82\xAC12.50" }
    y = add_text_line{ &list, &cache, provider, font = latin, s, size = 24.0, x, y, text = "24 px: Kerning AV Wa To Ty LT P. office" }
    y = add_text_line{ &list, &cache, provider, font = latin, s, size = 40.0, x, y, text = "AVAWAY Tj gjpqy \xC3\x85\xC3\x84" }
    if faces.has_cjk {
        y = add_text_line{ &list, &cache, provider, font = latin, s, size = 24.0, x, y,
            text = "Mixed: Hello \xE4\xB8\x96\xE7\x95\x8C, \xE6\x97\xA5\xE6\x9C\xAC\xE8\xAA\x9E and \xE4\xB8\xAD\xE6\x96\x87 text" }
        y = add_text_line{ &list, &cache, provider, font = latin, s, size = 16.0, x, y,
            text = "16 px: \xE8\xAE\xBE\xE7\xBD\xAE Settings \xE3\x83\x95\xE3\x82\xA1\xE3\x82\xA4\xE3\x83\xAB File \xE7\xBC\x96\xE8\xBE\x91 Edit" }
    }
    if faces.has_italic {
        y = add_text_line{ &list, &cache, provider, font = ui::Font{ index = 1 }, s, size = 32.0, x, y, text = "Italic: fjord ff Wf /// jag" }
    }
    // A paragraph wrapped to a panel 300 units wide, with 6 units of room on each side and 4 above and below.
    let size = scale_text_size{ s, size = 14.0 }
    let limit = scale_text_length{ s, length = 300.0 }
    let side = scale_text_length{ s, length = 6.0 }
    let edge = scale_text_length{ s, length = 4.0 }
    let mut lines: [16]ui::text::Line
    let wrapped = ui::text::wrap_text{ &cache, list, provider, font = latin, size, text = TEXT_PARAGRAPH, width = limit, lines = lines[..] }
    let m = ui::text::get_line_metrics{ &cache, list, provider, font = latin, size }
    let top = y + edge
    ui::draw::add_rect{ &list, rect = ui::Rect{ x = x - side, y = top, w = limit + 2 * side, h = m.height * @as(i32, wrapped.lines) + 2 * edge }, clip = 0,
        style = ui::RectStyle{ fill = TEXT_PANEL, radius = ui::round{ radius = 4.0 * s }, .. } }
    let mut ly = top + edge
    for l in lines[..@as(usize, wrapped.lines)] {
        ui::draw::add_text{ &list, font = latin, size, x, y = ly, text = TEXT_PARAGRAPH[@as(usize, l.start)..@as(usize, l.end)], color = TEXT_INK, clip = 0 }
        ly = ly + m.height
    }
}

fn shoot_text_scale {
    mut io: Io, mut fs: Fs, mut t: Test, mut heap: arena::Arena, mut dev: ui_gl::Device, mut staged: ui_stage::Staged,
    mut list: ui::DrawList, mut cache: ui::text::Cache, mut lib: ui_fonts::Library, provider: ui::TextProvider, faces: TextFaces,
    scale: f32, name: []u8, out_dir: []u8,
} -> !Shot {
    let missing = lib.stats.missing
    build_text_list{ &list, &cache, provider, faces, scale }
    // text: the list was built with nothing dropped
    @expect(&t, list.dropped == 0 and cache.unknown_font == 0 and cache.no_provider == 0)
    ui_stage::stage{ out = &staged, list = &list, provider }
    // text: the list stages with nothing dropped
    @expect(&t, staged.dropped == 0)
    // text: with the fallback, no character is missing
    @expect(&t, not faces.has_cjk or lib.stats.missing == missing)
    let width = @as(u32, staged.width)
    let height = @as(u32, staged.height)
    try ui_gl::make_target{ &dev, width, height }
    ui_gl::clear{ &dev, color = BG }
    try ui_gl::render{ &dev, staged = &staged }
    _ = @fmt(&io, "{}: {}x{} pixels, {} draws, {} glyph instances, atlas {}x{}, {} atlas bytes uploaded\n",
        name, width, height, dev.stats.draws, staged.glyph_count, staged.atlas.width, staged.atlas.height, dev.stats.atlas_bytes)
    // text: the device drew what was staged
    @expect(&t, dev.stats.draws == staged.draw_count and dev.stats.dropped == 0)
    // text: the first frame uploads the glyphs
    @expect(&t, dev.stats.atlas_bytes > 0)
    let pixels = try alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = @as(usize, width) * @as(usize, height) * 4 }
    try ui_gl::read_pixels{ &dev, into = pixels }
    let shot = Shot{ pixels, width, height }
    try write_shot{ &io, &fs, &heap, shot, name, out_dir }

    // The same frame again: nothing rasterised, no atlas bytes, the same pixels.
    let rasterized = lib.stats.rasterized
    let revision = staged.revision
    build_text_list{ &list, &cache, provider, faces, scale }
    ui_stage::stage{ out = &staged, list = &list, provider }
    ui_gl::clear{ &dev, color = BG }
    try ui_gl::render{ &dev, staged = &staged }
    // text: a second identical frame rasterises nothing and keeps its revision
    @expect(&t, lib.stats.rasterized == rasterized and staged.revision == revision)
    // text: a second identical frame uploads no atlas bytes
    @expect(&t, dev.stats.atlas_bytes == 0 and dev.stats.uploads == 0)
    let again = try alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = pixels.len }
    try ui_gl::read_pixels{ &dev, into = again }
    // text: the second frame has the same pixels
    @expect(&t, slice::eq_bytes{ a = again, b = pixels })
    check_text_ink{ &io, &t, &cache, list, provider, shot, scale }
    return shot
}

// The first line's ink lies inside its measured box, and the pixel columns after the box are
// clear. The box is whole pixels: the line starts on the pixel the scene put it on and is the
// measured width wide, which is the advances rounded up, so no ink may lie past it.
fn check_text_ink { mut io: Io, mut t: Test, mut cache: ui::text::Cache, list: ui::DrawList, provider: ui::TextProvider, shot: Shot, scale: f32 } {
    let text: []u8 = "11 px: The quick brown fox jumps over the lazy dog. 0123456789 (sharp?)"
    let font = ui::Font{ index = 0 }
    let size = scale_text_size{ s = scale, size = 11.0 }
    let width = ui::text::measure_text{ &cache, list, provider, font, size, text }
    let m = ui::text::get_line_metrics{ &cache, list, provider, font, size }
    let left = scale_text_length{ s = scale, length = 16.0 }
    let top = scale_text_length{ s = scale, length = 10.0 }
    let x0 = @as(usize, left)
    let x1 = @as(usize, left + width)
    let y0 = @as(usize, top)
    let y1 = @as(usize, top + m.ascent)      // above the guide
    let mut inside: u32 = 0
    let mut past: u32 = 0
    for y in y0..y1 {
        for x in x0..x1 + 6 {
            let at = (y * @as(usize, shot.width) + x) * 4
            let lit = shot.pixels[at] > 120
            if lit and x < x1 + 1 { inside = inside + 1 }
            if lit and x > x1 + 1 { past = past + 1 }
        }
    }
    // text: the first line's ink lies within its measured width
    @expect(&t, inside > 100 and past == 0)
    if past > 0 { _ = @fmt(&io, "  {} lit pixels past the measured width\n", past) }
}
