// Stages 3 and 4's screenshot tests: the conformance list and text in an outline font, drawn by the
// OpenGL backend in a hidden SDL window. How to run them: ui/AGENTS.md. The package's
// tests are skipped, each with the reason, where SDL opens no OpenGL window or there is no font.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "ui_test_shots", root = "." }
    build::add_sources{ &b, exe, dir = "../../core" }
    build::add_sources{ &b, exe, dir = "../../stage" }
    build::add_sources{ &b, exe, dir = "../../record" }
    build::add_sources{ &b, exe, dir = "../../test" }
    build::add_sources{ &b, exe, dir = "../support" }
    build::add_sources{ &b, exe, dir = "../../gl" }
    build::add_sources{ &b, exe, dir = "../../sdl" }
    match build::os{ &b } {
        macos => {
            build::lib_path{ &b, exe, path = "/opt/homebrew/lib" }        // Homebrew's SDL2
            build::link{ &b, exe, lib = "SDL2" }
        }
        windows => { build::link{ &b, exe, lib = "SDL2" } }
        linux => { build::link{ &b, exe, lib = "SDL2" } }
    }
    build::add_sources{ &b, exe, dir = "../../fonts" }
    build::link{ &b, exe, lib = "freetype" }
    build::link{ &b, exe, lib = "harfbuzz" }
}
