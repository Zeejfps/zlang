// The same input twice gives byte-identical dumps: in two frames of one Ui, with other frames
// between them, and in a Ui made afresh.
#test
fn dumps_the_same_input_identically { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let first_out = try alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 32768 }
    let again_out = try alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 32768 }
    let mut first = ui_rec::make_sink{ bytes = first_out }
    let mut again = ui_rec::make_sink{ bytes = again_out }
    let mut gui = try make_ui{ &heap, cap = get_small{} }

    start_frame{ ui = &gui, scale = 1.5 }
    show_panel{ ui = &gui }
    show_clips{ ui = &gui }
    ui::end_frame{ ui = &gui }
    try write_frame{ sink = &first, ui = gui, name = "frame" }

    start_frame{ ui = &gui, scale = 1.0 }
    show_opacity{ ui = &gui }
    ui::end_frame{ ui = &gui }

    start_frame{ ui = &gui, scale = 1.5 }
    show_panel{ ui = &gui }
    show_clips{ ui = &gui }
    ui::end_frame{ ui = &gui }
    try write_frame{ sink = &again, ui = gui, name = "frame" }
    // the same input two frames on gives a byte-identical dump
    @expect(&t, first.len > 1000 and slice::eq_bytes{ a = ui_rec::get_text{ sink = first }, b = ui_rec::get_text{ sink = again } })

    let mut fresh = try make_ui{ &heap, cap = get_small{} }
    ui_rec::reset_sink{ sink = &again }
    start_frame{ ui = &fresh, scale = 1.5 }
    show_panel{ ui = &fresh }
    show_clips{ ui = &fresh }
    ui::end_frame{ ui = &fresh }
    try write_frame{ sink = &again, ui = fresh, name = "frame" }
    // the same input in another Ui gives a byte-identical dump
    @expect(&t, slice::eq_bytes{ a = ui_rec::get_text{ sink = first }, b = ui_rec::get_text{ sink = again } })
}

// ---- flow and alignment

#test
fn lays_out_flow_and_alignment { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, cap = get_small{} }
    let one = ui::make_id{ ui = gui, name = "one" }
    let two = ui::make_id{ ui = gui, name = "two" }
    let top = ui::make_id{ ui = gui, name = "top" }

    // A row of 200 by 100 with padding 10 and gap 5 holds 40x20 and 60x30. Its inner size is 180
    // by 80 and its children use 40 + 5 + 60 = 105, so 75 is spare along the row. Centred, they
    // start half of it in, rounded down: 37, so x 47 and 92, and the odd pixel is left after
    // them. At the end of the cross axis they sit at y 10 + (80 - 20) = 70 and 10 + (80 - 30) = 60.
    start_frame{ ui = &gui, scale = 1.0 }
    let box = ui::Box{
        width = ui::fix{ size = 200.0 }, height = ui::fix{ size = 100.0 }, gap = 5.0,
        padding = ui::Insets{ left = 10.0, top = 10.0, right = 10.0, bottom = 10.0 },
        align_x = ui::Align::center, align_y = ui::Align::end, ..
    }
    let row = ui::begin_element{ ui = &gui, id = top, axis = ui::Axis::row, box }
    let a = ui::begin_element{ ui = &gui, id = one, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 40.0 }, height = ui::fix{ size = 20.0 }, .. } }
    ui::end{ ui = &gui, scope = a }
    let b = ui::begin_element{ ui = &gui, id = two, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 60.0 }, height = ui::fix{ size = 30.0 }, .. } }
    ui::end{ ui = &gui, scope = b }
    ui::end{ ui = &gui, scope = row }
    ui::end_frame{ ui = &gui }
    // the aligned row's frame is clean
    @expect(&t, is_clean{ ui = gui })
    // an element in the flow of the surface starts at its top left
    @expect(&t, is_same_rect{ r = find_rect{ ui = gui, id = top }, x = 0, y = 0, w = 200, h = 100 })
    // a centred row moves its first child by half the spare room, rounded down
    @expect(&t, is_same_rect{ r = find_rect{ ui = gui, id = one }, x = 47, y = 70, w = 40, h = 20 })
    // the second child follows the first by its width and the gap
    @expect(&t, is_same_rect{ r = find_rect{ ui = gui, id = two }, x = 92, y = 60, w = 60, h = 30 })

    // The same in a column that is too small: spare room is never negative, so children start at
    // the padding edge and run past the far one. A scroll offset moves the flow children up.
    start_frame{ ui = &gui, scale = 1.0 }
    let tight = ui::Box{
        width = ui::fix{ size = 50.0 }, height = ui::fix{ size = 40.0 }, gap = 5.0,
        align_x = ui::Align::end, align_y = ui::Align::center, ..
    }
    let column = ui::begin_element{ ui = &gui, id = top, axis = ui::Axis::column, box = tight }
    gui.tree.elements[@as(usize, ui::tree::get_open{ ui = gui })].scroll_y = 8
    let c = ui::begin_element{ ui = &gui, id = one, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 40.0 }, height = ui::fix{ size = 20.0 }, .. } }
    ui::end{ ui = &gui, scope = c }
    let d = ui::begin_element{ ui = &gui, id = two, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 60.0 }, height = ui::fix{ size = 30.0 }, .. } }
    ui::end{ ui = &gui, scope = d }
    ui::end{ ui = &gui, scope = column }
    ui::end_frame{ ui = &gui }
    // a short column starts its children at the start edge, less the scroll offset
    @expect(&t, is_same_rect{ r = find_rect{ ui = gui, id = one }, x = 10, y = -8, w = 40, h = 20 })
    // a child wider than its column starts at the column's edge
    @expect(&t, is_same_rect{ r = find_rect{ ui = gui, id = two }, x = 0, y = 17, w = 60, h = 30 })
}

// ---- get_rect: the last finished frame's rectangles

#test
fn answers_get_rect_from_the_last_frame { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, cap = get_small{} }
    let id = ui::make_id{ ui = gui, name = "mover" }
    // before any frame an id has no rectangle
    @expect(&t, ui::get_rect{ ui = gui, id } == null)

    start_frame{ ui = &gui, scale = 1.0 }
    add_box{ ui = &gui, id, x = 10.0, y = 20.0, w = 30.0, h = 40.0 }
    // an element has no rectangle in the frame that first records it
    @expect(&t, ui::get_rect{ ui = gui, id } == null)
    ui::end_frame{ ui = &gui }
    // after end_frame the rectangle is this frame's
    @expect(&t, is_same_rect{ r = find_rect{ ui = gui, id }, x = 10, y = 20, w = 30, h = 40 })

    start_frame{ ui = &gui, scale = 1.0 }
    add_box{ ui = &gui, id, x = 100.0, y = 200.0, w = 50.0, h = 60.0 }
    // while a frame is recorded get_rect answers the previous frame's rectangle
    @expect(&t, is_same_rect{ r = find_rect{ ui = gui, id }, x = 10, y = 20, w = 30, h = 40 })
    ui::end_frame{ ui = &gui }
    // and the new one once the frame has ended
    @expect(&t, is_same_rect{ r = find_rect{ ui = gui, id }, x = 100, y = 200, w = 50, h = 60 })
    // the anonymous id has no rectangle
    @expect(&t, ui::get_rect{ ui = gui, id = ui::NO_ID } == null)

    start_frame{ ui = &gui, scale = 1.0 }
    ui::end_frame{ ui = &gui }
    // an element that is no longer recorded has no rectangle
    @expect(&t, ui::get_rect{ ui = gui, id } == null and gui.stats.hits == 0)
}

// ---- the Ui as an @fmt sink

#test
fn formats_into_the_ui_as_a_sink { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, cap = get_small{} }
    start_frame{ ui = &gui, scale = 1.0 }
    let level: f32 = 0.375
    _ = @fmt(&gui, "Volume {:.1} %", level * 100.0)
    let volume = ui::take_text{ ui = &gui }
    // a decimal formats into the frame's arena with a spec
    @expect(&t, slice::eq_bytes{ a = volume, b = "Volume 37.5 %" })
    // Floats without a spec are written plainly, as std writes them; every spec works.
    let ten: f32 = 10.0
    let tenth: f32 = 0.1
    let wide: f64 = 1234567.0
    let tiny: f32 = 0.00001
    _ = @fmt(&gui, "{} {} {} {} {}", ten, tenth, -2.5, wide, tiny)
    let plain = ui::take_text{ ui = &gui }
    // f32 and f64 without a spec: std's shortest text
    @expect(&t, slice::eq_bytes{ a = plain, b = "10.0 0.1 -2.5 1234567.0 1e-05" })
    let n: i32 = -42
    let id: u32 = 255
    let digits: u32 = 2
    _ = @fmt(&gui, "[{:>6}] [{:<6}] [{:06}] [{:08X}] [{:b}] [{:8.2}] [{:^9}] [{}]", n, id, n, id, 5, ten / 3.0, "mid", ui::write_fixed{ v = ten / 3.0, digits, _ })
    let specs = ui::take_text{ ui = &gui }
    // specs in the Ui sink: width, alignment, zeros, bases, a precision, text; write_fixed with a digit count at run time
    @expect(&t, slice::eq_bytes{ a = specs, b = "[   -42] [255   ] [-00042] [000000FF] [101] [    3.33] [   mid   ] [3.33]" })
    let done: usize = 3
    let count: u32 = 12
    _ = @fmt(&gui, "{} of {} done, {}", done, count, true)
    let summary = ui::take_text{ ui = &gui }
    // integers and a bool format, and take_text starts after the last one
    @expect(&t, slice::eq_bytes{ a = summary, b = "3 of 12 done, true" })
    // the text taken first is still there
    @expect(&t, slice::eq_bytes{ a = volume, b = "Volume 37.5 %" })
    // nothing formatted is nothing taken
    @expect(&t, ui::take_text{ ui = &gui }.len == 0)
    // Formatted text is a label like any other.
    ui::add_text{ ui = &gui, text = summary, style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::end_frame{ ui = &gui }
    // formatted text draws as a label
    @expect(&t, is_clean{ ui = gui } and gui.draw.count == 1)
    // taken text lives until the next begin_frame
    @expect(&t, slice::eq_bytes{ a = volume, b = "Volume 37.5 %" })
}

// ---- scopes: unclosed, stray ends, an outer end with inner scopes open

#test
fn recovers_from_unclosed_and_stray_scopes { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, cap = get_small{} }
    let first = ui::make_id{ ui = gui, name = "first" }
    let after = ui::make_id{ ui = gui, name = "after" }

    // Scopes left open at end_frame are closed for the caller, counted and reported.
    start_frame{ ui = &gui, scale = 1.0 }
    _ = ui::push_id{ ui = &gui, name = "left" }
    _ = ui::begin_element{ ui = &gui, id = first, axis = ui::Axis::row, box = place_filled{ x = 10.0, y = 10.0, w = 20.0, h = 20.0, color = ACCENT } }
    _ = ui::push_key{ ui = &gui, key = 7 }
    ui::end_frame{ ui = &gui }
    // three scopes left open are counted
    @expect(&t, gui.stats.unclosed == 3)
    // and reported as one problem
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::unclosed_scope })
    // whose path is the id scopes that were open
    @expect(&t, slice::eq_bytes{ a = get_path{ ui = gui, kind = ui::ProblemKind::unclosed_scope }, b = "left/#7" })
    // the frame is still emitted
    @expect(&t, gui.draw.count == 1 and gui.stats.dropped == 0)

    // The next frame starts from nothing.
    start_frame{ ui = &gui, scale = 1.0 }
    add_box{ ui = &gui, id = after, x = 0.0, y = 0.0, w = 5.0, h = 5.0 }
    ui::end_frame{ ui = &gui }
    // the frame after an unclosed one is clean
    @expect(&t, is_clean{ ui = gui } and gui.stats.unclosed == 0)
    // and records at the top level again
    @expect(&t, gui.tree.elements[1].parent == 0)

    // ui::end with a scope that is not open closes nothing and is reported.
    start_frame{ ui = &gui, scale = 1.0 }
    let once = ui::begin_element{ ui = &gui, id = first, axis = ui::Axis::row, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = once }
    ui::end{ ui = &gui, scope = once }
    // ending a scope twice is a stray end
    @expect(&t, gui.stats.stray_ends == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::stray_end })
    ui::end{ ui = &gui, scope = ui::Scope{ depth = 5, open = true, serial = 99 } }
    // ending a scope that never was is a stray end
    @expect(&t, gui.stats.stray_ends == 2)
    ui::end{ ui = &gui, scope = ui::Scope{ .. } }
    // ending a closed widget's scope does nothing and is no problem
    @expect(&t, gui.stats.stray_ends == 2)
    // A stale token at a depth that is open again closes nothing either.
    let reopened = ui::begin_element{ ui = &gui, id = after, axis = ui::Axis::row, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = once }
    // an ended scope's token does not close the scope opened after it
    @expect(&t, gui.stats.stray_ends == 3 and gui.ids.depth == 1)
    ui::end{ ui = &gui, scope = reopened }
    // which its own token closes
    @expect(&t, gui.ids.depth == 0)
    ui::end_frame{ ui = &gui }
    // three stray ends are three problems and nothing else
    @expect(&t, gui.stats.unclosed == 0 and gui.stats.problems == 3 and gui.stats.dropped == 0)

    // Ending an outer scope ends what is still open inside it: that is the rule, not a problem.
    start_frame{ ui = &gui, scale = 1.0 }
    let outer = ui::push_id{ ui = &gui, name = "outer" }
    let mid = ui::begin_element{ ui = &gui, id = first, axis = ui::Axis::row, box = place_filled{ x = 0.0, y = 0.0, w = 50.0, h = 50.0, color = ACCENT } }
    let inner = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ .. } }
    let in_scope = ui::make_id{ ui = gui, name = "x" }
    ui::end{ ui = &gui, scope = outer }
    // ending the outer scope closes the two inside it, with no problem
    @expect(&t, gui.ids.depth == 0 and gui.stats.problems == 0)
    // and ids are the top level's again
    @expect(&t, ui::make_id{ ui = gui, name = "x" } != in_scope)
    add_box{ ui = &gui, id = after, x = 0.0, y = 0.0, w = 5.0, h = 5.0 }
    // what is recorded next is a child of the surface
    @expect(&t, gui.tree.elements[3].parent == 0)
    ui::end{ ui = &gui, scope = inner }
    ui::end{ ui = &gui, scope = mid }
    // the inner scopes' own ends are then stray
    @expect(&t, gui.stats.stray_ends == 2)
    ui::end_frame{ ui = &gui }
    // and the frame is emitted whole
    @expect(&t, gui.stats.unclosed == 0 and gui.draw.count == 2)
}

// ---- duplicate ids

#test
fn reports_duplicate_ids { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, cap = get_small{} }
    start_frame{ ui = &gui, scale = 1.0 }
    let items = ui::push_id{ ui = &gui, name = "items" }
    let row = ui::push_key{ ui = &gui, key = 3 }
    let id = ui::make_id{ ui = gui, name = "done" }
    add_box{ ui = &gui, id, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    add_box{ ui = &gui, id, x = 20.0, y = 0.0, w = 10.0, h = 10.0 }
    add_box{ ui = &gui, id = ui::NO_ID, x = 40.0, y = 0.0, w = 10.0, h = 10.0 }
    add_box{ ui = &gui, id = ui::NO_ID, x = 60.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end{ ui = &gui, scope = row }
    let other = ui::push_key{ ui = &gui, key = 4 }
    add_box{ ui = &gui, id = ui::make_id{ ui = gui, name = "done" }, x = 80.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end{ ui = &gui, scope = other }
    ui::end{ ui = &gui, scope = items }
    ui::end_frame{ ui = &gui }
    // two elements with one id are one duplicate; anonymous ones and other rows are none
    @expect(&t, gui.stats.duplicate_ids == 1 and gui.stats.problems == 1)
    // the problem names the id
    @expect(&t, gui.problem_count == 1 and gui.problems[0].kind == ui::ProblemKind::duplicate_id and gui.problems[0].id == id)
    // and the path of the scopes around it
    @expect(&t, slice::eq_bytes{ a = get_path{ ui = gui, kind = ui::ProblemKind::duplicate_id }, b = "items/#3" })
    // both elements are recorded, drawn and hit-testable
    @expect(&t, gui.draw.count == 5 and gui.stats.hits == 3 and gui.stats.dropped == 0)

    // The same id in the next frame is not a duplicate.
    start_frame{ ui = &gui, scale = 1.0 }
    add_box{ ui = &gui, id, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &gui }
    // an id used once a frame is never a duplicate
    @expect(&t, is_clean{ ui = gui } and gui.stats.duplicate_ids == 0)
}

// ---- frames: begin twice, end without begin, calls outside a frame

#test
fn reports_frames_begun_twice_or_never { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, cap = get_small{} }

    // Before any frame: nothing panics, nothing is recorded, each call is reported.
    ui::end_frame{ ui = &gui }
    // end_frame before any begin_frame is reported
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::frame_not_open })
    let s = ui::begin_element{ ui = &gui, id = ui::make_id{ ui = gui, name = "early" }, axis = ui::Axis::row, box = ui::Box{ .. } }
    ui::paint_rect{ ui = &gui, rect = ui::Rect{ w = 5, h = 5, .. }, style = fill_with{ color = WHITE } }
    ui::paint_text{ ui = &gui, font = gui.theme.font, size = 16, x = 0, y = 0, text = "early", color = WHITE }
    ui::add_text{ ui = &gui, text = "early", style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::add_host_slot{ ui = &gui, slot = 1, box = ui::Box{ .. } }
    let p = ui::push_id{ ui = &gui, name = "early" }
    let k = ui::push_key{ ui = &gui, key = 1 }
    ui::end{ ui = &gui, scope = k }
    ui::end{ ui = &gui, scope = p }
    ui::end{ ui = &gui, scope = s }
    // a begin outside a frame returns a closed scope
    @expect(&t, not s.open and not p.open and not k.open)
    // every call outside a frame is reported
    @expect(&t, gui.stats.problems == 8 and count_kept{ ui = gui, kind = ui::ProblemKind::frame_not_open } == 8)
    // and records nothing
    @expect(&t, gui.tree.count == 0 and gui.draw.count == 0)

    // A frame, then end_frame twice: the second does nothing, and the draw list stays.
    start_frame{ ui = &gui, scale = 1.0 }
    add_box{ ui = &gui, id = ui::NO_ID, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &gui }
    // begin_frame clears the problems of before
    @expect(&t, is_clean{ ui = gui } and gui.draw.count == 1)
    ui::end_frame{ ui = &gui }
    // end_frame twice is reported
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::frame_not_open })
    // and leaves the draw list as it was
    @expect(&t, gui.draw.count == 1 and is_same_rect{ r = get_shape_rect{ ui = gui, at = 0 }, x = 0, y = 0, w = 10, h = 10 })

    // begin_frame twice: the open frame is abandoned and the new one reports it.
    start_frame{ ui = &gui, scale = 1.0 }
    add_box{ ui = &gui, id = ui::make_id{ ui = gui, name = "lost" }, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    _ = ui::push_id{ ui = &gui, name = "open" }
    start_frame{ ui = &gui, scale = 1.0 }
    add_box{ ui = &gui, id = ui::make_id{ ui = gui, name = "kept" }, x = 50.0, y = 50.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &gui }
    // begin_frame twice is reported, once
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::frame_open })
    // only the second frame is emitted
    @expect(&t, gui.draw.count == 1 and is_same_rect{ r = get_shape_rect{ ui = gui, at = 0 }, x = 50, y = 50, w = 10, h = 10 })
    // nothing of the abandoned frame is left
    @expect(&t, gui.stats.unclosed == 0 and gui.stats.elements == 1 and gui.stats.dropped == 0)
    // the abandoned frame's element has no rectangle
    @expect(&t, ui::get_rect{ ui = gui, id = ui::make_id{ ui = gui, name = "lost" } } == null)

    // A surface of no size, and one whose numbers are not sizes or scales.
    ui::begin_frame{ ui = &gui, frame = ui::FrameInfo{ width = 0, height = 0, scale = 1.0, dt = 0.0 } }
    add_box{ ui = &gui, id = ui::make_id{ ui = gui, name = "kept" }, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &gui }
    // a surface of no size emits nothing and is no problem
    @expect(&t, gui.draw.count == 0 and gui.scale == 1.0 and is_clean{ ui = gui })
    let nan: f32 = ui::sqrt_f32{ x = -1.0 }
    ui::begin_frame{ ui = &gui, frame = ui::FrameInfo{ width = -5, height = -2147483648, scale = nan, dt = nan } }
    add_box{ ui = &gui, id = ui::NO_ID, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &gui }
    // a negative size is no size
    @expect(&t, gui.draw.width == 0 and gui.draw.height == 0 and gui.draw.count == 0)
    // a scale that is not a number is 1
    @expect(&t, gui.scale == 1.0 and ui::get_scale{ ui = gui } == 1.0 and gui.stats.dropped == 0)

    // A scale of 0, a negative one and an absurd one: the frame is laid out at 1, 1 and 64, and
    // a length still converts by the rule.
    let probe = ui::make_id{ ui = gui, name = "probe" }
    ui::begin_frame{ ui = &gui, frame = ui::FrameInfo{ width = 800, height = 600, scale = 0.0, dt = 0.016 } }
    add_box{ ui = &gui, id = probe, x = 10.0, y = 20.0, w = 30.0, h = 40.0 }
    // at a scale of 0 a length converts at scale 1
    @expect(&t, ui::to_pixels{ ui = gui, length = 10.4 } == 10 and ui::to_pixels{ ui = gui, length = 0.2 } == 1)
    ui::end_frame{ ui = &gui }
    // a scale of 0 lays the frame out at scale 1
    @expect(&t, is_clean{ ui = gui } and is_same_rect{ r = find_rect{ ui = gui, id = probe }, x = 10, y = 20, w = 30, h = 40 })
    ui::begin_frame{ ui = &gui, frame = ui::FrameInfo{ width = 800, height = 600, scale = -2.0, dt = 0.016 } }
    add_box{ ui = &gui, id = probe, x = 10.0, y = 20.0, w = 30.0, h = 40.0 }
    ui::end_frame{ ui = &gui }
    // a negative scale lays the frame out at scale 1
    @expect(&t, is_clean{ ui = gui } and is_same_rect{ r = find_rect{ ui = gui, id = probe }, x = 10, y = 20, w = 30, h = 40 })
    ui::begin_frame{ ui = &gui, frame = ui::FrameInfo{ width = 800, height = 600, scale = 1.0e30, dt = 0.016 } }
    add_box{ ui = &gui, id = probe, x = 1.0, y = 2.0, w = 3.0, h = 4.0 }
    ui::end_frame{ ui = &gui }
    // an absurd scale is held at 64
    @expect(&t, gui.scale == 64.0 and is_clean{ ui = gui } and is_same_rect{ r = find_rect{ ui = gui, id = probe }, x = 64, y = 128, w = 192, h = 256 })

    // The largest surface an i32 can name: it is held at MAX_PIXELS, and nothing overflows when
    // an element is placed at its far corner, fills it, or is centred in it.
    ui::begin_frame{ ui = &gui, frame = ui::FrameInfo{ width = 2147483647, height = 2147483647, scale = 1.0, dt = 0.016 } }
    let far = ui::begin_element{ ui = &gui, id = probe, axis = ui::Axis::row, box = ui::Box{
        width = ui::GROW, height = ui::take{ part = 1.0 }, fill = ACCENT, align_x = ui::Align::center, align_y = ui::Align::end,
        place = ui::Place{ anchor_x = 1.0, anchor_y = 1.0, .. }, hit_outset = ui::inset{ by = 1.0e9 }, padding = ui::inset{ by = 1.0e9 }, gap = 1.0e9, .. } }
    add_box{ ui = &gui, id = ui::NO_ID, x = 1.0e9, y = 1.0e9, w = 1.0e9, h = 1.0e9 }
    let inner = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 3.0e9 }, height = ui::fix_pixels{ size = 2147483647 }, fill = WHITE, .. } }
    ui::end{ ui = &gui, scope = inner }
    let second = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::GROW, height = ui::GROW, fill = WHITE, .. } }
    ui::end{ ui = &gui, scope = second }
    ui::paint_rect{ ui = &gui, rect = ui::Rect{ x = 2147483647, y = -2147483648, w = 2147483647, h = 2147483647 }, style = fill_with{ color = WHITE } }
    ui::end{ ui = &gui, scope = far }
    ui::end_frame{ ui = &gui }
    let big = find_rect{ ui = gui, id = probe }
    // the largest surface is held at MAX_PIXELS and drops nothing
    @expect(&t, gui.draw.width == ui::MAX_PIXELS and gui.draw.height == ui::MAX_PIXELS and gui.stats.dropped == 0)
    // an element that fills it from its far corner is held too, with no overflow
    @expect(&t, big.x == ui::MAX_PIXELS and big.y == ui::MAX_PIXELS and big.w == ui::MAX_PIXELS and big.h == ui::MAX_PIXELS)
}

// ---- a full element array

#test
fn drops_elements_past_a_full_array { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut cap = get_small{}
    cap.elements = 8
    let mut gui = try make_ui{ &heap, cap }
    start_frame{ ui = &gui, scale = 1.0 }
    let mut i: u32 = 0
    while i < 12 {
        add_box{ ui = &gui, id = ui::NO_ID, x = @as(f32, i) * 20.0, y = 0.0, w = 10.0, h = 10.0 }
        i = i + 1
    }
    ui::end_frame{ ui = &gui }
    // an array of 8 elements keeps the first 8
    @expect(&t, gui.stats.elements == 8 and gui.draw.count == 8)
    // and counts the 4 that did not fit
    @expect(&t, gui.stats.dropped == 4)
    // reporting the full array once
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::elements_full })
    // a dropped element's begin and end still pair
    @expect(&t, gui.stats.unclosed == 0 and gui.stats.stray_ends == 0)

    // What is recorded inside an element that did not fit is dropped with it, paints, text and
    // host slots too, and the tree is whole again after its end.
    start_frame{ ui = &gui, scale = 1.0 }
    i = 0
    while i < 8 {
        ui::paint_rect{ ui = &gui, rect = ui::Rect{ x = @as(i32, i) * 20, y = 0, w = 10, h = 10 }, style = fill_with{ color = WHITE } }
        i = i + 1
    }
    let lost = ui::begin_element{ ui = &gui, id = ui::make_id{ ui = gui, name = "lost" }, axis = ui::Axis::row, box = place_filled{ x = 0.0, y = 50.0, w = 100.0, h = 100.0, color = ACCENT } }
    // an element that did not fit opens a scope with no element in it
    @expect(&t, lost.open and ui::tree::get_open{ ui = gui } == ui::tree::NONE)
    ui::paint_rect{ ui = &gui, rect = ui::Rect{ w = 5, h = 5, .. }, style = fill_with{ color = WHITE } }
    ui::add_text{ ui = &gui, text = "lost", style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::add_host_slot{ ui = &gui, slot = 2, box = ui::Box{ .. } }
    let inner = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = inner }
    ui::end{ ui = &gui, scope = lost }
    // after its end the surface is the open element again
    @expect(&t, gui.ids.depth == 0 and ui::tree::get_open{ ui = gui } == 0)
    ui::end_frame{ ui = &gui }
    // the element and the four things inside it are five drops
    @expect(&t, gui.stats.elements == 8 and gui.draw.count == 8 and gui.stats.dropped == 5)
    // and nothing of it is emitted
    @expect(&t, gui.stats.hits == 0 and gui.stats.stray_ends == 0 and gui.stats.unclosed == 0)

    // The frame after a full one is whole.
    start_frame{ ui = &gui, scale = 1.0 }
    add_box{ ui = &gui, id = ui::NO_ID, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &gui }
    // the frame after a full one is clean
    @expect(&t, is_clean{ ui = gui } and gui.draw.count == 1)
}

// ---- a full clip table

#test
fn drops_clips_past_a_full_table { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut cap = get_small{}
    cap.clips = 3       // the whole surface and two more
    let mut gui = try make_ui{ &heap, cap }
    start_frame{ ui = &gui, scale = 1.0 }
    let mut i: u32 = 0
    while i < 4 {
        let mut box = place_clip{ x = @as(f32, i) * 100.0, y = 0.0, w = 50.0, h = 50.0 }
        box.fill = PANEL
        let el = ui::begin_element{ ui = &gui, id = ui::make_id{ ui = gui, name = if i == 3 { "last" } else { "" } }, axis = ui::Axis::row, box }
        ui::paint_rect{ ui = &gui, rect = ui::Rect{ w = 500, h = 500, .. }, style = fill_with{ color = WHITE } }
        ui::paint_text{ ui = &gui, font = gui.theme.font, size = 16, x = 0, y = 0, text = "in", color = WHITE }
        ui::end{ ui = &gui, scope = el }
        i = i + 1
    }
    ui::end_frame{ ui = &gui }
    // Four decorations (drawn under the clip around each element, which is the surface), and the
    // two shapes inside each of the two clips that fit.
    // a table of three clips holds two elements' clips and draws their content
    @expect(&t, gui.draw.clip_count == 3 and gui.draw.count == 8)
    // the two clips that did not fit and the two shapes under each are dropped and counted
    @expect(&t, gui.draw.dropped == 6 and gui.stats.dropped == 6)
    // the full clip table is reported once
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::clips_full })
    let mut unclipped = false
    let mut k: usize = 0
    while k < @as(usize, gui.draw.count) {
        match gui.draw.cmds[k] {
            rect{ rect, clip } => { if rect.w == 500 and clip == 0 { unclipped = true } }
            text{ x, clip } => { if clip == 0 and x >= 200 { unclipped = true } }
            else => {}
        }
        k = k + 1
    }
    // nothing is drawn unclipped in place of what could not be clipped
    @expect(&t, not unclipped)
    let last = find_rect{ ui = gui, id = ui::make_id{ ui = gui, name = "last" } }
    // an element whose clip did not fit still has its rectangle
    @expect(&t, is_same_rect{ r = last, x = 300, y = 0, w = 50, h = 50 })
}

// ---- a full scope stack

#test
fn drops_scopes_past_a_full_stack { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut cap = get_small{}
    cap.scopes = 4
    let mut gui = try make_ui{ &heap, cap }
    let mut scopes: [8]ui::Scope
    start_frame{ ui = &gui, scale = 1.0 }
    let mut i: usize = 0
    while i < 8 {
        scopes[i] = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = place_filled{ x = 2.0, y = 2.0, w = 100.0 - @as(f32, i) * 10.0, h = 100.0 - @as(f32, i) * 10.0, color = ACCENT } }
        i = i + 1
    }
    // eight nested elements on a stack of four: four are kept, all eight are counted
    @expect(&t, gui.ids.depth == 8 and gui.tree.count == 5)
    ui::paint_rect{ ui = &gui, rect = ui::Rect{ w = 5, h = 5, .. }, style = fill_with{ color = WHITE } }
    let deep = ui::push_id{ ui = &gui, name = "deep" }
    ui::end{ ui = &gui, scope = deep }
    // a scope past the stack still pairs with its end
    @expect(&t, gui.ids.depth == 8 and gui.stats.stray_ends == 0)
    i = 8
    while i > 0 {
        i = i - 1
        ui::end{ ui = &gui, scope = scopes[i] }
    }
    // every end finds its begin
    @expect(&t, gui.ids.depth == 0 and gui.stats.stray_ends == 0)
    add_box{ ui = &gui, id = ui::NO_ID, x = 300.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &gui }
    // after the ends the surface is the open element again
    @expect(&t, gui.tree.elements[5].parent == 0)
    // Dropped: the four elements past the stack (each counted by the scope it could not open),
    // the paint inside them, and the id scope past the stack.
    // what was recorded past the stack is dropped and counted
    @expect(&t, gui.stats.dropped == 6 and gui.stats.elements == 5 and gui.draw.count == 5)
    // the full scope stack is reported once
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::scopes_full })
    // and nothing is left open
    @expect(&t, gui.stats.unclosed == 0)

    // Id scopes alone overflow the same way, and end_frame closes whatever is left.
    start_frame{ ui = &gui, scale = 1.0 }
    i = 0
    while i < 10 {
        _ = ui::push_key{ ui = &gui, key = @as(u64, i) }
        i = i + 1
    }
    ui::end_frame{ ui = &gui }
    // ten id scopes left open on a stack of four are closed by end_frame
    @expect(&t, gui.stats.unclosed == 10 and gui.stats.dropped == 6)
    start_frame{ ui = &gui, scale = 1.0 }
    ui::end_frame{ ui = &gui }
    // and the next frame is clean
    @expect(&t, is_clean{ ui = gui })
}

// ---- the other tables: text, hits, shapes, lines

#test
fn drops_past_full_text_hit_shape_and_line_tables { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    // The text arena: 16 bytes hold "0123456789" and not a second copy.
    let mut cap = get_small{}
    cap.text = 16
    let mut gui = try make_ui{ &heap, cap }
    start_frame{ ui = &gui, scale = 1.0 }
    ui::add_text{ ui = &gui, text = "0123456789", style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::add_text{ ui = &gui, text = "0123456789", style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::paint_text{ ui = &gui, font = gui.theme.font, size = 16, x = 0, y = 0, text = "0123456789", color = WHITE }
    _ = @fmt(&gui, "{}", "0123456789")
    let cut = ui::take_text{ ui = &gui }
    ui::end_frame{ ui = &gui }
    // text that does not fit the arena is not recorded
    @expect(&t, gui.draw.count == 1 and gui.stats.elements == 1)
    // three texts that did not fit are counted and the arena reported once
    @expect(&t, gui.stats.dropped == 3 and gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::text_full })
    // formatted text is cut where the arena ends
    @expect(&t, slice::eq_bytes{ a = cut, b = "012345" })

    // Hit regions.
    cap = get_small{}
    cap.hits = 2
    let mut few = try make_ui{ &heap, cap }
    start_frame{ ui = &few, scale = 1.0 }
    add_box{ ui = &few, id = ui::make_id{ ui = few, name = "a" }, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    add_box{ ui = &few, id = ui::make_id{ ui = few, name = "b" }, x = 20.0, y = 0.0, w = 10.0, h = 10.0 }
    add_box{ ui = &few, id = ui::make_id{ ui = few, name = "c" }, x = 40.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &few }
    // a third hit region in a table of two is dropped and counted
    @expect(&t, few.stats.hits == 2 and few.stats.dropped == 1 and has_kept{ ui = few, kind = ui::ProblemKind::hits_full })
    // its element is still drawn
    @expect(&t, few.draw.count == 3)

    // Shapes.
    cap = get_small{}
    cap.cmds = 2
    let mut short = try make_ui{ &heap, cap }
    start_frame{ ui = &short, scale = 1.0 }
    add_box{ ui = &short, id = ui::NO_ID, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    add_box{ ui = &short, id = ui::NO_ID, x = 20.0, y = 0.0, w = 10.0, h = 10.0 }
    add_box{ ui = &short, id = ui::NO_ID, x = 40.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &short }
    // a third shape in a list of two is dropped and counted
    @expect(&t, short.draw.count == 2 and short.draw.dropped == 1 and short.stats.dropped == 1)
    // and the full list is reported
    @expect(&t, short.stats.problems == 1 and has_kept{ ui = short, kind = ui::ProblemKind::shapes_full })

    // Lines of text.
    cap = get_small{}
    cap.lines = 1
    let mut lines = try make_ui{ &heap, cap }
    start_frame{ ui = &lines, scale = 1.0 }
    ui::add_text{ ui = &lines, text = "one", style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::add_text{ ui = &lines, text = "two", style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::end_frame{ ui = &lines }
    // a text with no room in the line table is not drawn, and is counted
    @expect(&t, lines.draw.count == 1 and lines.stats.dropped == 1 and has_kept{ ui = lines, kind = ui::ProblemKind::lines_full })
}

// ---- fonts

fn fake_metrics { mut state: ui::Opaque, handle: u32, pixels: u32 } -> ui::LineMetrics {
    return ui::LineMetrics{ height = @as(f32, pixels) * 1.25 + @as(f32, handle) * 0.0, ascent = @as(f32, pixels) }
}

// Seven pixels a byte, one cluster a byte.
fn fake_shape { mut state: ui::Opaque, handle: u32, pixels: u32, text: []u8, out: []mut ui::Shaped } -> usize {
    let mut n: usize = 0
    while n < text.len and n < out.len {
        out[n] = ui::Shaped{ glyph = @as(u32, text[n]), face = handle + pixels * 0, x_advance = 7.0, cluster = @as(u32, n), .. }
        n = n + 1
    }
    return n
}

fn fake_raster { mut state: ui::Opaque, face: u32, glyph: u32, mut out: ui::GlyphBitmap } -> bool {
    return face == glyph + 1 and out.width == 0
}

struct Fake { calls: u32 }

#test
fn measures_through_the_ui_and_its_fonts { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, cap = get_small{} }
    let known = gui.theme.font
    start_frame{ ui = &gui, scale = 1.0 }
    // "Hello" in the test font measures 40 through the Ui
    @expect(&t, ui::measure_text{ ui = &gui, font = known, size = 16, text = "Hello" } == 40)
    // and 80 at size 32
    @expect(&t, ui::measure_text{ ui = &gui, font = known, size = 32, text = "Hello" } == 80)
    ui::end_frame{ ui = &gui }
    // measuring in a registered font is no problem
    @expect(&t, is_clean{ ui = gui })

    // Text in a font that was never registered is reported with where it was recorded, and not drawn.
    let unknown = ui::Font{ index = 9 }
    start_frame{ ui = &gui, scale = 1.0 }
    let scope = ui::push_id{ ui = &gui, name = "page" }
    ui::add_text{ ui = &gui, text = "lost", style = ui::TextStyle{ font = unknown, .. }, box = ui::Box{ .. } }
    ui::paint_text{ ui = &gui, font = unknown, size = 16, x = 0, y = 20, text = "lost", color = WHITE }
    ui::add_text{ ui = &gui, text = "kept", style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope }
    ui::end_frame{ ui = &gui }
    // text in an unregistered font is not drawn; text in a registered one is
    @expect(&t, gui.draw.count == 1 and gui.draw.dropped == 0)
    // each text in an unregistered font is a problem
    @expect(&t, gui.stats.problems == 2 and count_kept{ ui = gui, kind = ui::ProblemKind::unknown_font } == 2)
    // with the path of where it was recorded
    @expect(&t, slice::eq_bytes{ a = get_path{ ui = gui, kind = ui::ProblemKind::unknown_font }, b = "page" })

    // Measuring alone in such a font is reported too, once, at end_frame.
    start_frame{ ui = &gui, scale = 1.0 }
    // text in an unregistered font has no width
    @expect(&t, ui::measure_text{ ui = &gui, font = unknown, size = 16, text = "Hello" } == 0)
    _ = ui::measure_text{ ui = &gui, font = unknown, size = 16, text = "again" }
    ui::end_frame{ ui = &gui }
    // measuring in an unregistered font is one problem a frame
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::unknown_font })

    // An outline font with no provider measures nothing and is reported; with one it measures.
    let outline_def = ui::FontDef{ kind = ui::FontKind::outline{ handle = 5 }, encoding = ui::Encoding::utf8, height = 0.0, ascent = 0.0 }
    let outline = ui::add_font{ ui = &gui, font = outline_def } ifnull {
        // the font table has room for a second font
        @expect(&t, false)
        return
    }
    start_frame{ ui = &gui, scale = 1.0 }
    ui::add_text{ ui = &gui, text = "abc", style = ui::TextStyle{ font = outline, .. }, box = ui::Box{ .. } }
    ui::end_frame{ ui = &gui }
    // an outline font with no provider is reported
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::no_provider })

    let mut fake = Fake{ calls = 0 }
    ui::set_provider{ ui = &gui, provider = ui::TextProvider{ state = @cast(*mut ui::Opaque, &fake), metrics = fake_metrics, shape = fake_shape, rasterize = fake_raster } }
    let wide = ui::make_id{ ui = gui, name = "wide" }
    start_frame{ ui = &gui, scale = 1.0 }
    let fitted = ui::begin_element{ ui = &gui, id = wide, axis = ui::Axis::row, box = ui::Box{ .. } }
    ui::add_text{ ui = &gui, text = "abc", style = ui::TextStyle{ font = outline, .. }, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = fitted }
    ui::end_frame{ ui = &gui }
    // Three bytes of 7 are 21 wide; the fake face's line is 1.25 times its 16 pixels high.
    // with a provider an outline text is sized by its shaped width and its face's line
    @expect(&t, is_clean{ ui = gui } and is_same_rect{ r = find_rect{ ui = gui, id = wide }, x = 0, y = 0, w = 21, h = 20 })

    // A full font table answers null.
    let mut cap = get_small{}
    cap.fonts = 1
    let mut one = try make_ui{ &heap, cap }
    // a font past the table's room is refused
    @expect(&t, ui::add_font{ ui = &one, font = outline_def } == null)
}

// ---- values that are not sizes

#test
fn converts_values_that_are_not_sizes { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, cap = get_small{} }
    let nan: f32 = ui::sqrt_f32{ x = -1.0 }
    let huge: f32 = 3.0e38
    start_frame{ ui = &gui, scale = 1.5 }
    let odd = ui::Box{
        width = ui::fix{ size = nan }, height = ui::fix{ size = -20.0 }, gap = nan, opacity = nan,
        padding = ui::Insets{ left = nan, top = huge, right = -huge, bottom = nan },
        place = ui::Place{ anchor_x = nan, anchor_y = huge, x = huge, y = -huge },
        hit_outset = ui::Insets{ left = nan, top = huge, right = huge, bottom = nan },
        fill = WHITE, clip = true, radius = ui::round{ radius = nan }, ..
    }
    let a = ui::begin_element{ ui = &gui, id = ui::make_id{ ui = gui, name = "odd" }, axis = ui::Axis::row, box = odd }
    // A pixel rectangle cannot hold a fraction or a NaN, but it can hold any i32: the largest and
    // the most negative ones must not overflow a sum.
    let most: i32 = 2147483647
    let least: i32 = -2147483648
    ui::paint_rect{ ui = &gui, rect = ui::Rect{ x = most, y = least, w = -1, h = most }, style = fill_with{ color = WHITE } }
    ui::paint_rect{ ui = &gui, rect = ui::Rect{ x = least, y = least, w = most, h = most }, style = ui::RectStyle{ fill = WHITE, border = ui::Sides{ top = most, right = least, bottom = -1, left = most }, border_color = ui::color_sides{ color = WHITE }, .. } }
    ui::paint_image{ ui = &gui, rect = ui::Rect{ x = most, y = most, w = most, h = most }, image = PICTURE, uv = ui::Uv{ .. }, tint = WHITE, quarter = 255, angle = nan, blend = ui::Blend::alpha }
    ui::paint_image{ ui = &gui, rect = ui::Rect{ x = least, y = least, w = most, h = most }, image = PICTURE, uv = ui::Uv{ .. }, tint = WHITE, quarter = 1, angle = 0.4, blend = ui::Blend::alpha }
    ui::paint_line{ ui = &gui, x0 = nan, y0 = huge, x1 = -huge, y1 = nan, width = nan, color = WHITE, cap = ui::Cap::square }
    ui::paint_text{ ui = &gui, font = gui.theme.font, size = least, x = most, y = least, text = "odd", color = WHITE }
    ui::paint_text{ ui = &gui, font = gui.theme.font, size = most, x = least, y = most, text = "odd", color = WHITE }
    ui::add_text{ ui = &gui, text = "odd", style = ui::TextStyle{ size = -4.0, .. }, box = ui::Box{ width = ui::Size{ kind = ui::SizeKind::part, value = nan, min = huge, max = -1.0, .. }, .. } }
    ui::add_text{ ui = &gui, text = "odd odd odd", style = ui::TextStyle{ size = nan, wrap = true, .. }, box = ui::Box{ .. } }
    ui::add_host_slot{ ui = &gui, slot = 4294967295, box = ui::Box{ width = ui::GROW, height = ui::take{ part = huge }, .. } }
    let b = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ width = ui::fix{ size = huge }, height = ui::fix{ size = huge }, opacity = 7.0, fill = WHITE, .. } }
    ui::end{ ui = &gui, scope = b }
    // A placement in pixels with the extreme numbers, and sizes in pixels that are not sizes.
    let c = ui::begin_element{ ui = &gui, id = ui::make_id{ ui = gui, name = "pixels" }, axis = ui::Axis::row, box = ui::place_pixels{ rect = ui::Rect{ x = most, y = least, w = most, h = -5 } } }
    ui::end{ ui = &gui, scope = c }
    let d = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::fix_pixels{ size = most }, height = ui::fix_pixels{ size = least }, fill = WHITE, .. } }
    ui::end{ ui = &gui, scope = d }
    ui::end{ ui = &gui, scope = a }
    ui::end_frame{ ui = &gui }
    // sizes that are not numbers, or are huge or negative, drop nothing and do not panic
    @expect(&t, gui.stats.dropped == 0 and gui.stats.unclosed == 0)
    // and every element is still recorded
    @expect(&t, gui.stats.elements == 14 and gui.stats.hits == 2)
    let placed = find_rect{ ui = gui, id = ui::make_id{ ui = gui, name = "pixels" } }
    // a pixel placement is held: a negative height is 0, the largest width MAX_PIXELS
    @expect(&t, placed.w == ui::MAX_PIXELS and placed.h == 0 and placed.x <= ui::MAX_PIXELS and placed.y >= -ui::MAX_PIXELS)
    let own = find_rect{ ui = gui, id = ui::make_id{ ui = gui, name = "odd" } }
    // a size that is not a number is 0, and so is a negative one
    @expect(&t, own.w == 0 and own.h == 0)

    // Every length of a frame at scale 1.5 that is not a number: the conversions answer 0.
    start_frame{ ui = &gui, scale = 1.5 }
    // a length that is not a number converts to 0, and a font size is a pixel at least
    @expect(&t, ui::to_pixels{ ui = gui, length = nan } == 0 and ui::to_pixel_position{ ui = gui, position = nan } == 0 and ui::to_pixels_f32{ ui = gui, length = nan } == 0.0
        and ui::to_font_size{ ui = gui, size = nan } == 1 and ui::to_font_size{ ui = gui, size = -3.0 } == 1 and ui::to_font_size{ ui = gui, size = 0.0 } == 1)
    // a huge length is held at MAX_PIXELS
    @expect(&t, ui::to_pixels{ ui = gui, length = huge } == ui::MAX_PIXELS and ui::to_pixels{ ui = gui, length = -huge } == -ui::MAX_PIXELS and ui::to_pixel_position{ ui = gui, position = huge } == ui::MAX_PIXELS)
    let sides = ui::to_pixel_sides{ ui = gui, insets = ui::Insets{ left = nan, top = huge, right = -3.0, bottom = 1.0 } }
    // insets convert side by side: not a number and negative are 0
    @expect(&t, sides.left == 0 and sides.top == ui::MAX_PIXELS and sides.right == 0 and sides.bottom == 2)
    ui::end_frame{ ui = &gui }
}

// ---- trees beside the base one: what the layers are built on

#test
fn records_trees_beside_the_base_one { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut cap = get_small{}
    cap.layers = 2
    let mut gui = try make_ui{ &heap, cap }
    let under = ui::make_id{ ui = gui, name = "under" }
    let behind = ui::make_id{ ui = gui, name = "behind" }
    let front = ui::make_id{ ui = gui, name = "front" }
    let inside = ui::make_id{ ui = gui, name = "inside" }

    // A tree in front, recorded first, and one behind, recorded in the middle of the base tree.
    start_frame{ ui = &gui, scale = 1.0 }
    let over = ui::tree::open_element{ ui = &gui, id = front, axis = ui::Axis::column, box = place_filled{ x = 300.0, y = 300.0, w = 100.0, h = 100.0, color = WHITE },
        root = ui::tree::RootOpts{ order = ui::tree::BASE_ORDER + 5, .. }, on_end = null }
    add_box{ ui = &gui, id = inside, x = 10.0, y = 10.0, w = 20.0, h = 20.0 }
    let named = ui::push_id{ ui = &gui, name = "in front" }
    // what is recorded inside a tree knows the tree's order
    @expect(&t, ui::tree::get_order{ ui = gui } == ui::tree::BASE_ORDER + 5)
    ui::end{ ui = &gui, scope = over }
    // and the base tree's after it
    @expect(&t, named.open and ui::tree::get_order{ ui = gui } == ui::tree::BASE_ORDER)
    let base = ui::begin_element{ ui = &gui, id = under, axis = ui::Axis::column, box = place_filled{ x = 0.0, y = 0.0, w = 50.0, h = 50.0, color = PANEL } }
    let back = ui::tree::open_element{ ui = &gui, id = behind, axis = ui::Axis::column, box = place_filled{ x = 500.0, y = 0.0, w = 60.0, h = 60.0, color = TRACK },
        root = ui::tree::RootOpts{ order = ui::tree::BASE_ORDER - 5, hits = false, .. }, on_end = null }
    ui::end{ ui = &gui, scope = back }
    // Elements: 0 the surface, 1 the tree in front, 2 the box in it, 3 "under", 4 the tree behind.
    // a root has no parent, and after its end recording goes on where it was
    @expect(&t, ui::tree::get_open{ ui = gui } == 3 and gui.tree.elements[3].parent == 0 and gui.tree.elements[4].parent == ui::tree::NONE)
    ui::paint_rect{ ui = &gui, rect = ui::Rect{ w = 5, h = 5, .. }, style = fill_with{ color = ACCENT } }
    ui::end{ ui = &gui, scope = base }
    ui::end_frame{ ui = &gui }
    // three trees emit five shapes
    @expect(&t, is_clean{ ui = gui } and gui.draw.count == 5)
    // Back to front: the tree behind (500, 0), the base tree (0, 0) and its paint, the tree in
    // front (300, 300) and the element in it at (310, 310).
    // the tree of the smallest order is emitted first
    @expect(&t, is_same_rect{ r = get_shape_rect{ ui = gui, at = 0 }, x = 500, y = 0, w = 60, h = 60 })
    // then the base tree, without the root recorded inside it
    @expect(&t, is_same_rect{ r = get_shape_rect{ ui = gui, at = 1 }, x = 0, y = 0, w = 50, h = 50 } and
        is_same_rect{ r = get_shape_rect{ ui = gui, at = 2 }, x = 0, y = 0, w = 5, h = 5 })
    // then the tree in front, which is placed on the surface, with its content
    @expect(&t, is_same_rect{ r = get_shape_rect{ ui = gui, at = 3 }, x = 300, y = 300, w = 100, h = 100 } and
        is_same_rect{ r = get_shape_rect{ ui = gui, at = 4 }, x = 310, y = 310, w = 20, h = 20 })
    // hit regions are in emission order, the topmost last
    @expect(&t, gui.stats.hits == 4 and gui.emit.hits[0].id == behind and gui.emit.hits[1].id == under and gui.emit.hits[3].id == inside)
    // a tree that makes no hits has rectangles and no hit areas
    @expect(&t, gui.emit.hits[0].area.w == 0 and gui.emit.hits[1].area.w == 50 and gui.emit.hits[0].order == ui::tree::BASE_ORDER - 5)
    // with no modal tree nothing is blocked
    @expect(&t, gui.emit.floor == 0)

    // A modal tree switches off the hit areas of every tree behind it.
    start_frame{ ui = &gui, scale = 1.0 }
    add_box{ ui = &gui, id = under, x = 0.0, y = 0.0, w = 50.0, h = 50.0 }
    let modal = ui::tree::open_element{ ui = &gui, id = front, axis = ui::Axis::column, box = place_filled{ x = 100.0, y = 100.0, w = 200.0, h = 200.0, color = WHITE },
        root = ui::tree::RootOpts{ order = ui::tree::BASE_ORDER + 10, modal = true, .. }, on_end = null }
    ui::end{ ui = &gui, scope = modal }
    let above = ui::tree::open_element{ ui = &gui, id = inside, axis = ui::Axis::column, box = place_filled{ x = 120.0, y = 120.0, w = 20.0, h = 20.0, color = ACCENT },
        root = ui::tree::RootOpts{ order = ui::tree::BASE_ORDER + 20, .. }, on_end = null }
    ui::end{ ui = &gui, scope = above }
    ui::end_frame{ ui = &gui }
    // the frontmost modal tree's order is the floor
    @expect(&t, is_clean{ ui = gui } and gui.emit.floor == ui::tree::BASE_ORDER + 10)
    // what is behind a modal tree keeps its rectangle and loses its hit area
    @expect(&t, gui.emit.hits[0].id == under and gui.emit.hits[0].area.w == 0 and is_same_rect{ r = gui.emit.hits[0].rect, x = 0, y = 0, w = 50, h = 50 })
    // the modal tree and what is in front of it take the pointer
    @expect(&t, gui.emit.hits[1].area.w == 200 and gui.emit.hits[2].area.w == 20)

    // More trees than there is room for: the one that does not fit is dropped with its content.
    start_frame{ ui = &gui, scale = 1.0 }
    let mut i: u32 = 0
    while i < 3 {
        let extra = ui::tree::open_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::column, box = place_filled{ x = @as(f32, i) * 100.0, y = 0.0, w = 50.0, h = 50.0, color = WHITE },
            root = ui::tree::RootOpts{ order = ui::tree::BASE_ORDER + 1 + i, .. }, on_end = null }
        ui::paint_rect{ ui = &gui, rect = ui::Rect{ w = 5, h = 5, .. }, style = fill_with{ color = ACCENT } }
        ui::end{ ui = &gui, scope = extra }
        i = i + 1
    }
    add_box{ ui = &gui, id = ui::NO_ID, x = 0.0, y = 100.0, w = 10.0, h = 10.0 }
    ui::end_frame{ ui = &gui }
    // a third tree with room for two is dropped with the paint inside it
    @expect(&t, gui.draw.count == 5 and gui.stats.dropped == 2)
    // and reported once
    @expect(&t, gui.stats.problems == 1 and has_kept{ ui = gui, kind = ui::ProblemKind::layers_full } and gui.stats.unclosed == 0)
    // the base tree goes on after it
    @expect(&t, is_same_rect{ r = get_shape_rect{ ui = gui, at = 0 }, x = 0, y = 100, w = 10, h = 10 })
}

// ---- what runs when an element's scope closes

// Paints a bar along the bottom of the element that is closing, the way a scroll region does.
fn paint_bar { mut ui: ui::Ui, element: u32 } {
    let inner = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = place_filled{ x = 0.0, y = 90.0, w = 100.0, h = 10.0, color = TRACK } }
    ui::paint_rect{ &ui, rect = ui::Rect{ w = ui::hold_pixels{ v = @as(i64, element) }, h = 4, .. }, style = fill_with{ color = WHITE } }
    // The element is left open on purpose: closing the scope that called this closes it too.
    if element == 4294967295 { ui::end{ &ui, scope = inner } }
}

#test
fn calls_a_scopes_end_hook { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut cap = get_small{}
    cap.elements = 6
    let mut gui = try make_ui{ &heap, cap }
    start_frame{ ui = &gui, scale = 1.0 }
    let region = ui::tree::open_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::column, box = place_filled{ x = 200.0, y = 100.0, w = 100.0, h = 100.0, color = PANEL }, root = null, on_end = paint_bar }
    add_box{ ui = &gui, id = ui::NO_ID, x = 0.0, y = 0.0, w = 10.0, h = 10.0 }
    ui::end{ ui = &gui, scope = region }
    // the hook ran once, and the element it left open was closed with the scope
    @expect(&t, gui.ids.depth == 0 and gui.tree.count == 5)
    ui::end{ ui = &gui, scope = region }
    // a second end does not run it again
    @expect(&t, gui.tree.count == 5 and gui.stats.stray_ends == 1)
    ui::end_frame{ ui = &gui }
    // The region, its content, then what the hook recorded: the bar at (200, 190) and a paint as
    // wide as the region's index, 1.
    // what the hook records lands inside the element, after its content
    @expect(&t, gui.draw.count == 4 and is_same_rect{ r = get_shape_rect{ ui = gui, at = 2 }, x = 200, y = 190, w = 100, h = 10 } and
        is_same_rect{ r = get_shape_rect{ ui = gui, at = 3 }, x = 200, y = 190, w = 1, h = 4 })

    // end_frame runs it for a scope left open; it does not run for an element that was dropped.
    start_frame{ ui = &gui, scale = 1.0 }
    _ = ui::tree::open_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::column, box = place_filled{ x = 0.0, y = 0.0, w = 100.0, h = 100.0, color = PANEL }, root = null, on_end = paint_bar }
    ui::end_frame{ ui = &gui }
    // end_frame runs the hook of a scope it closes
    @expect(&t, gui.stats.unclosed == 1 and gui.draw.count == 3)
    start_frame{ ui = &gui, scale = 1.0 }
    let mut i: u32 = 0
    while i < 6 {
        add_box{ ui = &gui, id = ui::NO_ID, x = @as(f32, i) * 20.0, y = 0.0, w = 10.0, h = 10.0 }
        i = i + 1
    }
    let dropped = ui::tree::open_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ .. }, root = null, on_end = paint_bar }
    ui::end{ ui = &gui, scope = dropped }
    ui::end_frame{ ui = &gui }
    // the hook of an element that did not fit does not run
    @expect(&t, gui.stats.dropped == 1 and gui.draw.count == 6)
}

// ---- what emit draws of a text element: the lines the layout gave it

#test
fn emits_the_lines_the_layout_gave_a_text { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let out = try alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 4096 }
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = try make_ui{ &heap, cap = get_small{} }
    // The frame's steps one by one, as end_frame takes them, with the lines of the one text
    // element replaced between the solve and the emit by what a wrapping layout would give:
    // "hello" and "wor" followed by dots, each 40 wide, in an inner width of 100, right-aligned.
    start_frame{ ui = &gui, scale = 1.0 }
    let mut box = ui::place{ x = 20.0, y = 30.0, w = 120.0, h = 60.0 }
    box.padding = ui::Insets{ left = 10.0, top = 5.0, right = 10.0, bottom = 5.0 }
    ui::add_text{ ui = &gui, text = "hello world", style = ui::TextStyle{ align = ui::Align::end, .. }, box }
    ui::id::close_frame{ ui = &gui }
    ui::layout::solve{ ui = &gui }
    // the solver gives a text element one line, the whole text
    @expect(&t, gui.tree.elements[1].line_count == 1 and gui.layout.line_count == 1 and gui.layout.lines[0].end == 11)
    gui.layout.lines[0] = ui::text::Line{ start = 0, end = 5, width = 40 }
    gui.layout.lines[1] = ui::text::Line{ start = 6, end = 9, width = 48 }
    gui.layout.line_count = 2
    gui.tree.elements[1].line_count = 2
    gui.tree.elements[1].dots = true
    ui::emit::emit_frame{ ui = &gui }
    gui.in_frame = false
    _ = ui_rec::write_list{ &sink, list = &gui.draw }
    // The inner box is (30, 35) 100 wide; the lines are 16 apart; a line 40 wide ends at 130, one
    // 48 wide starts at 82.
    let want = "frame 800x600\ntext 90,35 font=0 size=16 E4E7EDFF clip=0 \"hello\"\ntext 82,51 font=0 size=16 E4E7EDFF clip=0 \"wor...\"\n"
    // emit draws each line at its place, the last with its dots
    @expect(&t, slice::eq_bytes{ a = ui_rec::get_text{ sink }, b = want })
    if not slice::eq_bytes{ a = ui_rec::get_text{ sink }, b = want } { _ = @fmt(&io, "{}", ui_rec::get_text{ sink }) }
}

// ---- the default capacities, and none at all

#test
fn makes_a_ui_with_default_and_no_capacities { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let before = arena::remaining{ heap }
    let mut gui = try make_ui{ &heap, cap = ui::Capacity{ .. } }
    // 7.1 MB at stage 5: 8193 elements of 256 bytes, 32768 shapes of 80, and the rest. Stage 7
    // added 1.4 MB: two node lists of 8192 and their text, the state table, the tab stops and
    // links, and the input's paste buffers (8.6 MB in all).
    let taken = before - arena::remaining{ heap }
    // a Ui of the default capacities takes less than 10 MB
    @expect(&t, taken < 10485760)
    start_frame{ ui = &gui, scale = 1.0 }
    show_panel{ ui = &gui }
    ui::end_frame{ ui = &gui }
    // a Ui of the default capacities draws the panel
    @expect(&t, is_clean{ ui = gui } and gui.draw.count == 9)

    // A Ui with room for nothing: every call still returns.
    let none = ui::Capacity{ elements = 0, text = 0, cmds = 0, clips = 0, hits = 0, states = 0, nodes = 0, fonts = 0, scopes = 0, layers = 0, lines = 0, measures = 0, shaped = 0 }
    let mut empty = try ui::make{ realloc = arena::alloc, &heap, cap = none }
    start_frame{ ui = &empty, scale = 1.0 }
    show_panel{ ui = &empty }
    show_clips{ ui = &empty }
    _ = @fmt(&empty, "{} and {}", 12, "text")
    _ = ui::take_text{ ui = &empty }
    ui::end_frame{ ui = &empty }
    // a Ui with room for nothing drops everything and does not panic
    @expect(&t, empty.draw.count == 0 and empty.stats.elements == 0 and empty.stats.dropped > 0)
    // and its scopes still pair
    @expect(&t, empty.stats.unclosed == 0 and empty.stats.stray_ends == 0)
}
