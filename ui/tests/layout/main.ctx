// Stage 5's tests: the Ui, ids and scopes, recording, placed layout, emit, and what misuse and full
// tables do. The scenes pinned by golden files are in placed.ctx; the flow solver's tests are in
// flow.ctx, and the properties of whole pixels in pixels.ctx.
//
//   kotor/tools/ctxc test ui/tests/layout                          (from the repository root)
//   kotor/tools/ctxc test ui/tests/layout -- --update-goldens   (after an intended change: rewrites the goldens)

const GOLDEN_DIR: []u8 = "ui/tests/layout/golden"

// ---- helpers

// Room for a few hundred elements: what every check but the one on the default capacities uses.
fn get_small { } -> ui::Capacity {
    return ui::Capacity{
        elements = 256, text = 8192, cmds = 512, clips = 32, hits = 256, states = 16, nodes = 16,
        fonts = 4, scopes = 32, layers = 4, lines = 64, measures = 16, shaped = 16,
    }
}

// A Ui with the test font registered and named in its theme.
fn make_ui { mut heap: arena::Arena, cap: ui::Capacity } -> !ui::Ui {
    let mut gui = try ui::make{ realloc = arena::alloc, &heap, cap }
    let def = try ui_test::make_test_font{ realloc = arena::alloc, &heap }
    if let font = ui::add_font{ ui = &gui, font = def } { gui.theme.font = font }
    return gui
}

// A frame of 800 by 600 logical units at `scale` device pixels a unit: a surface of that many
// pixels (800 by 600 at scale 1, 1200 by 900 at 1.5), which is what a host hands over. The scenes
// are declared in logical units, and what the checks read back (rectangles, the draw list) is
// device pixels; at scale 1 the two are the same numbers.
fn start_frame { mut ui: ui::Ui, scale: f32 } {
    ui::begin_frame{ &ui, frame = ui::FrameInfo{ width = ui::round_pixels{ v = 800.0 * scale }, height = ui::round_pixels{ v = 600.0 * scale }, scale, dt = 0.016 } }
}

fn is_same_rect { r: ui::Rect, x: i32, y: i32, w: i32, h: i32 } -> bool {
    return r.x == x and r.y == y and r.w == w and r.h == h
}

fn is_near { a: f32, b: f32 } -> bool {
    return ui::abs_f32{ x = a - b } < 0.001
}

// The rectangle the last finished frame gave `id`, or one of -1s when it had none.
fn find_rect { ui: ui::Ui, id: ui::Id } -> ui::Rect {
    return ui::get_rect{ ui, id } ifnull ui::Rect{ x = -1, y = -1, w = -1, h = -1 }
}

// Nothing was dropped and no problem was recorded: what every well-formed frame is checked for.
fn is_clean { ui: ui::Ui } -> bool {
    return ui.stats.dropped == 0 and ui.stats.problems == 0 and ui.problem_count == 0 and ui.draw.dropped == 0
}

// Whether the frame recorded a problem of `kind` among those it kept.
fn has_kept { ui: ui::Ui, kind: ui::ProblemKind } -> bool {
    let mut i: usize = 0
    while i < @as(usize, ui.problem_count) {
        if ui.problems[i].kind == kind { return true }
        i = i + 1
    }
    return false
}

// How many problems of `kind` the frame kept.
fn count_kept { ui: ui::Ui, kind: ui::ProblemKind } -> u32 {
    let mut n: u32 = 0
    let mut i: usize = 0
    while i < @as(usize, ui.problem_count) {
        if ui.problems[i].kind == kind { n = n + 1 }
        i = i + 1
    }
    return n
}

// The path of the first kept problem of `kind`; empty when there is none.
fn get_path { ui: ui::Ui, kind: ui::ProblemKind } -> []u8 {
    let mut i: usize = 0
    while i < @as(usize, ui.problem_count) {
        if ui.problems[i].kind == kind { return ui::get_text{ ui, span = ui.problems[i].path } }
        i = i + 1
    }
    return ""
}

// The rectangle of shape `at` when it is a rect; one of -1s otherwise.
fn get_shape_rect { ui: ui::Ui, at: usize } -> ui::Rect {
    let none = ui::Rect{ x = -1, y = -1, w = -1, h = -1 }
    if at >= @as(usize, ui.draw.count) { return none }
    match ui.draw.cmds[at] {
        rect{ rect } => { return rect }
        else => { return none }
    }
}

// A filled element of `w` by `h` placed at (`x`, `y`) in the open element, with `id`.
fn add_box { mut ui: ui::Ui, id: ui::Id, x: f32, y: f32, w: f32, h: f32 } {
    let el = ui::begin_element{ &ui, id, axis = ui::Axis::row, box = place_filled{ x, y, w, h, color = ACCENT } }
    ui::end{ &ui, scope = el }
}

// The frame as the goldens hold it: a title line, the draw list, then the hit regions.
fn write_frame { mut sink: ui_rec::Sink, ui: ui::Ui, name: []u8 } -> ! {
    try @fmt(&sink, "== {}\n", name)
    try ui_rec::write_list{ &sink, list = &ui.draw }
    let mut i: usize = 0
    while i < @as(usize, ui.emit.hit_count) {
        let hit = ui.emit.hits[i]
        try @fmt(&sink, "hit {} area {}\n", ui_rec::write_rect{ rect = hit.rect, _ }, ui_rec::write_rect{ rect = hit.area, _ })
        i = i + 1
    }
}

// What a golden test records into: a Ui on the tests' font, a sink for its frames and the buffer
// a golden is read into.
struct Scene { gui: ui::Ui, sink: ui_rec::Sink, scratch: []mut u8 }

fn make_scene { mut heap: arena::Arena } -> !Scene {
    let out = try alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 65536 }
    let scratch = try alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 65536 }
    let gui = try make_ui{ &heap, cap = get_small{} }
    return Scene{ gui, sink = ui_rec::make_sink{ bytes = out }, scratch }
}

// Whether the scene's frames, in its sink, are the golden `name`; says why not.
fn compare_scene { mut io: Io, mut fs: Fs, mut t: Test, s: Scene, name: []u8 } -> bool {
    return ui_check::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name, actual = ui_rec::get_text{ sink = s.sink }, scratch = s.scratch }
}

// ---- ids

#test
fn makes_ids_from_names_keys_and_scopes { mut t: Test, mut io: Io, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut gui = try make_ui{ &heap, cap = get_small{} }
    start_frame{ ui = &gui, scale = 1.0 }
    // FNV-1a 64 of "abc" from the offset basis is the published E71FA2190541574B.
    let abc = ui::make_id{ ui = gui, name = "abc" }
    // an id at the top level is FNV-1a 64 of its name
    @expect(&t, @as(u64, abc) == 0xE71FA2190541574B)
    // the same name gives the same id
    @expect(&t, ui::make_id{ ui = gui, name = "abc" } == abc)
    // another name gives another id
    @expect(&t, ui::make_id{ ui = gui, name = "abd" } != abc)
    // an empty name is anonymous
    @expect(&t, ui::make_id{ ui = gui, name = "" } == ui::NO_ID)

    let a = ui::push_id{ ui = &gui, name = "a" }
    let a_bc = ui::make_id{ ui = gui, name = "bc" }
    let a_b = ui::make_id{ ui = gui, name = "b" }
    ui::end{ ui = &gui, scope = a }
    let ab = ui::push_id{ ui = &gui, name = "ab" }
    let ab_c = ui::make_id{ ui = gui, name = "c" }
    ui::end{ ui = &gui, scope = ab }
    // a name inside a scope differs from the name outside it
    @expect(&t, a_b != ui::make_id{ ui = gui, name = "b" })
    // scopes "a" > "bc" and "ab" > "c" and the name "abc" are three ids
    @expect(&t, a_bc != ab_c and a_bc != abc and ab_c != abc)
    // ending a scope brings its parent's ids back
    @expect(&t, ui::make_id{ ui = gui, name = "abc" } == abc)

    let k3 = ui::push_key{ ui = &gui, key = 3 }
    let done3 = ui::make_id{ ui = gui, name = "done" }
    ui::end{ ui = &gui, scope = k3 }
    let k4 = ui::push_key{ ui = &gui, key = 4 }
    let done4 = ui::make_id{ ui = gui, name = "done" }
    ui::end{ ui = &gui, scope = k4 }
    let k3_again = ui::push_key{ ui = &gui, key = 3 }
    let done3_again = ui::make_id{ ui = gui, name = "done" }
    ui::end{ ui = &gui, scope = k3_again }
    // a key scope separates rows and is the same for the same key
    @expect(&t, done3 != done4 and done3 == done3_again)

    // An element scope does not change ids: only id scopes do.
    let el = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ .. } }
    // an element is not an id scope
    @expect(&t, ui::make_id{ ui = gui, name = "abc" } == abc)
    ui::end{ ui = &gui, scope = el }
    ui::end_frame{ ui = &gui }
    // the id frame is clean
    @expect(&t, is_clean{ ui = gui })

    // Ids are the same in another frame and in another Ui.
    let mut other = try make_ui{ &heap, cap = get_small{} }
    start_frame{ ui = &other, scale = 2.0 }
    let k = ui::push_key{ ui = &other, key = 3 }
    // ids do not depend on the Ui or the frame
    @expect(&t, ui::make_id{ ui = other, name = "done" } == done3)
    ui::end{ ui = &other, scope = k }
    ui::end_frame{ ui = &other }
}

// ---- the goldens

#test
fn places_a_panel_of_five_controls_as_the_golden { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let s = try make_scene{ &heap }
    let scratch = s.scratch
    let mut sink = s.sink
    let mut gui = s.gui
    start_frame{ ui = &gui, scale = 1.0 }
    show_panel{ ui = &gui }
    ui::end_frame{ ui = &gui }
    // the panel frame is clean
    @expect(&t, is_clean{ ui = gui })
    try write_frame{ &sink, ui = gui, name = "a panel at the centre of 800 by 600 with five placed controls" }
    @expect(&t, ui_check::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "panel", actual = ui_rec::get_text{ sink }, scratch })
    // The panel, its title, the picture and its image, the slider and its two paints, and two
    // buttons with a label each; every one but the picture's own element draws a shape.
    // the panel is 11 elements, 9 shapes and 5 hit regions
    @expect(&t, gui.stats.elements == 11 and gui.stats.shapes == 9 and gui.stats.hits == 5)
}

