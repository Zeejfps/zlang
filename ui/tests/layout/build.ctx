// The layout tests: the tree, placed layout and emit (stage 5). How to run them: ui/AGENTS.md.
fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "ui_test_layout", root = "." }
    build::add_sources{ &b, exe, dir = "../../core" }
    build::add_sources{ &b, exe, dir = "../../record" }
    build::add_sources{ &b, exe, dir = "../../test" }
    build::add_sources{ &b, exe, dir = "../support" }
}
