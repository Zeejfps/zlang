// Stage 6's test: the flow solver (ui/core/layout.ctx). `check_solver` is called from main.ctx.
//
// The scenes at the top are pinned by the goldens `flow-*.txt`, in the form placed.ctx describes.
// Every number in those goldens was worked out by hand from the rules at the top of layout.ctx
// before the solver ran; the comment on each scene says how. The test font is 8 wide a character
// and 16 high. Below the scenes are checks of single rules, of trees the solver must survive, and
// of rules that hold for any tree, tried on trees made from a seed.

const CLEAR: ui::Color = ui::Color{ a = 0, .. }

// ---- helpers

// The same padding on every side.
fn pad_by { all: f32 } -> ui::Insets {
    return ui::Insets{ left = all, top = all, right = all, bottom = all }
}

fn grow_within { min: f32, max: f32 } -> ui::Size {
    return ui::Size{ kind = ui::SizeKind::grow, min, max, .. }
}

fn take_within { part: f32, min: f32, max: f32 } -> ui::Size {
    return ui::Size{ kind = ui::SizeKind::part, value = part, min, max, .. }
}

// An empty box in the flow, filled with `color` (CLEAR draws nothing).
fn add_cell { mut ui: ui::Ui, width: ui::Size, height: ui::Size, color: ui::Color } {
    let el = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width, height, fill = color, .. } }
    ui::end{ &ui, scope = el }
}

// A filled box in the flow, sized by `width`, that holds one unseen cell of `content` by 20: a
// grow child with something in it.
fn add_holder { mut ui: ui::Ui, width: ui::Size, content: f32, color: ui::Color } {
    let el = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width, fill = color, .. } }
    add_cell{ &ui, width = ui::fix{ size = content }, height = ui::fix{ size = 20.0 }, color = CLEAR }
    ui::end{ &ui, scope = el }
}

// Opens `box` out of the flow with its top left at (`x`, `y`) of the surface.
fn begin_at { mut ui: ui::Ui, x: f32, y: f32, axis: ui::Axis, box: ui::Box } -> ui::Scope {
    let mut placed = box
    placed.place = ui::Place{ x, y, .. }
    return ui::begin_element{ &ui, id = ui::NO_ID, axis, box = placed }
}

// A box of `w` by `h` with padding 10 and gap 10, filled: what most scenes lay their children in.
fn frame_of { w: f32, h: f32 } -> ui::Box {
    return ui::Box{ width = ui::fix{ size = w }, height = ui::fix{ size = h }, padding = pad_by{ all = 10.0 }, gap = 10.0, fill = PANEL, .. }
}

// ---- the scenes

// Five rows of 340 by 40 with padding 10 and gap 10, so each has 320 inside and 20 of gaps, which
// leaves 300 for three children. Their children are 20 high and start at x 30.
//
//   y 20   three GROW: 100 each, at x 30, 140 and 250.
//   y 80   GROW with max 60, GROW, GROW: a first share of 100 each stops the first at 60, and
//          the 40 it left goes to the other two: 60, 120, 120 at x 30, 100 and 230.
//   y 140  GROW with min 150, GROW, GROW: fitted as 150, 0 and 0, which leaves 150 to share, 50
//          each: 200, 50, 50 at x 30, 240 and 300. Shares are of the spare room, not of the row.
//   y 200  a GROW box holding a cell of 40, a GROW, a fixed 60: fitted as 40, 0 and 60, which
//          leaves 200 to share between the two grow children: 140, 100, 60 at x 30, 180 and 290.
//   y 260  a GROW with min 150 holding 200, a GROW holding 200, a fixed 60: 480 with the gaps in
//          320, so 160 is missing. A first 80 from each stops the first at its min of 150 (it gave
//          50) and leaves the second at 120; the 30 still missing comes from the second: 150, 90,
//          60 at x 30, 190 and 290.
fn show_grow { mut ui: ui::Ui } {
    let high = ui::fix{ size = 20.0 }

    let a = begin_at{ &ui, x = 20.0, y = 20.0, axis = ui::Axis::row, box = frame_of{ w = 340.0, h = 40.0 } }
    add_cell{ &ui, width = ui::GROW, height = high, color = ACCENT }
    add_cell{ &ui, width = ui::GROW, height = high, color = CONTROL }
    add_cell{ &ui, width = ui::GROW, height = high, color = EDGE }
    ui::end{ &ui, scope = a }

    let b = begin_at{ &ui, x = 20.0, y = 80.0, axis = ui::Axis::row, box = frame_of{ w = 340.0, h = 40.0 } }
    add_cell{ &ui, width = grow_within{ min = 0.0, max = 60.0 }, height = high, color = ACCENT }
    add_cell{ &ui, width = ui::GROW, height = high, color = CONTROL }
    add_cell{ &ui, width = ui::GROW, height = high, color = EDGE }
    ui::end{ &ui, scope = b }

    let c = begin_at{ &ui, x = 20.0, y = 140.0, axis = ui::Axis::row, box = frame_of{ w = 340.0, h = 40.0 } }
    add_cell{ &ui, width = grow_within{ min = 150.0, max = ui::NO_LIMIT }, height = high, color = ACCENT }
    add_cell{ &ui, width = ui::GROW, height = high, color = CONTROL }
    add_cell{ &ui, width = ui::GROW, height = high, color = EDGE }
    ui::end{ &ui, scope = c }

    let d = begin_at{ &ui, x = 20.0, y = 200.0, axis = ui::Axis::row, box = frame_of{ w = 340.0, h = 40.0 } }
    let holder = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::GROW, fill = CONTROL, .. } }
    add_cell{ &ui, width = ui::fix{ size = 40.0 }, height = high, color = WHITE }
    ui::end{ &ui, scope = holder }
    add_cell{ &ui, width = ui::GROW, height = high, color = EDGE }
    add_cell{ &ui, width = ui::fix{ size = 60.0 }, height = high, color = ACCENT }
    ui::end{ &ui, scope = d }

    let e = begin_at{ &ui, x = 20.0, y = 260.0, axis = ui::Axis::row, box = frame_of{ w = 340.0, h = 40.0 } }
    add_holder{ &ui, width = grow_within{ min = 150.0, max = ui::NO_LIMIT }, content = 200.0, color = ACCENT }
    add_holder{ &ui, width = ui::GROW, content = 200.0, color = CONTROL }
    add_cell{ &ui, width = ui::fix{ size = 60.0 }, height = high, color = EDGE }
    ui::end{ &ui, scope = e }
}

// A row of 100 by 20 at (10, 10) with three children that grow both ways, recorded at scale 1.5:
// the row is 150 by 30 pixels at (15, 15), and 150 pixels among three is 50 each, at x 15, 65 and
// 115, 30 high. (At scale 1 the same row is 100 pixels, which three do not divide: that is the
// first row of `show_remainders`.)
fn show_thirds { mut ui: ui::Ui } {
    let row = begin_at{ &ui, x = 10.0, y = 10.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 100.0 }, height = ui::fix{ size = 20.0 }, fill = PANEL, .. } }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = ACCENT }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = CONTROL }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = EDGE }
    ui::end{ &ui, scope = row }
}

// A row of `w` by `h` at (10, `y`) with no padding and no gap, filled.
fn begin_bare { mut ui: ui::Ui, y: f32, w: f32, h: f32 } -> ui::Scope {
    return begin_at{ &ui, x = 10.0, y, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = w }, height = ui::fix{ size = h }, fill = PANEL, .. } }
}

// Where whole pixels do not divide: the cases that exist only because the layout is integers. At
// scale 1, so a unit is a pixel. Every row is at x 10 and 20 high but the fourth.
//
//   y 10   100 pixels among three GROW: 33 each and 1 left over, which goes to the first:
//          34, 33, 33 at x 10, 44 and 77. They fill the row exactly: 77 + 33 = 110.
//   y 40   101 pixels among a GROW with max 30 and a GROW: a first share of 50 each and 1 over
//          for the first would make it 51; it stops at 30, the second takes its 50, and the 21
//          still left go to the second alone: 30 and 71, at x 10 and 40.
//   y 70   three GROW boxes that each hold 40, in 100: 120 fitted, 20 missing. Each gives 6 and
//          2 are still missing, which the LAST two give: 34, 33, 33 at x 10, 44 and 77, as growing
//          left them at y 10. The first child is never the smaller one.
//   y 100  a row of 101 by 21, centred both ways, with a child of 40 by 10: 61 is spare along it
//          and half of it, rounded down, is 30: x 40. Across, 11 is spare: y 100 + 5 = 105. The odd
//          pixel is left after the child, right and below.
//   y 130  two children of take 0.5 in 101: floor(50.5) = 50 each, at x 10 and 60. The pixel that
//          is left is nobody's: take rounds down and does not share.
//   y 160  100 pixels among seven GROW: 14 each and 2 over for the first two: 15, 15, 14, 14, 14,
//          14, 14, at x 10, 25, 40, 54, 68, 82 and 96.
fn show_remainders { mut ui: ui::Ui } {
    let a = begin_bare{ &ui, y = 10.0, w = 100.0, h = 20.0 }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = ACCENT }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = CONTROL }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = EDGE }
    ui::end{ &ui, scope = a }

    let b = begin_bare{ &ui, y = 40.0, w = 101.0, h = 20.0 }
    add_cell{ &ui, width = grow_within{ min = 0.0, max = 30.0 }, height = ui::GROW, color = ACCENT }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = CONTROL }
    ui::end{ &ui, scope = b }

    let c = begin_bare{ &ui, y = 70.0, w = 100.0, h = 20.0 }
    add_holder{ &ui, width = ui::GROW, content = 40.0, color = ACCENT }
    add_holder{ &ui, width = ui::GROW, content = 40.0, color = CONTROL }
    add_holder{ &ui, width = ui::GROW, content = 40.0, color = EDGE }
    ui::end{ &ui, scope = c }

    let mut centred = ui::Box{ width = ui::fix{ size = 101.0 }, height = ui::fix{ size = 21.0 }, fill = PANEL, .. }
    centred.align_x = ui::Align::center
    centred.align_y = ui::Align::center
    let d = begin_at{ &ui, x = 10.0, y = 100.0, axis = ui::Axis::row, box = centred }
    add_cell{ &ui, width = ui::fix{ size = 40.0 }, height = ui::fix{ size = 10.0 }, color = ACCENT }
    ui::end{ &ui, scope = d }

    let e = begin_bare{ &ui, y = 130.0, w = 101.0, h = 20.0 }
    add_cell{ &ui, width = ui::take{ part = 0.5 }, height = ui::GROW, color = ACCENT }
    add_cell{ &ui, width = ui::take{ part = 0.5 }, height = ui::GROW, color = CONTROL }
    ui::end{ &ui, scope = e }

    let f = begin_bare{ &ui, y = 160.0, w = 100.0, h = 20.0 }
    for k in 0..7 { add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = if k % 2 == 0 { ACCENT } else { CONTROL } } }
    ui::end{ &ui, scope = f }
}

// `take`, a fraction of the parent's inner size less its gaps along the axis.
//
//   y 20   a row of 340 (320 inside, two gaps of 10: 300 to take from): a fixed 50, take 0.5 =
//          150, take 0.25 = 75, at x 30, 90 and 250.
//   y 80   a column of 200 by 120 (180 by 100 inside, one gap of 10): a child of take 0.5 by 20
//          is 90 wide, since across the axis no gap is taken off; a child of take 1 by take 0.5 is
//          180 by 45 (half of 100 - 10), at y 120.
//   y 220  a row of 320 with no gap (300 inside): three of take 0.5 are 150 each, at x 30, 180 and
//          330. Nothing shrinks: the third runs past the row, whose size stays.
//   y 280  the same row: take 0.1 with min 60 is 60, take 0.9 with max 100 is 100, and a GROW
//          gets the 140 that is left, at x 30, 90 and 190.
//   y 340  a FIT row with padding 10 and gap 10 around 100, take 0.5 and 60: the take child
//          counts as nothing while the row is fitted, so the row is 100 + 60 + 20 of gaps + 20 of
//          padding = 200 wide and 40 high. It then takes half of 180 - 20 = 80, and the children
//          run past the row: x 30, 140 and 230.
//   y 400  a box of 200 by 100 with padding 10 and two placed children: a GROW by 10 fills the
//          whole width, 200, padding included; one of take 0.5 both ways at offset (0, 50) is
//          100 by 50.
fn show_take { mut ui: ui::Ui } {
    let high = ui::fix{ size = 20.0 }

    let a = begin_at{ &ui, x = 20.0, y = 20.0, axis = ui::Axis::row, box = frame_of{ w = 340.0, h = 40.0 } }
    add_cell{ &ui, width = ui::fix{ size = 50.0 }, height = high, color = ACCENT }
    add_cell{ &ui, width = ui::take{ part = 0.5 }, height = high, color = CONTROL }
    add_cell{ &ui, width = ui::take{ part = 0.25 }, height = high, color = EDGE }
    ui::end{ &ui, scope = a }

    let b = begin_at{ &ui, x = 20.0, y = 80.0, axis = ui::Axis::column, box = frame_of{ w = 200.0, h = 120.0 } }
    add_cell{ &ui, width = ui::take{ part = 0.5 }, height = high, color = ACCENT }
    add_cell{ &ui, width = ui::take{ part = 1.0 }, height = ui::take{ part = 0.5 }, color = CONTROL }
    ui::end{ &ui, scope = b }

    let mut tight = frame_of{ w = 320.0, h = 40.0 }
    tight.gap = 0.0
    let c = begin_at{ &ui, x = 20.0, y = 220.0, axis = ui::Axis::row, box = tight }
    add_cell{ &ui, width = ui::take{ part = 0.5 }, height = high, color = ACCENT }
    add_cell{ &ui, width = ui::take{ part = 0.5 }, height = high, color = CONTROL }
    add_cell{ &ui, width = ui::take{ part = 0.5 }, height = high, color = EDGE }
    ui::end{ &ui, scope = c }

    let d = begin_at{ &ui, x = 20.0, y = 280.0, axis = ui::Axis::row, box = tight }
    add_cell{ &ui, width = take_within{ part = 0.1, min = 60.0, max = ui::NO_LIMIT }, height = high, color = ACCENT }
    add_cell{ &ui, width = take_within{ part = 0.9, min = 0.0, max = 100.0 }, height = high, color = CONTROL }
    add_cell{ &ui, width = ui::GROW, height = high, color = EDGE }
    ui::end{ &ui, scope = d }

    let e = begin_at{ &ui, x = 20.0, y = 340.0, axis = ui::Axis::row, box = ui::Box{ padding = pad_by{ all = 10.0 }, gap = 10.0, fill = PANEL, .. } }
    add_cell{ &ui, width = ui::fix{ size = 100.0 }, height = high, color = ACCENT }
    add_cell{ &ui, width = ui::take{ part = 0.5 }, height = high, color = CONTROL }
    add_cell{ &ui, width = ui::fix{ size = 60.0 }, height = high, color = EDGE }
    ui::end{ &ui, scope = e }

    let f = begin_at{ &ui, x = 20.0, y = 400.0, axis = ui::Axis::column, box = frame_of{ w = 200.0, h = 100.0 } }
    let over = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::GROW, height = ui::fix{ size = 10.0 }, fill = ACCENT, place = ui::Place{ .. }, .. } }
    ui::end{ &ui, scope = over }
    let half = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::take{ part = 0.5 }, height = ui::take{ part = 0.5 }, fill = CONTROL, place = ui::Place{ y = 50.0, .. }, .. } }
    ui::end{ &ui, scope = half }
    ui::end{ &ui, scope = f }
}

// A box of 300 by `h` with padding 10 and gap 10 at (`x`, `y`), its children aligned by `align`
// on both axes.
fn begin_aligned { mut ui: ui::Ui, x: f32, y: f32, h: f32, axis: ui::Axis, align: ui::Align } -> ui::Scope {
    let mut box = frame_of{ w = 300.0, h }
    box.align_x = align
    box.align_y = align
    return begin_at{ &ui, x, y, axis, box }
}

// Alignment. Each box is 300 wide with padding 10 and gap 10, so 280 inside; the first four are
// 100 high (80 inside) and hold a child of 40 by 20 and one of 60 by 40.
//
//   (20, 20)    a row, centred: the children take 40 + 10 + 60 = 110, 170 is spare, half of it
//               is 85: x 115 and 165. Across: y 30 + (80 - 20) / 2 = 60 and 30 + (80 - 40) / 2 = 50.
//   (340, 20)   a row, at the end: x 350 + 170 = 520 and 570; y 30 + 60 = 90 and 30 + 40 = 70.
//   (20, 140)   a column, centred: the children take 20 + 10 + 40 = 70, 10 is spare: y 155 and
//               185. Across: x 30 + (280 - 40) / 2 = 150 and 30 + (280 - 60) / 2 = 140.
//   (340, 140)  a column, at the end: y 150 + 10 = 160 and 190; x 350 + 240 = 590 and 350 + 220 = 570.
//   (20, 260)   a centred row 60 high (40 inside) with a child of 40 by 20 and one that grows
//               both ways: it takes the 230 that is spare and all 40 across, so nothing is left to
//               align it by: x 80, y 270. The fixed child is centred across: y 270 + 10 = 280.
//   (340, 260)  a column whose children go to the end across it, with a child that grows across
//               up to a max of 100: it is 100 wide and sits at the end, x 350 + 180 = 530.
fn show_align { mut ui: ui::Ui } {
    let small_w = ui::fix{ size = 40.0 }
    let small_h = ui::fix{ size = 20.0 }
    let large_w = ui::fix{ size = 60.0 }
    let large_h = ui::fix{ size = 40.0 }

    let a = begin_aligned{ &ui, x = 20.0, y = 20.0, h = 100.0, axis = ui::Axis::row, align = ui::Align::center }
    add_cell{ &ui, width = small_w, height = small_h, color = ACCENT }
    add_cell{ &ui, width = large_w, height = large_h, color = CONTROL }
    ui::end{ &ui, scope = a }

    let b = begin_aligned{ &ui, x = 340.0, y = 20.0, h = 100.0, axis = ui::Axis::row, align = ui::Align::end }
    add_cell{ &ui, width = small_w, height = small_h, color = ACCENT }
    add_cell{ &ui, width = large_w, height = large_h, color = CONTROL }
    ui::end{ &ui, scope = b }

    let c = begin_aligned{ &ui, x = 20.0, y = 140.0, h = 100.0, axis = ui::Axis::column, align = ui::Align::center }
    add_cell{ &ui, width = small_w, height = small_h, color = ACCENT }
    add_cell{ &ui, width = large_w, height = large_h, color = CONTROL }
    ui::end{ &ui, scope = c }

    let d = begin_aligned{ &ui, x = 340.0, y = 140.0, h = 100.0, axis = ui::Axis::column, align = ui::Align::end }
    add_cell{ &ui, width = small_w, height = small_h, color = ACCENT }
    add_cell{ &ui, width = large_w, height = large_h, color = CONTROL }
    ui::end{ &ui, scope = d }

    let e = begin_aligned{ &ui, x = 20.0, y = 260.0, h = 60.0, axis = ui::Axis::row, align = ui::Align::center }
    add_cell{ &ui, width = small_w, height = small_h, color = ACCENT }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = CONTROL }
    ui::end{ &ui, scope = e }

    let mut ended = frame_of{ w = 300.0, h = 60.0 }
    ended.align_x = ui::Align::end
    let f = begin_at{ &ui, x = 340.0, y = 260.0, axis = ui::Axis::column, box = ended }
    add_cell{ &ui, width = grow_within{ min = 0.0, max = 100.0 }, height = small_h, color = ACCENT }
    ui::end{ &ui, scope = f }
}

// Wrapped text. A wrapped text with no width of its own grows: it fills a column, and in a row it
// takes what the row has left.
//
//   (20, 20)    a FIT column with gap 4 holding a panel and a cell of 50 by 10. The panel is FIT
//               with max 216 and padding 8. Its text is 43 characters, 344 wide on one line, so
//               the panel wants 360 and is held at 216, 200 inside. The text fills that and
//               breaks after "jumps" (25 characters, exactly 200); "over the lazy dog" is the
//               second line. Two lines are 32 high, so the panel is 48 high, and the cell under
//               it is at y 20 + 48 + 4 = 72: the heights are fitted after the text is wrapped.
//   (300, 20)   a row of 320 (FIT high, padding 10, gap 10: 300 inside) with a cell of 100 by 20
//               and a GROW column with padding 5 and gap 5 that holds a text and a cell of 30 by
//               10. The text is 27 characters, 216 on one line, so the column is fitted as 226
//               and the row is 36 short; the column gives that up: 190 wide, 180 inside. At 180
//               the text breaks after "four" (18 characters, 144; "five" would end at 184). The
//               column is 5 + 32 + 5 + 10 + 5 = 57 high and the row 77. The text is at (425, 35),
//               the cell under it at y 35 + 32 + 5 = 72.
//   (20, 120)   a text of fixed width 120 with padding 4 (112 inside), lines at the end. The
//               newline ends "alpha beta" (80 wide, x 24 + 32 = 56); "gamma delta" is 88 (x 48)
//               and "epsilon" 56 (x 80), since "gamma delta epsilon" is 152. Three lines and the
//               padding: 56 high.
//   (300, 120)  a row of 300 with gap 10 holding a text of 17 characters (136) and a cell of 200:
//               346 in 300, so the text gives up 46 and is 90 wide. "aa bb cc dd" is 88; "ee ff"
//               is the second line. The cell is at x 300 + 90 + 10 = 400.
fn show_text { mut ui: ui::Ui } {
    let wrapped = ui::TextStyle{ wrap = true, .. }

    let outer = begin_at{ &ui, x = 20.0, y = 20.0, axis = ui::Axis::column, box = ui::Box{ gap = 4.0, .. } }
    let panel = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ width = ui::Size{ max = 216.0, .. }, padding = pad_by{ all = 8.0 }, fill = PANEL, .. } }
    ui::add_text{ &ui, text = "The quick brown fox jumps over the lazy dog", style = wrapped, box = ui::Box{ .. } }
    ui::end{ &ui, scope = panel }
    add_cell{ &ui, width = ui::fix{ size = 50.0 }, height = ui::fix{ size = 10.0 }, color = ACCENT }
    ui::end{ &ui, scope = outer }

    let row = begin_at{ &ui, x = 300.0, y = 20.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 320.0 }, padding = pad_by{ all = 10.0 }, gap = 10.0, fill = PANEL, .. } }
    add_cell{ &ui, width = ui::fix{ size = 100.0 }, height = ui::fix{ size = 20.0 }, color = ACCENT }
    let column = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ width = ui::GROW, padding = pad_by{ all = 5.0 }, gap = 5.0, fill = CONTROL, .. } }
    ui::add_text{ &ui, text = "one two three four five six", style = wrapped, box = ui::Box{ .. } }
    add_cell{ &ui, width = ui::fix{ size = 30.0 }, height = ui::fix{ size = 10.0 }, color = WHITE }
    ui::end{ &ui, scope = column }
    ui::end{ &ui, scope = row }

    ui::add_text{ &ui, text = "alpha beta\ngamma delta epsilon", style = ui::TextStyle{ wrap = true, align = ui::Align::end, .. },
        box = ui::Box{ width = ui::fix{ size = 120.0 }, padding = pad_by{ all = 4.0 }, fill = TRACK, place = ui::Place{ x = 20.0, y = 120.0, .. }, .. } }

    let beside = begin_at{ &ui, x = 300.0, y = 120.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 300.0 }, gap = 10.0, .. } }
    ui::add_text{ &ui, text = "aa bb cc dd ee ff", style = wrapped, box = ui::Box{ .. } }
    add_cell{ &ui, width = ui::fix{ size = 200.0 }, height = ui::fix{ size = 20.0 }, color = ACCENT }
    ui::end{ &ui, scope = beside }
}

// A row with gap 4 at (20, `y`), `w` wide, holding `text` and a cell of 30 by 16.
fn show_label_row { mut ui: ui::Ui, y: f32, w: f32, text: []u8, overflow: ui::Overflow } {
    let row = begin_at{ &ui, x = 20.0, y, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = w }, gap = 4.0, fill = PANEL, .. } }
    ui::add_text{ &ui, text, style = ui::TextStyle{ overflow, .. }, box = ui::Box{ .. } }
    add_cell{ &ui, width = ui::fix{ size = 30.0 }, height = ui::fix{ size = 16.0 }, color = ACCENT }
    ui::end{ &ui, scope = row }
}

// A text of fixed width `w` at (20, `y`) that is cut for its dots when it does not fit.
fn show_cut_text { mut ui: ui::Ui, y: f32, w: f32, text: []u8, align: ui::Align } {
    ui::add_text{ &ui, text, style = ui::TextStyle{ overflow = ui::Overflow::ellipsis, align, .. },
        box = ui::Box{ width = ui::fix{ size = w }, fill = TRACK, place = ui::Place{ x = 20.0, y, .. }, .. } }
}

// One line that does not fit. A text marked `Overflow::ellipsis` with no width of its own gives
// room up when its parent is short and never grows past its own width. "..." is 24 wide.
//
//   y 20   a row of 100 with gap 4: "A long label here" (17 characters, 136) and a cell of 30.
//          170 in 100, so the text gives up 70 and is 66 wide. 66 - 24 leaves 42 for the text:
//          "A lon" (40) fits, "A long" (48) does not. The cell is at x 20 + 66 + 4 = 90.
//   y 50   the same in a row of 200: there is room, the text keeps its 136 and takes none of
//          the 30 that is spare. The cell is at x 160.
//   y 80   a column of 80 with padding 4 (72 inside): "Hello world" is 88, held at 72 across
//          the column. 72 - 24 leaves 48: "Hello " fits and its trailing space is dropped.
//   y 120  a fixed width of 60, lines at the end: "Settings" is 64. 60 - 24 leaves 36: "Sett"
//          (32). With its dots it is 56 wide and ends at the right edge: x 20 + 4 = 24.
//   y 150  the row of y 20 with a text that is not marked: it keeps its width, and the cell
//          after it is at x 20 + 136 + 4 = 160, past the row.
//   y 180  a fixed width of 20: not even the dots fit, so nothing is drawn.
//   y 210  a fixed width of 40, exactly "Hello": drawn whole.
fn show_ellipsis { mut ui: ui::Ui } {
    show_label_row{ &ui, y = 20.0, w = 100.0, text = "A long label here", overflow = ui::Overflow::ellipsis }
    show_label_row{ &ui, y = 50.0, w = 200.0, text = "A long label here", overflow = ui::Overflow::ellipsis }

    let column = begin_at{ &ui, x = 20.0, y = 80.0, axis = ui::Axis::column, box = ui::Box{ width = ui::fix{ size = 80.0 }, padding = pad_by{ all = 4.0 }, fill = PANEL, .. } }
    ui::add_text{ &ui, text = "Hello world", style = ui::TextStyle{ overflow = ui::Overflow::ellipsis, .. }, box = ui::Box{ .. } }
    ui::end{ &ui, scope = column }

    show_cut_text{ &ui, y = 120.0, w = 60.0, text = "Settings", align = ui::Align::end }
    show_label_row{ &ui, y = 150.0, w = 100.0, text = "A long label here", overflow = ui::Overflow::clip }
    show_cut_text{ &ui, y = 180.0, w = 20.0, text = "Hello", align = ui::Align::start }
    show_cut_text{ &ui, y = 210.0, w = 40.0, text = "Hello", align = ui::Align::start }
}

// Children that do not fit. Spare room is never negative, so whatever the alignment they start at
// the padding edge and run past the far one, and the parent keeps its size.
//
//   (20, 20)    a row of 200 by 40 (padding 10, gap 10: 180 by 20 inside), children at the end
//               on both axes: three fixed children of 100 take 320. They start at x 30, 140 and
//               250. The second is 30 high in 20, so across the axis it starts at the top too.
//   (20, 100)   a centred column of 100 by 60 (padding 10, gap 5: 80 by 40 inside): children of
//               120 by 30, 40 by 30 and 40 by 30 take 100 in 40: y 110, 145 and 180. The first
//               is wider than the column and starts at x 30; the others are centred at x 50.
//   (300, 20)   a centred row of no size with gap 5: its two children of 20 by 20 start at its
//               corner, x 300 and 325. The row itself draws nothing.
//   (300, 100)  a clipping row of 200 by 40: a fixed 150, a GROW with min 40 that holds 100, a
//               fixed 100. 350 in 200: the grow child gives up 60 and stops at its min, and
//               nothing else shrinks: x 300, 450 and 490, the last cut by the row's clip.
fn show_overflow { mut ui: ui::Ui } {
    let mut ended = frame_of{ w = 200.0, h = 40.0 }
    ended.align_x = ui::Align::end
    ended.align_y = ui::Align::end
    let a = begin_at{ &ui, x = 20.0, y = 20.0, axis = ui::Axis::row, box = ended }
    add_cell{ &ui, width = ui::fix{ size = 100.0 }, height = ui::fix{ size = 20.0 }, color = ACCENT }
    add_cell{ &ui, width = ui::fix{ size = 100.0 }, height = ui::fix{ size = 30.0 }, color = CONTROL }
    add_cell{ &ui, width = ui::fix{ size = 100.0 }, height = ui::fix{ size = 20.0 }, color = EDGE }
    ui::end{ &ui, scope = a }

    let mut centred = frame_of{ w = 100.0, h = 60.0 }
    centred.gap = 5.0
    centred.align_x = ui::Align::center
    centred.align_y = ui::Align::center
    let b = begin_at{ &ui, x = 20.0, y = 100.0, axis = ui::Axis::column, box = centred }
    add_cell{ &ui, width = ui::fix{ size = 120.0 }, height = ui::fix{ size = 30.0 }, color = ACCENT }
    add_cell{ &ui, width = ui::fix{ size = 40.0 }, height = ui::fix{ size = 30.0 }, color = CONTROL }
    add_cell{ &ui, width = ui::fix{ size = 40.0 }, height = ui::fix{ size = 30.0 }, color = EDGE }
    ui::end{ &ui, scope = b }

    let none = ui::Box{ width = ui::fix{ size = 0.0 }, height = ui::fix{ size = 0.0 }, gap = 5.0, align_x = ui::Align::center, align_y = ui::Align::center, fill = PANEL, .. }
    let c = begin_at{ &ui, x = 300.0, y = 20.0, axis = ui::Axis::row, box = none }
    add_cell{ &ui, width = ui::fix{ size = 20.0 }, height = ui::fix{ size = 20.0 }, color = ACCENT }
    add_cell{ &ui, width = ui::fix{ size = 20.0 }, height = ui::fix{ size = 20.0 }, color = CONTROL }
    ui::end{ &ui, scope = c }

    let d = begin_at{ &ui, x = 300.0, y = 100.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 200.0 }, height = ui::fix{ size = 40.0 }, clip = true, fill = PANEL, .. } }
    add_cell{ &ui, width = ui::fix{ size = 150.0 }, height = ui::fix{ size = 20.0 }, color = ACCENT }
    add_holder{ &ui, width = grow_within{ min = 40.0, max = ui::NO_LIMIT }, content = 100.0, color = CONTROL }
    add_cell{ &ui, width = ui::fix{ size = 100.0 }, height = ui::fix{ size = 20.0 }, color = EDGE }
    ui::end{ &ui, scope = d }
}

// What takes no room in a parent: placed children and paints.
//
//   (20, 20)   a FIT column with padding 10 and gap 5 holding 80 by 20, a placed child of 300 by
//              200 at offset (100, 0), and 60 by 20. It is fitted to the two in the flow: 80 + 20
//              = 100 wide, 20 + 5 + 20 + 20 = 65 high, with one gap, not two. The placed child is
//              at (120, 20) and the second flow child at y 30 + 20 + 5 = 55.
//   (20, 300)  a row of 300 by 40 with gap 10: a GROW, a placed child of 50 by 50 at the bottom
//              right corner (anchor 1, 1, offset -50, -50: (270, 290)), a GROW. The two grow
//              children share 300 - 10: 145 each, at x 20 and 175.
//   (20, 360)  a FIT row holding a paint of 200 by 5 and a child of 40 by 20: it is 40 by 20.
fn show_placed { mut ui: ui::Ui } {
    let a = begin_at{ &ui, x = 20.0, y = 20.0, axis = ui::Axis::column, box = ui::Box{ padding = pad_by{ all = 10.0 }, gap = 5.0, fill = PANEL, .. } }
    add_cell{ &ui, width = ui::fix{ size = 80.0 }, height = ui::fix{ size = 20.0 }, color = ACCENT }
    let floating = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = place_filled{ x = 100.0, y = 0.0, w = 300.0, h = 200.0, color = EDGE } }
    ui::end{ &ui, scope = floating }
    add_cell{ &ui, width = ui::fix{ size = 60.0 }, height = ui::fix{ size = 20.0 }, color = CONTROL }
    ui::end{ &ui, scope = a }

    let b = begin_at{ &ui, x = 20.0, y = 300.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 300.0 }, height = ui::fix{ size = 40.0 }, gap = 10.0, fill = PANEL, .. } }
    add_cell{ &ui, width = ui::GROW, height = ui::fix{ size = 20.0 }, color = ACCENT }
    let corner = ui::Box{ width = ui::fix{ size = 50.0 }, height = ui::fix{ size = 50.0 }, fill = EDGE, place = ui::Place{ anchor_x = 1.0, anchor_y = 1.0, x = -50.0, y = -50.0 }, .. }
    let pinned = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = corner }
    ui::end{ &ui, scope = pinned }
    add_cell{ &ui, width = ui::GROW, height = ui::fix{ size = 20.0 }, color = CONTROL }
    ui::end{ &ui, scope = b }

    let c = begin_at{ &ui, x = 20.0, y = 360.0, axis = ui::Axis::row, box = ui::Box{ fill = PANEL, .. } }
    ui::paint_rect{ &ui, rect = scale_rect{ ui, x = 0.0, y = 0.0, w = 200.0, h = 5.0 }, style = fill_with{ color = WHITE } }
    add_cell{ &ui, width = ui::fix{ size = 40.0 }, height = ui::fix{ size = 20.0 }, color = ACCENT }
    ui::end{ &ui, scope = c }
}

// Rows inside a column, growing at both levels: the shape of a window with a title bar, a body
// of two panes and a status line.
//
// The column is 400 by 300 at (20, 20) with padding 10 and gap 10: 380 by 280 inside. Its three
// children grow across it, so each is 380 wide at x 30.
//   the header  30 high at y 30, a row with gap 5: a fixed 60, a GROW and a fixed 60, all growing
//               across to 30 high. The GROW gets 380 - 120 - 10 = 250: x 30, 95 and 350.
//   the body    grows along the column. Before sharing it is fitted to its content, 65 high, so
//               the column's children take 30 + 65 + 20 + 20 of gaps = 135 and 145 is spare: the
//               body is 210 high at y 70. It is a row with padding 5 and gap 5, 370 by 200 inside
//               from (35, 75): a pane 100 wide and a pane that takes the other 265 at x 140, both
//               200 high. The second pane is a column with padding 5 and gap 5, 255 by 190 inside
//               from (145, 80): a child 40 high, and one that takes the 190 - 40 - 5 = 145 left,
//               at y 125. Both grow across to 255.
//   the footer  20 high at y 70 + 210 + 10 = 290.
fn show_nested { mut ui: ui::Ui } {
    let window = begin_at{ &ui, x = 20.0, y = 20.0, axis = ui::Axis::column, box = frame_of{ w = 400.0, h = 300.0 } }

    let header = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::GROW, height = ui::fix{ size = 30.0 }, gap = 5.0, fill = CONTROL, .. } }
    add_cell{ &ui, width = ui::fix{ size = 60.0 }, height = ui::GROW, color = ACCENT }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = EDGE }
    add_cell{ &ui, width = ui::fix{ size = 60.0 }, height = ui::GROW, color = ACCENT }
    ui::end{ &ui, scope = header }

    let body = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::GROW, height = ui::GROW, padding = pad_by{ all = 5.0 }, gap = 5.0, fill = TRACK, .. } }
    add_cell{ &ui, width = ui::fix{ size = 100.0 }, height = ui::GROW, color = CONTROL }
    let pane = ui::begin_element{ &ui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ width = ui::GROW, height = ui::GROW, padding = pad_by{ all = 5.0 }, gap = 5.0, fill = EDGE, .. } }
    add_cell{ &ui, width = ui::GROW, height = ui::fix{ size = 40.0 }, color = ACCENT }
    add_cell{ &ui, width = ui::GROW, height = ui::GROW, color = WHITE }
    ui::end{ &ui, scope = pane }
    ui::end{ &ui, scope = body }

    add_cell{ &ui, width = ui::GROW, height = ui::fix{ size = 20.0 }, color = CONTROL }
    ui::end{ &ui, scope = window }
}

// ---- the checks

fn check_solver { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, update: bool } {
    check_flow_goldens{ &io, &fs, &t, &heap, update }
    check_flow_repeat{ &io, &t, &heap }
    check_flow_rules{ &io, &t, &heap }
    check_flow_text{ &io, &t, &heap }
    check_flow_limits{ &io, &t, &heap }
    check_flow_random{ &io, &t, &heap }
}

// One frame of `show` at `scale`, written to the sink under `title`.
fn record_scene { mut io: Io, mut t: ui_test::Tally, mut sink: ui_rec::Sink, mut ui: ui::Ui, scale: f32, title: []u8, show: fn{ mut ui: ui::Ui } } {
    start_frame{ &ui, scale }
    show{ &ui }
    ui::end_frame{ &ui }
    ui_test::expect{ &io, &t, ok = is_clean{ ui }, what = "a flow scene's frame is clean" }
    if not is_clean{ ui } { _ = @fmt(&io, "  the scene: {}\n", title) }
    write_frame{ &sink, ui, name = title } iferr { return }
}

// A scene of one frame against the golden `name`.
fn check_scene { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut sink: ui_rec::Sink, mut ui: ui::Ui, scratch: []mut u8, update: bool,
                 name: []u8, title: []u8, show: fn{ mut ui: ui::Ui } } {
    ui_rec::reset_sink{ &sink }
    record_scene{ &io, &t, &sink, &ui, scale = 1.0, title, show }
    ui_test::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name, actual = ui_rec::get_text{ sink }, scratch, update }
}

fn check_flow_goldens { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, update: bool } {
    let out = alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 65536 } iferr { return }
    let scratch = alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 65536 } iferr { return }
    let mut sink = ui_rec::make_sink{ bytes = out }
    let mut gui = make_ui{ &heap, cap = get_small{} } iferr { return }

    record_scene{ &io, &t, &sink, ui = &gui, scale = 1.0, show = show_grow,
        title = "grow: an equal split, a max with the rest shared again, a min above the share, content first, shrinking" }
    record_scene{ &io, &t, &sink, ui = &gui, scale = 1.5, show = show_thirds, title = "three grow children share 100 at scale 1.5" }
    ui_test::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name = "flow-grow", actual = ui_rec::get_text{ sink }, scratch, update }

    check_scene{ &io, &fs, &t, &sink, ui = &gui, scratch, update, name = "flow-pixels", show = show_remainders,
        title = "whole pixels: 100 among three, 101 with a cap, shrinking by 20 among three, an odd spare centred, take rounds down, 100 among seven" }

    check_scene{ &io, &fs, &t, &sink, ui = &gui, scratch, update, name = "flow-take", show = show_take,
        title = "take: beside fix, across the axis, past the whole, with min and max, in a fit parent, placed" }
    check_scene{ &io, &fs, &t, &sink, ui = &gui, scratch, update, name = "flow-align", show = show_align,
        title = "alignment: centre and end on both axes, in a row and in a column; grow leaves nothing to align" }
    check_scene{ &io, &fs, &t, &sink, ui = &gui, scratch, update, name = "flow-text", show = show_text,
        title = "wrapped text: in a fit panel, in a grow column, with a newline in a fixed width, beside a fixed sibling" }
    check_scene{ &io, &fs, &t, &sink, ui = &gui, scratch, update, name = "flow-ellipsis", show = show_ellipsis,
        title = "ellipsis: a short row, a row with room, a narrow column, a fixed width, clip, no room for the dots, an exact fit" }
    check_scene{ &io, &fs, &t, &sink, ui = &gui, scratch, update, name = "flow-overflow", show = show_overflow,
        title = "overflow starts at the start edge whatever the alignment, and leaves the parent's size alone" }
    check_scene{ &io, &fs, &t, &sink, ui = &gui, scratch, update, name = "flow-placed", show = show_placed,
        title = "placed children and paints take no room: a fit parent keeps its size, grow siblings share as if alone" }
    check_scene{ &io, &fs, &t, &sink, ui = &gui, scratch, update, name = "flow-nested", show = show_nested,
        title = "rows inside a column with grow at both levels" }
    ui_test::expect{ &io, &t, ok = sink.lost == 0, what = "the flow dumps fit their buffer" }
}

// The frame every repeat check records: grow at two levels, wrapped text and text with dots.
fn show_everything { mut ui: ui::Ui } {
    show_nested{ &ui }
    show_text{ &ui }
    show_ellipsis{ &ui }
}

// The same tree twice gives byte-identical dumps: two frames on in one Ui, and in a Ui made afresh.
fn check_flow_repeat { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena } {
    let first_out = alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 32768 } iferr { return }
    let again_out = alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 32768 } iferr { return }
    let mut first = ui_rec::make_sink{ bytes = first_out }
    let mut again = ui_rec::make_sink{ bytes = again_out }
    let mut gui = make_ui{ &heap, cap = get_small{} } iferr { return }

    record_scene{ &io, &t, sink = &first, ui = &gui, scale = 1.5, title = "frame", show = show_everything }
    record_scene{ &io, &t, sink = &again, ui = &gui, scale = 1.0, title = "between", show = show_grow }
    ui_rec::reset_sink{ sink = &again }
    record_scene{ &io, &t, sink = &again, ui = &gui, scale = 1.5, title = "frame", show = show_everything }
    ui_test::expect{ &io, &t, ok = first.len > 2000 and slice::eq_bytes{ a = ui_rec::get_text{ sink = first }, b = ui_rec::get_text{ sink = again } },
        what = "the same flow tree two frames on gives a byte-identical dump" }

    let mut fresh = make_ui{ &heap, cap = get_small{} } iferr { return }
    ui_rec::reset_sink{ sink = &again }
    record_scene{ &io, &t, sink = &again, ui = &fresh, scale = 1.5, title = "frame", show = show_everything }
    ui_test::expect{ &io, &t, ok = first.lost == 0 and slice::eq_bytes{ a = ui_rec::get_text{ sink = first }, b = ui_rec::get_text{ sink = again } },
        what = "the same flow tree in another Ui gives a byte-identical dump" }
}

// The solved rectangle of element `at`, as the layout left it: whole pixels, which is what emit draws.
fn get_solved { ui: ui::Ui, at: usize } -> ui::Rect {
    if at >= @as(usize, ui.tree.count) { return ui::Rect{ x = -1, y = -1, w = -1, h = -1 } }
    let e = ui.tree.elements[at]
    return ui::Rect{ x = e.x, y = e.y, w = e.w, h = e.h }
}

fn has_solved { ui: ui::Ui, at: usize, x: i32, y: i32, w: i32, h: i32 } -> bool {
    return is_same_rect{ r = get_solved{ ui, at }, x, y, w, h }
}

// ---- single rules, read from the tree. Element 0 is the surface; the rest are numbered as recorded.

fn check_flow_rules { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena } {
    let mut gui = make_ui{ &heap, cap = get_small{} } iferr { return }
    let high = ui::fix{ size = 20.0 }

    // What a box's content comes to, which is what a scroll region measures its range by: a
    // column of 100 by 50 with padding 4 and gap 5 holding three children of 80 by 30 has content
    // of 80 by 30 * 3 + 2 * 5 = 100, and a scroll offset of 20 moves the children up by it.
    start_frame{ ui = &gui, scale = 1.0 }
    let region = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::column, box = ui::Box{ width = ui::fix{ size = 100.0 }, height = ui::fix{ size = 50.0 }, padding = pad_by{ all = 4.0 }, gap = 5.0, .. } }
    gui.tree.elements[1].scroll_y = 20
    add_cell{ ui = &gui, width = ui::fix{ size = 80.0 }, height = ui::fix{ size = 30.0 }, color = ACCENT }
    add_cell{ ui = &gui, width = ui::fix{ size = 80.0 }, height = ui::fix{ size = 30.0 }, color = ACCENT }
    add_cell{ ui = &gui, width = ui::fix{ size = 80.0 }, height = ui::fix{ size = 30.0 }, color = ACCENT }
    ui::end{ ui = &gui, scope = region }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = is_clean{ ui = gui } and gui.tree.elements[1].content_w == 80 and gui.tree.elements[1].content_h == 100,
        what = "a box's content is what its flow children take: the largest across its axis, their sum and gaps along it" }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 1, x = 0, y = 0, w = 100, h = 50 } and has_solved{ ui = gui, at = 2, x = 4, y = -16, w = 80, h = 30 } and
        has_solved{ ui = gui, at = 4, x = 4, y = 54, w = 80, h = 30 }, what = "children that overflow keep their sizes and are moved by the scroll offset" }

    // The content is of the final sizes: a grow child fitted to 200 and shrunk to 60 counts as 60.
    start_frame{ ui = &gui, scale = 1.0 }
    let short = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 100.0 }, .. } }
    add_holder{ ui = &gui, width = ui::GROW, content = 200.0, color = ACCENT }
    add_cell{ ui = &gui, width = ui::fix{ size = 40.0 }, height = high, color = ACCENT }
    ui::end{ ui = &gui, scope = short }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[2].w == 60 and gui.tree.elements[1].content_w == 100 and gui.tree.elements[2].content_w == 200,
        what = "a box's content counts a shrunk child at the size it ended with" }

    // What a scroll region is built on: a column of 200 by 100 with a header and a footer of 20
    // and between them a region that grows both ways and holds ten rows of 30. The region is
    // fitted to its 300 of content, the column is 240 short, and the region alone gives that up:
    // it is 60 high, its rows keep their height and run past it, and its content is still 300.
    start_frame{ ui = &gui, scale = 1.0 }
    let window = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::column, box = ui::Box{ width = ui::fix{ size = 200.0 }, height = ui::fix{ size = 100.0 }, .. } }
    add_cell{ ui = &gui, width = ui::GROW, height = high, color = ACCENT }
    let rows = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ width = ui::GROW, height = ui::GROW, clip = true, .. } }
    for k in 0..10 { add_cell{ ui = &gui, width = ui::GROW, height = ui::fix{ size = 30.0 }, color = if k % 2 == 0 { CONTROL } else { EDGE } } }
    ui::end{ ui = &gui, scope = rows }
    add_cell{ ui = &gui, width = ui::GROW, height = high, color = ACCENT }
    ui::end{ ui = &gui, scope = window }
    ui::end_frame{ ui = &gui }
    // Elements: 1 the column, 2 the header, 3 the region, 4 to 13 its rows, 14 the footer.
    ui_test::expect{ &io, &t, ok = is_clean{ ui = gui } and has_solved{ ui = gui, at = 3, x = 0, y = 20, w = 200, h = 60 } and has_solved{ ui = gui, at = 14, x = 0, y = 80, w = 200, h = 20 },
        what = "a grow region between a header and a footer gets the room they leave, whatever it holds" }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[3].content_h == 300 and gui.tree.elements[3].content_w == 200 and
        has_solved{ ui = gui, at = 13, x = 0, y = 290, w = 200, h = 30 }, what = "its content keeps its size, runs past it and is measured whole" }

    // A FIT parent has no spare room. Along its axis a grow child keeps the size it was fitted
    // to; across it a grow child fills the parent, which is as large as the largest sibling.
    start_frame{ ui = &gui, scale = 1.0 }
    let fitted = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::row, box = ui::Box{ .. } }
    add_holder{ ui = &gui, width = ui::GROW, content = 30.0, color = ACCENT }
    add_cell{ ui = &gui, width = ui::fix{ size = 50.0 }, height = ui::fix{ size = 40.0 }, color = ACCENT }
    add_cell{ ui = &gui, width = ui::fix{ size = 10.0 }, height = ui::GROW, color = ACCENT }
    ui::end{ ui = &gui, scope = fitted }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 1, x = 0, y = 0, w = 90, h = 40 }, what = "a fit row is as wide as its children and as high as the highest" }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 2, x = 0, y = 0, w = 30, h = 20 }, what = "a grow child along a fit parent's axis keeps its fitted size" }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 5, x = 80, y = 0, w = 10, h = 40 }, what = "a grow child across a fit parent's axis fills it: as high as the highest sibling" }

    // min wins over max, and a child held by its min takes no share.
    start_frame{ ui = &gui, scale = 1.0 }
    let limits = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 300.0 }, .. } }
    add_cell{ ui = &gui, width = grow_within{ min = 80.0, max = 40.0 }, height = high, color = ACCENT }
    add_cell{ ui = &gui, width = ui::GROW, height = high, color = ACCENT }
    add_cell{ ui = &gui, width = ui::Size{ min = 30.0, max = 10.0, .. }, height = high, color = ACCENT }
    add_cell{ ui = &gui, width = take_within{ part = 0.5, min = 20.0, max = 5.0 }, height = high, color = ACCENT }
    ui::end{ ui = &gui, scope = limits }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[2].w == 80 and gui.tree.elements[4].w == 30 and gui.tree.elements[5].w == 20,
        what = "a min larger than the max wins, for grow, fit and take" }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[3].w == 170 and gui.tree.elements[5].x == 280, what = "and the grow child beside them takes all that is left" }

    // A root stands in the surface as a placed child stands in its parent: GROW fills it, take
    // is a fraction of it. Its own children are laid out in it as in any element.
    start_frame{ ui = &gui, scale = 1.0 }
    let layer = ui::tree::open_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::GROW, height = ui::take{ part = 0.5 }, padding = pad_by{ all = 10.0 }, .. },
        root = ui::tree::RootOpts{ order = ui::tree::BASE_ORDER + 1, .. }, on_end = null }
    add_cell{ ui = &gui, width = ui::GROW, height = ui::GROW, color = ACCENT }
    ui::end{ ui = &gui, scope = layer }
    let tip = ui::tree::open_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ padding = pad_by{ all = 3.0 }, place = ui::Place{ anchor_x = 1.0, x = -100.0, y = 40.0, .. }, .. },
        root = ui::tree::RootOpts{ order = ui::tree::BASE_ORDER + 2, .. }, on_end = null }
    add_cell{ ui = &gui, width = ui::fix{ size = 50.0 }, height = high, color = ACCENT }
    ui::end{ ui = &gui, scope = tip }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = is_clean{ ui = gui } and has_solved{ ui = gui, at = 1, x = 0, y = 0, w = 800, h = 300 }, what = "a root that grows fills the surface, and one that takes a part takes it of the surface" }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 2, x = 10, y = 10, w = 780, h = 280 }, what = "a root's children are laid out inside it" }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 3, x = 700, y = 40, w = 56, h = 26 }, what = "a fit root is sized by its content and stands at its anchor" }

    // Many grow children, each with its own max: child k stops at 3 * k * k, the room is 20000,
    // and all of it is given out, to the pixel. The first 14 stop at their caps, which add up to
    // 3045, and the other 26 share the 16955 that are left: 652 each and 3 over for the first
    // three of them, children 15, 16 and 17.
    let mut big = get_small{}
    big.cmds = 1024
    let mut many = make_ui{ &heap, cap = big } iferr { return }
    start_frame{ ui = &many, scale = 1.0 }
    let wide = begin_at{ ui = &many, x = 0.0, y = 0.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 20000.0 }, .. } }
    for k in 1..41 {
        let stop = 3.0 * @as(f32, k * k)
        add_cell{ ui = &many, width = grow_within{ min = 0.0, max = stop }, height = high, color = ACCENT }
    }
    ui::end{ ui = &many, scope = wide }
    ui::end_frame{ ui = &many }
    let mut total: i32 = 0
    let mut past = false
    for k in 1..41 {
        let w = many.tree.elements[@as(usize, k) + 1].w
        total = total + w
        if w > 3 * k * k { past = true }
    }
    ui_test::expect{ &io, &t, ok = not past and total == 20000, what = "forty grow children with forty different caps share all the room, to the pixel, and none passes its cap" }
    ui_test::expect{ &io, &t, ok = many.tree.elements[2].w == 3 and many.tree.elements[13].w == 432 and many.tree.elements[15].w == 588, what = "the children with small caps stop at them" }
    ui_test::expect{ &io, &t, ok = many.tree.elements[16].w == 653 and many.tree.elements[18].w == 653 and many.tree.elements[19].w == 652 and many.tree.elements[41].w == 652,
        what = "the children that did not stop all grew by the same amount, the pixels left over going to the first of them" }

    // The integer rules, one at a time, read from the tree (the golden flow-pixels pins the same
    // as shapes). 100 among three; 101 with a cap; shrinking 20 among three; an odd spare
    // centred; take rounds down.
    start_frame{ ui = &gui, scale = 1.0 }
    show_remainders{ ui = &gui }
    ui::end_frame{ ui = &gui }
    // Elements: 1 the first row and 2 to 4 its children; 5 the second row, 6 and 7; 8 the third
    // row, its holders 9, 11 and 13 (each with a cell inside); 15 the fourth row and 16 its
    // child; 17 the fifth row, 18 and 19.
    ui_test::expect{ &io, &t, ok = is_clean{ ui = gui } and gui.tree.elements[2].w == 34 and gui.tree.elements[3].w == 33 and gui.tree.elements[4].w == 33,
        what = "100 pixels among three grow children are 34, 33 and 33" }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[4].x + gui.tree.elements[4].w == gui.tree.elements[1].x + gui.tree.elements[1].w, what = "and they fill the row exactly" }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[6].w == 30 and gui.tree.elements[7].w == 71, what = "101 pixels among a grow child capped at 30 and another are 30 and 71" }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[9].w == 34 and gui.tree.elements[11].w == 33 and gui.tree.elements[13].w == 33,
        what = "three grow children of 40 in 100 pixels give up 6, 7 and 7: the last ones give the odd pixels" }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 16, x = 40, y = 105, w = 40, h = 10 }, what = "an odd spare is centred rounded down: 61 puts 30 before, 11 puts 5 above" }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[18].w == 50 and gui.tree.elements[19].w == 50 and gui.tree.elements[19].x == 60, what = "take 0.5 of 101 pixels is 50: a fraction rounds down" }
}

// ---- text between the width pass and the height pass

fn check_flow_text { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena } {
    let mut gui = make_ui{ &heap, cap = get_small{} } iferr { return }
    let wrapped = ui::TextStyle{ wrap = true, .. }

    // The same wrapped text in a grow column beside a fixed cell, in rows of two widths: the
    // column's width comes from sharing, the text is wrapped at it, and the heights follow.
    // 23 characters are 184 wide. In a row of 300 the column gets 300 - 100 = 200: one line. In a
    // row of 196 it gets 96, 12 characters a line: "aaa bbb ccc" and "ddd eee fff", two lines.
    start_frame{ ui = &gui, scale = 1.0 }
    let roomy = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 300.0 }, .. } }
    add_cell{ ui = &gui, width = ui::fix{ size = 100.0 }, height = ui::fix{ size = 10.0 }, color = ACCENT }
    let one = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ width = ui::GROW, .. } }
    ui::add_text{ ui = &gui, text = "aaa bbb ccc ddd eee fff", style = wrapped, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = one }
    ui::end{ ui = &gui, scope = roomy }
    let tight = begin_at{ ui = &gui, x = 0.0, y = 100.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 196.0 }, .. } }
    add_cell{ ui = &gui, width = ui::fix{ size = 100.0 }, height = ui::fix{ size = 10.0 }, color = ACCENT }
    let two = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::column, box = ui::Box{ width = ui::GROW, .. } }
    ui::add_text{ ui = &gui, text = "aaa bbb ccc ddd eee fff", style = wrapped, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = two }
    ui::end{ ui = &gui, scope = tight }
    ui::end_frame{ ui = &gui }
    // Elements: 1 the first row, 2 its cell, 3 its column, 4 its text; 5 to 8 the second row's.
    ui_test::expect{ &io, &t, ok = is_clean{ ui = gui } and has_solved{ ui = gui, at = 4, x = 100, y = 0, w = 200, h = 16 } and gui.tree.elements[4].line_count == 1,
        what = "wrapped text in a grow column with room is one line" }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 8, x = 100, y = 100, w = 96, h = 32 } and gui.tree.elements[8].line_count == 2,
        what = "the same text in a column that sharing left narrower is wrapped at that width" }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[1].h == 16 and gui.tree.elements[7].h == 32 and gui.tree.elements[5].h == 32,
        what = "and the column and the row are as high as the wrapped lines" }
    let lines = gui.layout.lines
    ui_test::expect{ &io, &t, ok = gui.layout.line_count == 3 and gui.tree.elements[8].first_line == 1 and lines[1].start == 0 and lines[1].end == 11 and lines[2].start == 12 and lines[2].end == 23 and
        lines[1].width == 88, what = "its lines are byte ranges of its own text, after the lines of the texts before it" }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[8].content_h == 32 and gui.tree.elements[8].content_w == 184,
        what = "a text's content is as high as its lines and as wide as its one line was measured" }

    // Wrapped text that holds a newline asks for its longest paragraph, not for all of it on one
    // line: "ab\ncdefgh" is 48 wide in a fit box, and two lines high.
    start_frame{ ui = &gui, scale = 1.0 }
    let around = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::column, box = ui::Box{ .. } }
    ui::add_text{ ui = &gui, text = "ab\ncdefgh", style = wrapped, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = around }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 1, x = 0, y = 0, w = 48, h = 32 } and gui.tree.elements[2].line_count == 2,
        what = "a fit box around wrapped text with a newline is as wide as its longest paragraph" }

    // Text that neither wraps nor has dots keeps its width whatever its parent has, and is one
    // line: 14 characters and a newline, which has no width.
    start_frame{ ui = &gui, scale = 1.0 }
    let narrow = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::column, box = ui::Box{ width = ui::fix{ size = 40.0 }, .. } }
    ui::add_text{ ui = &gui, text = "plain text\nkept", style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = narrow }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = gui, at = 2, x = 0, y = 0, w = 112, h = 16 } and gui.tree.elements[2].line_count == 1 and not gui.tree.elements[2].dots,
        what = "text that does not wrap is one line of its own width" }

    // A status bar: a note that may be cut and counts that must not be, in a row too short for
    // both (200 for 304 and 120). The note is GROW with dots; the counts are plain text, FIT, which
    // never gives room up: they keep all 120 and the note gets the other 80, with dots.
    let note = "Deleted a task. Ctrl+Z brings it back."
    let counts = "8 tasks, 3 done"
    start_frame{ ui = &gui, scale = 1.0 }
    let bar = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 200.0 }, .. } }
    ui::add_text{ ui = &gui, text = note, style = ui::TextStyle{ overflow = ui::Overflow::ellipsis, .. }, box = ui::Box{ width = ui::GROW, .. } }
    ui::add_text{ ui = &gui, text = counts, style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = bar }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = is_clean{ ui = gui } and has_solved{ ui = gui, at = 2, x = 0, y = 0, w = 80, h = 16 } and gui.tree.elements[2].dots
        and has_solved{ ui = gui, at = 3, x = 80, y = 0, w = 120, h = 16 } and not gui.tree.elements[3].dots,
        what = "status bar: plain counts keep their width, and the note that may be cut gives up the room, with dots" }
    // The same counts marked `Overflow::ellipsis` with no width of their own may give room up too
    // (a FIT line with dots is sized GROW, at most its own width): the bar is 224 short, and the
    // two give it up alike, 112 each, so the counts are cut. This is the rule the
    // option's comment and AGENTS.md state: dots mean "may be cut".
    start_frame{ ui = &gui, scale = 1.0 }
    let bar2 = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 200.0 }, .. } }
    ui::add_text{ ui = &gui, text = note, style = ui::TextStyle{ overflow = ui::Overflow::ellipsis, .. }, box = ui::Box{ width = ui::GROW, .. } }
    ui::add_text{ ui = &gui, text = counts, style = ui::TextStyle{ overflow = ui::Overflow::ellipsis, .. }, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = bar2 }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = is_clean{ ui = gui } and has_solved{ ui = gui, at = 2, x = 0, y = 0, w = 192, h = 16 } and has_solved{ ui = gui, at = 3, x = 192, y = 0, w = 8, h = 16 },
        what = "status bar: counts with dots and no width give room up alike with the note: 192 and 8, too narrow even for the dots" }

    // A line table too small: the lines that fit are laid out, the text that lost lines and the
    // text that got none are each counted once, and solving the frame again does not count them twice.
    let mut cap = get_small{}
    cap.lines = 2
    let mut few = make_ui{ &heap, cap } iferr { return }
    start_frame{ ui = &few, scale = 1.0 }
    let column = begin_at{ ui = &few, x = 0.0, y = 0.0, axis = ui::Axis::column, box = ui::Box{ width = ui::fix{ size = 64.0 }, .. } }
    ui::add_text{ ui = &few, text = "aa bb cc dd ee ff gg hh", style = wrapped, box = ui::Box{ .. } }
    ui::add_text{ ui = &few, text = "x y", style = wrapped, box = ui::Box{ .. } }
    ui::add_text{ ui = &few, text = "z", style = ui::TextStyle{ .. }, box = ui::Box{ .. } }
    ui::end{ ui = &few, scope = column }
    ui::end_frame{ ui = &few }
    ui_test::expect{ &io, &t, ok = few.tree.elements[2].line_count == 2 and few.tree.elements[3].line_count == 0 and few.tree.elements[4].line_count == 0 and few.layout.line_count == 2,
        what = "a full line table keeps the lines that fitted and gives the texts after it none" }
    ui_test::expect{ &io, &t, ok = few.stats.dropped == 3 and few.stats.problems == 1 and has_kept{ ui = few, kind = ui::ProblemKind::lines_full }, what = "each text that lost lines is counted once and the full table reported once" }
    ui_test::expect{ &io, &t, ok = few.tree.elements[2].h == 32 and few.tree.elements[3].h == 16 and few.draw.count == 2, what = "what was laid out is drawn, and a text with no lines keeps the height of one" }
    ui::layout::solve{ ui = &few }
    ui::layout::solve{ ui = &few }
    ui_test::expect{ &io, &t, ok = few.stats.dropped == 3 and few.stats.problems == 1 and few.layout.line_count == 2, what = "solving the same frame again counts nothing twice" }
}

// ---- trees the solver must survive

// `depth` boxes inside one another, each with padding 1, around one cell of 10 by 10. With `grow`
// each box grows both ways, so sizes come from the outside in; without, each is fitted, so they
// come from the inside out.
fn show_nest { mut ui: ui::Ui, depth: u32, grow: bool } {
    let size = if grow { ui::GROW } else { ui::FIT }
    let mut outer = ui::Scope{ .. }
    for k in 0..depth {
        let scope = ui::begin_element{ &ui, id = ui::NO_ID, axis = if k % 2 == 0 { ui::Axis::row } else { ui::Axis::column }, box = ui::Box{ width = size, height = size, padding = pad_by{ all = 1.0 }, .. } }
        if k == 0 { outer = scope }
    }
    add_cell{ &ui, width = ui::fix{ size = 10.0 }, height = ui::fix{ size = 10.0 }, color = ACCENT }
    ui::end{ &ui, scope = outer }       // every box opened inside the first too
}

fn check_flow_limits { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena } {
    // The deepest nesting a scope stack of 128 allows: 127 boxes and the cell in the last, each
    // an open scope. Growing, box k (from 1) is 800 - 2 * (k - 1) wide at x k - 1, so the last is
    // 548 by 348 at (126, 126) and the cell inside it is at (127, 127). Fitted, box k is
    // 10 + 2 * (128 - k), so the first is 264 and the last 12.
    let mut cap = get_small{}
    cap.scopes = 128
    let mut deep = make_ui{ &heap, cap } iferr { return }
    start_frame{ ui = &deep, scale = 1.0 }
    show_nest{ ui = &deep, depth = 127, grow = true }
    ui::end_frame{ ui = &deep }
    ui_test::expect{ &io, &t, ok = is_clean{ ui = deep } and deep.stats.elements == 128, what = "127 boxes inside one another are recorded on a scope stack of 128" }
    ui_test::expect{ &io, &t, ok = has_solved{ ui = deep, at = 1, x = 0, y = 0, w = 800, h = 600 } and has_solved{ ui = deep, at = 127, x = 126, y = 126, w = 548, h = 348 } and
        has_solved{ ui = deep, at = 128, x = 127, y = 127, w = 10, h = 10 }, what = "growing sizes reach the innermost of 127 nested boxes" }
    start_frame{ ui = &deep, scale = 1.0 }
    show_nest{ ui = &deep, depth = 127, grow = false }
    ui::end_frame{ ui = &deep }
    ui_test::expect{ &io, &t, ok = is_clean{ ui = deep } and has_solved{ ui = deep, at = 1, x = 0, y = 0, w = 264, h = 264 } and has_solved{ ui = deep, at = 127, x = 126, y = 126, w = 12, h = 12 },
        what = "fitted sizes reach the outermost of 127 nested boxes" }

    // Thousands of elements: a row of 800 pixels holding 4000 grow children, and a column of 600
    // holding 1000 grow rows of two children each: 7002 elements. There are fewer pixels than
    // children, so the share is 0 and the pixels left over, all of them, go one each to the first
    // 800 children and the first 600 rows; the rest have no size and stand at the far edge. Sums
    // of thousands of whole sizes are exact: the last child ends on the row's last pixel.
    let mut gui = make_ui{ &heap, cap = ui::Capacity{ .. } } iferr { return }
    start_frame{ ui = &gui, scale = 1.0 }
    let row = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::row, box = ui::Box{ width = ui::fix{ size = 800.0 }, height = ui::fix{ size = 20.0 }, .. } }
    for k in 0..4000 { add_cell{ ui = &gui, width = ui::GROW, height = ui::GROW, color = if k % 2 == 0 { ACCENT } else { CONTROL } } }
    ui::end{ ui = &gui, scope = row }
    let column = begin_at{ ui = &gui, x = 0.0, y = 0.0, axis = ui::Axis::column, box = ui::Box{ width = ui::fix{ size = 800.0 }, height = ui::fix{ size = 600.0 }, .. } }
    for k in 0..1000 {
        let line = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::GROW, height = ui::GROW, gap = if k % 2 == 0 { 2.0 } else { 0.0 }, .. } }
        add_cell{ ui = &gui, width = ui::fix{ size = 100.0 }, height = ui::GROW, color = CLEAR }
        add_cell{ ui = &gui, width = ui::GROW, height = ui::GROW, color = CLEAR }
        ui::end{ ui = &gui, scope = line }
    }
    ui::end{ ui = &gui, scope = column }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = is_clean{ ui = gui } and gui.stats.elements == 7002, what = "a frame of 7002 elements is solved and emitted with nothing dropped" }
    let last = gui.tree.elements[4001]
    // Children 0 to 799 are elements 2 to 801, a pixel each; child 800, element 802, is the first with none.
    ui_test::expect{ &io, &t, ok = gui.tree.elements[2].w == 1 and has_solved{ ui = gui, at = 801, x = 799, y = 0, w = 1, h = 20 } and has_solved{ ui = gui, at = 802, x = 800, y = 0, w = 0, h = 20 },
        what = "4000 grow children share a row of 800 pixels: the first 800 get one each" }
    ui_test::expect{ &io, &t, ok = last.x + last.w == 800 and last.h == 20, what = "and the last ends exactly at the row's far edge" }
    // The column is element 4002, its first row 4003 with children 4004 and 4005, its last row 7000.
    // Row 599 is element 5800, the last with a pixel; row 600 is element 5803.
    ui_test::expect{ &io, &t, ok = gui.tree.elements[4003].h == 1 and has_solved{ ui = gui, at = 4005, x = 102, y = 0, w = 698, h = 1 } and
        has_solved{ ui = gui, at = 5800, x = 0, y = 599, w = 800, h = 1 } and has_solved{ ui = gui, at = 5803, x = 0, y = 600, w = 800, h = 0 } and
        gui.tree.elements[7000].y + gui.tree.elements[7000].h == 600, what = "1000 grow rows share a column of 600 pixels, each with its own children laid out" }

    // A surface of no size: everything that grows or takes is nothing, and what is fixed stays.
    ui::begin_frame{ ui = &gui, frame = ui::FrameInfo{ width = 0, height = 0, scale = 1.0, dt = 0.0 } }
    let lost = ui::begin_element{ ui = &gui, id = ui::NO_ID, axis = ui::Axis::row, box = ui::Box{ width = ui::GROW, height = ui::take{ part = 0.5 }, padding = pad_by{ all = 10.0 }, gap = 4.0, .. } }
    add_cell{ ui = &gui, width = ui::GROW, height = ui::GROW, color = ACCENT }
    add_cell{ ui = &gui, width = ui::take{ part = 0.5 }, height = ui::fix{ size = 7.0 }, color = ACCENT }
    ui::add_text{ ui = &gui, text = "no room at all", style = ui::TextStyle{ wrap = true, .. }, box = ui::Box{ .. } }
    ui::add_text{ ui = &gui, text = "no room at all", style = ui::TextStyle{ overflow = ui::Overflow::ellipsis, .. }, box = ui::Box{ .. } }
    ui::end{ ui = &gui, scope = lost }
    ui::end_frame{ ui = &gui }
    ui_test::expect{ &io, &t, ok = is_clean{ ui = gui } and has_solved{ ui = gui, at = 1, x = 0, y = 0, w = 0, h = 0 } and has_solved{ ui = gui, at = 2, x = 10, y = 10, w = 0, h = 0 } and
        has_solved{ ui = gui, at = 3, x = 14, y = 10, w = 0, h = 7 }, what = "on a surface of no size what grows or takes is nothing, without a problem" }
    // The wrapped text has no width, so every line is one character: the 11 that are not the
    // spaces the lines break at.
    ui_test::expect{ &io, &t, ok = gui.tree.elements[4].w == 0 and gui.tree.elements[4].line_count == 11 and gui.tree.elements[4].h == 176,
        what = "wrapped text with no width is a character a line, and still ends" }
    ui_test::expect{ &io, &t, ok = gui.tree.elements[5].w == 0 and gui.tree.elements[5].line_count == 1 and gui.layout.lines[@as(usize, gui.tree.elements[5].first_line)].end == 0,
        what = "a line with dots and no width keeps nothing of its text" }
}

// ---- trees made from a seed

struct Rng { state: u64 }

// A number from 0 to `below` - 1.
fn roll { mut rng: Rng, below: u32 } -> u32 {
    rng.state = rng.state *% 6364136223846793005 +% 1442695040888963407
    return @as(u32, (rng.state >> 33) % @as(u64, below))
}

// Numbers that are not sizes, for the trees that try to break the solver.
struct Odd { nan: f32, inf: f32 }

fn roll_odd { mut rng: Rng, odd: Odd } -> f32 {
    let pick = roll{ &rng, below = 8 }
    if pick == 0 { return odd.nan }
    if pick == 1 { return odd.inf }
    if pick == 2 { return 0.0 - odd.inf }
    if pick == 3 { return 3.0e38 }
    if pick == 4 { return -3.0e38 }
    if pick == 5 { return -7.0 }
    if pick == 6 { return 0.0 }
    return 1.0e-30
}

// A number from 0 to `below` - 1, or with `odd` one time in three something that is not a size.
fn roll_f32 { mut rng: Rng, below: u32, odd: ?Odd } -> f32 {
    if let o = odd {
        if roll{ &rng, below = 3 } == 0 { return roll_odd{ &rng, odd = o } }
    }
    return @as(f32, roll{ &rng, below })
}

fn roll_size { mut rng: Rng, odd: ?Odd } -> ui::Size {
    let kind = roll{ &rng, below = 10 }
    let mut size = ui::FIT
    if kind < 3 {
        size = ui::GROW
    } else if kind < 6 {
        size = ui::fix{ size = roll_f32{ &rng, below = 120, odd } }
    } else if kind < 8 {
        // A part from 0 to 1 in eighths; the odd trees also ask for more than the whole.
        size = ui::take{ part = roll_f32{ &rng, below = 9, odd } / 8.0 }
    }
    if roll{ &rng, below = 4 } == 0 { size.min = roll_f32{ &rng, below = 60, odd } }
    if roll{ &rng, below = 4 } == 0 { size.max = roll_f32{ &rng, below = 150, odd } }
    return size
}

fn roll_align { mut rng: Rng } -> ui::Align {
    let pick = roll{ &rng, below = 3 }
    return if pick == 0 { ui::Align::start } else if pick == 1 { ui::Align::center } else { ui::Align::end }
}

fn roll_box { mut rng: Rng, odd: ?Odd } -> ui::Box {
    let width = roll_size{ &rng, odd }
    let height = roll_size{ &rng, odd }
    let mut box = ui::Box{ width, height, fill = ACCENT, .. }
    if roll{ &rng, below = 2 } == 0 {
        let left = roll_f32{ &rng, below = 10, odd }
        let top = roll_f32{ &rng, below = 10, odd }
        let right = roll_f32{ &rng, below = 10, odd }
        let bottom = roll_f32{ &rng, below = 10, odd }
        box.padding = ui::Insets{ left, top, right, bottom }
    }
    if roll{ &rng, below = 2 } == 0 { box.gap = roll_f32{ &rng, below = 8, odd } }
    box.align_x = roll_align{ &rng }
    box.align_y = roll_align{ &rng }
    return box
}

const WORDS: []u8 = "alpha beta gamma\ndelta epsilon zeta eta theta iota kappa-lambda mu"

// One element and, for a box, everything in it: a text one time in five, otherwise a box of up to
// four children, placed one time in six. Boxes stop nesting at depth 5.
fn add_random { mut ui: ui::Ui, mut rng: Rng, depth: u32, odd: ?Odd } {
    let kind = roll{ &rng, below = 30 }
    if kind < 6 {
        let len = @as(usize, roll{ &rng, below = @as(u32, WORDS.len) + 1 })
        let style = ui::TextStyle{ wrap = kind < 3, overflow = if kind % 2 == 0 { ui::Overflow::ellipsis } else { ui::Overflow::clip }, align = roll_align{ &rng }, .. }
        let box = roll_box{ &rng, odd }
        ui::add_text{ &ui, text = WORDS[..len], style, box }
        return
    }
    let mut box = roll_box{ &rng, odd }
    if kind < 11 {
        let anchor_x = @as(f32, roll{ &rng, below = 5 }) / 4.0
        let anchor_y = @as(f32, roll{ &rng, below = 5 }) / 4.0
        let x = roll_f32{ &rng, below = 100, odd } - 50.0
        let y = roll_f32{ &rng, below = 100, odd } - 50.0
        box.place = ui::Place{ anchor_x, anchor_y, x, y }
    }
    let axis = if roll{ &rng, below = 2 } == 0 { ui::Axis::row } else { ui::Axis::column }
    let el = ui::begin_element{ &ui, id = ui::NO_ID, axis, box }
    if depth < 5 {
        let children = roll{ &rng, below = 5 }
        for k in 0..children { add_random{ &ui, &rng, depth = depth + 1, odd } }
    }
    ui::end{ &ui, scope = el }
}

// The frame of one seed: up to three trees in the surface.
fn show_random { mut ui: ui::Ui, seed: u32, odd: ?Odd } {
    let mut rng = Rng{ state = @as(u64, seed) *% 2654435761 +% 977 }
    let trees = 1 + roll{ &rng, below = 3 }
    for k in 0..trees { add_random{ &ui, &rng, depth = 0, odd } }
}

// What a solve left in an element.
struct Shot { x: i32 = 0, y: i32 = 0, w: i32 = 0, h: i32 = 0, content_w: i32 = 0, content_h: i32 = 0, first_line: u32 = 0, line_count: u32 = 0, dots: bool = false }

fn take_shots { ui: ui::Ui, shots: []mut Shot } {
    for i in 0..@as(usize, ui.tree.count) {
        if i >= shots.len { break }
        let e = ui.tree.elements[i]
        shots[i] = Shot{ x = e.x, y = e.y, w = e.w, h = e.h, content_w = e.content_w, content_h = e.content_h, first_line = e.first_line, line_count = e.line_count, dots = e.dots }
    }
}

// How many elements differ from their shots. With `sizes` only the sizes and the lines are
// compared: what a tree of numbers that are not sizes still has to keep.
fn count_changed { ui: ui::Ui, shots: []Shot, sizes: bool } -> u32 {
    let mut n: u32 = 0
    for i in 0..@as(usize, ui.tree.count) {
        if i >= shots.len { break }
        let e = ui.tree.elements[i]
        if e.kind == ui::tree::Kind::paint { continue }
        let s = shots[i]
        let mut same = e.w == s.w and e.h == s.h and e.first_line == s.first_line and e.line_count == s.line_count and e.dots == s.dots
        if not sizes { same = same and e.x == s.x and e.y == s.y and e.content_w == s.content_w and e.content_h == s.content_h }
        if not same { n = n + 1 }
    }
    return n
}

// What the rules found broken in the trees, by rule.
struct Faults {
    sizes: u32 = 0, limits: u32 = 0, across: u32 = 0, along: u32 = 0, shared: u32 = 0, filled: u32 = 0,
    placed: u32 = 0, content: u32 = 0, lines: u32 = 0,
}

// Counts a broken rule and says where the first few were.
fn note_fault { mut io: Io, mut count: u32, seed: u32, at: usize, what: []u8 } {
    count = count + 1
    if count <= 3 { _ = @fmt(&io, "  seed {} element {}: {}\n", seed, at, what) }
}

// The rules below are checked in whole pixels and exactly: the layout is integer arithmetic, so
// there is no tolerance to allow. They are worked out here from the tree's own lengths (already
// pixels, as tree.ctx converted them), not by calling the solver's steps.

// `v` held by the limits of `size`: between its `min` and `max`, `min` winning, never negative.
fn hold_within { size: ui::tree::Extent, v: i64 } -> i32 {
    let top = if size.max < size.min { size.min } else { size.max }
    let mut held = v
    if held > @as(i64, top) { held = @as(i64, top) }
    if held < @as(i64, size.min) { held = @as(i64, size.min) }
    if held < 0 { held = 0 }
    return ui::hold_pixels{ v = held }
}

// Whether `v` is a size `size` allows: its value when fixed, otherwise between its min and max.
fn is_allowed { size: ui::tree::Extent, v: i32 } -> bool {
    if size.kind == ui::SizeKind::fixed { return v == size.value }
    return v >= size.min and v <= ui::pick_max_i32{ a = size.min, b = size.max }
}

// How much of `spare` pixels lies before content aligned by `align`: none at the start, half of
// it rounded down at the centre, all of it at the end; nothing when no room is spare.
fn lead_of { spare: i64, align: ui::Align } -> i64 {
    if spare <= 0 { return 0 }
    if align == ui::Align::center { return spare / 2 }
    return if align == ui::Align::end { spare } else { 0 }
}

// The rules for one parent's children along one axis: x and widths when `wide`.
fn check_children { mut io: Io, ui: ui::Ui, seed: u32, at: usize, wide: bool, mut faults: Faults } {
    let p = ui.tree.elements[at]
    let main = (p.axis == ui::Axis::row) == wide
    let outer = if wide { p.w } else { p.h }
    let padding: i64 = if wide { @as(i64, p.padding.left) + @as(i64, p.padding.right) } else { @as(i64, p.padding.top) + @as(i64, p.padding.bottom) }
    let inner: i64 = if @as(i64, outer) > padding { @as(i64, outer) - padding } else { 0 }
    let start: i64 = if wide { @as(i64, p.x) + @as(i64, p.padding.left) } else { @as(i64, p.y) + @as(i64, p.padding.top) }
    let origin: i64 = if wide { @as(i64, p.x) } else { @as(i64, p.y) }
    let align = if wide { p.align_x } else { p.align_y }

    // What the flow children take.
    let mut sum: i64 = 0
    let mut gaps: i64 = 0
    let mut largest: i32 = 0
    let mut any = false
    let mut c = p.first_child
    while c != ui::tree::NONE {
        let child = ui.tree.elements[@as(usize, c)]
        c = child.next
        if not ui::layout::is_flow{ e = child } { continue }
        let v = if wide { child.w } else { child.h }
        sum = sum + @as(i64, v)
        if v > largest { largest = v }
        if any { gaps = gaps + @as(i64, p.gap) }
        any = true
    }
    let taken = sum + gaps
    // A box's content is what its flow children take.
    let content = @as(i64, if wide { p.content_w } else { p.content_h })
    let want_content: i64 = if main { (if taken > 0 { taken } else { 0 }) } else { @as(i64, largest) }
    if content != want_content {
        note_fault{ &io, count = &faults.content, seed, at, what = "the content is not what the flow children take" }
    }

    let room: i64 = if main { (if inner > gaps { inner - gaps } else { 0 }) } else { inner }
    let mut cursor = start + lead_of{ spare = inner - taken, align }
    c = p.first_child
    while c != ui::tree::NONE {
        let index = @as(usize, c)
        let child = ui.tree.elements[index]
        c = child.next
        if child.kind == ui::tree::Kind::paint { continue }
        let size = ui::layout::get_size{ e = child, wide }
        let v = if wide { child.w } else { child.h }
        let pos = @as(i64, if wide { child.x } else { child.y })

        if child.placed {
            // At its anchor, the fraction of the parent rounded down; a part of the parent's
            // whole size, rounded down, or all of it when it grows.
            let anchor = if wide { child.anchor_x } else { child.anchor_y }
            let offset = if wide { child.offset_x } else { child.offset_y }
            let want = origin + @as(i64, ui::floor_pixels{ v = @as(f32, outer) * anchor }) + @as(i64, offset)
            let mut ok = pos == want
            if size.kind == ui::SizeKind::part { ok = ok and v == hold_within{ size, v = @as(i64, ui::floor_pixels{ v = @as(f32, outer) * size.part }) } }
            if size.kind == ui::SizeKind::grow { ok = ok and v == hold_within{ size, v = @as(i64, outer) } }
            if not ok { note_fault{ &io, count = &faults.placed, seed, at = index, what = "a placed child is not at its anchor with its part of the parent" } }
            continue
        }

        if size.kind == ui::SizeKind::part and v != hold_within{ size, v = @as(i64, ui::floor_pixels{ v = @as(f32, room) * size.part }) } {
            note_fault{ &io, count = &faults.shared, seed, at = index, what = "a take child is not its part of the parent's room, rounded down" }
        }
        if main {
            // One after another from the aligned start, exactly the gap apart: none overlap.
            if pos != cursor { note_fault{ &io, count = &faults.along, seed, at = index, what = "a child does not follow the one before it by its size and the gap" } }
            cursor = cursor + @as(i64, v) + @as(i64, p.gap)
            // While a single pixel of room is spare every grow child is at its max; while a
            // single pixel is missing, every one is at its min.
            if size.kind == ui::SizeKind::grow {
                if taken < inner and v < size.max { note_fault{ &io, count = &faults.filled, seed, at = index, what = "room is spare and a grow child below its max did not take it" } }
                if taken > inner and v > size.min { note_fault{ &io, count = &faults.filled, seed, at = index, what = "room is short and a grow child above its min did not give it" } }
            }
        } else {
            if size.kind == ui::SizeKind::grow and v != hold_within{ size, v = inner } {
                note_fault{ &io, count = &faults.shared, seed, at = index, what = "a grow child does not fill the parent across its axis" }
            }
            if @as(i64, v) <= inner {
                // Inside the padding box, where the alignment puts it.
                let inside = pos >= start and pos + @as(i64, v) <= start + inner
                if not inside or pos != start + lead_of{ spare = inner - @as(i64, v), align } {
                    note_fault{ &io, count = &faults.across, seed, at = index, what = "a child that fits is not inside the padding box at its alignment" }
                }
            } else {
                // Larger than the padding box: only by a size of its own (fixed, fitted to its
                // content, or its min), and then from the start edge.
                let own = size.kind == ui::SizeKind::fixed or size.kind == ui::SizeKind::fit or v == size.min
                if not own or pos != start {
                    note_fault{ &io, count = &faults.across, seed, at = index, what = "a child overflows across the axis without a size of its own, or not from the start edge" }
                }
            }
        }
    }
}

// The rules for a text element's lines.
fn check_text { mut io: Io, ui: ui::Ui, seed: u32, at: usize, mut faults: Faults } {
    let e = ui.tree.elements[at]
    let padding = @as(i64, e.padding.left) + @as(i64, e.padding.right)
    let inner: i32 = if @as(i64, e.w) > padding { ui::hold_pixels{ v = @as(i64, e.w) - padding } } else { 0 }
    // The test font at this text's pixel size: it is magnified by size / 16, so a character
    // advances 8 times that (a fraction of a pixel, at some sizes) and a line is the size high.
    let mut advance: f32 = 8.0
    if let def = ui::draw::get_font{ list = ui.draw, font = e.font } { advance = 8.0 * ui::get_font_scale{ font = def, size = e.text_size } }
    let wide = ui::ceil_pixels{ v = advance }
    let high = e.text_size
    let first = @as(usize, e.first_line)
    let count = @as(usize, e.line_count)
    let mut ok = count >= 1 and first + count <= @as(usize, ui.layout.line_count) and e.line_height == high
    if ok {
        let lines = ui.layout.lines[first..first + count]
        ok = lines[0].start == 0
        if e.wrap {
            // Every byte is in a line or is the break between two; no line is wider than the
            // text's room, but for a single character that is, and for the spaces a line ends
            // with, which hang past the edge.
            let text = ui::get_text{ ui, span = e.text }
            ok = ok and lines[count - 1].end == e.text.len and text.len == @as(usize, e.text.len)
            for line at k in lines {
                if line.start > line.end or line.end > e.text.len {
                    ok = false
                    break
                }
                let mut spaces: u32 = 0
                let mut end = @as(usize, line.end)
                while end > @as(usize, line.start) and text[end - 1] == ' ' {
                    spaces = spaces + 1
                    end = end - 1
                }
                let hung = ui::ceil_pixels{ v = advance * @as(f32, spaces) }
                if line.width > ui::pick_max_i32{ a = inner, b = wide } + hung { ok = false }
                if k > 0 and line.start < lines[k - 1].end { ok = false }
            }
            if e.height.kind == ui::SizeKind::fit {
                let want = hold_within{ size = e.height, v = @as(i64, high) * @as(i64, e.line_count) + @as(i64, e.padding.top) + @as(i64, e.padding.bottom) }
                ok = ok and e.h == want
            }
        } else {
            ok = ok and count == 1
            if e.dots {
                ok = ok and e.overflow == ui::Overflow::ellipsis and lines[0].end < e.text.len and lines[0].width <= inner
            } else if lines[0].end != e.text.len {
                // Cut to nothing: only when not even the dots fit.
                ok = ok and e.overflow == ui::Overflow::ellipsis and lines[0].end == 0 and inner < ui::ceil_pixels{ v = 3.0 * advance }
            } else {
                // Whole: it was not to be cut, or it is no wider than its room, to the pixel.
                ok = ok and (e.overflow == ui::Overflow::clip or e.content_w <= inner)
            }
        }
    }
    if not ok { note_fault{ &io, count = &faults.lines, seed, at, what = "a text's lines do not cover it, or do not fit its width" } }
}

// Every rule on every element of the solved frame.
fn check_tree { mut io: Io, ui: ui::Ui, seed: u32, mut faults: Faults } {
    for at in 0..@as(usize, ui.tree.count) {
        let e = ui.tree.elements[at]
        if e.kind == ui::tree::Kind::paint { continue }
        let sized = e.w >= 0 and e.w <= ui::MAX_PIXELS and e.h >= 0 and e.h <= ui::MAX_PIXELS
        let placed = e.x >= -ui::MAX_PIXELS and e.x <= ui::MAX_PIXELS and e.y >= -ui::MAX_PIXELS and e.y <= ui::MAX_PIXELS
        if not sized or not placed { note_fault{ &io, count = &faults.sizes, seed, at, what = "a size or a position is out of range" } }
        if not is_allowed{ size = ui::layout::get_size{ e, wide = true }, v = e.w } or not is_allowed{ size = ui::layout::get_size{ e, wide = false }, v = e.h } {
            note_fault{ &io, count = &faults.limits, seed, at, what = "a size is outside its min and max, or is not its fixed value" }
        }
        if e.kind == ui::tree::Kind::text { check_text{ &io, ui, seed, at, &faults } }
        if e.first_child == ui::tree::NONE { continue }
        check_children{ &io, ui, seed, at, wide = true, &faults }
        check_children{ &io, ui, seed, at, wide = false, &faults }
    }
}

// Room for the largest tree a seed can make: 1365 elements a tree, three trees.
fn get_roomy { } -> ui::Capacity {
    return ui::Capacity{
        elements = 4096, text = 262144, cmds = 16384, clips = 8, hits = 16, states = 16, nodes = 16,
        fonts = 4, scopes = 32, layers = 4, lines = 65536, measures = 16, shaped = 16,
    }
}

// The scale seed `seed` is recorded at: the five a display has, in turn.
fn pick_scale { seed: u32 } -> f32 {
    let pick = seed % 5
    return if pick == 0 { 1.0 } else if pick == 1 { 1.25 } else if pick == 2 { 1.5 } else if pick == 3 { 1.75 } else { 2.0 }
}

// Trees made from a seed, with sizes that are numbers: the rules that hold whatever the tree is,
// at whatever scale. A seed's tree is declared in logical units and recorded at one of five
// scales, so its pixels differ from seed to seed, and the rules are about the pixels.
fn check_flow_random { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena } {
    let mut gui = make_ui{ &heap, cap = get_roomy{} } iferr { return }
    let shots = alloc::make(Shot, arena::Arena){ realloc = arena::alloc, &heap, count = 4097 } iferr { return }
    let mut faults = Faults{ .. }
    let mut unclean: u32 = 0
    let mut resolved: u32 = 0
    let mut repeated: u32 = 0
    let mut elements: u32 = 0
    let mut texts: u32 = 0
    let seeds: u32 = 400
    for seed in 0..seeds {
        let scale = pick_scale{ seed }
        start_frame{ ui = &gui, scale }
        show_random{ ui = &gui, seed, odd = null }
        ui::end_frame{ ui = &gui }
        if not is_clean{ ui = gui } { unclean = unclean + 1 }
        elements = elements + gui.stats.elements
        texts = texts + gui.layout.line_count
        check_tree{ &io, ui = gui, seed, &faults }

        // Solving the same tree again, and working out positions again, changes nothing.
        take_shots{ ui = gui, shots }
        let lines = gui.layout.line_count
        ui::layout::solve{ ui = &gui }
        ui::layout::position{ ui = &gui }
        resolved = resolved + count_changed{ ui = gui, shots = shots, sizes = false }
        if gui.layout.line_count != lines { resolved = resolved + 1 }

        // The same seed after another frame gives the same tree and the same solve.
        let count = gui.tree.count
        start_frame{ ui = &gui, scale = 1.0 }
        show_random{ ui = &gui, seed = seed + 7919, odd = null }
        ui::end_frame{ ui = &gui }
        start_frame{ ui = &gui, scale }
        show_random{ ui = &gui, seed, odd = null }
        ui::end_frame{ ui = &gui }
        repeated = repeated + count_changed{ ui = gui, shots = shots, sizes = false }
        if gui.tree.count != count { repeated = repeated + 1 }
    }
    ui_test::expect{ &io, &t, ok = elements > 20000 and texts > 2000, what = "the seeded trees are thousands of elements and lines of text" }
    ui_test::expect{ &io, &t, ok = unclean == 0, what = "every seeded frame is clean" }
    ui_test::expect{ &io, &t, ok = faults.sizes == 0, what = "seeded trees: every size and position is a whole number of pixels in range" }
    ui_test::expect{ &io, &t, ok = faults.limits == 0, what = "seeded trees: every size is its fixed value or between its min and max" }
    ui_test::expect{ &io, &t, ok = faults.across == 0, what = "seeded trees: across the axis a flow child is inside the padding box unless its own size is larger" }
    ui_test::expect{ &io, &t, ok = faults.along == 0, what = "seeded trees: along the axis flow children follow one another exactly the gap apart" }
    ui_test::expect{ &io, &t, ok = faults.shared == 0, what = "seeded trees: take is its part of the room rounded down, and grow fills across the axis" }
    ui_test::expect{ &io, &t, ok = faults.filled == 0, what = "seeded trees: spare room is taken by grow children up to their max, missing room given up down to their min, to the pixel" }
    ui_test::expect{ &io, &t, ok = faults.placed == 0, what = "seeded trees: a placed child is at its anchor and takes its part of the whole parent" }
    ui_test::expect{ &io, &t, ok = faults.content == 0, what = "seeded trees: a box's content is what its flow children take" }
    ui_test::expect{ &io, &t, ok = faults.lines == 0, what = "seeded trees: a text's lines cover it and fit its width" }
    ui_test::expect{ &io, &t, ok = resolved == 0, what = "seeded trees: solving twice gives identical results" }
    ui_test::expect{ &io, &t, ok = repeated == 0, what = "seeded trees: the same tree in a later frame gives identical results" }

    check_odd_trees{ &io, &t, ui = &gui, shots }
}

// Trees made from a seed with numbers that are not sizes in every field: not a number, infinite,
// huge, negative. Nothing panics, nothing is dropped, and every size the solver stores is a size:
// the conversion to pixels made each of them 0 or held it before the solver saw it.
fn check_odd_trees { mut io: Io, mut t: ui_test::Tally, mut ui: ui::Ui, shots: []mut Shot } {
    let zero = ui::abs_f32{ x = 0.0 }
    let odd = Odd{ nan = ui::sqrt_f32{ x = -1.0 }, inf = 1.0 / zero }
    ui_test::expect{ &io, &t, ok = odd.nan != odd.nan and odd.inf > 3.0e38, what = "the odd numbers are what they are meant to be" }
    let mut bad: u32 = 0
    let mut dropped: u32 = 0
    let mut resolved: u32 = 0
    let mut elements: u32 = 0
    let seeds: u32 = 300
    for seed in 0..seeds {
        start_frame{ &ui, scale = pick_scale{ seed } }
        show_random{ &ui, seed, odd }
        ui::end_frame{ &ui }
        if ui.stats.dropped != 0 or ui.stats.unclosed != 0 { dropped = dropped + 1 }
        elements = elements + ui.stats.elements
        for at in 0..@as(usize, ui.tree.count) {
            let e = ui.tree.elements[at]
            if e.kind == ui::tree::Kind::paint { continue }
            let sized = e.w >= 0 and e.w <= ui::MAX_PIXELS and e.h >= 0 and e.h <= ui::MAX_PIXELS
            let content = e.content_w >= 0 and e.content_w <= ui::MAX_PIXELS and e.content_h >= 0 and e.content_h <= ui::MAX_PIXELS
            let placed = e.x >= -ui::MAX_PIXELS and e.x <= ui::MAX_PIXELS and e.y >= -ui::MAX_PIXELS and e.y <= ui::MAX_PIXELS
            if not sized or not content or not placed { bad = bad + 1 }
        }
        take_shots{ ui, shots }
        ui::layout::solve{ &ui }
        resolved = resolved + count_changed{ ui, shots = shots, sizes = false }
    }
    ui_test::expect{ &io, &t, ok = elements > 10000, what = "the odd trees are thousands of elements" }
    ui_test::expect{ &io, &t, ok = dropped == 0, what = "odd trees: numbers that are not sizes drop nothing" }
    ui_test::expect{ &io, &t, ok = bad == 0, what = "odd trees: every size and position the solver stores is a whole number in range" }
    ui_test::expect{ &io, &t, ok = resolved == 0, what = "odd trees: solving twice gives identical sizes and positions" }
}
