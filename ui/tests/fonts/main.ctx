// Stage 4's tests: ui_fonts over FreeType and HarfBuzz, with a real font from the system.
//
//   kotor/tools/ctxc test ui/tests/fonts                          (from anywhere)
//   UI_FONT=PATH UI_CJK_FONT=PATH kotor/tools/ctxc test ui/tests/fonts
//
// UI_FONT is the Latin face (default: the platform's, such as C:/Windows/Fonts/segoeui.ttf) and
// UI_CJK_FONT a face with Chinese or Japanese characters for the fallback (default: the first of
// the platform's that exists). No font file is part of the repository. With no Latin face every
// test is skipped, and with no CJK face the fallback's test is: each has a `skip:` line with the
// reason, and the runner's summary counts it as skipped.
//
// Checks: the start-up check of FreeType's mirrored fields passes, and fails loudly when an offset
// is wrong; 'A' rasterises to ink; "AV" is narrower than 'A' and 'V' apart; a second shaping is a
// cache hit; a line mixing Latin and CJK comes back from two faces; releasing a face frees its
// glyphs in a staged level; caret offsets are monotonic and end at the measured width; wrapped lines
// keep to the width; bad input (bytes that are not a font, bytes that are not UTF-8, a zero size, a
// handle that names nothing, a buffer too small, a full run cache) is answered and counted; `close`
// leaves no FreeType or HarfBuzz object alive. The faces are added from their files
// (`add_face_file`), but in the tests of `add_face` itself: a face from a file is the face from its
// bytes; a missing file, a directory, an empty file, one that is not a font and a path C cannot
// take are refused, each with its error, leaving nothing behind; a file named past ASCII opens, is
// mapped while its face is alive, and is unmapped when it is released or the library closes. The
// files these write go under ui/out.

const EPS: f32 = 0.001

// A test that needs a font file this machine lacks is skipped with the reason, by
// `ui_check::get_latin_font` and `get_cjk_font` (ui/tests/support/font.ctx).

// The Latin face (UI_FONT, else the platform's) added from its file, mapped.
fn add_latin { mut t: Test, mut fs: Fs, mut proc: Proc, mut lib: ui_fonts::Library } -> !ui_fonts::Face {
    let path = ui_check::get_latin_font{ &t, &fs, &proc }
    return try ui_fonts::add_face_file{ &lib, path, index = 0 }
}

// The CJK face (UI_CJK_FONT, else the platform's) added from its file, mapped.
fn add_cjk { mut t: Test, mut fs: Fs, mut proc: Proc, mut lib: ui_fonts::Library } -> !ui_fonts::Face {
    let path = ui_check::get_cjk_font{ &t, &fs, &proc }
    return try ui_fonts::add_face_file{ &lib, path, index = 0 }
}

// The Latin face's bytes, for the tests of add_face itself.
fn read_latin { mut t: Test, mut fs: Fs, mut proc: Proc, mut heap: arena::Arena } -> ![]u8 {
    let path = ui_check::get_latin_font{ &t, &fs, &proc }
    return try fs::read_all{ &fs, &heap, realloc = arena::alloc, path }
}

// A number with up to two digits after the point (std prints 10.0 as 1e+01).
fn write_number { mut io: Io, v: f32 } -> ! {
    let mut text: [48]u8
    let n = ui::format_fixed{ v, digits = 2, trim = true, into = text[..] }
    _ = @fmt(&io, "{}", text[..n])
}

// ---- the tests

// A face loads into a library, and its mirrored FreeType fields pass the start-up check.
#test
fn loads_a_face_past_the_start_up_check { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let version = ui_fonts::get_version{ &lib }
    _ = @fmt(&io, "FreeType {}.{}.{}, HarfBuzz {}\n", version.major, version.minor, version.patch, ui_fonts::hb_version_string{ &fonts })
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let slot = ui_fonts::find_face{ lib, id = face.id } ifnull { return ui_fonts::closed }
    _ = @fmt(&io, "face {}: {} units per em, {} glyphs; the mirrored fields check out\n", face.id, lib.faces[slot].units_per_em, lib.faces[slot].glyph_count)
    // a face loads and its mirrored FreeType fields pass the start-up check
    @expect(&t, face.id != 0)
}

// `close` releases every FreeType and HarfBuzz object of a library that loaded a face and shaped
// with it, as HarfBuzz itself reports.
#test
fn closes_every_freetype_and_harfbuzz_object { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let freed_before = ui_fonts::count_freed{ &fonts }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let mut out: [16]ui::Shaped
    let shaped = shape{ provider, face, pixels = 16, text = "Hello, close", out = out[..] }
    // the library shaped before it is closed
    @expect(&t, shaped.len == 12)
    let blobs = lib.live.hb_blobs
    let freed_open = ui_fonts::count_freed{ &fonts }
    ui_fonts::close{ &lib }
    let freed = ui_fonts::count_freed{ &fonts }
    let live = lib.live
    _ = @fmt(&io, "after close: {} libraries, {} faces, {} sizes, {} blobs, {} hb faces, {} hb fonts, {} buffers alive; HarfBuzz freed {} blobs and {} buffers in all\n",
        live.ft_libraries, live.ft_faces, live.ft_sizes, live.hb_blobs, live.hb_faces, live.hb_fonts, live.hb_buffers,
        freed.blobs - freed_before.blobs, freed.buffers - freed_before.buffers)
    let none = live.ft_libraries == 0 and live.ft_faces == 0 and live.ft_sizes == 0 and live.hb_blobs == 0
        and live.hb_faces == 0 and live.hb_fonts == 0 and live.hb_buffers == 0
    // close releases every FreeType and HarfBuzz object the library made
    @expect(&t, none)
    // HarfBuzz reports each blob (so each face and font over it) and the buffer freed at close
    @expect(&t, freed.blobs - freed_open.blobs == @as(u64, blobs) and freed.buffers - freed_open.buffers == 1)
    let mut after: [8]ui::Shaped
    // a closed library answers nothing
    @expect(&t, ui_fonts::shape_text{ &lib, handle = face.id, pixels = 16, text = "after", out = after[..] } == 0)
}

// The start-up check fails at once, and leaves nothing behind, when a mirrored offset is wrong.
#test
fn fails_add_face_at_once_on_a_wrong_mirrored_offset { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let latin = try read_latin{ &t, &fs, &proc, &heap }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ faces = 2, sizes = 4, runs = 4, run_bytes = 256, run_glyphs = 256, scratch = 64 } }
    lib.layout.face_units_per_em = lib.layout.face_units_per_em + 2
    let wrong_upem = is_bad_layout{ lib = &lib, data = latin }
    lib.layout = ui_fonts::LAYOUT
    lib.layout.size_ascender = lib.layout.size_ascender + 4
    let wrong_size = is_bad_layout{ lib = &lib, data = latin }
    lib.layout = ui_fonts::LAYOUT
    lib.layout.face_num_glyphs = lib.layout.face_num_glyphs + 8
    let wrong_count = is_bad_layout{ lib = &lib, data = latin }
    // a wrong mirrored offset fails add_face with bad_layout
    @expect(&t, wrong_upem and wrong_size and wrong_count)
    // a face that fails the check leaves nothing behind
    @expect(&t, lib.live.ft_faces == 0 and lib.live.hb_blobs == 0 and lib.live.hb_faces == 0 and lib.live.ft_sizes == 0)
    ui_fonts::close{ &lib }
}

fn is_bad_layout { mut lib: ui_fonts::Library, data: []u8 } -> bool {
    let face = ui_fonts::add_face{ &lib, data, index = 0 } iferr err{ error } {
        match error {
            ui_fonts::bad_layout{ field, got, want } => {}
            else => { return false }
        }
        return true
    }
    ui_fonts::release_face{ &lib, face }
    return false
}

// Bytes that are not a font, no bytes, and a face index the file does not have: refused.
#test
fn refuses_bytes_that_are_not_a_font { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let latin = try read_latin{ &t, &fs, &proc, &heap }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ faces = 2, sizes = 4, runs = 4, run_bytes = 256, run_glyphs = 256, scratch = 64 } }
    let junk = is_bad_font{ lib = &lib, data = "this is not a font file, only text that is long enough to look at" }
    let empty = is_bad_font{ lib = &lib, data = "" }
    let truncated = is_bad_font{ lib = &lib, data = latin[..latin.len / 3] }
    let mut index_ok = false
    _ = ui_fonts::add_face{ &lib, data = latin, index = 7 } iferr { index_ok = true }
    // bytes that are not a font are refused with bad_font
    @expect(&t, junk and empty)
    // a face index the file does not have is refused
    @expect(&t, index_ok)
    _ = @fmt(&io, "a third of the font file: {}\n", if truncated { "refused" } else { "opened (FreeType loads tables lazily)" })
    // refused bytes leave nothing behind
    @expect(&t, lib.live.ft_faces == 0 and lib.live.hb_blobs == 0 and lib.live.hb_faces == 0)
    ui_fonts::close{ &lib }
    // close after refused bytes leaves nothing
    @expect(&t, lib.live.ft_faces == 0 and lib.live.hb_blobs == 0)
}

fn is_bad_font { mut lib: ui_fonts::Library, data: []u8 } -> bool {
    let face = ui_fonts::add_face{ &lib, data, index = 0 } iferr err{ error } {
        match error {
            ui_fonts::bad_font{ code } => {}
            else => { return false }
        }
        return true
    }
    ui_fonts::release_face{ &lib, face }
    return false
}

// ---- add_face_file

// The tests below write the files they add under ui/out, which git ignores (`make_out_path`, from
// the test's own file). Each test names its own files, since the tests run at once.

// A face added from its file is the face added from its bytes: the same tables, the same glyphs
// and advances. A face of a collection by its index too, where the CJK face is a collection.
#test
fn adds_a_face_from_a_file_as_from_its_bytes { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let latin = try read_latin{ &t, &fs, &proc, &heap }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let from_bytes = try ui_fonts::add_face{ &lib, data = latin, index = 0 }
    let from_file = try add_latin{ &t, &fs, &proc, &lib }
    let a = ui_fonts::find_face{ lib, id = from_bytes.id }
    let b = ui_fonts::find_face{ lib, id = from_file.id }
    // both faces are alive
    @require(&t, a != null and b != null)
    _ = @fmt(&io, "from bytes: {} units per em, {} glyphs; from the file: {} and {}\n",
        lib.faces[a].units_per_em, lib.faces[a].glyph_count, lib.faces[b].units_per_em, lib.faces[b].glyph_count)
    // the face from the file has the tables of the face from the bytes
    @expect(&t, lib.faces[a].units_per_em == lib.faces[b].units_per_em and lib.faces[a].glyph_count == lib.faces[b].glyph_count)
    let provider = ui_fonts::get_provider{ lib = &lib }
    let text = "Typography: AV Wa To office ffl, 0123 \xC3\xA9t\xC3\xA9"
    let mut one: [64]ui::Shaped
    let mut two: [64]ui::Shaped
    let x = shape{ provider, face = from_bytes, pixels = 20, text, out = one[..] }
    let y = shape{ provider, face = from_file, pixels = 20, text, out = two[..] }
    let mut same = x.len == y.len and x.len > 20
    if same {
        for g at i in x {
            if g.glyph != y[i].glyph or g.cluster != y[i].cluster or g.x_advance != y[i].x_advance or g.x_offset != y[i].x_offset { same = false }
        }
    }
    // the face from the file shapes a line to the glyphs and advances of the face from the bytes
    @expect(&t, same)
    let cjk = ui_check::find_cjk_font{ &fs, &proc }
    let n = cjk.path.len
    if cjk.found and n > 4 and (cjk.path[n - 4..] == ".ttc" or cjk.path[n - 4..] == ".TTC") {
        let first = ui_fonts::add_face_file{ &lib, path = cjk.path, index = 0 } iferr { ui_fonts::Face{ .. } }
        let second = ui_fonts::add_face_file{ &lib, path = cjk.path, index = 1 } iferr { ui_fonts::Face{ .. } }
        _ = @fmt(&io, "faces 0 and 1 of the collection {}: {} and {}\n", cjk.path, first.id != 0, second.id != 0)
        // faces 0 and 1 of a collection are added from its file by their index
        @expect(&t, first.id != 0 and second.id != 0)
    }
    ui_fonts::close{ &lib }
}

// A missing file, a directory, an empty file, a file that is not a font, a face index the file
// lacks, and paths C cannot take: each an error of its own, and nothing left behind.
#test
fn refuses_files_that_are_not_fonts { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let latin_path = ui_check::get_latin_font{ &t, &fs, &proc }
    let mut dir_buf: [1024]u8
    _ = fs::make_dir{ &fs, path = ui_check::make_out_path{ &t, name = "", out = dir_buf[..] } }
    let mut empty_buf: [1024]u8
    let empty = ui_check::make_out_path{ &t, name = "fonts-empty.ttf", out = empty_buf[..] }
    _ = try fs::write_all{ &fs, path = empty, bytes = "" }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ faces = 2, sizes = 4, runs = 4, run_bytes = 256, run_glyphs = 256, scratch = 64 } }
    let live = lib.live
    let freed = ui_fonts::count_freed{ &fonts }
    let mut missing_buf: [1024]u8
    let missing = name_refusal{ &io, &lib, path = ui_check::make_out_path{ &t, name = "fonts-there-is-no-such-file.ttf", out = missing_buf[..] }, index = 0 }
    let directory = name_refusal{ &io, &lib, path = test::dir{ &t }, index = 0 }
    let nothing = name_refusal{ &io, &lib, path = empty, index = 0 }
    let mut text_buf: [1024]u8
    let text = name_refusal{ &io, &lib, path = ui_check::make_path{ &t, relative = "build.ctx", out = text_buf[..] }, index = 0 }
    let index = name_refusal{ &io, &lib, path = latin_path, index = 7 }
    let no_path = name_refusal{ &io, &lib, path = "", index = 0 }
    let mut nul_buf: [1024]u8
    let nul = name_refusal{ &io, &lib, path = ui_check::make_out_path{ &t, name = "a\x00b.ttf", out = nul_buf[..] }, index = 0 }
    let mut long: [4200]u8
    for i in 0..long.len { long[i] = 'a' }
    let too_long = name_refusal{ &io, &lib, path = long[..], index = 0 }
    // a missing file and a directory are no_file
    @expect(&t, missing == Refusal::no_file and directory == Refusal::no_file)
    // an empty file, a file that is not a font and a face index the file lacks are bad_font
    @expect(&t, nothing == Refusal::bad_font and text == Refusal::bad_font and index == Refusal::bad_font)
    // an empty path, one holding a NUL and one too long for C are bad_path
    @expect(&t, no_path == Refusal::bad_path and nul == Refusal::bad_path and too_long == Refusal::bad_path)
    let after = lib.live
    let freed_after = ui_fonts::count_freed{ &fonts }
    _ = @fmt(&io, "after the refusals: {} faces, {} blobs, {} hb faces alive (before: {}, {}, {}); HarfBuzz freed {} blobs\n",
        after.ft_faces, after.hb_blobs, after.hb_faces, live.ft_faces, live.hb_blobs, live.hb_faces, freed_after.blobs - freed.blobs)
    // nothing is left behind: the live counters are where they were
    @expect(&t, after.ft_faces == live.ft_faces and after.hb_blobs == live.hb_blobs and after.hb_faces == live.hb_faces and after.ft_sizes == live.ft_sizes)
    // the files that opened and were refused by FreeType were released (their blobs freed)
    @expect(&t, freed_after.blobs - freed.blobs == 2)
    ui_fonts::close{ &lib }
    _ = fs::remove{ &fs, path = empty }
}

// How add_face_file refused a path.
enum Refusal: u8 { added, no_file, bad_path, bad_font, other }

fn name_refusal { mut io: Io, mut lib: ui_fonts::Library, path: []u8, index: u32 } -> Refusal {
    let face = ui_fonts::add_face_file{ &lib, path, index } iferr err{ error } {
        let kind = match error {
            ui_fonts::no_file{ path } => { Refusal::no_file }
            ui_fonts::bad_path{ path } => { Refusal::bad_path }
            ui_fonts::bad_font{ code } => { Refusal::bad_font }
            else => { Refusal::other }
        }
        if path.len < 256 {
            _ = @fmt(&io, "index {}: {}\n", index, error)
        } else {
            _ = @fmt(&io, "a path of {} bytes, index {}: refused\n", path.len, index)
        }
        return kind
    }
    ui_fonts::release_face{ &lib, face }
    return Refusal::added
}

// A file added with a name past ASCII (UTF-8) opens; while its face is alive the file is mapped
// (on Windows it cannot be written over, though it can be renamed and deleted), and releasing the
// face, or closing the library, unmaps it: HarfBuzz reports the blob freed, and the file can be
// written over, renamed and deleted at once.
#test
fn releases_a_files_mapping_with_its_face { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let latin = try read_latin{ &t, &fs, &proc, &heap }
    let mut dir_buf: [1024]u8
    _ = fs::make_dir{ &fs, path = ui_check::make_out_path{ &t, name = "", out = dir_buf[..] } }
    let mut path_buf: [1024]u8
    let path = ui_check::make_out_path{ &t, name = "fonts-mapped-\xC3\xBC\xE5\xAD\x97.ttf", out = path_buf[..] }            // fonts-mapped-ü字.ttf
    let mut moved_buf: [1024]u8
    let moved = ui_check::make_out_path{ &t, name = "fonts-mapped-moved.ttf", out = moved_buf[..] }
    _ = fs::remove{ &fs, path }
    _ = fs::remove{ &fs, path = moved }
    _ = try fs::write_all{ &fs, path, bytes = latin }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let freed = ui_fonts::count_freed{ &fonts }
    let face = ui_fonts::add_face_file{ &lib, path, index = 0 } iferr err{ error } {
        _ = @fmt(&io, "{}: {}\n", path, error)
        ui_fonts::Face{ .. }
    }
    // a file whose name is past ASCII is added
    @require(&t, face.id != 0)
    let provider = ui_fonts::get_provider{ lib = &lib }
    let mut out: [16]ui::Shaped
    // the mapped face shapes
    @expect(&t, shape{ provider, face, pixels = 16, text = "Mapped", out = out[..] }.len == 6)
    // Writing over a mapped file is what Windows refuses (ERROR_USER_MAPPED_FILE); elsewhere it
    // would change what the face reads, so it is tried on Windows only.
    let windows = match target::OS { windows => { true } macos => { false } linux => { false } }
    if windows {
        // on Windows a file mapped by a face alive cannot be written over
        @expect(&t, not can_write{ &fs, path, bytes = latin })
    }
    let renamed = can_rename{ &fs, from = path, to = moved }
    if renamed { _ = fs::rename{ &fs, from = moved, to = path } }
    _ = @fmt(&io, "while the face is alive the file {} be renamed\n", if renamed { "can" } else { "cannot" })
    ui_fonts::release_face{ &lib, face }
    // releasing the face frees its blob, which unmaps the file
    @expect(&t, ui_fonts::count_freed{ &fonts }.blobs == freed.blobs + 1)
    // once the face is released the file can be written over and renamed
    @expect(&t, can_write{ &fs, path, bytes = latin } and can_rename{ &fs, from = path, to = moved })

    // Closing the library unmaps a file whose face is alive, which may be deleted meanwhile.
    let again = ui_fonts::add_face_file{ &lib, path = moved, index = 0 } iferr err{ error } {
        _ = @fmt(&io, "{}: {}\n", moved, error)
        ui_fonts::Face{ .. }
    }
    // the renamed file is added again
    @expect(&t, again.id != 0 and lib.live.hb_blobs == 1)
    let deleted = can_remove{ &fs, path = moved }
    let mut big: [8]ui::Shaped
    let drawn = shape{ provider, face = again, pixels = 40, text = "Deleted", out = big[..] }
    _ = @fmt(&io, "while the face is alive the file {} be deleted\n", if deleted { "can" } else { "cannot" })
    // the face still shapes, at a new size, after its file's name is deleted
    @expect(&t, drawn.len == 7)
    ui_fonts::close{ &lib }
    // closing the library frees the blob of the face still alive
    @expect(&t, ui_fonts::count_freed{ &fonts }.blobs == freed.blobs + 2 and lib.live.hb_blobs == 0)
    // once the library is closed the file is deleted, or can be, and its name taken again
    @expect(&t, (deleted or can_remove{ &fs, path = moved }) and can_write{ &fs, path = moved, bytes = "x" } and can_remove{ &fs, path = moved })
}

// Whether `bytes` could be written over the file at `path`.
fn can_write { mut fs: Fs, path: []u8, bytes: []u8 } -> bool {
    _ = fs::write_all{ &fs, path, bytes } iferr { return false }
    return true
}

// Whether the file at `from` could be renamed `to`.
fn can_rename { mut fs: Fs, from: []u8, to: []u8 } -> bool {
    fs::rename{ &fs, from, to } iferr { return false }
    return true
}

// Whether the file at `path` could be deleted.
fn can_remove { mut fs: Fs, path: []u8 } -> bool {
    fs::remove{ &fs, path } iferr { return false }
    return true
}

// The glyphs of `text` in `face` at `pixels`, shaped by the provider.
fn shape { provider: ui::TextProvider, face: ui_fonts::Face, pixels: u32, text: []u8, out: []mut ui::Shaped } -> []mut ui::Shaped {
    let n = provider.shape{ state = provider.state, handle = face.id, pixels, text, out }
    return out[..n]
}

fn sum_advances { glyphs: []ui::Shaped } -> f32 {
    let mut total: f32 = 0.0
    for g in glyphs { total = total + g.x_advance }
    return total
}

// 'A' rasterises to ink; a space to nothing; too small a buffer and a face that is not there are refused.
#test
fn rasterises_a_glyph_to_ink_on_the_baseline { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let mut out: [8]ui::Shaped
    let a = shape{ provider, face, pixels = 32, text = "A", out = out[..] }
    // 'A' shapes to one glyph
    @expect(&t, a.len == 1 and a[0].glyph != 0)
    if a.len != 1 { return }
    let mut pixels: [65536]u8
    let mut bitmap = ui::GlyphBitmap{ pixels = pixels[..], width = 0, height = 0, left = 0, top = 0 }
    let ok = provider.rasterize{ state = provider.state, face = a[0].face, glyph = a[0].glyph, out = &bitmap }
    let mut covered: u32 = 0
    for p in pixels[..@as(usize, bitmap.width * bitmap.height)] { if p > 127 { covered = covered + 1 } }
    _ = @fmt(&io, "'A' at 32 px: {}x{}, left {}, top {}, {} covered pixels\n", bitmap.width, bitmap.height, bitmap.left, bitmap.top, covered)
    // 'A' rasterises to a non-empty bitmap
    @expect(&t, ok and bitmap.width > 8 and bitmap.height > 12 and covered > 40)
    // 'A' stands on the baseline, its top above it
    @expect(&t, bitmap.top > 12 and bitmap.top <= 32)

    let mut spaces: [8]ui::Shaped
    let space = shape{ provider, face, pixels = 32, text = " ", out = spaces[..] }
    let mut blank = ui::GlyphBitmap{ pixels = pixels[..], width = 9, height = 9, left = 0, top = 0 }
    let space_ok = space.len == 1 and provider.rasterize{ state = provider.state, face = space[0].face, glyph = space[0].glyph, out = &blank }
    // a space rasterises to no ink, and true
    @expect(&t, space_ok and blank.width == 0 and blank.height == 0)

    let too_big = lib.stats.too_big
    let mut small: [16]u8
    let mut tiny = ui::GlyphBitmap{ pixels = small[..], width = 0, height = 0, left = 0, top = 0 }
    let fits = provider.rasterize{ state = provider.state, face = a[0].face, glyph = a[0].glyph, out = &tiny }
    // a bitmap larger than the buffer is refused and counted
    @expect(&t, not fits and lib.stats.too_big == too_big + 1)

    let unknown = lib.stats.unknown
    let gone = provider.rasterize{ state = provider.state, face = 99999, glyph = a[0].glyph, out = &bitmap }
    // a sized face that does not exist is refused and counted
    @expect(&t, not gone and lib.stats.unknown == unknown + 1)
    let zero = provider.rasterize{ state = provider.state, face = a[0].face, glyph = 0, out = &bitmap }
    // glyph 0 (a character no face has) draws nothing, as in ZGF
    @expect(&t, not zero)
}

// A draw list with the face registered as font 0, and a text cache. Text is measured at a pixel
// size, so no scale comes into it: 16 units at scale 1.5 is size 24.
struct Measure { list: ui::DrawList, cache: ui::text::Cache }

fn make_measure { mut heap: arena::Arena, lib: ui_fonts::Library, face: ui_fonts::Face } -> !Measure {
    let mut list = try ui::draw::make{ realloc = arena::alloc, &heap, cmds = 64, text = 4096, clips = 4, fonts = 4 }
    ui::draw::reset{ &list, width = 640, height = 480 }
    let def = ui_fonts::describe_face{ lib, face } ifnull { return ui_fonts::closed }
    _ = ui::draw::add_font{ &list, font = def }
    let cache = try ui::text::make_cache{ realloc = arena::alloc, &heap, entries = 256, shaped = 256 }
    return Measure{ list, cache }
}

// The width the core measures: whole pixels, the advances rounded up.
fn measure { mut m: Measure, provider: ui::TextProvider, size: i32, text: []u8 } -> i32 {
    return ui::text::measure_text{ cache = &m.cache, list = m.list, provider, font = ui::Font{ index = 0 }, size, text }
}

// The sum of the advances the core measured from, before it is rounded: what kerning is seen in.
fn sum_width { mut m: Measure, provider: ui::TextProvider, size: i32, text: []u8 } -> f32 {
    return ui::text::sum_text{ cache = &m.cache, list = m.list, provider, font = ui::Font{ index = 0 }, size, text }
}

// "AV" is kerned: narrower than 'A' and 'V' apart.
#test
fn kerns_av_narrower_than_a_and_v_apart { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let mut m = try make_measure{ &heap, lib, face }
    let av = sum_width{ &m, provider, size = 32, text = "AV" }
    let a = sum_width{ &m, provider, size = 32, text = "A" }
    let v = sum_width{ &m, provider, size = 32, text = "V" }
    // What leaves the run is whole pixels: each of the three, rounded up.
    let whole_av = measure{ &m, provider, size = 32, text = "AV" }
    let whole_a = measure{ &m, provider, size = 32, text = "A" }
    // a measured width is the advances rounded up to a whole pixel: a box that wide holds the text
    @expect(&t, whole_av == ui::text::ceil_width{ v = av } and whole_a == ui::text::ceil_width{ v = a } and @as(f32, whole_av) >= av and @as(f32, whole_av) < av + 1.0)
    let mut buf: [16]ui::Shaped
    let ii = sum_advances{ glyphs = shape{ provider, face, pixels = 32, text = "ii", out = buf[..] } }
    let ww = sum_advances{ glyphs = shape{ provider, face, pixels = 32, text = "WW", out = buf[..] } }
    _ = @fmt(&io, "at 32 px: \"AV\" {}, 'A' {} + 'V' {}; \"ii\" {}, \"WW\" {}\n", write_number{ v = av, _ }, write_number{ v = a, _ },
        write_number{ v = v, _ }, write_number{ v = ii, _ }, write_number{ v = ww, _ })
    // "AV" is narrower than 'A' plus 'V' (kerning)
    @expect(&t, av + 0.5 < a + v)
    // the font is proportional: "WW" is much wider than "ii"
    @expect(&t, ww > ii * 2.0)
    let metrics = provider.metrics{ state = provider.state, handle = face.id, pixels = 32 }
    _ = @fmt(&io, "line at 32 px: height {}, ascent {}\n", write_number{ v = metrics.height, _ }, write_number{ v = metrics.ascent, _ })
    // a sized face's line metrics are in range, the line box holding ascent and descent
    @expect(&t, metrics.ascent > 20.0 and metrics.ascent < 40.0 and metrics.height >= metrics.ascent + 4.0 and metrics.height < 56.0)
}

// A second shaping of the same text is a cache hit, and gives the same glyphs.
#test
fn hits_the_run_cache_on_a_second_shaping { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let mut first: [64]ui::Shaped
    let mut second: [64]ui::Shaped
    let a = shape{ provider, face, pixels = 20, text = "The quick brown fox", out = first[..] }
    let shaped = lib.stats.shaped
    let hits = lib.stats.hits
    let b = shape{ provider, face, pixels = 20, text = "The quick brown fox", out = second[..] }
    // a second shaping of the same text is a cache hit, not shaped again
    @expect(&t, lib.stats.hits == hits + 1 and lib.stats.shaped == shaped)
    // the cached run is the same glyphs
    @expect(&t, a.len == b.len and a.len == 19 and is_same_glyphs{ a, b })
    let c = shape{ provider, face, pixels = 21, text = "The quick brown fox", out = second[..] }
    // another pixel size is another sized face, shaped anew
    @expect(&t, lib.stats.shaped == shaped + 1 and c.len == 19 and c[0].face != a[0].face)
}

fn is_same_glyphs { a: []ui::Shaped, b: []ui::Shaped } -> bool {
    if a.len != b.len { return false }
    for g at i in a {
        let h = b[i]
        if g.glyph != h.glyph or g.face != h.face or g.cluster != h.cluster or g.x_advance != h.x_advance or g.x_offset != h.x_offset or g.y_offset != h.y_offset { return false }
    }
    return true
}

// Clusters are byte offsets inside the text that never go down.
fn has_good_clusters { glyphs: []ui::Shaped, len: usize } -> bool {
    let mut last: u32 = 0
    for g in glyphs {
        if g.cluster < last or @as(usize, g.cluster) >= len { return false }
        last = g.cluster
    }
    return true
}

// Bytes that are not UTF-8, a zero size, a handle that names nothing, an empty text.
#test
fn answers_bad_input_and_counts_it { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let mut out: [64]ui::Shaped
    let bad: [12]u8 = [0xFF, 'a', 0xC3, 0x28, 0xE2, 0x82, 'b', 0xED, 0xA0, 0x80, 0xC3, 0xA9]
    let invalid = lib.stats.invalid
    let g = shape{ provider, face, pixels = 16, text = bad[..], out = out[..] }
    _ = @fmt(&io, "12 bytes, 7 of them not UTF-8: {} glyphs, {} bytes counted invalid\n", g.len, lib.stats.invalid - invalid)
    // bytes that are not UTF-8 shape, with clusters inside the text, and are counted
    @expect(&t, g.len > 0 and has_good_clusters{ glyphs = g, len = bad.len } and lib.stats.invalid > invalid)
    let bad_size = lib.stats.bad_size
    let zero = shape{ provider, face, pixels = 0, text = "zero", out = out[..] }
    let huge = shape{ provider, face, pixels = 100000, text = "huge", out = out[..] }
    let zero_metrics = provider.metrics{ state = provider.state, handle = face.id, pixels = 0 }
    // a zero or huge pixel size gives nothing and is counted
    @expect(&t, zero.len == 0 and huge.len == 0 and zero_metrics.height == 0.0 and lib.stats.bad_size == bad_size + 3)
    let unknown = lib.stats.unknown
    let nobody = shape{ provider, face = ui_fonts::Face{ id = 4242 }, pixels = 16, text = "who", out = out[..] }
    // a handle that names no face gives nothing and is counted
    @expect(&t, nobody.len == 0 and lib.stats.unknown == unknown + 1)
    let empty = shape{ provider, face, pixels = 16, text = "", out = out[..] }
    // an empty text has no glyphs
    @expect(&t, empty.len == 0)
    // An output shorter than the glyphs: filled, and the count is its length.
    let short = shape{ provider, face, pixels = 16, text = "twelve chars", out = out[..5] }
    // an output shorter than the run is filled
    @expect(&t, short.len == 5)
}

// The core's walks over a real font: caret offsets and wrapping, at 16 pixels and at 24, which is
// what 16 logical units are at scales 1 and 1.5. The face is shaped at the pixel size itself, so
// the 24 pixel text is the font's own 24 pixel shaping, not the 16 pixel one stretched.
//
// What leaves a shaped run is whole pixels. A measured width is the advances rounded up; a caret
// offset is the advances before it rounded to the nearest pixel. So the offsets never go down, the
// last one is the measured width or the pixel before it, and no wrapped line is wider than the
// limit, in whole pixels, with no tolerance.
#test
fn steps_carets_and_wraps_in_whole_pixels { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let line = "Typography: AV Wa To office ffl, 0123 \xC3\xA9t\xC3\xA9 \xE2\x80\x94 done."
    let paragraph = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs; how vexingly quick daft zebras jump! A well-known, rather extraordinarily long word: incomprehensibilities."
    let sizes: [2]i32 = [16, 24]
    let limits: [2]i32 = [180, 270]
    for size at which in sizes {
        let mut m = try make_measure{ &heap, lib, face }
        let font = ui::Font{ index = 0 }
        let width = measure{ &m, provider, size, text = line }
        let sum = sum_width{ &m, provider, size, text = line }
        let mut index: usize = 0
        let mut last: i32 = 0
        let mut monotonic = true
        let mut steps: u32 = 0
        while index < line.len {
            let next = ui::text::step_caret{ cache = &m.cache, list = m.list, provider, font, size, text = line, index, forward = true }
            if next <= index {
                monotonic = false
                break
            }
            let x = ui::text::locate_caret{ cache = &m.cache, list = m.list, provider, font, size, text = line, index = next }
            if x < last { monotonic = false }
            last = x
            index = next
            steps = steps + 1
        }
        _ = @fmt(&io, "size {}: caret took {} steps over {} bytes, ends at {} of a measured {} (advances {})\n", size, steps, line.len, last, width, write_number{ v = sum, _ })
        // caret offsets in a shaped string are whole pixels that never go down, stepping by clusters
        @expect(&t, monotonic and steps > 0 and steps < @as(u32, line.len))
        // the measured width is the advances rounded up, the last caret offset the advances rounded to the nearest pixel
        @expect(&t, width == ui::text::ceil_width{ v = sum } and last == ui::round_pixels{ v = sum })
        // the last caret offset is the measured width or the pixel before it, never past it
        @expect(&t, last <= width and last >= width - 1)
        let picked = ui::text::pick_index{ cache = &m.cache, list = m.list, provider, font, size, text = line, x = width + 5 }
        // the index right of the line is its end
        @expect(&t, picked == line.len)
        let first = ui::text::locate_caret{ cache = &m.cache, list = m.list, provider, font, size, text = line, index = 0 }
        // the caret before the line is at pixel 0, and pixel 0 picks it
        @expect(&t, first == 0 and ui::text::pick_index{ cache = &m.cache, list = m.list, provider, font, size, text = line, x = 0 } == 0)

        let limit = limits[which]
        let mut lines: [32]ui::text::Line
        let wrapped = ui::text::wrap_text{ cache = &m.cache, list = m.list, provider, font, size, text = paragraph, width = limit, lines = lines[..] }
        let mut fits = true
        let mut whole = true
        let mut widest: i32 = 0
        for l in lines[..@as(usize, wrapped.lines)] {
            let w = measure{ &m, provider, size, text = paragraph[@as(usize, l.start)..@as(usize, l.end)] }
            if l.width > limit or w > limit { fits = false }
            // A line's width is what measuring its bytes alone gives, up to the kerning across the
            // break, which a line shaped with its neighbour may have and the line alone has not.
            if l.width > w + 2 or w > l.width + 2 { whole = false }
            if w > widest { widest = w }
        }
        _ = @fmt(&io, "size {}: the paragraph wraps to {} lines at {}, the widest {}\n", size, wrapped.lines, limit, widest)
        // a paragraph wrapped in the real font has no line wider than the limit, in whole pixels
        @expect(&t, wrapped.lines >= 5 and @as(usize, wrapped.rest) == paragraph.len and fits)
        // each line's width is a whole number of pixels, and the widest is reported
        @expect(&t, whole and wrapped.width <= limit and wrapped.width == widest_of{ lines = lines[..@as(usize, wrapped.lines)] })
        // the core measured with the provider
        @expect(&t, m.cache.unknown_font == 0 and m.cache.no_provider == 0)
        let box = ui::text::get_line_metrics{ cache = &m.cache, list = m.list, provider, font, size }
        let raw = provider.metrics{ state = provider.state, handle = face.id, pixels = ui::text::get_pixel_size{ size } }
        // a line's height is the face's rounded up, its ascent the face's to the nearest pixel
        @expect(&t, @as(f32, box.height) >= raw.height - 0.001 and @as(f32, box.height) < raw.height + 1.0 and ui::abs_f32{ x = @as(f32, box.ascent) - raw.ascent } <= 0.5)
    }
}

fn widest_of { lines: []ui::text::Line } -> i32 {
    let mut widest: i32 = 0
    for l in lines { if l.width > widest { widest = l.width } }
    return widest
}

// A Ui with the face registered by make_font measures through its provider, in pixels, at the
// pixel size a logical size comes to at the frame's scale.
#test
fn measures_through_a_ui_at_the_frames_scale { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let mut ui = try ui::make{ realloc = arena::alloc, &heap, cap = ui::Capacity{ elements = 64, text = 4096, cmds = 256, hits = 64, states = 16, nodes = 64, lines = 64, .. } }
    let font = ui_fonts::make_font{ &lib, &ui, face } ifnull {
        // make_font registers the face with a Ui
        @expect(&t, false)
        return
    }
    ui::set_provider{ &ui, provider }
    ui::begin_frame{ &ui, frame = ui::FrameInfo{ width = 320, height = 200, scale = 1.0, dt = 0.016 } }
    let w = ui::measure_text{ &ui, font, size = 16, text = "Settings" }
    ui::end_frame{ &ui }
    // make_font registers the face, and a Ui measures text in it
    @expect(&t, w > 40 and w < 90 and ui.stats.problems == 0)

    // At scale 1.5 a text of 16 logical units is recorded at 24 pixels: the element is as wide
    // and as high as the face's own 24 pixel text, in whole pixels.
    let label = ui::make_id{ ui, name = "label" }
    ui::begin_frame{ &ui, frame = ui::FrameInfo{ width = 480, height = 300, scale = 1.5, dt = 0.016 } }
    let size = ui::to_font_size{ ui, size = 16.0 }
    let wide = ui::measure_text{ &ui, font, size, text = "Settings" }
    let line = ui::measure_line{ &ui, font, size }
    let el = ui::begin_element{ &ui, id = label, axis = ui::Axis::row, box = ui::Box{ .. } }
    ui::add_text{ &ui, text = "Settings", style = ui::TextStyle{ font, size = 16.0, .. }, box = ui::Box{ .. } }
    ui::end{ &ui, scope = el }
    ui::end_frame{ &ui }
    let rect = ui::get_rect{ ui, id = label } ifnull ui::Rect{ .. }
    // at scale 1.5 a text of 16 units is the face's 24 pixel text, sized in whole pixels
    @expect(&t, size == 24 and wide > w and rect.w == wide and rect.h == line.height and ui.stats.problems == 0)
}

// The line box (the rule at ui_fonts::measure_design), at the pixel sizes text of 13, 14, 16 and 24
// units comes to at scales 1 and 1.5: the baseline is the face's design ascender to the nearest
// pixel, not FreeType's rounded up; the height is the line spacing and at least that baseline and
// the descent, rounded up; every glyph of a line of accented capitals and descenders, and of CJK
// from the fallback face when there is one, is inside the box (nothing is cut by a clip to it);
// and a capital H centred by its line box in a control twice the text's size is within a pixel of
// the control's middle.
#test
fn holds_every_glyph_inside_the_line_box { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let cjk = ui_check::find_cjk_font{ &fs, &proc }
    let slot = ui_fonts::find_face{ lib, id = face.id } ifnull { return ui_fonts::closed }
    let ft = lib.faces[slot].ft ifnull { return ui_fonts::closed }
    let design = ui_fonts::get_design_metrics{ face = ft, layout = lib.layout }
    let upem = @as(f32, lib.faces[slot].units_per_em)
    let mut other: ?ui_fonts::Face = null
    if cjk.found {
        let added = try ui_fonts::add_face_file{ &lib, path = cjk.path, index = 0 }
        ui_fonts::add_fallback{ &lib, face = added }
        other = added
    }
    let units: [4]f32 = [13.0, 14.0, 16.0, 24.0]
    let text = "\xC3\x85\xC3\x89Hgjy\xC3\xA7Q\xE4\xB8\x96\xE7\x95\x8C"       // ÅÉHgjyçQ世界
    let mut baselines = true
    let mut heights = true
    let mut inside = true
    let mut centred = true
    let mut fallback_glyphs: u32 = 0
    let mut pixels_buf: [65536]u8
    for k in 0..2 {
        let scale: f32 = if k == 0 { 1.0 } else { 1.5 }
        for u in units {
            let size = ui::scale_font_size{ size = u, scale }
            let px = @as(u32, size)
            let raw = provider.metrics{ state = provider.state, handle = face.id, pixels = px }
            let box = ui::text::round_metrics{ m = raw }
            let per = @as(f32, px) / upem
            let ascent = ui::round_pixels{ v = @as(f32, design.ascender) * per }
            let descent = ui::ceil_pixels{ v = -@as(f32, design.descender) * per - 0.001 }
            let spacing = ui::ceil_pixels{ v = @as(f32, design.height) * per - 0.001 }
            if box.ascent != ascent { baselines = false }
            if box.height != ui::pick_max_i32{ a = spacing, b = ascent + descent } { heights = false }
            let mut out: [32]ui::Shaped
            let glyphs = shape{ provider, face, pixels = px, text, out = out[..] }
            let mut h_top: i32 = 0
            let mut h_rows: i32 = 0
            for g in glyphs {
                let mut bitmap = ui::GlyphBitmap{ pixels = pixels_buf[..], width = 0, height = 0, left = 0, top = 0 }
                if not provider.rasterize{ state = provider.state, face = g.face, glyph = g.glyph, out = &bitmap } or bitmap.height == 0 { continue }
                let rows = @as(i32, bitmap.height)
                if bitmap.top > box.ascent or rows - bitmap.top > box.height - box.ascent { inside = false }
                if g.cluster == 4 {
                    h_top = bitmap.top
                    h_rows = rows
                }
                if g.cluster >= 11 and g.face != glyphs[0].face { fallback_glyphs = fallback_glyphs + 1 }
            }
            // A control twice the text's size, its line box centred in it (the spare halved and
            // rounded down, as the layout centres), and H's ink in that box.
            let control = ui::scale_length{ length = u * 2.0, scale }
            let top = (control - box.height) / 2
            let ink_top = top + box.ascent - h_top
            let off2 = 2 * ink_top + h_rows - control
            if off2 > 2 or off2 < -2 { centred = false }
            let s = ui_fonts::find_sized{ &lib, handle = face.id, pixels = px } ifnull { return ui_fonts::closed }
            let sized = lib.sizes[s].ft ifnull { return ui_fonts::closed }
            let rounded = ui_fonts::get_size_metrics{ size = sized, layout = lib.layout }
            _ = @fmt(&io, "line box at {} px: height {}, baseline {} (FreeType's {}); H {} rows, its middle {} half pixels below a {} pixel control's\n",
                px, box.height, box.ascent, write_number{ v = rounded.ascender, _ }, h_rows, off2, control)
        }
    }
    // line box: the baseline is the face's design ascender to the nearest pixel
    @expect(&t, baselines)
    // line box: the height is the line spacing, and at least the baseline plus the descent, rounded up
    @expect(&t, heights)
    // line box: every glyph of accented capitals, descenders and CJK is inside the box
    @expect(&t, inside)
    // line box: a capital centred by its line box is within a pixel of the control's middle
    @expect(&t, centred)
    if let f = other {
        // line box: the CJK came from the fallback face, on the same baseline
        @expect(&t, fallback_glyphs >= 16)
        ui_fonts::release_face{ &lib, face = f }
    }
}

// With a CJK face as fallback, a line mixing Latin and CJK comes back as runs of two sized faces.
#test
fn falls_back_to_a_cjk_face { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let mixed = "Hello \xE4\xB8\x96\xE7\x95\x8C and \xE6\x97\xA5\xE6\x9C\xAC\xE8\xAA\x9E!"     // Hello 世界 and 日本語!
    let mut out: [64]ui::Shaped
    let missing = lib.stats.missing
    let alone = shape{ provider, face, pixels = 24, text = mixed, out = out[..] }
    _ = @fmt(&io, "without a fallback: {} glyphs, {} of them missing\n", alone.len, lib.stats.missing - missing)
    let other = try add_cjk{ &t, &fs, &proc, &lib }
    ui_fonts::add_fallback{ &lib, face = other }
    let missing_after = lib.stats.missing
    let g = shape{ provider, face, pixels = 24, text = mixed, out = out[..] }
    let first = g[0].face
    let mut second: u32 = 0
    let mut runs: u32 = 1
    let mut cjk_ok = true
    for s at i in g {
        if i > 0 and s.face != g[i - 1].face { runs = runs + 1 }
        if s.face != first { second = s.face }
        let at = @as(usize, s.cluster)
        let wide = mixed[at] >= 0xE0
        if wide == (s.face == first) { cjk_ok = false }
    }
    _ = @fmt(&io, "with the fallback: {} glyphs in {} runs from faces {} and {}\n", g.len, runs, first, second)
    // a line mixing Latin and CJK comes back as runs from two faces, each character from the face that has it
    @expect(&t, second != 0 and runs == 5 and cjk_ok)
    // no character is missing with the fallback, and the clusters hold
    @expect(&t, lib.stats.missing == missing_after and has_good_clusters{ glyphs = g, len = mixed.len })
    let size = ui_fonts::find_size{ lib, id = second } ifnull { return ui_fonts::closed }
    // the fallback's glyphs are of its own variant at the same pixel size
    @expect(&t, lib.sizes[size].face == other.id and lib.sizes[size].pixels == 24)
    // The fallback's glyphs rasterise; release it and the face shapes alone again.
    let mut pixels: [65536]u8
    let mut bitmap = ui::GlyphBitmap{ pixels = pixels[..], width = 0, height = 0, left = 0, top = 0 }
    let mut drew = false
    for s in g { if s.face == second and not drew { drew = provider.rasterize{ state = provider.state, face = s.face, glyph = s.glyph, out = &bitmap } and bitmap.width > 0 } }
    // a fallback glyph rasterises
    @expect(&t, drew)
    ui_fonts::release_face{ &lib, face = other }
    let back = shape{ provider, face, pixels = 24, text = mixed, out = out[..] }
    let mut one = true
    for s in back { if s.face != first { one = false } }
    // a released fallback is no longer tried
    @expect(&t, lib.fallback_count == 0 and one)
}

// Releasing a face frees its glyphs: its sized faces' glyphs leave the staged level's cache, and
// their atlas room is free again after the quarantine.
#test
fn frees_a_released_faces_glyphs { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let face = try add_latin{ &t, &fs, &proc, &lib }
    let mut list = try ui::draw::make{ realloc = arena::alloc, &heap, cmds = 64, text = 4096, clips = 4, fonts = 4 }
    let mut staged = try ui_stage::make{ realloc = arena::alloc, &heap, cap = ui_stage::Capacity{
        rects = 64, glyphs = 1024, images = 16, shapes = 16, draws = 64, passes = 2,
        atlas_width = 256, atlas_height = 256, atlas_max_height = 512, glyph_cache = 512, raster_bytes = 65536 } }
    let def = ui_fonts::describe_face{ lib, face } ifnull { return ui_fonts::closed }
    ui::draw::reset{ &list, width = 320, height = 120 }
    let font = ui::draw::add_font{ &list, font = def } ifnull { return ui_fonts::closed }
    ui::draw::add_text{ &list, font, size = 16, x = 4, y = 4, text = "Release me", color = ui::Color{ r = 255, g = 255, b = 255, .. }, clip = 0 }
    ui::draw::add_text{ &list, font, size = 24, x = 4, y = 40, text = "and me too", color = ui::Color{ r = 255, g = 255, b = 255, .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    let cached = staged.cache_used
    // text in the face stages, its glyphs cached in the atlas
    @expect(&t, staged.dropped == 0 and staged.glyph_count > 10 and cached > 10)
    let mut ids: [8]u32
    let n = ui_fonts::list_sizes{ lib, face, out = ids[..] }
    // the face has a sized variant for each pixel size drawn
    @expect(&t, n == 2)
    for id in ids[..n] { ui_stage::release_face{ out = &staged, face = id } }
    let sizes_before = lib.live.ft_sizes
    ui_fonts::release_face{ &lib, face }
    // releasing the face takes its glyphs out of the glyph cache
    @expect(&t, staged.cache_used == 0 and staged.packer.held_count > 0)
    // releasing the face releases its sized variants
    @expect(&t, lib.live.ft_sizes + 2 == sizes_before and ui_fonts::find_face{ lib, id = face.id } == null)
    ui::draw::reset{ &list, width = 320, height = 120 }
    for _ in 0..5 { ui_stage::stage{ out = &staged, list = &list, provider } }
    // after the quarantine the released glyphs' atlas room is free to take
    @expect(&t, staged.packer.held_count == 0 and staged.packer.freed_count > 0)
    // Text still naming the released face: nothing drawn, counted by the provider, no panic.
    let unknown = lib.stats.unknown
    _ = ui::draw::add_font{ &list, font = def }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16, x = 4, y = 4, text = "gone", color = ui::Color{ r = 255, g = 255, b = 255, .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    // text in a released face draws nothing and is counted
    @expect(&t, staged.glyph_count == 0 and lib.stats.unknown > unknown)
}

// A run cache with room for four runs: generations retire, and what comes back is still right.
#test
fn retires_runs_from_a_full_run_cache { mut t: Test, mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut fonts: ui_fonts::Fonts } -> ! {
    let mut heap = ui_check::make_heap{ &mem }
    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ faces = 2, sizes = 2, runs = 4, run_bytes = 64, run_glyphs = 64, scratch = 24 } }
    let face = add_latin{ &t, &fs, &proc, &lib } iferr {
        // a face loads into a small library
        @expect(&t, false)
        ui_fonts::close{ &lib }
        return
    }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let words: [10][]u8 = ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"]
    let mut first: [32]ui::Shaped
    let a = shape{ provider, face, pixels = 16, text = words[0], out = first[..] }
    let mut out: [32]ui::Shaped
    for w in words { _ = shape{ provider, face, pixels = 16, text = w, out = out[..] } }
    let again = shape{ provider, face, pixels = 16, text = words[0], out = out[..] }
    // a full run cache retires a generation, and runs shape the same after
    @expect(&t, lib.stats.retired > 0 and is_same_glyphs{ a, b = again })
    // More glyphs than a generation holds: shaped each time, counted.
    let long = "a run of text that has more glyphs than one generation keeps"
    let truncated = lib.stats.truncated
    let cut = shape{ provider, face, pixels = 16, text = long, out = out[..] }
    // glyphs past the scratch buffer are cut and counted
    @expect(&t, cut.len == 24 and lib.stats.truncated == truncated + 1)
    let mut m_ok = true
    let mut list = try ui::draw::make{ realloc = arena::alloc, &heap, cmds = 4, text = 256, clips = 2, fonts = 2 }
    ui::draw::reset{ &list, width = 640, height = 480 }
    let def = ui_fonts::describe_face{ lib, face } ifnull { return ui_check::refused }
    _ = ui::draw::add_font{ &list, font = def }
    let mut cache = try ui::text::make_cache{ realloc = arena::alloc, &heap, entries = 16, shaped = 16 }
    let whole = ui::text::sum_text{ &cache, list, provider, font = ui::Font{ index = 0 }, size = 16, text = long }
    let mut bigger: [128]ui::Shaped
    let mut full = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let full_face = try add_latin{ &t, &fs, &proc, lib = &full }
    let full_provider = ui_fonts::get_provider{ lib = &full }
    let reference = sum_advances{ glyphs = shape{ provider = full_provider, face = full_face, pixels = 16, text = long, out = bigger[..] } }
    if ui::abs_f32{ x = whole - reference } > 0.01 { m_ok = false }
    if ui::text::measure_text{ &cache, list, provider, font = ui::Font{ index = 0 }, size = 16, text = long } != ui::text::ceil_width{ v = reference } { m_ok = false }
    _ = @fmt(&io, "a long text measured in pieces: {}, shaped whole: {}\n", write_number{ v = whole, _ }, write_number{ v = reference, _ })
    // the core shapes a text longer than its buffer in pieces, to the same width
    @expect(&t, m_ok)
    // 22 em dashes: 22 glyphs, which the scratch buffer holds, in 66 bytes, more than a generation
    // keeps: shaped every time, and counted.
    let mut dashes: [66]u8
    for i in 0..22 {
        dashes[i * 3] = 0xE2
        dashes[i * 3 + 1] = 0x80
        dashes[i * 3 + 2] = 0x94
    }
    let uncached = lib.stats.uncached
    let shaped = lib.stats.shaped
    let d1 = shape{ provider, face, pixels = 16, text = dashes[..], out = out[..] }
    let d2 = shape{ provider, face, pixels = 16, text = dashes[..], out = bigger[..] }
    // a run too big for the run cache is shaped each time, and counted
    @expect(&t, d1.len == 22 and is_same_glyphs{ a = d1, b = d2 } and lib.stats.uncached == uncached + 2 and lib.stats.shaped == shaped + 2)
    ui_fonts::close{ lib = &full }
    ui_fonts::close{ &lib }
}
