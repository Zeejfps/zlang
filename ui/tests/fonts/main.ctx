// Stage 4's test: ui_fonts over FreeType and HarfBuzz, with a real font from the system.
//
//   kotor/tools/ctxc run ui/tests/fonts                          (from the repository root)
//   kotor/tools/ctxc run ui/tests/fonts -- --font PATH --cjk PATH
//
// `--font` is the Latin face (default: the platform's, such as C:\Windows\Fonts\segoeui.ttf) and
// `--cjk` a face with Chinese or Japanese characters for the fallback checks (default: the first of
// the platform's that exists). With no Latin face the test says why and exits 0; with no CJK face
// it skips the fallback checks and says so. No font file is part of the repository.
//
// Checks: the start-up check of FreeType's mirrored fields passes, and fails loudly when an offset
// is wrong; 'A' rasterises to ink; "AV" is narrower than 'A' and 'V' apart; a second shaping is a
// cache hit; a line mixing Latin and CJK comes back from two faces; releasing a face frees its
// glyphs in a staged level; caret offsets are monotonic and end at the measured width; wrapped lines
// keep to the width; bad input (bytes that are not a font, bytes that are not UTF-8, a zero size, a
// handle that names nothing, a buffer too small, a full run cache) is answered and counted; `close`
// leaves no FreeType or HarfBuzz object alive. Exits 1 when any check fails.

const LATIN_WINDOWS: [1][]u8 = ["C:/Windows/Fonts/segoeui.ttf"]
const LATIN_MACOS: [1][]u8 = ["/System/Library/Fonts/Helvetica.ttc"]
const LATIN_LINUX: [2][]u8 = ["/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/TTF/DejaVuSans.ttf"]
const CJK_WINDOWS: [3][]u8 = ["C:/Windows/Fonts/msyh.ttc", "C:/Windows/Fonts/YuGothR.ttc", "C:/Windows/Fonts/simsun.ttc"]
const CJK_MACOS: [2][]u8 = ["/System/Library/Fonts/PingFang.ttc", "/System/Library/Fonts/Hiragino Sans GB.ttc"]
const CJK_LINUX: [2][]u8 = ["/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc", "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc"]

const EPS: f32 = 0.001

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, mut fonts: ui_fonts::Fonts, args: Args } -> i32 {
    let mut t = ui_test::Tally{ run = 0, failed = 0 }
    let buf = mem::pages{ &mem, size = 536870912 } ifnull {
        io::eprintln{ &io, s = "ui/tests/fonts: out of memory" }
        return 1
    }
    let mut heap = arena::new{ buf }
    let latin = read_font{ &fs, &heap, args, option = "--font", defaults = get_latin_paths{} }
    let latin_bytes = latin.bytes ifnull {
        _ = @fmt(&io, "ui/tests/fonts: no font to test with: {} (pass --font PATH); skipped\n", latin.path)
        return 0
    }
    _ = @fmt(&io, "font: {} ({} bytes)\n", latin.path, latin_bytes.len)
    let cjk = read_font{ &fs, &heap, args, option = "--cjk", defaults = get_cjk_paths{} }
    if let bytes = cjk.bytes {
        _ = @fmt(&io, "fallback font: {} ({} bytes)\n", cjk.path, bytes.len)
    } else {
        _ = @fmt(&io, "no CJK font at {} (pass --cjk PATH): the fallback checks are skipped\n", cjk.path)
    }
    run{ &io, &fonts, &t, &heap, latin = latin_bytes, cjk = cjk.bytes } iferr err{ error } {
        _ = @fmt(&io, "ui/tests/fonts: failed: {}\n", error)
        io::flush{ &io }
        return 1
    }
    _ = @fmt(&io, "ui/tests/fonts: {} checks, {} failed\n", t.run, t.failed)
    io::flush{ &io }
    return if t.failed == 0 { 0 } else { 1 }
}

// A number with up to two digits after the point (std prints 10.0 as 1e+01).
fn write_number { mut io: Io, v: f32 } -> ! {
    let mut text: [48]u8
    let n = ui::format_fixed{ v, digits = 2, trim = true, into = text[..] }
    _ = @fmt(&io, "{}", text[..n])
}

// ---- finding a font

fn get_latin_paths {} -> [][]u8 {
    return match target::OS { windows => { LATIN_WINDOWS[..] } macos => { LATIN_MACOS[..] } linux => { LATIN_LINUX[..] } }
}

fn get_cjk_paths {} -> [][]u8 {
    return match target::OS { windows => { CJK_WINDOWS[..] } macos => { CJK_MACOS[..] } linux => { CJK_LINUX[..] } }
}

// The value after `name` in the arguments, or null.
fn find_option { args: Args, name: []u8 } -> ?[]u8 {
    for a at i in args {
        if i + 1 < args.len and slice::eq_bytes{ a, b = name } { return args[i + 1] }
    }
    return null
}

// A font file's bytes: the path the option names, else the first default that can be read. `path`
// is the one read, or what was tried when none was.
struct Found { path: []u8, bytes: ?[]u8 }

fn read_font { mut fs: Fs, mut heap: arena::Arena, args: Args, option: []u8, defaults: [][]u8 } -> Found {
    if let path = find_option{ args, name = option } {
        let bytes = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr { return Found{ path, bytes = null } }
        return Found{ path, bytes }
    }
    for path in defaults {
        let bytes = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr { continue }
        return Found{ path, bytes }
    }
    return Found{ path = if defaults.len > 0 { defaults[0] } else { "" }, bytes = null }
}

// ---- the checks

fn run { mut io: Io, mut fonts: ui_fonts::Fonts, mut t: ui_test::Tally, mut heap: arena::Arena, latin: []u8, cjk: ?[]u8 } -> ! {
    let freed_before = ui_fonts::count_freed{ &fonts }
    check_layout_check{ &io, &fonts, &t, &heap, latin }
    check_bad_bytes{ &io, &fonts, &t, &heap, latin }

    let mut lib = try ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } }
    let version = ui_fonts::get_version{ &lib }
    _ = @fmt(&io, "FreeType {}.{}.{}, HarfBuzz {}\n", version.major, version.minor, version.patch, ui_fonts::hb_version_string{ &fonts })
    let face = try ui_fonts::add_face{ &lib, data = latin, index = 0 }
    let slot = ui_fonts::find_face{ lib, id = face.id } ifnull { return ui_fonts::closed }
    _ = @fmt(&io, "face {}: {} units per em, {} glyphs; the mirrored fields check out\n", face.id, lib.faces[slot].units_per_em, lib.faces[slot].glyph_count)
    ui_test::expect{ &io, &t, ok = face.id != 0, what = "a face loads and its mirrored FreeType fields pass the start-up check" }
    let provider = ui_fonts::get_provider{ lib = &lib }

    check_raster{ &io, &t, &lib, provider, face }
    check_kerning{ &io, &t, &heap, &lib, provider, face }
    check_cache{ &io, &t, &lib, provider, face }
    check_bad_input{ &io, &t, &lib, provider, face }
    check_text{ &io, &t, &heap, &lib, provider, face }
    check_ui{ &io, &t, &heap, &lib, provider, face }
    if let bytes = cjk { try check_fallback{ &io, &t, &lib, provider, face, cjk = bytes } }
    try check_release{ &io, &t, &heap, &lib, provider, latin }
    check_small_cache{ &io, &fonts, &t, &heap, latin }

    // close: every FreeType and HarfBuzz object released, as HarfBuzz itself reports.
    let blobs = lib.live.hb_blobs
    let freed_open = ui_fonts::count_freed{ &fonts }
    ui_fonts::close{ &lib }
    let freed = ui_fonts::count_freed{ &fonts }
    let live = lib.live
    _ = @fmt(&io, "after close: {} libraries, {} faces, {} sizes, {} blobs, {} hb faces, {} hb fonts, {} buffers alive; HarfBuzz freed {} blobs and {} buffers in all\n",
        live.ft_libraries, live.ft_faces, live.ft_sizes, live.hb_blobs, live.hb_faces, live.hb_fonts, live.hb_buffers,
        freed.blobs - freed_before.blobs, freed.buffers - freed_before.buffers)
    let none = live.ft_libraries == 0 and live.ft_faces == 0 and live.ft_sizes == 0 and live.hb_blobs == 0
        and live.hb_faces == 0 and live.hb_fonts == 0 and live.hb_buffers == 0
    ui_test::expect{ &io, &t, ok = none, what = "close releases every FreeType and HarfBuzz object the library made" }
    ui_test::expect{ &io, &t, ok = freed.blobs - freed_open.blobs == @as(u64, blobs) and freed.buffers - freed_open.buffers == 1,
        what = "HarfBuzz reports each blob (so each face and font over it) and the buffer freed at close" }
    let mut after: [8]ui::Shaped
    ui_test::expect{ &io, &t, ok = ui_fonts::shape_text{ &lib, handle = face.id, pixels = 16, text = "after", out = after[..] } == 0,
        what = "a closed library answers nothing" }
}

// The start-up check fails at once, and leaves nothing behind, when a mirrored offset is wrong.
fn check_layout_check { mut io: Io, mut fonts: ui_fonts::Fonts, mut t: ui_test::Tally, mut heap: arena::Arena, latin: []u8 } {
    let mut lib = ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ faces = 2, sizes = 4, runs = 4, run_bytes = 256, run_glyphs = 256, scratch = 64 } } iferr {
        ui_test::expect{ &io, &t, ok = false, what = "a library opens" }
        return
    }
    lib.layout.face_units_per_em = lib.layout.face_units_per_em + 2
    let wrong_upem = is_bad_layout{ lib = &lib, data = latin }
    lib.layout = ui_fonts::LAYOUT
    lib.layout.size_ascender = lib.layout.size_ascender + 4
    let wrong_size = is_bad_layout{ lib = &lib, data = latin }
    lib.layout = ui_fonts::LAYOUT
    lib.layout.face_num_glyphs = lib.layout.face_num_glyphs + 8
    let wrong_count = is_bad_layout{ lib = &lib, data = latin }
    ui_test::expect{ &io, &t, ok = wrong_upem and wrong_size and wrong_count, what = "a wrong mirrored offset fails add_face with bad_layout" }
    ui_test::expect{ &io, &t, ok = lib.live.ft_faces == 0 and lib.live.hb_blobs == 0 and lib.live.hb_faces == 0 and lib.live.ft_sizes == 0,
        what = "a face that fails the check leaves nothing behind" }
    ui_fonts::close{ &lib }
}

fn is_bad_layout { mut lib: ui_fonts::Library, data: []u8 } -> bool {
    let face = ui_fonts::add_face{ &lib, data, index = 0 } iferr err{ error } {
        match error {
            ui_fonts::bad_layout{ field, got, want } => {}
            else => { return false }
        }
        return true
    }
    ui_fonts::release_face{ &lib, face }
    return false
}

// Bytes that are not a font, no bytes, and a face index the file does not have: refused.
fn check_bad_bytes { mut io: Io, mut fonts: ui_fonts::Fonts, mut t: ui_test::Tally, mut heap: arena::Arena, latin: []u8 } {
    let mut lib = ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ faces = 2, sizes = 4, runs = 4, run_bytes = 256, run_glyphs = 256, scratch = 64 } } iferr {
        ui_test::expect{ &io, &t, ok = false, what = "a library opens" }
        return
    }
    let junk = is_bad_font{ lib = &lib, data = "this is not a font file, only text that is long enough to look at" }
    let empty = is_bad_font{ lib = &lib, data = "" }
    let truncated = is_bad_font{ lib = &lib, data = latin[..latin.len / 3] }
    let mut index_ok = false
    _ = ui_fonts::add_face{ &lib, data = latin, index = 7 } iferr { index_ok = true }
    ui_test::expect{ &io, &t, ok = junk and empty, what = "bytes that are not a font are refused with bad_font" }
    ui_test::expect{ &io, &t, ok = index_ok, what = "a face index the file does not have is refused" }
    _ = @fmt(&io, "a third of the font file: {}\n", if truncated { "refused" } else { "opened (FreeType loads tables lazily)" })
    ui_test::expect{ &io, &t, ok = lib.live.ft_faces == 0 and lib.live.hb_blobs == 0 and lib.live.hb_faces == 0, what = "refused bytes leave nothing behind" }
    ui_fonts::close{ &lib }
    ui_test::expect{ &io, &t, ok = lib.live.ft_faces == 0 and lib.live.hb_blobs == 0, what = "close after refused bytes leaves nothing" }
}

fn is_bad_font { mut lib: ui_fonts::Library, data: []u8 } -> bool {
    let face = ui_fonts::add_face{ &lib, data, index = 0 } iferr err{ error } {
        match error {
            ui_fonts::bad_font{ code } => {}
            else => { return false }
        }
        return true
    }
    ui_fonts::release_face{ &lib, face }
    return false
}

// The glyphs of `text` in `face` at `pixels`, shaped by the provider.
fn shape { provider: ui::TextProvider, face: ui_fonts::Face, pixels: u32, text: []u8, out: []mut ui::Shaped } -> []mut ui::Shaped {
    let n = provider.shape{ state = provider.state, handle = face.id, pixels, text, out }
    return out[..n]
}

fn sum_advances { glyphs: []ui::Shaped } -> f32 {
    let mut total: f32 = 0.0
    for g in glyphs { total = total + g.x_advance }
    return total
}

// 'A' rasterises to ink; a space to nothing; too small a buffer and a face that is not there are refused.
fn check_raster { mut io: Io, mut t: ui_test::Tally, mut lib: ui_fonts::Library, provider: ui::TextProvider, face: ui_fonts::Face } {
    let mut out: [8]ui::Shaped
    let a = shape{ provider, face, pixels = 32, text = "A", out = out[..] }
    ui_test::expect{ &io, &t, ok = a.len == 1 and a[0].glyph != 0, what = "'A' shapes to one glyph" }
    if a.len != 1 { return }
    let mut pixels: [65536]u8
    let mut bitmap = ui::GlyphBitmap{ pixels = pixels[..], width = 0, height = 0, left = 0, top = 0 }
    let ok = provider.rasterize{ state = provider.state, face = a[0].face, glyph = a[0].glyph, out = &bitmap }
    let mut covered: u32 = 0
    for p in pixels[..@as(usize, bitmap.width * bitmap.height)] { if p > 127 { covered = covered + 1 } }
    _ = @fmt(&io, "'A' at 32 px: {}x{}, left {}, top {}, {} covered pixels\n", bitmap.width, bitmap.height, bitmap.left, bitmap.top, covered)
    ui_test::expect{ &io, &t, ok = ok and bitmap.width > 8 and bitmap.height > 12 and covered > 40, what = "'A' rasterises to a non-empty bitmap" }
    ui_test::expect{ &io, &t, ok = bitmap.top > 12 and bitmap.top <= 32, what = "'A' stands on the baseline, its top above it" }

    let mut spaces: [8]ui::Shaped
    let space = shape{ provider, face, pixels = 32, text = " ", out = spaces[..] }
    let mut blank = ui::GlyphBitmap{ pixels = pixels[..], width = 9, height = 9, left = 0, top = 0 }
    let space_ok = space.len == 1 and provider.rasterize{ state = provider.state, face = space[0].face, glyph = space[0].glyph, out = &blank }
    ui_test::expect{ &io, &t, ok = space_ok and blank.width == 0 and blank.height == 0, what = "a space rasterises to no ink, and true" }

    let too_big = lib.stats.too_big
    let mut small: [16]u8
    let mut tiny = ui::GlyphBitmap{ pixels = small[..], width = 0, height = 0, left = 0, top = 0 }
    let fits = provider.rasterize{ state = provider.state, face = a[0].face, glyph = a[0].glyph, out = &tiny }
    ui_test::expect{ &io, &t, ok = not fits and lib.stats.too_big == too_big + 1, what = "a bitmap larger than the buffer is refused and counted" }

    let unknown = lib.stats.unknown
    let gone = provider.rasterize{ state = provider.state, face = 99999, glyph = a[0].glyph, out = &bitmap }
    ui_test::expect{ &io, &t, ok = not gone and lib.stats.unknown == unknown + 1, what = "a sized face that does not exist is refused and counted" }
    let zero = provider.rasterize{ state = provider.state, face = a[0].face, glyph = 0, out = &bitmap }
    ui_test::expect{ &io, &t, ok = not zero, what = "glyph 0 (a character no face has) draws nothing, as in ZGF" }
}

// A draw list with the face registered as font 0, and a text cache. Text is measured at a pixel
// size, so no scale comes into it: 16 units at scale 1.5 is size 24.
struct Measure { list: ui::DrawList, cache: ui::text::Cache }

fn make_measure { mut heap: arena::Arena, lib: ui_fonts::Library, face: ui_fonts::Face } -> !Measure {
    let mut list = try ui::draw::make{ realloc = arena::alloc, &heap, cmds = 64, text = 4096, clips = 4, fonts = 4 }
    ui::draw::reset{ &list, width = 640, height = 480 }
    let def = ui_fonts::describe_face{ lib, face } ifnull { return ui_fonts::closed }
    _ = ui::draw::add_font{ &list, font = def }
    let cache = try ui::text::make_cache{ realloc = arena::alloc, &heap, entries = 256, shaped = 256 }
    return Measure{ list, cache }
}

// The width the core measures: whole pixels, the advances rounded up.
fn measure { mut m: Measure, provider: ui::TextProvider, size: i32, text: []u8 } -> i32 {
    return ui::text::measure_text{ cache = &m.cache, list = m.list, provider, font = ui::Font{ index = 0 }, size, text }
}

// The sum of the advances the core measured from, before it is rounded: what kerning is seen in.
fn sum_width { mut m: Measure, provider: ui::TextProvider, size: i32, text: []u8 } -> f32 {
    return ui::text::sum_text{ cache = &m.cache, list = m.list, provider, font = ui::Font{ index = 0 }, size, text }
}

// "AV" is kerned: narrower than 'A' and 'V' apart.
fn check_kerning { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, mut lib: ui_fonts::Library, provider: ui::TextProvider, face: ui_fonts::Face } {
    let mut m = make_measure{ &heap, lib, face } iferr {
        ui_test::expect{ &io, &t, ok = false, what = "a draw list for measuring" }
        return
    }
    let av = sum_width{ &m, provider, size = 32, text = "AV" }
    let a = sum_width{ &m, provider, size = 32, text = "A" }
    let v = sum_width{ &m, provider, size = 32, text = "V" }
    // What leaves the run is whole pixels: each of the three, rounded up.
    let whole_av = measure{ &m, provider, size = 32, text = "AV" }
    let whole_a = measure{ &m, provider, size = 32, text = "A" }
    ui_test::expect{ &io, &t, ok = whole_av == ui::text::ceil_width{ v = av } and whole_a == ui::text::ceil_width{ v = a } and @as(f32, whole_av) >= av and @as(f32, whole_av) < av + 1.0,
        what = "a measured width is the advances rounded up to a whole pixel: a box that wide holds the text" }
    let mut buf: [16]ui::Shaped
    let ii = sum_advances{ glyphs = shape{ provider, face, pixels = 32, text = "ii", out = buf[..] } }
    let ww = sum_advances{ glyphs = shape{ provider, face, pixels = 32, text = "WW", out = buf[..] } }
    _ = @fmt(&io, "at 32 px: \"AV\" {}, 'A' {} + 'V' {}; \"ii\" {}, \"WW\" {}\n", write_number{ v = av, _ }, write_number{ v = a, _ },
        write_number{ v = v, _ }, write_number{ v = ii, _ }, write_number{ v = ww, _ })
    ui_test::expect{ &io, &t, ok = av + 0.5 < a + v, what = "\"AV\" is narrower than 'A' plus 'V' (kerning)" }
    ui_test::expect{ &io, &t, ok = ww > ii * 2.0, what = "the font is proportional: \"WW\" is much wider than \"ii\"" }
    let metrics = provider.metrics{ state = provider.state, handle = face.id, pixels = 32 }
    _ = @fmt(&io, "line at 32 px: height {}, ascent {}\n", write_number{ v = metrics.height, _ }, write_number{ v = metrics.ascent, _ })
    ui_test::expect{ &io, &t, ok = metrics.ascent > 20.0 and metrics.ascent < 40.0 and metrics.height >= metrics.ascent + 4.0 and metrics.height < 56.0,
        what = "a sized face's line metrics are in range, the line box holding ascent and descent" }
}

// A second shaping of the same text is a cache hit, and gives the same glyphs.
fn check_cache { mut io: Io, mut t: ui_test::Tally, mut lib: ui_fonts::Library, provider: ui::TextProvider, face: ui_fonts::Face } {
    let mut first: [64]ui::Shaped
    let mut second: [64]ui::Shaped
    let a = shape{ provider, face, pixels = 20, text = "The quick brown fox", out = first[..] }
    let shaped = lib.stats.shaped
    let hits = lib.stats.hits
    let b = shape{ provider, face, pixels = 20, text = "The quick brown fox", out = second[..] }
    ui_test::expect{ &io, &t, ok = lib.stats.hits == hits + 1 and lib.stats.shaped == shaped, what = "a second shaping of the same text is a cache hit, not shaped again" }
    ui_test::expect{ &io, &t, ok = a.len == b.len and a.len == 19 and is_same_glyphs{ a, b }, what = "the cached run is the same glyphs" }
    let c = shape{ provider, face, pixels = 21, text = "The quick brown fox", out = second[..] }
    ui_test::expect{ &io, &t, ok = lib.stats.shaped == shaped + 1 and c.len == 19 and c[0].face != a[0].face,
        what = "another pixel size is another sized face, shaped anew" }
}

fn is_same_glyphs { a: []ui::Shaped, b: []ui::Shaped } -> bool {
    if a.len != b.len { return false }
    for g at i in a {
        let h = b[i]
        if g.glyph != h.glyph or g.face != h.face or g.cluster != h.cluster or g.x_advance != h.x_advance or g.x_offset != h.x_offset or g.y_offset != h.y_offset { return false }
    }
    return true
}

// Clusters are byte offsets inside the text that never go down.
fn has_good_clusters { glyphs: []ui::Shaped, len: usize } -> bool {
    let mut last: u32 = 0
    for g in glyphs {
        if g.cluster < last or @as(usize, g.cluster) >= len { return false }
        last = g.cluster
    }
    return true
}

// Bytes that are not UTF-8, a zero size, a handle that names nothing, an empty text.
fn check_bad_input { mut io: Io, mut t: ui_test::Tally, mut lib: ui_fonts::Library, provider: ui::TextProvider, face: ui_fonts::Face } {
    let mut out: [64]ui::Shaped
    let bad: [12]u8 = [0xFF, 'a', 0xC3, 0x28, 0xE2, 0x82, 'b', 0xED, 0xA0, 0x80, 0xC3, 0xA9]
    let invalid = lib.stats.invalid
    let g = shape{ provider, face, pixels = 16, text = bad[..], out = out[..] }
    _ = @fmt(&io, "12 bytes, 7 of them not UTF-8: {} glyphs, {} bytes counted invalid\n", g.len, lib.stats.invalid - invalid)
    ui_test::expect{ &io, &t, ok = g.len > 0 and has_good_clusters{ glyphs = g, len = bad.len } and lib.stats.invalid > invalid,
        what = "bytes that are not UTF-8 shape, with clusters inside the text, and are counted" }
    let bad_size = lib.stats.bad_size
    let zero = shape{ provider, face, pixels = 0, text = "zero", out = out[..] }
    let huge = shape{ provider, face, pixels = 100000, text = "huge", out = out[..] }
    let zero_metrics = provider.metrics{ state = provider.state, handle = face.id, pixels = 0 }
    ui_test::expect{ &io, &t, ok = zero.len == 0 and huge.len == 0 and zero_metrics.height == 0.0 and lib.stats.bad_size == bad_size + 3,
        what = "a zero or huge pixel size gives nothing and is counted" }
    let unknown = lib.stats.unknown
    let nobody = shape{ provider, face = ui_fonts::Face{ id = 4242 }, pixels = 16, text = "who", out = out[..] }
    ui_test::expect{ &io, &t, ok = nobody.len == 0 and lib.stats.unknown == unknown + 1, what = "a handle that names no face gives nothing and is counted" }
    let empty = shape{ provider, face, pixels = 16, text = "", out = out[..] }
    ui_test::expect{ &io, &t, ok = empty.len == 0, what = "an empty text has no glyphs" }
    // An output shorter than the glyphs: filled, and the count is its length.
    let short = shape{ provider, face, pixels = 16, text = "twelve chars", out = out[..5] }
    ui_test::expect{ &io, &t, ok = short.len == 5, what = "an output shorter than the run is filled" }
}

// The core's walks over a real font: caret offsets and wrapping, at 16 pixels and at 24, which is
// what 16 logical units are at scales 1 and 1.5. The face is shaped at the pixel size itself, so
// the 24 pixel text is the font's own 24 pixel shaping, not the 16 pixel one stretched.
//
// What leaves a shaped run is whole pixels. A measured width is the advances rounded up; a caret
// offset is the advances before it rounded to the nearest pixel. So the offsets never go down, the
// last one is the measured width or the pixel before it, and no wrapped line is wider than the
// limit, in whole pixels, with no tolerance.
fn check_text { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, mut lib: ui_fonts::Library, provider: ui::TextProvider, face: ui_fonts::Face } {
    let line = "Typography: AV Wa To office ffl, 0123 \xC3\xA9t\xC3\xA9 \xE2\x80\x94 done."
    let paragraph = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs; how vexingly quick daft zebras jump! A well-known, rather extraordinarily long word: incomprehensibilities."
    let sizes: [2]i32 = [16, 24]
    let limits: [2]i32 = [180, 270]
    for size at which in sizes {
        let mut m = make_measure{ &heap, lib, face } iferr {
            ui_test::expect{ &io, &t, ok = false, what = "a draw list for measuring" }
            return
        }
        let font = ui::Font{ index = 0 }
        let width = measure{ &m, provider, size, text = line }
        let sum = sum_width{ &m, provider, size, text = line }
        let mut index: usize = 0
        let mut last: i32 = 0
        let mut monotonic = true
        let mut steps: u32 = 0
        while index < line.len {
            let next = ui::text::step_caret{ cache = &m.cache, list = m.list, provider, font, size, text = line, index, forward = true }
            if next <= index {
                monotonic = false
                break
            }
            let x = ui::text::locate_caret{ cache = &m.cache, list = m.list, provider, font, size, text = line, index = next }
            if x < last { monotonic = false }
            last = x
            index = next
            steps = steps + 1
        }
        _ = @fmt(&io, "size {}: caret took {} steps over {} bytes, ends at {} of a measured {} (advances {})\n", size, steps, line.len, last, width, write_number{ v = sum, _ })
        ui_test::expect{ &io, &t, ok = monotonic and steps > 0 and steps < @as(u32, line.len), what = "caret offsets in a shaped string are whole pixels that never go down, stepping by clusters" }
        ui_test::expect{ &io, &t, ok = width == ui::text::ceil_width{ v = sum } and last == ui::round_pixels{ v = sum }, what = "the measured width is the advances rounded up, the last caret offset the advances rounded to the nearest pixel" }
        ui_test::expect{ &io, &t, ok = last <= width and last >= width - 1, what = "the last caret offset is the measured width or the pixel before it, never past it" }
        let picked = ui::text::pick_index{ cache = &m.cache, list = m.list, provider, font, size, text = line, x = width + 5 }
        ui_test::expect{ &io, &t, ok = picked == line.len, what = "the index right of the line is its end" }
        let first = ui::text::locate_caret{ cache = &m.cache, list = m.list, provider, font, size, text = line, index = 0 }
        ui_test::expect{ &io, &t, ok = first == 0 and ui::text::pick_index{ cache = &m.cache, list = m.list, provider, font, size, text = line, x = 0 } == 0, what = "the caret before the line is at pixel 0, and pixel 0 picks it" }

        let limit = limits[which]
        let mut lines: [32]ui::text::Line
        let wrapped = ui::text::wrap_text{ cache = &m.cache, list = m.list, provider, font, size, text = paragraph, width = limit, lines = lines[..] }
        let mut fits = true
        let mut whole = true
        let mut widest: i32 = 0
        for l in lines[..@as(usize, wrapped.lines)] {
            let w = measure{ &m, provider, size, text = paragraph[@as(usize, l.start)..@as(usize, l.end)] }
            if l.width > limit or w > limit { fits = false }
            // A line's width is what measuring its bytes alone gives, up to the kerning across the
            // break, which a line shaped with its neighbour may have and the line alone has not.
            if l.width > w + 2 or w > l.width + 2 { whole = false }
            if w > widest { widest = w }
        }
        _ = @fmt(&io, "size {}: the paragraph wraps to {} lines at {}, the widest {}\n", size, wrapped.lines, limit, widest)
        ui_test::expect{ &io, &t, ok = wrapped.lines >= 5 and @as(usize, wrapped.rest) == paragraph.len and fits,
            what = "a paragraph wrapped in the real font has no line wider than the limit, in whole pixels" }
        ui_test::expect{ &io, &t, ok = whole and wrapped.width <= limit and wrapped.width == widest_of{ lines = lines[..@as(usize, wrapped.lines)] }, what = "each line's width is a whole number of pixels, and the widest is reported" }
        ui_test::expect{ &io, &t, ok = m.cache.unknown_font == 0 and m.cache.no_provider == 0, what = "the core measured with the provider" }
        let box = ui::text::get_line_metrics{ cache = &m.cache, list = m.list, provider, font, size }
        let raw = provider.metrics{ state = provider.state, handle = face.id, pixels = ui::text::get_pixel_size{ size } }
        ui_test::expect{ &io, &t, ok = @as(f32, box.height) >= raw.height - 0.001 and @as(f32, box.height) < raw.height + 1.0 and ui::abs_f32{ x = @as(f32, box.ascent) - raw.ascent } <= 0.5,
            what = "a line's height is the face's rounded up, its ascent the face's to the nearest pixel" }
    }
}

fn widest_of { lines: []ui::text::Line } -> i32 {
    let mut widest: i32 = 0
    for l in lines { if l.width > widest { widest = l.width } }
    return widest
}

// A Ui with the face registered by make_font measures through its provider, in pixels, at the
// pixel size a logical size comes to at the frame's scale.
fn check_ui { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, mut lib: ui_fonts::Library, provider: ui::TextProvider, face: ui_fonts::Face } {
    let mut ui = ui::make{ realloc = arena::alloc, &heap, cap = ui::Capacity{ elements = 64, text = 4096, cmds = 256, hits = 64, states = 16, nodes = 64, lines = 64, .. } } iferr {
        ui_test::expect{ &io, &t, ok = false, what = "a Ui" }
        return
    }
    let font = ui_fonts::make_font{ &lib, &ui, face } ifnull {
        ui_test::expect{ &io, &t, ok = false, what = "make_font registers the face with a Ui" }
        return
    }
    ui::set_provider{ &ui, provider }
    ui::begin_frame{ &ui, frame = ui::FrameInfo{ width = 320, height = 200, scale = 1.0, dt = 0.016 } }
    let w = ui::measure_text{ &ui, font, size = 16, text = "Settings" }
    ui::end_frame{ &ui }
    ui_test::expect{ &io, &t, ok = w > 40 and w < 90 and ui.stats.problems == 0, what = "make_font registers the face, and a Ui measures text in it" }

    // At scale 1.5 a text of 16 logical units is recorded at 24 pixels: the element is as wide
    // and as high as the face's own 24 pixel text, in whole pixels.
    let label = ui::make_id{ ui, name = "label" }
    ui::begin_frame{ &ui, frame = ui::FrameInfo{ width = 480, height = 300, scale = 1.5, dt = 0.016 } }
    let size = ui::to_font_size{ ui, size = 16.0 }
    let wide = ui::measure_text{ &ui, font, size, text = "Settings" }
    let line = ui::measure_line{ &ui, font, size }
    let el = ui::begin_element{ &ui, id = label, axis = ui::Axis::row, box = ui::Box{ .. } }
    ui::add_text{ &ui, text = "Settings", style = ui::TextStyle{ font, size = 16.0, .. }, box = ui::Box{ .. } }
    ui::end{ &ui, scope = el }
    ui::end_frame{ &ui }
    let rect = ui::get_rect{ ui, id = label } ifnull ui::Rect{ .. }
    ui_test::expect{ &io, &t, ok = size == 24 and wide > w and rect.w == wide and rect.h == line.height and ui.stats.problems == 0, what = "at scale 1.5 a text of 16 units is the face's 24 pixel text, sized in whole pixels" }
}

// With a CJK face as fallback, a line mixing Latin and CJK comes back as runs of two sized faces.
fn check_fallback { mut io: Io, mut t: ui_test::Tally, mut lib: ui_fonts::Library, provider: ui::TextProvider, face: ui_fonts::Face, cjk: []u8 } -> ! {
    let mixed = "Hello \xE4\xB8\x96\xE7\x95\x8C and \xE6\x97\xA5\xE6\x9C\xAC\xE8\xAA\x9E!"     // Hello 世界 and 日本語!
    let mut out: [64]ui::Shaped
    let missing = lib.stats.missing
    let alone = shape{ provider, face, pixels = 24, text = mixed, out = out[..] }
    _ = @fmt(&io, "without a fallback: {} glyphs, {} of them missing\n", alone.len, lib.stats.missing - missing)
    let other = try ui_fonts::add_face{ &lib, data = cjk, index = 0 }
    ui_fonts::add_fallback{ &lib, face = other }
    let missing_after = lib.stats.missing
    let g = shape{ provider, face, pixels = 24, text = mixed, out = out[..] }
    let first = g[0].face
    let mut second: u32 = 0
    let mut runs: u32 = 1
    let mut cjk_ok = true
    for s at i in g {
        if i > 0 and s.face != g[i - 1].face { runs = runs + 1 }
        if s.face != first { second = s.face }
        let at = @as(usize, s.cluster)
        let wide = mixed[at] >= 0xE0
        if wide == (s.face == first) { cjk_ok = false }
    }
    _ = @fmt(&io, "with the fallback: {} glyphs in {} runs from faces {} and {}\n", g.len, runs, first, second)
    ui_test::expect{ &io, &t, ok = second != 0 and runs == 5 and cjk_ok, what = "a line mixing Latin and CJK comes back as runs from two faces, each character from the face that has it" }
    ui_test::expect{ &io, &t, ok = lib.stats.missing == missing_after and has_good_clusters{ glyphs = g, len = mixed.len }, what = "no character is missing with the fallback, and the clusters hold" }
    let size = ui_fonts::find_size{ lib, id = second } ifnull { return ui_fonts::closed }
    ui_test::expect{ &io, &t, ok = lib.sizes[size].face == other.id and lib.sizes[size].pixels == 24, what = "the fallback's glyphs are of its own variant at the same pixel size" }
    // The fallback's glyphs rasterise; release it and the face shapes alone again.
    let mut pixels: [65536]u8
    let mut bitmap = ui::GlyphBitmap{ pixels = pixels[..], width = 0, height = 0, left = 0, top = 0 }
    let mut drew = false
    for s in g { if s.face == second and not drew { drew = provider.rasterize{ state = provider.state, face = s.face, glyph = s.glyph, out = &bitmap } and bitmap.width > 0 } }
    ui_test::expect{ &io, &t, ok = drew, what = "a fallback glyph rasterises" }
    ui_fonts::release_face{ &lib, face = other }
    let back = shape{ provider, face, pixels = 24, text = mixed, out = out[..] }
    let mut one = true
    for s in back { if s.face != first { one = false } }
    ui_test::expect{ &io, &t, ok = lib.fallback_count == 0 and one, what = "a released fallback is no longer tried" }
}

// Releasing a face frees its glyphs: its sized faces' glyphs leave the staged level's cache, and
// their atlas room is free again after the quarantine.
fn check_release { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, mut lib: ui_fonts::Library, provider: ui::TextProvider, latin: []u8 } -> ! {
    let face = try ui_fonts::add_face{ &lib, data = latin, index = 0 }
    let mut list = try ui::draw::make{ realloc = arena::alloc, &heap, cmds = 64, text = 4096, clips = 4, fonts = 4 }
    let mut staged = try ui_stage::make{ realloc = arena::alloc, &heap, cap = ui_stage::Capacity{
        rects = 64, glyphs = 1024, images = 16, shapes = 16, draws = 64, passes = 2,
        atlas_width = 256, atlas_height = 256, atlas_max_height = 512, glyph_cache = 512, raster_bytes = 65536 } }
    let def = ui_fonts::describe_face{ lib, face } ifnull { return ui_fonts::closed }
    ui::draw::reset{ &list, width = 320, height = 120 }
    let font = ui::draw::add_font{ &list, font = def } ifnull { return ui_fonts::closed }
    ui::draw::add_text{ &list, font, size = 16, x = 4, y = 4, text = "Release me", color = ui::Color{ r = 255, g = 255, b = 255, .. }, clip = 0 }
    ui::draw::add_text{ &list, font, size = 24, x = 4, y = 40, text = "and me too", color = ui::Color{ r = 255, g = 255, b = 255, .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    let cached = staged.cache_used
    ui_test::expect{ &io, &t, ok = staged.dropped == 0 and staged.glyph_count > 10 and cached > 10, what = "text in the face stages, its glyphs cached in the atlas" }
    let mut ids: [8]u32
    let n = ui_fonts::list_sizes{ lib, face, out = ids[..] }
    ui_test::expect{ &io, &t, ok = n == 2, what = "the face has a sized variant for each pixel size drawn" }
    for id in ids[..n] { ui_stage::release_face{ out = &staged, face = id } }
    let sizes_before = lib.live.ft_sizes
    ui_fonts::release_face{ &lib, face }
    ui_test::expect{ &io, &t, ok = staged.cache_used == 0 and staged.packer.held_count > 0, what = "releasing the face takes its glyphs out of the glyph cache" }
    ui_test::expect{ &io, &t, ok = lib.live.ft_sizes + 2 == sizes_before and ui_fonts::find_face{ lib, id = face.id } == null, what = "releasing the face releases its sized variants" }
    ui::draw::reset{ &list, width = 320, height = 120 }
    for _ in 0..5 { ui_stage::stage{ out = &staged, list = &list, provider } }
    ui_test::expect{ &io, &t, ok = staged.packer.held_count == 0 and staged.packer.freed_count > 0, what = "after the quarantine the released glyphs' atlas room is free to take" }
    // Text still naming the released face: nothing drawn, counted by the provider, no panic.
    let unknown = lib.stats.unknown
    _ = ui::draw::add_font{ &list, font = def }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16, x = 4, y = 4, text = "gone", color = ui::Color{ r = 255, g = 255, b = 255, .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    ui_test::expect{ &io, &t, ok = staged.glyph_count == 0 and lib.stats.unknown > unknown, what = "text in a released face draws nothing and is counted" }
}

// A run cache with room for four runs: generations retire, and what comes back is still right.
fn check_small_cache { mut io: Io, mut fonts: ui_fonts::Fonts, mut t: ui_test::Tally, mut heap: arena::Arena, latin: []u8 } {
    let mut lib = ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ faces = 2, sizes = 2, runs = 4, run_bytes = 64, run_glyphs = 64, scratch = 24 } } iferr {
        ui_test::expect{ &io, &t, ok = false, what = "a small library opens" }
        return
    }
    let face = ui_fonts::add_face{ &lib, data = latin, index = 0 } iferr {
        ui_test::expect{ &io, &t, ok = false, what = "a face loads into a small library" }
        ui_fonts::close{ &lib }
        return
    }
    let provider = ui_fonts::get_provider{ lib = &lib }
    let words: [10][]u8 = ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"]
    let mut first: [32]ui::Shaped
    let a = shape{ provider, face, pixels = 16, text = words[0], out = first[..] }
    let mut out: [32]ui::Shaped
    for w in words { _ = shape{ provider, face, pixels = 16, text = w, out = out[..] } }
    let again = shape{ provider, face, pixels = 16, text = words[0], out = out[..] }
    ui_test::expect{ &io, &t, ok = lib.stats.retired > 0 and is_same_glyphs{ a, b = again }, what = "a full run cache retires a generation, and runs shape the same after" }
    // More glyphs than a generation holds: shaped each time, counted.
    let long = "a run of text that has more glyphs than one generation keeps"
    let truncated = lib.stats.truncated
    let cut = shape{ provider, face, pixels = 16, text = long, out = out[..] }
    ui_test::expect{ &io, &t, ok = cut.len == 24 and lib.stats.truncated == truncated + 1, what = "glyphs past the scratch buffer are cut and counted" }
    let mut m_ok = true
    let mut list = ui::draw::make{ realloc = arena::alloc, &heap, cmds = 4, text = 256, clips = 2, fonts = 2 } iferr {
        ui_test::expect{ &io, &t, ok = false, what = "a draw list" }
        return
    }
    ui::draw::reset{ &list, width = 640, height = 480 }
    let def = ui_fonts::describe_face{ lib, face } ifnull { return }
    _ = ui::draw::add_font{ &list, font = def }
    let mut cache = ui::text::make_cache{ realloc = arena::alloc, &heap, entries = 16, shaped = 16 } iferr { return }
    let whole = ui::text::sum_text{ &cache, list, provider, font = ui::Font{ index = 0 }, size = 16, text = long }
    let mut bigger: [128]ui::Shaped
    let mut full = ui_fonts::open{ &fonts, realloc = arena::alloc, &heap, cap = ui_fonts::Capacity{ .. } } iferr { return }
    let full_face = ui_fonts::add_face{ lib = &full, data = latin, index = 0 } iferr { return }
    let full_provider = ui_fonts::get_provider{ lib = &full }
    let reference = sum_advances{ glyphs = shape{ provider = full_provider, face = full_face, pixels = 16, text = long, out = bigger[..] } }
    if ui::abs_f32{ x = whole - reference } > 0.01 { m_ok = false }
    if ui::text::measure_text{ &cache, list, provider, font = ui::Font{ index = 0 }, size = 16, text = long } != ui::text::ceil_width{ v = reference } { m_ok = false }
    _ = @fmt(&io, "a long text measured in pieces: {}, shaped whole: {}\n", write_number{ v = whole, _ }, write_number{ v = reference, _ })
    ui_test::expect{ &io, &t, ok = m_ok, what = "the core shapes a text longer than its buffer in pieces, to the same width" }
    // 22 em dashes: 22 glyphs, which the scratch buffer holds, in 66 bytes, more than a generation
    // keeps: shaped every time, and counted.
    let mut dashes: [66]u8
    for i in 0..22 {
        dashes[i * 3] = 0xE2
        dashes[i * 3 + 1] = 0x80
        dashes[i * 3 + 2] = 0x94
    }
    let uncached = lib.stats.uncached
    let shaped = lib.stats.shaped
    let d1 = shape{ provider, face, pixels = 16, text = dashes[..], out = out[..] }
    let d2 = shape{ provider, face, pixels = 16, text = dashes[..], out = bigger[..] }
    ui_test::expect{ &io, &t, ok = d1.len == 22 and is_same_glyphs{ a = d1, b = d2 } and lib.stats.uncached == uncached + 2 and lib.stats.shaped == shaped + 2,
        what = "a run too big for the run cache is shaped each time, and counted" }
    ui_fonts::close{ lib = &full }
    ui_fonts::close{ &lib }
}
