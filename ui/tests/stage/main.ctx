// Stage 2's test: the staged level. Instances, the flip into canvas space, the clip table, the atlas
// and the glyph cache, overlap-aware batching, passes, the revision, overflow, and the dump of a
// Staged. Outline text goes through a fake provider that rasterises boxes. The batching invariant is
// also checked directly on randomly generated lists (a fixed seed).
//
//   kotor/tools/ctxc run ui/tests/stage                 (from the repository root)
//   kotor/tools/ctxc run ui/tests/stage -- --update     rewrite the goldens after an intended change
//
// Writes the atlas to ui/out/stage-atlas.png (ignored by git) to look at. Exits 1 when any check fails.

const GOLDEN_DIR: []u8 = "ui/tests/stage/golden"
const ATLAS_PNG: []u8 = "ui/out/stage-atlas.png"

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, args: Args } -> i32 {
    let mut t = ui_test::Tally{ run = 0, failed = 0 }
    let buf = mem::pages{ &mem, size = 268435456 } ifnull { return 1 }
    let mut heap = arena::new{ buf }
    let update = ui_test::has_flag{ args, flag = "--update" }
    let font = ui_test::make_test_font{ realloc = arena::alloc, &heap } iferr { return 1 }
    let mut fake = Fake{ shapes = 0, rasters = 0 }
    let provider: ?ui::TextProvider = ui::TextProvider{ state = @cast(*mut ui::Opaque, &fake), metrics = fake_metrics, shape = fake_shape, rasterize = fake_raster }

    check_golden_list{ &io, &fs, &t, &heap, font, update }
    check_flip{ &io, &t, &heap, font }
    check_buttons{ &io, &t, &heap, font }
    check_overlap{ &io, &fs, &t, &heap, font, update }
    check_textures{ &io, &t, &heap }
    check_host{ &io, &fs, &t, &heap, font, update }
    check_quarter{ &io, &t, &heap }
    check_revision{ &io, &t, &heap, font }
    check_cache{ &io, &t, &heap, font, provider, fake = &fake }
    check_release{ &io, &t, &heap, font, provider }
    check_growth{ &io, &t, &heap, font }
    check_limit{ &io, &t, &heap, font }
    check_overflow{ &io, &t, &heap, font }
    check_random{ &io, &t, &heap, font }
    write_atlas{ &io, &fs, &t, &heap, font, provider }

    _ = @fmt(&io, "ui/tests/stage: {} checks, {} failed\n", t.run, t.failed)
    io::flush{ &io }
    return if t.failed == 0 { 0 } else { 1 }
}

// ---- the fake outline provider: one glyph a byte, `pixels / 2` apart, each a box

struct Fake { shapes: u32, rasters: u32 }

fn fake_metrics { mut state: ui::Opaque, handle: u32, pixels: u32 } -> ui::LineMetrics {
    return ui::LineMetrics{ height = @as(f32, pixels) * 1.25 + @as(f32, handle) * 0.0, ascent = @as(f32, pixels) * 0.75 }
}

// A sized face is the handle and the pixel size together.
fn fake_shape { mut state: ui::Opaque, handle: u32, pixels: u32, text: []u8, out: []mut ui::Shaped } -> usize {
    let fake = @cast(*mut Fake, &state)
    fake.shapes = fake.shapes + 1
    let mut n: usize = 0
    while n < text.len and n < out.len {
        out[n] = ui::Shaped{ glyph = @as(u32, text[n]), face = handle * 1000 + pixels, x_advance = @as(f32, pixels) * 0.5, cluster = @as(u32, n), .. }
        n = n + 1
    }
    return n
}

// A box 3 + glyph % 5 wide and 6 + glyph % 4 high sitting on the baseline, its edge solid and its
// inside half covered, with a diagonal so its rows can be told apart. A space has no ink.
fn fake_raster { mut state: ui::Opaque, face: u32, glyph: u32, mut out: ui::GlyphBitmap } -> bool {
    let fake = @cast(*mut Fake, &state)
    fake.rasters = fake.rasters + 1
    if glyph == 32 {
        out.width = 0
        out.height = 0
        out.left = 0
        out.top = 0
        return true
    }
    let w = 3 + glyph % 5 + face * 0
    let h = 6 + glyph % 4
    if @as(usize, w * h) > out.pixels.len { return false }
    let mut y: u32 = 0
    while y < h {
        let mut x: u32 = 0
        while x < w {
            let edge = x == 0 or y == 0 or x == w - 1 or y == h - 1
            out.pixels[@as(usize, y * w + x)] = if edge or x == y { 255 } else { 96 }
            x = x + 1
        }
        y = y + 1
    }
    out.width = w
    out.height = h
    out.left = 1
    out.top = @as(i32, h)
    return true
}

// ---- helpers

fn make_rect { x: f32, y: f32, w: f32, h: f32 } -> ui::Rect {
    return ui::Rect{ x, y, w, h }
}

fn is_near { a: f32, b: f32 } -> bool {
    return ui::abs_f32{ x = a - b } < 0.001
}

// A list of `width` by `height` at `scale` with the test font registered as font 0.
fn make_list { mut heap: arena::Arena, font: ui::FontDef, width: f32, height: f32, scale: f32, cmds: u32 } -> !ui::DrawList {
    let mut list = try ui::draw::make{ realloc = arena::alloc, &heap, cmds, text = cmds * 16 + 1024, clips = 300, fonts = 4 }
    ui::draw::reset{ &list, width, height, scale_x = scale, scale_y = scale }
    _ = ui::draw::add_font{ &list, font }
    return list
}

fn make_staged { mut heap: arena::Arena, cap: ui_stage::Capacity } -> !ui_stage::Staged {
    return try ui_stage::make{ realloc = arena::alloc, &heap, cap }
}

// A small Staged for most checks: a 128 by 64 atlas that may grow to 256.
fn make_small { mut heap: arena::Arena } -> !ui_stage::Staged {
    return try make_staged{ &heap, cap = ui_stage::Capacity{ rects = 1024, glyphs = 4096, images = 1024, shapes = 256, draws = 256, passes = 8,
        atlas_width = 128, atlas_height = 64, atlas_max_height = 256, glyph_cache = 512, raster_bytes = 4096 } }
}

fn fill { color: ui::Color } -> ui::RectStyle {
    return ui::RectStyle{ fill = color, .. }
}

fn add_picture { mut list: ui::DrawList, rect: ui::Rect, image: u32, blend: ui::Blend } {
    ui::draw::add_image{ &list, rect, region = ui::Region{ image = ui::Image{ id = image, width = 64.0, height = 64.0 }, .. },
        tint = ui::Color{ r = 255, g = 255, b = 255, .. }, quarter = 0, angle = 0.0, radius = ui::Corners{ .. }, blend, clip = 0 }
}

fn dump { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, staged: *ui_stage::Staged, name: []u8, update: bool } {
    let out = alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 65536 } iferr { return }
    let scratch = alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = 65536 } iferr { return }
    let mut sink = ui_rec::make_sink{ bytes = out }
    ui_rec::write_staged{ &sink, staged } iferr {
        ui_test::expect{ &io, &t, ok = false, what = "write the staged dump" }
        return
    }
    ui_test::expect{ &io, &t, ok = sink.lost == 0, what = "the staged dump fit its buffer" }
    ui_test::compare_golden{ &io, &fs, &t, dir = GOLDEN_DIR, name, actual = ui_rec::get_text{ sink }, scratch, update }
}

// ---- the stage 0 list, every field of every instance

fn check_golden_list { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef, update: bool } {
    let mut list = make_list{ &heap, font, width = 800.0, height = 600.0, scale = 1.5, cmds = 64 } iferr { return }
    let panel_rect = make_rect{ x = 16.0, y = 16.0, w = 400.0, h = 300.0 }
    let rounded = ui::draw::add_clip{ &list, clip = ui::Clip{ rect = panel_rect, round = panel_rect, radius = 8.0 } } ifnull { return }
    let plain = ui::draw::add_clip{ &list, clip = ui::Clip{ rect = make_rect{ x = 100.0, y = 100.0, w = 200.0, h = 150.0 }, .. } } ifnull { return }
    let fraction = ui::draw::add_clip{ &list, clip = ui::Clip{ rect = make_rect{ x = 8.5, y = 8.5, w = 64.0, h = 32.0 }, .. } } ifnull { return }

    let ink = ui::Color{ r = 0xE4, g = 0xE7, b = 0xED, .. }
    let border = ui::Color{ r = 0x40, g = 0x45, b = 0x52, .. }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 16.0, y = 16.0, w = 120.0, h = 28.0 }, clip = rounded, style = ui::RectStyle{
        fill = ui::Color{ r = 0x30, g = 0x34, b = 0x3E, .. },
        radius = ui::Corners{ top_left = 4.0, top_right = 4.0, .. },
        border = ui::Sides{ top = 1.0, right = 1.0, left = 1.0, .. },
        border_color = ui::SideColors{ top = border, right = border, left = border, .. },
    } }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 200.0, y = 40.0, w = 24.0, h = 24.0 }, clip = rounded, style = ui::RectStyle{
        fill = ui::Color{ r = 0x4A, g = 0x90, b = 0xE2, .. }, radius = ui::round{ radius = 12.0 }, .. } }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 240.0, y = 40.0, w = 24.0, h = 24.0 }, clip = rounded, style = ui::RectStyle{
        radius = ui::round{ radius = 12.0 }, border = ui::stroke{ width = 2.0 }, border_color = ui::color_sides{ color = ink }, .. } }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 24.0, y = 22.0, text = "Add", color = ink, clip = rounded }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 12.5, x = 24.5, y = 60.25, text = "Say \"hi\"", color = ui::Color{ r = 0x4A, g = 0x90, b = 0xE2, .. }, clip = plain }
    ui::draw::add_image{ &list, rect = make_rect{ x = 10.0, y = 10.0, w = 32.0, h = 32.0 }, region = ui::Region{ image = ui::Image{ id = 3, width = 32.0, height = 32.0 }, width = 32.0, height = 32.0, .. },
        tint = ui::Color{ r = 255, g = 255, b = 255, .. }, quarter = 1, angle = 0.0, radius = ui::Corners{ .. }, blend = ui::Blend::alpha, clip = 0 }
    ui::draw::add_image{ &list, rect = make_rect{ x = 100.5, y = 120.25, w = 64.0, h = 48.0 },
        region = ui::Region{ image = ui::Image{ id = 7, width = 256.0, height = 256.0 }, uv = ui::Uv{ u0 = 0.25, v0 = 0.125, u1 = 0.75, v1 = 0.5 }, width = 128.0, height = 96.0 },
        tint = ui::Color{ r = 0x80, g = 0xFF, b = 0x80, a = 0xC0 }, quarter = 0, angle = 0.5, radius = ui::round{ radius = 4.0 }, blend = ui::Blend::additive, clip = plain }
    ui::draw::add_line{ &list, x0 = 40.0, y0 = 60.0, x1 = 52.0, y1 = 72.0, width = 2.0, color = ink, cap = ui::Cap::round, clip = 0 }
    ui::draw::add_line{ &list, x0 = 10.5, y0 = 20.25, x1 = 30.0, y1 = 0.5, width = 1.5, color = ui::Color{ r = 255, .. }, cap = ui::Cap::butt, clip = fraction }
    ui::draw::add_line{ &list, x0 = 0.0, y0 = 0.0, x1 = 5.0, y1 = 5.0, width = 1.0, color = ui::Color{ a = 0x80, .. }, cap = ui::Cap::square, clip = 0 }
    ui::draw::add_host{ &list, slot = 1, rect = make_rect{ x = 320.0, y = 60.0, w = 280.0, h = 360.0 } }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 330.0, y = 70.0, w = 20.0, h = 20.0 }, clip = 0, style = ui::RectStyle{ fill = ui::Color{ r = 255, g = 0, b = 255, .. }, .. } }
    ui_test::expect{ &io, &t, ok = list.count == 12 and list.dropped == 0, what = "the stage 0 list was built" }

    let mut staged = make_staged{ &heap, cap = ui_stage::Capacity{ rects = 64, glyphs = 64, images = 64, shapes = 64, draws = 64, passes = 4,
        atlas_width = 64, atlas_height = 32, atlas_max_height = 64, glyph_cache = 64, raster_bytes = 1024 } } iferr { return }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.dropped == 0, what = "the stage 0 list stages with nothing dropped" }
    ui_test::expect{ &io, &t, ok = staged.pixel_width == 1200.0 and staged.pixel_height == 900.0 and staged.width == 800.0 and staged.height == 600.0, what = "the canvas is the list's size, 1200 by 900 pixels at 1.5" }

    // Radii tl, tr, br, bl and borders top, right, bottom, left arrive in the shader's order.
    let r = staged.rects[0]
    ui_test::expect{ &io, &t, ok = r.radius_tl == 4.0 and r.radius_tr == 4.0 and r.radius_br == 0.0 and r.radius_bl == 0.0, what = "radii arrive tl, tr, br, bl" }
    ui_test::expect{ &io, &t, ok = r.border_top == 1.0 and r.border_right == 1.0 and r.border_bottom == 0.0 and r.border_left == 1.0, what = "borders arrive top, right, bottom, left" }
    ui_test::expect{ &io, &t, ok = r.color_bottom == 0 and r.color_top == 0xFF404552 and r.fill == 0xFF30343E, what = "colours are packed ARGB" }
    ui_test::expect{ &io, &t, ok = r.y == 600.0 - 16.0 - 28.0, what = "a rectangle's canvas y is its distance from the bottom" }

    // The rounded clip fills all three rows of its slot.
    let c = staged.clips[1]
    ui_test::expect{ &io, &t, ok = c.left == 16.0 and c.bottom == 284.0 and c.right == 416.0 and c.top == 584.0, what = "a clip's first row is left, bottom, right, top" }
    ui_test::expect{ &io, &t, ok = c.round_left == 16.0 and c.round_bottom == 284.0 and c.round_right == 416.0 and c.round_top == 584.0, what = "a rounded clip's second row is its rounded rectangle" }
    ui_test::expect{ &io, &t, ok = c.radius == 8.0, what = "a rounded clip's third row is its radius" }
    let p = staged.clips[2]
    ui_test::expect{ &io, &t, ok = p.radius == 0.0 and p.round_right == 0.0, what = "a plain clip has no rounded rectangle" }
    dump{ &io, &fs, &t, &heap, staged = &staged, name = "list", update }
}

// A rectangle at the top left of a 100-high list has canvas y 90; a line's ends flip the same way.
fn check_flip { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef } {
    let mut list = make_list{ &heap, font, width = 100.0, height = 100.0, scale = 1.0, cmds = 8 } iferr { return }
    let mut staged = make_small{ &heap } iferr { return }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 10.0, h = 10.0 }, style = fill{ color = ui::Color{ r = 1, .. } }, clip = 0 }
    ui::draw::add_line{ &list, x0 = 10.0, y0 = 20.0, x1 = 30.0, y1 = 40.0, width = 2.0, color = ui::Color{ .. }, cap = ui::Cap::square, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 0.0, text = "A", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    let r = staged.rects[0]
    ui_test::expect{ &io, &t, ok = r.x == 0.0 and r.y == 90.0 and r.w == 10.0 and r.h == 10.0, what = "a rectangle at the top left of a 100-high list has canvas y 90" }
    let s = staged.shapes[0]
    ui_test::expect{ &io, &t, ok = s.data[0] == 10.0 and s.data[1] == 80.0 and s.data[2] == 30.0 and s.data[3] == 60.0, what = "a line's end points flip" }
    // Square cap: half 1, padded by 1 + 1.5 + 1.
    ui_test::expect{ &io, &t, ok = s.x == 6.5 and s.y == 56.5 and s.w == 27.0 and s.h == 27.0 and s.flags == 2 and s.kind == 2 and s.half_width == 1.0, what = "a square-capped line's box is padded by half its width twice and 1.5" }
    let g = staged.glyphs[0]
    ui_test::expect{ &io, &t, ok = g.x == 0.0 and g.y == 84.0 and g.w == 8.0 and g.h == 16.0, what = "a glyph at the top left of a 100-high list has canvas y 84" }
    ui_test::expect{ &io, &t, ok = g.uw * 128.0 == 8.0 and g.vh * 64.0 == 16.0, what = "a glyph's UV covers its 8 by 16 texels of the atlas" }
}

// ---- batching

// 200 buttons side by side, a rectangle and a text each, stage to two draws.
fn check_buttons { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef } {
    let mut list = make_list{ &heap, font, width = 8000.0, height = 100.0, scale = 1.0, cmds = 512 } iferr { return }
    let mut staged = make_small{ &heap } iferr { return }
    let mut i: u32 = 0
    while i < 200 {
        let x = @as(f32, i) * 40.0
        ui::draw::add_rect{ &list, rect = make_rect{ x, y = 10.0, w = 40.0, h = 24.0 }, style = ui::RectStyle{ fill = ui::Color{ r = 0x30, .. }, radius = ui::round{ radius = 4.0 }, .. }, clip = 0 }
        ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = x + 8.0, y = 14.0, text = "OK", color = ui::Color{ r = 255, g = 255, b = 255, .. }, clip = 0 }
        i = i + 1
    }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.dropped == 0 and staged.rect_count == 200 and staged.glyph_count == 400, what = "200 buttons stage 200 rectangles and 400 glyphs" }
    ui_test::expect{ &io, &t, ok = staged.draw_count == 2 and staged.pass_count == 1, what = "200 buttons side by side stage to 2 draws" }
    ui_test::expect{ &io, &t, ok = staged.draws[0].kind == ui_stage::Kind::rect and staged.draws[0].count == 200 and staged.draws[1].kind == ui_stage::Kind::glyph and staged.draws[1].count == 400,
        what = "the rectangles are drawn first, then the glyphs" }
}

// A rectangle recorded between two texts and overlapping the first forces a third draw.
fn check_overlap { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef, update: bool } {
    let mut list = make_list{ &heap, font, width = 200.0, height = 100.0, scale = 1.0, cmds = 16 } iferr { return }
    let mut staged = make_small{ &heap } iferr { return }
    // Without the overlap: a panel, a text, a rectangle beside it, a text. The rectangle joins the panel's draw.
    ui::draw::add_rect{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 200.0, h = 100.0 }, style = fill{ color = ui::Color{ r = 0x10, .. } }, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 10.0, y = 10.0, text = "AB", color = ui::Color{ r = 0xA0, .. }, clip = 0 }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 60.0, y = 10.0, w = 20.0, h = 20.0 }, style = fill{ color = ui::Color{ g = 0xA0, .. } }, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 10.0, y = 60.0, text = "CD", color = ui::Color{ b = 0xA0, .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.draw_count == 2, what = "a rectangle that overlaps no text joins the panel's draw: 2 draws" }

    // The same with the rectangle over the first text: a third draw, after the glyphs.
    ui::draw::reset{ &list, width = 200.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 200.0, h = 100.0 }, style = fill{ color = ui::Color{ r = 0x10, .. } }, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 10.0, y = 10.0, text = "AB", color = ui::Color{ r = 0xA0, .. }, clip = 0 }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 20.0, y = 14.0, w = 20.0, h = 20.0 }, style = fill{ color = ui::Color{ g = 0xA0, .. } }, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 10.0, y = 60.0, text = "CD", color = ui::Color{ b = 0xA0, .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.draw_count == 3, what = "a rectangle over the first text forces a third draw" }
    ui_test::expect{ &io, &t, ok = staged.draws[0].kind == ui_stage::Kind::rect and staged.draws[0].count == 1 and staged.draws[1].kind == ui_stage::Kind::glyph
        and staged.draws[1].count == 4 and staged.draws[2].kind == ui_stage::Kind::rect and staged.draws[2].count == 1, what = "panel, then both texts, then the rectangle over the first" }
    dump{ &io, &fs, &t, &heap, staged = &staged, name = "overlap", update }
}

// The number of draws `order` (a string of '1', '2', 'a': texture 1, texture 2, texture 1 additive)
// stages to, the pictures side by side so none overlaps another.
fn count_picture_draws { mut list: ui::DrawList, mut staged: ui_stage::Staged, order: []u8 } -> u32 {
    ui::draw::reset{ &list, width = 1000.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    let mut i: usize = 0
    while i < order.len {
        let rect = make_rect{ x = @as(f32, i) * 20.0, y = 10.0, w = 16.0, h = 16.0 }
        let c = order[i]
        if c == '1' { add_picture{ &list, rect, image = 1, blend = ui::Blend::alpha } }
        if c == '2' { add_picture{ &list, rect, image = 2, blend = ui::Blend::alpha } }
        if c == 'a' { add_picture{ &list, rect, image = 1, blend = ui::Blend::additive } }
        i = i + 1
    }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    return staged.draw_count
}

// Pictures from two textures that do not overlap stage to 2 draws however they are interleaved; an
// additive picture gets its own draw.
fn check_textures { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena } {
    let mut list = ui::draw::make{ realloc = arena::alloc, &heap, cmds = 64, text = 64, clips = 2, fonts = 1 } iferr { return }
    let mut staged = make_small{ &heap } iferr { return }
    ui_test::expect{ &io, &t, ok = count_picture_draws{ &list, &staged, order = "12121212" } == 2, what = "1 2 1 2 ... is 2 draws" }
    ui_test::expect{ &io, &t, ok = count_picture_draws{ &list, &staged, order = "11112222" } == 2, what = "1 1 1 1 2 2 2 2 is 2 draws" }
    ui_test::expect{ &io, &t, ok = count_picture_draws{ &list, &staged, order = "21122112" } == 2, what = "2 1 1 2 2 1 1 2 is 2 draws" }
    ui_test::expect{ &io, &t, ok = count_picture_draws{ &list, &staged, order = "1222221" } == 2, what = "1 2 2 2 2 2 1 is 2 draws" }
    ui_test::expect{ &io, &t, ok = count_picture_draws{ &list, &staged, order = "121a212" } == 3, what = "an additive picture gets its own draw" }
    ui_test::expect{ &io, &t, ok = staged.draws[2].blend == ui::Blend::additive and staged.draws[2].image == 1 and staged.draws[2].count == 1, what = "the additive draw names its texture and blend" }
    ui_test::expect{ &io, &t, ok = count_picture_draws{ &list, &staged, order = "1a1a" } == 2, what = "additive pictures of one texture share a draw" }

    // Overlapping pictures of two textures keep paint order: 1 under 2 under 1 is three draws.
    ui::draw::reset{ &list, width = 100.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    add_picture{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 20.0, h = 20.0 }, image = 1, blend = ui::Blend::alpha }
    add_picture{ &list, rect = make_rect{ x = 10.0, y = 0.0, w = 20.0, h = 20.0 }, image = 2, blend = ui::Blend::alpha }
    add_picture{ &list, rect = make_rect{ x = 20.0, y = 0.0, w = 20.0, h = 20.0 }, image = 1, blend = ui::Blend::alpha }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.draw_count == 3 and staged.draws[0].image == 1 and staged.draws[1].image == 2 and staged.draws[2].image == 1, what = "overlapping pictures of two textures keep paint order" }
    // Pictures that only touch do not overlap.
    ui::draw::reset{ &list, width = 100.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    add_picture{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 20.0, h = 20.0 }, image = 1, blend = ui::Blend::alpha }
    add_picture{ &list, rect = make_rect{ x = 20.0, y = 0.0, w = 20.0, h = 20.0 }, image = 2, blend = ui::Blend::alpha }
    add_picture{ &list, rect = make_rect{ x = 40.0, y = 0.0, w = 20.0, h = 20.0 }, image = 1, blend = ui::Blend::alpha }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.draw_count == 2, what = "pictures that only touch do not overlap" }
    // At a fractional position the shader grows the picture by a pixel, so touching ones then overlap.
    ui::draw::reset{ &list, width = 100.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    add_picture{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 20.5, h = 20.0 }, image = 1, blend = ui::Blend::alpha }
    add_picture{ &list, rect = make_rect{ x = 20.5, y = 0.0, w = 20.0, h = 20.0 }, image = 2, blend = ui::Blend::alpha }
    add_picture{ &list, rect = make_rect{ x = 40.5, y = 0.0, w = 20.0, h = 20.0 }, image = 1, blend = ui::Blend::alpha }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.draw_count == 3, what = "an edge between device pixels widens the bounds by the pixel the shader grows it by" }
}

// A host slot gives two passes, and no draw spans them.
fn check_host { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef, update: bool } {
    let mut list = make_list{ &heap, font, width = 200.0, height = 100.0, scale = 1.0, cmds = 16 } iferr { return }
    let mut staged = make_small{ &heap } iferr { return }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 50.0, h = 20.0 }, style = fill{ color = ui::Color{ r = 0x11, .. } }, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 2.0, y = 2.0, text = "a", color = ui::Color{ r = 0x22, .. }, clip = 0 }
    ui::draw::add_host{ &list, slot = 7, rect = make_rect{ x = 60.0, y = 0.0, w = 80.0, h = 60.0 } }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 150.0, y = 0.0, w = 50.0, h = 20.0 }, style = fill{ color = ui::Color{ r = 0x33, .. } }, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 152.0, y = 2.0, text = "b", color = ui::Color{ r = 0x44, .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.pass_count == 2, what = "a host slot gives two passes" }
    let a = staged.passes[0]
    let b = staged.passes[1]
    ui_test::expect{ &io, &t, ok = a.host and a.slot == 7 and a.rect.x == 60.0 and a.rect.w == 80.0 and not b.host, what = "the first pass ends at the host slot, the last has none" }
    ui_test::expect{ &io, &t, ok = a.first == 0 and a.count == 2 and b.first == 2 and b.count == 2 and staged.draw_count == 4, what = "no draw spans the passes: the rectangles after the slot are a draw of their own" }
    dump{ &io, &fs, &t, &heap, staged = &staged, name = "host", update }

    // A list that ends at a host slot ends with an empty pass.
    ui::draw::reset{ &list, width = 200.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 50.0, h = 20.0 }, style = fill{ color = ui::Color{ r = 0x11, .. } }, clip = 0 }
    ui::draw::add_host{ &list, slot = 1, rect = make_rect{ x = 60.0, y = 0.0, w = 80.0, h = 60.0 } }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.pass_count == 2 and staged.passes[1].count == 0 and not staged.passes[1].host, what = "a list ending at a host slot ends with an empty pass" }
}

// An odd quarter turn gives a transposed rectangle and the right rotation.
fn check_quarter { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena } {
    let mut list = ui::draw::make{ realloc = arena::alloc, &heap, cmds = 8, text = 8, clips = 2, fonts = 1 } iferr { return }
    let mut staged = make_small{ &heap } iferr { return }
    ui::draw::reset{ &list, width = 100.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    let corners = ui::Corners{ top_left = 1.0, top_right = 2.0, bottom_right = 3.0, bottom_left = 4.0 }
    let white = ui::Color{ r = 255, g = 255, b = 255, .. }
    let region = ui::Region{ image = ui::Image{ id = 5, width = 64.0, height = 64.0 }, uv = ui::Uv{ u0 = 0.25, v0 = 0.0, u1 = 0.5, v1 = 0.5 }, .. }
    let mut q: u8 = 0
    while q < 4 {
        ui::draw::add_image{ &list, rect = make_rect{ x = 10.0, y = 20.0, w = 40.0, h = 20.0 }, region, tint = white, quarter = q, angle = 0.0, radius = corners, blend = ui::Blend::alpha, clip = 0 }
        q = q + 1
    }
    ui::draw::add_image{ &list, rect = make_rect{ x = 10.0, y = 20.0, w = 40.0, h = 20.0 }, region, tint = white, quarter = 1, angle = 0.25, radius = corners, blend = ui::Blend::alpha, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.image_count == 5 and staged.draw_count == 1, what = "five pictures of one texture are one draw" }
    let m0 = staged.images[0]
    let m1 = staged.images[1]
    let m2 = staged.images[2]
    let m3 = staged.images[3]
    let m4 = staged.images[4]
    // The rectangle's centre is (30, 30) y down, (30, 70) in canvas space.
    ui_test::expect{ &io, &t, ok = m0.x == 10.0 and m0.y == 60.0 and m0.w == 40.0 and m0.h == 20.0 and m0.angle == 0.0, what = "no turn: the rectangle as it is" }
    ui_test::expect{ &io, &t, ok = m1.x == 20.0 and m1.y == 50.0 and m1.w == 20.0 and m1.h == 40.0 and is_near{ a = m1.angle, b = 1.5707964 }, what = "one quarter turn: transposed about the centre, turned by pi/2" }
    ui_test::expect{ &io, &t, ok = m2.x == 10.0 and m2.y == 60.0 and m2.w == 40.0 and m2.h == 20.0 and is_near{ a = m2.angle, b = 3.1415927 }, what = "two quarter turns: not transposed, turned by pi" }
    ui_test::expect{ &io, &t, ok = m3.x == 20.0 and m3.w == 20.0 and m3.h == 40.0 and is_near{ a = m3.angle, b = 4.712389 }, what = "three quarter turns: transposed, turned by 3 pi/2" }
    ui_test::expect{ &io, &t, ok = m4.w == 20.0 and m4.h == 40.0 and is_near{ a = m4.angle, b = 1.8207964 }, what = "a quarter turn and an angle add up" }
    // The region's V is flipped: v = v1 and a negative height.
    ui_test::expect{ &io, &t, ok = m0.u == 0.25 and m0.v == 0.5 and m0.uw == 0.25 and m0.vh == -0.5, what = "the region's V is flipped: v1 and a negative height" }
    // The corners go with the turn: after one counterclockwise turn the picture's top right is the rectangle's top left.
    ui_test::expect{ &io, &t, ok = m0.radius_tl == 1.0 and m0.radius_tr == 2.0 and m0.radius_br == 3.0 and m0.radius_bl == 4.0, what = "unturned radii are as given" }
    ui_test::expect{ &io, &t, ok = m1.radius_tl == 2.0 and m1.radius_tr == 3.0 and m1.radius_br == 4.0 and m1.radius_bl == 1.0, what = "turned radii round the rectangle's corners where they end up" }
    // The bounds of a quarter-turned picture are exactly its rectangle: two of them that touch do not overlap.
    ui::draw::reset{ &list, width = 100.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_image{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 40.0, h = 20.0 }, region, tint = white, quarter = 1, angle = 0.0, radius = ui::Corners{ .. }, blend = ui::Blend::alpha, clip = 0 }
    add_picture{ &list, rect = make_rect{ x = 40.0, y = 0.0, w = 20.0, h = 20.0 }, image = 6, blend = ui::Blend::alpha }
    ui::draw::add_image{ &list, rect = make_rect{ x = 60.0, y = 0.0, w = 40.0, h = 20.0 }, region, tint = white, quarter = 3, angle = 0.0, radius = ui::Corners{ .. }, blend = ui::Blend::alpha, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.draw_count == 2, what = "quarter-turned pictures that touch another texture's do not overlap it" }
}

// The same list twice gives the same revision; one changed colour gives a new one.
fn build_revision_list { mut list: ui::DrawList, color: ui::Color } {
    ui::draw::reset{ &list, width = 200.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 50.0, h = 20.0 }, style = fill{ color }, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 2.0, y = 2.0, text = "rev", color = ui::Color{ r = 0x22, .. }, clip = 0 }
    ui::draw::add_line{ &list, x0 = 0.0, y0 = 50.0, x1 = 100.0, y1 = 50.0, width = 1.0, color = ui::Color{ .. }, cap = ui::Cap::butt, clip = 0 }
}

fn check_revision { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef } {
    let mut list = make_list{ &heap, font, width = 200.0, height = 100.0, scale = 1.0, cmds = 16 } iferr { return }
    let mut staged = make_small{ &heap } iferr { return }
    build_revision_list{ &list, color = ui::Color{ r = 10, .. } }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    let first = staged.revision
    ui_test::expect{ &io, &t, ok = first == 1 and staged.atlas.dirty_x1 > staged.atlas.dirty_x0, what = "the first frame is revision 1 and uploads the glyphs it packed" }
    build_revision_list{ &list, color = ui::Color{ r = 10, .. } }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.revision == first and staged.atlas.dirty_x1 == staged.atlas.dirty_x0, what = "the same list twice gives the same revision, with nothing dirty" }
    ui_test::expect{ &io, &t, ok = staged.draw_count == 3 and staged.rect_count == 1 and staged.glyph_count == 3, what = "an unchanged frame keeps its draws" }
    build_revision_list{ &list, color = ui::Color{ r = 11, .. } }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.revision == first + 1 and staged.rects[0].fill == 0xFF0B0000, what = "one changed colour gives a new revision" }
    build_revision_list{ &list, color = ui::Color{ r = 11, .. } }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.revision == first + 1, what = "and the frame after it, the same again, keeps it" }
    build_revision_list{ &list, color = ui::Color{ r = 10, .. } }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.revision == first + 2, what = "changing it back is a change too" }
    // A changed scale is a change, even when the shapes are the same.
    ui::draw::reset{ &list, width = 200.0, height = 100.0, scale_x = 2.0, scale_y = 2.0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    let empty_rev = staged.revision
    ui::draw::reset{ &list, width = 200.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.revision == empty_rev + 1 and staged.pixel_width == 200.0, what = "the same empty list at another scale is a new revision" }
}

// ---- the glyph cache and the atlas

fn add_outline_font { mut list: ui::DrawList, handle: u32 } -> ui::Font {
    let def = ui::FontDef{ kind = ui::FontKind::outline{ handle }, encoding = ui::Encoding::utf8, height = 0.0, ascent = 0.0, snap = false }
    return ui::draw::add_font{ &list, font = def } ifnull { ui::Font{ index = 99 } }
}

// A glyph drawn twice is rasterised once, in an outline font and in a glyph table.
fn check_cache { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef, provider: ?ui::TextProvider, fake: *Fake } {
    let mut list = make_list{ &heap, font, width = 200.0, height = 100.0, scale = 1.0, cmds = 16 } iferr { return }
    let outline = add_outline_font{ &list, handle = 3 }
    let mut staged = make_small{ &heap } iferr { return }
    let before = fake.rasters
    ui::draw::add_text{ &list, font = outline, size = 16.0, x = 10.0, y = 10.0, text = "ABA B", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    ui_test::expect{ &io, &t, ok = fake.rasters == before + 3 and staged.glyph_count == 4 and staged.dropped == 0, what = "A, B and the space are rasterised once each; the four glyphs with ink are staged" }
    // Pen 10, 8 pixels an advance; baseline 10 + 12. 'A' (65) is 3 wide and 7 high, left 1, top 7.
    let a = staged.glyphs[0]
    ui_test::expect{ &io, &t, ok = a.x == 11.0 and a.w == 3.0 and a.h == 7.0 and a.y == 100.0 - 22.0, what = "an outline glyph sits on the baseline, its bearing added" }
    let b = staged.glyphs[1]
    ui_test::expect{ &io, &t, ok = b.x == 19.0 and b.w == 4.0 and b.h == 8.0, what = "the pen moves on by the advance" }
    let packed = staged.packed
    ui::draw::reset{ &list, width = 200.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_text{ &list, font = outline, size = 16.0, x = 50.0, y = 50.0, text = "BAAB", color = ui::Color{ .. }, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 10.0, y = 70.0, text = "xyx", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    ui_test::expect{ &io, &t, ok = fake.rasters == before + 3 and staged.packed == packed + 2, what = "a glyph drawn again is not rasterised again; x and y of the table are packed once" }
    ui::draw::reset{ &list, width = 200.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 32.0, x = 10.0, y = 10.0, text = "yxy", color = ui::Color{ .. }, clip = 0 }
    ui::draw::add_text{ &list, font = outline, size = 32.0, x = 10.0, y = 50.0, text = "A", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    ui_test::expect{ &io, &t, ok = staged.packed == packed + 3, what = "a table's glyph at another size is the same picture; an outline glyph at another size is another sized face" }
    ui_test::expect{ &io, &t, ok = fake.rasters == before + 4, what = "the outline 'A' at 32 pixels is rasterised once" }
    // Text in an outline font with no provider is dropped and counted.
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.dropped == 1, what = "outline text with no provider is dropped and counted" }
}

// A table with a picture of its own, so releasing it touches nothing else: the test font's cells.
fn copy_font { mut heap: arena::Arena, font: ui::FontDef } -> !ui::FontDef {
    if font.kind is bitmap{ image, glyphs, first, pixels, pixels_width, pixels_height } {
        let copy = try alloc::make(u8, arena::Arena){ realloc = arena::alloc, &heap, count = pixels.len }
        slice::copy(u8){ dst = copy, src = pixels }
        return ui::FontDef{ kind = ui::FontKind::bitmap{ image, glyphs, first, pixels = copy, pixels_width, pixels_height }, encoding = font.encoding, height = font.height, ascent = font.ascent, snap = font.snap }
    }
    return font
}

fn sum_texels { staged: *ui_stage::Staged, x: u32, y: u32, w: u32, h: u32 } -> u32 {
    let mut sum: u32 = 0
    let mut r: u32 = 0
    while r < h {
        let mut c: u32 = 0
        while c < w {
            sum = sum + staged.atlas.pixels[@as(usize, (y + r) * staged.atlas.width + x + c)]
            c = c + 1
        }
        r = r + 1
    }
    return sum
}

// Releasing a font frees its atlas space after four frames, and a glyph after that takes it.
fn check_release { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef, provider: ?ui::TextProvider } {
    let own = copy_font{ &heap, font } iferr { return }
    let mut list = make_list{ &heap, font, width = 200.0, height = 100.0, scale = 1.0, cmds = 16 } iferr { return }
    let other = ui::draw::add_font{ &list, font = own } ifnull { return }
    let outline = add_outline_font{ &list, handle = 4 }
    let mut staged = make_small{ &heap } iferr { return }
    ui::draw::add_text{ &list, font = other, size = 16.0, x = 0.0, y = 0.0, text = "Q", color = ui::Color{ .. }, clip = 0 }
    ui::draw::add_text{ &list, font = outline, size = 16.0, x = 0.0, y = 50.0, text = "R", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    let q = staged.glyphs[0]
    let qx = @as(u32, q.u * 128.0)
    let qy = @as(u32, q.v * 64.0)
    ui_test::expect{ &io, &t, ok = staged.cache_used == 2 and sum_texels{ staged = &staged, x = qx, y = qy, w = 8, h = 16 } > 0, what = "the table's Q and the outline R are in the atlas" }

    ui_stage::release_font{ out = &staged, font = own }
    ui_stage::release_face{ out = &staged, face = 4 * 1000 + 16 }
    ui_test::expect{ &io, &t, ok = staged.cache_used == 0 and staged.packer.held_count == 2, what = "releasing the font and the face forgets their glyphs and holds their room" }
    ui::draw::reset{ &list, width = 200.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    let mut frame: u32 = 0
    while frame < 3 {
        ui_stage::stage{ out = &staged, list = &list, provider }
        frame = frame + 1
    }
    ui_test::expect{ &io, &t, ok = staged.packer.held_count == 2 and staged.packer.freed_count == 0 and sum_texels{ staged = &staged, x = qx, y = qy, w = 8, h = 16 } > 0,
        what = "three frames later the room is still held and its texels kept" }
    ui_stage::stage{ out = &staged, list = &list, provider }
    ui_test::expect{ &io, &t, ok = staged.packer.held_count == 0 and staged.packer.freed_count == 2 and sum_texels{ staged = &staged, x = qx, y = qy, w = 8, h = 16 } == 0,
        what = "the fourth frame frees the room and clears its texels" }
    ui_test::expect{ &io, &t, ok = staged.atlas.dirty_x1 > staged.atlas.dirty_x0 and staged.revision > 0, what = "the cleared texels are dirty" }
    // A glyph of the same size takes the freed room.
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 0.0, text = "Z", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    let z = staged.glyphs[0]
    ui_test::expect{ &io, &t, ok = @as(u32, z.u * 128.0) == qx and @as(u32, z.v * 64.0) == qy and staged.packer.freed_count == 1, what = "the next glyph of that size takes the freed room" }
}

// A full atlas grows and raises `version`; the glyphs already in it stay where they are.
fn check_growth { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef } {
    let mut list = make_list{ &heap, font, width = 800.0, height = 100.0, scale = 1.0, cmds = 16 } iferr { return }
    let mut staged = make_staged{ &heap, cap = ui_stage::Capacity{ rects = 16, glyphs = 256, images = 16, shapes = 16, draws = 16, passes = 2,
        atlas_width = 64, atlas_height = 18, atlas_max_height = 72, glyph_cache = 256, raster_bytes = 1024 } } iferr { return }
    // Six glyphs, padded to 10 by 18, fill a 64 by 18 atlas.
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 0.0, text = "abcdef", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.atlas.height == 18 and staged.atlas.version == 0 and staged.dropped == 0, what = "six glyphs fit the first 18 rows" }
    let a = staged.glyphs[0]
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 20.0, text = "ghij", color = ui::Color{ .. }, clip = 0 }
    let rev = staged.revision
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.atlas.height == 36 and staged.atlas.version == 1 and staged.dropped == 0 and staged.revision == rev + 1, what = "a full atlas doubles in height and raises version" }
    let a2 = staged.glyphs[0]
    ui_test::expect{ &io, &t, ok = a2.u == a.u and is_near{ a = a2.v * 36.0, b = a.v * 18.0 } and is_near{ a = a2.vh * 36.0, b = 16.0 }, what = "a glyph packed before stays at its texels; its UV follows the new height" }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 40.0, text = "klmnopqrstuv", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.atlas.height == 72 and staged.atlas.version == 2 and staged.dropped == 0, what = "it grows again, to its limit" }
}

// At the limit the missing glyphs are counted, and the next frame refills the atlas.
fn check_limit { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef } {
    let mut list = make_list{ &heap, font, width = 800.0, height = 100.0, scale = 1.0, cmds = 16 } iferr { return }
    let mut staged = make_staged{ &heap, cap = ui_stage::Capacity{ rects = 16, glyphs = 256, images = 16, shapes = 16, draws = 16, passes = 2,
        atlas_width = 64, atlas_height = 18, atlas_max_height = 36, glyph_cache = 256, raster_bytes = 1024 } } iferr { return }
    // Room for twelve: six a band of 18 rows, two bands.
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 0.0, text = "abcdefghijklmnop", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.dropped == 4 and staged.glyph_count == 12 and staged.packer.refill, what = "at the limit the four glyphs that do not fit are counted as dropped" }
    ui::draw::reset{ &list, width = 800.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 0.0, text = "mnop", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.dropped == 0 and staged.glyph_count == 4 and staged.cache_used == 4 and not staged.packer.refill, what = "the next frame empties the atlas and refills it with what it draws" }
    ui_test::expect{ &io, &t, ok = staged.atlas.dirty_x0 == 0 and staged.atlas.dirty_y0 == 0 and staged.atlas.dirty_x1 == 64 and staged.atlas.dirty_y1 == 36, what = "the emptied atlas is dirty all over" }
    let m = staged.glyphs[0]
    ui_test::expect{ &io, &t, ok = m.u == 1.0 / 64.0 and m.v == 1.0 / 36.0, what = "the refilled atlas packs from its corner again" }
}

// Overflow of each array is counted, never a panic.
fn check_overflow { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef } {
    let mut list = make_list{ &heap, font, width = 300.0, height = 100.0, scale = 1.0, cmds = 512 } iferr { return }
    let mut staged = make_staged{ &heap, cap = ui_stage::Capacity{ rects = 2, glyphs = 3, images = 2, shapes = 2, draws = 2, passes = 2,
        atlas_width = 64, atlas_height = 32, atlas_max_height = 64, glyph_cache = 6, raster_bytes = 1024 } } iferr { return }
    let white = ui::Color{ r = 255, g = 255, b = 255, .. }
    let mut i: u32 = 0
    while i < 3 {
        ui::draw::add_rect{ &list, rect = make_rect{ x = @as(f32, i) * 10.0, y = 0.0, w = 5.0, h = 5.0 }, style = fill{ color = white }, clip = 0 }
        i = i + 1
    }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.rect_count == 2 and staged.dropped == 1, what = "three rectangles into room for two: one counted" }

    ui::draw::reset{ &list, width = 300.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 0.0, text = "aabba", color = white, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.glyph_count == 3 and staged.dropped == 2, what = "five glyphs into room for three: two counted" }

    ui::draw::reset{ &list, width = 300.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    i = 0
    while i < 3 {
        add_picture{ &list, rect = make_rect{ x = @as(f32, i) * 20.0, y = 0.0, w = 10.0, h = 10.0 }, image = 1, blend = ui::Blend::alpha }
        ui::draw::add_line{ &list, x0 = @as(f32, i) * 20.0, y0 = 50.0, x1 = @as(f32, i) * 20.0 + 5.0, y1 = 50.0, width = 1.0, color = white, cap = ui::Cap::butt, clip = 0 }
        i = i + 1
    }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.image_count == 2 and staged.shape_count == 2 and staged.dropped == 2, what = "three pictures and three lines into room for two each: two counted" }

    // Three draws wanted, room for two: the instance that needs the third is counted.
    ui::draw::reset{ &list, width = 300.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    add_picture{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 20.0, h = 20.0 }, image = 1, blend = ui::Blend::alpha }
    add_picture{ &list, rect = make_rect{ x = 10.0, y = 0.0, w = 20.0, h = 20.0 }, image = 2, blend = ui::Blend::alpha }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 5.0, y = 5.0, w = 5.0, h = 5.0 }, style = fill{ color = white }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.draw_count == 2 and staged.rect_count == 0 and staged.dropped == 1, what = "an instance that finds the draw list full is counted" }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.dropped == 1, what = "an unchanged frame counts it again" }

    // Two hosts, room for two passes: the second host is counted and its shapes stay in the last pass.
    ui::draw::reset{ &list, width = 300.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_host{ &list, slot = 1, rect = make_rect{ x = 0.0, y = 0.0, w = 10.0, h = 10.0 } }
    ui::draw::add_host{ &list, slot = 2, rect = make_rect{ x = 0.0, y = 0.0, w = 10.0, h = 10.0 } }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 5.0, y = 5.0, w = 5.0, h = 5.0 }, style = fill{ color = white }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = staged.pass_count == 2 and staged.passes[0].slot == 1 and staged.dropped == 1 and staged.rect_count == 1, what = "a host past the pass list is counted" }

    // A cache of four slots keeps a quarter free, so it holds three glyphs: a fourth distinct glyph
    // is counted and the next frame starts afresh.
    let mut few = make_staged{ &heap, cap = ui_stage::Capacity{ rects = 2, glyphs = 8, images = 2, shapes = 2, draws = 2, passes = 2,
        atlas_width = 64, atlas_height = 32, atlas_max_height = 64, glyph_cache = 4, raster_bytes = 1024 } } iferr { return }
    ui::draw::reset{ &list, width = 300.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 0.0, text = "pqr", color = white, clip = 0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 20.0, text = "sp", color = white, clip = 0 }
    ui_stage::stage{ out = &few, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = few.glyph_count == 4 and few.dropped == 1 and few.cache_used == 3 and few.packer.refill, what = "a full glyph cache counts the glyph it cannot hold" }
    ui::draw::reset{ &list, width = 300.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 20.0, text = "s", color = white, clip = 0 }
    ui_stage::stage{ out = &few, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = few.glyph_count == 1 and few.dropped == 0 and few.cache_used == 1, what = "the next frame empties the cache and the glyph fits" }

    // A clip past the uniform block's 256 entries, a font never registered, image 0 and an outline font with no provider.
    ui::draw::reset{ &list, width = 300.0, height = 100.0, scale_x = 1.0, scale_y = 1.0 }
    let mut k: u32 = 1
    let mut last: u16 = 0
    while k < 260 {
        last = ui::draw::add_clip{ &list, clip = ui::Clip{ rect = make_rect{ x = @as(f32, k) * 0.5, y = 0.0, w = 10.0, h = 10.0 }, .. } } ifnull { 0 }
        k = k + 1
    }
    ui::draw::add_rect{ &list, rect = make_rect{ x = 5.0, y = 5.0, w = 5.0, h = 5.0 }, style = fill{ color = white }, clip = last }
    ui::draw::add_text{ &list, font = ui::Font{ index = 3 }, size = 16.0, x = 0.0, y = 0.0, text = "x", color = white, clip = 0 }
    ui::draw::add_image{ &list, rect = make_rect{ x = 0.0, y = 0.0, w = 5.0, h = 5.0 }, region = ui::Region{ .. }, tint = white, quarter = 0, angle = 0.0, radius = ui::Corners{ .. }, blend = ui::Blend::alpha, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider = null }
    ui_test::expect{ &io, &t, ok = last == 259 and staged.clip_count == 256 and staged.rect_count == 0 and staged.dropped == 3, what = "clip 259, an unregistered font and image 0 are each counted" }
}

// ---- the batching invariant on random lists

struct Rng { state: u32 }

fn next_random { mut rng: Rng, below: u32 } -> u32 {
    let mut x = rng.state
    x = x ^ @wrap_shl(x, 13)
    x = x ^ (x >> 17)
    x = x ^ @wrap_shl(x, 5)
    rng.state = x
    return x % below
}

// Shape `id`'s colour: the id in the low 24 bits, opaque.
fn make_id_color { id: u32 } -> ui::Color {
    return ui::Color{ r = @trunc(u8, id >> 16), g = @trunc(u8, id >> 8), b = @trunc(u8, id), a = 255 }
}

// Fills `list` with `count` random shapes, each a colour of its own (its paint order), and writes in
// `glyphs[id]` how many instances shape `id` should stage to. Positions are on a half-unit grid so
// some edges are between device pixels.
fn build_random_list { mut list: ui::DrawList, mut rng: Rng, count: u32, expect: []mut u32, scale: f32 } {
    ui::draw::reset{ &list, width = 400.0, height = 300.0, scale_x = scale, scale_y = scale }
    // A few clips, one rounded.
    let mut clips: [4]u16
    clips[0] = 0
    let mut c: usize = 1
    while c < 4 {
        let cx = next_random{ &rng, below = 200 }
        let cy = next_random{ &rng, below = 150 }
        let cw = 50 + next_random{ &rng, below = 200 }
        let ch = 40 + next_random{ &rng, below = 150 }
        let r = make_rect{ x = @as(f32, cx), y = @as(f32, cy), w = @as(f32, cw), h = @as(f32, ch) }
        let radius: f32 = if c == 3 { 6.0 } else { 0.0 }
        clips[c] = ui::draw::add_clip{ &list, clip = ui::Clip{ rect = r, round = r, radius } } ifnull { 0 }
        c = c + 1
    }
    let texts: [4][]u8 = ["a", "hi", "abc", "word"]
    let mut id: u32 = 0
    while id < count {
        let x = @as(f32, next_random{ &rng, below = 760 }) * 0.5
        let y = @as(f32, next_random{ &rng, below = 560 }) * 0.5
        let w = @as(f32, 4 + next_random{ &rng, below = 100 }) * 0.5
        let h = @as(f32, 4 + next_random{ &rng, below = 100 }) * 0.5
        let clip = clips[@as(usize, next_random{ &rng, below = 4 })]
        let color = make_id_color{ id }
        let pick = next_random{ &rng, below = 100 }
        expect[@as(usize, id)] = 1
        if pick < 35 {
            ui::draw::add_rect{ &list, rect = make_rect{ x, y, w, h }, style = ui::RectStyle{ fill = color, radius = ui::round{ radius = 2.0 }, .. }, clip }
        } else if pick < 65 {
            let image = 1 + next_random{ &rng, below = 3 }
            let blend = if next_random{ &rng, below = 5 } == 0 { ui::Blend::additive } else { ui::Blend::alpha }
            let quarter = @as(u8, next_random{ &rng, below = 4 })
            let angle: f32 = if next_random{ &rng, below = 4 } == 0 { 0.4 } else { 0.0 }
            ui::draw::add_image{ &list, rect = make_rect{ x, y, w, h }, region = ui::Region{ image = ui::Image{ id = image, width = 64.0, height = 64.0 }, .. },
                tint = color, quarter, angle, radius = ui::Corners{ .. }, blend, clip }
        } else if pick < 82 {
            let text = texts[@as(usize, next_random{ &rng, below = 4 })]
            let size: f32 = if next_random{ &rng, below = 2 } == 0 { 16.0 } else { 32.0 }
            ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size, x, y, text, color, clip }
            expect[@as(usize, id)] = @as(u32, text.len)
        } else if pick < 98 {
            let cap = if next_random{ &rng, below = 2 } == 0 { ui::Cap::round } else { ui::Cap::square }
            ui::draw::add_line{ &list, x0 = x, y0 = y, x1 = x + w - 10.0, y1 = y + h - 10.0, width = 1.0 + @as(f32, next_random{ &rng, below = 4 }), color, cap, clip }
        } else {
            ui::draw::add_host{ &list, slot = id, rect = make_rect{ x, y, w, h } }
            expect[@as(usize, id)] = 0
        }
        id = id + 1
    }
}

// One instance of the final draw sequence: the shape it came from, its batching key and its bounds,
// worked out here from the instance and the staged clip table, as the shaders cover it.
struct Seen { id: u32, kind: ui_stage::Kind, image: u32, blend: ui::Blend, min_x: f32, min_y: f32, max_x: f32, max_y: f32 }

fn is_between_pixels { v: f32, scale: f32 } -> bool {
    let d = v * scale
    return ui::abs_f32{ x = d - ui::round_f32{ x = d } } >= 1.0 / 256.0
}

fn make_seen { staged: *ui_stage::Staged, kind: ui_stage::Kind, image: u32, blend: ui::Blend, color: u32, clip: u32, x: f32, y: f32, w: f32, h: f32, angle: f32, grows: bool, scale: f32 } -> Seen {
    let mut s = Seen{ id = color & 0xFFFFFF, kind, image, blend, min_x = x, min_y = y, max_x = x + w, max_y = y + h }
    if angle != 0.0 {
        // The corners of the turned rectangle.
        let cx = x + w * 0.5
        let cy = y + h * 0.5
        let cs = ui::cos_f32{ x = angle }
        let sn = ui::sin_f32{ x = angle }
        let hx = [0.0 - w * 0.5, w * 0.5]
        let hy = [0.0 - h * 0.5, h * 0.5]
        s.min_x = 1.0e30
        s.min_y = 1.0e30
        s.max_x = -1.0e30
        s.max_y = -1.0e30
        let mut i: usize = 0
        while i < 4 {
            let lx = hx[i % 2]
            let ly = hy[i / 2]
            let px = cx + cs * lx - sn * ly
            let py = cy + sn * lx + cs * ly
            s.min_x = ui::pick_min_f32{ a = s.min_x, b = px }
            s.max_x = ui::pick_max_f32{ a = s.max_x, b = px }
            s.min_y = ui::pick_min_f32{ a = s.min_y, b = py }
            s.max_y = ui::pick_max_f32{ a = s.max_y, b = py }
            i = i + 1
        }
    } else if grows and w > 0.0 and h > 0.0 {
        if is_between_pixels{ v = x, scale } or is_between_pixels{ v = x + w, scale } {
            s.min_x = s.min_x - 1.0 / scale
            s.max_x = s.max_x + 1.0 / scale
        }
        if is_between_pixels{ v = y, scale } or is_between_pixels{ v = y + h, scale } {
            s.min_y = s.min_y - 1.0 / scale
            s.max_y = s.max_y + 1.0 / scale
        }
    }
    let k = staged.clips[@as(usize, clip)]
    s.min_x = ui::pick_max_f32{ a = s.min_x, b = k.left }
    s.min_y = ui::pick_max_f32{ a = s.min_y, b = k.bottom }
    s.max_x = ui::pick_min_f32{ a = s.max_x, b = k.right }
    s.max_y = ui::pick_min_f32{ a = s.max_y, b = k.top }
    return s
}

// Every instance of `staged` in the order a backend draws it. False when the draws and passes do
// not cover the instance arrays exactly once each, in order.
fn list_drawn { staged: *ui_stage::Staged, scale: f32, seen: []mut Seen, mut count: usize } -> bool {
    count = 0
    let mut next_draw: u32 = 0
    let mut used: [4]u32
    let mut p: usize = 0
    while p < @as(usize, staged.pass_count) {
        let pass = staged.passes[p]
        if pass.first != next_draw { return false }
        let mut d = pass.first
        while d < pass.first + pass.count {
            let draw = staged.draws[@as(usize, d)]
            let k = @as(usize, @as(u8, draw.kind))
            if draw.first != used[k] { return false }
            let mut i = draw.first
            while i < draw.first + draw.count {
                let n = @as(usize, i)
                match draw.kind {
                    rect => {
                        let r = staged.rects[n]
                        seen[count] = make_seen{ staged, kind = draw.kind, image = 0, blend = draw.blend, color = r.fill, clip = r.clip, x = r.x, y = r.y, w = r.w, h = r.h, angle = 0.0, grows = true, scale }
                    }
                    glyph => {
                        let g = staged.glyphs[n]
                        seen[count] = make_seen{ staged, kind = draw.kind, image = 0, blend = draw.blend, color = g.color, clip = g.clip, x = g.x, y = g.y, w = g.w, h = g.h, angle = g.angle, grows = false, scale }
                    }
                    image => {
                        let m = staged.images[n]
                        seen[count] = make_seen{ staged, kind = draw.kind, image = draw.image, blend = draw.blend, color = m.tint, clip = m.clip, x = m.x, y = m.y, w = m.w, h = m.h, angle = m.angle, grows = true, scale }
                    }
                    shape => {
                        let s = staged.shapes[n]
                        seen[count] = make_seen{ staged, kind = draw.kind, image = 0, blend = draw.blend, color = s.color, clip = s.clip, x = s.x, y = s.y, w = s.w, h = s.h, angle = 0.0, grows = false, scale }
                    }
                }
                count = count + 1
                i = i + 1
            }
            used[k] = used[k] + draw.count
            d = d + 1
        }
        next_draw = pass.first + pass.count
        p = p + 1
    }
    return next_draw == staged.draw_count and used[0] == staged.rect_count and used[1] == staged.glyph_count and used[2] == staged.image_count and used[3] == staged.shape_count
}

fn is_overlapping { a: Seen, b: Seen } -> bool {
    if not (a.max_x > a.min_x and a.max_y > a.min_y and b.max_x > b.min_x and b.max_y > b.min_y) { return false }
    return a.min_x < b.max_x and b.min_x < a.max_x and a.min_y < b.max_y and b.min_y < a.max_y
}

// Stages random lists and checks the batching invariant directly: every pair of instances whose
// clipped bounds overlap is drawn in paint order (this covers the pairs whose kinds or textures
// differ, and the pairs that share a draw key too), and every shape's instances appear exactly as
// often as it made them.
fn check_random { mut io: Io, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef } {
    let shapes: u32 = 120
    let mut list = make_list{ &heap, font, width = 400.0, height = 300.0, scale = 1.0, cmds = shapes } iferr { return }
    let mut staged = make_staged{ &heap, cap = ui_stage::Capacity{ rects = 512, glyphs = 1024, images = 512, shapes = 512, draws = 512, passes = 16,
        atlas_width = 256, atlas_height = 64, atlas_max_height = 512, glyph_cache = 512, raster_bytes = 1024 } } iferr { return }
    let expect = alloc::make(u32, arena::Arena){ realloc = arena::alloc, &heap, count = @as(usize, shapes) } iferr { return }
    let found = alloc::make(u32, arena::Arena){ realloc = arena::alloc, &heap, count = @as(usize, shapes) } iferr { return }
    let seen = alloc::make(Seen, arena::Arena){ realloc = arena::alloc, &heap, count = 4096 } iferr { return }
    let mut rng = Rng{ state = 2463534242 }
    let mut ok_cover = true
    let mut ok_order = true
    let mut ok_count = true
    let mut ok_dropped = true
    let mut pairs: u64 = 0
    let mut draws: u64 = 0
    let mut instances: u64 = 0
    let mut round: u32 = 0
    while round < 300 {
        let scale: f32 = if round % 3 == 0 { 1.5 } else { 1.0 }
        build_random_list{ &list, &rng, count = shapes, expect, scale }
        ui_stage::stage{ out = &staged, list = &list, provider = null }
        if staged.dropped != 0 or list.dropped != 0 { ok_dropped = false }
        let mut count: usize = 0
        if not list_drawn{ staged = &staged, scale, seen, &count } { ok_cover = false }
        slice::fill(u32){ s = found, v = 0 }
        let mut i: usize = 0
        while i < count {
            let id = seen[i].id
            if id < shapes { found[@as(usize, id)] = found[@as(usize, id)] + 1 } else { ok_count = false }
            let mut j = i + 1
            while j < count {
                if is_overlapping{ a = seen[i], b = seen[j] } {
                    pairs = pairs + 1
                    if seen[j].id < seen[i].id { ok_order = false }
                }
                j = j + 1
            }
            i = i + 1
        }
        i = 0
        while i < @as(usize, shapes) {
            if found[i] != expect[i] { ok_count = false }
            i = i + 1
        }
        draws = draws + @as(u64, staged.draw_count)
        instances = instances + @as(u64, count)
        round = round + 1
    }
    ui_test::expect{ &io, &t, ok = ok_dropped, what = "random lists stage with nothing dropped" }
    ui_test::expect{ &io, &t, ok = ok_cover, what = "random lists: the passes and draws cover every instance array exactly once, in order" }
    ui_test::expect{ &io, &t, ok = ok_count, what = "random lists: every shape's instances appear exactly once each" }
    ui_test::expect{ &io, &t, ok = ok_order, what = "random lists: every pair of overlapping instances is drawn in paint order" }
    ui_test::expect{ &io, &t, ok = pairs > 10000 and draws < instances, what = "random lists: the check met many overlapping pairs, and batching merged draws" }
    _ = @fmt(&io, "random lists: 300 lists, {} instances in {} draws, {} overlapping pairs checked\n", instances, draws, pairs)
}

// ---- the atlas, written to look at

fn write_atlas { mut io: Io, mut fs: Fs, mut t: ui_test::Tally, mut heap: arena::Arena, font: ui::FontDef, provider: ?ui::TextProvider } {
    let mut list = make_list{ &heap, font, width = 800.0, height = 200.0, scale = 1.0, cmds = 16 } iferr { return }
    let outline = add_outline_font{ &list, handle = 9 }
    let mut staged = make_staged{ &heap, cap = ui_stage::Capacity{ rects = 16, glyphs = 1024, images = 16, shapes = 16, draws = 16, passes = 2,
        atlas_width = 256, atlas_height = 64, atlas_max_height = 256, glyph_cache = 1024, raster_bytes = 4096 } } iferr { return }
    ui::draw::add_text{ &list, font = ui::Font{ index = 0 }, size = 16.0, x = 0.0, y = 0.0, text = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~", color = ui::Color{ .. }, clip = 0 }
    ui::draw::add_text{ &list, font = outline, size = 24.0, x = 0.0, y = 40.0, text = "ABCDEFGHIJKLMNOPQRST", color = ui::Color{ .. }, clip = 0 }
    ui_stage::stage{ out = &staged, list = &list, provider }
    ui_test::expect{ &io, &t, ok = staged.dropped == 0 and staged.glyph_count == 95 + 20, what = "the whole test font and twenty boxes fit the atlas" }
    _ = fs::make_dir{ &fs, path = "ui/out" }
    let picture = ui_test::Picture{ width = staged.atlas.width, height = staged.atlas.height, channels = 1, pixels = staged.atlas.pixels }
    ui_test::write_png{ &fs, realloc = arena::alloc, &heap, path = ATLAS_PNG, picture, bottom_up = true } iferr {
        ui_test::expect{ &io, &t, ok = false, what = "write the atlas PNG" }
        return
    }
    _ = @fmt(&io, "wrote {} ({}x{})\n", ATLAS_PNG, staged.atlas.width, staged.atlas.height)
}
