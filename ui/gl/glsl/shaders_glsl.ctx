        "#version 410\n",
        "\n",
        "// Per-vertex\n",
        "layout(location = 0) in vec2 a_unitPos;          // [0,1] x [0,1]\n",
        "\n",
        "// Per-instance\n",
        "layout(location = 1) in vec4 i_rect;             // x, y, w, h (pixel space)\n",
        "layout(location = 2) in vec4 i_borderRadius;     // tl, tr, br, bl\n",
        "layout(location = 3) in vec4 i_borderSize;       // top, right, bottom, left\n",
        "layout(location = 4) in uint i_bgColor;          // ARGB packed\n",
        "layout(location = 5) in uint i_borderColorTop;\n",
        "layout(location = 6) in uint i_borderColorRight;\n",
        "layout(location = 7) in uint i_borderColorBottom;\n",
        "layout(location = 8) in uint i_borderColorLeft;\n",
        "layout(location = 9) in uint i_clipIndex;\n",
        "\n",
        "// The projection, then the logical canvas size followed by the actual, rounded framebuffer size.\n",
        "// One std140 block, the same in every canvas shader: Vulkan's GLSL has no plain uniforms.\n",
        "layout(std140) uniform Canvas {\n",
        "    mat4 u_projection;\n",
        "    vec4 u_canvasMetrics;\n",
        "};\n",
        "\n",
        "layout(location = 0) flat out vec2 v_rectOrigin;\n",
        "layout(location = 1) flat out vec4 v_rectSize;  // (w, h, w, h) for convenience\n",
        "layout(location = 2) flat out vec4 v_borderRadius;\n",
        "layout(location = 3) flat out vec4 v_borderSize;\n",
        "layout(location = 4) flat out uint v_bgColor;\n",
        "layout(location = 5) flat out uint v_borderColorTop;\n",
        "layout(location = 6) flat out uint v_borderColorRight;\n",
        "layout(location = 7) flat out uint v_borderColorBottom;\n",
        "layout(location = 8) flat out uint v_borderColorLeft;\n",
        "layout(location = 9) flat out uint v_clipIndex;\n",
        "// Whether the rect grew to fade an edge between device pixels; a rect on the grid is drawn exactly as before.\n",
        "layout(location = 10) flat out float v_fadesEdges;\n",
        "\n",
        "void main() {\n",
        "    // A rect moved or scaled by a transform can have an edge between device pixels. The quad grows a\n",
        "    // pixel on that axis so the pixels the edge partly covers are drawn, and the fragment shader fades\n",
        "    // them by how much. An edge on the grid needs neither and the quad stays as it was.\n",
        "    vec2 devicePerLogical = u_canvasMetrics.zw / u_canvasMetrics.xy;\n",
        "    vec2 low = i_rect.xy * devicePerLogical;\n",
        "    vec2 high = (i_rect.xy + i_rect.zw) * devicePerLogical;\n",
        "    vec2 offGrid = max(abs(low - round(low)), abs(high - round(high)));\n",
        "    // A rect with no area stays without one rather than growing into a faint line.\n",
        "    bool hasArea = i_rect.z > 0.0 && i_rect.w > 0.0;\n",
        "    vec2 outset = hasArea ? step(1.0 / 256.0, offGrid) / devicePerLogical : vec2(0.0);\n",
        "    v_fadesEdges = outset.x > 0.0 || outset.y > 0.0 ? 1.0 : 0.0;\n",
        "    vec2 pixelPos = i_rect.xy - outset + a_unitPos * (i_rect.zw + 2.0 * outset);\n",
        "    gl_Position = u_projection * vec4(pixelPos, 0.0, 1.0);\n",
        "\n",
        "    v_rectOrigin = i_rect.xy;\n",
        "    v_rectSize = vec4(i_rect.zw, i_rect.zw);\n",
        "    v_borderRadius = i_borderRadius;\n",
        "    v_borderSize = i_borderSize;\n",
        "    v_bgColor = i_bgColor;\n",
        "    v_borderColorTop = i_borderColorTop;\n",
        "    v_borderColorRight = i_borderColorRight;\n",
        "    v_borderColorBottom = i_borderColorBottom;\n",
        "    v_borderColorLeft = i_borderColorLeft;\n",
        "    v_clipIndex = i_clipIndex;\n",
        "}\n",
    ]

    // ui/shaders/canvas_rect.frag.glsl
    const CANVAS_RECT_FRAG: [_]c::String = [
        "#version 410\n",
        "\n",
        "layout(location = 0) flat in vec2 v_rectOrigin;\n",
        "layout(location = 1) flat in vec4 v_rectSize;\n",
        "layout(location = 2) flat in vec4 v_borderRadius;\n",
        "layout(location = 3) flat in vec4 v_borderSize;\n",
        "layout(location = 4) flat in uint v_bgColor;\n",
        "layout(location = 5) flat in uint v_borderColorTop;\n",
        "layout(location = 6) flat in uint v_borderColorRight;\n",
        "layout(location = 7) flat in uint v_borderColorBottom;\n",
        "layout(location = 8) flat in uint v_borderColorLeft;\n",
        "layout(location = 9) flat in uint v_clipIndex;\n",
        "layout(location = 10) flat in float v_fadesEdges;\n",
        "\n",
        "// Binding point is assigned from C# via glUniformBlockBinding because the\n",
        "// `binding = N` layout qualifier requires GLSL 420 / ARB_shading_language_420pack,\n",
        "// which is not available on macOS (capped at 4.1 / GLSL 410).\n",
        "layout(std140) uniform ClipRects {\n",
        "    vec4 u_clipRects[256];  // (left, bottom, right, top)\n",
        "    vec4 u_clipRounds[256]; // the rounded rect the clip is also cut to, (left, bottom, right, top)\n",
        "    vec4 u_clipRadii[256];  // that rect's corner radius in x; 0 when the clip is not rounded\n",
        "};\n",
        "\n",
        "out vec4 f_Color;\n",
        "\n",
        "// The projection, then the logical canvas size followed by the actual, rounded framebuffer size.\n",
        "// One std140 block, the same in every canvas shader: Vulkan's GLSL has no plain uniforms.\n",
        "layout(std140) uniform Canvas {\n",
        "    mat4 u_projection;\n",
        "    vec4 u_canvasMetrics;\n",
        "};\n",
        "\n",
        "vec4 unpackARGB(uint c) {\n",
        "    float a = float((c >> 24) & 0xFFu) / 255.0;\n",
        "    float r = float((c >> 16) & 0xFFu) / 255.0;\n",
        "    float g = float((c >>  8) & 0xFFu) / 255.0;\n",
        "    float b = float( c        & 0xFFu) / 255.0;\n",
        "    return vec4(r, g, b, a);\n",
        "}\n",
        "\n",
        "// How much of the pixel at p the clip's rounded rect covers: 1 inside it, 0 outside, and between over\n",
        "// the device pixel its edge crosses. Always 1 for a clip that is not rounded.\n",
        "float clipCoverage(vec2 p, uint index) {\n",
        "    float pixel = max(fwidth(p.x), 1e-4);\n",
        "    float r = u_clipRadii[index].x;\n",
        "    if (r <= 0.0) return 1.0;\n",
        "    vec4 rounded = u_clipRounds[index];\n",
        "    vec2 halfSize = (rounded.zw - rounded.xy) * 0.5;\n",
        "    vec2 q = abs(p - (rounded.xy + rounded.zw) * 0.5) - (halfSize - vec2(r));\n",
        "    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;\n",
        "    return clamp(0.5 - d / pixel, 0.0, 1.0);\n",
        "}\n",
        "\n",
        "void main() {\n",
        "    // Interpolated local coordinates can fall on opposite sides of an exact border\n",
        "    // boundary along the same pixel row. Reconstruct from the fragment's pixel center\n",
        "    // and flat instance data so straight borders have uniform thickness at any DPI.\n",
        "#ifdef VULKAN\n",
        "    // Vulkan counts gl_FragCoord.y from the framebuffer's top; the canvas counts from its bottom.\n",
        "    vec2 fragCoord = vec2(gl_FragCoord.x, u_canvasMetrics.w - gl_FragCoord.y);\n",
        "#else\n",
        "    vec2 fragCoord = gl_FragCoord.xy;\n",
        "#endif\n",
        "    vec2 v_pixelPos = fragCoord * (u_canvasMetrics.xy / u_canvasMetrics.zw);\n",
        "    vec2 v_localPos = v_pixelPos - v_rectOrigin;\n",
        "    // --- Clip test ---\n",
        "    float clipCover = clipCoverage(v_pixelPos, v_clipIndex);\n",
        "    vec4 clip = u_clipRects[v_clipIndex];\n",
        "    // Discarded only once clipCoverage's derivative is taken: fwidth reads the 2x2 quad's neighbours,\n",
        "    // which must all still run the same code for it to be defined.\n",
        "    bool clippedOut = v_pixelPos.x < clip.x || v_pixelPos.x >= clip.z ||\n",
        "                      v_pixelPos.y < clip.y || v_pixelPos.y >= clip.w || clipCover <= 0.0;\n",
        "\n",
        "    float rectW = v_rectSize.x;\n",
        "    float rectH = v_rectSize.y;\n",
        "    float halfW = rectW * 0.5;\n",
        "    float halfH = rectH * 0.5;\n",
        "\n",
        "    vec2 mirror = abs(v_localPos - vec2(halfW, halfH)); // 0 at center, halfX at edges\n",
        "\n",
        "    // Pick the radius for this quadrant.\n",
        "    // borderRadius = (tl, tr, br, bl). v_localPos.y > halfH means upper, .x > halfW means right.\n",
        "    bool right = v_localPos.x > halfW;\n",
        "    bool top   = v_localPos.y > halfH;\n",
        "    float radius =\n",
        "        top  ? (right ? v_borderRadius.y : v_borderRadius.x)   // tr : tl\n",
        "             : (right ? v_borderRadius.z : v_borderRadius.w);  // br : bl\n",
        "\n",
        "    // Border thickness for the active quadrant (used for rounded-corner pivot test).\n",
        "    float borderW = right ? v_borderSize.y : v_borderSize.w;\n",
        "    float borderH = top   ? v_borderSize.x : v_borderSize.z;\n",
        "\n",
        "    vec2 pivot = vec2(halfW - radius, halfH - radius);\n",
        "    bool inCornerZone = (mirror.x > pivot.x) && (mirror.y > pivot.y);\n",
        "\n",
        "    // A rounded corner's two edges ramp over one device pixel, each by how far its value moves across one,\n",
        "    // worked out from the geometry rather than taken with fwidth: the compiler is free to compute a value\n",
        "    // only inside the branch that uses it, so a 2x2 quad straddling where the corner starts read undefined\n",
        "    // neighbours there, which left a 1-device-pixel seam down the corner at 1x, where corners start mid-quad.\n",
        "    vec2 logicalPerDevice = u_canvasMetrics.xy / u_canvasMetrics.zw;\n",
        "    vec2 fromPivot = mirror - pivot;\n",
        "    float d = length(fromPivot);\n",
        "    float aa = max(dot(abs(fromPivot), logicalPerDevice) / max(d, 1e-6), 1e-6);\n",
        "\n",
        "    // The inner (fill vs border) ellipse e == 1 and how far e moves across a device pixel.\n",
        "    float innerW = max(radius - borderW, 1e-6);\n",
        "    float innerH = max(radius - borderH, 1e-6);\n",
        "    float ix = (mirror.x - pivot.x) / innerW;\n",
        "    float iy = (mirror.y - pivot.y) / innerH;\n",
        "    float e = ix * ix + iy * iy;\n",
        "    float aaInner = max(dot(abs(vec2(2.0 * ix / innerW, 2.0 * iy / innerH)), logicalPerDevice), 1e-6);\n",
        "\n",
        "    if (clippedOut) discard;\n",
        "\n",
        "    // At fractional display scales an outer edge can pass through a pixel center.\n",
        "    // A zero-width side must still count as fill there, not borrow another side's color.\n",
        "    bool inBottom = v_borderSize.z > 0.0 && v_localPos.y < v_borderSize.z;\n",
        "    bool inTop    = v_borderSize.x > 0.0 && v_localPos.y >= rectH - v_borderSize.x;\n",
        "    bool inRight  = v_borderSize.y > 0.0 && v_localPos.x >= rectW - v_borderSize.y;\n",
        "    bool inLeft   = v_borderSize.w > 0.0 && v_localPos.x < v_borderSize.w;\n",
        "\n",
        "    float coverage = 1.0;   // outer silhouette (shape vs background)\n",
        "    float fillFactor;       // 1 = fill, 0 = border, ramped across the inner boundary\n",
        "    if (inCornerZone && radius > 0.0) {\n",
        "        // Antialiased outer edge of the rounded corner: 1 inside, 0 outside, ramped over one pixel.\n",
        "        coverage = clamp((radius - d) / aa + 0.5, 0.0, 1.0);\n",
        "        if (coverage <= 0.0) discard;\n",
        "        if (borderW < radius && borderH < radius) {\n",
        "            // Antialiased INNER boundary (fill vs border): the ellipse e == 1, ramped like the outer\n",
        "            // edge. Keeps a filled corner smooth even with a transparent border \xE2\x80\x94 a hard test would\n",
        "            // leave the fill's own corner aliased (reads as square).\n",
        "            fillFactor = clamp((1.0 - e) / aaInner + 0.5, 0.0, 1.0);\n",
        "        } else {\n",
        "            fillFactor = 0.0; // border thicker than the radius: the whole corner is border\n",
        "        }\n",
        "    } else if (v_fadesEdges > 0.0) {\n",
        "        // Straight edges a transform left between device pixels: the outer edge and the border's inner\n",
        "        // edge each fade the pixels they partly cover, so the rect moves smoothly instead of a pixel at a\n",
        "        // time. A side with no border lets the fill run to the outer edge.\n",
        "        vec2 devicePerLogical = u_canvasMetrics.zw / u_canvasMetrics.xy;\n",
        "        vec2 inside = (vec2(halfW, halfH) - mirror) * devicePerLogical;\n",
        "        coverage = clamp(inside.x + 0.5, 0.0, 1.0) * clamp(inside.y + 0.5, 0.0, 1.0);\n",
        "        if (coverage <= 0.0) discard;\n",
        "        const float noBorder = 1.0e6;\n",
        "        float fromLeft   = v_borderSize.w > 0.0 ? v_localPos.x - v_borderSize.w : noBorder;\n",
        "        float fromRight  = v_borderSize.y > 0.0 ? rectW - v_borderSize.y - v_localPos.x : noBorder;\n",
        "        float fromBottom = v_borderSize.z > 0.0 ? v_localPos.y - v_borderSize.z : noBorder;\n",
        "        float fromTop    = v_borderSize.x > 0.0 ? rectH - v_borderSize.x - v_localPos.y : noBorder;\n",
        "        vec2 intoFill = vec2(min(fromLeft, fromRight), min(fromBottom, fromTop)) * devicePerLogical;\n",
        "        fillFactor = clamp(intoFill.x + 0.5, 0.0, 1.0) * clamp(intoFill.y + 0.5, 0.0, 1.0);\n",
        "        // A pixel whose center is just inside the fill takes the nearest side's border color for its share.\n",
        "        if (!(inBottom || inTop || inRight || inLeft)) {\n",
        "            float nearest = min(min(fromLeft, fromRight), min(fromBottom, fromTop));\n",
        "            inBottom = nearest == fromBottom && v_borderSize.z > 0.0;\n",
        "            inTop    = !inBottom && nearest == fromTop && v_borderSize.x > 0.0;\n",
        "            inRight  = !inBottom && !inTop && nearest == fromRight && v_borderSize.y > 0.0;\n",
        "            inLeft   = !inBottom && !inTop && !inRight && nearest == fromLeft && v_borderSize.w > 0.0;\n",
        "        }\n",
        "    } else {\n",
        "        // Straight-edge zone on the pixel grid: axis-aligned, needs no antialiasing.\n",
        "        fillFactor = (inBottom || inTop || inRight || inLeft) ? 0.0 : 1.0;\n",
        "    }\n",
        "\n",
        "    // Border side priority: bottom > top > right > left (matches software canvas).\n",
        "    uint pickedColor;\n",
        "    if (inBottom)      pickedColor = v_borderColorBottom;\n",
        "    else if (inTop)    pickedColor = v_borderColorTop;\n",
        "    else if (inRight)  pickedColor = v_borderColorRight;\n",
        "    else if (inLeft)   pickedColor = v_borderColorLeft;\n",
        "    else               pickedColor = top ? v_borderColorTop : v_borderColorBottom;\n",
        "\n",
        "    // Composite fill over border in premultiplied space, then unpremultiply, so a transparent border\n",
        "    // lets the fill's rounded corner fade correctly (a straight-alpha mix would darken the edge).\n",
        "    // coverage applies the outer silhouette.\n",
        "    vec4 fillCol   = unpackARGB(v_bgColor);\n",
        "    vec4 borderCol = unpackARGB(pickedColor);\n",
        "    float outA     = mix(borderCol.a, fillCol.a, fillFactor);\n",
        "    vec3 outPre    = mix(borderCol.rgb * borderCol.a, fillCol.rgb * fillCol.a, fillFactor);\n",
        "    vec3 outRgb    = outA > 0.0 ? outPre / outA : vec3(0.0);\n",
        "    f_Color = vec4(outRgb, outA * coverage);\n",
        "    f_Color.a *= clipCover;\n",
        "}\n",
    ]

    // ui/shaders/canvas_glyph.vert.glsl
    const CANVAS_GLYPH_VERT: [_]c::String = [
        "#version 410\n",
        "\n",
        "// Per-vertex\n",
        "layout(location = 0) in vec2 a_unitPos;     // [0,1] x [0,1]\n",
        "\n",
        "// Per-instance\n",
        "layout(location = 1) in vec4 i_rect;        // x, y, w, h (pixel space)\n",
        "layout(location = 2) in vec4 i_atlasUV;     // u, v, w, h (normalized atlas coords)\n",
        "layout(location = 3) in uint i_color;       // ARGB packed\n",
        "layout(location = 4) in uint i_clipIndex;\n",
        "layout(location = 5) in float i_rotation;   // radians, rotation about the glyph rect's center\n",
        "\n",
        "// The projection, then the logical canvas size followed by the actual, rounded framebuffer size.\n",
        "// One std140 block, the same in every canvas shader: Vulkan's GLSL has no plain uniforms.\n",
        "layout(std140) uniform Canvas {\n",
        "    mat4 u_projection;\n",
        "    vec4 u_canvasMetrics;\n",
        "};\n",
        "\n",
        "layout(location = 0) out vec2 v_pixelPos;\n",
        "layout(location = 1) out vec2 v_atlasUV;\n",
        "layout(location = 2) flat out uint v_color;\n",
        "layout(location = 3) flat out uint v_clipIndex;\n",
        "\n",
        "void main() {\n",
        "    vec2 center = i_rect.xy + i_rect.zw * 0.5;\n",
        "    vec2 local = (a_unitPos - vec2(0.5)) * i_rect.zw;\n",
        "    float cs = cos(i_rotation);\n",
        "    float sn = sin(i_rotation);\n",
        "    vec2 rotated = vec2(cs * local.x - sn * local.y, sn * local.x + cs * local.y);\n",
        "    vec2 pixelPos = center + rotated;\n",
        "    gl_Position = u_projection * vec4(pixelPos, 0.0, 1.0);\n",
        "\n",
        "    v_pixelPos = pixelPos;\n",
        "    // Atlas is uploaded with Y already flipped, so the texture's V-axis matches the\n",
        "    // pixel-space Y-up axis. Bottom of dest rect (unit y=0) samples bottom of glyph in atlas.\n",
        "    v_atlasUV = vec2(\n",
        "        i_atlasUV.x + a_unitPos.x * i_atlasUV.z,\n",
        "        i_atlasUV.y + a_unitPos.y * i_atlasUV.w\n",
        "    );\n",
        "    v_color = i_color;\n",
        "    v_clipIndex = i_clipIndex;\n",
        "}\n",
    ]

    // ui/shaders/canvas_glyph.frag.glsl
    const CANVAS_GLYPH_FRAG: [_]c::String = [
        "#version 410\n",
        "\n",
        "layout(location = 0) in vec2 v_pixelPos;\n",
        "layout(location = 1) in vec2 v_atlasUV;\n",
        "layout(location = 2) flat in uint v_color;\n",
        "layout(location = 3) flat in uint v_clipIndex;\n",
        "\n",
        "layout(std140) uniform ClipRects {\n",
        "    vec4 u_clipRects[256];  // (left, bottom, right, top)\n",
        "    vec4 u_clipRounds[256]; // the rounded rect the clip is also cut to, (left, bottom, right, top)\n",
        "    vec4 u_clipRadii[256];  // that rect's corner radius in x; 0 when the clip is not rounded\n",
        "};\n",
        "\n",
        "// The projection, then the logical canvas size followed by the actual, rounded framebuffer size.\n",
        "// One std140 block, the same in every canvas shader: Vulkan's GLSL has no plain uniforms.\n",
        "layout(std140) uniform Canvas {\n",
        "    mat4 u_projection;\n",
        "    vec4 u_canvasMetrics;\n",
        "};\n",
        "\n",
        "uniform sampler2D u_atlas;\n",
        "\n",
        "out vec4 f_Color;\n",
        "\n",
        "vec4 unpackARGB(uint c) {\n",
        "    float a = float((c >> 24) & 0xFFu) / 255.0;\n",
        "    float r = float((c >> 16) & 0xFFu) / 255.0;\n",
        "    float g = float((c >>  8) & 0xFFu) / 255.0;\n",
        "    float b = float( c        & 0xFFu) / 255.0;\n",
        "    return vec4(r, g, b, a);\n",
        "}\n",
        "\n",
        "// How much of the pixel at p the clip's rounded rect covers: 1 inside it, 0 outside, and between over\n",
        "// the device pixel its edge crosses. Always 1 for a clip that is not rounded.\n",
        "float clipCoverage(vec2 p, uint index) {\n",
        "    float pixel = max(fwidth(p.x), 1e-4);\n",
        "    float r = u_clipRadii[index].x;\n",
        "    if (r <= 0.0) return 1.0;\n",
        "    vec4 rounded = u_clipRounds[index];\n",
        "    vec2 halfSize = (rounded.zw - rounded.xy) * 0.5;\n",
        "    vec2 q = abs(p - (rounded.xy + rounded.zw) * 0.5) - (halfSize - vec2(r));\n",
        "    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;\n",
        "    return clamp(0.5 - d / pixel, 0.0, 1.0);\n",
        "}\n",
        "\n",
        "void main() {\n",
        "    float clipCover = clipCoverage(v_pixelPos, v_clipIndex);\n",
        "    vec4 clip = u_clipRects[v_clipIndex];\n",
        "    if (v_pixelPos.x < clip.x || v_pixelPos.x >= clip.z ||\n",
        "        v_pixelPos.y < clip.y || v_pixelPos.y >= clip.w) {\n",
        "        discard;\n",
        "    }\n",
        "    if (clipCover <= 0.0) discard;\n",
        "\n",
        "    float alpha = texture(u_atlas, v_atlasUV).r;\n",
        "    if (alpha <= 0.0) discard;\n",
        "\n",
        "    vec4 color = unpackARGB(v_color);\n",
        "    f_Color = vec4(color.rgb, color.a * alpha);\n",
        "    f_Color.a *= clipCover;\n",
        "}\n",
    ]

    // ui/shaders/canvas_image.vert.glsl
    const CANVAS_IMAGE_VERT: [_]c::String = [
        "#version 410\n",
        "\n",
        "// Per-vertex\n",
        "layout(location = 0) in vec2 a_unitPos;     // [0,1] x [0,1]\n",
        "\n",
        "// Per-instance\n",
        "layout(location = 1) in vec4 i_rect;        // x, y, w, h (pixel space)\n",
        "layout(location = 2) in vec4 i_srcUV;       // u, v, w, h (normalized texture coords)\n",
        "layout(location = 3) in uint i_tint;        // ARGB packed\n",
        "layout(location = 4) in uint i_clipIndex;\n",
        "layout(location = 5) in float i_rotation;   // radians, rotation about the rect's center\n",
        "layout(location = 6) in vec4 i_cornerRadius; // tl, tr, br, bl\n",
        "\n",
        "// The projection, then the logical canvas size followed by the actual, rounded framebuffer size.\n",
        "// One std140 block, the same in every canvas shader: Vulkan's GLSL has no plain uniforms.\n",
        "layout(std140) uniform Canvas {\n",
        "    mat4 u_projection;\n",
        "    vec4 u_canvasMetrics;\n",
        "};\n",
        "\n",
        "layout(location = 0) out vec2 v_pixelPos;\n",
        "layout(location = 1) out vec2 v_uv;\n",
        "// Where the fragment is from the image's center in its own unrotated frame, and half its size.\n",
        "layout(location = 2) out vec2 v_local;\n",
        "layout(location = 3) flat out vec2 v_halfSize;\n",
        "// The image's own texels, which a grown edge is clamped to; and whether its edges fade at all \xE2\x80\x94 only\n",
        "// when the quad grew, so an image on the grid, or rotated, is drawn exactly as before.\n",
        "layout(location = 4) flat out vec4 v_srcUV;\n",
        "layout(location = 5) flat out float v_fadesEdges;\n",
        "layout(location = 6) flat out uint v_tint;\n",
        "layout(location = 7) flat out uint v_clipIndex;\n",
        "layout(location = 8) flat out vec4 v_cornerRadius;\n",
        "\n",
        "void main() {\n",
        "    // An unrotated image a transform left between device pixels grows a pixel on that axis, so the\n",
        "    // fragment shader can fade the pixels its edge partly covers; one on the grid stays as it was.\n",
        "    vec2 devicePerLogical = u_canvasMetrics.zw / u_canvasMetrics.xy;\n",
        "    vec2 low = i_rect.xy * devicePerLogical;\n",
        "    vec2 high = (i_rect.xy + i_rect.zw) * devicePerLogical;\n",
        "    vec2 offGrid = max(abs(low - round(low)), abs(high - round(high)));\n",
        "    bool growable = i_rotation == 0.0 && i_rect.z > 0.0 && i_rect.w > 0.0;\n",
        "    vec2 outset = growable ? step(1.0 / 256.0, offGrid) / devicePerLogical : vec2(0.0);\n",
        "    vec2 unit = (a_unitPos * (i_rect.zw + 2.0 * outset) - outset) / max(i_rect.zw, vec2(1e-6));\n",
        "\n",
        "    vec2 center = i_rect.xy + i_rect.zw * 0.5;\n",
        "    vec2 local = (unit - vec2(0.5)) * i_rect.zw;\n",
        "    float cs = cos(i_rotation);\n",
        "    float sn = sin(i_rotation);\n",
        "    vec2 rotated = vec2(cs * local.x - sn * local.y, sn * local.x + cs * local.y);\n",
        "    vec2 pixelPos = center + rotated;\n",
        "    gl_Position = u_projection * vec4(pixelPos, 0.0, 1.0);\n",
        "\n",
        "    v_pixelPos = pixelPos;\n",
        "    // Past the image's edge the texture clamps, so the grown pixels show its edge texels, faded.\n",
        "    v_uv = vec2(\n",
        "        i_srcUV.x + unit.x * i_srcUV.z,\n",
        "        i_srcUV.y + unit.y * i_srcUV.w\n",
        "    );\n",
        "    v_local = local;\n",
        "    v_halfSize = i_rect.zw * 0.5;\n",
        "    v_srcUV = i_srcUV;\n",
        "    v_fadesEdges = outset.x > 0.0 || outset.y > 0.0 ? 1.0 : 0.0;\n",
        "    v_tint = i_tint;\n",
        "    v_clipIndex = i_clipIndex;\n",
        "    v_cornerRadius = min(i_cornerRadius, vec4(min(i_rect.z, i_rect.w) * 0.5));\n",
        "}\n",
    ]

    // ui/shaders/canvas_image.frag.glsl
    const CANVAS_IMAGE_FRAG: [_]c::String = [
        "#version 410\n",
        "\n",
        "layout(location = 0) in vec2 v_pixelPos;\n",
        "layout(location = 1) in vec2 v_uv;\n",
        "layout(location = 2) in vec2 v_local;\n",
        "layout(location = 3) flat in vec2 v_halfSize;\n",
        "layout(location = 4) flat in vec4 v_srcUV;\n",
        "layout(location = 5) flat in float v_fadesEdges;\n",
        "layout(location = 6) flat in uint v_tint;\n",
        "layout(location = 7) flat in uint v_clipIndex;\n",
        "layout(location = 8) flat in vec4 v_cornerRadius;\n",
        "\n",
        "layout(std140) uniform ClipRects {\n",
        "    vec4 u_clipRects[256];  // (left, bottom, right, top)\n",
        "    vec4 u_clipRounds[256]; // the rounded rect the clip is also cut to, (left, bottom, right, top)\n",
        "    vec4 u_clipRadii[256];  // that rect's corner radius in x; 0 when the clip is not rounded\n",
        "};\n",
        "\n",
        "uniform sampler2D u_texture;\n",
        "// The projection, then the logical canvas size followed by the actual, rounded framebuffer size.\n",
        "// One std140 block, the same in every canvas shader: Vulkan's GLSL has no plain uniforms.\n",
        "layout(std140) uniform Canvas {\n",
        "    mat4 u_projection;\n",
        "    vec4 u_canvasMetrics;\n",
        "};\n",
        "\n",
        "out vec4 f_Color;\n",
        "\n",
        "vec4 unpackARGB(uint c) {\n",
        "    float a = float((c >> 24) & 0xFFu) / 255.0;\n",
        "    float r = float((c >> 16) & 0xFFu) / 255.0;\n",
        "    float g = float((c >>  8) & 0xFFu) / 255.0;\n",
        "    float b = float( c        & 0xFFu) / 255.0;\n",
        "    return vec4(r, g, b, a);\n",
        "}\n",
        "\n",
        "// How much of the pixel at p the clip's rounded rect covers: 1 inside it, 0 outside, and between over\n",
        "// the device pixel its edge crosses. Always 1 for a clip that is not rounded.\n",
        "float clipCoverage(vec2 p, uint index) {\n",
        "    float pixel = max(fwidth(p.x), 1e-4);\n",
        "    float r = u_clipRadii[index].x;\n",
        "    if (r <= 0.0) return 1.0;\n",
        "    vec4 rounded = u_clipRounds[index];\n",
        "    vec2 halfSize = (rounded.zw - rounded.xy) * 0.5;\n",
        "    vec2 q = abs(p - (rounded.xy + rounded.zw) * 0.5) - (halfSize - vec2(r));\n",
        "    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;\n",
        "    return clamp(0.5 - d / pixel, 0.0, 1.0);\n",
        "}\n",
        "\n",
        "void main() {\n",
        "    // The texture is read first, before any discard: a fragment that is discarded stops, and the fragments\n",
        "    // beside it in its 2 by 2 block then have no derivatives to pick a mip level by, so an image with mip\n",
        "    // levels drawn smaller than its texels would read the wrong level along the edge of every clip.\n",
        "    //\n",
        "    // An image shows its region once, so it never samples past the region's rim: the coordinate is held to\n",
        "    // the centres of the region's outermost texels. That is what CLAMP_TO_EDGE does for a whole texture, done\n",
        "    // here so it holds for a region of an atlas (whose neighbours the linear filter would otherwise reach\n",
        "    // into) and for a texture made to repeat (whose opposite side it would reach), whenever the image is\n",
        "    // drawn larger than its texels. A region under a texel wide is held to its middle.\n",
        "    vec2 uvEnd = v_srcUV.xy + v_srcUV.zw;\n",
        "    vec2 rim = 0.5 / vec2(textureSize(u_texture, 0));\n",
        "    vec2 uvLow = min(v_srcUV.xy, uvEnd) + rim;\n",
        "    vec2 uvHigh = max(v_srcUV.xy, uvEnd) - rim;\n",
        "    vec2 uv = clamp(v_uv, min(uvLow, uvHigh), max(uvLow, uvHigh));\n",
        "    vec4 sample0 = texture(u_texture, uv);\n",
        "\n",
        "    float clipCover = clipCoverage(v_pixelPos, v_clipIndex);\n",
        "    vec4 clip = u_clipRects[v_clipIndex];\n",
        "    if (v_pixelPos.x < clip.x || v_pixelPos.x >= clip.z ||\n",
        "        v_pixelPos.y < clip.y || v_pixelPos.y >= clip.w) {\n",
        "        discard;\n",
        "    }\n",
        "    if (clipCover <= 0.0) discard;\n",
        "\n",
        "    // An edge between device pixels fades the pixels it partly covers, by how much it covers them.\n",
        "    float coverage = 1.0;\n",
        "    if (v_fadesEdges > 0.0) {\n",
        "        vec2 devicePerLogical = u_canvasMetrics.zw / u_canvasMetrics.xy;\n",
        "        vec2 inside = (v_halfSize - abs(v_local)) * devicePerLogical;\n",
        "        coverage = clamp(inside.x + 0.5, 0.0, 1.0) * clamp(inside.y + 0.5, 0.0, 1.0);\n",
        "        if (coverage <= 0.0) discard;\n",
        "    }\n",
        "\n",
        "    // Rounded corners cut the image to their shape, smoothing its edge there over a device pixel. The\n",
        "    // canvas's y runs up, so a positive local y is the image's upper half.\n",
        "    float radius = v_local.y > 0.0\n",
        "        ? (v_local.x > 0.0 ? v_cornerRadius.y : v_cornerRadius.x)\n",
        "        : (v_local.x > 0.0 ? v_cornerRadius.z : v_cornerRadius.w);\n",
        "    if (radius > 0.0) {\n",
        "        vec2 devicePerLogical = u_canvasMetrics.zw / u_canvasMetrics.xy;\n",
        "        vec2 q = abs(v_local) - (v_halfSize - vec2(radius));\n",
        "        float distance = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;\n",
        "        coverage *= clamp(0.5 - distance * devicePerLogical.x, 0.0, 1.0);\n",
        "        if (coverage <= 0.0) discard;\n",
        "    }\n",
        "\n",
        "    vec4 tint = unpackARGB(v_tint);\n",
        "    f_Color = sample0 * tint * vec4(1.0, 1.0, 1.0, coverage);\n",
        "    f_Color.a *= clipCover;\n",
        "}\n",
    ]

    // ui/shaders/canvas_shape.vert.glsl
    const CANVAS_SHAPE_VERT: [_]c::String = [
        "#version 410\n",
        "\n",
        "// Per-vertex\n",
        "layout(location = 0) in vec2 a_unitPos;          // [0,1] x [0,1]\n",
        "\n",
        "// Per-instance\n",
        "layout(location = 1) in vec4 i_outerRect;        // x, y, w, h pixel space (drawn quad)\n",
        "layout(location = 2) in vec4 i_shapeData;        // line: p0.xy/p1.xy; circle: center.xy/radius; bezier: p0.xy/control.xy\n",
        "layout(location = 3) in vec4 i_shapeData2;       // bezier: p2.xy in .xy; line: dash/gap in .zw\n",
        "layout(location = 4) in float i_halfWidth;\n",
        "layout(location = 5) in uint i_color;            // ARGB packed\n",
        "layout(location = 6) in uint i_shapeType;        // 0 filled circle, 1 ring, 2 line/capsule, 3 quad bezier\n",
        "layout(location = 7) in uint i_clipIndex;\n",
        "layout(location = 8) in uint i_color2;           // line gradient end\n",
        "layout(location = 9) in uint i_flags;            // bits 0-1 cap, bit 2 dash, bit 3 gradient\n",
        "\n",
        "// The projection, then the logical canvas size followed by the actual, rounded framebuffer size.\n",
        "// One std140 block, the same in every canvas shader: Vulkan's GLSL has no plain uniforms.\n",
        "layout(std140) uniform Canvas {\n",
        "    mat4 u_projection;\n",
        "    vec4 u_canvasMetrics;\n",
        "};\n",
        "\n",
        "layout(location = 0) out vec2 v_pixelPos;\n",
        "layout(location = 1) out vec4 v_shapeData;\n",
        "layout(location = 2) out vec4 v_shapeData2;\n",
        "layout(location = 3) flat out float v_halfWidth;\n",
        "layout(location = 4) flat out uint v_color;\n",
        "layout(location = 5) flat out uint v_shapeType;\n",
        "layout(location = 6) flat out uint v_clipIndex;\n",
        "layout(location = 7) flat out uint v_color2;\n",
        "layout(location = 8) flat out uint v_flags;\n",
        "\n",
        "void main() {\n",
        "    vec2 pixelPos = i_outerRect.xy + a_unitPos * i_outerRect.zw;\n",
        "    gl_Position = u_projection * vec4(pixelPos, 0.0, 1.0);\n",
        "\n",
        "    v_pixelPos = pixelPos;\n",
        "    v_shapeData = i_shapeData;\n",
        "    v_shapeData2 = i_shapeData2;\n",
        "    v_halfWidth = i_halfWidth;\n",
        "    v_color = i_color;\n",
        "    v_shapeType = i_shapeType;\n",
        "    v_clipIndex = i_clipIndex;\n",
        "    v_color2 = i_color2;\n",
        "    v_flags = i_flags;\n",
        "}\n",
    ]

    // ui/shaders/canvas_shape.frag.glsl
    const CANVAS_SHAPE_FRAG: [_]c::String = [
        "#version 410\n",
        "\n",
        "// Generic anti-aliased SDF primitive: filled circle, ring (stroked circle) and\n",
        "// line/capsule. See canvas_shape.slang for the authoritative source; the OpenGL\n",
        "// backend uses this hand-written GLSL, matching the rest of the canvas pipeline.\n",
        "\n",
        "layout(location = 0) in vec2 v_pixelPos;\n",
        "layout(location = 1) in vec4 v_shapeData;\n",
        "layout(location = 2) in vec4 v_shapeData2;\n",
        "layout(location = 3) flat in float v_halfWidth;\n",
        "layout(location = 4) flat in uint v_color;\n",
        "layout(location = 5) flat in uint v_shapeType;\n",
        "layout(location = 6) flat in uint v_clipIndex;\n",
        "layout(location = 7) flat in uint v_color2;\n",
        "layout(location = 8) flat in uint v_flags;\n",
        "\n",
        "layout(std140) uniform ClipRects {\n",
        "    vec4 u_clipRects[256];  // (left, bottom, right, top)\n",
        "    vec4 u_clipRounds[256]; // the rounded rect the clip is also cut to, (left, bottom, right, top)\n",
        "    vec4 u_clipRadii[256];  // that rect's corner radius in x; 0 when the clip is not rounded\n",
        "};\n",
        "\n",
        "// The projection, then the logical canvas size followed by the actual, rounded framebuffer size.\n",
        "// One std140 block, the same in every canvas shader: Vulkan's GLSL has no plain uniforms.\n",
        "layout(std140) uniform Canvas {\n",
        "    mat4 u_projection;\n",
        "    vec4 u_canvasMetrics;\n",
        "};\n",
        "\n",
        "out vec4 f_Color;\n",
        "\n",
        "vec4 unpackARGB(uint c) {\n",
        "    float a = float((c >> 24) & 0xFFu) / 255.0;\n",
        "    float r = float((c >> 16) & 0xFFu) / 255.0;\n",
        "    float g = float((c >>  8) & 0xFFu) / 255.0;\n",
        "    float b = float( c        & 0xFFu) / 255.0;\n",
        "    return vec4(r, g, b, a);\n",
        "}\n",
        "\n",
        "float sdSegment(vec2 p, vec2 a, vec2 b) {\n",
        "    vec2 pa = p - a;\n",
        "    vec2 ba = b - a;\n",
        "    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);\n",
        "    return length(pa - ba * h);\n",
        "}\n",
        "\n",
        "// Stroked line with selectable cap: 0 round (capsule), 1 butt, 2 square.\n",
        "float sdLineCapped(vec2 p, vec2 a, vec2 b, float hw, uint cap) {\n",
        "    if (cap == 0u) return sdSegment(p, a, b) - hw;\n",
        "    vec2 ba = b - a;\n",
        "    float len = max(length(ba), 1e-6);\n",
        "    vec2 dir = ba / len;\n",
        "    vec2 rel = p - (a + b) * 0.5;\n",
        "    float along = abs(dot(rel, dir));\n",
        "    float perp = abs(dot(rel, vec2(-dir.y, dir.x)));\n",
        "    float capExt = (cap == 2u) ? hw : 0.0;\n",
        "    vec2 q = vec2(along - (len * 0.5 + capExt), perp - hw);\n",
        "    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);\n",
        "}\n",
        "\n",
        "// Distance + closest parameter t for the quadratic Bezier A->B->C (B = control).\n",
        "// Returns (distance, t). Source: Inigo Quilez (https://www.shadertoy.com/view/MlKcDD).\n",
        "vec2 sdBezier(vec2 p, vec2 A, vec2 B, vec2 C) {\n",
        "    vec2 b = A - 2.0 * B + C;\n",
        "    if (dot(b, b) < 1e-4) { // control collinear -> segment\n",
        "        vec2 ac = C - A;\n",
        "        float td = clamp(dot(p - A, ac) / max(dot(ac, ac), 1e-6), 0.0, 1.0);\n",
        "        return vec2(sdSegment(p, A, C), td);\n",
        "    }\n",
        "    vec2 a = B - A;\n",
        "    vec2 e = A - p;\n",
        "    float kk = 1.0 / dot(b, b);\n",
        "    float kx = kk * dot(a, b);\n",
        "    float ky = kk * (2.0 * dot(a, a) + dot(e, b)) / 3.0;\n",
        "    float kz = kk * dot(e, a);\n",
        "    float res;\n",
        "    float bestT;\n",
        "    float pp = ky - kx * kx;\n",
        "    float pp3 = pp * pp * pp;\n",
        "    float q = kx * (2.0 * kx * kx - 3.0 * ky) + kz;\n",
        "    float h = q * q + 4.0 * pp3;\n",
        "    if (h >= 0.0) {\n",
        "        h = sqrt(h);\n",
        "        vec2 x = (vec2(h, -h) - q) / 2.0;\n",
        "        vec2 uv = sign(x) * pow(abs(x), vec2(1.0 / 3.0));\n",
        "        float t = clamp(uv.x + uv.y - kx, 0.0, 1.0);\n",
        "        vec2 dd = e + (2.0 * a + b * t) * t;\n",
        "        res = dot(dd, dd);\n",
        "        bestT = t;\n",
        "    } else {\n",
        "        float z = sqrt(-pp);\n",
        "        float v = acos(q / (pp * z * 2.0)) / 3.0;\n",
        "        float m = cos(v);\n",
        "        float n = sin(v) * 1.732050808;\n",
        "        float t0 = clamp((m + m) * z - kx, 0.0, 1.0);\n",
        "        float t1 = clamp((-n - m) * z - kx, 0.0, 1.0);\n",
        "        vec2 d0 = e + (2.0 * a + b * t0) * t0;\n",
        "        vec2 d1 = e + (2.0 * a + b * t1) * t1;\n",
        "        float dd0 = dot(d0, d0);\n",
        "        float dd1 = dot(d1, d1);\n",
        "        res = min(dd0, dd1);\n",
        "        bestT = dd0 < dd1 ? t0 : t1;\n",
        "    }\n",
        "    return vec2(sqrt(res), bestT);\n",
        "}\n",
        "\n",
        "// Arc length along the quadratic Bezier A->B->C from 0 to t (trapezoidal).\n",
        "float bezierArcLength(vec2 A, vec2 B, vec2 C, float t) {\n",
        "    vec2 d0 = 2.0 * (B - A);\n",
        "    vec2 d1 = 2.0 * (C - B);\n",
        "    const int N = 16;\n",
        "    float step = t / float(N);\n",
        "    float prev = length(d0);\n",
        "    float total = 0.0;\n",
        "    for (int i = 1; i <= N; i++) {\n",
        "        float u = t * float(i) / float(N);\n",
        "        float cur = length(d0 * (1.0 - u) + d1 * u);\n",
        "        total += (prev + cur) * 0.5 * step;\n",
        "        prev = cur;\n",
        "    }\n",
        "    return total;\n",
        "}\n",
        "\n",
        "// How much of the pixel at p the clip's rounded rect covers: 1 inside it, 0 outside, and between over\n",
        "// the device pixel its edge crosses. Always 1 for a clip that is not rounded.\n",
        "float clipCoverage(vec2 p, uint index) {\n",
        "    float pixel = max(fwidth(p.x), 1e-4);\n",
        "    float r = u_clipRadii[index].x;\n",
        "    if (r <= 0.0) return 1.0;\n",
        "    vec4 rounded = u_clipRounds[index];\n",
        "    vec2 halfSize = (rounded.zw - rounded.xy) * 0.5;\n",
        "    vec2 q = abs(p - (rounded.xy + rounded.zw) * 0.5) - (halfSize - vec2(r));\n",
        "    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;\n",
        "    return clamp(0.5 - d / pixel, 0.0, 1.0);\n",
        "}\n",
        "\n",
        "void main() {\n",
        "    float clipCover = clipCoverage(v_pixelPos, v_clipIndex);\n",
        "    vec4 clip = u_clipRects[v_clipIndex];\n",
        "    if (v_pixelPos.x < clip.x || v_pixelPos.x >= clip.z ||\n",
        "        v_pixelPos.y < clip.y || v_pixelPos.y >= clip.w) {\n",
        "        discard;\n",
        "    }\n",
        "    if (clipCover <= 0.0) discard;\n",
        "\n",
        "    float d;\n",
        "    float bezierT = 0.0;\n",
        "    if (v_shapeType == 3u) {\n",
        "        // quadratic bezier stroke (round caps/joins)\n",
        "        vec2 bz = sdBezier(v_pixelPos, v_shapeData.xy, v_shapeData.zw, v_shapeData2.xy);\n",
        "        d = bz.x - v_halfWidth;\n",
        "        bezierT = bz.y;\n",
        "        if ((v_flags & 4u) != 0u) {\n",
        "            // dashing along the curve's arc length\n",
        "            float period = v_shapeData2.z + v_shapeData2.w;\n",
        "            if (period > 0.0) {\n",
        "                float s = bezierArcLength(v_shapeData.xy, v_shapeData.zw, v_shapeData2.xy, bezierT);\n",
        "                if ((s - period * floor(s / period)) > v_shapeData2.z) discard;\n",
        "            }\n",
        "        }\n",
        "    } else if (v_shapeType == 2u) {\n",
        "        // line with selectable cap\n",
        "        d = sdLineCapped(v_pixelPos, v_shapeData.xy, v_shapeData.zw, v_halfWidth, v_flags & 3u);\n",
        "        if ((v_flags & 4u) != 0u) {\n",
        "            // dashing: carve gaps along the arclength measured from p0\n",
        "            vec2 ba = v_shapeData.zw - v_shapeData.xy;\n",
        "            float len = max(length(ba), 1e-6);\n",
        "            float s = dot(v_pixelPos - v_shapeData.xy, ba / len);\n",
        "            float period = v_shapeData2.z + v_shapeData2.w;\n",
        "            if (period > 0.0 && (s - period * floor(s / period)) > v_shapeData2.z) discard;\n",
        "        }\n",
        "    } else if (v_shapeType == 1u) {\n",
        "        // ring: distance to the circle outline, then stroke half-width\n",
        "        d = abs(length(v_pixelPos - v_shapeData.xy) - v_shapeData.z) - v_halfWidth;\n",
        "    } else {\n",
        "        // filled circle\n",
        "        d = length(v_pixelPos - v_shapeData.xy) - v_shapeData.z;\n",
        "    }\n",
        "\n",
        "    // Analytic coverage: 1px transition centered on the zero isoline.\n",
        "    float aa = max(fwidth(d), 1e-6);\n",
        "    float coverage = clamp(0.5 - d / aa, 0.0, 1.0);\n",
        "    if (coverage <= 0.0) discard;\n",
        "\n",
        "    vec4 rgba = unpackARGB(v_color);\n",
        "    if ((v_flags & 8u) != 0u) {\n",
        "        // gradient: mix color -> color2 along the stroke\n",
        "        float g;\n",
        "        if (v_shapeType == 3u) {\n",
        "            g = bezierT;\n",
        "        } else {\n",
        "            vec2 ba = v_shapeData.zw - v_shapeData.xy;\n",
        "            g = clamp(dot(v_pixelPos - v_shapeData.xy, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);\n",
        "        }\n",
        "        rgba = mix(rgba, unpackARGB(v_color2), g);\n",
        "    }\n",
        "    f_Color = vec4(rgba.rgb, rgba.a * coverage);\n",
        "    f_Color.a *= clipCover;\n",
        "}\n",
    ]
}
