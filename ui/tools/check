#!/usr/bin/env bash
# Verifies ui/ in one command, and exits non-zero if anything failed: the shader check, every test
# package under ui/tests through `ctxc test` (each prints its failures and a summary line), the
# samples' scripted tours (the only end-to-end checks of the programs), then kotor/tools/uicompat.
# Tests that need what this machine lacks (a font, an OpenGL window) are left out by their
# package's `#test_main` with a `skip:` line each; the tours need an OpenGL window. Run it from
# anywhere; it works from the repository root, where the goldens' paths start.
#
#   ui/tools/check
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
cd "$ROOT"

failed=0
# Runs a command under a heading, and counts it when it fails.
run_step() {
    echo "== $*"
    if ! "$@"; then
        echo "FAILED: $*"
        failed=$((failed + 1))
    fi
}

# The embedded shaders match ui/shaders (plan section 2.6), checked where glslc is installed.
if command -v glslc >/dev/null 2>&1 || [ -x /g/Dev/msys64/mingw64/bin/glslc ]; then
    run_step ui/tools/build_shaders --check
fi
for dir in ui/tests/*/; do
    dir="${dir%/}"
    [ -f "$dir/build.ctx" ] || continue
    run_step kotor/tools/ctxc test "$dir"
done
run_step kotor/tools/ctxc run ui/samples/demo_gl -- --headless --script ui/samples/gallery/tour.txt --shot ui/out/tour.png
run_step kotor/tools/ctxc run ui/samples/tasks -- --headless --script ui/samples/tasks/tour.txt
run_step kotor/tools/ctxc run kotor/tools/uicompat

if [ "$failed" -ne 0 ]; then
    echo "ui/tools/check: $failed failed"
    exit 1
fi
echo "ui/tools/check: all passed"
