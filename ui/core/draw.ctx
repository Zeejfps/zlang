// ui::draw: the draw list on its own, for a surface with no widgets (kotor's minimap pass into a
// render target) and as what the core's emit step writes into. Coordinates are absolute.
//
// Nothing here fails: a shape that does not fit, a clip table that is full, or a clip index that
// names no entry drops the shape and adds one to `list.dropped`. A shape is never drawn unclipped
// in place of one that could not be clipped.
namespace ui {
    namespace draw {
        // Allocates every buffer once. `clips` counts entry 0, the whole surface, so it is at least 1.
        fn make(S) { realloc: alloc::Fn(S), mut heap: S, cmds: u32, text: u32, clips: u32, fonts: u32 } -> !DrawList {
            let clip_slots = if clips < 1 { 1 } else { clips }
            let c = try alloc::make(Cmd, S){ realloc, &heap, count = @as(usize, cmds) }
            let t = try alloc::make(u8, S){ realloc, &heap, count = @as(usize, text) }
            let f = try alloc::make(FontDef, S){ realloc, &heap, count = @as(usize, fonts) }
            let k = try alloc::make(Clip, S){ realloc, &heap, count = @as(usize, clip_slots) }
            return DrawList{
                cmds = c, count = 0, text = t, text_len = 0, fonts = f, font_count = 0, clips = k, clip_count = 1,
                width = 0.0, height = 0.0, scale_x = 1.0, scale_y = 1.0, dropped = 0,
            }
        }

        // Empties the list for a new frame of this size. The font table stays: fonts are registered
        // once. Entry 0 of the clip table is the whole surface.
        fn reset { mut list: DrawList, width: f32, height: f32, scale_x: f32, scale_y: f32 } {
            list.count = 0
            list.text_len = 0
            list.clip_count = 1
            list.clips[0] = Clip{ rect = Rect{ x = 0.0, y = 0.0, w = width, h = height }, .. }
            list.width = width
            list.height = height
            list.scale_x = scale_x
            list.scale_y = scale_y
            list.dropped = 0
        }

        // Appends one command, or counts it as dropped when the list is full.
        fn add { mut list: DrawList, cmd: Cmd } {
            if @as(usize, list.count) >= list.cmds.len {
                list.dropped = list.dropped + 1
                return
            }
            list.cmds[@as(usize, list.count)] = cmd
            list.count = list.count + 1
        }

        fn is_same_rect { a: Rect, b: Rect } -> bool {
            return a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h
        }

        // The index of `clip` in the clip table. Equal entries are shared, so a clip asked for twice
        // is added once. Null, and one dropped shape counted, when the table is full: the caller
        // then skips the shape it wanted this clip for and does not count it again.
        fn add_clip { mut list: DrawList, clip: Clip } -> ?u16 {
            let mut i: usize = 0
            while i < @as(usize, list.clip_count) {
                let c = list.clips[i]
                if is_same_rect{ a = c.rect, b = clip.rect } and is_same_rect{ a = c.round, b = clip.round } and c.radius == clip.radius {
                    return @as(u16, i)
                }
                i = i + 1
            }
            if i >= list.clips.len or i > 65535 {
                list.dropped = list.dropped + 1
                return null
            }
            list.clips[i] = clip
            list.clip_count = list.clip_count + 1
            return @as(u16, i)
        }

        // Whether `clip` names an entry of the table. A shape that does not is a caller's mistake;
        // add_* drops it and counts it rather than panic.
        fn has_clip { list: DrawList, clip: u16 } -> bool {
            return @as(u32, clip) < list.clip_count
        }

        fn add_rect { mut list: DrawList, rect: Rect, style: RectStyle, clip: u16 } {
            if not has_clip{ list, clip } {
                list.dropped = list.dropped + 1
                return
            }
            add{ &list, cmd = Cmd::rect{ rect, style, clip } }
        }

        fn add_image { mut list: DrawList, rect: Rect, region: Region, tint: Color, quarter: u8, angle: f32, radius: Corners, blend: Blend, clip: u16 } {
            if not has_clip{ list, clip } {
                list.dropped = list.dropped + 1
                return
            }
            add{ &list, cmd = Cmd::image{ rect, image = region.image, uv = region.uv, tint, quarter, angle, radius, blend, clip } }
        }

        fn add_line { mut list: DrawList, x0: f32, y0: f32, x1: f32, y1: f32, width: f32, color: Color, cap: Cap, clip: u16 } {
            if not has_clip{ list, clip } {
                list.dropped = list.dropped + 1
                return
            }
            add{ &list, cmd = Cmd::line{ x0, y0, x1, y1, width, color, cap, clip } }
        }

        // Copies `text` into the list's text arena, so the caller's bytes need not outlive the call.
        // A text that does not fit in the arena drops the whole shape.
        fn add_text { mut list: DrawList, font: Font, size: f32, x: f32, y: f32, text: []u8, color: Color, clip: u16 } {
            let start = @as(usize, list.text_len)
            if not has_clip{ list, clip } or text.len > list.text.len - start or text.len > 4294967295 {
                list.dropped = list.dropped + 1
                return
            }
            if @as(usize, list.count) >= list.cmds.len {
                list.dropped = list.dropped + 1
                return
            }
            slice::copy(u8){ dst = list.text[start..start + text.len], src = text }
            list.text_len = list.text_len + @as(u32, text.len)
            add{ &list, cmd = Cmd::text{ font, size, x, y, text = Span{ start = @as(u32, start), len = @as(u32, text.len) }, color, clip } }
        }

        // A rectangle the host draws itself, in order: shapes before it are under it.
        fn add_host { mut list: DrawList, slot: u32, rect: Rect } {
            add{ &list, cmd = Cmd::host{ slot, rect } }
        }

        // The bytes a text command points at.
        fn get_text { list: DrawList, span: Span } -> []u8 {
            let start = @as(usize, span.start)
            return list.text[start..start + @as(usize, span.len)]
        }
    }
}
