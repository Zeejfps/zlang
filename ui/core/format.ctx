// ui: number text into a caller's buffer, for what a format spec does not say: a digit count known
// only at run time with the dump's trimmed form (`format_fixed`, over std's `fmt::format_f32`),
// and the dump's uppercase hexadecimal and colours. A program formats numbers with `@fmt` and a
// spec (`@fmt(&ui, "{:.1} %", v)`): the Ui is a sink with writers for every spec. The recorder
// wraps these in `#write` functions of its own.
//
// All of them are infallible: text that does not fit `into` is cut at the end of the buffer, and
// the result says how many bytes were written.
namespace ui {
    const MAX_FIXED_DIGITS: u32 = 9

    // Appends `text` to `out` after the `used` bytes already there, as much as fits.
    fn append_text { out: []mut u8, mut used: usize, text: []u8 } {
        let mut i: usize = 0
        while i < text.len and used < out.len {
            out[used] = text[i]
            used = used + 1
            i = i + 1
        }
    }

    // `v` with exactly `digits` digits after the point (at most 9), as the language's `{:.N}`
    // writes it (std's `fmt::format_f32`: rounded to the nearest such number, a value exactly
    // halfway to the even digit, never in exponent form): 37.5 with 1 digit is `37.5`, 10.0 with 2
    // is `10.00`. Two things are the dump's own, which no spec writes: with `trim`, trailing zeros
    // and then a bare point are dropped, so `digits` is the most digits written (10.0 is `10`, 0.5
    // is `0.5`, -3.25 is `-3.25`); and a negative that rounds to zero is written without its sign.
    // NaN is `nan`, infinities `inf` and `-inf`. What does not fit `into` is cut at its end.
    fn format_fixed { v: f32, digits: u32, trim: bool, into: []mut u8 } -> usize {
        let d = if digits > MAX_FIXED_DIGITS { MAX_FIXED_DIGITS } else { digits }
        let mut buf: [fmt::LONGEST]u8
        let spec = fmt::Spec{ width = 0, precision = @as(i32, d), align = fmt::Align::natural, zero = false, base = 10, upper = false }
        let text = fmt::format_f32{ v = fmt::F32{ x = v, spec }, into = buf[..] }
        let mut from: usize = 0
        let mut to = text.len
        if to > 1 and text[0] == '-' {
            // `-0.00`: a sign on nothing but zeros is dropped.
            let mut zero = true
            for c in text[1..] {
                if c != '0' and c != '.' { zero = false }
            }
            if zero { from = 1 }
        }
        if trim and d > 0 and text[from..to].len > 0 and (text[to - 1] == '0' or text[to - 1] == '.') {
            let mut point = false
            for c in text[from..to] {
                if c == '.' { point = true }
            }
            if point {
                while to > from and text[to - 1] == '0' { to = to - 1 }
                if to > from and text[to - 1] == '.' { to = to - 1 }
            }
        }
        let mut n: usize = 0
        append_text{ out = into, used = &n, text = text[from..to] }
        return n
    }

    // `n` in uppercase hexadecimal, zero padded to at least `digits` digits (at most 16).
    fn format_hex { n: u64, digits: u32, into: []mut u8 } -> usize {
        let mut buf: [16]u8
        let mut k: usize = 16
        let mut v = n
        while k > 0 {
            k = k - 1
            let d = @as(u8, v & 15)
            buf[k] = if d < 10 { '0' + d } else { 'A' + (d - 10) }
            v = v >> 4
        }
        let want = if digits > 16 { 16 } else { @as(usize, digits) }
        // Skip leading zeros, but keep `want` digits and at least one.
        let mut first: usize = 0
        while first < 15 and buf[first] == '0' and 16 - first > want { first = first + 1 }
        let mut i: usize = 0
        while i < 16 - first and i < into.len {
            into[i] = buf[first + i]
            i = i + 1
        }
        return i
    }

    // A colour as RRGGBBAA, eight hex digits: the order the draw-list dump and the theme use.
    fn format_color { color: Color, into: []mut u8 } -> usize {
        let packed = (@as(u64, color.r) << 24) | (@as(u64, color.g) << 16) | (@as(u64, color.b) << 8) | @as(u64, color.a)
        return format_hex{ n = packed, digits = 8, into }
    }
}
