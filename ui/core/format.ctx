// ui: number formatting that does not depend on std's float printer, which writes an f32 `10.0`
// as `1e+01` and `100.0` as `1e+02` and has no precision. These write into a caller's buffer;
// the sinks that `@fmt` writes into (the frame's text arena, the recorder) wrap them in `#write`
// functions of their own.
//
// All of them are infallible: text that does not fit `into` is cut at the end of the buffer, and
// the result says how many bytes were written.
namespace ui {
    const MAX_FIXED_DIGITS: u32 = 9

    // Appends `text` to `out` after the `used` bytes already there, as much as fits.
    fn append_text { out: []mut u8, mut used: usize, text: []u8 } {
        let mut i: usize = 0
        while i < text.len and used < out.len {
            out[used] = text[i]
            used = used + 1
            i = i + 1
        }
    }

    // `v` with exactly `digits` digits after the point (at most 9): 37.5 with 1 digit is `37.5`,
    // 10.0 with 2 is `10.00`. With `trim`, trailing zeros and then a bare point are dropped, so
    // `digits` is the most digits written: 10.0 is `10`, 0.5 is `0.5`, -3.25 is `-3.25`.
    // Rounds half away from zero. A negative that rounds to zero is written without its sign.
    // NaN is `nan`, infinities `inf` and `-inf`, and a magnitude beyond 9e18 `huge` or `-huge`.
    fn format_fixed { v: f32, digits: u32, trim: bool, into: []mut u8 } -> usize {
        let mut buf: [48]u8
        let mut n: usize = 0
        if v != v {
            append_text{ out = buf[..], used = &n, text = "nan" }
        } else if v - v != 0.0 {
            append_text{ out = buf[..], used = &n, text = if v < 0.0 { "-inf" } else { "inf" } }
        } else {
            let neg = v < 0.0
            let m: f64 = @as(f64, if neg { 0.0 - v } else { v })
            let d = if digits > MAX_FIXED_DIGITS { MAX_FIXED_DIGITS } else { digits }
            let mut p: f64 = 1.0
            let mut k: u32 = 0
            while k < d {
                p = p * 10.0
                k = k + 1
            }
            let scaled_f: f64 = m * p + 0.5
            if scaled_f >= 9.0e18 {
                append_text{ out = buf[..], used = &n, text = if neg { "-huge" } else { "huge" } }
            } else {
                let scaled = @as(i64, scaled_f)
                let unit = @as(i64, p)
                if neg and scaled != 0 { append_text{ out = buf[..], used = &n, text = "-" } }
                let mut whole_buf: [20]u8
                append_text{ out = buf[..], used = &n, text = utf8::fmt_i64{ n = scaled / unit, into = whole_buf[..] }.bytes }
                if d > 0 {
                    append_fraction{ out = buf[..], used = &n, frac = scaled % unit, digits = d, trim }
                }
            }
        }
        let mut i: usize = 0
        while i < n and i < into.len {
            into[i] = buf[i]
            i = i + 1
        }
        return i
    }

    // The point and `digits` digits of `frac`, zero padded on the left, with trailing zeros (and
    // the point, when nothing is left) dropped if `trim`.
    fn append_fraction { out: []mut u8, mut used: usize, frac: i64, digits: u32, trim: bool } {
        let mut fd: [9]u8
        let mut k = @as(usize, digits)
        let mut f = frac
        while k > 0 {
            k = k - 1
            fd[k] = '0' + @as(u8, f % 10)
            f = f / 10
        }
        let mut count = @as(usize, digits)
        if trim {
            while count > 0 and fd[count - 1] == '0' { count = count - 1 }
        }
        if count > 0 {
            append_text{ out, used = &used, text = "." }
            append_text{ out, used = &used, text = fd[..count] }
        }
    }

    // `n` in uppercase hexadecimal, zero padded to at least `digits` digits (at most 16).
    fn format_hex { n: u64, digits: u32, into: []mut u8 } -> usize {
        let mut buf: [16]u8
        let mut k: usize = 16
        let mut v = n
        while k > 0 {
            k = k - 1
            let d = @as(u8, v & 15)
            buf[k] = if d < 10 { '0' + d } else { 'A' + (d - 10) }
            v = v >> 4
        }
        let want = if digits > 16 { 16 } else { @as(usize, digits) }
        // Skip leading zeros, but keep `want` digits and at least one.
        let mut first: usize = 0
        while first < 15 and buf[first] == '0' and 16 - first > want { first = first + 1 }
        let mut i: usize = 0
        while i < 16 - first and i < into.len {
            into[i] = buf[first + i]
            i = i + 1
        }
        return i
    }

    // A colour as RRGGBBAA, eight hex digits: the order the draw-list dump and the theme use.
    fn format_color { color: Color, into: []mut u8 } -> usize {
        let packed = (@as(u64, color.r) << 24) | (@as(u64, color.g) << 16) | (@as(u64, color.b) << 8) | @as(u64, color.a)
        return format_hex{ n = packed, digits = 8, into }
    }
}
