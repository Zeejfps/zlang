// ui: the host seam's input and requests (plan section 2.8). Everything on the OS side is input the
// host pushes (`Event`) or a request the host applies after the frame (`Requests`); the core calls
// nothing. `FrameInfo`, the third piece, is declared with the frame in ui.ctx.
//
// Positions are device pixels (i32), y down, origin at the surface's top left: the host converts
// whatever its window system reports (ui_sdl does), so the core never scales a pointer. Typed text
// is in the focused font's encoding.
namespace ui {
    // A key, by what it is on a US layout (a host maps the OS's key codes, which follow the layout's
    // letters). `menu` is the context-menu key. `alt` is not a key the host sends: the core makes a
    // stroke of it when Alt goes down and comes up with no other key or press between (a host sends
    // the Alt key itself as `none` with its modifier, as it sends Shift), which is how Alt alone
    // reaches a menu bar. The keys after `menu` came later and are listed after it, so the numbers
    // of the first ones did not change.
    enum Key: u8 {
        none, tab, enter, escape, backspace, delete, left, right, up, down, home, end, page_up, page_down, space, a, c, v, x, y, z, menu,
        insert,
        b, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, w,
        digit_0, digit_1, digit_2, digit_3, digit_4, digit_5, digit_6, digit_7, digit_8, digit_9,
        f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12,
        minus, equals, plus, comma, period, slash, backslash, semicolon, apostrophe, grave, left_bracket, right_bracket,
        alt,
    }

    // What a shortcut is: a key and exactly the modifiers held with it (MOD_SHIFT, MOD_CTRL,
    // MOD_ALT). `Key::none` is no shortcut.
    struct Shortcut { key: Key = Key::none, mods: u8 = 0 }
    const MOD_SHIFT: u8 = 1
    const MOD_CTRL: u8 = 2
    const MOD_ALT: u8 = 4
    union Event {
        pointer_move{ x: i32, y: i32 },                    // device pixels
        pointer_button{ button: u8, down: bool, clicks: u8 },
        pointer_leave,
        wheel{ dx: f32, dy: f32 },                         // notches, fractional on a smooth wheel
        key{ key: Key, down: bool, repeat: bool, mods: u8 },
        text{ bytes: [32]u8, len: u8 },                    // committed text, in the focused font's encoding
        paste{ text: []u8 },                               // the host's answer to Requests.paste; copied at the push
        focus{ gained: bool },
    }
    enum Cursor: u8 { arrow, text, hand, resize_h, resize_v, resize_diag, move, hidden }
    struct Requests {
        cursor: Cursor = Cursor::arrow,
        wants_pointer: bool = false, wants_keys: bool = false,
        text_input: bool = false, text_rect: Rect = Rect{ .. },   // turn OS text input on; where the caret is, in device pixels
        copy: []u8 = "", paste: bool = false,                     // set the clipboard; send me a paste event
        animating: bool = false,                                  // something moves with time: draw another frame
        // Something changes at a known time (a caret's blink, a tooltip's delay): draw a frame this
        // many seconds of frame time after this one, or sooner. Null: nothing is waiting. With
        // `animating` the next frame is due at once anyway.
        wake: ?f32 = null,
    }
}
