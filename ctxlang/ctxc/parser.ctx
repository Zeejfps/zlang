// The parser: tokens to a syntax tree (syntax.ctx), a port of ctxi/parser.py.
//
//   let lexed = lexer::lex{ text, file, &heap, &diags }
//   let tree = parser::parse{ text, file, tokens = lexed.tokens, &heap, &diags }
//
// Up to its first error it takes ctxi's path exactly, so it reports what ctxi reports, at the
// same token. Then, instead of stopping, it recovers:
//
// - An error sets `bad`, and while it is set the parser sees the end of the file. Every loop
//   ends, nothing more is consumed, and each parse function returns what it has, with error nodes
//   and missing names for the rest. That unwinds to the nearest statement, match arm or
//   declaration.
// - There the parser skips to a synchronization point (sync), clears `bad` and goes on.
// - An error is only reported if a token has been consumed since the last one, so one mistake
//   makes one diagnostic. The lexer has already reported its error tokens: one where an
//   expression or a type belongs becomes an error node, and anywhere else the parser fails there
//   without a message.

namespace parser {
    // Deeper nesting of expressions, types or blocks is an error rather than a risk to the stack.
    const MAX_DEPTH: u32 = 256

    struct Parser {
        text:    []u8,
        file:    u32,
        toks:    []tok::Token,         // ends with an eof token
        i:       usize,
        heap:    *mut arena::Arena,
        diags:   *mut diag::Diags,
        ids:     u32,
        in_cond: bool,                 // in a condition or scrutinee, outside any brackets
        depth:   u32,
        bad:     bool,                 // an error, not yet recovered from
        errored: bool,                 // an error has been reported, when the
        err_at:  usize,                // parser was at this token
        hand:    Handler,              // what null_expr last returned
        // The token after a block's `}` in a condition, where the `}` ends a line and the next
        // starts with `-` or `&`: a statement begins there, which the condition may have been
        // meant to go on with (brace_is_call). 0 for none. cond_mark: the diagnostics before
        // that block. cond_items: the block's braces could hold a call's items instead.
        cond_break: usize,
        cond_mark:  diag::Mark,
        cond_items: bool,
        // In a match arm without braces: the `-` that begins the next line and the next arm's
        // pattern, where the arm's expression ends (arm_end). 0 for none.
        arm_end: usize,
    }

    // Whether the expression null_expr returned is a handler's, `l ifnull r`, `l iferr r` or
    // `l ifoverflow r`, as written, without parentheses round it (bare), for the operators that
    // can't sit beside one (mixed). With several, l is the first's left side and r the last's
    // right side: block if that is a block. first and last are their keywords.
    struct Handler { bare: bool, block: bool, first: tok::Token, last: tok::Token, left_end: u32, right_start: u32 }

    fn parse { text: []u8, file: u32, tokens: []tok::Token, mut heap: arena::Arena, mut diags: diag::Diags } -> syntax::File {
        let mut p = Parser{
            text, file, toks = tokens, i = 0, heap = &heap, diags = &diags, ids = 0,
            in_cond = false, depth = 0, bad = false, errored = false, err_at = 0,
            hand = Handler{ bare = false, block = false, first = tokens[0], last = tokens[0], left_end = 0, right_start = 0 },
            cond_break = 0, cond_mark = diag::mark{ diags }, cond_items = false, arm_end = 0,
        }
        let decls = decl_list{ &p, top = true }
        return syntax::File{ decls, ids = p.ids }
    }

    // ---- declarations

    // Declarations up to the end of the file, or up to the `}` of a namespace.
    fn decl_list { mut p: Parser, top: bool } -> []syntax::Decl {
        let mut xs = list::new(syntax::Decl){ realloc = arena::alloc, heap = p.heap }
        skip_semis{ &p }
        while true {
            if top {
                if next_is{ p, k = tok::Kind::eof } { break }
            } else if next_is{ p, k = tok::Kind::rbrace } {
                break
            } else if next_is{ p, k = tok::Kind::eof } {
                fail{ &p, msg = "expected '}' to close namespace" }
                break
            }
            let start = p.i
            try! list::push{ list = &xs, item = decl{ &p } }
            if p.bad {
                sync{ &p, start, in_block = false, top }
                if p.i == start { p.i = p.i + 1 }
            }
            skip_semis{ &p }
        }
        return list::items{ list = xs }
    }

    fn decl { mut p: Parser } -> syntax::Decl {
        let attrs = attributes{ &p, field = false }
        let start = p.i
        let id = new_id{ &p }
        let k = kind{ p, ahead = 0 }
        let mut d = syntax::DeclKind::error
        if p.bad {
            // a bad attribute: the declaration is skipped with it
        } else if k == tok::Kind::kw_fn {
            skip{ &p }
            let name = ident{ &p }
            let tps = fn_tparams{ &p }
            if body_as_context{ p } {
                failf{ &p, msg = @fmt("a function's context comes before its body: write `fn {} {{}} {{ ... }}`", utf8::String{ bytes = name.text }) }
            }
            let params = ctx_fields{ &p, decl = true }
            let ret: ?syntax::TypeExpr = if accept{ &p, k = tok::Kind::arrow } { type_expr{ &p } } else { null }
            d = syntax::DeclKind::func{ name, tparams = tps.names, tsets = tps.sets, params, ret, body = block{ &p }, external = false }
        } else if k == tok::Kind::kw_extern and kind{ p, ahead = 1 } == tok::Kind::kw_union {
            skip{ &p }
            skip{ &p }
            let name = ident{ &p }
            if next_is{ p, k = tok::Kind::lparen } { fail{ &p, msg = "an extern union cannot have generic parameters" } }
            d = syntax::DeclKind::record{ name, tparams = slice::empty(syntax::Name){}, fields = plain_fields{ &p }, untagged = true }
        } else if k == tok::Kind::kw_extern {
            skip{ &p }
            expect{ &p, k = tok::Kind::kw_fn }
            let name = ident{ &p }
            if next_is{ p, k = tok::Kind::lparen } { fail{ &p, msg = "an extern fn cannot have generic parameters" } }
            let params = ctx_fields{ &p, decl = true }
            let ret: ?syntax::TypeExpr = if accept{ &p, k = tok::Kind::arrow } { type_expr{ &p } } else { null }
            if next_is{ p, k = tok::Kind::lbrace } and not nl{ p } { fail{ &p, msg = "an extern fn has no body: C provides it" } }
            let at = prev_end{ p }
            let body = syntax::Block{ id = new_id{ &p }, span = source::Span{ file = p.file, start = at, end = at }, stmts = slice::empty(syntax::Stmt){} }
            d = syntax::DeclKind::func{ name, tparams = slice::empty(syntax::Name){}, tsets = slice::empty(bool){}, params, ret, body, external = true }
        } else if k == tok::Kind::kw_struct {
            skip{ &p }
            let name = ident{ &p }
            let tparams = tparams{ &p }
            d = syntax::DeclKind::record{ name, tparams, fields = plain_fields{ &p }, untagged = false }
        } else if k == tok::Kind::kw_union {
            skip{ &p }
            let name = ident{ &p }
            let tparams = tparams{ &p }
            d = syntax::DeclKind::sum{ name, tparams, variants = variants{ &p } }
        } else if k == tok::Kind::kw_enum {
            skip{ &p }
            let name = ident{ &p }
            if next_is{ p, k = tok::Kind::lparen } { fail{ &p, msg = "an enum cannot have generic parameters" } }
            expect{ &p, k = tok::Kind::colon }
            let base = type_expr{ &p }
            d = syntax::DeclKind::enumeration{ name, base, variants = enum_variants{ &p } }
        } else if k == tok::Kind::kw_type {
            skip{ &p }
            let name = ident{ &p }
            let tparams = tparams{ &p }
            expect{ &p, k = tok::Kind::assign }
            let distinct = at_distinct{ p }
            if distinct { skip{ &p } }
            d = syntax::DeclKind::alias{ name, tparams, ty = type_expr{ &p }, distinct }
        } else if k == tok::Kind::kw_const {
            skip{ &p }
            let name = ident{ &p }
            expect{ &p, k = tok::Kind::colon }
            let ty = type_expr{ &p }
            expect{ &p, k = tok::Kind::assign }
            d = syntax::DeclKind::constant{ name, ty, value = expr{ &p } }
        } else if k == tok::Kind::kw_capability {
            skip{ &p }
            let name = ident{ &p }
            if next_is{ p, k = tok::Kind::lparen } and not nl{ p } { fail{ &p, msg = "a capability cannot have generic parameters" } }
            let mut fields: ?[]syntax::Field = null
            let mut includes = list::new(syntax::Include){ realloc = arena::alloc, heap = p.heap }
            if next_is{ p, k = tok::Kind::lbrace } and not nl{ p } {
                let open = p.i
                let fs = cap_fields{ &p, includes = &includes }
                if fs.len == 0 and includes.len == 0 and not p.bad { fail_at{ &p, msg = "a capability without fields has no braces: write `capability Name`", t = p.toks[open] } }
                fields = fs
            }
            d = syntax::DeclKind::cap{ name, fields, includes = list::items{ list = includes } }
        } else if at_error_decl{ p } {
            // `error name` or `error name{ fields }`: `error` is a keyword only here, where a
            // declaration begins and a name follows it.
            skip{ &p }
            let name = ident{ &p }
            if next_is{ p, k = tok::Kind::lparen } and not nl{ p } { fail{ &p, msg = "an error cannot have generic parameters" } }
            let fields: ?[]syntax::Field = if next_is{ p, k = tok::Kind::lbrace } and not nl{ p } { plain_fields{ &p } } else { null }
            d = syntax::DeclKind::fault{ name, fields }
        } else if k == tok::Kind::kw_namespace {
            skip{ &p }
            let name = ident{ &p }
            expect{ &p, k = tok::Kind::lbrace }
            let decls = decl_list{ &p, top = false }
            expect{ &p, k = tok::Kind::rbrace }
            d = syntax::DeclKind::space{ name, decls }
        } else {
            expected{ &p, what = "a declaration" }
        }
        return syntax::Decl{ id, span = span_from{ p, start }, attrs, k = d }
    }

    // The attributes before a declaration, or before a field of one (a struct's, an extern
    // union's, a union variant's, an error's, a capability's or a fn's context's): `#path` or
    // `#path{ field = value, ... }`, each on its own line. A bare `#path` gets empty braces, so
    // every attribute is a literal.
    fn attributes { mut p: Parser, field: bool } -> []syntax::Attr {
        let mut xs = list::new(syntax::Attr){ realloc = arena::alloc, heap = p.heap }
        while next_is{ p, k = tok::Kind::hash } and not p.bad {
            let start = p.i
            skip{ &p }
            if not next_is{ p, k = tok::Kind::ident } {
                expected{ &p, what = "a struct name after '#'" }
                break
            }
            let e = postfix{ &p }
            if p.bad { break }
            let mut value = e
            let mut ok = false
            match e.k {
                path => {
                    let k = syntax::ExprKind::braced{ callee = box{ &p, value = e }, items = slice::empty(syntax::Item){}, forward = false, bind = false }
                    value = syntax::Expr{ id = new_id{ &p }, span = e.span, at = e.span.start, k }
                    ok = true
                }
                // `..` takes fields from their defaults, as in any struct literal (§7).
                braced{ callee, bind } => {
                    if callee.k is path { ok = not bind }
                }
                else => {}
            }
            if not ok {
                fail_at{ &p, msg = "an attribute is a struct name or a struct literal", t = p.toks[start + 1] }
                break
            }
            if not nl{ p } {
                fail{ &p, msg = if field { "an attribute goes on its own line, before a field" } else { "an attribute goes on its own line, before a declaration" } }
                break
            }
            try! list::push{ list = &xs, item = syntax::Attr{ span = span_from{ p, start }, value } }
        }
        if xs.len > 0 and not p.bad {
            let k = kind{ p, ahead = 0 }
            if field {
                if k != tok::Kind::ident and k != tok::Kind::kw_extern and k != tok::Kind::kw_mut { expected{ &p, what = "a field after an attribute" } }
            } else if not is_decl_start{ k } and not at_error_decl{ p } {
                expected{ &p, what = "a declaration after an attribute" }
            }
        }
        return list::items{ list = xs }
    }

    // Whether the `{ ... }` here, where a function's context belongs, is its body instead: it
    // doesn't start like a context (`}`, `mut`, `name:` or an attribute's `#`), it is closed, and
    // neither a body nor `->` follows it.
    fn body_as_context { p: Parser } -> bool {
        if not next_is{ p, k = tok::Kind::lbrace } { return false }
        let first = kind{ p, ahead = 1 }
        if first == tok::Kind::rbrace or first == tok::Kind::kw_mut or first == tok::Kind::hash
           or (first == tok::Kind::ident and kind{ p, ahead = 2 } == tok::Kind::colon) {
            return false
        }
        let mut depth: u32 = 0
        let mut k = p.i
        while p.toks[k].kind != tok::Kind::eof {
            let x = p.toks[k].kind
            if x == tok::Kind::lbrace {
                depth = depth + 1
            } else if x == tok::Kind::rbrace {
                depth = depth - 1
                if depth == 0 {
                    let after = p.toks[k + 1].kind
                    return not (after == tok::Kind::lbrace or after == tok::Kind::arrow)
                }
            }
            k = k + 1
        }
        return false            // unclosed: no telling what it was meant to be
    }

    fn tparams { mut p: Parser } -> []syntax::Name {
        let mut xs = list::new(syntax::Name){ realloc = arena::alloc, heap = p.heap }
        if accept{ &p, k = tok::Kind::lparen } {
            try! list::push{ list = &xs, item = ident{ &p } }
            while accept{ &p, k = tok::Kind::comma } { try! list::push{ list = &xs, item = ident{ &p } } }
            expect{ &p, k = tok::Kind::rparen }
        }
        return list::items{ list = xs }
    }

    struct TParams { names: []syntax::Name, sets: []bool }

    // A function's `(T, E: error, ...)`: its generic parameters, and which are error sets (§9).
    fn fn_tparams { mut p: Parser } -> TParams {
        let mut xs = list::new(syntax::Name){ realloc = arena::alloc, heap = p.heap }
        let mut sets = list::new(bool){ realloc = arena::alloc, heap = p.heap }
        if accept{ &p, k = tok::Kind::lparen } {
            while true {
                try! list::push{ list = &xs, item = ident{ &p } }
                let mut set = false
                if accept{ &p, k = tok::Kind::colon } {
                    let kind = ident{ &p }
                    if slice::eq_bytes{ a = kind.text, b = "error" } {
                        set = true
                    } else if kind.text.len > 0 {
                        fail{ &p, msg = "a generic parameter's kind is `error`, an error set: `E: error`" }
                    }
                }
                try! list::push{ list = &sets, item = set }
                if not accept{ &p, k = tok::Kind::comma } { break }
            }
            expect{ &p, k = tok::Kind::rparen }
        }
        return TParams{ names = list::items{ list = xs }, sets = list::items{ list = sets } }
    }

    // `{ mut name: T, ... }`, the context of a function, whose fields may have attributes, or of
    // a function type (decl false), whose fields declare nothing and so have none.
    fn ctx_fields { mut p: Parser, decl: bool } -> []syntax::Param {
        let mut xs = list::new(syntax::Param){ realloc = arena::alloc, heap = p.heap }
        expect{ &p, k = tok::Kind::lbrace }
        while more{ p, close = tok::Kind::rbrace } {
            let mut attrs: []syntax::Attr = slice::empty(syntax::Attr){}
            if decl {
                attrs = attributes{ &p, field = true }
            } else if next_is{ p, k = tok::Kind::hash } {
                fail{ &p, msg = "a function type's fields can't have attributes: only a declaration's fields can" }
            }
            let start = p.i
            let mutable = accept{ &p, k = tok::Kind::kw_mut }
            let name = ident{ &p }
            expect{ &p, k = tok::Kind::colon }
            let ty = type_expr{ &p }
            try! list::push{ list = &xs, item = syntax::Param{ span = span_from{ p, start }, attrs, mutable, name, ty } }
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        expect{ &p, k = tok::Kind::rbrace }
        return list::items{ list = xs }
    }

    // `{ name: T, name: T = e, ... }`, of a struct, an extern union, a union variant or an error,
    // each field with its attributes and maybe a default, which only a struct's may have (the
    // checker says so).
    fn plain_fields { mut p: Parser } -> []syntax::Field {
        let mut xs = list::new(syntax::Field){ realloc = arena::alloc, heap = p.heap }
        expect{ &p, k = tok::Kind::lbrace }
        while more{ p, close = tok::Kind::rbrace } {
            let attrs = attributes{ &p, field = true }
            let start = p.i
            let name = ident{ &p }
            expect{ &p, k = tok::Kind::colon }
            let ty = type_expr{ &p }
            let mut default: ?syntax::Expr = null
            let mut default_id: u32 = 0
            if accept{ &p, k = tok::Kind::assign } {
                default = expr{ &p }
                default_id = new_id{ &p }
            }
            try! list::push{ list = &xs, item = syntax::Field{ span = span_from{ p, start }, attrs, name, ty, external = false, stat = false, default, default_id } }
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        expect{ &p, k = tok::Kind::rbrace }
        return list::items{ list = xs }
    }

    // A capability's `{ name: T, extern name: T, static name: T, ..Name, ... }`: its fields, C
    // variables and statics among them, and in includes each `..Name`.
    fn cap_fields { mut p: Parser, mut includes: list::List(syntax::Include, arena::Arena) } -> []syntax::Field {
        let mut xs = list::new(syntax::Field){ realloc = arena::alloc, heap = p.heap }
        expect{ &p, k = tok::Kind::lbrace }
        while more{ p, close = tok::Kind::rbrace } {
            let attrs = attributes{ &p, field = true }
            let start = p.i
            if accept{ &p, k = tok::Kind::dots } {
                let ty = type_expr{ &p }
                try! list::push{ list = &includes, item = syntax::Include{ span = span_from{ p, start }, ty, at = xs.len } }
            } else {
                let external = accept{ &p, k = tok::Kind::kw_extern }
                // `static` is a keyword only here, before a name: elsewhere it is a name.
                let stat = not external and next_is{ p, k = tok::Kind::ident } and kind{ p, ahead = 1 } == tok::Kind::ident
                           and slice::eq_bytes{ a = text_of{ p, t = p.toks[p.i] }, b = "static" }
                if stat { skip{ &p } }
                let name = ident{ &p }
                expect{ &p, k = tok::Kind::colon }
                let ty = type_expr{ &p }
                try! list::push{ list = &xs, item = syntax::Field{ span = span_from{ p, start }, attrs, name, ty, external, stat, default = null, default_id = 0 } }
            }
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        expect{ &p, k = tok::Kind::rbrace }
        return list::items{ list = xs }
    }

    fn variants { mut p: Parser } -> []syntax::Variant {
        let mut xs = list::new(syntax::Variant){ realloc = arena::alloc, heap = p.heap }
        expect{ &p, k = tok::Kind::lbrace }
        while more{ p, close = tok::Kind::rbrace } {
            let start = p.i
            let name = ident{ &p }
            let fields: ?[]syntax::Field = if next_is{ p, k = tok::Kind::lbrace } { plain_fields{ &p } } else { null }
            try! list::push{ list = &xs, item = syntax::Variant{ span = span_from{ p, start }, name, fields } }
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        expect{ &p, k = tok::Kind::rbrace }
        return list::items{ list = xs }
    }

    fn enum_variants { mut p: Parser } -> []syntax::EnumVariant {
        let mut xs = list::new(syntax::EnumVariant){ realloc = arena::alloc, heap = p.heap }
        expect{ &p, k = tok::Kind::lbrace }
        while more{ p, close = tok::Kind::rbrace } {
            let start = p.i
            let name = ident{ &p }
            let value: ?syntax::Expr = if accept{ &p, k = tok::Kind::assign } { expr{ &p } } else { null }
            try! list::push{ list = &xs, item = syntax::EnumVariant{ span = span_from{ p, start }, name, value } }
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        expect{ &p, k = tok::Kind::rbrace }
        return list::items{ list = xs }
    }

    // ---- types

    fn type_expr { mut p: Parser } -> syntax::TypeExpr {
        let start = p.i
        let id = new_id{ &p }
        if not enter{ &p } { return syntax::TypeExpr{ id, span = span_from{ p, start }, k = syntax::TypeKind::error } }
        defer p.depth = p.depth - 1
        let k = kind{ p, ahead = 0 }
        let mut t = syntax::TypeKind::error
        if k == tok::Kind::star {
            skip{ &p }
            let mutable = accept{ &p, k = tok::Kind::kw_mut }
            t = syntax::TypeKind::ptr{ mutable, elem = box{ &p, value = type_expr{ &p } } }
        } else if k == tok::Kind::question {
            skip{ &p }
            t = syntax::TypeKind::opt{ elem = box{ &p, value = type_expr{ &p } } }
        } else if k == tok::Kind::bang {
            // `!T`, or `!` alone where no type follows on its line: a function that returns no
            // value or fails.
            skip{ &p }
            let mut elem: ?*syntax::TypeExpr = null
            if starts_type{ p } and not nl{ p } { elem = box{ &p, value = type_expr{ &p } } }
            t = syntax::TypeKind::fail{ elem, set = null }
        } else if k == tok::Kind::lbracket {
            skip{ &p }
            if accept{ &p, k = tok::Kind::rbracket } {
                let mutable = accept{ &p, k = tok::Kind::kw_mut }
                t = syntax::TypeKind::slice{ mutable, elem = box{ &p, value = type_expr{ &p } } }
            } else {
                let n = box{ &p, value = expr{ &p } }
                expect{ &p, k = tok::Kind::rbracket }
                t = syntax::TypeKind::array{ n, elem = box{ &p, value = type_expr{ &p } } }
            }
        } else if k == tok::Kind::kw_fn or (k == tok::Kind::amp and kind{ p, ahead = 1 } == tok::Kind::kw_fn)
                  or (k == tok::Kind::kw_extern and kind{ p, ahead = 1 } == tok::Kind::kw_fn) {
            let bound = accept{ &p, k = tok::Kind::amp }
            let external = accept{ &p, k = tok::Kind::kw_extern }
            skip{ &p }
            let params = ctx_fields{ &p, decl = false }
            let ret: ?*syntax::TypeExpr = if accept{ &p, k = tok::Kind::arrow } { box{ &p, value = type_expr{ &p } } } else { null }
            t = syntax::TypeKind::func{ bound, params, ret, external }
        } else if k == tok::Kind::ident {
            let mut segs = list::new(syntax::Seg){ realloc = arena::alloc, heap = p.heap }
            try! list::push{ list = &segs, item = type_seg{ &p } }
            while accept{ &p, k = tok::Kind::colons } { try! list::push{ list = &segs, item = type_seg{ &p } } }
            t = syntax::TypeKind::path{ segs = list::items{ list = segs } }
            // `E!T`, or `E!` alone where no type follows on its line: a result whose errors are
            // set E's.
            if next_is{ p, k = tok::Kind::bang } and not nl{ p } {
                let set = box{ &p, value = syntax::TypeExpr{ id, span = span_from{ p, start }, k = t } }
                skip{ &p }
                let mut elem: ?*syntax::TypeExpr = null
                if starts_type{ p } and not nl{ p } { elem = box{ &p, value = type_expr{ &p } } }
                return syntax::TypeExpr{ id = new_id{ &p }, span = span_from{ p, start }, k = syntax::TypeKind::fail{ elem, set } }
            }
        } else if k == tok::Kind::error {
            skip{ &p }
        } else {
            expected{ &p, what = "a type" }
        }
        return syntax::TypeExpr{ id, span = span_from{ p, start }, k = t }
    }

    // Whether a type begins at the current token.
    fn starts_type { p: Parser } -> bool {
        let k = kind{ p, ahead = 0 }
        let k1 = kind{ p, ahead = 1 }
        return k == tok::Kind::star or k == tok::Kind::question or k == tok::Kind::lbracket or k == tok::Kind::ident
               or k == tok::Kind::kw_fn or (k == tok::Kind::amp and k1 == tok::Kind::kw_fn)
               or (k == tok::Kind::kw_extern and k1 == tok::Kind::kw_fn)
    }

    fn type_seg { mut p: Parser } -> syntax::Seg {
        let name = ident{ &p }
        if not (next_is{ p, k = tok::Kind::lparen } and not nl{ p }) { return syntax::Seg{ name, targs = null, rest = false } }
        // `(T, ...)`, and `..` last for an open error set, `error(a, b, ..)`.
        let mut xs = list::new(syntax::TypeExpr){ realloc = arena::alloc, heap = p.heap }
        let mut rest = false
        expect{ &p, k = tok::Kind::lparen }
        while more{ p, close = tok::Kind::rparen } {
            if accept{ &p, k = tok::Kind::dots } {
                rest = true
                break
            }
            try! list::push{ list = &xs, item = type_expr{ &p } }
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        expect{ &p, k = tok::Kind::rparen }
        return syntax::Seg{ name, targs = list::items{ list = xs }, rest }
    }

    // `(T, ...)`
    fn type_list { mut p: Parser } -> []syntax::TypeExpr {
        let mut xs = list::new(syntax::TypeExpr){ realloc = arena::alloc, heap = p.heap }
        expect{ &p, k = tok::Kind::lparen }
        while more{ p, close = tok::Kind::rparen } {
            try! list::push{ list = &xs, item = type_expr{ &p } }
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        expect{ &p, k = tok::Kind::rparen }
        return list::items{ list = xs }
    }

    // ---- statements

    fn block { mut p: Parser } -> syntax::Block {
        let start = p.i
        let id = new_id{ &p }
        let mut xs = list::new(syntax::Stmt){ realloc = arena::alloc, heap = p.heap }
        if not enter{ &p } { return syntax::Block{ id, span = span_from{ p, start }, stmts = list::items{ list = xs } } }
        defer p.depth = p.depth - 1
        expect{ &p, k = tok::Kind::lbrace }
        skip_semis{ &p }
        while not next_is{ p, k = tok::Kind::rbrace } {
            if next_is{ p, k = tok::Kind::eof } {
                fail{ &p, msg = "expected '}' to close block" }
                break
            }
            let s = p.i
            let broke = s > 0 and s == p.cond_break and opens_block{ p }
            let seen = p.cond_mark
            let items = p.cond_items
            let st = stmt{ &p }
            try! list::push{ list = &xs, item = st }
            if not p.bad and not (nl{ p } or next_is{ p, k = tok::Kind::semi } or next_is{ p, k = tok::Kind::rbrace }) {
                expected{ &p, what = "a newline or ';' after statement" }
            }
            // The braces before this line don't hold statements, or the line isn't one: the
            // condition was meant to go on here. Or both parse, but the braces could be a
            // call's and the line ends in braces that could be the block: either reading
            // stands, and only the types would tell. That is the one error, in place of any
            // others, and neither the statement before nor this one is left for the checker.
            let failed = broke and p.diags.errors > seen.errors
            if failed or (broke and items and ends_in_braces{ s = st }) {
                diag::rewind{ diags = p.diags, to = seen }
                let mut b = message{ p }
                let op = utf8::String{ bytes = text_of{ p, t = p.toks[s] } }
                try! @fmt(&b, "a condition can't go on with a line that starts with `{}`, which may begin a statement: end the line before with the `{}`, or put the condition in parentheses", op, op)
                if not failed { try! @fmt(&b, "; if this line is a value of its own, put that in parentheses") }
                diag::error{ diags = p.diags, span = p.toks[s].span, msg = utf8::view{ b } }
                xs.items[xs.len - 1].k = syntax::StmtKind::error
                if xs.len >= 2 { xs.items[xs.len - 2].k = syntax::StmtKind::error }
                p.bad = true
                p.errored = true
                p.err_at = p.i
            }
            if p.bad {
                sync{ &p, start = s, in_block = true, top = false }
                if at_decl{ p } { break }
            }
            skip_semis{ &p }
        }
        expect{ &p, k = tok::Kind::rbrace }
        return syntax::Block{ id, span = span_from{ p, start }, stmts = list::items{ list = xs } }
    }

    fn stmt { mut p: Parser } -> syntax::Stmt {
        let mut start = p.i
        let t = p.toks[p.i]
        let id = new_id{ &p }
        let k = kind{ p, ahead = 0 }
        let mut s = syntax::StmtKind::error
        if k == tok::Kind::kw_let {
            return let_stmt{ &p, id }
        } else if k == tok::Kind::kw_if {
            s = if_stmt{ &p }
        } else if k == tok::Kind::kw_while {
            s = while_stmt{ &p, label = null }
        } else if k == tok::Kind::kw_for {
            s = for_stmt{ &p, label = null }
        } else if k == tok::Kind::kw_match {
            s = syntax::StmtKind::choose{ x = match_node{ &p } }
        } else if k == tok::Kind::kw_break {
            skip{ &p }
            s = syntax::StmtKind::brk{ label = jump_label{ &p } }
        } else if k == tok::Kind::kw_continue {
            skip{ &p }
            s = syntax::StmtKind::cont{ label = jump_label{ &p } }
        } else if k == tok::Kind::lbrace {
            // A block of its own (§11, rule 4): a call's or a literal's `{` is on its
            // expression's line, so one that begins a statement is this.
            s = syntax::StmtKind::scope{ body = block{ &p } }
        } else if k == tok::Kind::kw_defer {
            skip{ &p }
            if next_is{ p, k = tok::Kind::lbrace } {
                s = syntax::StmtKind::deferred{ body = block{ &p } }
            } else {
                // Any statement that can run later by itself (§11, Defer, rule 1).
                let inner = stmt{ &p }
                if inner.k is local | let_else {
                    fail_at{ &p, msg = "`defer let` declares a local that nothing could use: put the `let` and what uses it in a block, `defer { ... }`", t }
                } else if inner.k is ret | brk | cont {
                    fail_at{ &p, msg = "a deferred body can't leave: `defer` takes a call, an assignment, `_ = e`, an `if`, a `match`, a loop or a block", t }
                } else if not (inner.k is eval | discard | assign | cond | choose | loop | each) {
                    fail_at{ &p, msg = "`defer` takes a call, an assignment, `_ = e`, an `if`, a `match`, a loop or a block", t }
                }
                s = syntax::StmtKind::deferred{ body = one{ &p, s = inner } }
            }
        } else if k == tok::Kind::kw_return {
            skip{ &p }
            if nl{ p } or next_is{ p, k = tok::Kind::rbrace } or next_is{ p, k = tok::Kind::semi } {
                s = syntax::StmtKind::ret{ value = null }
            } else {
                s = syntax::StmtKind::ret{ value = expr{ &p } }
            }
        } else if k == tok::Kind::ident and kind{ p, ahead = 1 } == tok::Kind::colon {
            // A loop label: `name:`, then the `while` or the `for`, on the same line or the
            // next. The statement starts at the `while`, as in ctxi.
            let label = ident{ &p }
            skip{ &p }
            start = p.i
            if next_is{ p, k = tok::Kind::kw_while } {
                s = while_stmt{ &p, label }
            } else if next_is{ p, k = tok::Kind::kw_for } {
                s = for_stmt{ &p, label }
            } else {
                expected_msg{ &p, msg = "only a `while` or a `for` can be labeled, found " }
            }
        } else {
            let e = expr{ &p }
            if accept{ &p, k = tok::Kind::assign } {
                if is_discard{ e } {
                    s = syntax::StmtKind::discard{ e = expr{ &p } }
                } else {
                    s = syntax::StmtKind::assign{ place = e, value = expr{ &p } }
                }
            } else {
                s = syntax::StmtKind::eval{ e }
            }
        }
        return syntax::Stmt{ id, span = span_from{ p, start }, k = s }
    }

    // `_` alone, before the `=` of a discard.
    fn is_discard { e: syntax::Expr } -> bool {
        match e.k {
            path{ segs } => {
                return segs.len == 1 and segs[0].targs == null and slice::eq_bytes{ a = segs[0].name.text, b = "_" }
            }
            else => { return false }
        }
    }

    // A block holding one statement, with the statement's span.
    fn one { mut p: Parser, s: syntax::Stmt } -> syntax::Block {
        let mut xs = list::new(syntax::Stmt){ realloc = arena::alloc, heap = p.heap }
        try! list::push{ list = &xs, item = s }
        return syntax::Block{ id = new_id{ &p }, span = s.span, stmts = list::items{ list = xs } }
    }

    fn let_stmt { mut p: Parser, id: u32 } -> syntax::Stmt {
        let start = p.i
        let t = take{ &p }
        let mutable = accept{ &p, k = tok::Kind::kw_mut }
        if not mutable and next_is{ p, k = tok::Kind::kw_null } {
            let pat = pattern{ &p, test = false }
            return let_else{ &p, id, start, variant = pat.variant, binders = pat.binders }
        }
        let name = ident{ &p }
        if slice::eq_bytes{ a = name.text, b = "_" } {
            fail_at{ &p, msg = "`_` is not a name: `_ = e` discards a value without declaring anything", t }
        }
        if not mutable and next_is{ p, k = tok::Kind::lbrace } {
            let bs = binder_list{ &p }
            return let_else{ &p, id, start, variant = name, binders = bs }
        }
        let ty: ?syntax::TypeExpr = if accept{ &p, k = tok::Kind::colon } { type_expr{ &p } } else { null }
        let init: ?syntax::Expr = if accept{ &p, k = tok::Kind::assign } { expr{ &p } } else { null }
        if ty == null and init == null {
            failf_at{ &p, msg = @fmt("`let {}` needs a type or an initializer", utf8::String{ bytes = name.text }), t }
        }
        if init != null and ty == null and not mutable and next_is{ p, k = tok::Kind::kw_else } {
            // `let variant = e else ...`
            return let_else_tail{ &p, id, start, variant = name, binders = slice::empty(syntax::Binder){}, init }
        }
        return syntax::Stmt{ id, span = span_from{ p, start }, k = syntax::StmtKind::local{ mutable, name, ty, init } }
    }

    // `let variant{ binders } = init else ...`, after the pattern.
    fn let_else { mut p: Parser, id: u32, start: usize, variant: syntax::Name, binders: []syntax::Binder } -> syntax::Stmt {
        expect{ &p, k = tok::Kind::assign }
        let init = expr{ &p }
        if not next_is{ p, k = tok::Kind::kw_else } { fail{ &p, msg = "a `let` with a pattern needs an `else`" } }
        return let_else_tail{ &p, id, start, variant, binders, init }
    }

    // From the `else`: an optional pattern for the other variant, then the block.
    fn let_else_tail { mut p: Parser, id: u32, start: usize, variant: syntax::Name, binders: []syntax::Binder, init: syntax::Expr } -> syntax::Stmt {
        expect{ &p, k = tok::Kind::kw_else }
        let mut els_variant: ?syntax::Name = null
        let mut els_binders: []syntax::Binder = slice::empty(syntax::Binder){}
        if not next_is{ p, k = tok::Kind::lbrace } {
            // `else v { ... }` binds nothing; `else v{ ... } { ... }` has bindings, then the block.
            els_variant = if next_is{ p, k = tok::Kind::kw_null } { keyword_name{ &p } } else { ident{ &p } }
            if braces_then_brace{ p } { els_binders = binder_list{ &p } }
        }
        let els = block{ &p }
        let k = syntax::StmtKind::let_else{ variant, binders, init, els_variant, els_binders, els }
        return syntax::Stmt{ id, span = span_from{ p, start }, k }
    }

    fn while_stmt { mut p: Parser, label: ?syntax::Name } -> syntax::StmtKind {
        skip{ &p }
        let c = cond_expr{ &p }
        return syntax::StmtKind::loop{ label, c, body = block{ &p } }
    }

    // `for i in lo..hi { }`, `for x in e { }`, `for &x in e { }` and `for x at i in e { }`
    // (§11, For). `in` and `at` are words only here. What is gone over is e's slice, `e[..]`,
    // with e's span, so an array is gone over as its view; an array literal stays as it is, a
    // view where a slice is expected.
    fn for_stmt { mut p: Parser, label: ?syntax::Name } -> syntax::StmtKind {
        skip{ &p }
        let amp = p.toks[p.i]
        let by_ref = accept{ &p, k = tok::Kind::amp }
        let item = ident{ &p }
        let mut index: ?syntax::Name = null
        if next_is{ p, k = tok::Kind::comma } {
            fail{ &p, msg = "a `for` names one element: write `for x at i in xs` for each element `x` and its index `i`" }
        }
        let word = p.toks[p.i]
        if is_word{ p, word = "at" } and kind{ p, ahead = 1 } == tok::Kind::ident {
            skip{ &p }
            index = ident{ &p }
        }
        if is_word{ p, word = "in" } {
            skip{ &p }
        } else {
            expected_msg{ &p, msg = "expected `in` after a `for`'s name, as in `for x in xs` or `for i in 0..n`, found " }
        }
        if is_word{ p, word = "range" } and kind{ p, ahead = 1 } == tok::Kind::lparen {
            fail{ &p, msg = "a `for` counts over a range written `lo..hi`: write `for i in 0..n`" }
        }
        let first = cond_expr{ &p }
        let mut hi: ?syntax::Expr = null
        let mut iter = first
        if accept{ &p, k = tok::Kind::dots } {
            if next_is{ p, k = tok::Kind::assign } {
                fail{ &p, msg = "a `for`'s range is `lo..hi`, which leaves `hi` out: to include it, write `lo..hi + 1`" }
            }
            if by_ref { fail_at{ &p, msg = "a range's numbers aren't places: write `for i in lo..hi`, without the `&`", t = amp } }
            if index != null { fail_at{ &p, msg = "a range's number is its own index: write `for i in lo..hi`, without the `at`", t = word } }
            hi = cond_expr{ &p }
        } else {
            if not (first.k is array | repeat) {
                iter = syntax::Expr{ id = new_id{ &p }, span = first.span, at = first.span.start, k = syntax::ExprKind::range{ base = box{ &p, value = first }, lo = null, hi = null } }
            }
        }
        return syntax::StmtKind::each{ label, item, by_ref, index, iter, hi, body = block{ &p } }
    }

    // Whether the current token is the name `word`: a word that is a keyword only in its place.
    fn is_word { p: Parser, word: []u8 } -> bool {
        return next_is{ p, k = tok::Kind::ident } and slice::eq_bytes{ a = text_of{ p, t = p.toks[p.i] }, b = word }
    }

    // The label after `break` or `continue`, if one follows on the same line.
    fn jump_label { mut p: Parser } -> ?syntax::Name {
        if next_is{ p, k = tok::Kind::ident } and not nl{ p } { return ident{ &p } }
        return null
    }

    // `variant` or `variant{ binders }`, where variant may be `null`, or an error's name with its
    // path, `a::b::name`. After `is` (test), a `{` begins binders only on the same line, and in a
    // condition only where it would begin a call's braces. An integer pattern (§8, Match on
    // integers) is a literal, `-` and one, or a name with its path, and `..=` and another for a
    // range: a pattern without binders has its value as an expression too.
    fn pattern { mut p: Parser, test: bool } -> syntax::Pattern {
        let start = p.i
        let no_quals = slice::empty(syntax::Name){}
        let none = slice::empty(syntax::Binder){}
        if literal_start{ p } {
            let lo = box{ &p, value = prefix{ &p } }
            let hi = range_end{ &p }
            let here = source::Span{ file = p.file, start = lo.span.start, end = lo.span.start }
            return syntax::Pattern{ span = span_from{ p, start }, quals = no_quals, variant = made_name{ &p, at = here, text = "" }, binders = none, value = lo, upto = hi }
        }
        let is_null = next_is{ p, k = tok::Kind::kw_null }
        let mut variant = if is_null { keyword_name{ &p } } else { ident{ &p } }
        let mut quals = list::new(syntax::Name){ realloc = arena::alloc, heap = p.heap }
        while next_is{ p, k = tok::Kind::colons } and variant.text.len > 0 {
            skip{ &p }
            try! list::push{ list = &quals, item = variant }
            variant = ident{ &p }
        }
        let mut bs: []syntax::Binder = none
        if next_is{ p, k = tok::Kind::lbrace } and (not test or (not nl{ p } and (not p.in_cond or brace_is_call{ &p }))) {
            bs = binder_list{ &p }
        }
        let qs = list::items{ list = quals }
        let mut value: ?*syntax::Expr = null
        let mut hi: ?*syntax::Expr = null
        if bs.len == 0 and not is_null and variant.text.len > 0 {
            value = box{ &p, value = path_of{ &p, quals = qs, name = variant, start } }
            hi = range_end{ &p }
        }
        return syntax::Pattern{ span = span_from{ p, start }, quals = qs, variant, binders = bs, value, upto = hi }
    }

    // Whether an integer pattern's literal starts here.
    fn literal_start { p: Parser } -> bool {
        let k = kind{ p, ahead = 0 }
        return k == tok::Kind::int or k == tok::Kind::char or k == tok::Kind::minus
    }

    // A range pattern's `..= end`, if one follows.
    fn range_end { mut p: Parser } -> ?*syntax::Expr {
        if not next_is{ p, k = tok::Kind::dots } { return null }
        if kind{ p, ahead = 1 } != tok::Kind::assign {
            fail{ &p, msg = "a range pattern is `lo..=hi`, which includes hi" }
            return null
        }
        skip{ &p }
        skip{ &p }
        let start = p.i
        if literal_start{ p } { return box{ &p, value = prefix{ &p } } }
        let mut name = ident{ &p }
        let mut quals = list::new(syntax::Name){ realloc = arena::alloc, heap = p.heap }
        while next_is{ p, k = tok::Kind::colons } and name.text.len > 0 {
            skip{ &p }
            try! list::push{ list = &quals, item = name }
            name = ident{ &p }
        }
        return box{ &p, value = path_of{ &p, quals = list::items{ list = quals }, name, start } }
    }

    // The path expression `a::b::name`, from token start.
    fn path_of { mut p: Parser, quals: []syntax::Name, name: syntax::Name, start: usize } -> syntax::Expr {
        let mut segs = list::new(syntax::Seg){ realloc = arena::alloc, heap = p.heap }
        let mut i: usize = 0
        while i < quals.len {
            try! list::push{ list = &segs, item = syntax::Seg{ name = quals[i], targs = null, rest = false } }
            i = i + 1
        }
        try! list::push{ list = &segs, item = syntax::Seg{ name, targs = null, rest = false } }
        let k = syntax::ExprKind::path{ segs = list::items{ list = segs } }
        return syntax::Expr{ id = new_id{ &p }, span = span_from{ p, start }, at = start_of{ p, start }, k }
    }

    // `{ f, &g, h = x, &k = y }`: the payload fields a pattern binds.
    fn binder_list { mut p: Parser } -> []syntax::Binder {
        let mut xs = list::new(syntax::Binder){ realloc = arena::alloc, heap = p.heap }
        expect{ &p, k = tok::Kind::lbrace }
        while more{ p, close = tok::Kind::rbrace } {
            let start = p.i
            let by_ref = accept{ &p, k = tok::Kind::amp }
            let field = ident{ &p }
            let local: ?syntax::Name = if accept{ &p, k = tok::Kind::assign } { ident{ &p } } else { null }
            try! list::push{ list = &xs, item = syntax::Binder{ span = span_from{ p, start }, by_ref, field, local } }
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        expect{ &p, k = tok::Kind::rbrace }
        return list::items{ list = xs }
    }

    // Whether the `{ ... }` starting here is followed by another `{`.
    fn braces_then_brace { p: Parser } -> bool {
        if not next_is{ p, k = tok::Kind::lbrace } { return false }
        let mut depth: u32 = 0
        let mut k = p.i
        while p.toks[k].kind != tok::Kind::eof {
            let x = p.toks[k].kind
            if x == tok::Kind::lbrace {
                depth = depth + 1
            } else if x == tok::Kind::rbrace {
                depth = depth - 1
                if depth == 0 { return p.toks[k + 1].kind == tok::Kind::lbrace }
            }
            k = k + 1
        }
        return false
    }

    // The condition of an `if` or `while`, or a match scrutinee: an expression that ends where
    // its block's `{` begins (brace_is_call).
    fn cond_expr { mut p: Parser } -> syntax::Expr {
        let saved = p.in_cond
        p.in_cond = true
        let e = or_expr{ &p }
        p.in_cond = saved
        return e
    }

    // In a condition, whether the `{` here begins a call or literal rather than the block:
    // whether the token after its matching `}` goes on with the expression (§11, rules 2 and
    // 3). On the same line, any token that could; on the next line, one that can only continue
    // an expression (continues), unless the braces hold a match's arms: `match x { ... }` may
    // be an operand itself, with an operator on the line after it.
    fn brace_is_call { mut p: Parser } -> bool {
        if p.bad { return false }
        let mut depth: u32 = 0
        let mut arms = false
        let mut k = p.i
        while p.toks[k].kind != tok::Kind::eof {
            let x = p.toks[k].kind
            if x == tok::Kind::lbrace {
                depth = depth + 1
            } else if x == tok::Kind::fat_arrow {
                if depth == 1 { arms = true }
            } else if x == tok::Kind::rbrace {
                depth = depth - 1
                if depth == 0 {
                    let after = p.toks[k + 1]
                    let a = after.kind
                    if a == tok::Kind::eof or a == tok::Kind::kw_else { return false }
                    if after.nl {
                        if arms { return false }
                        if continues{ k = a } or is_at{ p, i = k + 1 } { return true }
                        if a == tok::Kind::minus or a == tok::Kind::amp {
                            p.cond_break = k + 1
                            p.cond_mark = diag::mark{ diags = p.diags.* }
                            p.cond_items = items_like{ p, close = k }
                        }
                        return false
                    }
                    return not (a == tok::Kind::semi or a == tok::Kind::rbrace or a == tok::Kind::comma
                                or a == tok::Kind::rparen or a == tok::Kind::rbracket)
                }
            }
            k = k + 1
        }
        return false
    }

    // Whether a line that starts with k goes on with the expression before it, whatever that
    // ends in: k continues an expression and begins none, and so no statement. `-` and `&`
    // begin one (`-1`, `&x`), and a postfix `(`, `[` or `{` must be on its expression's line.
    fn continues { k: tok::Kind } -> bool {
        return k == tok::Kind::kw_and or k == tok::Kind::kw_or or is_cmp{ k } or is_handler{ k }
               or k == tok::Kind::plus or k == tok::Kind::plus_wrap or k == tok::Kind::minus_wrap
               or k == tok::Kind::star or k == tok::Kind::star_wrap or k == tok::Kind::slash or k == tok::Kind::percent
               or k == tok::Kind::pipe or k == tok::Kind::caret or k == tok::Kind::shl or k == tok::Kind::shr
               or k == tok::Kind::shl_wrap or k == tok::Kind::dot
    }

    // Whether the braces from the `{` here to the `}` at token `close` could hold a call's
    // items, by their tokens: nothing, or items between commas, each `name = e`, or a pun or a
    // spread, which has no `=`; and a line begins only after a comma. A block of statements
    // that looks so is `{}`, `{ x }` and `{ x = e }`.
    fn items_like { p: Parser, close: usize } -> bool {
        let mut depth: u32 = 0
        let mut first = true                // at an item's first token
        let mut named = false               // the item began `name =`
        let mut k = p.i + 1
        while k < close {
            let t = p.toks[k]
            let x = t.kind
            if depth == 0 {
                if x == tok::Kind::semi or x == tok::Kind::fat_arrow { return false }
                if t.nl and not first and k > p.i + 1 { return false }
                if first {
                    named = x == tok::Kind::ident and p.toks[k + 1].kind == tok::Kind::assign
                    if not (x == tok::Kind::ident or x == tok::Kind::amp or x == tok::Kind::dots) { return false }
                    if x == tok::Kind::ident {
                        let y = p.toks[k + 1].kind
                        if y == tok::Kind::lbrace or y == tok::Kind::lparen or y == tok::Kind::colons { return false }
                    }
                    first = false
                } else if x == tok::Kind::comma {
                    first = true
                } else if x == tok::Kind::assign and not (named and k >= 1 and p.toks[k - 1].kind == tok::Kind::ident and is_item_start{ p, k = k - 1 }) {
                    return false
                }
            }
            if x == tok::Kind::lbrace or x == tok::Kind::lparen or x == tok::Kind::lbracket {
                depth = depth + 1
            } else if (x == tok::Kind::rbrace or x == tok::Kind::rparen or x == tok::Kind::rbracket) and depth > 0 {
                depth = depth - 1
            }
            k = k + 1
        }
        return true
    }

    // Whether token k begins an item of the braces at the current token: it follows the `{`
    // or a comma.
    fn is_item_start { p: Parser, k: usize } -> bool {
        return k == p.i + 1 or p.toks[k - 1].kind == tok::Kind::comma
    }

    // Whether statement s is an expression that ends in a call's or a literal's braces.
    fn ends_in_braces { s: syntax::Stmt } -> bool {
        match s.k {
            eval{ e } => { return braces_last{ e } }
            else => { return false }
        }
    }

    fn braces_last { e: syntax::Expr } -> bool {
        match e.k {
            braced => { return true }
            binary{ b } => { return b.span.end == e.span.end and braces_last{ e = b.* } }
            neg{ e = x } | lnot{ e = x } | bnot{ e = x } | addr{ e = x } => { return x.span.end == e.span.end and braces_last{ e = x.* } }
            else => { return false }
        }
    }

    // At a line that starts with `-` or `&` after a condition's block (cond_break): whether a
    // `{` comes before the statement there could end, as a condition's block would, were the
    // condition meant to go on with this line and those that continue it.
    fn opens_block { p: Parser } -> bool {
        let mut k = p.i + 1
        while p.toks[k].kind != tok::Kind::eof {
            let t = p.toks[k]
            if t.kind == tok::Kind::lbrace { return true }
            if t.kind == tok::Kind::rbrace or t.kind == tok::Kind::semi { return false }
            if t.nl and not (continues{ k = t.kind } or is_at{ p, i = k } or t.kind == tok::Kind::minus or t.kind == tok::Kind::amp) { return false }
            k = k + 1
        }
        return false
    }

    fn if_node { mut p: Parser } -> syntax::If {
        skip{ &p }
        let c = box{ &p, value = cond_expr{ &p } }
        let then = block{ &p }
        let mut els: ?syntax::Block = null
        if accept{ &p, k = tok::Kind::kw_else } {
            els = if next_is{ p, k = tok::Kind::kw_if } { else_if_stmt{ &p } } else { block{ &p } }
        }
        return syntax::If{ c, then, els }
    }

    // An `if` or `if let` statement.
    fn if_stmt { mut p: Parser } -> syntax::StmtKind {
        if kind{ p, ahead = 1 } == tok::Kind::kw_let { return syntax::StmtKind::choose{ x = if_let{ &p, value = false } } }
        return syntax::StmtKind::cond{ x = if_node{ &p } }
    }

    // `else if ...` in a statement: a block of the inner `if` or `if let` alone.
    fn else_if_stmt { mut p: Parser } -> syntax::Block {
        let start = p.i
        let id = new_id{ &p }
        let k = if_stmt{ &p }
        return one{ &p, s = syntax::Stmt{ id, span = span_from{ p, start }, k } }
    }

    // `if let x = e { A } else { B }` or `if let &x = e ...`: a match on e marked is_iflet
    // (syntax::Match). As an expression (value) the `else` is required, and an `else if` is an
    // `if` expression too.
    fn if_let { mut p: Parser, value: bool } -> syntax::Match {
        let start = p.i
        let t = take{ &p }
        skip{ &p }
        let pat_start = p.i
        let by_ref = accept{ &p, k = tok::Kind::amp }
        let name = ident{ &p }
        let pat_span = span_from{ p, start = pat_start }
        expect{ &p, k = tok::Kind::assign }
        let scrut = box{ &p, value = cond_expr{ &p } }
        let then = block{ &p }
        let no_quals = slice::empty(syntax::Name){}
        let mut binders = list::new(syntax::Binder){ realloc = arena::alloc, heap = p.heap }
        try! list::push{ list = &binders, item = syntax::Binder{ span = pat_span, by_ref, field = made_name{ &p, at = name.span, text = "value" }, local = name } }
        let mut somes = list::new(syntax::Pattern){ realloc = arena::alloc, heap = p.heap }
        try! list::push{ list = &somes, item = syntax::Pattern{ span = pat_span, quals = no_quals, variant = made_name{ &p, at = pat_span, text = "some" }, binders = list::items{ list = binders }, value = null, upto = null } }
        let mut arms = list::new(syntax::Arm){ realloc = arena::alloc, heap = p.heap }
        try! list::push{ list = &arms, item = syntax::Arm{ span = span_from{ p, start }, pats = list::items{ list = somes }, body = then } }
        let else_at = p.i
        let mut els = syntax::Block{ id = new_id{ &p }, span = span_from{ p, start = else_at }, stmts = slice::empty(syntax::Stmt){} }
        if accept{ &p, k = tok::Kind::kw_else } {
            if not next_is{ p, k = tok::Kind::kw_if } {
                els = block{ &p }
            } else if value {
                els = else_if{ &p }
            } else {
                els = else_if_stmt{ &p }
            }
        } else if value {
            fail_at{ &p, msg = "an `if` expression needs an `else`", t }
        }
        let null_span = span_from{ p, start = else_at }
        let mut nulls = list::new(syntax::Pattern){ realloc = arena::alloc, heap = p.heap }
        try! list::push{ list = &nulls, item = syntax::Pattern{ span = null_span, quals = no_quals, variant = made_name{ &p, at = null_span, text = "null" }, binders = slice::empty(syntax::Binder){}, value = null, upto = null } }
        try! list::push{ list = &arms, item = syntax::Arm{ span = null_span, pats = list::items{ list = nulls }, body = els } }
        return syntax::Match{ scrut, arms = list::items{ list = arms }, is_ifnull = false, is_iferr = false, is_iflet = true }
    }

    // An `if` in expression position. `else` is required; `else if` nests another one.
    fn if_expr { mut p: Parser } -> syntax::Expr {
        let start = p.i
        let id = new_id{ &p }
        if kind{ p, ahead = 1 } == tok::Kind::kw_let {
            let at = p.toks[p.i].span.start
            let x = if_let{ &p, value = true }
            return syntax::Expr{ id, span = span_from{ p, start }, at, k = syntax::ExprKind::matchx{ x } }
        }
        let t = take{ &p }
        let c = box{ &p, value = cond_expr{ &p } }
        let then = block{ &p }
        if not accept{ &p, k = tok::Kind::kw_else } { fail_at{ &p, msg = "an `if` expression needs an `else`", t } }
        let els = if next_is{ p, k = tok::Kind::kw_if } { else_if{ &p } } else { block{ &p } }
        let k = syntax::ExprKind::ifx{ x = syntax::If{ c, then, els } }
        return syntax::Expr{ id, span = span_from{ p, start }, at = start_of{ p, start }, k }
    }

    // `else if ...` in an expression: a block of the inner `if` alone.
    fn else_if { mut p: Parser } -> syntax::Block {
        let start = p.i
        let id = new_id{ &p }
        let e = if_expr{ &p }
        return one{ &p, s = syntax::Stmt{ id, span = span_from{ p, start }, k = syntax::StmtKind::eval{ e } } }
    }

    fn match_node { mut p: Parser } -> syntax::Match {
        skip{ &p }
        let scrut = box{ &p, value = cond_expr{ &p } }
        expect{ &p, k = tok::Kind::lbrace }
        let mut arms = list::new(syntax::Arm){ realloc = arena::alloc, heap = p.heap }
        skip_semis{ &p }
        while more{ p, close = tok::Kind::rbrace } {
            let start = p.i
            let mut pats = list::new(syntax::Pattern){ realloc = arena::alloc, heap = p.heap }
            if not accept{ &p, k = tok::Kind::kw_else } {
                try! list::push{ list = &pats, item = pattern{ &p, test = false } }
                while accept{ &p, k = tok::Kind::pipe } { try! list::push{ list = &pats, item = pattern{ &p, test = false } } }
            }
            expect{ &p, k = tok::Kind::fat_arrow }
            let braces = next_is{ p, k = tok::Kind::lbrace }
            let body = if braces { block{ &p } } else { arm_stmt{ &p } }
            try! list::push{ list = &arms, item = syntax::Arm{ span = span_from{ p, start }, pats = list::items{ list = pats }, body } }
            // An arm without braces ends as a statement does, or at a `,` or the match's `}`.
            if not accept{ &p, k = tok::Kind::comma } and not braces and not p.bad
               and not (nl{ p } or next_is{ p, k = tok::Kind::semi } or next_is{ p, k = tok::Kind::rbrace }) {
                expected{ &p, what = "',' or a newline after a match arm" }
            }
            if p.bad {
                sync{ &p, start, in_block = true, top = false }
                if at_decl{ p } or next_is{ p, k = tok::Kind::eof } { break }
            }
            skip_semis{ &p }
        }
        expect{ &p, k = tok::Kind::rbrace }
        return syntax::Match{ scrut, arms = list::items{ list = arms }, is_ifnull = false, is_iferr = false, is_iflet = false }
    }

    // A match arm without braces (§8, Match, rule 11): one statement, a block of it alone, as
    // `a => "A"`, `a => return 1` and `a => n = n + 1` are. A `let` and a `defer` would do
    // nothing there.
    fn arm_stmt { mut p: Parser } -> syntax::Block {
        let t = p.toks[p.i]
        let outer = p.arm_end
        p.arm_end = arm_end{ p }
        let s = stmt{ &p }
        p.arm_end = outer
        if s.k is local | let_else | deferred {
            fail_at{ &p, msg = "a match arm without braces is an expression or one statement, and not a `let` or a `defer`, which need a block: write `=> { ... }`", t }
        }
        return one{ &p, s }
    }

    // Where the expression of the arm that begins here ends, though a line that starts with
    // `-` would go on with it: at a `-` that begins a line and the next arm's pattern, `-1 =>`,
    // `-1 | 0 =>` or `-8..=-1 =>`, which no expression goes on to. 0 if there is none before
    // the arm ends.
    fn arm_end { p: Parser } -> usize {
        let mut depth: u32 = 0
        let mut k = p.i
        while p.toks[k].kind != tok::Kind::eof {
            let t = p.toks[k]
            let x = t.kind
            if depth == 0 {
                if x == tok::Kind::fat_arrow or x == tok::Kind::comma or x == tok::Kind::semi or x == tok::Kind::rbrace { return 0 }
                if k > p.i and t.nl and x == tok::Kind::minus and k + 2 < p.toks.len {
                    let a = p.toks[k + 1].kind
                    let b = p.toks[k + 2].kind
                    if (a == tok::Kind::int or a == tok::Kind::char)
                       and (b == tok::Kind::fat_arrow or b == tok::Kind::pipe or b == tok::Kind::dots) {
                        return k
                    }
                }
            }
            if x == tok::Kind::lbrace or x == tok::Kind::lparen or x == tok::Kind::lbracket {
                depth = depth + 1
            } else if (x == tok::Kind::rbrace or x == tok::Kind::rparen or x == tok::Kind::rbracket) and depth > 0 {
                depth = depth - 1
            }
            k = k + 1
        }
        return 0
    }

    // ---- expressions

    fn expr { mut p: Parser } -> syntax::Expr {
        let saved = p.in_cond
        p.in_cond = false
        let e = or_expr{ &p }
        p.in_cond = saved
        return e
    }

    fn or_expr { mut p: Parser } -> syntax::Expr {
        let start = p.i
        let mut e = and_expr{ &p }
        let mut h = p.hand
        while next_is{ p, k = tok::Kind::kw_or } {
            let op = take{ &p }
            let b = and_expr{ &p }
            mixed{ &p, a = e, ha = h, op, b_start = b.span.start, hb = p.hand }
            e = binary{ &p, start, op, a = e, b }
            h.bare = false
            p.hand.bare = false
        }
        return e
    }

    fn and_expr { mut p: Parser } -> syntax::Expr {
        let start = p.i
        let mut e = cmp_expr{ &p }
        let mut h = p.hand
        while next_is{ p, k = tok::Kind::kw_and } {
            let op = take{ &p }
            let b = cmp_expr{ &p }
            mixed{ &p, a = e, ha = h, op, b_start = b.span.start, hb = p.hand }
            e = binary{ &p, start, op, a = e, b }
            h.bare = false
            p.hand.bare = false
        }
        return e
    }

    fn cmp_expr { mut p: Parser } -> syntax::Expr {
        let start = p.i
        let mut e = null_expr{ &p }
        let h = p.hand
        if at_is{ p } {
            let op = p.toks[p.i]
            let a = e
            e = is_expr{ &p, start, e }
            let mut none = h
            none.bare = false
            mixed{ &p, a, ha = h, op, b_start = 0, hb = none }
        } else if is_cmp{ k = kind{ p, ahead = 0 } } {
            let op = take{ &p }
            let b = null_expr{ &p }
            mixed{ &p, a = e, ha = h, op, b_start = b.span.start, hb = p.hand }
            e = binary{ &p, start, op, a = e, b }
        } else {
            return e
        }
        p.hand.bare = false
        if is_cmp{ k = kind{ p, ahead = 0 } } or at_is{ p } { fail{ &p, msg = "comparisons do not chain" } }
        return e
    }

    // Whether the current token, after an expression, is the operator `is` (§8, Is).
    fn at_is { p: Parser } -> bool {
        return not p.bad and is_at{ p, i = p.i }
    }

    // Whether token i, after an expression, is the operator `is`: `is` is a keyword only
    // there, and a name anywhere else (§1, rule 4). On the expression's line it is always the
    // operator, since no name can follow an expression. At the start of a line it is one only
    // before a pattern on that line, a name, `null` or an integer literal, `-` and one too: a
    // statement that begins with the name `is` goes on with something else (`is = 1`,
    // `is{ ... }`, `is.x`).
    fn is_at { p: Parser, i: usize } -> bool {
        let t = p.toks[i]
        if t.kind != tok::Kind::ident or not slice::eq_bytes{ a = text_of{ p, t }, b = "is" } { return false }
        if not t.nl { return true }
        if i + 1 >= p.toks.len or p.toks[i + 1].nl { return false }
        let k = p.toks[i + 1].kind
        if k == tok::Kind::minus and i + 2 < p.toks.len { return p.toks[i + 2].kind == tok::Kind::int or p.toks[i + 2].kind == tok::Kind::char }
        return k == tok::Kind::ident or k == tok::Kind::kw_null or k == tok::Kind::int or k == tok::Kind::char
    }

    // `e is a | b`, after e, which began at token `start`. A `not` in front of e takes the whole
    // test, `not (e is a)`, though it binds tighter than `is` everywhere else.
    fn is_expr { mut p: Parser, start: usize, e: syntax::Expr } -> syntax::Expr {
        if e.k is lnot{ e = x } {
            if p.toks[start].kind == tok::Kind::kw_not {
                let inner = is_expr{ &p, start = start + 1, e = x.* }
                let k = syntax::ExprKind::lnot{ e = box{ &p, value = inner } }
                return syntax::Expr{ id = e.id, span = span_from{ p, start }, at = e.at, k }
            }
        }
        let t = take{ &p }
        let mut pats = list::new(syntax::Pattern){ realloc = arena::alloc, heap = p.heap }
        try! list::push{ list = &pats, item = pattern{ &p, test = true } }
        while accept{ &p, k = tok::Kind::pipe } { try! list::push{ list = &pats, item = pattern{ &p, test = true } } }
        let k = syntax::ExprKind::isx{ e = box{ &p, value = e }, pats = list::items{ list = pats } }
        return syntax::Expr{ id = new_id{ &p }, span = span_from{ p, start }, at = t.span.start, k }
    }

    fn is_cmp { k: tok::Kind } -> bool {
        return k == tok::Kind::eq or k == tok::Kind::ne or k == tok::Kind::lt or k == tok::Kind::le
               or k == tok::Kind::gt or k == tok::Kind::ge
    }

    // The handlers, `e ifnull x`, `e iferr x` and `e ifoverflow x` (§11, Expressions, rule 7).
    // x is a block, or an expression of this level or tighter, which takes every handler after
    // it: `a ifnull b ifnull 0` is `a ifnull (b ifnull 0)`. A block ends at its `}`, so a
    // handler after one takes all that is before it: `f{} iferr { return } ifnull { return }`
    // is `(f{} iferr { return }) ifnull { return }`.
    fn null_expr { mut p: Parser } -> syntax::Expr {
        let start = p.i
        let left = bin_expr{ &p, level = 0 }
        let mut e = left
        let mut hand = Handler{ bare = false, block = false, first = p.toks[p.i], last = p.toks[p.i], left_end = left.span.end, right_start = 0 }
        // `a + f{} ifnull 0` is an error (whole_left), and the handler's left side an error
        // node in place of `a + f{}`, so that the checker has nothing to add.
        let whole = (next_is{ p, k = tok::Kind::kw_ifnull } or next_is{ p, k = tok::Kind::kw_iferr }) and last_operand{ p, e = left } != left.span.start
        if whole { e = syntax::Expr{ id = new_id{ &p }, span = left.span, at = left.span.start, k = syntax::ExprKind::error } }
        while is_handler{ k = kind{ p, ahead = 0 } } {
            if not hand.bare { hand.first = p.toks[p.i] }
            e = handler{ &p, start, e }
            hand.bare = true
            hand.block = p.hand.block
            hand.last = p.hand.last
            hand.right_start = p.hand.right_start
        }
        if whole { whole_left{ &p, left, e, op = hand.first } }
        p.hand = hand
        return e
    }

    fn is_handler { k: tok::Kind } -> bool {
        return k == tok::Kind::kw_ifnull or k == tok::Kind::kw_iferr or k == tok::Kind::kw_ifoverflow
    }

    // One handler, at its keyword, after its left side e, which began at token `start`.
    // `e ifnull x` and `e iferr x` are a match on e marked is_ifnull or is_iferr (syntax::Match).
    // After `iferr`, `err{ binders }` before a block binds the error, as after a let-else's
    // `else`. `e ifoverflow x` is an ExprKind::overflow.
    fn handler { mut p: Parser, start: usize, e: syntax::Expr } -> syntax::Expr {
        if next_is{ p, k = tok::Kind::kw_ifoverflow } {
            let id = new_id{ &p }
            let op = take{ &p }
            let els = handler_value{ &p, op, at = p.toks[p.i].span.start }
            let k = syntax::ExprKind::overflow{ e = box{ &p, value = e }, els }
            return syntax::Expr{ id, span = span_from{ p, start }, at = op.span.start, k }
        }
        let is_null = next_is{ p, k = tok::Kind::kw_ifnull }
        let id = new_id{ &p }
        let op_i = p.i
        let op = take{ &p }
        let right_at = p.toks[p.i].span.start
        let here = source::Span{ file = p.file, start = op.span.start, end = op.span.start }
        let no_quals = slice::empty(syntax::Name){}
        let mut binders = list::new(syntax::Binder){ realloc = arena::alloc, heap = p.heap }
        let field = made_name{ &p, at = here, text = "value" }
        try! list::push{ list = &binders, item = syntax::Binder{ span = here, by_ref = false, field, local = null } }
        let mut pats = list::new(syntax::Pattern){ realloc = arena::alloc, heap = p.heap }
        let has = if is_null { "some" } else { "ok" }
        try! list::push{ list = &pats, item = syntax::Pattern{ span = here, quals = no_quals, variant = made_name{ &p, at = here, text = has }, binders = list::items{ list = binders }, value = null, upto = null } }
        let value = name_path{ &p, name = made_name{ &p, at = here, text = "value" } }
        let some_body = one{ &p, s = syntax::Stmt{ id = new_id{ &p }, span = here, k = syntax::StmtKind::eval{ e = value } } }
        let mut arms = list::new(syntax::Arm){ realloc = arena::alloc, heap = p.heap }
        try! list::push{ list = &arms, item = syntax::Arm{ span = here, pats = list::items{ list = pats }, body = some_body } }
        let mut nulls = list::new(syntax::Pattern){ realloc = arena::alloc, heap = p.heap }
        if is_null {
            try! list::push{ list = &nulls, item = syntax::Pattern{ span = here, quals = no_quals, variant = made_name{ &p, at = here, text = "null" }, binders = slice::empty(syntax::Binder){}, value = null, upto = null } }
        } else if err_pattern{ p } {
            let pat_start = p.i
            let name = ident{ &p }
            let bs = binder_list{ &p }
            try! list::push{ list = &nulls, item = syntax::Pattern{ span = span_from{ p, start = pat_start }, quals = no_quals, variant = name, binders = bs, value = null, upto = null } }
        } else {
            try! list::push{ list = &nulls, item = syntax::Pattern{ span = here, quals = no_quals, variant = made_name{ &p, at = here, text = "err" }, binders = slice::empty(syntax::Binder){}, value = null, upto = null } }
        }
        let null_body = handler_value{ &p, op, at = right_at }
        try! list::push{ list = &arms, item = syntax::Arm{ span = span_from{ p, start = op_i }, pats = list::items{ list = nulls }, body = null_body } }
        let x = syntax::Match{ scrut = box{ &p, value = e }, arms = list::items{ list = arms }, is_ifnull = is_null, is_iferr = not is_null, is_iflet = false }
        return syntax::Expr{ id, span = span_from{ p, start }, at = op.span.start, k = syntax::ExprKind::matchx{ x } }
    }

    // After `iferr`, whether `err{ ... }` comes next with a block after it: a pattern that binds
    // the error, rather than an expression.
    fn err_pattern { p: Parser } -> bool {
        if not next_is{ p, k = tok::Kind::ident } or not slice::eq_bytes{ a = text_of{ p, t = p.toks[p.i] }, b = "err" } { return false }
        if kind{ p, ahead = 1 } != tok::Kind::lbrace { return false }
        let mut q = p
        q.i = p.i + 1
        return braces_then_brace{ p = q }
    }

    // A handler's right side, which begins at offset `at`, after its keyword op: a block, or an
    // expression with every handler after it. It leaves the handler in p.hand, but for its
    // left side.
    fn handler_value { mut p: Parser, op: tok::Token, at: u32 } -> syntax::Block {
        if next_is{ p, k = tok::Kind::lbrace } {
            let b = block{ &p }
            p.hand = Handler{ bare = true, block = true, first = op, last = op, left_end = 0, right_start = at }
            return b
        }
        let b = null_value{ &p }
        if not p.hand.bare { p.hand = Handler{ bare = true, block = false, first = op, last = op, left_end = 0, right_start = at } }
        return b
    }

    // `ifnull` or `iferr` (op) after an operator's expression, `a + f{} ifnull 0`: it takes all
    // of `a + f{}`, which is never an optional or a `!T`, so the error says what was meant,
    // with the handler on the last operand. left is the handler's left side as written, and e
    // the whole expression. Parentheses round left say it was meant, and the checker has it.
    fn whole_left { mut p: Parser, left: syntax::Expr, e: syntax::Expr, op: tok::Token } {
        if p.bad { return }
        let leaf = last_operand{ p, e = left }
        let mut b = message{ p }
        try! @fmt(&b, "`{}` takes all of `", utf8::String{ bytes = text_of{ p, t = op } })
        put_source{ p, &b, lo = left.span.start, hi = left.span.end }
        try! @fmt(&b, "` before it, which is never {}: write `", if op.kind == tok::Kind::kw_ifnull { "optional" } else { "a `!T`" })
        put_source{ p, &b, lo = left.span.start, hi = leaf }
        try! @fmt(&b, "(")
        put_source{ p, &b, lo = leaf, hi = e.span.end }
        try! @fmt(&b, ")`")
        diag::error{ diags = p.diags, span = op.span, msg = utf8::view{ b } }
    }

    // Where the last operand of an operator's expression begins: `f{}` in `a + -f{}`. e's own
    // start if it is no operator's, or is in parentheses, which only its span shows.
    fn last_operand { p: Parser, e: syntax::Expr } -> u32 {
        match e.k {
            binary{ a, b } => {
                if a.span.start == e.span.start { return last_operand{ p, e = b.* } }
            }
            neg{ e = x } | lnot{ e = x } | bnot{ e = x } => {
                if p.text[e.span.start] != '(' { return last_operand{ p, e = x.* } }
            }
            else => {}
        }
        return e.span.start
    }

    // A handler beside a comparison, `is`, `and` or `or` (op), without parentheses: an error
    // that shows both ways to write them (§11, Expressions, rule 7). a is the left operand and
    // ha its handler, if it is one; hb is the right operand's, which began at offset b_start
    // and has just ended. A handler on the left whose right side is a block reads one way only.
    fn mixed { mut p: Parser, a: syntax::Expr, ha: Handler, op: tok::Token, b_start: u32, hb: Handler } {
        if p.bad { return }
        let lo = a.span.start
        let hi = prev_end{ p }
        let mut b = message{ p }
        if ha.bare and not ha.block {
            // `l h r op b`: `(l h r) op b` or `l h (r op b)`
            try! @fmt(&b, "`{}` beside `{}` needs parentheses: write `(", utf8::String{ bytes = text_of{ p, t = ha.last } }, utf8::String{ bytes = text_of{ p, t = op } })
            put_source{ p, &b, lo, hi = a.span.end }
            try! @fmt(&b, ")")
            put_source{ p, &b, lo = a.span.end, hi }
            try! @fmt(&b, "` or `")
            put_source{ p, &b, lo, hi = ha.right_start }
            try! @fmt(&b, "(")
            put_source{ p, &b, lo = ha.right_start, hi }
            try! @fmt(&b, ")`")
            diag::error{ diags = p.diags, span = ha.last.span, msg = utf8::view{ b } }
        } else if hb.bare {
            // `a op l h r`: `a op (l h r)` or `(a op l) h r`
            try! @fmt(&b, "`{}` beside `{}` needs parentheses: write `", utf8::String{ bytes = text_of{ p, t = hb.first } }, utf8::String{ bytes = text_of{ p, t = op } })
            put_source{ p, &b, lo, hi = b_start }
            try! @fmt(&b, "(")
            put_source{ p, &b, lo = b_start, hi }
            try! @fmt(&b, ")` or `(")
            put_source{ p, &b, lo, hi = hb.left_end }
            try! @fmt(&b, ")")
            put_source{ p, &b, lo = hb.left_end, hi }
            try! @fmt(&b, "`")
            diag::error{ diags = p.diags, span = hb.first.span, msg = utf8::view{ b } }
        }
    }

    // The source from lo to hi, for a message, each run of spaces and line ends as one space.
    fn put_source { p: Parser, mut b: utf8::Builder(arena::Arena), lo: u32, hi: u32 } {
        let mut i: usize = lo
        while i < hi {
            let mut k = i
            if is_space{ c = p.text[i] } {
                while k < hi and is_space{ c = p.text[k] } { k = k + 1 }
                try! @fmt(&b, " ")
            } else {
                while k < hi and not is_space{ c = p.text[k] } { k = k + 1 }
                try! @fmt(&b, "{}", utf8::String{ bytes = p.text[i..k] })
            }
            i = k
        }
    }

    fn is_space { c: u8 } -> bool {
        return c == ' ' or c == '\t' or c == '\r' or c == '\n'
    }

    // The right side of `ifnull`, if it isn't a block: a block of it alone.
    fn null_value { mut p: Parser } -> syntax::Block {
        let id = new_id{ &p }
        let x = null_expr{ &p }
        return one{ &p, s = syntax::Stmt{ id, span = x.span, k = syntax::StmtKind::eval{ e = x } } }
    }

    // A name the parser makes up, where there is none in the source.
    fn made_name { mut p: Parser, at: source::Span, text: []u8 } -> syntax::Name {
        return syntax::Name{ id = new_id{ &p }, span = at, text }
    }

    // Binary operator levels between `ifnull` and prefix, loosest first. All are left to right.
    const LEVELS: u32 = 6

    fn in_level { k: tok::Kind, level: u32 } -> bool {
        if level == 0 { return k == tok::Kind::pipe }
        if level == 1 { return k == tok::Kind::caret }
        if level == 2 { return k == tok::Kind::amp }
        if level == 3 { return k == tok::Kind::shl or k == tok::Kind::shr or k == tok::Kind::shl_wrap }
        if level == 4 { return k == tok::Kind::plus or k == tok::Kind::minus or k == tok::Kind::plus_wrap or k == tok::Kind::minus_wrap }
        return k == tok::Kind::star or k == tok::Kind::slash or k == tok::Kind::percent or k == tok::Kind::star_wrap
    }

    // The operators of `level` and tighter.
    fn bin_expr { mut p: Parser, level: u32 } -> syntax::Expr {
        if level == LEVELS { return prefix{ &p } }
        let start = p.i
        let mut e = bin_expr{ &p, level = level + 1 }
        while in_level{ k = kind{ p, ahead = 0 }, level } and p.i != p.arm_end {
            let op = take{ &p }
            let b = bin_expr{ &p, level = level + 1 }
            e = binary{ &p, start, op, a = e, b }
        }
        return e
    }

    fn binary { mut p: Parser, start: usize, op: tok::Token, a: syntax::Expr, b: syntax::Expr } -> syntax::Expr {
        let x = box{ &p, value = a }
        let k = syntax::ExprKind::binary{ op = op.kind, a = x, b = box{ &p, value = b } }
        return syntax::Expr{ id = new_id{ &p }, span = span_from{ p, start }, at = op.span.start, k }
    }

    fn prefix { mut p: Parser } -> syntax::Expr {
        let start = p.i
        if not enter{ &p } { return error_expr{ &p, start } }
        defer p.depth = p.depth - 1
        let k = kind{ p, ahead = 0 }
        if k == tok::Kind::amp {
            skip{ &p }
            let e = box{ &p, value = prefix{ &p } }
            return expr_from{ &p, start, k = syntax::ExprKind::addr{ e } }
        }
        if k == tok::Kind::minus {
            skip{ &p }
            let mut inner = prefix{ &p }
            // A literal takes the sign, unless it has one already.
            let mut folded = true
            match inner.k {
                int{ negative, value } => {
                    if negative { folded = false } else { inner.k = syntax::ExprKind::int{ negative = true, value } }
                }
                float{ negative, value } => {
                    if negative { folded = false } else { inner.k = syntax::ExprKind::float{ negative = true, value } }
                }
                else => { folded = false }
            }
            if folded {
                inner.span = span_from{ p, start }
                inner.at = inner.span.start
                return inner
            }
            let e = box{ &p, value = inner }
            return expr_from{ &p, start, k = syntax::ExprKind::neg{ e } }
        }
        if k == tok::Kind::kw_not {
            skip{ &p }
            let e = box{ &p, value = prefix{ &p } }
            return expr_from{ &p, start, k = syntax::ExprKind::lnot{ e } }
        }
        if k == tok::Kind::tilde {
            skip{ &p }
            let e = box{ &p, value = prefix{ &p } }
            return expr_from{ &p, start, k = syntax::ExprKind::bnot{ e } }
        }
        if k == tok::Kind::kw_try {
            skip{ &p }
            let panics = accept{ &p, k = tok::Kind::bang }       // `try!`: `!` never starts an expression
            // Its operand goes up to the end of its first call: `try f{}.x` is `(try f{}).x`,
            // and `try a.b{}` tries the call (§8, Errors, rule 7). Without a call it is the
            // whole postfix expression, and after a prefix operator that operator's.
            let x = kind{ p, ahead = 0 }
            if x == tok::Kind::amp or x == tok::Kind::minus or x == tok::Kind::kw_not or x == tok::Kind::tilde or x == tok::Kind::kw_try {
                let e = box{ &p, value = prefix{ &p } }
                return expr_from{ &p, start, k = syntax::ExprKind::trye{ e, panics } }
            }
            let operand = postfix_to{ &p, to_call = true }
            let called = operand.k is braced
            let e = expr_from{ &p, start, k = syntax::ExprKind::trye{ e = box{ &p, value = operand }, panics } }
            if not called { return e }
            return postfix_ops{ &p, start, from = e, to_call = false }
        }
        return postfix{ &p }
    }

    // An expression from `start` to here, at its start.
    fn expr_from { mut p: Parser, start: usize, k: syntax::ExprKind } -> syntax::Expr {
        return syntax::Expr{ id = new_id{ &p }, span = span_from{ p, start }, at = start_of{ p, start }, k }
    }

    fn postfix { mut p: Parser } -> syntax::Expr {
        return postfix_to{ &p, to_call = false }
    }

    // A postfix expression. With to_call it ends at the `}` of its first call or literal, if
    // it has one: `try`'s operand.
    fn postfix_to { mut p: Parser, to_call: bool } -> syntax::Expr {
        let start = p.i
        let paren = next_is{ p, k = tok::Kind::lparen }
        let mut e = primary{ &p }
        match e.k {
            ifx | matchx => { if not paren { return e } }   // `if` and `match` end at their `}`, unless in parentheses
            path{ segs } => { e = path_tail{ &p, start, e, segs } }
            else => {}
        }
        return postfix_ops{ &p, start, from = e, to_call }
    }

    // The postfix operators after `from`, which began at token `start`.
    fn postfix_ops { mut p: Parser, start: usize, from: syntax::Expr, to_call: bool } -> syntax::Expr {
        let mut e = from
        while true {
            let t = p.toks[p.i]
            let k = kind{ p, ahead = 0 }
            if k == tok::Kind::dot {
                skip{ &p }
                let base = box{ &p, value = e }
                if accept{ &p, k = tok::Kind::star } {
                    e = at_op{ &p, start, op = t, k = syntax::ExprKind::deref{ base } }
                } else {
                    let name = ident{ &p }
                    e = at_op{ &p, start, op = t, k = syntax::ExprKind::field{ base, name } }
                }
            } else if k == tok::Kind::lbracket and not t.nl {
                skip{ &p }
                let base = box{ &p, value = e }
                if accept{ &p, k = tok::Kind::dots } {
                    let hi = range_hi{ &p }
                    e = at_op{ &p, start, op = t, k = syntax::ExprKind::range{ base, lo = null, hi } }
                } else {
                    let lo = box{ &p, value = expr{ &p } }
                    if accept{ &p, k = tok::Kind::dots } {
                        let hi = range_hi{ &p }
                        e = at_op{ &p, start, op = t, k = syntax::ExprKind::range{ base, lo, hi } }
                    } else {
                        expect{ &p, k = tok::Kind::rbracket }
                        e = at_op{ &p, start, op = t, k = syntax::ExprKind::index{ base, i = lo } }
                    }
                }
            } else if k == tok::Kind::lbrace and not t.nl {
                if p.in_cond and not brace_is_call{ &p } { return e }
                e = braced{ &p, start, callee = e }
                if to_call { return e }
            } else {
                return e
            }
        }
        return e
    }

    // After `lo..`: the end of a range, if any, and its `]`.
    fn range_hi { mut p: Parser } -> ?*syntax::Expr {
        let mut hi: ?*syntax::Expr = null
        if not next_is{ p, k = tok::Kind::rbracket } { hi = box{ &p, value = expr{ &p } } }
        expect{ &p, k = tok::Kind::rbracket }
        return hi
    }

    // A postfix expression from `start` to here, at its operator.
    fn at_op { mut p: Parser, start: usize, op: tok::Token, k: syntax::ExprKind } -> syntax::Expr {
        return syntax::Expr{ id = new_id{ &p }, span = span_from{ p, start }, at = op.span.start, k }
    }

    // The rest of a path: `::name` and generic arguments `(T, ...)` on the same line.
    fn path_tail { mut p: Parser, start: usize, e: syntax::Expr, segs: []syntax::Seg } -> syntax::Expr {
        if not next_is{ p, k = tok::Kind::colons } and not (next_is{ p, k = tok::Kind::lparen } and not nl{ p }) { return e }
        let mut xs = list::new(syntax::Seg){ realloc = arena::alloc, heap = p.heap }
        let mut i: usize = 0
        while i < segs.len {
            try! list::push{ list = &xs, item = segs[i] }
            i = i + 1
        }
        while true {
            if accept{ &p, k = tok::Kind::colons } {
                try! list::push{ list = &xs, item = syntax::Seg{ name = ident{ &p }, targs = null, rest = false } }
            } else if next_is{ p, k = tok::Kind::lparen } and not nl{ p } and xs.items[xs.len - 1].targs == null {
                let targs = type_list{ &p }
                xs.items[xs.len - 1].targs = targs
            } else {
                break
            }
        }
        return syntax::Expr{ id = e.id, span = span_from{ p, start }, at = e.at, k = syntax::ExprKind::path{ segs = list::items{ list = xs } } }
    }

    fn braced { mut p: Parser, start: usize, callee: syntax::Expr } -> syntax::Expr {
        let t = take{ &p }
        let c = box{ &p, value = callee }
        let mut items = list::new(syntax::Item){ realloc = arena::alloc, heap = p.heap }
        let mut forward = false
        let mut bind = false
        while more{ p, close = tok::Kind::rbrace } {
            let it = p.toks[p.i]
            if forward {
                fail{ &p, msg = "'..' must be the last item" }
                break
            }
            if bind {
                fail{ &p, msg = "'_' must be the last item" }
                break
            }
            let s = p.i
            if accept{ &p, k = tok::Kind::dots } {
                if next_is{ p, k = tok::Kind::rbrace } or next_is{ p, k = tok::Kind::comma } {
                    forward = true
                } else {
                    // `..e`: a spread
                    let name = syntax::Name{ id = new_id{ &p }, span = source::Span{ file = p.file, start = it.span.start, end = it.span.start }, text = p.text[..0] }
                    let value = expr{ &p }
                    try! list::push{ list = &items, item = syntax::Item{ span = span_from{ p, start = s }, name, value, pun = false, spread = true } }
                }
            } else if it.kind == tok::Kind::ident and slice::eq_bytes{ a = text_of{ p, t = it }, b = "_" } {
                skip{ &p }
                bind = true
            } else if accept{ &p, k = tok::Kind::amp } {
                let name = ident{ &p }
                if not at_item_end{ p } {
                    try! list::push{ list = &items, item = long_pun{ &p, s, name } }
                } else {
                    let path = name_path{ &p, name = again{ &p, n = name } }
                    let value = syntax::Expr{
                        id = new_id{ &p }, span = span_from{ p, start = s }, at = it.span.start,
                        k = syntax::ExprKind::addr{ e = box{ &p, value = path } },
                    }
                    try! list::push{ list = &items, item = syntax::Item{ span = span_from{ p, start = s }, name, value, pun = true, spread = false } }
                }
            } else {
                let name = ident{ &p }
                if accept{ &p, k = tok::Kind::assign } {
                    let value = expr{ &p }
                    try! list::push{ list = &items, item = syntax::Item{ span = span_from{ p, start = s }, name, value, pun = false, spread = false } }
                } else if not at_item_end{ p } {
                    try! list::push{ list = &items, item = long_pun{ &p, s, name } }
                } else {
                    let value = name_path{ &p, name = again{ &p, n = name } }
                    try! list::push{ list = &items, item = syntax::Item{ span = span_from{ p, start = s }, name, value, pun = true, spread = false } }
                }
            }
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        expect{ &p, k = tok::Kind::rbrace }
        let k = syntax::ExprKind::braced{ callee = c, items = list::items{ list = items }, forward, bind }
        return syntax::Expr{ id = new_id{ &p }, span = span_from{ p, start }, at = t.span.start, k }
    }

    // After a pun's name: the item ends here, at a `,` or the `}`, so the pun is the name alone.
    fn at_item_end { p: Parser } -> bool {
        return next_is{ p, k = tok::Kind::comma } or next_is{ p, k = tok::Kind::rbrace }
    }

    // An item without `name =` that is more than a name, from token s (§3, rule 6). A place that
    // ends in a field's name is a pun of that name: `&g.rng` is `rng = &g.rng`, and `a.d` is
    // `d = a.d`. Anything else names no field: an error that says what to write, without
    // recovering, since the item's expression is whole. Its name is then empty, zero-width at
    // its start, which the checker takes for any field, so that this is the item's only error.
    fn long_pun { mut p: Parser, s: usize, name: syntax::Name } -> syntax::Item {
        p.i = s
        let value = expr{ &p }
        let mut place = value
        match value.k {
            addr{ e } => { place = e.* }
            else => {}
        }
        match place.k {
            field{ base, name = last } => {
                if pun_place{ e = base.* } {
                    return syntax::Item{ span = span_from{ p, start = s }, name = again{ &p, n = last }, value, pun = true, spread = false }
                }
            }
            // The name alone after all: what follows it is not part of the item.
            path{ segs } => {
                if segs.len == 1 and segs[0].targs == null {
                    return syntax::Item{ span = span_from{ p, start = s }, name, value, pun = true, spread = false }
                }
            }
            else => {}
        }
        let text = utf8::String{ bytes = p.text[value.span.start..value.span.end] }
        let why: utf8::String = match place.k {
            index => { "this one ends in an index" }
            deref => { "this one ends in `.*`" }
            range => { "this one ends in a range" }
            braced => { "this one is a call or a literal" }
            field | path => { "this one isn't a place" }
            else => { "this one is an expression" }
        }
        if not p.bad {
            let mut b = message{ p }
            try! @fmt(&b, "a pun is a place that ends in a field's name, as `&g.rng` is for `rng`, and {}: write the field's name, as `name = {}`", why, text)
            diag::error{ diags = p.diags, span = p.toks[s].span, msg = utf8::view{ b } }
        }
        let span = span_from{ p, start = s }
        let none = syntax::Name{ id = new_id{ &p }, span = source::Span{ file = p.file, start = span.start, end = span.start }, text = p.text[..0] }
        return syntax::Item{ span, name = none, value, pun = false, spread = false }
    }

    // Whether e is a place by its shape (§11, Places): a name, then fields, indexes and derefs.
    fn pun_place { e: syntax::Expr } -> bool {
        match e.k {
            path{ segs } => { return segs.len == 1 and segs[0].targs == null }
            field{ base } => { return pun_place{ e = base.* } }
            index{ base } => { return pun_place{ e = base.* } }
            deref{ base } => { return pun_place{ e = base.* } }
            else => { return false }
        }
    }

    // The same name as another node: a pun's item name and its value are two uses of it.
    fn again { mut p: Parser, n: syntax::Name } -> syntax::Name {
        return syntax::Name{ id = new_id{ &p }, span = n.span, text = n.text }
    }

    // A path of one name, where the name is.
    fn name_path { mut p: Parser, name: syntax::Name } -> syntax::Expr {
        let mut segs = list::new(syntax::Seg){ realloc = arena::alloc, heap = p.heap }
        try! list::push{ list = &segs, item = syntax::Seg{ name, targs = null, rest = false } }
        let k = syntax::ExprKind::path{ segs = list::items{ list = segs } }
        return syntax::Expr{ id = new_id{ &p }, span = name.span, at = name.span.start, k }
    }

    fn primary { mut p: Parser } -> syntax::Expr {
        let start = p.i
        let t = p.toks[p.i]
        let k = kind{ p, ahead = 0 }
        let mut e = syntax::ExprKind::error
        if k == tok::Kind::int or k == tok::Kind::char {
            skip{ &p }
            e = syntax::ExprKind::int{ negative = false, value = lexer::int_value{ text = text_of{ p, t } } }
        } else if k == tok::Kind::float {
            skip{ &p }
            e = syntax::ExprKind::float{ negative = false, value = lexer::float_value{ heap = p.heap, text = text_of{ p, t } } }
        } else if k == tok::Kind::str {
            skip{ &p }
            e = syntax::ExprKind::str{ bytes = lexer::str_value{ heap = p.heap, text = text_of{ p, t } } }
        } else if k == tok::Kind::ident {
            return name_path{ &p, name = ident{ &p } }
        } else if k == tok::Kind::kw_true or k == tok::Kind::kw_false {
            skip{ &p }
            e = syntax::ExprKind::boolean{ value = k == tok::Kind::kw_true }
        } else if k == tok::Kind::kw_null {
            skip{ &p }
            e = syntax::ExprKind::nil
        } else if k == tok::Kind::kw_if {
            return if_expr{ &p }
        } else if k == tok::Kind::kw_match {
            let id = new_id{ &p }
            let x = match_node{ &p }
            return syntax::Expr{ id, span = span_from{ p, start }, at = t.span.start, k = syntax::ExprKind::matchx{ x } }
        } else if k == tok::Kind::builtin {
            return builtin{ &p }
        } else if k == tok::Kind::lparen {
            skip{ &p }
            let mut inner = expr{ &p }
            expect{ &p, k = tok::Kind::rparen }
            inner.span = span_from{ p, start }
            return inner
        } else if k == tok::Kind::lbracket {
            skip{ &p }
            let mut elems = list::new(syntax::Expr){ realloc = arena::alloc, heap = p.heap }
            if not accept{ &p, k = tok::Kind::rbracket } {
                let first = expr{ &p }
                if accept{ &p, k = tok::Kind::semi } {
                    let elem = box{ &p, value = first }
                    let count = box{ &p, value = expr{ &p } }
                    expect{ &p, k = tok::Kind::rbracket }
                    return expr_from{ &p, start, k = syntax::ExprKind::repeat{ elem, count } }
                }
                try! list::push{ list = &elems, item = first }
                while accept{ &p, k = tok::Kind::comma } {
                    if next_is{ p, k = tok::Kind::rbracket } { break }
                    try! list::push{ list = &elems, item = expr{ &p } }
                }
                expect{ &p, k = tok::Kind::rbracket }
            }
            e = syntax::ExprKind::array{ elems = list::items{ list = elems } }
        } else if k == tok::Kind::error {
            skip{ &p }
        } else {
            expected{ &p, what = "an expression" }
        }
        return expr_from{ &p, start, k = e }
    }

    // Every builtin's signature (spec §13). Type arguments come first, so the name alone says how
    // to parse each argument. Value arguments from lo to hi, where ANY means no limit.
    struct Builtin { name: []u8, types: u32, lo: u32, hi: u32, usage: utf8::String }

    const ANY: u32 = 4294967295

    const BUILTINS: [_]Builtin = [
        Builtin{ name = "size_of",  types = 1, lo = 0, hi = 0, usage = "@size_of(T)" },
        Builtin{ name = "align_of", types = 1, lo = 0, hi = 0, usage = "@align_of(T)" },
        Builtin{ name = "offset_of", types = 1, lo = 1, hi = 1, usage = "@offset_of(T, field)" },
        Builtin{ name = "as",       types = 1, lo = 1, hi = 1, usage = "@as(T, x)" },
        Builtin{ name = "trunc",    types = 1, lo = 1, hi = 1, usage = "@trunc(T, x)" },
        Builtin{ name = "cast",     types = 1, lo = 1, hi = 1, usage = "@cast(*U, q)" },
        Builtin{ name = "addr",     types = 0, lo = 1, hi = 1, usage = "@addr(q)" },
        Builtin{ name = "slice",    types = 0, lo = 2, hi = 2, usage = "@slice(p, n)" },
        Builtin{ name = "hash",     types = 0, lo = 1, hi = 1, usage = "@hash(x)" },
        Builtin{ name = "min",      types = 0, lo = 2, hi = 2, usage = "@min(a, b)" },
        Builtin{ name = "max",      types = 0, lo = 2, hi = 2, usage = "@max(a, b)" },
        Builtin{ name = "clamp",    types = 0, lo = 3, hi = 3, usage = "@clamp(x, lo, hi)" },
        Builtin{ name = "round",    types = 1, lo = 1, hi = 1, usage = "@round(T, x)" },
        Builtin{ name = "saturate", types = 1, lo = 1, hi = 1, usage = "@saturate(T, x)" },
        Builtin{ name = "round_saturate", types = 1, lo = 1, hi = 1, usage = "@round_saturate(T, x)" },
        Builtin{ name = "panic",    types = 0, lo = 0, hi = 1, usage = "@panic() or @panic(\"reason\")" },
        Builtin{ name = "fmt",      types = 0, lo = 1, hi = ANY, usage = "@fmt(b, \"format\", args...) or @fmt(\"format\", args...)" },
        Builtin{ name = "expect",   types = 0, lo = 2, hi = 2, usage = "@expect(&t, condition)" },
        Builtin{ name = "atomic_load", types = 0, lo = 2, hi = 2, usage = "@atomic_load(p, order)" },
        Builtin{ name = "atomic_store", types = 0, lo = 3, hi = 3, usage = "@atomic_store(p, value, order)" },
        Builtin{ name = "atomic_exchange", types = 0, lo = 3, hi = 3, usage = "@atomic_exchange(p, value, order)" },
        Builtin{ name = "atomic_compare_exchange", types = 0, lo = 4, hi = 4, usage = "@atomic_compare_exchange(p, expected, desired, order)" },
        Builtin{ name = "atomic_add", types = 0, lo = 3, hi = 3, usage = "@atomic_add(p, value, order)" },
        Builtin{ name = "atomic_subtract", types = 0, lo = 3, hi = 3, usage = "@atomic_subtract(p, value, order)" },
        Builtin{ name = "fence",    types = 0, lo = 1, hi = 1, usage = "@fence(order)" },
        Builtin{ name = "record_size", types = 0, lo = 1, hi = 1, usage = "@record_size(run)" },
        Builtin{ name = "record_copy", types = 0, lo = 2, hi = 2, usage = "@record_copy(run, into)" },
    ]

    fn builtin { mut p: Parser } -> syntax::Expr {
        let start = p.i
        let t = take{ &p }
        let name = syntax::Name{
            id = new_id{ &p }, span = source::Span{ file = p.file, start = t.span.start + 1, end = t.span.end },
            text = p.text[t.span.start + 1..t.span.end],
        }
        let mut n: usize = 0
        while n < BUILTINS.len and not slice::eq_bytes{ a = BUILTINS[n].name, b = name.text } { n = n + 1 }
        if n == BUILTINS.len {
            failf_at{ &p, msg = @fmt("unknown builtin `@{}`", utf8::String{ bytes = name.text }), t }
            return expr_from{ &p, start, k = syntax::ExprKind::error }
        }
        let sig = BUILTINS[n]
        if not next_is{ p, k = tok::Kind::lparen } {
            failf{ &p, msg = @fmt("expected '(' after @{}: {}", utf8::String{ bytes = name.text }, sig.usage) }
            return expr_from{ &p, start, k = syntax::ExprKind::error }
        }
        skip{ &p }
        let mut targ: ?*syntax::TypeExpr = null
        let mut args = list::new(syntax::Expr){ realloc = arena::alloc, heap = p.heap }
        let mut count: u32 = 0
        while (count < sig.types or count - sig.types < sig.hi) and more{ p, close = tok::Kind::rparen } {
            if count < sig.types {
                targ = box{ &p, value = type_expr{ &p } }
            } else {
                try! list::push{ list = &args, item = expr{ &p } }
            }
            count = count + 1
            if not accept{ &p, k = tok::Kind::comma } { break }
        }
        if count < sig.types + sig.lo or not next_is{ p, k = tok::Kind::rparen } {
            failf{ &p, msg = @fmt("wrong number of arguments: {}", sig.usage) }
        }
        skip{ &p }
        let k = syntax::ExprKind::builtin{ name, targ, args = list::items{ list = args } }
        return expr_from{ &p, start, k }
    }

    fn error_expr { mut p: Parser, start: usize } -> syntax::Expr {
        return expr_from{ &p, start, k = syntax::ExprKind::error }
    }

    // ---- recovery

    // After an error in the statement, match arm or declaration that began at token `start`:
    // skips to where the next one can begin, and clears `bad`. It counts brackets from `start`,
    // and stops at the first token after the error that is
    //
    // - a declaration keyword that begins a line, whatever the count (a `}` may be missing),
    // - for a statement or arm: the start of a line or a `;` with every bracket closed, or a `}`
    //   that closes the enclosing block,
    // - for a declaration in a namespace: a `}` that begins a line and closes the namespace,
    // - or the end of the file.
    fn sync { mut p: Parser, start: usize, in_block: bool, top: bool } {
        let mut depth: u32 = 0
        let mut k = start
        while p.toks[k].kind != tok::Kind::eof {
            let t = p.toks[k]
            if k >= p.i {
                if t.nl and is_decl_keyword{ k = t.kind } and (k > start or in_block) { break }
                if k > start and depth == 0 {
                    if in_block and (t.nl or t.kind == tok::Kind::semi or t.kind == tok::Kind::rbrace) { break }
                    if not in_block and not top and t.nl and t.kind == tok::Kind::rbrace { break }
                }
            }
            if t.kind == tok::Kind::lbrace or t.kind == tok::Kind::lparen or t.kind == tok::Kind::lbracket {
                depth = depth + 1
            } else if (t.kind == tok::Kind::rbrace or t.kind == tok::Kind::rparen or t.kind == tok::Kind::rbracket) and depth > 0 {
                depth = depth - 1
            }
            k = k + 1
        }
        p.i = k
        p.bad = false
    }

    // At `distinct T` after `type Name =` (§12): `distinct` is a keyword only there, before a
    // type on the same line, and a name anywhere else, `type X = distinct` among them.
    fn at_distinct { p: Parser } -> bool {
        if not next_is{ p, k = tok::Kind::ident } or not slice::eq_bytes{ a = text_of{ p, t = p.toks[p.i] }, b = "distinct" } { return false }
        if p.i + 1 >= p.toks.len or p.toks[p.i + 1].nl { return false }
        let k = kind{ p, ahead = 1 }
        return k == tok::Kind::ident or k == tok::Kind::star or k == tok::Kind::question or k == tok::Kind::bang
               or k == tok::Kind::lbracket or k == tok::Kind::kw_fn or k == tok::Kind::kw_extern or k == tok::Kind::amp
    }

    // At `error name`, which declares an error: `error` is a name anywhere else.
    fn at_error_decl { p: Parser } -> bool {
        return next_is{ p, k = tok::Kind::ident } and slice::eq_bytes{ a = text_of{ p, t = p.toks[p.i] }, b = "error" }
               and kind{ p, ahead = 1 } == tok::Kind::ident
    }

    // A token that can begin a declaration, at the start of a line, for recovery.
    fn is_decl_keyword { k: tok::Kind } -> bool {
        return is_decl_start{ k } or k == tok::Kind::hash
    }

    fn is_decl_start { k: tok::Kind } -> bool {
        return k == tok::Kind::kw_fn or k == tok::Kind::kw_struct or k == tok::Kind::kw_union
               or k == tok::Kind::kw_enum or k == tok::Kind::kw_type or k == tok::Kind::kw_const
               or k == tok::Kind::kw_namespace or k == tok::Kind::kw_extern or k == tok::Kind::kw_capability
    }

    // At a declaration keyword that begins a line: a block or match that reaches one after an
    // error ends there, since its `}` is probably missing.
    fn at_decl { p: Parser } -> bool {
        let t = p.toks[p.i]
        return t.nl and is_decl_keyword{ k = t.kind }
    }

    // Reports msg at the current token, unless recovering.
    fn fail { mut p: Parser, msg: utf8::String } {
        fail_at{ &p, msg, t = p.toks[p.i] }
    }

    // fail and fail_at, with a message that msg writes: `failf{ &p, msg = @fmt("...", x) }`.
    fn failf { mut p: Parser, msg: utf8::Fmt(arena::Arena) } {
        failf_at{ &p, msg, t = p.toks[p.i] }
    }

    fn failf_at { mut p: Parser, msg: utf8::Fmt(arena::Arena), t: tok::Token } {
        let mut b = message{ p }
        try! msg{ &b }
        fail_at{ &p, msg = utf8::view{ b }, t }
    }

    // Reports msg at t, unless recovering, and starts recovering.
    fn fail_at { mut p: Parser, msg: utf8::String, t: tok::Token } {
        if p.bad { return }
        p.bad = true
        if p.errored and p.i <= p.err_at { return }      // nothing consumed since the last error
        p.errored = true
        p.err_at = p.i
        if t.kind == tok::Kind::error { return }          // the lexer has reported it
        diag::error{ diags = p.diags, span = t.span, msg }
    }

    // "expected WHAT, found TOKEN"
    fn expected { mut p: Parser, what: utf8::String } {
        if p.bad { return }
        let mut b = message{ p }
        try! @fmt(&b, "expected {}, found ", what)
        expected_msg{ &p, msg = utf8::view{ b } }
    }

    // msg, then the current token as ctxi describes it.
    fn expected_msg { mut p: Parser, msg: utf8::String } {
        if p.bad { return }
        let t = p.toks[p.i]
        let mut b = message{ p }
        if t.kind == tok::Kind::eof {
            try! @fmt(&b, "{}end of file", msg)
        } else {
            try! @fmt(&b, "{}'{}'", msg, utf8::String{ bytes = text_of{ p, t } })
        }
        fail{ &p, msg = utf8::view{ b } }
    }

    // A builder for a message, from the parser's heap.
    fn message { p: Parser } -> utf8::Builder(arena::Arena) {
        return utf8::builder{ realloc = arena::alloc, heap = p.heap }
    }


    // ---- tokens

    // The kind of the token `ahead` of the current one. While recovering, every token is eof.
    fn kind { p: Parser, ahead: usize } -> tok::Kind {
        if p.bad { return tok::Kind::eof }
        let k = p.i + ahead
        if k >= p.toks.len { return tok::Kind::eof }
        return p.toks[k].kind
    }

    fn next_is { p: Parser, k: tok::Kind } -> bool {
        return kind{ p, ahead = 0 } == k
    }

    // Whether a newline comes before the current token, as it does before the end of the file.
    fn nl { p: Parser } -> bool {
        return p.bad or p.toks[p.i].nl
    }

    // Whether a list closed by `close` goes on: at the end of the file it does, and the next
    // item reports it.
    fn more { p: Parser, close: tok::Kind } -> bool {
        return not p.bad and not next_is{ p, k = close }
    }

    // Consumes the current token, unless it is the end of the file or the parser is recovering.
    fn skip { mut p: Parser } {
        if kind{ p, ahead = 0 } != tok::Kind::eof { p.i = p.i + 1 }
    }

    fn take { mut p: Parser } -> tok::Token {
        let t = p.toks[p.i]
        skip{ &p }
        return t
    }

    fn accept { mut p: Parser, k: tok::Kind } -> bool {
        if not next_is{ p, k } { return false }
        skip{ &p }
        return true
    }

    fn expect { mut p: Parser, k: tok::Kind } {
        if accept{ &p, k } or p.bad { return }
        let mut b = message{ p }
        try! @fmt(&b, "expected '{}', found ", utf8::String{ bytes = kind_text{ k } })
        expected_msg{ &p, msg = utf8::view{ b } }
    }

    // A keyword's or operator's text.
    fn kind_text { k: tok::Kind } -> []u8 {
        if tok::is_keyword{ kind = k } { return tok::KEYWORDS[@as(usize, k) - @as(usize, tok::Kind::kw_fn)] }
        return tok::op_text{ kind = k }
    }

    fn skip_semis { mut p: Parser } {
        while accept{ &p, k = tok::Kind::semi } {}
    }

    fn text_of { p: Parser, t: tok::Token } -> []u8 {
        return p.text[t.span.start..t.span.end]
    }

    // A name, or a missing one where the name should have been. A keyword there gets told so.
    fn ident { mut p: Parser } -> syntax::Name {
        if next_is{ p, k = tok::Kind::ident } { return keyword_name{ &p } }
        if tok::is_keyword{ kind = kind{ p, ahead = 0 } } {
            let word = utf8::String{ bytes = text_of{ p, t = p.toks[p.i] } }
            failf{ &p, msg = @fmt("expected a name, found '{}': `{}` is a keyword and can't be a name; use another, such as `{}_`", word, word, word) }
        } else {
            expected{ &p, what = "a name" }
        }
        let at = prev_end{ p }
        return syntax::Name{ id = new_id{ &p }, span = source::Span{ file = p.file, start = at, end = at }, text = p.text[..0] }
    }

    // The current token as a name: an identifier, or `null` in a pattern.
    fn keyword_name { mut p: Parser } -> syntax::Name {
        let t = take{ &p }
        return syntax::Name{ id = new_id{ &p }, span = t.span, text = text_of{ p, t } }
    }

    // ---- nodes

    fn new_id { mut p: Parser } -> u32 {
        let id = p.ids
        p.ids = p.ids + 1
        return id
    }

    // From token `start` to the last token consumed. Zero-width after the last token consumed
    // if nothing has been since `start`.
    fn span_from { p: Parser, start: usize } -> source::Span {
        if p.i <= start {
            let at = prev_end{ p }
            return source::Span{ file = p.file, start = at, end = at }
        }
        return source::Span{ file = p.file, start = p.toks[start].span.start, end = p.toks[p.i - 1].span.end }
    }

    // Where a node from token `start` begins: see span_from.
    fn start_of { p: Parser, start: usize } -> u32 {
        return span_from{ p, start }.start
    }

    fn prev_end { p: Parser } -> u32 {
        if p.i == 0 { return 0 }
        return p.toks[p.i - 1].span.end
    }

    // Guards the stack: false, with a diagnostic, if nesting is too deep.
    fn enter { mut p: Parser } -> bool {
        if p.depth >= MAX_DEPTH {
            fail{ &p, msg = "too deeply nested" }
            return false
        }
        p.depth = p.depth + 1
        return true
    }

    fn box(T) { mut p: Parser, value: T } -> *T {
        let x = try! alloc::new{ realloc = arena::alloc, heap = p.heap, value }
        return x
    }

}
