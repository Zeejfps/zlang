// ctxc: the ctxlang compiler, written in ctxlang. A directory is one program: this file holds
// the driver; source.ctx, diag.ctx and lexer.ctx the front end so far; ir.ctx the typed IR,
// ir_read.ctx and ir_print.ctx its text form; emit_c.ctx the C backend; dump.ctx text dumps for
// tests.
//
//   python -m ctxi ctxc roundtrip FILE.ir      reads IR (from `python -m ctxi PROGRAM --ir`)
//                                              and prints it back; the output must equal FILE.ir
//   python -m ctxi ctxc c FILE.ir OUT.c        writes the program as C, for ctxc/rt/ctxrt.c
//   python -m ctxi ctxc tokens FILE...         prints each file's tokens (dump.ctx), each
//                                              after a line `file FILE`
//
// tools/ctxc.py runs the whole pipeline: IR, C and the C compiler.

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, args: Args } -> i32 {
    let mut to_c = false
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "tokens" } {
        return tokens{ .. }
    }
    if args.len == 3 and slice::eq_bytes{ a = args[0], b = "c" } {
        to_c = true
    } else if args.len != 2 or not slice::eq_bytes{ a = args[0], b = "roundtrip" } {
        io::eprintln{ &io, s = "usage: ctxc roundtrip FILE.ir | ctxc c FILE.ir OUT.c | ctxc tokens FILE..." }
        return 2
    }
    let path = args[1]

    // The file, its IR and the output all live in one arena over pages sized to the input.
    let ok{ value = size } = fs::size{ &fs, path } else {
        cannot{ &io, path, what = "cannot read" }
        return 1
    }
    let some{ value = pages } = mem::pages{ &mem, size = 16777216 + @as(usize, size) * 32 } else {
        cannot{ &io, path, what = "out of memory reading" }
        return 1
    }
    let mut heap = arena::new{ buf = pages }
    let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } else {
        cannot{ &io, path, what = "cannot read" }
        return 1
    }

    let mut r = ir_read::reader{ text, heap = &heap }
    let prog = ir_read::program{ &r }
    if r.failed {
        report{ &io, path, text, at = r.error_at, problem = r.error }
        return 1
    }

    if to_c {
        let out = args[2]
        let code = emit::program{ heap = &heap, p = prog }
        let ok = fs::write_all{ &fs, path = out, bytes = code } else {
            cannot{ &io, path = out, what = "cannot write" }
            return 1
        }
        return 0
    }
    let mut o = ir_print::out{ heap = &heap, types = prog.types }
    ir_print::program{ &o, p = prog }
    io::write{ &io, to = io::Stream::out, bytes = list::items{ list = o.bytes } }
    return 0
}

// `ctxc tokens FILE...`: lexes each file on its own, in one arena that is reset between files.
fn tokens { mut io: Io, mut fs: Fs, mut mem: Mem, args: Args } -> i32 {
    let mut largest: u64 = 0
    let mut i: usize = 1
    while i < args.len {
        let ok{ value = size } = fs::size{ &fs, path = args[i] } else {
            cannot{ &io, path = args[i], what = "cannot read" }
            return 1
        }
        if size > largest { largest = size }
        i = i + 1
    }
    let some{ value = pages } = mem::pages{ &mem, size = 16777216 + @as(usize, largest) * 128 } else {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut heap = arena::new{ buf = pages }
    i = 1
    while i < args.len {
        arena::reset{ &heap }
        let path = args[i]
        let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } else {
            cannot{ &io, path, what = "cannot read" }
            return 1
        }
        let mut diags = diag::new{}
        let lexed = lexer::lex{ text, file = 0, &heap, &diags }
        let mut out = utf8::builder{ realloc = arena::alloc }
        _ = utf8::push{ b = &out, &heap, s = "file " }
        _ = utf8::push{ b = &out, &heap, s = utf8::String{ bytes = path } }
        _ = utf8::push{ b = &out, &heap, s = "\n" }
        dump::tokens{ &out, &heap, text, lexed, diags }
        io::write{ &io, to = io::Stream::out, bytes = utf8::view{ b = out }.bytes }
        i = i + 1
    }
    return 0
}

// "PATH: what"
fn cannot { mut io: Io, path: []u8, what: utf8::String } {
    io::write{ &io, to = io::Stream::err, bytes = path }
    io::eprint{ &io, s = ": " }
    io::eprintln{ &io, s = what }
}

// "PATH:LINE:COL: error: PROBLEM" for a malformed IR file.
fn report { mut io: Io, path: []u8, text: []u8, at: usize, problem: ir_read::Problem } {
    let mut line = 1
    let mut col = 1
    let mut i = 0
    while i < at and i < text.len {
        if text[i] == '\n' {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    let mut buf: [256]u8
    let mut heap = arena::new{ buf = buf[..] }
    let mut b = utf8::builder{ realloc = arena::alloc }
    _ = utf8::push_char{ &b, &heap, c = ':' }
    _ = utf8::push_u64{ &b, &heap, n = line }
    _ = utf8::push_char{ &b, &heap, c = ':' }
    _ = utf8::push_u64{ &b, &heap, n = col }
    _ = utf8::push{ &b, &heap, s = ": error: " }
    match problem {
        expected{ c } => {
            _ = utf8::push{ &b, &heap, s = "expected '" }
            _ = utf8::push_char{ &b, &heap, c }
            _ = utf8::push_char{ &b, &heap, c = '\'' }
        }
        expected_int => {
            _ = utf8::push{ &b, &heap, s = "expected an integer" }
        }
        int_too_large   => { _ = utf8::push{ &b, &heap, s = "integer too large" } }
        expected_symbol => { _ = utf8::push{ &b, &heap, s = "expected a symbol" } }
        expected_string => { _ = utf8::push{ &b, &heap, s = "expected a string" } }
        bad_escape      => { _ = utf8::push{ &b, &heap, s = "invalid escape in string" } }
        bad_float       => { _ = utf8::push{ &b, &heap, s = "invalid float" } }
        unknown_tag     => { _ = utf8::push{ &b, &heap, s = "unexpected tag" } }
        bad_id          => { _ = utf8::push{ &b, &heap, s = "type id out of order" } }
        trailing_text   => { _ = utf8::push{ &b, &heap, s = "unexpected text after (main)" } }
    }
    io::write{ &io, to = io::Stream::err, bytes = path }
    io::eprintln{ &io, s = utf8::view{ b } }
}
