// ctxc: the ctxlang compiler, written in ctxlang. A directory is one program: this file holds
// the driver; source.ctx, diag.ctx, lexer.ctx, syntax.ctx, parser.ctx, types.ctx, check.ctx and
// nodes.ctx (its tables over syntax nodes) the front end, and report.ctx its diagnostics as they
// are shown; lower.ctx the checked
// program as IR; ir.ctx the typed IR, ir_read.ctx and ir_print.ctx its text form; emit_c.ctx
// the C backend; eval.ctx an interpreter over the IR, which comptime.ctx runs consts in;
// dump.ctx text dumps for tests; drive.ctx the driver, which runs the C compiler.
//
//   ctxc run PATH [-- ARGS...]                  builds the program at PATH (a .ctx file, or a
//                                               directory, maybe with a build.ctx) with the C
//                                               compiler and runs it (drive.ctx)
//   ctxc exe PATH -o OUT                        builds it into the executable OUT
//   ctxc test PATH [ARGS...]                    builds it with std's test runner as its entry
//                                               point and runs that: the program's `#test` fns,
//                                               those whose names contain one of ARGS
//                                               (spec §20; drive.ctx)
//   ctxc check PATH                             checks the program at PATH, and each executable
//                                               its build program describes, and reports every
//                                               error: the front end alone, with no C compiler
//                                               (drive.ctx)
//   --json                                      with run, exe, test and check: the diagnostics
//                                               as JSON, a line for each (spec §21; report.ctx)
//   ctxc check --fix [--dry-run] PATH           also applies the fixes that are safe to the
//                                               program's files, or with --dry-run says them
//   ctxc graph DIR GEN LIST                     runs DIR's build program as `run` does, and
//                                               writes what it describes to LIST and its
//                                               generated files to GEN, for
//                                               tools/suite (drive.ctx)
//   ctxc interp [--env N=V | --env N]... PATH [-- ARGS...]
//                                               checks the program at PATH as `run` does, and
//                                               runs it in the interpreter (eval.ctx), in ctxc's
//                                               environment with N set to V, or N removed
//   ctxc build OUT.c STD... -- FILE...          checks the program of FILE..., with std's files
//                                               STD..., and writes it as C, for ctxc/rt/ctxrt.c
//                                               (and ctxfloat.c);
//                                               or prints its errors and exits with 1. In the
//                                               FILEs after a `--deny-unchecked`, up to the next
//                                               `--allow-unchecked`, the unchecked operations
//                                               are errors (spec §13), as in `ir` and `decls`
//   ctxc ir STD... -- FILE...                   checks the program and prints its IR, or its
//                                               diagnostics if it has errors (lower.ctx)
//   ctxc roundtrip FILE.ir                      reads IR (from `ctxc ir`) and prints it back;
//                                               the output must equal FILE.ir
//   ctxc c FILE.ir OUT.c                        writes an IR file's program as C
//   ctxc tokens FILE...                         prints each file's tokens (dump.ctx), each
//                                               after a line `file FILE`
//   ctxc syntax FILE...                         the same for each file's syntax tree
//   ctxc recover FILE FROM TO [-v] [--every N] [-- FILE...]
//                                               the recovery test (recover.ctx)
//   ctxc decls STD... -- FILE...                checks the program and prints its declarations
//                                               and bodies (dump.ctx, namespace decls)
//
// bootstrap/ctxc.PLATFORM.c is this program as C with std's layer for PLATFORM (std/os), for
// building ctxc with only a C compiler.

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, args: Args } -> i32 {
    let mut to_c = false
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "run" } {
        return drive::command{ run = true, .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "exe" } {
        return drive::command{ run = false, .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "test" } {
        return drive::test{ .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "check" } {
        return drive::check{ .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "graph" } {
        return drive::graph{ .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "where" } {
        return drive::query{ api = false, .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "api" } {
        return drive::query{ api = true, .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "interp" } {
        return drive::interp{ .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "tokens" } {
        return dumps{ &io, &fs, &mem, args, trees = false }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "syntax" } {
        return dumps{ &io, &fs, &mem, args, trees = true }
    }
    if args.len >= 4 and slice::eq_bytes{ a = args[0], b = "recover" } {
        return recovery{ .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "decls" } {
        return declarations{ mode = Mode::decls, .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "ir" } {
        return declarations{ mode = Mode::ir, .. }
    }
    if args.len >= 2 and slice::eq_bytes{ a = args[0], b = "build" } {
        return declarations{ mode = Mode::build, .. }
    }
    if args.len == 3 and slice::eq_bytes{ a = args[0], b = "c" } {
        to_c = true
    } else if args.len != 2 or not slice::eq_bytes{ a = args[0], b = "roundtrip" } {
        io::eprintln{ &io, s = "usage: ctxc run PATH [-- ARGS...] | ctxc exe PATH -o OUT | ctxc test PATH [ARGS...] | ctxc check PATH | ctxc graph DIR GEN LIST | ctxc where PATH NAME | ctxc api PATH FOLDER | ctxc interp PATH... [-- ARGS...] | ctxc roundtrip FILE.ir | ctxc c FILE.ir OUT.c | ctxc tokens|syntax FILE... | ctxc recover FILE FROM TO [-v] [--every N] [-- FILE...] | ctxc decls|ir STD... -- FILE... | ctxc build OUT.c STD... -- FILE... (FILE...: also --deny-unchecked, --allow-unchecked, --place DIR)" }
        return 2
    }
    let path = args[1]

    // The file, its IR and the output all live in one arena over pages sized to the input.
    let ok{ value = size } = fs::size{ &fs, path } else {
        cannot{ &io, path, what = "cannot read" }
        return 1
    }
    let pages = mem::reserve{ &mem, size = 16777216 + @as(usize, size) * 32 } ifnull {
        cannot{ &io, path, what = "out of memory reading" }
        return 1
    }
    let mut heap = arena::new{ buf = pages }
    let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } else {
        cannot{ &io, path, what = "cannot read" }
        return 1
    }

    let mut r = ir_read::reader{ text, heap = &heap }
    // Every error program can fail with is listed: one it gains won't compile until it is.
    let prog = match ir_read::program{ &r } {
        ok{ value } => { value }
        alloc::out_of_memory => {
            cannot{ &io, path, what = "out of memory" }
            return 1
        }
    }
    if r.failed {
        report{ &io, path, text, at = r.error_at, problem = r.error }
        return 1
    }

    if to_c {
        let out = args[2]
        let code = emit::program{ heap = &heap, p = prog }
        let ok = fs::write_all{ &fs, path = out, bytes = code } else {
            cannot{ &io, path = out, what = "cannot write" }
            return 1
        }
        return 0
    }
    let mut o = ir_print::out{ heap = &heap, types = prog.types }
    ir_print::program{ &o, p = prog }
    io::write{ &io, to = io::Stream::out, bytes = list::items{ list = o.bytes } }
    return 0
}

// `ctxc tokens FILE...` and `ctxc syntax FILE...`: lexes each file on its own, and parses it for
// a tree, in one arena that is reset between files.
fn dumps { mut io: Io, mut fs: Fs, mut mem: Mem, args: Args, trees: bool } -> i32 {
    let mut largest: u64 = 0
    let mut i: usize = 1
    while i < args.len {
        let ok{ value = size } = fs::size{ &fs, path = args[i] } else {
            cannot{ &io, path = args[i], what = "cannot read" }
            return 1
        }
        if size > largest { largest = size }
        i = i + 1
    }
    let pages = mem::reserve{ &mem, size = 16777216 + @as(usize, largest) * 128 } ifnull {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut heap = arena::new{ buf = pages }
    i = 1
    while i < args.len {
        arena::reset{ &heap }
        let path = args[i]
        let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } else {
            cannot{ &io, path, what = "cannot read" }
            return 1
        }
        let mut diags = diag::new{ &heap }
        let lexed = lexer::lex{ text, file = 0, &heap, &diags }
        let mut out = utf8::builder{ realloc = arena::alloc, &heap }
        _ = @fmt(&out, "file {}\n", utf8::String{ bytes = path })
        if trees {
            let f = parser::parse{ text, file = 0, tokens = lexed.tokens, api = parser::is_api{ path }, &heap, &diags }
            tree::file{ &out, &heap, text, f, diags }
        } else {
            dump::tokens{ &out, &heap, text, lexed, diags }
        }
        io::write{ &io, to = io::Stream::out, bytes = utf8::view{ b = out }.bytes }
        i = i + 1
    }
    return 0
}

// What `analyze` does with the checked program.
// where and api: `ctxc where` and `ctxc api` (drive.ctx), whose name or folder is `out`.
enum Mode: u8 { decls, ir, build, interp, units, check, where, api }

// `ctxc decls STD... -- FILE...`: lexes and parses every file, then checks the program, all in
// one arena. `ctxc ir ...` prints the program's IR instead, if it has no errors, and
// `ctxc build OUT.c ...` writes it as C.
fn declarations { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, args: Args, mode: Mode } -> i32 {
    let first: usize = if mode == Mode::build { 2 } else { 1 }
    // The lists of what the arguments name are on pages, not the stack: the program's files
    // and modules keep their paths (spec §14, Escape check, `into`).
    let listed = mem::reserve{ &mem, size = 1048576 } ifnull {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut heap = arena::new{ buf = listed }
    let mut paths = list::new([]u8){ realloc = arena::alloc, &heap }
    // Which of paths are denied the unchecked operations: those after a `--deny-unchecked`, up
    // to the next `--allow-unchecked`, as the suite's runner passes what `ctxc graph` listed.
    let mut denied = list::new(bool){ realloc = arena::alloc, &heap }
    // The folder each of paths counts as being in for modules, from a `--place DIR` before it
    // (spec §10, Modules): a generated file's, as `ctxc graph` lists it. Empty for its own.
    let mut places = list::new([]u8){ realloc = arena::alloc, &heap }
    let mut place: []u8 = ""
    let mut deny = false
    let mut split: usize = 0
    let mut i = first
    while i < args.len {
        if slice::eq_bytes{ a = args[i], b = "--" } {
            split = i
        } else if split != 0 and slice::eq_bytes{ a = args[i], b = "--deny-unchecked" } {
            deny = true
        } else if split != 0 and slice::eq_bytes{ a = args[i], b = "--allow-unchecked" } {
            deny = false
        } else if split != 0 and slice::eq_bytes{ a = args[i], b = "--place" } and i + 1 < args.len {
            i = i + 1
            place = args[i]
        } else {
            list::push{ list = &places, item = place } iferr {
                io::eprintln{ &io, s = "too many files" }
                return 1
            }
            place = ""
            list::push{ list = &paths, item = args[i] } iferr {
                io::eprintln{ &io, s = "too many files" }
                return 1
            }
            list::push{ list = &denied, item = deny } iferr {
                io::eprintln{ &io, s = "too many files" }
                return 1
            }
        }
        i = i + 1
    }
    if split == 0 {
        io::eprintln{ &io, s = "usage: ctxc decls|ir STD... -- FILE... | ctxc build OUT.c STD... -- FILE... (FILE...: also --deny-unchecked, --allow-unchecked, --place DIR)" }
        return 2
    }
    let out: []u8 = if mode == Mode::build { args[1] } else { "" }
    let mut units: [][]u8 = slice::empty([]u8){}
    // A program's errors, and their text as it is written.
    let pages = mem::reserve{ &mem, size = 16777216 } ifnull {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut scratch = arena::new{ buf = pages }
    let mut found = report::found{ heap = &scratch }
    let code = analyze{ &io, &fs, &mem, &proc, paths = list::items{ list = paths }, std_files = split - first, extras = slice::empty([]u8){}, mode, out, argv = slice::empty([]u8){}, env = slice::empty([]u8){}, stack = 0, size = 0, copy = 0, made = &units, texts = slice::empty([]u8){}, denied = list::items{ list = denied }, places = list::items{ list = places }, testing = false, &found }
    report::write{ &io, heap = &scratch, es = list::items{ list = found.entries }, dropped = found.dropped, as_json = false }
    return code
}

// Checks the program of `paths`, std's files first, and acts on it as `mode` says: for build,
// writes it as C to `out`; for units, sets `made` to its C in units of about `size` bytes, each
// with copies of the functions of fewer than `copy` statements and expressions it calls in others
// (emit::units), which live as long as ctxc does; for interp, runs it with args `argv`, as the
// program named `out`, letting its calls take `stack` bytes of ctxc's stack. A const computed by
// running code (comptime.ctx) may take half of ctxc's stack, and CTX_CONST_FUEL steps if that is
// set. The last texts.len files aren't read: their text is texts', as the driver has it for the
// files a build program generates, so what is compiled is the driver's, whatever another ctxc
// does to the file meanwhile. If the program is a build program (`builds`), extras are std's
// files too, after paths' (drive.ctx, `build_extras`). denied says which of paths are denied
// the unchecked operations (spec §13), one for each, or is empty for none. places says, for
// each of paths, the folder it counts as being in for modules where that isn't its own (spec
// §10, Modules; a generated file's, §19, rule 13), or is empty for none. testing makes it a
// test build (spec §20): its entry point is the `#test_main` fn, in place of `main`. For check,
// nothing is made of the program: every diagnostic is kept, whatever their number, the program
// is checked as a test build as well (check::Checker.checking). A program's errors are added
// to found, which the caller shows (report::write), but those `ir` prints in its own form.
fn analyze { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, paths: [][]u8, std_files: usize, extras: [][]u8, mode: Mode, out: []u8, argv: [][]u8, env: [][]u8, stack: u64, size: usize, copy: usize, mut made: [][]u8, texts: [][]u8, denied: []bool, places: [][]u8, testing: bool, mut found: report::Found } -> i32 {
    let given = paths.len - texts.len               // paths[given..] are texts'
    let mut total: u64 = 0
    let mut i: usize = 0
    while i < paths.len + extras.len {
        if i >= given and i < paths.len {
            total = total + texts[i - given].len
            i = i + 1
            continue
        }
        let path = if i < paths.len { paths[i] } else { extras[i - paths.len] }
        let ok{ value = size } = fs::size{ &fs, path } else {
            cannot{ &io, path, what = "cannot read" }
            return 1
        }
        total = total + size
        i = i + 1
    }
    let pages = mem::reserve{ &mem, size = 67108864 + @as(usize, total) * 512 } ifnull {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut heap = arena::new{ buf = pages }
    let mut diags = diag::new{ &heap }
    if mode == Mode::check { diag::keep_all{ &diags } }
    let mut files = list::new(check::File){ realloc = arena::alloc, &heap }
    let mut read = list::new([]u8){ realloc = arena::alloc, &heap }
    i = 0
    while i < paths.len {
        let path = paths[i]
        let mut text = ""
        if i >= given {
            text = texts[i - given]
        } else {
            text = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr {
                cannot{ &io, path, what = "cannot read" }
                return 1
            }
        }
        try! list::push{ list = &read, item = text }
        i = i + 1
    }
    let all = list::items{ list = read }
    // The program's files are parsed with diagnostics of their own until it is known whether it
    // is a build program, whose files come after the extras.
    let mut own = diag::new{ &heap }
    if mode == Mode::check { diag::keep_all{ diags = &own } }
    i = 0
    while i < paths.len {
        if i < std_files {
            add_file{ &files, &heap, &diags, name = paths[i], text = all[i], denied = false }
        } else {
            add_file{ &files, &heap, diags = &own, name = paths[i], text = all[i], denied = i < denied.len and denied[i] }
        }
        i = i + 1
    }
    let mut std_count = std_files
    if extras.len > 0 and builds{ files = list::items{ list = files }[std_files..] } {
        files.len = std_files
        i = 0
        while i < extras.len {
            let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path = extras[i] } else {
                cannot{ &io, path = extras[i], what = "cannot read" }
                return 1
            }
            add_file{ &files, &heap, &diags, name = extras[i], text, denied = false }
            i = i + 1
        }
        std_count = std_files + extras.len
        i = std_files
        while i < paths.len {
            add_file{ &files, &heap, &diags, name = paths[i], text = all[i], denied = i < denied.len and denied[i] }
            i = i + 1
        }
    } else {
        let errors = diags.errors + own.errors
        let ds = diag::items{ diags = own }
        i = 0
        while i < ds.len {
            diag::add{ &diags, d = ds[i] }
            i = i + 1
        }
        diags.errors = errors
        diags.dropped = diags.dropped + own.dropped
    }
    // A test is given the directory of its own file (spec §20, rule 12): each of the program's
    // files' directories as an absolute path, from the working directory, which the files'
    // names are relative to.
    if testing {
        let here = drive::absolute{ &io, &fs, &heap, path = "." } ifnull { return 1 }
        let own_files = list::items{ list = files }
        i = std_count
        while i < own_files.len {
            own_files[i].dir = drive::place{ &heap, dir = here, rel = drive::parent{ path = own_files[i].name } }
            i = i + 1
        }
    }
    // Modules (spec §10): which folder each of the program's own files is inside.
    let own_places = if places.len > std_files { places[std_files..] } else { slice::empty([]u8){} }
    let mods = modules::find{ &io, &fs, &heap, &diags, files = list::items{ list = files }, own = std_count, places = own_places, os = proc::os{ &proc } } ifnull { return 1 }
    let mut c = check::new{ files = list::items{ list = files }, modules = mods, std_files = std_count, &heap, &diags }
    c.stack = drive::host_stack{ &proc } / 2
    c.testing = testing
    c.checking = mode == Mode::check
    let fuel = proc::env{ &proc, name = "CTX_CONST_FUEL" }
    if fuel != null {
        let n = utf8::parse_u64{ s = utf8::String{ bytes = fuel } }
        if n != null { c.fuel = n }
    }
    check::program{ &c }
    // `ctxc where PATH NAME` (spec §10, Modules, Tooling): where the program declares `out`,
    // whatever errors it has.
    if mode == Mode::where {
        let mut text = utf8::builder{ realloc = arena::alloc, &heap }
        let n = modules::where{ out = &text, c, name = out }
        io::write{ &io, to = io::Stream::out, bytes = utf8::view{ b = text }.bytes }
        if n == 0 {
            let mut b = utf8::builder{ realloc = arena::alloc, &heap }
            try! @fmt(&b, "ctxc where: nothing in the program is named `{}`", utf8::String{ bytes = out })
            io::eprintln{ &io, s = utf8::view{ b } }
            return 1
        }
        return 0
    }
    if diags.errors > 0 and mode != Mode::ir and mode != Mode::decls {
        // The program's own files are those given by path, after std's: the rest are generated.
        report::keep{ &found, es = report::resolve{ &heap, c, ds = diag::items{ diags }, own_end = std_count + (given - std_files) } }
        found.waiting = found.waiting | c.waiting
        if diags.dropped > 0 { found.dropped = true }
        return 1
    }
    if mode == Mode::check { return 0 }
    if mode == Mode::api { return first_api{ &io, &fs, &heap, c, folder = out, own = std_count, os = proc::os{ &proc } } }
    if mode == Mode::build or mode == Mode::interp or mode == Mode::units {
        if diags.errors == 0 and mode == Mode::interp {
            return interpret{ &io, &heap, p = lower::program{ &c }, name = out, argv, env, stack }
        }
        if diags.errors == 0 and mode == Mode::units {
            made = emit::units{ &heap, p = lower::program{ &c }, size, copy }
            return 0
        }
        if diags.errors == 0 {
            let code = emit::program{ heap = &heap, p = lower::program{ &c } }
            let ok = fs::write_all{ &fs, path = out, bytes = code } else {
                cannot{ &io, path = out, what = "cannot write" }
                return 1
            }
            return 0
        }
        return 1
    }
    if mode == Mode::ir {
        if diags.errors == 0 {
            let p = lower::program{ &c }
            let mut o = ir_print::out{ heap = &heap, types = p.types }
            ir_print::program{ &o, p }
            io::write{ &io, to = io::Stream::out, bytes = list::items{ list = o.bytes } }
            return 0
        }
        let mut errs = utf8::builder{ realloc = arena::alloc, &heap }
        let ds = diag::items{ diags }
        let mut k: usize = 0
        while k < ds.len {
            decls::diagnostic{ out = &errs, c, d = ds[k] }
            k = k + 1
        }
        io::write{ &io, to = io::Stream::out, bytes = utf8::view{ b = errs }.bytes }
        return 1
    }
    let mut out = utf8::builder{ realloc = arena::alloc, &heap }
    decls::file{ &out, &c }
    io::write{ &io, to = io::Stream::out, bytes = utf8::view{ b = out }.bytes }
    return 0
}

// `ctxc api PATH FOLDER` (spec §10, Modules, Tooling): writes FOLDER/api.ctx, a first
// contract for FOLDER from what the rest of c's program names of its files (modules::first_api).
fn first_api { mut io: Io, mut fs: Fs, mut heap: arena::Arena, c: check::Checker, folder: []u8, own: usize, os: build::Os } -> i32 {
    let key = drive::key_of{ &io, &fs, &heap, path = folder, os } ifnull { return 1 }
    let inside = try! alloc::make(bool, arena::Arena){ realloc = arena::alloc, &heap, count = c.files.len }
    for f at i in c.files {
        inside[i] = false
        if i < own { continue }
        let dir = drive::key_of{ &io, &fs, &heap, path = if drive::parent{ path = f.name }.len == 0 { "." } else { drive::parent{ path = f.name } }, os } ifnull { return 1 }
        inside[i] = slice::eq_bytes{ a = dir, b = key } or (dir.len > key.len and dir[key.len] == '/' and slice::eq_bytes{ a = dir[..key.len], b = key })
    }
    let mut text = utf8::builder{ realloc = arena::alloc, &heap }
    let mut count: usize = 0
    let mut moves = list::new(source::Span){ realloc = arena::alloc, &heap }
    modules::first_api{ out = &text, c, inside, &count, &moves }
    let path = drive::join{ &heap, a = folder, b = "api.ctx" }
    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
    if count == 0 {
        try! @fmt(&b, "ctxc api: nothing outside `{}` names a declaration of its files", utf8::String{ bytes = folder })
        io::eprintln{ &io, s = utf8::view{ b } }
        return 1
    }
    // What moves to the api.ctx leaves its file, each file written once without it.
    let ms = list::items{ list = moves }
    for f at i in c.files {
        let mut cut = false
        for m in ms { if m.file == @as(u32, i) { cut = true } }
        if not cut { continue }
        let mut kept = list::new(u8){ realloc = arena::alloc, &heap }
        let mut at: usize = 0
        while at < f.text.len {
            let mut next = f.text.len
            let mut skip_to = at
            for m in ms {
                if m.file == @as(u32, i) and @as(usize, m.start) >= at and @as(usize, m.start) < next {
                    next = @as(usize, m.start)
                    skip_to = @as(usize, m.end)
                }
            }
            for ch in f.text[at..next] { try! list::push{ list = &kept, item = ch } }
            at = if next == f.text.len { next } else { skip_to }
            // A blank line after a cut goes with it where the text before it ends in a blank
            // line or opens a block, so the cut leaves no gap of its own.
            if next < f.text.len and opens_or_blank{ text = list::items{ list = kept } } {
                let mut after = at
                while after < f.text.len and (f.text[after] == ' ' or f.text[after] == '\t' or f.text[after] == '\r') { after = after + 1 }
                if after < f.text.len and f.text[after] == '\n' { at = after + 1 }
            }
        }
        let ok = fs::write_all{ &fs, path = f.name, bytes = list::items{ list = kept } } else {
            cannot{ &io, path = f.name, what = "cannot write" }
            return 1
        }
    }
    let ok = fs::write_all{ &fs, path, bytes = utf8::view{ b = text }.bytes } else {
        cannot{ &io, path, what = "cannot write" }
        return 1
    }
    try! @fmt(&b, "wrote {}: {} declaration{}", utf8::String{ bytes = path }, count, utf8::String{ bytes = if count == 1 { "" } else { "s" } })
    io::println{ &io, s = utf8::view{ b } }
    return 0
}

// Whether text ends with a line that is blank or ends in `{`, then its line break.
fn opens_or_blank { text: []u8 } -> bool {
    if text.len == 0 { return true }
    if text[text.len - 1] != '\n' { return false }
    let mut n = text.len - 1
    while n > 0 and (text[n - 1] == ' ' or text[n - 1] == '\t' or text[n - 1] == '\r') { n = n - 1 }
    return n == 0 or text[n - 1] == '\n' or text[n - 1] == '{'
}

// Runs p in the interpreter, as C's main would run it, in environment env ("KEY=VALUE"), and
// writes what it wrote. Returns its exit code, as the compiled program's: 132 for a trap, as a
// shell says for C's (SIGILL); or 1 if interp can't run it.
fn interpret { mut io: Io, mut heap: arena::Arena, p: ir::Program, name: []u8, argv: [][]u8, env: [][]u8, stack: u64 } -> i32 {
    let mut m = eval::machine{ heap = &heap, p, name, emulate = true, fuel = eval::FUEL, stack }
    m.env = env
    let r = eval::main{ &m, argv }
    let out = list::items{ list = m.out }
    let mut i: usize = 0
    while i < m.chunks.len {
        let c = list::items{ list = m.chunks }[i]
        io::write{ &io, to = c.to, bytes = out[c.start..c.start + c.len] }
        i = i + 1
    }
    match r {
        ok{ value } => { return eval::exit_code{ value } }
        exit{ code } => { return code }
        trap => { return 132 }
        panic{ text } => {
            io::write{ &io, to = io::Stream::err, bytes = text }
            io::eprint{ &io, s = "\n" }
            return 134
        }
        failed{ msg } => {
            io::eprint{ &io, s = "ctxc interp: " }
            io::write{ &io, to = io::Stream::err, bytes = msg }
            io::eprint{ &io, s = "\n" }
            return 1
        }
    }
}

// Whether the program of files is a build program (spec §19, rule 2): one whose entry is a
// top-level `fn build`, with no top-level `fn main`.
fn builds { files: []check::File } -> bool {
    let mut build = false
    let mut i: usize = 0
    while i < files.len {
        let decls = files[i].tree.decls
        let mut k: usize = 0
        while k < decls.len {
            if decls[k].k is func{ name, external } and not external {
                if slice::eq_bytes{ a = name.text, b = "main" } { return false }
                if slice::eq_bytes{ a = name.text, b = "build" } { build = true }
            }
            k = k + 1
        }
        i = i + 1
    }
    return build
}

// Lexes and parses a file into the program's list, where its index is its file id. denied:
// the unchecked operations are errors in it (spec §13).
fn add_file { mut files: list::List(check::File, arena::Arena), mut heap: arena::Arena, mut diags: diag::Diags, name: []u8, text: []u8, denied: bool } {
    let file = @as(u32, files.len)
    let lexed = lexer::lex{ text, file, &heap, &diags }
    let tree = parser::parse{ text, file, tokens = lexed.tokens, api = parser::is_api{ path = name }, &heap, &diags }
    let lines = source::line_starts{ text, &heap }
    try! list::push{ list = &files, item = check::File{ name, text, lines, tree, denied, dir = "", api = parser::is_api{ path = name }, .. } }
}

// `ctxc recover FILE FROM TO [-v] [--every N] [-- FILE...]` (recover.ctx). The program's files
// are lexed and parsed once, below the arena's mark that each copy goes back to, so a copy costs
// its own parse and the check.
fn recovery { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, args: Args } -> i32 {
    let path = args[1]
    let from = utf8::parse_u64{ s = utf8::String{ bytes = args[2] } }
    let to = utf8::parse_u64{ s = utf8::String{ bytes = args[3] } }
    let mut verbose = false
    let mut every: u64 = 1
    let mut given: [][]u8 = slice::empty([]u8){}
    if from == null or to == null {
        io::eprintln{ &io, s = "usage: ctxc recover FILE FROM TO [-v] [--every N] [-- FILE...]" }
        return 2
    }
    let mut usage = false
    let mut i: usize = 4
    while i < args.len and not usage {
        if slice::eq_bytes{ a = args[i], b = "-v" } {
            verbose = true
        } else if slice::eq_bytes{ a = args[i], b = "--every" } and i + 1 < args.len {
            i = i + 1
            every = utf8::parse_u64{ s = utf8::String{ bytes = args[i] } } ifnull { 0 }
            if every == 0 or every > 4294967295 { usage = true }
        } else if slice::eq_bytes{ a = args[i], b = "--" } {
            given = args[i + 1..]
            break
        } else {
            usage = true
        }
        i = i + 1
    }
    if usage {
        io::eprintln{ &io, s = "usage: ctxc recover FILE FROM TO [-v] [--every N] [-- FILE...]" }
        return 2
    }
    let pages = mem::reserve{ &mem, size = 16777216 } ifnull {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut names = arena::new{ buf = pages }
    let home = drive::find_home{ &fs, &proc, heap = &names } ifnull {
        io::eprintln{ &io, s = "ctxc: cannot find std/ and ctxc/rt/; set CTX_HOME to the directory that holds them" }
        return 1
    }
    let os = proc::os{ &proc }
    let key = drive::key_of{ &io, &fs, heap = &names, path, os } ifnull { return 1 }

    // FILE's program: std with FILE's layer, if FILE is std's; else std with the host's layer,
    // and FILE... or FILE alone. src is FILE's index in all.
    let mut layer = os
    let mut interp = false
    let std_dir = drive::key_of{ &io, &fs, heap = &names, path = drive::join{ heap = &names, a = home, b = "std" }, os } ifnull { return 1 }
    let dir = drive::parent{ path = key }
    let mut in_std = slice::eq_bytes{ a = dir, b = std_dir }
    let layers: [5][]u8 = ["windows", "linux", "macos", "posix", "interp"]
    let mut l: usize = 0
    while l < layers.len {
        if slice::eq_bytes{ a = dir, b = drive::join{ heap = &names, a = std_dir, b = drive::cat{ heap = &names, a = "os/", b = layers[l] } } } {
            in_std = true
            if l == 0 { layer = build::Os::windows }
            if l == 1 or l == 3 { layer = build::Os::linux }
            if l == 2 { layer = build::Os::macos }
            if l == 4 { interp = true }
        }
        l = l + 1
    }
    let std = drive::std_files{ &io, &fs, heap = &names, home, os = layer, interp } ifnull { return 1 }
    let mut paths = list::new([]u8){ realloc = arena::alloc, heap = &names }
    let mut src = NOT_FOUND
    i = 0
    while i < std.len {
        try! list::push{ list = &paths, item = std[i] }
        let k = drive::key_of{ &io, &fs, heap = &names, path = std[i], os } ifnull { return 1 }
        if in_std and slice::eq_bytes{ a = k, b = key } { src = i }
        i = i + 1
    }
    if not in_std {
        if given.len == 0 { given = drive::one{ heap = &names, s = path } }
        i = 0
        while i < given.len {
            try! list::push{ list = &paths, item = given[i] }
            let k = drive::key_of{ &io, &fs, heap = &names, path = given[i], os } ifnull { return 1 }
            if slice::eq_bytes{ a = k, b = key } { src = std.len + i }
            i = i + 1
        }
    }
    if src == NOT_FOUND {
        cannot{ &io, path, what = if in_std { "is in std/ but not among std's files" } else { "is not among the program's files" } }
        return 1
    }
    let extras = drive::build_extras{ &io, &fs, heap = &names, home } ifnull { return 1 }

    let all = list::items{ list = paths }
    let mut total: u64 = 0
    i = 0
    while i < all.len + extras.len {
        let p = if i < all.len { all[i] } else { extras[i - all.len] }
        let ok{ value = size } = fs::size{ &fs, path = p } else {
            cannot{ &io, path = p, what = "cannot read" }
            return 1
        }
        total = total + size
        i = i + 1
    }
    let big = mem::reserve{ &mem, size = 67108864 + @as(usize, total) * 512 } ifnull {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut heap = arena::new{ buf = big }
    let mut texts = list::new([]u8){ realloc = arena::alloc, &heap }
    i = 0
    while i < all.len {
        let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path = all[i] } else {
            cannot{ &io, path = all[i], what = "cannot read" }
            return 1
        }
        try! list::push{ list = &texts, item = text }
        i = i + 1
    }
    let read = list::items{ list = texts }
    let mut diags = diag::new{ &heap }
    let mut files = list::new(check::File){ realloc = arena::alloc, &heap }
    i = 0
    while i < std.len {
        add_file{ &files, &heap, &diags, name = all[i], text = read[i], denied = false }
        i = i + 1
    }
    // A build program's files come after std's extras, as `analyze` places them; whether it is
    // one is decided by FILE's program as it is, not by each copy.
    let mut std_count = std.len
    if all.len > std.len {
        let mark = arena::mark{ heap }
        let mut own = list::new(check::File){ realloc = arena::alloc, &heap }
        let mut scratch = diag::new{ &heap }
        i = std.len
        while i < all.len {
            add_file{ files = &own, &heap, diags = &scratch, name = all[i], text = read[i], denied = false }
            i = i + 1
        }
        let build = builds{ files = list::items{ list = own } }
        arena::restore{ &heap, to = mark }
        if build {
            i = 0
            while i < extras.len {
                let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path = extras[i] } else {
                    cannot{ &io, path = extras[i], what = "cannot read" }
                    return 1
                }
                add_file{ &files, &heap, &diags, name = extras[i], text, denied = false }
                i = i + 1
            }
            std_count = std.len + extras.len
        }
        i = std.len
        while i < all.len {
            add_file{ &files, &heap, &diags, name = all[i], text = read[i], denied = false }
            i = i + 1
        }
    }
    let at = if src < std.len { src } else { src + std_count - std.len }
    let mods = modules::find{ &io, &fs, heap = &names, diags = &diags, files = list::items{ list = files }, own = std_count, places = slice::empty([]u8){}, os } ifnull { return 1 }
    let program = recover::Program{ files = list::items{ list = files }, modules = mods, std_files = std_count, at, stack = drive::host_stack{ &proc } / 2, every = @as(u32, every) }
    let failures = recover::run{ &io, &heap, path, text = read[src], from = @as(usize, from), to = @as(usize, to), verbose, program }
    return if failures > 0 { 1 } else { 0 }
}

// No index: a file not found among a program's.
const NOT_FOUND: usize = 18446744073709551615

// "PATH: what"
fn cannot { mut io: Io, path: []u8, what: utf8::String } {
    io::write{ &io, to = io::Stream::err, bytes = path }
    io::eprint{ &io, s = ": " }
    io::eprintln{ &io, s = what }
}

// "PATH:LINE:COL: error: PROBLEM" for a malformed IR file.
fn report { mut io: Io, path: []u8, text: []u8, at: usize, problem: ir_read::Problem } {
    let mut line = 1
    let mut col = 1
    let mut i = 0
    while i < at and i < text.len {
        if text[i] == '\n' {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    let mut buf: [256]u8
    let mut heap = arena::new{ buf = buf[..] }
    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
    _ = @fmt(&b, ":{}:{}: error: ", line, col)
    match problem {
        expected{ c } => {
            _ = @fmt(&b, "expected '{}'", utf8::write_char{ c, _ })
        }
        expected_int => {
            _ = utf8::push{ &b, s = "expected an integer" }
        }
        int_too_large   => { _ = utf8::push{ &b, s = "integer too large" } }
        expected_symbol => { _ = utf8::push{ &b, s = "expected a symbol" } }
        expected_string => { _ = utf8::push{ &b, s = "expected a string" } }
        bad_escape      => { _ = utf8::push{ &b, s = "invalid escape in string" } }
        bad_float       => { _ = utf8::push{ &b, s = "invalid float" } }
        unknown_tag     => { _ = utf8::push{ &b, s = "unexpected tag" } }
        bad_id          => { _ = utf8::push{ &b, s = "type id out of order" } }
        trailing_text   => { _ = utf8::push{ &b, s = "unexpected text after (main)" } }
    }
    io::write{ &io, to = io::Stream::err, bytes = path }
    io::eprintln{ &io, s = utf8::view{ b } }
}
