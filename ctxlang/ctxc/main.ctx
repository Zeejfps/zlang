// ctxc: the ctxlang compiler, written in ctxlang. A directory is one program: this file holds
// the driver; source.ctx, diag.ctx, lexer.ctx, syntax.ctx, parser.ctx, types.ctx and check.ctx
// the front end; lower.ctx the checked program as IR; ir.ctx the typed IR, ir_read.ctx and
// ir_print.ctx its text form; emit_c.ctx the C backend; eval.ctx an interpreter over the IR,
// which comptime.ctx runs consts in; dump.ctx text dumps for tests; drive.ctx the driver, which
// runs the C compiler.
//
//   ctxc run PATH [-- ARGS...]                  builds the program at PATH (a .ctx file, or a
//                                               directory, maybe with a build.ctx) with the C
//                                               compiler and runs it (drive.ctx)
//   ctxc exe PATH -o OUT                        builds it into the executable OUT
//   ctxc graph DIR GEN LIST                     runs DIR's build program as `run` does, and
//                                               writes what it describes to LIST and its
//                                               generated files to GEN, for
//                                               tools/toolchain.py (drive.ctx)
//   ctxc interp [--env N=V | --env N]... PATH [-- ARGS...]
//                                               checks the program at PATH as `run` does, and
//                                               runs it in the interpreter (eval.ctx), in ctxc's
//                                               environment with N set to V, or N removed
//   ctxc build OUT.c STD... -- FILE...          checks the program of FILE..., with std's files
//                                               STD..., and writes it as C, for ctxc/rt/ctxrt.c
//                                               (and ctxfloat.c);
//                                               or prints its errors and exits with 1
//   ctxc ir STD... -- FILE...                   checks the program and prints its IR, or its
//                                               diagnostics if it has errors (lower.ctx)
//   ctxc roundtrip FILE.ir                      reads IR (from `ctxc ir`) and prints it back;
//                                               the output must equal FILE.ir
//   ctxc c FILE.ir OUT.c                        writes an IR file's program as C
//   ctxc tokens FILE...                         prints each file's tokens (dump.ctx), each
//                                               after a line `file FILE`
//   ctxc syntax FILE...                         the same for each file's syntax tree
//   ctxc recover FILE FROM TO                   the recovery test (recover.ctx)
//   ctxc decls STD... -- FILE...                checks the program and prints its declarations
//                                               and bodies (dump.ctx, namespace decls)
//
// bootstrap/ctxc.PLATFORM.c is this program as C with std's layer for PLATFORM (std/os), for
// building ctxc with only a C compiler.

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, args: Args } -> i32 {
    let mut to_c = false
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "run" } {
        return drive::command{ run = true, .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "exe" } {
        return drive::command{ run = false, .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "graph" } {
        return drive::graph{ .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "interp" } {
        return drive::interp{ .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "tokens" } {
        return dumps{ &io, &fs, &mem, args, trees = false }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "syntax" } {
        return dumps{ &io, &fs, &mem, args, trees = true }
    }
    if args.len >= 4 and slice::eq_bytes{ a = args[0], b = "recover" } {
        return recovery{ .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "decls" } {
        return declarations{ mode = Mode::decls, .. }
    }
    if args.len >= 1 and slice::eq_bytes{ a = args[0], b = "ir" } {
        return declarations{ mode = Mode::ir, .. }
    }
    if args.len >= 2 and slice::eq_bytes{ a = args[0], b = "build" } {
        return declarations{ mode = Mode::build, .. }
    }
    if args.len == 3 and slice::eq_bytes{ a = args[0], b = "c" } {
        to_c = true
    } else if args.len != 2 or not slice::eq_bytes{ a = args[0], b = "roundtrip" } {
        io::eprintln{ &io, s = "usage: ctxc run PATH [-- ARGS...] | ctxc exe PATH -o OUT | ctxc graph DIR GEN LIST | ctxc interp PATH [-- ARGS...] | ctxc roundtrip FILE.ir | ctxc c FILE.ir OUT.c | ctxc tokens|syntax FILE... | ctxc recover FILE FROM TO | ctxc decls|ir STD... -- FILE... | ctxc build OUT.c STD... -- FILE..." }
        return 2
    }
    let path = args[1]

    // The file, its IR and the output all live in one arena over pages sized to the input.
    let ok{ value = size } = fs::size{ &fs, path } else {
        cannot{ &io, path, what = "cannot read" }
        return 1
    }
    let pages = mem::reserve{ &mem, size = 16777216 + @as(usize, size) * 32 } ifnull {
        cannot{ &io, path, what = "out of memory reading" }
        return 1
    }
    let mut heap = arena::new{ buf = pages }
    let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } else {
        cannot{ &io, path, what = "cannot read" }
        return 1
    }

    let mut r = ir_read::reader{ text, heap = &heap }
    // Every error program can fail with is listed: one it gains won't compile until it is.
    let prog = match ir_read::program{ &r } {
        ok{ value } => { value }
        alloc::out_of_memory => {
            cannot{ &io, path, what = "out of memory" }
            return 1
        }
    }
    if r.failed {
        report{ &io, path, text, at = r.error_at, problem = r.error }
        return 1
    }

    if to_c {
        let out = args[2]
        let code = emit::program{ heap = &heap, p = prog }
        let ok = fs::write_all{ &fs, path = out, bytes = code } else {
            cannot{ &io, path = out, what = "cannot write" }
            return 1
        }
        return 0
    }
    let mut o = ir_print::out{ heap = &heap, types = prog.types }
    ir_print::program{ &o, p = prog }
    io::write{ &io, to = io::Stream::out, bytes = list::items{ list = o.bytes } }
    return 0
}

// `ctxc tokens FILE...` and `ctxc syntax FILE...`: lexes each file on its own, and parses it for
// a tree, in one arena that is reset between files.
fn dumps { mut io: Io, mut fs: Fs, mut mem: Mem, args: Args, trees: bool } -> i32 {
    let mut largest: u64 = 0
    let mut i: usize = 1
    while i < args.len {
        let ok{ value = size } = fs::size{ &fs, path = args[i] } else {
            cannot{ &io, path = args[i], what = "cannot read" }
            return 1
        }
        if size > largest { largest = size }
        i = i + 1
    }
    let pages = mem::reserve{ &mem, size = 16777216 + @as(usize, largest) * 128 } ifnull {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut heap = arena::new{ buf = pages }
    i = 1
    while i < args.len {
        arena::reset{ &heap }
        let path = args[i]
        let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } else {
            cannot{ &io, path, what = "cannot read" }
            return 1
        }
        let mut diags = diag::new{ &heap }
        let lexed = lexer::lex{ text, file = 0, &heap, &diags }
        let mut out = utf8::builder{ realloc = arena::alloc, &heap }
        _ = @fmt(&out, "file {}\n", utf8::String{ bytes = path })
        if trees {
            let f = parser::parse{ text, file = 0, tokens = lexed.tokens, &heap, &diags }
            tree::file{ &out, &heap, text, f, diags }
        } else {
            dump::tokens{ &out, &heap, text, lexed, diags }
        }
        io::write{ &io, to = io::Stream::out, bytes = utf8::view{ b = out }.bytes }
        i = i + 1
    }
    return 0
}

// What `analyze` does with the checked program.
enum Mode: u8 { decls, ir, build, interp, units }

// `ctxc decls STD... -- FILE...`: lexes and parses every file, then checks the program, all in
// one arena. `ctxc ir ...` prints the program's IR instead, if it has no errors, and
// `ctxc build OUT.c ...` writes it as C.
fn declarations { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, args: Args, mode: Mode } -> i32 {
    let first: usize = if mode == Mode::build { 2 } else { 1 }
    let mut buf: [65536]u8
    let mut heap = arena::new{ buf = buf[..] }
    let mut paths = list::new([]u8){ realloc = arena::alloc, &heap }
    let mut split: usize = 0
    let mut i = first
    while i < args.len {
        if slice::eq_bytes{ a = args[i], b = "--" } {
            split = i
        } else {
            list::push{ list = &paths, item = args[i] } iferr {
                io::eprintln{ &io, s = "too many files" }
                return 1
            }
        }
        i = i + 1
    }
    if split == 0 {
        io::eprintln{ &io, s = "usage: ctxc decls|ir STD... -- FILE... | ctxc build OUT.c STD... -- FILE..." }
        return 2
    }
    let out: []u8 = if mode == Mode::build { args[1] } else { "" }
    let mut units: [][]u8 = slice::empty([]u8){}
    return analyze{ &io, &fs, &mem, &proc, paths = list::items{ list = paths }, std_files = split - first, extras = slice::empty([]u8){}, mode, out, argv = slice::empty([]u8){}, env = slice::empty([]u8){}, stack = 0, size = 0, copy = 0, made = &units, texts = slice::empty([]u8){} }
}

// Checks the program of `paths`, std's files first, and acts on it as `mode` says: for build,
// writes it as C to `out`; for units, sets `made` to its C in units of about `size` bytes, each
// with copies of the functions of fewer than `copy` statements and expressions it calls in others
// (emit::units), which live as long as ctxc does; for interp, runs it with args `argv`, as the
// program named `out`, letting its calls take `stack` bytes of ctxc's stack. A const computed by
// running code (comptime.ctx) may take half of ctxc's stack, and CTX_CONST_FUEL steps if that is
// set. The last texts.len files aren't read: their text is texts', as the driver has it for the
// files a build program generates, so what is compiled is the driver's, whatever another ctxc
// does to the file meanwhile. If the program is a build program (`builds`), extras are std's
// files too, after paths' (drive.ctx, `build_extras`).
fn analyze { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, paths: [][]u8, std_files: usize, extras: [][]u8, mode: Mode, out: []u8, argv: [][]u8, env: [][]u8, stack: u64, size: usize, copy: usize, mut made: [][]u8, texts: [][]u8 } -> i32 {
    let given = paths.len - texts.len               // paths[given..] are texts'
    let mut total: u64 = 0
    let mut i: usize = 0
    while i < paths.len + extras.len {
        if i >= given and i < paths.len {
            total = total + texts[i - given].len
            i = i + 1
            continue
        }
        let path = if i < paths.len { paths[i] } else { extras[i - paths.len] }
        let ok{ value = size } = fs::size{ &fs, path } else {
            cannot{ &io, path, what = "cannot read" }
            return 1
        }
        total = total + size
        i = i + 1
    }
    let pages = mem::reserve{ &mem, size = 67108864 + @as(usize, total) * 512 } ifnull {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut heap = arena::new{ buf = pages }
    let mut diags = diag::new{ &heap }
    let mut files = list::new(check::File){ realloc = arena::alloc, &heap }
    let mut read = list::new([]u8){ realloc = arena::alloc, &heap }
    i = 0
    while i < paths.len {
        let path = paths[i]
        let mut text = ""
        if i >= given {
            text = texts[i - given]
        } else {
            text = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr {
                cannot{ &io, path, what = "cannot read" }
                return 1
            }
        }
        try! list::push{ list = &read, item = text }
        i = i + 1
    }
    let all = list::items{ list = read }
    // The program's files are parsed with diagnostics of their own until it is known whether it
    // is a build program, whose files come after the extras.
    let mut own = diag::new{ &heap }
    i = 0
    while i < paths.len {
        if i < std_files {
            add_file{ &files, &heap, &diags, name = paths[i], text = all[i] }
        } else {
            add_file{ &files, &heap, diags = &own, name = paths[i], text = all[i] }
        }
        i = i + 1
    }
    let mut std_count = std_files
    if extras.len > 0 and builds{ files = list::items{ list = files }[std_files..] } {
        files.len = std_files
        i = 0
        while i < extras.len {
            let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path = extras[i] } else {
                cannot{ &io, path = extras[i], what = "cannot read" }
                return 1
            }
            add_file{ &files, &heap, &diags, name = extras[i], text }
            i = i + 1
        }
        std_count = std_files + extras.len
        i = std_files
        while i < paths.len {
            add_file{ &files, &heap, &diags, name = paths[i], text = all[i] }
            i = i + 1
        }
    } else {
        let errors = diags.errors + own.errors
        let ds = diag::items{ diags = own }
        i = 0
        while i < ds.len {
            diag::add{ &diags, d = ds[i] }
            i = i + 1
        }
        diags.errors = errors
        diags.dropped = diags.dropped + own.dropped
    }
    let mut c = check::new{ files = list::items{ list = files }, std_files = std_count, &heap, &diags }
    c.stack = drive::host_stack{ &proc } / 2
    let fuel = proc::env{ &proc, name = "CTX_CONST_FUEL" }
    if fuel != null {
        let n = utf8::parse_u64{ s = utf8::String{ bytes = fuel } }
        if n != null { c.fuel = n }
    }
    check::program{ &c }
    if mode == Mode::build or mode == Mode::interp or mode == Mode::units {
        if diags.errors == 0 and mode == Mode::interp {
            return interpret{ &io, &heap, p = lower::program{ &c }, name = out, argv, env, stack }
        }
        if diags.errors == 0 and mode == Mode::units {
            made = emit::units{ &heap, p = lower::program{ &c }, size, copy }
            return 0
        }
        if diags.errors == 0 {
            let code = emit::program{ heap = &heap, p = lower::program{ &c } }
            let ok = fs::write_all{ &fs, path = out, bytes = code } else {
                cannot{ &io, path = out, what = "cannot write" }
                return 1
            }
            return 0
        }
        let mut errs = utf8::builder{ realloc = arena::alloc, &heap }
        let ds = diag::items{ diags }
        let mut k: usize = 0
        while k < ds.len {
            error{ out = &errs, c, d = ds[k] }
            k = k + 1
        }
        io::write{ &io, to = io::Stream::err, bytes = utf8::view{ b = errs }.bytes }
        return 1
    }
    if mode == Mode::ir {
        if diags.errors == 0 {
            let p = lower::program{ &c }
            let mut o = ir_print::out{ heap = &heap, types = p.types }
            ir_print::program{ &o, p }
            io::write{ &io, to = io::Stream::out, bytes = list::items{ list = o.bytes } }
            return 0
        }
        let mut errs = utf8::builder{ realloc = arena::alloc, &heap }
        let ds = diag::items{ diags }
        let mut k: usize = 0
        while k < ds.len {
            decls::diagnostic{ out = &errs, c, d = ds[k] }
            k = k + 1
        }
        io::write{ &io, to = io::Stream::out, bytes = utf8::view{ b = errs }.bytes }
        return 1
    }
    let mut out = utf8::builder{ realloc = arena::alloc, &heap }
    decls::file{ &out, &c }
    io::write{ &io, to = io::Stream::out, bytes = utf8::view{ b = out }.bytes }
    return 0
}

// Runs p in the interpreter, as C's main would run it, in environment env ("KEY=VALUE"), and
// writes what it wrote. Returns its exit code, as the compiled program's: 132 for a trap, as a
// shell says for C's (SIGILL); or 1 if interp can't run it.
fn interpret { mut io: Io, mut heap: arena::Arena, p: ir::Program, name: []u8, argv: [][]u8, env: [][]u8, stack: u64 } -> i32 {
    let mut m = eval::machine{ heap = &heap, p, name, emulate = true, fuel = eval::FUEL, stack }
    m.env = env
    let r = eval::main{ &m, argv }
    let out = list::items{ list = m.out }
    let mut i: usize = 0
    while i < m.chunks.len {
        let c = list::items{ list = m.chunks }[i]
        io::write{ &io, to = c.to, bytes = out[c.start..c.start + c.len] }
        i = i + 1
    }
    match r {
        ok{ value } => { return eval::exit_code{ value } }
        exit{ code } => { return code }
        trap => { return 132 }
        panic{ text } => {
            io::write{ &io, to = io::Stream::err, bytes = text }
            io::eprint{ &io, s = "\n" }
            return 134
        }
        failed{ msg } => {
            io::eprint{ &io, s = "ctxc interp: " }
            io::write{ &io, to = io::Stream::err, bytes = msg }
            io::eprint{ &io, s = "\n" }
            return 1
        }
    }
}

// "PATH:LINE:COL: error: MESSAGE". An error about the whole
// program, such as a missing `main`, is at the start of its first file.
fn error { mut out: utf8::Builder(arena::Arena), c: check::Checker, d: diag::Diag } {
    if d.span.file == check::NO_FILE {
        _ = @fmt(&out, "{}:1:1", check::str{ s = c.files[c.std_files].name })
    } else {
        let f = c.files[d.span.file]
        let p = source::position{ text = f.text, lines = f.lines, offset = d.span.start }
        _ = @fmt(&out, "{}:{}:{}", check::str{ s = f.name }, p.line, p.col)
    }
    _ = @fmt(&out, ": error: {}\n", d.msg)
}

// Whether the program of files is a build program (spec §19, rule 2): one whose entry is a
// top-level `fn build`, with no top-level `fn main`.
fn builds { files: []check::File } -> bool {
    let mut build = false
    let mut i: usize = 0
    while i < files.len {
        let decls = files[i].tree.decls
        let mut k: usize = 0
        while k < decls.len {
            if decls[k].k is func{ name, external } and not external {
                if slice::eq_bytes{ a = name.text, b = "main" } { return false }
                if slice::eq_bytes{ a = name.text, b = "build" } { build = true }
            }
            k = k + 1
        }
        i = i + 1
    }
    return build
}

// Lexes and parses a file into the program's list, where its index is its file id.
fn add_file { mut files: list::List(check::File, arena::Arena), mut heap: arena::Arena, mut diags: diag::Diags, name: []u8, text: []u8 } {
    let file = @as(u32, files.len)
    let lexed = lexer::lex{ text, file, &heap, &diags }
    let tree = parser::parse{ text, file, tokens = lexed.tokens, &heap, &diags }
    let lines = source::line_starts{ text, &heap }
    try! list::push{ list = &files, item = check::File{ name, text, lines, tree } }
}

// `ctxc recover FILE FROM TO [-v]`
fn recovery { mut io: Io, mut fs: Fs, mut mem: Mem, args: Args } -> i32 {
    let path = args[1]
    let from = utf8::parse_u64{ s = utf8::String{ bytes = args[2] } }
    let to = utf8::parse_u64{ s = utf8::String{ bytes = args[3] } }
    if from == null or to == null {
        io::eprintln{ &io, s = "usage: ctxc recover FILE FROM TO [-v]" }
        return 2
    }
    let ok{ value = size } = fs::size{ &fs, path } else {
        cannot{ &io, path, what = "cannot read" }
        return 1
    }
    let pages = mem::reserve{ &mem, size = 67108864 + @as(usize, size) * 256 } ifnull {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    let mut heap = arena::new{ buf = pages }
    let ok{ value = text } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } else {
        cannot{ &io, path, what = "cannot read" }
        return 1
    }
    let verbose = args.len > 4 and slice::eq_bytes{ a = args[4], b = "-v" }
    let failures = recover::run{ &io, &heap, path, text, from = @as(usize, from), to = @as(usize, to), verbose }
    return if failures > 0 { 1 } else { 0 }
}

// "PATH: what"
fn cannot { mut io: Io, path: []u8, what: utf8::String } {
    io::write{ &io, to = io::Stream::err, bytes = path }
    io::eprint{ &io, s = ": " }
    io::eprintln{ &io, s = what }
}

// "PATH:LINE:COL: error: PROBLEM" for a malformed IR file.
fn report { mut io: Io, path: []u8, text: []u8, at: usize, problem: ir_read::Problem } {
    let mut line = 1
    let mut col = 1
    let mut i = 0
    while i < at and i < text.len {
        if text[i] == '\n' {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    let mut buf: [256]u8
    let mut heap = arena::new{ buf = buf[..] }
    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
    _ = @fmt(&b, ":{}:{}: error: ", line, col)
    match problem {
        expected{ c } => {
            _ = @fmt(&b, "expected '{}'", utf8::write_char{ c, _ })
        }
        expected_int => {
            _ = utf8::push{ &b, s = "expected an integer" }
        }
        int_too_large   => { _ = utf8::push{ &b, s = "integer too large" } }
        expected_symbol => { _ = utf8::push{ &b, s = "expected a symbol" } }
        expected_string => { _ = utf8::push{ &b, s = "expected a string" } }
        bad_escape      => { _ = utf8::push{ &b, s = "invalid escape in string" } }
        bad_float       => { _ = utf8::push{ &b, s = "invalid float" } }
        unknown_tag     => { _ = utf8::push{ &b, s = "unexpected tag" } }
        bad_id          => { _ = utf8::push{ &b, s = "type id out of order" } }
        trailing_text   => { _ = utf8::push{ &b, s = "unexpected text after (main)" } }
    }
    io::write{ &io, to = io::Stream::err, bytes = path }
    io::eprintln{ &io, s = utf8::view{ b } }
}
