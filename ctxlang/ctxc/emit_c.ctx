// The C backend: an ir::Program as one C file, for GNU C with ctxc/rt/ctxrt.h.
//
//   let text = emit::program{ heap = &heap, p = prog }       // the C source
//
// Mapping (the plan's table):
//   types        each TypeId is a typedef tN. [N]T is struct { T a[N]; }, so arrays copy as values;
//                a struct is a C struct with fields m_NAME; a union or ?T is
//                struct { uint32_t tag; union { struct {...} vI; ... } p; }. Layouts are checked
//                against the IR's with _Static_assert.
//   functions    fN. Slot i is lI; a `mut` param's slot is a pointer.
//   fn values    ctx_fn*: a record whose first member is the code, called with the record and
//                the function type's fields in name order. fnref gives a static record per
//                function (gN, code hN); a bind allocates one (struct bK); a conversion to a
//                type with more fields wraps the value in an adapter (aK).
//   expressions  C expressions. Where C's order of evaluation would differ from ctxi's (left to
//                right), operands go into temporaries _tK inside GNU statement expressions.
//                `if` and `match` expressions are statement expressions too; a branch that
//                leaves jumps out of it with return, break or continue.
//   defer        each deferred body is copied to every exit of its block, innermost first.
//   panics       ctx_panic and checked helpers in ctxrt.h, with the IR's positions.

namespace emit {
    type Out = ir_print::Out

    union Scope { block, loop, deferred{ body: ir::Block } }
    union Stop { block, loop, function }

    // An adapter from function type `from` to `to`, emitted as aK.
    struct Pair { from: ir::TypeId, to: ir::TypeId }

    struct E {
        p:        ir::Program,
        o:        Out,                              // where text goes now
        aux:      Out,                              // records and thunks, placed before the bodies
        heap:     *ir::Heap,
        f:        ir::Func,                         // the function being emitted
        temp:     u32,                              // the next _tK
        sites:    u32,                              // the next bind record bK
        depth:    u32,                              // indentation
        scopes:   list::List(Scope, ir::Heap),
        thunks:   list::List(bool, ir::Heap),       // by function id: hN and gN emitted
        adapters: list::List(Pair, ir::Heap),
        marks:    list::List(u8, ir::Heap),         // by type id: 1 typedef'd, 2 defined
    }

    // The whole C file.
    fn program { heap: *ir::Heap, p: ir::Program } -> ir::Bytes {
        let mut e = E{
            p,
            o = ir_print::out{ heap, types = p.types },
            aux = ir_print::out{ heap, types = p.types },
            heap,
            f = slice::get{ s = p.fns, i = p.main },
            temp = 0, sites = 0, depth = 0,
            scopes = list::new(Scope){ realloc = arena::alloc },
            thunks = list::new(bool){ realloc = arena::alloc },
            adapters = list::new(Pair){ realloc = arena::alloc },
            marks = list::new(u8){ realloc = arena::alloc },
        }
        let mut i: usize = 0
        while (i < p.fns.len) {
            add{ xs = &e.thunks, heap = e.heap, item = false }
            i = i + 1
        }
        i = 0
        while (i < p.types.len) {
            add{ xs = &e.marks, heap = e.heap, item = 0 }
            i = i + 1
        }

        put{ &e, a = "// Generated by ctxc. Compile with ctxc/rt/ctxrt.c.\n#include \"ctxrt.h\"\n\n" }
        put{ &e, a = "static const char *const ctx_file_table[] = {" }
        i = 0
        while (i < p.files.len) {
            cstr{ &e, b = slice::get{ s = p.files, i } }
            put{ &e, a = ", " }
            i = i + 1
        }
        put{ &e, a = "\"\" };\n\n" }
        types{ &e }
        prototypes{ &e }

        // Bodies go to a second buffer, so that the records and thunks they need can go first.
        let head = e.o
        e.o = ir_print::out{ heap, types = p.types }
        i = 0
        while (i < p.fns.len) {
            let f = slice::get{ s = p.fns, i }
            if (f.native) { native{ &e, f } } else { function{ &e, f } }
            i = i + 1
        }
        entry{ &e }

        let mut all = head
        ir_print::bytes{ o = &all, b = list::items{ list = e.aux.bytes } }
        ir_print::bytes{ o = &all, b = list::items{ list = e.o.bytes } }
        return list::items{ list = all.bytes }
    }

    // ---- types

    fn types { mut e: E } {
        let n = e.p.types.len
        let mut i: usize = 0
        while (i < n) { typedef{ &e, id = @as(u32, i) }; i = i + 1 }
        ch{ &e, c = '\n' }
        i = 0
        while (i < n) { define{ &e, id = @as(u32, i) }; i = i + 1 }
        ch{ &e, c = '\n' }
        i = 0
        while (i < n) {
            let func{ params, ret } = slice::get{ s = e.p.types, i } else { i = i + 1; continue }
            put{ &e, a = "typedef " }
            tn{ &e, t = ret }
            put{ &e, a = " (*c" }
            num{ &e, n = i }
            put{ &e, a = ")(ctx_fn *" }
            let mut j: usize = 0
            while (j < params.len) {
                put{ &e, a = ", " }
                param_type{ &e, q = slice::get{ s = params, i = j } }
                j = j + 1
            }
            put{ &e, a = ");\n" }
            i = i + 1
        }
        ch{ &e, c = '\n' }
        i = 0
        while (i < n) { asserts{ &e, id = @as(u32, i) }; i = i + 1 }
        ch{ &e, c = '\n' }
    }

    fn mark { e: E, id: ir::TypeId } -> u8 {
        return slice::get{ s = list::items{ list = e.marks }, i = id }
    }

    fn set_mark { mut e: E, id: ir::TypeId, m: u8 } {
        slice::set{ s = list::items{ list = e.marks }, i = id, v = m }
    }

    // `typedef ... tN;`, after the typedefs it refers to.
    fn typedef { mut e: E, id: ir::TypeId } {
        if (mark{ e, id } >= 1) { return }
        set_mark{ &e, id, m = 1 }
        match (ty{ e, id }) {
            prim{ p } => {
                put{ &e, a = "typedef " }
                ctype{ &e, p }
            }
            ptr{ elem } => {
                typedef{ &e, id = elem }
                put{ &e, a = "typedef " }
                tn{ &e, t = elem }
                put{ &e, a = " *" }
            }
            func => { put{ &e, a = "typedef ctx_fn *" } }
            void => { put{ &e, a = "typedef void " } }
            else => {
                put{ &e, a = "typedef struct " }
                tn{ &e, t = id }
                ch{ &e, c = ' ' }
            }
        }
        tn{ &e, t = id }
        put{ &e, a = ";\n" }
    }

    fn ctype { mut e: E, p: ir::Prim } {
        match (p) {
            i8    => { put{ &e, a = "int8_t " } }
            i16   => { put{ &e, a = "int16_t " } }
            i32   => { put{ &e, a = "int32_t " } }
            i64   => { put{ &e, a = "int64_t " } }
            u8    => { put{ &e, a = "uint8_t " } }
            u16   => { put{ &e, a = "uint16_t " } }
            u32   => { put{ &e, a = "uint32_t " } }
            u64   => { put{ &e, a = "uint64_t " } }
            usize => { put{ &e, a = "uint64_t " } }
            f32   => { put{ &e, a = "float " } }
            f64   => { put{ &e, a = "double " } }
            bool  => { put{ &e, a = "bool " } }
        }
    }

    // `struct tN { ... };` for arrays, structs, unions and capabilities, after the structs it
    // holds by value.
    fn define { mut e: E, id: ir::TypeId } {
        if (mark{ e, id } >= 2) { return }
        set_mark{ &e, id, m = 2 }
        match (ty{ e, id }) {
            arr{ n, elem } => {
                define{ &e, id = elem }
                struct_head{ &e, id }
                tn{ &e, t = elem }
                put{ &e, a = " a[" }
                num{ &e, n }
                put{ &e, a = "]; };\n" }
            }
            record{ fields } => {
                define_fields{ &e, fields }
                struct_head{ &e, id }
                members{ &e, fields }
                put{ &e, a = "};\n" }
            }
            tagged{ variants } => {
                let mut i: usize = 0
                let mut payload = false
                while (i < variants.len) {
                    let fs = slice::get{ s = variants, i }.fields
                    if (fs != null) {
                        define_fields{ &e, fields = fs }
                        payload = true
                    }
                    i = i + 1
                }
                struct_head{ &e, id }
                put{ &e, a = "uint32_t tag; " }
                if (payload) {
                    put{ &e, a = "union { " }
                    i = 0
                    while (i < variants.len) {
                        let fs = slice::get{ s = variants, i }.fields
                        if (fs != null) {
                            put{ &e, a = "struct { " }
                            members{ &e, fields = fs }
                            put{ &e, a = "} v" }
                            num{ &e, n = i }
                            put{ &e, a = "; " }
                        }
                        i = i + 1
                    }
                    put{ &e, a = "} p; " }
                }
                put{ &e, a = "};\n" }
            }
            cap => {
                struct_head{ &e, id }
                put{ &e, a = "};\n" }
            }
            else => {}
        }
    }

    fn define_fields { mut e: E, fields: slice::Slice(ir::Field) } {
        let mut i: usize = 0
        while (i < fields.len) {
            define{ &e, id = slice::get{ s = fields, i }.ty }
            i = i + 1
        }
    }

    fn struct_head { mut e: E, id: ir::TypeId } {
        put{ &e, a = "struct " }
        tn{ &e, t = id }
        put{ &e, a = " { " }
    }

    fn members { mut e: E, fields: slice::Slice(ir::Field) } {
        let mut i: usize = 0
        while (i < fields.len) {
            let f = slice::get{ s = fields, i }
            tn{ &e, t = f.ty }
            put{ &e, a = " m_" }
            raw{ &e, b = f.name }
            put{ &e, a = "; " }
            i = i + 1
        }
    }

    // Checks the C layout against the IR's.
    fn asserts { mut e: E, id: ir::TypeId } {
        match (ty{ e, id }) {
            record{ size, align, fields } => {
                size_assert{ &e, id, size, align }
                let mut i: usize = 0
                while (i < fields.len) {
                    let f = slice::get{ s = fields, i }
                    offset_assert{ &e, id, variant = null, f }
                    i = i + 1
                }
            }
            tagged{ size, align, variants } => {
                size_assert{ &e, id, size, align }
                let mut i: usize = 0
                while (i < variants.len) {
                    let v = slice::get{ s = variants, i }
                    let some{ value = fields } = v.fields else { i = i + 1; continue }
                    let mut j: usize = 0
                    while (j < fields.len) {
                        offset_assert{ &e, id, variant = @as(u32, i), f = slice::get{ s = fields, i = j } }
                        j = j + 1
                    }
                    i = i + 1
                }
            }
            else => {}
        }
    }

    fn size_assert { mut e: E, id: ir::TypeId, size: u64, align: u64 } {
        put{ &e, a = "_Static_assert(sizeof(" }
        tn{ &e, t = id }
        put{ &e, a = ") == " }
        num{ &e, n = size }
        put{ &e, a = " && _Alignof(" }
        tn{ &e, t = id }
        put{ &e, a = ") == " }
        num{ &e, n = align }
        put{ &e, a = ", \"layout of " }
        tn{ &e, t = id }
        put{ &e, a = "\");\n" }
    }

    fn offset_assert { mut e: E, id: ir::TypeId, variant: ?u32, f: ir::Field } {
        put{ &e, a = "_Static_assert(offsetof(" }
        tn{ &e, t = id }
        put{ &e, a = ", " }
        if (variant != null) {
            put{ &e, a = "p.v" }
            num{ &e, n = variant }
            ch{ &e, c = '.' }
        }
        put{ &e, a = "m_" }
        raw{ &e, b = f.name }
        put{ &e, a = ") == " }
        num{ &e, n = f.offset }
        put{ &e, a = ", \"offset in " }
        tn{ &e, t = id }
        put{ &e, a = "\");\n" }
    }

    // A function type's field as a C parameter type: `mut` ones are void*.
    fn param_type { mut e: E, q: ir::Param } {
        if (q.mutable) { put{ &e, a = "void *" } } else { tn{ &e, t = q.ty } }
    }

    // ---- functions

    fn prototypes { mut e: E } {
        let mut i: usize = 0
        while (i < e.p.fns.len) {
            signature{ &e, f = slice::get{ s = e.p.fns, i } }
            put{ &e, a = ";\n" }
            i = i + 1
        }
        ch{ &e, c = '\n' }
    }

    // `static R fN(P l0, ...)`
    fn signature { mut e: E, f: ir::Func } {
        put{ &e, a = "static " }
        tn{ &e, t = f.ret }
        put{ &e, a = " f" }
        num{ &e, n = f.id }
        ch{ &e, c = '(' }
        if (f.params.len == 0) { put{ &e, a = "void" } }
        let mut i: usize = 0
        while (i < f.params.len) {
            if (i > 0) { put{ &e, a = ", " } }
            if (f.native) {
                param_type{ &e, q = slice::get{ s = f.params, i } }
            } else {
                tn{ &e, t = slice::get{ s = f.locals, i }.ty }
            }
            put{ &e, a = " l" }
            num{ &e, n = i }
            i = i + 1
        }
        ch{ &e, c = ')' }
    }

    // A native calls the runtime's ctx_n_NS_NAME, with slices as ctx_slice and payload-less
    // unions as their tag.
    fn native { mut e: E, f: ir::Func } {
        signature{ &e, f }
        put{ &e, a = " {\n    " }
        let void_ret = is_void{ e, t = f.ret }
        let slice_ret = match (ty{ e, id = f.ret }) { record => { true } else => { false } }
        if (not void_ret) { put{ &e, a = "return " } }
        if (slice_ret) {
            put{ &e, a = "CTX_BITCAST(" }
            tn{ &e, t = f.ret }
            put{ &e, a = ", " }
        }
        put{ &e, a = "ctx_n_" }
        let mut i: usize = 0
        while (i < f.name.len) {
            let c = slice::get{ s = f.name, i }
            if (c == ':') {
                ch{ &e, c = '_' }
                i = i + 2
            } else {
                ch{ &e, c }
                i = i + 1
            }
        }
        ch{ &e, c = '(' }
        i = 0
        while (i < f.params.len) {
            if (i > 0) { put{ &e, a = ", " } }
            let q = slice::get{ s = f.params, i }
            let kind = if (q.mutable) { 0 } else {
                match (ty{ e, id = q.ty }) { record => { 1 } tagged => { 2 } else => { 0 } }
            }
            if (kind == 1) { put{ &e, a = "CTX_BITCAST(ctx_slice, " } }
            ch{ &e, c = 'l' }
            num{ &e, n = i }
            if (kind == 1) { ch{ &e, c = ')' } }
            if (kind == 2) { put{ &e, a = ".tag" } }
            i = i + 1
        }
        if (slice_ret) { ch{ &e, c = ')' } }
        put{ &e, a = ");\n}\n\n" }
    }

    fn function { mut e: E, f: ir::Func } {
        e.f = f
        e.temp = 0
        put{ &e, a = "// " }
        raw{ &e, b = f.name }
        ch{ &e, c = '\n' }
        signature{ &e, f }
        put{ &e, a = " {" }
        e.depth = 1
        let mut i = f.params.len
        while (i < f.locals.len) {
            nl{ &e }
            tn{ &e, t = slice::get{ s = f.locals, i }.ty }
            put{ &e, a = " l" }
            num{ &e, n = i }
            ch{ &e, c = ';' }
            i = i + 1
        }
        nl{ &e }
        put{ &e, a = "CTX_STACK_CHECK();" }
        nl{ &e }
        block{ &e, b = f.body }
        if (not is_void{ e, t = f.ret }) {
            nl{ &e }
            put{ &e, a = "__builtin_unreachable();" }
        }
        e.depth = 0
        put{ &e, a = "\n}\n\n" }
    }

    // `int main`: supplies main's capabilities and args, and returns its exit code.
    fn entry { mut e: E } {
        let f = slice::get{ s = e.p.fns, i = e.p.main }
        put{ &e, a = "int main(int argc, char **argv) {\n    static char cap[1];\n    ctx_init(ctx_file_table, " }
        num{ &e, n = e.p.files.len }
        put{ &e, a = ", CTX_PROGRAM_NAME, argc, argv);\n    " }
        let void_ret = is_void{ e, t = f.ret }
        if (not void_ret) { put{ &e, a = "int32_t code = " } }
        ch{ &e, c = 'f' }
        num{ &e, n = f.id }
        ch{ &e, c = '(' }
        let mut i: usize = 0
        let args = "args"
        while (i < f.params.len) {
            if (i > 0) { put{ &e, a = ", " } }
            let q = slice::get{ s = f.params, i }
            if (q.mutable) {
                put{ &e, a = "(void *)cap" }
            } else if (map::eq_bytes{ a = q.name, b = slice::of(u8){ a = &args } }) {
                put{ &e, a = "CTX_BITCAST(" }
                tn{ &e, t = q.ty }
                put{ &e, a = ", ctx_args())" }
            } else {
                ch{ &e, c = '(' }
                tn{ &e, t = q.ty }
                put{ &e, a = "){}" }
            }
            i = i + 1
        }
        put{ &e, a = ");\n    return ctx_exit(" }
        if (void_ret) { ch{ &e, c = '0' } } else { put{ &e, a = "code" } }
        put{ &e, a = ");\n}\n" }
    }

    // ---- statements

    // `{ ... }`: the statements, then the block's deferred bodies.
    fn block { mut e: E, b: ir::Block } {
        ch{ &e, c = '{' }
        open_block{ &e }
        let mut i: usize = 0
        while (i < b.stmts.len) {
            nl{ &e }
            stmt{ &e, s = slice::get{ s = b.stmts, i } }
            i = i + 1
        }
        close_block{ &e }
        ch{ &e, c = '}' }
    }

    // A branch of an `if` or `match` expression: like block, with its value into _tRES.
    fn value_block { mut e: E, b: ir::Block, res: u32 } {
        ch{ &e, c = '{' }
        open_block{ &e }
        let mut i: usize = 0
        while (i < b.stmts.len) {
            nl{ &e }
            stmt{ &e, s = slice::get{ s = b.stmts, i } }
            i = i + 1
        }
        let r = b.result
        if (r != null) {
            nl{ &e }
            tmp{ &e, k = res }
            put{ &e, a = " = " }
            expr{ &e, x = r.* }
            ch{ &e, c = ';' }
        }
        close_block{ &e }
        ch{ &e, c = '}' }
    }

    fn open_block { mut e: E } {
        e.depth = e.depth + 1
        push_scope{ &e, s = Scope::block }
    }

    fn close_block { mut e: E } {
        defers{ &e, stop = Stop::block }
        while (true) {
            let some{ value = s } = list::pop{ list = &e.scopes } else { break }
            let block = s else { continue }
            break
        }
        e.depth = e.depth - 1
        nl{ &e }
    }

    fn push_scope { mut e: E, s: Scope } {
        add{ xs = &e.scopes, heap = e.heap, item = s }
    }

    // The deferred bodies between here and the nearest `stop`, innermost first.
    fn defers { mut e: E, stop: Stop } {
        let mut i = e.scopes.len
        while (i > 0) {
            i = i - 1
            let s = slice::get{ s = list::items{ list = e.scopes }, i }
            match (s) {
                deferred{ body } => {
                    nl{ &e }
                    block{ &e, b = body }
                }
                block => { match (stop) { block => { return } else => {} } }
                loop  => { match (stop) { loop => { return } else => {} } }
            }
        }
    }

    fn has_defers { e: E, stop: Stop } -> bool {
        let mut i = e.scopes.len
        while (i > 0) {
            i = i - 1
            match (slice::get{ s = list::items{ list = e.scopes }, i }) {
                deferred => { return true }
                block    => { match (stop) { block => { return false } else => {} } }
                loop     => { match (stop) { loop => { return false } else => {} } }
            }
        }
        return false
    }

    fn stmt { mut e: E, s: ir::Stmt } {
        match (s) {
            define{ slot, init } => {
                local{ &e, slot }
                put{ &e, a = " = " }
                expr{ &e, x = init }
                ch{ &e, c = ';' }
            }
            zero{ slot } => {
                put{ &e, a = "memset(&" }
                local{ &e, slot }
                put{ &e, a = ", 0, sizeof " }
                local{ &e, slot }
                put{ &e, a = ");" }
            }
            assign{ place, value } => {
                // ctxi computes the value, then the place.
                if (pure{ e, x = value } or fixed_place{ x = place }) {
                    expr{ &e, x = place }
                    put{ &e, a = " = " }
                    expr{ &e, x = value }
                    ch{ &e, c = ';' }
                } else {
                    let k = fresh{ &e }
                    put{ &e, a = "{ " }
                    declare{ &e, t = value.ty, k }
                    expr{ &e, x = value }
                    put{ &e, a = "; " }
                    expr{ &e, x = place }
                    put{ &e, a = " = " }
                    tmp{ &e, k }
                    put{ &e, a = "; }" }
                }
            }
            eval{ e = x } => {
                if (not is_void{ e, t = x.ty }) { put{ &e, a = "(void)" } }
                expr{ &e, x }
                ch{ &e, c = ';' }
            }
            cond{ c, then, els } => {
                put{ &e, a = "if (" }
                expr{ &e, x = c }
                put{ &e, a = ") " }
                block{ &e, b = then }
                if (els != null) {
                    put{ &e, a = " else " }
                    block{ &e, b = els }
                }
            }
            loop{ c, body } => {
                put{ &e, a = "while (" }
                expr{ &e, x = c }
                put{ &e, a = ") " }
                push_scope{ &e, s = Scope::loop }
                block{ &e, b = body }
                list::pop{ list = &e.scopes }
            }
            brk => {
                defers{ &e, stop = Stop::loop }
                put{ &e, a = " break;" }
            }
            cont => {
                defers{ &e, stop = Stop::loop }
                put{ &e, a = " continue;" }
            }
            ret{ value } => { ret{ &e, value } }
            deferred{ body } => {
                push_scope{ &e, s = Scope::deferred{ body } }
                put{ &e, a = "/* defer */" }
            }
            panic{ pos, msg } => {
                put{ &e, a = "ctx_panic(" }
                position{ &e, p = pos }
                put{ &e, a = ", " }
                cstr{ &e, b = msg }
                put{ &e, a = ");" }
            }
            choose{ scrut, through, arms } => {
                let k = fresh{ &e }
                put{ &e, a = "{ " }
                declare{ &e, t = scrut.ty, k }
                expr{ &e, x = scrut }
                put{ &e, a = ";" }
                arm_chain{ &e, arms, k, through, union_t = union_type{ e, t = scrut.ty, through }, res = null }
                put{ &e, a = " }" }
            }
            let_else{ init, variant, binds, els_variant, els_binds, els } => {
                let k = fresh{ &e }
                let u = init.ty
                put{ &e, a = "{ " }
                declare{ &e, t = u, k }
                expr{ &e, x = init }
                put{ &e, a = "; if (" }
                tmp{ &e, k }
                put{ &e, a = ".tag != " }
                num{ &e, n = variant }
                put{ &e, a = ") { " }
                if (els_variant != null) {
                    bind_all{ &e, binds = els_binds, k, through = false, union_t = u, variant = els_variant }
                }
                block{ &e, b = els }
                put{ &e, a = " } " }
                bind_all{ &e, binds, k, through = false, union_t = u, variant }
                ch{ &e, c = '}' }
            }
        }
    }

    // `return`: the value into a temporary, then every deferred body, then return.
    fn ret { mut e: E, value: ?ir::Expr } {
        let deferred = has_defers{ e, stop = Stop::function }
        let some{ value = v } = value else {
            if (deferred) {
                ch{ &e, c = '{' }
                defers{ &e, stop = Stop::function }
                put{ &e, a = " return; }" }
            } else {
                put{ &e, a = "return;" }
            }
            return
        }
        if (not deferred) {
            put{ &e, a = "return " }
            expr{ &e, x = v }
            ch{ &e, c = ';' }
            return
        }
        let k = fresh{ &e }
        put{ &e, a = "{ " }
        declare{ &e, t = v.ty, k }
        expr{ &e, x = v }
        ch{ &e, c = ';' }
        defers{ &e, stop = Stop::function }
        put{ &e, a = " return " }
        tmp{ &e, k }
        put{ &e, a = "; }" }
    }

    // The arms of a match on _tK: an if-else chain, since `break` inside a C switch would leave
    // the switch, not the loop. With res, each arm is a value block into _tRES.
    fn arm_chain { mut e: E, arms: slice::Slice(ir::Arm), k: u32, through: bool, union_t: ir::TypeId, res: ?u32 } {
        let mut i: usize = 0
        while (i < arms.len) {
            let a = slice::get{ s = arms, i }
            ch{ &e, c = ' ' }
            if (i > 0) { put{ &e, a = "else " } }
            if (a.pats.len > 0) {
                put{ &e, a = "if (" }
                let mut j: usize = 0
                while (j < a.pats.len) {
                    if (j > 0) { put{ &e, a = " || " } }
                    tag_is{ &e, k, through, variant = slice::get{ s = a.pats, i = j }.variant }
                    j = j + 1
                }
                put{ &e, a = ") " }
            }
            arm_body{ &e, a, k, through, union_t, res }
            i = i + 1
        }
    }

    // `_tK.tag == V`
    fn tag_is { mut e: E, k: u32, through: bool, variant: u32 } {
        tmp{ &e, k }
        if (through) { put{ &e, a = "->tag == " } } else { put{ &e, a = ".tag == " } }
        num{ &e, n = variant }
    }

    // With several patterns, the bindings depend on which one matched.
    fn arm_body { mut e: E, a: ir::Arm, k: u32, through: bool, union_t: ir::TypeId, res: ?u32 } {
        put{ &e, a = "{ " }
        if (a.pats.len == 1) {
            let p = slice::get{ s = a.pats, i = 0 }
            bind_all{ &e, binds = p.binds, k, through, union_t, variant = p.variant }
        } else if (a.pats.len > 1 and slice::get{ s = a.pats, i = 0 }.binds.len > 0) {
            let mut j: usize = 0
            while (j < a.pats.len) {
                let p = slice::get{ s = a.pats, i = j }
                if (j > 0) { put{ &e, a = "else " } }
                put{ &e, a = "if (" }
                tag_is{ &e, k, through, variant = p.variant }
                put{ &e, a = ") { " }
                bind_all{ &e, binds = p.binds, k, through, union_t, variant = p.variant }
                put{ &e, a = "} " }
                j = j + 1
            }
        }
        match (res) {
            null          => { block{ &e, b = a.body } }
            some{ value } => { value_block{ &e, b = a.body, res = value } }
        }
        put{ &e, a = " }" }
    }

    // Each binding's slot gets its field of variant `variant` of _tK, or the field's address.
    fn bind_all { mut e: E, binds: slice::Slice(ir::Bind), k: u32, through: bool, union_t: ir::TypeId, variant: u32 } {
        let mut i: usize = 0
        while (i < binds.len) {
            let b = slice::get{ s = binds, i }
            local{ &e, slot = b.slot }
            put{ &e, a = " = " }
            if (b.by_ref) { ch{ &e, c = '&' } }
            tmp{ &e, k }
            if (through) { put{ &e, a = "->" } } else { ch{ &e, c = '.' } }
            payload_member{ &e, union_t, variant, field = b.field }
            put{ &e, a = "; " }
            i = i + 1
        }
    }

    // `p.vV.m_NAME`
    fn payload_member { mut e: E, union_t: ir::TypeId, variant: u32, field: u32 } {
        put{ &e, a = "p.v" }
        num{ &e, n = variant }
        put{ &e, a = ".m_" }
        let tagged{ variants } = ty{ e, id = union_t } else { @panic("emit: payload of a non-union") }
        let some{ value = fields } = slice::get{ s = variants, i = variant }.fields else { @panic("emit: variant has no payload") }
        raw{ &e, b = slice::get{ s = fields, i = field }.name }
    }

    // The union a match scrutinee of type t holds, through a pointer if `through`.
    fn union_type { e: E, t: ir::TypeId, through: bool } -> ir::TypeId {
        if (not through) { return t }
        let ptr{ elem } = ty{ e, id = t } else { @panic("emit: match through a non-pointer") }
        return elem
    }

    // ---- expressions

    fn expr { mut e: E, x: ir::Expr } {
        match (x.k) {
            int{ negative, value } => {
                cast_open{ &e, t = x.ty }
                if (negative) {
                    put{ &e, a = "(-(int64_t)" }
                    num{ &e, n = value - 1 }
                    put{ &e, a = "LL - 1)" }
                } else {
                    num{ &e, n = value }
                    put{ &e, a = "ULL" }
                }
                put{ &e, a = "))" }
            }
            float{ value } => {
                cast_open{ &e, t = x.ty }
                let mut buf: [32]u8
                raw{ &e, b = ascii::fmt_f64{ n = value, into = slice::of(u8){ a = &buf } }.bytes }
                put{ &e, a = "))" }
            }
            boolean{ value } => {
                if (value) { put{ &e, a = "((bool)1)" } } else { put{ &e, a = "((bool)0)" } }
            }
            str{ bytes } => {
                compound{ &e, t = x.ty }
                if (bytes.len > 0) {
                    put{ &e, a = "{ " }
                    cstr{ &e, b = bytes }
                    put{ &e, a = " }" }
                }
                put{ &e, a = "})" }
            }
            nil => {
                compound{ &e, t = x.ty }
                put{ &e, a = "0})" }
            }
            local{ slot } => { local{ &e, slot } }
            deref{ ptr } => {
                put{ &e, a = "(*" }
                expr{ &e, x = ptr.* }
                ch{ &e, c = ')' }
            }
            field{ base, index } => {
                ch{ &e, c = '(' }
                expr{ &e, x = base.* }
                put{ &e, a = ").m_" }
                let record{ fields } = ty{ e, id = base.ty } else { @panic("emit: field of a non-struct") }
                raw{ &e, b = slice::get{ s = fields, i = index }.name }
            }
            index{ base, i, pos } => { index{ &e, base = base.*, i = i.*, pos } }
            payload{ base, variant, field } => {
                ch{ &e, c = '(' }
                expr{ &e, x = base.* }
                put{ &e, a = ")." }
                payload_member{ &e, union_t = base.ty, variant, field }
            }
            addr{ place } => {
                put{ &e, a = "(&" }
                expr{ &e, x = place.* }
                ch{ &e, c = ')' }
            }
            seq{ first, then } => {
                put{ &e, a = "({ (void)(" }
                expr{ &e, x = first.* }
                put{ &e, a = "); " }
                expr{ &e, x = then.* }
                put{ &e, a = "; })" }
            }
            neg{ e = a, pos } => {
                let some{ value = p } = prim_of{ e, t = x.ty } else { @panic("emit: neg of a non-number") }
                if (is_float{ p }) {
                    put{ &e, a = "(-(" }
                    expr{ &e, x = a.* }
                    put{ &e, a = "))" }
                } else {
                    put{ &e, a = "ctx_neg_" }
                    suffix{ &e, p }
                    ch{ &e, c = '(' }
                    expr{ &e, x = a.* }
                    put{ &e, a = ", " }
                    position{ &e, p = pos }
                    ch{ &e, c = ')' }
                }
            }
            lnot{ e = a } => {
                put{ &e, a = "(!" }
                expr{ &e, x = a.* }
                ch{ &e, c = ')' }
            }
            // C's && and || already go left to right, and must not evaluate b early.
            land{ a, b } => { logical{ &e, a = a.*, op = " && ", b = b.* } }
            lor{ a, b }  => { logical{ &e, a = a.*, op = " || ", b = b.* } }
            arith{ op, a, b, pos } => { arith{ &e, t = x.ty, op, a = a.*, b = b.*, pos } }
            bits{ op, a, b } => {
                cast_open{ &e, t = x.ty }
                match (op) {
                    bit_and => { infix{ &e, a = a.*, op = " & ", b = b.* } }
                    bit_or  => { infix{ &e, a = a.*, op = " | ", b = b.* } }
                    bit_xor => { infix{ &e, a = a.*, op = " ^ ", b = b.* } }
                }
                put{ &e, a = "))" }
            }
            shift{ op, a, b, pos } => { shift{ &e, t = x.ty, op, a = a.*, b = b.*, pos } }
            cmp{ op, a, b } => {
                let text = match (op) {
                    eq => { 0 } ne => { 1 } lt => { 2 } le => { 3 } gt => { 4 } ge => { 5 }
                }
                if (text == 0) { infix{ &e, a = a.*, op = " == ", b = b.* } }
                if (text == 1) { infix{ &e, a = a.*, op = " != ", b = b.* } }
                if (text == 2) { infix{ &e, a = a.*, op = " < ", b = b.* } }
                if (text == 3) { infix{ &e, a = a.*, op = " <= ", b = b.* } }
                if (text == 4) { infix{ &e, a = a.*, op = " > ", b = b.* } }
                if (text == 5) { infix{ &e, a = a.*, op = " >= ", b = b.* } }
            }
            ptradd{ p, n } => { infix{ &e, a = p.*, op = " + ", b = n.* } }
            isnull{ e = a } => {
                put{ &e, a = "((" }
                expr{ &e, x = a.* }
                put{ &e, a = ").tag == 0)" }
            }
            notnull{ e = a } => {
                put{ &e, a = "((" }
                expr{ &e, x = a.* }
                put{ &e, a = ").tag != 0)" }
            }
            widen{ e = a } => { convert_to{ &e, t = x.ty, a = a.* } }
            trunc{ e = a } => { convert_to{ &e, t = x.ty, a = a.* } }
            cast{ e = a }  => { convert_to{ &e, t = x.ty, a = a.* } }
            ptraddr{ e = a } => {
                put{ &e, a = "((uint64_t)(uintptr_t)(" }
                expr{ &e, x = a.* }
                put{ &e, a = "))" }
            }
            some{ e = a } => {
                compound{ &e, t = x.ty }
                put{ &e, a = " .tag = 1, .p.v1.m_value = " }
                expr{ &e, x = a.* }
                put{ &e, a = " })" }
            }
            fnconv{ e = a } => { fnconv{ &e, to = x.ty, a = a.* } }
            call{ callee, args } => { call{ &e, callee, args } }
            dcall{ callee, args } => { dcall{ &e, callee = callee.*, args } }
            bind{ callee, args } => { bind{ &e, t = x.ty, callee, args } }
            dbind{ callee, args } => { dbind{ &e, t = x.ty, callee = callee.*, args } }
            fnref{ callee } => {
                thunk{ &e, callee, t = x.ty }
                put{ &e, a = "(&g" }
                num{ &e, n = callee }
                ch{ &e, c = ')' }
            }
            record{ items } => { literal{ &e, t = x.ty, variant = null, items } }
            variant{ index, items } => { literal{ &e, t = x.ty, variant = index, items } }
            array{ elems } => { array{ &e, t = x.ty, elems } }
            repeat{ elem } => { repeat{ &e, t = x.ty, elem = elem.* } }
            ifx{ c, then, els } => {
                let res = fresh{ &e }
                put{ &e, a = "({ " }
                result_var{ &e, t = x.ty, k = res }
                put{ &e, a = "if (" }
                expr{ &e, x = c.* }
                put{ &e, a = ") " }
                value_block{ &e, b = then, res }
                put{ &e, a = " else " }
                value_block{ &e, b = els, res }
                ch{ &e, c = ' ' }
                tmp{ &e, k = res }
                put{ &e, a = "; })" }
            }
            matchx{ scrut, through, arms } => {
                let res = fresh{ &e }
                let k = fresh{ &e }
                put{ &e, a = "({ " }
                result_var{ &e, t = x.ty, k = res }
                declare{ &e, t = scrut.ty, k }
                expr{ &e, x = scrut.* }
                ch{ &e, c = ';' }
                arm_chain{ &e, arms, k, through, union_t = union_type{ e, t = scrut.ty, through }, res }
                ch{ &e, c = ' ' }
                tmp{ &e, k = res }
                put{ &e, a = "; })" }
            }
            convert{ e = a, pos } => { as{ &e, t = x.ty, a = a.*, pos } }
            wrap{ op, a, b } => {
                let tt = temps2{ &e, a = a.*, b = b.* }
                cast_open{ &e, t = x.ty }
                put{ &e, a = "(uint64_t)" }
                operand{ &e, x = a.*, tt, i = 0 }
                match (op) {
                    add => { put{ &e, a = " + " } }
                    sub => { put{ &e, a = " - " } }
                    else => { put{ &e, a = " * " } }
                }
                put{ &e, a = "(uint64_t)" }
                operand{ &e, x = b.*, tt, i = 1 }
                put{ &e, a = "))" }
                close_temps{ &e, tt }
            }
        }
    }

    // `((tT)(`: close it with `))`.
    fn cast_open { mut e: E, t: ir::TypeId } {
        put{ &e, a = "((" }
        tn{ &e, t }
        put{ &e, a = ")(" }
    }

    // `((tT){`
    fn compound { mut e: E, t: ir::TypeId } {
        put{ &e, a = "((" }
        tn{ &e, t }
        put{ &e, a = "){" }
    }

    fn convert_to { mut e: E, t: ir::TypeId, a: ir::Expr } {
        cast_open{ &e, t }
        expr{ &e, x = a }
        put{ &e, a = "))" }
    }

    fn logical(A) { mut e: E, a: ir::Expr, op: A, b: ir::Expr } {
        ch{ &e, c = '(' }
        expr{ &e, x = a }
        put{ &e, a = op }
        expr{ &e, x = b }
        ch{ &e, c = ')' }
    }

    // `(A OP B)`, in ctxi's order.
    fn infix(A) { mut e: E, a: ir::Expr, op: A, b: ir::Expr } {
        let tt = temps2{ &e, a, b }
        ch{ &e, c = '(' }
        operand{ &e, x = a, tt, i = 0 }
        put{ &e, a = op }
        operand{ &e, x = b, tt, i = 1 }
        ch{ &e, c = ')' }
        close_temps{ &e, tt }
    }

    fn arith { mut e: E, t: ir::TypeId, op: ir::ArithOp, a: ir::Expr, b: ir::Expr, pos: ir::Pos } {
        let some{ value = p } = prim_of{ e, t } else { @panic("emit: arithmetic on a non-number") }
        if (is_float{ p }) {
            match (op) {
                add => { infix{ &e, a, op = " + ", b } }
                sub => { infix{ &e, a, op = " - ", b } }
                mul => { infix{ &e, a, op = " * ", b } }
                div => { infix{ &e, a, op = " / ", b } }
                rem => {
                    let tt = temps2{ &e, a, b }
                    cast_open{ &e, t }
                    put{ &e, a = "fmod(" }
                    operand{ &e, x = a, tt, i = 0 }
                    put{ &e, a = ", " }
                    operand{ &e, x = b, tt, i = 1 }
                    put{ &e, a = ")))" }
                    close_temps{ &e, tt }
                }
            }
            return
        }
        let tt = temps2{ &e, a, b }
        match (op) {
            add => { put{ &e, a = "ctx_add_" } }
            sub => { put{ &e, a = "ctx_sub_" } }
            mul => { put{ &e, a = "ctx_mul_" } }
            div => { put{ &e, a = "ctx_div_" } }
            rem => { put{ &e, a = "ctx_rem_" } }
        }
        suffix{ &e, p }
        ch{ &e, c = '(' }
        operand{ &e, x = a, tt, i = 0 }
        put{ &e, a = ", " }
        operand{ &e, x = b, tt, i = 1 }
        put{ &e, a = ", " }
        position{ &e, p = pos }
        ch{ &e, c = ')' }
        close_temps{ &e, tt }
    }

    // `((tT)((uint64_t)A << ctx_shcount_i(B, BITS, pos)))`: shl in unsigned arithmetic, so the bits
    // shifted out are dropped; shr is C's, which is arithmetic for a signed A with gcc and clang.
    fn shift { mut e: E, t: ir::TypeId, op: ir::ShiftOp, a: ir::Expr, b: ir::Expr, pos: ir::Pos } {
        let some{ value = p } = prim_of{ e, t } else { @panic("emit: shift of a non-integer") }
        let some{ value = cp } = prim_of{ e, t = b.ty } else { @panic("emit: shift count of a non-integer") }
        let tt = temps2{ &e, a, b }
        cast_open{ &e, t }
        match (op) {
            shl => {
                put{ &e, a = "(uint64_t)" }
                operand{ &e, x = a, tt, i = 0 }
                put{ &e, a = " << " }
            }
            shr => {
                operand{ &e, x = a, tt, i = 0 }
                put{ &e, a = " >> " }
            }
        }
        if (is_signed{ p = cp }) { put{ &e, a = "ctx_shcount_i(" } } else { put{ &e, a = "ctx_shcount_u(" } }
        operand{ &e, x = b, tt, i = 1 }
        put{ &e, a = ", " }
        num{ &e, n = bit_width{ p } }
        put{ &e, a = ", " }
        position{ &e, p = pos }
        put{ &e, a = ")))" }
        close_temps{ &e, tt }
    }

    fn bit_width { p: ir::Prim } -> u64 {
        return match (p) {
            i8 => { 8 } u8 => { 8 } i16 => { 16 } u16 => { 16 } i32 => { 32 } u32 => { 32 } else => { 64 }
        }
    }

    // `(B).a[ctx_idx(I, N, pos)]`, with the base before the index.
    fn index { mut e: E, base: ir::Expr, i: ir::Expr, pos: ir::Pos } {
        let arr{ n } = ty{ e, id = base.ty } else { @panic("emit: index of a non-array") }
        if (not ordered{ e, a = base, b = i }) {
            ch{ &e, c = '(' }
            expr{ &e, x = base }
            put{ &e, a = ").a[ctx_idx(" }
            expr{ &e, x = i }
            put{ &e, a = ", " }
            num{ &e, n }
            put{ &e, a = ", " }
            position{ &e, p = pos }
            put{ &e, a = ")]" }
            return
        }
        let kb = fresh{ &e }
        let ki = fresh{ &e }
        let place = is_place{ x = base }
        if (place) { put{ &e, a = "(*({ " } } else { put{ &e, a = "({ " } }
        tn{ &e, t = base.ty }
        if (place) { put{ &e, a = " *" } } else { ch{ &e, c = ' ' } }
        tmp{ &e, k = kb }
        if (place) { put{ &e, a = " = &(" } } else { put{ &e, a = " = (" } }
        expr{ &e, x = base }
        put{ &e, a = "); uint64_t " }
        tmp{ &e, k = ki }
        put{ &e, a = " = " }
        expr{ &e, x = i }
        put{ &e, a = "; " }
        if (place) { ch{ &e, c = '&' } }
        tmp{ &e, k = kb }
        if (place) { put{ &e, a = "->a[ctx_idx(" } } else { put{ &e, a = ".a[ctx_idx(" } }
        tmp{ &e, k = ki }
        put{ &e, a = ", " }
        num{ &e, n }
        put{ &e, a = ", " }
        position{ &e, p = pos }
        put{ &e, a = ")]; })" }
        if (place) { ch{ &e, c = ')' } }
    }

    // @as between numbers: range-checked for integer results.
    fn as { mut e: E, t: ir::TypeId, a: ir::Expr, pos: ir::Pos } {
        let some{ value = dst } = prim_of{ e, t } else { @panic("emit: @as to a non-number") }
        let some{ value = src } = prim_of{ e, t = a.ty } else { @panic("emit: @as of a non-number") }
        if (is_float{ p = dst }) {
            cast_open{ &e, t }
            if (not is_float{ p = src }) { put{ &e, a = "(double)" } }
            expr{ &e, x = a }
            put{ &e, a = "))" }
            return
        }
        let signed_dst = is_signed{ p = dst }
        cast_open{ &e, t }
        if (is_float{ p = src }) {
            // ctx_f2i_s(v, LO, HI) or ctx_f2i_u(v, HI)
            if (signed_dst) { put{ &e, a = "ctx_f2i_s((double)(" } } else { put{ &e, a = "ctx_f2i_u((double)(" } }
            expr{ &e, x = a }
            put{ &e, a = "), " }
            if (signed_dst) {
                limit{ &e, p = dst, low = true }
                put{ &e, a = ", " }
            }
            limit{ &e, p = dst, low = false }
        } else if (is_signed{ p = src }) {
            // ctx_as_s(v, LO, HI); a u64 destination's HI is INT64_MAX, all an i64 can reach.
            put{ &e, a = "ctx_as_s((int64_t)(" }
            expr{ &e, x = a }
            put{ &e, a = "), " }
            if (signed_dst) {
                limit{ &e, p = dst, low = true }
                put{ &e, a = ", " }
                limit{ &e, p = dst, low = false }
            } else if (dst_is_u64{ p = dst }) {
                put{ &e, a = "0, INT64_MAX" }
            } else {
                put{ &e, a = "0, " }
                limit{ &e, p = dst, low = false }
            }
        } else {
            put{ &e, a = "ctx_as_u((uint64_t)(" }
            expr{ &e, x = a }
            put{ &e, a = "), " }
            limit{ &e, p = dst, low = false }
        }
        put{ &e, a = ", \"" }
        prim_name{ &e, p = dst }
        put{ &e, a = "\", " }
        position{ &e, p = pos }
        put{ &e, a = ")))" }
    }

    fn dst_is_u64 { p: ir::Prim } -> bool {
        return match (p) { u64 => { true } usize => { true } else => { false } }
    }

    // INTn_MIN or INTn_MAX, or UINTn_MAX.
    fn limit { mut e: E, p: ir::Prim, low: bool } {
        match (p) {
            i8    => { if (low) { put{ &e, a = "INT8_MIN" } } else { put{ &e, a = "INT8_MAX" } } }
            i16   => { if (low) { put{ &e, a = "INT16_MIN" } } else { put{ &e, a = "INT16_MAX" } } }
            i32   => { if (low) { put{ &e, a = "INT32_MIN" } } else { put{ &e, a = "INT32_MAX" } } }
            i64   => { if (low) { put{ &e, a = "INT64_MIN" } } else { put{ &e, a = "INT64_MAX" } } }
            u8    => { put{ &e, a = "UINT8_MAX" } }
            u16   => { put{ &e, a = "UINT16_MAX" } }
            u32   => { put{ &e, a = "UINT32_MAX" } }
            else  => { put{ &e, a = "UINT64_MAX" } }
        }
    }

    // A struct or variant literal.
    fn literal { mut e: E, t: ir::TypeId, variant: ?u32, items: slice::Slice(ir::Arg) } {
        let tt = temps_args{ &e, args = items }
        compound{ &e, t }
        let mut names = slice::empty(ir::Field){}
        let mut payload = false
        match (ty{ e, id = t }) {
            record{ fields } => { names = fields }
            tagged{ variants } => {
                let some{ value = v } = variant else { @panic("emit: variant literal without a variant") }
                put{ &e, a = " .tag = " }
                num{ &e, n = v }
                let fs = slice::get{ s = variants, i = v }.fields
                if (fs != null) {
                    names = fs
                    payload = true
                    put{ &e, a = ", .p.v" }
                    num{ &e, n = v }
                    put{ &e, a = " = {" }
                }
            }
            else => { @panic("emit: literal of a non-struct") }
        }
        let mut i: usize = 0
        while (i < items.len) {
            let a = slice::get{ s = items, i }
            put{ &e, a = " .m_" }
            raw{ &e, b = slice::get{ s = names, i = a.index }.name }
            put{ &e, a = " = " }
            operand{ &e, x = a.value, tt, i = @as(u32, i) }
            ch{ &e, c = ',' }
            i = i + 1
        }
        if (payload) { put{ &e, a = " }" } }
        put{ &e, a = " })" }
        close_temps{ &e, tt }
    }

    fn array { mut e: E, t: ir::TypeId, elems: slice::Slice(ir::Expr) } {
        let tt = temps_list{ &e, xs = elems }
        compound{ &e, t }
        if (elems.len > 0) {
            put{ &e, a = "{ " }
            let mut i: usize = 0
            while (i < elems.len) {
                if (i > 0) { put{ &e, a = ", " } }
                operand{ &e, x = slice::get{ s = elems, i }, tt, i = @as(u32, i) }
                i = i + 1
            }
            put{ &e, a = " }" }
        }
        put{ &e, a = "})" }
        close_temps{ &e, tt }
    }

    // [x; N]: x once, copied N times.
    fn repeat { mut e: E, t: ir::TypeId, elem: ir::Expr } {
        let arr{ n } = ty{ e, id = t } else { @panic("emit: repeat of a non-array") }
        let kv = fresh{ &e }
        let ka = fresh{ &e }
        put{ &e, a = "({ " }
        declare{ &e, t = elem.ty, k = kv }
        expr{ &e, x = elem }
        put{ &e, a = "; " }
        tn{ &e, t }
        ch{ &e, c = ' ' }
        tmp{ &e, k = ka }
        put{ &e, a = "; for (uint64_t _i = 0; _i < " }
        num{ &e, n }
        put{ &e, a = "; _i++) " }
        tmp{ &e, k = ka }
        put{ &e, a = ".a[_i] = " }
        tmp{ &e, k = kv }
        put{ &e, a = "; " }
        tmp{ &e, k = ka }
        put{ &e, a = "; })" }
    }

    // ---- calls and function values

    // fN(args in parameter order), evaluated in the IR's order.
    fn call { mut e: E, callee: u32, args: slice::Slice(ir::Arg) } {
        let f = slice::get{ s = e.p.fns, i = callee }
        let tt = temps_args{ &e, args }
        ch{ &e, c = 'f' }
        num{ &e, n = callee }
        ch{ &e, c = '(' }
        in_order{ &e, args, n = f.params.len, tt }
        ch{ &e, c = ')' }
        close_temps{ &e, tt }
    }

    // The args, by parameter index 0..n.
    fn in_order { mut e: E, args: slice::Slice(ir::Arg), n: usize, tt: Temps } {
        let mut j: usize = 0
        while (j < n) {
            if (j > 0) { put{ &e, a = ", " } }
            let mut i: usize = 0
            while (i < args.len) {
                let a = slice::get{ s = args, i }
                if (a.index == j) { operand{ &e, x = a.value, tt, i = @as(u32, i) } }
                i = i + 1
            }
            j = j + 1
        }
    }

    // The callee first, then the args; called through its code.
    fn dcall { mut e: E, callee: ir::Expr, args: slice::Slice(ir::Arg) } {
        let func{ params } = ty{ e, id = callee.ty } else { @panic("emit: call of a non-function") }
        let kf = fresh{ &e }
        put{ &e, a = "({ ctx_fn *" }
        tmp{ &e, k = kf }
        put{ &e, a = " = " }
        expr{ &e, x = callee }
        put{ &e, a = "; " }
        let tt = temps_args{ &e, args }
        put{ &e, a = "((c" }
        num{ &e, n = callee.ty }
        put{ &e, a = ")" }
        tmp{ &e, k = kf }
        put{ &e, a = "->code)(" }
        tmp{ &e, k = kf }
        if (params.len > 0) { put{ &e, a = ", " } }
        in_order{ &e, args, n = params.len, tt }
        ch{ &e, c = ')' }
        close_temps{ &e, tt }
        put{ &e, a = "; })" }
    }

    // A bound function: a record holding the code and the given args, allocated each time.
    fn bind { mut e: E, t: ir::TypeId, callee: u32, args: slice::Slice(ir::Arg) } {
        let f = slice::get{ s = e.p.fns, i = callee }
        let k = e.sites
        e.sites = e.sites + 1
        record{ &e, k, inner = false, args }
        let func{ params, ret } = ty{ e, id = t } else { @panic("emit: bind to a non-function type") }
        to_aux{ &e }
        code_head{ &e, prefix = "b", k, ret, params }
        put{ &e, a = "    struct b" }
        num{ &e, n = k }
        put{ &e, a = " *s = (struct b" }
        num{ &e, n = k }
        put{ &e, a = " *)self;\n    " }
        if (not is_void{ e, t = ret }) { put{ &e, a = "return " } }
        ch{ &e, c = 'f' }
        num{ &e, n = callee }
        ch{ &e, c = '(' }
        forward{ &e, target = f.params, args, given = params }
        put{ &e, a = ");\n}\n\n" }
        to_aux{ &e }
        new_record{ &e, k, inner = null, args }
    }

    // A bound function value: like bind, calling the callee value through its code.
    fn dbind { mut e: E, t: ir::TypeId, callee: ir::Expr, args: slice::Slice(ir::Arg) } {
        let func{ params = target } = ty{ e, id = callee.ty } else { @panic("emit: bind of a non-function") }
        let k = e.sites
        e.sites = e.sites + 1
        record{ &e, k, inner = true, args }
        let func{ params, ret } = ty{ e, id = t } else { @panic("emit: bind to a non-function type") }
        to_aux{ &e }
        code_head{ &e, prefix = "b", k, ret, params }
        put{ &e, a = "    struct b" }
        num{ &e, n = k }
        put{ &e, a = " *s = (struct b" }
        num{ &e, n = k }
        put{ &e, a = " *)self;\n    " }
        if (not is_void{ e, t = ret }) { put{ &e, a = "return " } }
        put{ &e, a = "((c" }
        num{ &e, n = callee.ty }
        put{ &e, a = ")s->inner->code)(s->inner" }
        if (target.len > 0) { put{ &e, a = ", " } }
        forward{ &e, target, args, given = params }
        put{ &e, a = ");\n}\n\n" }
        to_aux{ &e }
        new_record{ &e, k, inner = callee, args }
    }

    // `struct bK { ctx_fn base; [ctx_fn *inner;] T cI; ... };` for the args it captures.
    fn record { mut e: E, k: u32, inner: bool, args: slice::Slice(ir::Arg) } {
        to_aux{ &e }
        put{ &e, a = "struct b" }
        num{ &e, n = k }
        put{ &e, a = " { ctx_fn base; " }
        if (inner) { put{ &e, a = "ctx_fn *inner; " } }
        let mut i: usize = 0
        while (i < args.len) {
            let a = slice::get{ s = args, i }
            tn{ &e, t = a.value.ty }
            put{ &e, a = " c" }
            num{ &e, n = a.index }
            put{ &e, a = "; " }
            i = i + 1
        }
        put{ &e, a = "};\n" }
        to_aux{ &e }
    }

    // Allocates record bK and fills it, in the IR's order: the callee value, then the args.
    fn new_record { mut e: E, k: u32, inner: ?ir::Expr, args: slice::Slice(ir::Arg) } {
        let kr = fresh{ &e }
        put{ &e, a = "({ struct b" }
        num{ &e, n = k }
        put{ &e, a = " *" }
        tmp{ &e, k = kr }
        put{ &e, a = " = ctx_alloc(sizeof(struct b" }
        num{ &e, n = k }
        put{ &e, a = ")); " }
        tmp{ &e, k = kr }
        put{ &e, a = "->base.code = (void (*)(void))b" }
        num{ &e, n = k }
        put{ &e, a = "_code; " }
        match (inner) {
            some{ value } => {
                tmp{ &e, k = kr }
                put{ &e, a = "->inner = " }
                expr{ &e, x = value }
                put{ &e, a = "; " }
            }
            null => {}
        }
        let mut i: usize = 0
        while (i < args.len) {
            let a = slice::get{ s = args, i }
            tmp{ &e, k = kr }
            put{ &e, a = "->c" }
            num{ &e, n = a.index }
            put{ &e, a = " = " }
            expr{ &e, x = a.value }
            put{ &e, a = "; " }
            i = i + 1
        }
        put{ &e, a = "(ctx_fn *)" }
        tmp{ &e, k = kr }
        put{ &e, a = "; })" }
    }

    // `static R PREFIXK_code(ctx_fn *self, P a0, ...) {`
    fn code_head(A) { mut e: E, prefix: A, k: u32, ret: ir::TypeId, params: slice::Slice(ir::Param) } {
        put{ &e, a = "static " }
        tn{ &e, t = ret }
        ch{ &e, c = ' ' }
        put{ &e, a = prefix }
        num{ &e, n = k }
        put{ &e, a = "_code(ctx_fn *self" }
        let mut i: usize = 0
        while (i < params.len) {
            put{ &e, a = ", " }
            param_type{ &e, q = slice::get{ s = params, i } }
            put{ &e, a = " a" }
            num{ &e, n = i }
            i = i + 1
        }
        put{ &e, a = ") {\n" }
    }

    // The target's params in order: a captured arg (s->cJ) or the code's param of the same name.
    fn forward { mut e: E, target: slice::Slice(ir::Param), args: slice::Slice(ir::Arg), given: slice::Slice(ir::Param) } {
        let mut j: usize = 0
        while (j < target.len) {
            if (j > 0) { put{ &e, a = ", " } }
            let mut captured = false
            let mut i: usize = 0
            while (i < args.len) {
                if (slice::get{ s = args, i }.index == j) { captured = true }
                i = i + 1
            }
            if (captured) {
                put{ &e, a = "s->c" }
                num{ &e, n = j }
            } else {
                by_name{ &e, name = slice::get{ s = target, i = j }.name, params = given }
            }
            j = j + 1
        }
    }

    // `aI` for the param named `name`.
    fn by_name { mut e: E, name: ir::Bytes, params: slice::Slice(ir::Param) } {
        let mut i: usize = 0
        while (i < params.len) {
            if (map::eq_bytes{ a = slice::get{ s = params, i }.name, b = name }) {
                ch{ &e, c = 'a' }
                num{ &e, n = i }
                return
            }
            i = i + 1
        }
        @panic("emit: a function value's param is missing")
    }

    // gN, the value of function N: a static record whose code hN calls fN.
    fn thunk { mut e: E, callee: u32, t: ir::TypeId } {
        if (slice::get{ s = list::items{ list = e.thunks }, i = callee }) { return }
        slice::set{ s = list::items{ list = e.thunks }, i = callee, v = true }
        let f = slice::get{ s = e.p.fns, i = callee }
        let func{ params, ret } = ty{ e, id = t } else { @panic("emit: fnref of a non-function type") }
        to_aux{ &e }
        code_head{ &e, prefix = "h", k = callee, ret, params }
        put{ &e, a = "    (void)self;\n    " }
        if (not is_void{ e, t = ret }) { put{ &e, a = "return " } }
        ch{ &e, c = 'f' }
        num{ &e, n = callee }
        ch{ &e, c = '(' }
        forward{ &e, target = f.params, args = slice::empty(ir::Arg){}, given = params }
        put{ &e, a = ");\n}\nstatic ctx_fn g" }
        num{ &e, n = callee }
        put{ &e, a = " = { (void (*)(void))h" }
        num{ &e, n = callee }
        put{ &e, a = "_code };\n\n" }
        to_aux{ &e }
    }

    // A function value of type `from` as type `to`. The same fields need nothing; more fields
    // need an adapter that drops them.
    fn fnconv { mut e: E, to: ir::TypeId, a: ir::Expr } {
        let func{ params = src, ret } = ty{ e, id = a.ty } else { @panic("emit: fnconv of a non-function") }
        let func{ params = dst } = ty{ e, id = to } else { @panic("emit: fnconv to a non-function") }
        if (same_params{ a = src, b = dst }) {
            expr{ &e, x = a }
            return
        }
        let mut k: usize = 0
        while (k < e.adapters.len) {
            let q = slice::get{ s = list::items{ list = e.adapters }, i = k }
            if (q.from == a.ty and q.to == to) { break }
            k = k + 1
        }
        if (k == e.adapters.len) {
            add{ xs = &e.adapters, heap = e.heap, item = Pair{ from = a.ty, to } }
            to_aux{ &e }
            code_head{ &e, prefix = "a", k = @as(u32, k), ret, params = dst }
            put{ &e, a = "    ctx_fn *in = ((ctx_adapter *)self)->inner;\n    " }
            if (not is_void{ e, t = ret }) { put{ &e, a = "return " } }
            put{ &e, a = "((c" }
            num{ &e, n = a.ty }
            put{ &e, a = ")in->code)(in" }
            if (src.len > 0) { put{ &e, a = ", " } }
            forward{ &e, target = src, args = slice::empty(ir::Arg){}, given = dst }
            put{ &e, a = ");\n}\n\n" }
            to_aux{ &e }
        }
        put{ &e, a = "ctx_adapt(" }
        expr{ &e, x = a }
        put{ &e, a = ", (void (*)(void))a" }
        num{ &e, n = k }
        put{ &e, a = "_code)" }
    }

    fn same_params { a: slice::Slice(ir::Param), b: slice::Slice(ir::Param) } -> bool {
        if (a.len != b.len) { return false }
        let mut i: usize = 0
        while (i < a.len) {
            let x = slice::get{ s = a, i }
            let y = slice::get{ s = b, i }
            if (x.ty != y.ty or x.mutable != y.mutable or not map::eq_bytes{ a = x.name, b = y.name }) { return false }
            i = i + 1
        }
        return true
    }

    // Swaps the output with the aux buffer.
    fn to_aux { mut e: E } {
        let o = e.o
        e.o = e.aux
        e.aux = o
    }

    // ---- evaluation order
    //
    // C leaves the order of operands open; ctxi goes left to right. Operands go into temporaries
    // when the order could show: some operand has an effect or can panic, and at least two of
    // them aren't constants.

    // Temporaries for a node's operands: tt.base is the first _tK, or tt.on is false.
    struct Temps { on: bool, base: u32 }

    fn temps2 { mut e: E, a: ir::Expr, b: ir::Expr } -> Temps {
        if (not ordered{ e, a, b }) { return Temps{ on = false, base = 0 } }
        let base = e.temp
        e.temp = e.temp + 2
        put{ &e, a = "({ " }
        declare{ &e, t = a.ty, k = base }
        expr{ &e, x = a }
        put{ &e, a = "; " }
        declare{ &e, t = b.ty, k = base + 1 }
        expr{ &e, x = b }
        put{ &e, a = "; " }
        return Temps{ on = true, base }
    }

    fn temps_args { mut e: E, args: slice::Slice(ir::Arg) } -> Temps {
        let mut effects: usize = 0
        let mut vars: usize = 0
        let mut i: usize = 0
        while (i < args.len) {
            let x = slice::get{ s = args, i }.value
            if (not pure{ e, x }) { effects = effects + 1 }
            if (not constant{ x }) { vars = vars + 1 }
            i = i + 1
        }
        if (effects == 0 or vars < 2) { return Temps{ on = false, base = 0 } }
        let base = e.temp
        e.temp = e.temp + @as(u32, args.len)
        put{ &e, a = "({ " }
        i = 0
        while (i < args.len) {
            let x = slice::get{ s = args, i }.value
            declare{ &e, t = x.ty, k = base + @as(u32, i) }
            expr{ &e, x }
            put{ &e, a = "; " }
            i = i + 1
        }
        return Temps{ on = true, base }
    }

    fn temps_list { mut e: E, xs: slice::Slice(ir::Expr) } -> Temps {
        let mut effects: usize = 0
        let mut vars: usize = 0
        let mut i: usize = 0
        while (i < xs.len) {
            let x = slice::get{ s = xs, i }
            if (not pure{ e, x }) { effects = effects + 1 }
            if (not constant{ x }) { vars = vars + 1 }
            i = i + 1
        }
        if (effects == 0 or vars < 2) { return Temps{ on = false, base = 0 } }
        let base = e.temp
        e.temp = e.temp + @as(u32, xs.len)
        put{ &e, a = "({ " }
        i = 0
        while (i < xs.len) {
            let x = slice::get{ s = xs, i }
            declare{ &e, t = x.ty, k = base + @as(u32, i) }
            expr{ &e, x }
            put{ &e, a = "; " }
            i = i + 1
        }
        return Temps{ on = true, base }
    }

    // Operand i: its temporary, or the expression itself.
    fn operand { mut e: E, x: ir::Expr, tt: Temps, i: u32 } {
        if (tt.on) { tmp{ &e, k = tt.base + i } } else { expr{ &e, x } }
    }

    fn close_temps { mut e: E, tt: Temps } {
        if (tt.on) { put{ &e, a = "; })" } }
    }

    // Must a and b go into temporaries?
    fn ordered { e: E, a: ir::Expr, b: ir::Expr } -> bool {
        let pa = pure{ e, x = a }
        let pb = pure{ e, x = b }
        if (pa and pb) { return false }
        return not constant{ x = a } and not constant{ x = b }
    }

    // No effects, no panics: reading it earlier or later gives the same result, as long as
    // nothing between writes memory.
    fn pure { e: E, x: ir::Expr } -> bool {
        return match (x.k) {
            int | float | boolean | str | nil | local | fnref => { true }
            deref{ ptr = a } | field{ base = a } | payload{ base = a } | addr{ place = a }
            | lnot{ e = a } | isnull{ e = a } | notnull{ e = a } | widen{ e = a } | some{ e = a }
            | cast{ e = a } | ptraddr{ e = a } | trunc{ e = a } | fnconv{ e = a } | repeat{ elem = a } => {
                pure{ e, x = a.* }
            }
            seq{ first = a, then = b } | land{ a, b } | lor{ a, b } | cmp{ a, b } | bits{ a, b }
            | ptradd{ p = a, n = b } | wrap{ a, b } => {
                pure{ e, x = a.* } and pure{ e, x = b.* }
            }
            arith{ a, b }      => { float_type{ e, t = x.ty } and pure{ e, x = a.* } and pure{ e, x = b.* } }
            neg{ e = a }       => { float_type{ e, t = x.ty } and pure{ e, x = a.* } }
            record{ items }    => { pure_args{ e, args = items } }
            variant{ items }   => { pure_args{ e, args = items } }
            array{ elems }     => {
                let mut i: usize = 0
                let mut ok = true
                while (i < elems.len) {
                    if (not pure{ e, x = slice::get{ s = elems, i } }) { ok = false }
                    i = i + 1
                }
                ok
            }
            else => { false }
        }
    }

    fn pure_args { e: E, args: slice::Slice(ir::Arg) } -> bool {
        let mut i: usize = 0
        while (i < args.len) {
            if (not pure{ e, x = slice::get{ s = args, i }.value }) { return false }
            i = i + 1
        }
        return true
    }

    // The same value whenever it is computed, whatever else runs.
    fn constant { x: ir::Expr } -> bool {
        return match (x.k) {
            int | float | boolean | str | nil | fnref => { true }
            addr{ place } => { fixed_place{ x = place.* } }
            else    => { false }
        }
    }

    // A place whose address doesn't depend on memory: a local, or a field or payload of one.
    fn fixed_place { x: ir::Expr } -> bool {
        return match (x.k) {
            local                         => { true }
            field{ base } | payload{ base } => { fixed_place{ x = base.* } }
            else             => { false }
        }
    }

    fn is_place { x: ir::Expr } -> bool {
        return match (x.k) {
            local           => { true }
            deref           => { true }
            field{ base }   => { is_place{ x = base.* } }
            index{ base }   => { is_place{ x = base.* } }
            payload{ base } => { is_place{ x = base.* } }
            else            => { false }
        }
    }

    // ---- types, briefly

    fn ty { e: E, id: ir::TypeId } -> ir::Type {
        return slice::get{ s = e.p.types, i = id }
    }

    fn is_void { e: E, t: ir::TypeId } -> bool {
        return match (ty{ e, id = t }) { void => { true } else => { false } }
    }

    fn prim_of { e: E, t: ir::TypeId } -> ?ir::Prim {
        let prim{ p } = ty{ e, id = t } else { return null }
        return p
    }

    fn float_type { e: E, t: ir::TypeId } -> bool {
        let some{ value } = prim_of{ e, t } else { return false }
        return is_float{ p = value }
    }

    fn is_float { p: ir::Prim } -> bool {
        return match (p) { f32 => { true } f64 => { true } else => { false } }
    }

    fn is_signed { p: ir::Prim } -> bool {
        return match (p) { i8 => { true } i16 => { true } i32 => { true } i64 => { true } else => { false } }
    }

    // The runtime's name for an integer type: usize is u64.
    fn suffix { mut e: E, p: ir::Prim } {
        match (p) {
            usize => { put{ &e, a = "u64" } }
            else  => { prim_name{ &e, p } }
        }
    }

    fn prim_name { mut e: E, p: ir::Prim } {
        match (p) {
            i8    => { put{ &e, a = "i8" } }
            i16   => { put{ &e, a = "i16" } }
            i32   => { put{ &e, a = "i32" } }
            i64   => { put{ &e, a = "i64" } }
            u8    => { put{ &e, a = "u8" } }
            u16   => { put{ &e, a = "u16" } }
            u32   => { put{ &e, a = "u32" } }
            u64   => { put{ &e, a = "u64" } }
            usize => { put{ &e, a = "usize" } }
            f32   => { put{ &e, a = "f32" } }
            f64   => { put{ &e, a = "f64" } }
            bool  => { put{ &e, a = "bool" } }
        }
    }

    // ---- text

    fn fresh { mut e: E } -> u32 {
        let k = e.temp
        e.temp = e.temp + 1
        return k
    }

    // `tT _tK = `
    fn declare { mut e: E, t: ir::TypeId, k: u32 } {
        tn{ &e, t }
        ch{ &e, c = ' ' }
        tmp{ &e, k }
        put{ &e, a = " = " }
    }

    // `tT _tK; `, the result of an `if` or `match` expression.
    fn result_var { mut e: E, t: ir::TypeId, k: u32 } {
        tn{ &e, t }
        ch{ &e, c = ' ' }
        tmp{ &e, k }
        put{ &e, a = "; " }
    }

    fn tmp { mut e: E, k: u32 } {
        put{ &e, a = "_t" }
        num{ &e, n = k }
    }

    fn local { mut e: E, slot: u32 } {
        ch{ &e, c = 'l' }
        num{ &e, n = slot }
    }

    fn tn { mut e: E, t: ir::TypeId } {
        ch{ &e, c = 't' }
        num{ &e, n = t }
    }

    // `LINE, COL, FILE`
    fn position { mut e: E, p: ir::Pos } {
        num{ &e, n = p.line }
        put{ &e, a = ", " }
        num{ &e, n = p.col }
        put{ &e, a = ", " }
        num{ &e, n = p.file }
    }

    // A C string literal: printable ASCII as is, except `"`, `\` and `?`; other bytes as octal.
    fn cstr { mut e: E, b: ir::Bytes } {
        ch{ &e, c = '"' }
        let mut i: usize = 0
        while (i < b.len) {
            let c = slice::get{ s = b, i }
            if (c >= 32 and c <= 126 and c != '"' and c != '\\' and c != '?') {
                ch{ &e, c }
            } else {
                ch{ &e, c = '\\' }
                ch{ &e, c = '0' + c / 64 }
                ch{ &e, c = '0' + c / 8 % 8 }
                ch{ &e, c = '0' + c % 8 }
            }
            i = i + 1
        }
        ch{ &e, c = '"' }
    }

    fn nl { mut e: E } {
        ch{ &e, c = '\n' }
        let mut i: u32 = 0
        while (i < e.depth) {
            put{ &e, a = "    " }
            i = i + 1
        }
    }

    fn put(A) { mut e: E, a: A } {
        ir_print::text{ o = &e.o, a }
    }

    fn ch { mut e: E, c: u8 } {
        ir_print::char{ o = &e.o, c }
    }

    fn num { mut e: E, n: u64 } {
        ir_print::num{ o = &e.o, n }
    }

    fn raw { mut e: E, b: ir::Bytes } {
        ir_print::bytes{ o = &e.o, b }
    }

    fn add(T) { mut xs: list::List(T, ir::Heap), heap: *ir::Heap, item: T } {
        if (not list::push{ list = &xs, heap, item }) { @panic("emit: out of memory") }
    }
}
