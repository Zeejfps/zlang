// The C backend: an ir::Program as C for GNU C with ctxc/rt/ctxrt.h, as one file or as units
// to compile apart and link.
//
//   let text = emit::program{ heap = &heap, p = prog }                  // one C file
//   let units = emit::units{ &heap, p = prog, size = 262144 }            // several
//
// Mapping (the plan's table):
//   types        each TypeId is a typedef tN. [N]T is struct { T a[N]; }, so arrays copy as values;
//                a struct is a C struct with fields m_NAME; a union or ?T is
//                struct { uint32_t tag; union { struct {...} vI; ... } p; }, except a ?*T, which
//                is the pointer itself, null being 0. Layouts are checked against the IR's with
//                _Static_assert.
//   functions    f_NAME, after the function's name (below). Slot i is lI; a `mut` param's slot
//                is a pointer, and so is a read-only struct, union or array param over BYREF
//                bytes, whose uses are (*lI) (spec §14.6). A call passes such an argument's
//                place if nothing could change it during the call, or a copy (`pass`).
//   extern fns   eN calls xN, a prototype whose assembler name is the C symbol, so that no
//                header's declaration of the symbol can clash with it. Capabilities aren't
//                passed; a `mut` field's pointer is.
//   C fn types   an extern fn{...} type is a C function pointer typedef, called directly, with
//                the same rules for capabilities and `mut` fields; a named extern fn as its
//                value is xN. A `#c::callback` fn as one is k_NAME, a C function with the type's
//                params that calls f_NAME, supplying the capabilities C doesn't pass.
//   consts       static const qN, initialized with the literals of its value.
//   C variables  vN, declared with the C symbol as its assembler name, as an extern fn is.
//   fn values    ctx_fn*: a record whose first member is the code, called with the record and
//                the function type's fields in name order (code type cN). A function's value
//                is a static record gN, code hN; a bind allocates one (struct bN); a conversion
//                to a type with more fields wraps the value in an adapter (aN).
//   expressions  C expressions. Where C's order of evaluation would differ from ctxi's (left to
//                right), operands go into temporaries _tK inside GNU statement expressions.
//                `if` and `match` expressions are statement expressions too; a branch that
//                leaves jumps out of it with return, break or continue.
//   defer        each deferred body is copied to every exit of its block, innermost first.
//   loop labels  a loop with label L (one an inner break or continue leaves) is wrapped in a
//                block with local labels: `{ __label__ _contL, _brkL; _contL: while (...) {...}
//                _brkL:; }`, so copies of it made by defer don't clash. `continue L` jumps to
//                _contL, which checks the condition again.
//   panics       ctx_panic and checked helpers in ctxrt.h, with the IR's positions. A position
//                names its file by a hash of the file's name, which the runtime looks up in the
//                file table that main passes it.
//
// Units. Each function is emitted once, into text in which the names of types, consts, C
// variables, extern fns, records, thunks and adapters are markers (MARK, a kind, the IR's id,
// END). A unit is a list of functions: its C is their text with each marker replaced by a name
// numbered in the order the unit first uses it (`rewrite`), after the declarations and
// definitions those names need. So a unit's C depends only on its own functions and what they
// use, not on what else the program has: an edit elsewhere leaves it as it was, and a build
// can keep its object. Only a function with a body and a callback have names that other units
// see, made from the function's name (`prepare`), which don't move when other code changes.
// `units` groups the functions by the file that declares them (`group`).

namespace emit {
    type Out = ir_print::Out

    const NONE: u32 = 4294967295
    // A frame slot that holds an adapter rather than a bind's record (E.slots).
    const SLOT_ADAPTER: u32 = 2147483648

    // A read-only struct, union or array param over this many bytes is passed by reference
    // (spec §14.6): a pointer to the caller's place, or to a copy (`pass`).
    const BYREF: u64 = 32

    // A marker: MARK, a kind (a letter), the IR's id in decimal, END. The C never holds these
    // bytes otherwise: strings escape them.
    const MARK: u8 = 1
    const END: u8 = 2

    union Scope { block, loop{ label: ?u32 }, deferred{ body: ir::Block } }
    union Stop { block, loop, label{ id: u32 }, function }

    // An adapter from function type `from` to `to`, emitted as aN.
    struct Pair { from: ir::TypeId, to: ir::TypeId }

    // A C function k_NAME calling function callee, of C function type ty.
    struct Callback { callee: u32, ty: ir::TypeId }

    // A function's C, with markers: its body, the bind records it makes, which go before it, and
    // the types of its expressions, whose definitions it needs whether or not it names them.
    struct Body { text: ir::Bytes, aux: ir::Bytes, uses: []u32 }

    // Names numbered within a unit, in the order it first uses them: ids[i], for the IR's id i,
    // is the unit's number + 1, or 0 if the unit hasn't used it; order holds the IR's ids by
    // the unit's numbers.
    struct Locals { ids: list::List(u32, ir::Heap), order: list::List(u32, ir::Heap) }

    struct E {
        p:        ir::Program,
        heap:     *mut ir::Heap,
        o:        Out,                              // where text goes now
        aux:      Out,                              // records, placed before the function
        f:        ir::Func,                         // the function being emitted
        temp:     u32,                              // the next _tK
        sites:    u32,                              // the next bind record
        loops:    u32,                              // the loops around what is being written
        given:    Given,                            // what takes the value being written (Records)
        stacked:  bool,                             // the function borrows records (CTX_RECORDS)
        slots:    list::List(u32, ir::Heap),        // its records in its frame, by site: SLOT_ADAPTER for an adapter's
        confined: list::List(u8, ir::Heap),         // by local: UNSEEN, CONFINED or LOOSE (confine)
        depth:    u32,                              // indentation
        scopes:   list::List(Scope, ir::Heap),
        static_init: bool,                          // writing a const's static initializer
        split:    bool,                             // several units: functions are global
        direct:   bool,                             // writing types with their unit's names
        assembling: bool,                           // writing a unit, not a function
        names:    list::List([]u8, ir::Heap),       // by function id: the C name of one with a body
        files:    list::List(u32, ir::Heap),        // by IR file: its id in positions
        thunks:   list::List(u32, ir::Heap),        // by function id: its value's type, or NONE
        adapters: list::List(Pair, ir::Heap),
        callbacks: list::List(Callback, ir::Heap),
        knames:   list::List([]u8, ir::Heap),       // by callback: its C name
        uses:     list::List(u32, ir::Heap),        // the types of the function being emitted
        used:     list::List(u32, ir::Heap),        // by type id: 1 + the last function using it
        bodies:   list::List(Body, ir::Heap),       // by function id
        entry_text: ir::Bytes,                      // int main, with the file table
        unit_of:  list::List(u32, ir::Heap),        // by function id: its unit
        unit:     u32,                              // the unit being written
        marks:    list::List(u8, ir::Heap),         // by type id, in the unit: 1 typedef'd, 2 defined
        lt: Locals, lc: Locals, lq: Locals, lv: Locals, lf: Locals,     // types, code types,
        lg: Locals, la: Locals, lk: Locals, lb: Locals,                 // consts, C variables,
                                                    // functions, thunks, adapters, callbacks, records
    }

    // The whole program as one C file.
    fn program { heap: *mut ir::Heap, p: ir::Program } -> ir::Bytes {
        let mut e = start{ heap, p }
        return whole{ &e }
    }

    // Every function, in the IR's order, and main, as one unit.
    fn whole { mut e: E } -> ir::Bytes {
        let mut fs = list::new(u32){ realloc = arena::alloc, heap = e.heap }
        let mut i: usize = 0
        while i < e.p.fns.len {
            if e.p.fns[i].symbol.len == 0 { try! list::push{ list = &fs, item = @as(u32, i) } }
            i = i + 1
        }
        return unit_text{ &e, fns = list::items{ list = fs }, entry = true, unit = 0, title = false }
    }

    // The program as units to compile apart and link, of about `size` bytes of function bodies
    // each, and a last one with `int main`. A program of less than twice that is one unit, as
    // `program` writes it.
    fn units { mut heap: ir::Heap, p: ir::Program, size: usize } -> [][]u8 {
        let mut e = start{ heap = &heap, p }
        let mut out = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut total: usize = 0
        let mut i: usize = 0
        while i < e.bodies.len {
            let b = list::items{ list = e.bodies }[i]
            total = total + b.text.len + b.aux.len
            i = i + 1
        }
        if total < size * 2 {
            try! list::push{ list = &out, item = whole{ &e } }
            return list::items{ list = out }
        }
        e.split = true
        let g = group{ &e, size }
        let mut k: usize = 0
        let mut from: usize = 0
        while k < g.ends.len {
            let to = list::items{ list = g.ends }[k]
            let fs = list::items{ list = g.fns }[from..to]
            let mut j: usize = 0
            while j < fs.len {
                list::items{ list = e.unit_of }[fs[j]] = @as(u32, k)
                j = j + 1
            }
            from = to
            k = k + 1
        }
        from = 0
        k = 0
        while k < g.ends.len {
            let to = list::items{ list = g.ends }[k]
            let text = unit_text{ &e, fns = list::items{ list = g.fns }[from..to], entry = false, unit = @as(u32, k), title = true }
            try! list::push{ list = &out, item = text }
            from = to
            k = k + 1
        }
        let none = slice::empty(u32){}
        try! list::push{ list = &out, item = unit_text{ &e, fns = none, entry = true, unit = @as(u32, k), title = true } }
        return list::items{ list = out }
    }

    // Emits every function's text, and main's, and names what other units see.
    fn start { heap: *mut ir::Heap, p: ir::Program } -> E {
        let mut e = E{
            p, heap,
            o = ir_print::out{ heap, types = p.types },
            aux = ir_print::out{ heap, types = p.types },
            f = p.fns[p.main],
            temp = 0, sites = 0, loops = 0, given = Given::other, stacked = false,
            slots = list::new(u32){ realloc = arena::alloc, heap },
            confined = list::new(u8){ realloc = arena::alloc, heap },
            depth = 0,
            scopes = list::new(Scope){ realloc = arena::alloc, heap },
            static_init = false, split = false, direct = false, assembling = false,
            names = list::new([]u8){ realloc = arena::alloc, heap },
            files = list::new(u32){ realloc = arena::alloc, heap },
            thunks = zeros{ heap, n = p.fns.len, value = NONE },
            adapters = list::new(Pair){ realloc = arena::alloc, heap },
            callbacks = list::new(Callback){ realloc = arena::alloc, heap },
            knames = list::new([]u8){ realloc = arena::alloc, heap },
            uses = list::new(u32){ realloc = arena::alloc, heap },
            used = zeros{ heap, n = p.types.len, value = 0 },
            bodies = list::new(Body){ realloc = arena::alloc, heap },
            entry_text = "",
            unit_of = zeros{ heap, n = p.fns.len, value = 0 },
            unit = 0,
            marks = list::new(u8){ realloc = arena::alloc, heap },
            lt = locals{ heap, n = 0 }, lc = locals{ heap, n = 0 }, lq = locals{ heap, n = 0 },
            lv = locals{ heap, n = 0 }, lf = locals{ heap, n = 0 }, lg = locals{ heap, n = 0 },
            la = locals{ heap, n = 0 }, lk = locals{ heap, n = 0 }, lb = locals{ heap, n = 0 },
        }
        let mut i: usize = 0
        while i < p.files.len {
            try! list::push{ list = &e.files, item = fnv32{ bytes = p.files[i] } | 2147483648 }
            i = i + 1
        }
        i = 0
        while i < p.types.len {
            try! list::push{ list = &e.marks, item = 0 }
            i = i + 1
        }
        i = 0
        while i < p.fns.len {
            let f = p.fns[i]
            e.o = ir_print::out{ heap, types = p.types }
            e.aux = ir_print::out{ heap, types = p.types }
            if f.symbol.len == 0 { function{ &e, f } }
            try! list::push{ list = &e.bodies, item = Body{ text = list::items{ list = e.o.bytes }, aux = list::items{ list = e.aux.bytes }, uses = list::items{ list = e.uses } } }
            e.uses = list::new(u32){ realloc = arena::alloc, heap }
            i = i + 1
        }
        e.o = ir_print::out{ heap, types = p.types }
        entry{ &e }
        e.entry_text = list::items{ list = e.o.bytes }
        e.o = ir_print::out{ heap, types = p.types }
        prepare{ &e }
        return e
    }

    fn zeros { heap: *mut ir::Heap, n: usize, value: u32 } -> list::List(u32, ir::Heap) {
        let mut xs = list::new(u32){ realloc = arena::alloc, heap }
        let mut i: usize = 0
        while i < n {
            try! list::push{ list = &xs, item = value }
            i = i + 1
        }
        return xs
    }

    fn locals { heap: *mut ir::Heap, n: usize } -> Locals {
        return Locals{ ids = zeros{ heap, n, value = 0 }, order = list::new(u32){ realloc = arena::alloc, heap } }
    }

    // The unit's number for IR id `id`, which it gets the first time it is asked for.
    fn number { mut l: Locals, id: u32 } -> u32 {
        let k = list::items{ list = l.ids }[id]
        if k > 0 { return k - 1 }
        try! list::push{ list = &l.order, item = id }
        list::items{ list = l.ids }[id] = @as(u32, l.order.len)
        return @as(u32, l.order.len) - 1
    }

    fn clear_locals { mut l: Locals } {
        let ids = list::items{ list = l.ids }
        let order = list::items{ list = l.order }
        let mut i: usize = 0
        while i < order.len {
            ids[order[i]] = 0
            i = i + 1
        }
        list::clear{ list = &l.order }
    }

    // Names what other units see: a function with a body is f_ and its name, where a name of
    // letters, digits, `_` and `::` (as `__`) is kept as it is, and any other, or a long one, is
    // cut and followed by a hash of the whole; a second function of the same name gets _1, and
    // so on. A callback is k_ and its function's name. Sizes the units' tables.
    fn prepare { mut e: E } {
        let heap = e.heap
        let mut taken = map::new([]u8, u32){ realloc = arena::alloc, heap, hash = map::hash_bytes, eq = slice::eq_bytes }
        let mut i: usize = 0
        while i < e.p.fns.len {
            let f = e.p.fns[i]
            let mut name: []u8 = ""
            if f.symbol.len == 0 { name = unique{ heap, &taken, base = mangle{ heap, prefix = "f_", name = f.name } } }
            try! list::push{ list = &e.names, item = name }
            i = i + 1
        }
        i = 0
        while i < e.callbacks.len {
            let c = list::items{ list = e.callbacks }[i]
            let fname = list::items{ list = e.names }[c.callee]
            let base = cat{ heap, a = "k_", b = fname[2..] }
            try! list::push{ list = &e.knames, item = unique{ heap, &taken, base } }
            i = i + 1
        }
        e.lt = locals{ heap, n = e.p.types.len }
        e.lc = locals{ heap, n = e.p.types.len }
        e.lq = locals{ heap, n = e.p.consts.len }
        e.lv = locals{ heap, n = e.p.vars.len }
        e.lf = locals{ heap, n = e.p.fns.len }
        e.lg = locals{ heap, n = e.p.fns.len }
        e.la = locals{ heap, n = e.adapters.len }
        e.lk = locals{ heap, n = e.callbacks.len }
        e.lb = locals{ heap, n = @as(usize, e.sites) }
    }

    // base, or base_N for the first N from 1 that no other name has taken.
    fn unique { heap: *mut ir::Heap, mut taken: map::Map([]u8, u32, ir::Heap), base: []u8 } -> []u8 {
        let mut name = base
        let mut n: u64 = 0
        let digits = try! alloc::resize(u8, ir::Heap){ realloc = arena::alloc, heap, mem = slice::empty(u8){}, count = 20 }
        while map::has{ m = taken, key = name } {
            n = n + 1
            name = cat{ heap, a = cat{ heap, a = base, b = "_" }, b = utf8::fmt_u64{ n, into = digits }.bytes }
        }
        try! map::put{ m = &taken, key = name, value = 0 }
        return name
    }

    fn mangle { heap: *mut ir::Heap, prefix: []u8, name: ir::Bytes } -> []u8 {
        let mut b = list::new(u8){ realloc = arena::alloc, heap }
        let mut i: usize = 0
        while i < prefix.len {
            try! list::push{ list = &b, item = prefix[i] }
            i = i + 1
        }
        let mut lossy = false
        i = 0
        while i < name.len {
            let c = name[i]
            if ascii::is_alnum{ c } or c == '_' {
                try! list::push{ list = &b, item = c }
            } else if c == ':' {
                try! list::push{ list = &b, item = '_' }
            } else {
                lossy = true
            }
            i = i + 1
        }
        if b.len > 64 {
            b.len = 64
            lossy = true
        }
        if lossy {
            try! list::push{ list = &b, item = '_' }
            let h = fnv32{ bytes = name }
            let mut k: u32 = 8
            while k > 0 {
                k = k - 1
                let d = @trunc(u8, (h >> (k * 4)) & 15)
                try! list::push{ list = &b, item = if d < 10 { '0' + d } else { 'a' + d - 10 } }
            }
        }
        return list::items{ list = b }
    }

    // FNV-1a, 32 bits: what names a file in positions (the runtime's file_id), and what tells
    // apart functions whose names `mangle` cut.
    fn fnv32 { bytes: []u8 } -> u32 {
        let mut h: u32 = 2166136261
        let mut i: usize = 0
        while i < bytes.len {
            h = @wrap_mul(h ^ @as(u32, bytes[i]), 16777619)
            i = i + 1
        }
        return h
    }

    fn cat { heap: *mut ir::Heap, a: []u8, b: []u8 } -> []u8 {
        let out = try! alloc::resize(u8, ir::Heap){ realloc = arena::alloc, heap, mem = slice::empty(u8){}, count = a.len + b.len }
        slice::copy{ dst = out[..a.len], src = a }
        slice::copy{ dst = out[a.len..], src = b }
        return out
    }

    // ---- units

    // The functions of each unit, one after another: unit k is fns[ends[k - 1]..ends[k]].
    struct Groups { fns: list::List(u32, ir::Heap), ends: list::List(usize, ir::Heap) }

    // The functions with bodies, in units of about `size` bytes: by the file that declares them,
    // in order of their files' names and then of where they are. A file of at least `size` is
    // as many units as it takes, a function going to one by a hash of its name; smaller files of
    // one directory share units, in order, as long as they stay within `size`. So an edit to one
    // file changes its own units, and only moves the files of its directory after it into other
    // units if its size crosses a boundary.
    fn group { mut e: E, size: usize } -> Groups {
        let heap = e.heap
        let mut g = Groups{ fns = list::new(u32){ realloc = arena::alloc, heap }, ends = list::new(usize){ realloc = arena::alloc, heap } }
        let mut all = list::new(u32){ realloc = arena::alloc, heap }
        let mut i: usize = 0
        while i < e.p.fns.len {
            if e.p.fns[i].symbol.len == 0 { try! list::push{ list = &all, item = @as(u32, i) } }
            i = i + 1
        }
        let fs = list::items{ list = all }
        sort{ e, xs = fs }
        let mut pack: usize = 0                     // bytes since the last unit ended
        let mut dir: []u8 = ""
        i = 0
        while i < fs.len {
            let unit = e.p.fns[fs[i]].unit
            let mut j = i
            let mut bytes: usize = 0
            while j < fs.len and slice::eq_bytes{ a = e.p.fns[fs[j]].unit, b = unit } {
                bytes = bytes + body_size{ e, f = fs[j] }
                j = j + 1
            }
            let here = parent{ path = unit }
            if pack > 0 and not slice::eq_bytes{ a = here, b = dir } { pack = end_unit{ &g } }
            dir = here
            if bytes >= size {
                if pack > 0 { pack = end_unit{ &g } }
                let parts = @as(u32, (bytes + size - 1) / size)
                let mut part: u32 = 0
                while part < parts {
                    let mut any = false
                    let mut k = i
                    while k < j {
                        if fnv32{ bytes = list::items{ list = e.names }[fs[k]] } % parts == part {
                            try! list::push{ list = &g.fns, item = fs[k] }
                            any = true
                        }
                        k = k + 1
                    }
                    if any { pack = end_unit{ &g } }
                    part = part + 1
                }
            } else {
                if pack > 0 and pack + bytes > size { pack = end_unit{ &g } }
                let mut k = i
                while k < j {
                    try! list::push{ list = &g.fns, item = fs[k] }
                    k = k + 1
                }
                pack = pack + bytes
            }
            i = j
        }
        if pack > 0 { pack = end_unit{ &g } }
        return g
    }

    fn end_unit { mut g: Groups } -> usize {
        try! list::push{ list = &g.ends, item = g.fns.len }
        return 0
    }

    fn body_size { e: E, f: u32 } -> usize {
        let b = list::items{ list = e.bodies }[f]
        return b.text.len + b.aux.len
    }

    // The directory part of a file's path: "" for a bare name.
    fn parent { path: []u8 } -> []u8 {
        let mut k = path.len
        while k > 0 {
            k = k - 1
            if path[k] == '/' or path[k] == '\\' { return path[..k] }
        }
        return path[..0]
    }

    // Sorts functions by file, then position, then C name: a merge sort, since a big program has
    // tens of thousands.
    fn sort { e: E, xs: []mut u32 } {
        let tmp = try! alloc::resize(u32, ir::Heap){ realloc = arena::alloc, heap = e.heap, mem = slice::empty(u32){}, count = xs.len }
        let mut width: usize = 1
        while width < xs.len {
            let mut lo: usize = 0
            while lo < xs.len {
                let mid = if lo + width < xs.len { lo + width } else { xs.len }
                let hi = if mid + width < xs.len { mid + width } else { xs.len }
                let mut a = lo
                let mut b = mid
                let mut k = lo
                while k < hi {
                    if a < mid and (b >= hi or not before{ e, x = xs[b], y = xs[a] }) {
                        tmp[k] = xs[a]
                        a = a + 1
                    } else {
                        tmp[k] = xs[b]
                        b = b + 1
                    }
                    k = k + 1
                }
                lo = hi
            }
            slice::copy{ dst = xs, src = tmp }
            width = width * 2
        }
    }

    fn before { e: E, x: u32, y: u32 } -> bool {
        let f = e.p.fns[x]
        let g = e.p.fns[y]
        if not slice::eq_bytes{ a = f.unit, b = g.unit } { return less{ a = f.unit, b = g.unit } }
        if f.at != g.at { return f.at < g.at }
        return less{ a = list::items{ list = e.names }[x], b = list::items{ list = e.names }[y] }
    }

    fn less { a: []u8, b: []u8 } -> bool {
        let mut i: usize = 0
        while i < a.len and i < b.len {
            if a[i] != b[i] { return a[i] < b[i] }
            i = i + 1
        }
        return a.len < b.len
    }

    // A unit's C: functions fns, and main if entry. With a title, its first line names the files
    // its functions are in.
    fn unit_text { mut e: E, fns: []u32, entry: bool, unit: u32, title: bool } -> ir::Bytes {
        let heap = e.heap
        let types = e.p.types
        clear_unit{ &e }
        e.unit = unit
        e.assembling = true
        let mut body = ir_print::out{ heap, types }
        let mut i: usize = 0
        while i < fns.len {
            let b = list::items{ list = e.bodies }[fns[i]]
            rewrite{ &e, src = b.aux, into = &body }
            rewrite{ &e, src = b.text, into = &body }
            let mut k: usize = 0
            while k < b.uses.len {
                _ = number{ l = &e.lt, id = b.uses[k] }
                k = k + 1
            }
            i = i + 1
        }
        if entry { rewrite{ &e, src = e.entry_text, into = &body } }
        // A callback is defined in its function's unit, whether that uses it or not.
        i = 0
        while e.split and i < e.callbacks.len {
            if list::items{ list = e.unit_of }[list::items{ list = e.callbacks }[i].callee] == unit {
                _ = number{ l = &e.lk, id = @as(u32, i) }
            }
            i = i + 1
        }

        // What the text uses, declared or defined, until that uses nothing new.
        let mut proto = ir_print::out{ heap, types }
        let mut defs = ir_print::out{ heap, types }
        let mut nf: usize = 0
        let mut nv: usize = 0
        let mut nq: usize = 0
        let mut ng: usize = 0
        let mut na: usize = 0
        let mut nk: usize = 0
        while true {
            list::clear{ list = &e.o.bytes }
            if nf < e.lf.order.len {
                let f = e.p.fns[list::items{ list = e.lf.order }[nf]]
                nf = nf + 1
                if f.symbol.len > 0 {
                    c_prototype{ &e, f }
                    signature{ &e, f }
                    put{ &e, a = ";\n" }
                    rewrite{ &e, src = list::items{ list = e.o.bytes }, into = &proto }
                    list::clear{ list = &e.o.bytes }
                    external{ &e, f }
                    rewrite{ &e, src = list::items{ list = e.o.bytes }, into = &defs }
                } else {
                    signature{ &e, f }
                    put{ &e, a = ";\n" }
                    rewrite{ &e, src = list::items{ list = e.o.bytes }, into = &proto }
                }
            } else if nv < e.lv.order.len {
                c_variable{ &e, id = list::items{ list = e.lv.order }[nv] }
                nv = nv + 1
                rewrite{ &e, src = list::items{ list = e.o.bytes }, into = &proto }
            } else if nq < e.lq.order.len {
                const_def{ &e, id = list::items{ list = e.lq.order }[nq] }
                nq = nq + 1
                rewrite{ &e, src = list::items{ list = e.o.bytes }, into = &defs }
            } else if ng < e.lg.order.len {
                thunk_def{ &e, callee = list::items{ list = e.lg.order }[ng] }
                ng = ng + 1
                rewrite{ &e, src = list::items{ list = e.o.bytes }, into = &defs }
            } else if na < e.la.order.len {
                adapter_def{ &e, k = list::items{ list = e.la.order }[na] }
                na = na + 1
                rewrite{ &e, src = list::items{ list = e.o.bytes }, into = &defs }
            } else if nk < e.lk.order.len {
                let k = list::items{ list = e.lk.order }[nk]
                nk = nk + 1
                callback_head{ &e, k }
                put{ &e, a = ";\n" }
                rewrite{ &e, src = list::items{ list = e.o.bytes }, into = &proto }
                let c = list::items{ list = e.callbacks }[k]
                if not e.split or list::items{ list = e.unit_of }[c.callee] == e.unit {
                    list::clear{ list = &e.o.bytes }
                    callback_def{ &e, k }
                    rewrite{ &e, src = list::items{ list = e.o.bytes }, into = &defs }
                }
            } else {
                break
            }
        }

        // The types all that uses, with their unit's names: typedefs, then definitions of those
        // it uses (and of what they hold by value), then function code types, then layout
        // checks. A type only pointed to is only typedef'd. The layouts are checked once: in the
        // only unit, or in main's, which defines every type to check it.
        let checks = not e.split or entry
        if checks {
            i = 0
            while i < e.p.types.len {
                _ = number{ l = &e.lt, id = @as(u32, i) }
                i = i + 1
            }
        }
        list::clear{ list = &e.o.bytes }
        e.direct = true
        let n = e.lt.order.len
        i = 0
        while i < n {
            typedef{ &e, id = list::items{ list = e.lt.order }[i] }
            i = i + 1
        }
        ch{ &e, c = '\n' }
        i = 0
        while i < n {
            define{ &e, id = list::items{ list = e.lt.order }[i] }
            i = i + 1
        }
        ch{ &e, c = '\n' }
        i = 0
        while i < e.lc.order.len {
            code_type{ &e, id = list::items{ list = e.lc.order }[i] }
            i = i + 1
        }
        ch{ &e, c = '\n' }
        i = 0
        while checks and i < e.lt.order.len {
            let id = list::items{ list = e.lt.order }[i]
            if mark{ e, id } == 2 { asserts{ &e, id } }
            i = i + 1
        }
        ch{ &e, c = '\n' }
        e.direct = false
        e.assembling = false
        let typed = e.o

        let mut all = ir_print::out{ heap, types }
        ir_print::text{ o = &all, a = "// Generated by ctxc" }
        if title {
            if fns.len == 0 { ir_print::text{ o = &all, a = ": the entry point" } }
            let mut last: []u8 = ""
            i = 0
            while i < fns.len {
                let u = e.p.fns[fns[i]].unit
                if i == 0 or not slice::eq_bytes{ a = u, b = last } {
                    ir_print::text{ o = &all, a = if i == 0 { " from " } else { ", " } }
                    ir_print::bytes{ o = &all, b = u }
                    last = u
                }
                i = i + 1
            }
        }
        ir_print::text{ o = &all, a = ". Compile with ctxc/rt/ctxrt.c, and ctxfloat.c if it uses floats as text.\n#include \"ctxrt.h\"\n\n" }
        ir_print::bytes{ o = &all, b = list::items{ list = typed.bytes } }
        ir_print::bytes{ o = &all, b = list::items{ list = proto.bytes } }
        ir_print::char{ o = &all, c = '\n' }
        ir_print::bytes{ o = &all, b = list::items{ list = defs.bytes } }
        ir_print::bytes{ o = &all, b = list::items{ list = body.bytes } }
        list::clear{ list = &e.o.bytes }
        return list::items{ list = all.bytes }
    }

    fn clear_unit { mut e: E } {
        let ts = list::items{ list = e.lt.order }
        let mut i: usize = 0
        while i < ts.len {
            list::items{ list = e.marks }[ts[i]] = 0
            i = i + 1
        }
        clear_locals{ l = &e.lt }
        clear_locals{ l = &e.lc }
        clear_locals{ l = &e.lq }
        clear_locals{ l = &e.lv }
        clear_locals{ l = &e.lf }
        clear_locals{ l = &e.lg }
        clear_locals{ l = &e.la }
        clear_locals{ l = &e.lk }
        clear_locals{ l = &e.lb }
    }

    // src, with each marker replaced by its name in the unit, onto `into`.
    fn rewrite { mut e: E, src: ir::Bytes, mut into: Out } {
        let mut start: usize = 0
        let mut i: usize = 0
        while i < src.len {
            if src[i] != MARK {
                i = i + 1
                continue
            }
            ir_print::bytes{ o = &into, b = src[start..i] }
            let kind = src[i + 1]
            let mut j = i + 2
            let mut id: u32 = 0
            while src[j] != END {
                id = id * 10 + @as(u32, src[j] - '0')
                j = j + 1
            }
            resolve{ &e, kind, id, &into }
            i = j + 1
            start = i
        }
        ir_print::bytes{ o = &into, b = src[start..] }
    }

    fn resolve { mut e: E, kind: u8, id: u32, mut into: Out } {
        if kind == 't' {
            local_name{ &into, c = 't', n = number{ l = &e.lt, id } }
        } else if kind == 'c' {
            _ = number{ l = &e.lc, id }
            local_name{ &into, c = 'c', n = number{ l = &e.lt, id } }
        } else if kind == 'q' {
            local_name{ &into, c = 'q', n = number{ l = &e.lq, id } }
        } else if kind == 'v' {
            local_name{ &into, c = 'v', n = number{ l = &e.lv, id } }
        } else if kind == 'f' {
            let n = number{ l = &e.lf, id }
            if e.p.fns[id].symbol.len > 0 {
                local_name{ &into, c = 'e', n }
            } else {
                ir_print::bytes{ o = &into, b = list::items{ list = e.names }[id] }
            }
        } else if kind == 'x' {
            local_name{ &into, c = 'x', n = number{ l = &e.lf, id } }
        } else if kind == 'g' {
            local_name{ &into, c = 'g', n = number{ l = &e.lg, id } }
        } else if kind == 'h' {
            local_name{ &into, c = 'h', n = number{ l = &e.lg, id } }
        } else if kind == 'a' {
            local_name{ &into, c = 'a', n = number{ l = &e.la, id } }
        } else if kind == 'k' {
            _ = number{ l = &e.lk, id }
            ir_print::bytes{ o = &into, b = list::items{ list = e.knames }[id] }
        } else if kind == 'b' {
            local_name{ &into, c = 'b', n = number{ l = &e.lb, id } }
        } else if kind == 's' {
            if not e.split { ir_print::text{ o = &into, a = "static " } }
        } else {
            @panic("emit: an unknown marker")
        }
    }

    fn local_name { mut into: Out, c: u8, n: u32 } {
        ir_print::char{ o = &into, c }
        ir_print::num{ o = &into, n }
    }

    // A marker for kind's IR id `id`.
    fn mark_id { mut e: E, kind: u8, id: u64 } {
        ch{ &e, c = MARK }
        ch{ &e, c = kind }
        num{ &e, n = id }
        ch{ &e, c = END }
    }

    // ---- types

    fn mark { e: E, id: ir::TypeId } -> u8 {
        return list::items{ list = e.marks }[id]
    }

    fn set_mark { mut e: E, id: ir::TypeId, m: u8 } {
        list::items{ list = e.marks }[id] = m
    }

    // `typedef ... tN;`, after the typedefs it refers to.
    fn typedef { mut e: E, id: ir::TypeId } {
        if mark{ e, id } >= 1 { return }
        set_mark{ &e, id, m = 1 }
        match ty{ e, id } {
            cfn{ params, ret } => {
                // typedef R (*tN)(P, ...);
                typedef{ &e, id = ret }
                let mut i = 0
                while i < params.len { typedef{ &e, id = params[i].ty }; i = i + 1 }
                put{ &e, a = "typedef " }
                tn{ &e, t = ret }
                put{ &e, a = " (*" }
                tn{ &e, t = id }
                put{ &e, a = ")(" }
                c_params{ &e, params }
                put{ &e, a = ");\n" }
                return
            }
            prim{ p } => {
                put{ &e, a = "typedef " }
                ctype{ &e, p }
            }
            ptr{ elem } => {
                typedef{ &e, id = elem }
                put{ &e, a = "typedef " }
                tn{ &e, t = elem }
                put{ &e, a = " *" }
            }
            nptr{ ptr } => {
                typedef{ &e, id = ptr }
                put{ &e, a = "typedef " }
                tn{ &e, t = ptr }
                ch{ &e, c = ' ' }
            }
            func => { put{ &e, a = "typedef ctx_fn *" } }
            void => { put{ &e, a = "typedef void " } }
            record{ untagged } => {
                put{ &e, a = if untagged { "typedef union " } else { "typedef struct " } }
                tn{ &e, t = id }
                ch{ &e, c = ' ' }
            }
            else => {
                put{ &e, a = "typedef struct " }
                tn{ &e, t = id }
                ch{ &e, c = ' ' }
            }
        }
        tn{ &e, t = id }
        put{ &e, a = ";\n" }
    }

    fn ctype { mut e: E, p: ir::Prim } {
        match p {
            i8    => { put{ &e, a = "int8_t " } }
            i16   => { put{ &e, a = "int16_t " } }
            i32   => { put{ &e, a = "int32_t " } }
            i64   => { put{ &e, a = "int64_t " } }
            u8    => { put{ &e, a = "uint8_t " } }
            u16   => { put{ &e, a = "uint16_t " } }
            u32   => { put{ &e, a = "uint32_t " } }
            u64   => { put{ &e, a = "uint64_t " } }
            usize => { put{ &e, a = "uint64_t " } }
            f32   => { put{ &e, a = "float " } }
            f64   => { put{ &e, a = "double " } }
            bool  => { put{ &e, a = "bool " } }
        }
    }

    // `struct tN { ... };` for arrays, structs, unions and capabilities, after its typedef and
    // the structs it holds by value.
    fn define { mut e: E, id: ir::TypeId } {
        if mark{ e, id } >= 2 { return }
        typedef{ &e, id }
        set_mark{ &e, id, m = 2 }
        match ty{ e, id } {
            arr{ n, elem } => {
                define{ &e, id = elem }
                struct_head{ &e, id }
                tn{ &e, t = elem }
                put{ &e, a = " a[" }
                num{ &e, n }
                put{ &e, a = "]; };\n" }
            }
            record{ fields, untagged } => {
                define_fields{ &e, fields }
                if untagged { put{ &e, a = "union " } } else { put{ &e, a = "struct " } }
                tn{ &e, t = id }
                put{ &e, a = " { " }
                members{ &e, fields }
                put{ &e, a = "};\n" }
            }
            tagged{ variants } => {
                let mut i = 0
                let mut payload = false
                while i < variants.len {
                    let fs = variants[i].fields
                    if fs != null {
                        define_fields{ &e, fields = fs }
                        payload = true
                    }
                    i = i + 1
                }
                struct_head{ &e, id }
                put{ &e, a = "uint32_t tag; " }
                if payload {
                    put{ &e, a = "union { " }
                    i = 0
                    while i < variants.len {
                        let fs = variants[i].fields
                        if fs != null {
                            put{ &e, a = "struct { " }
                            members{ &e, fields = fs }
                            put{ &e, a = "} v" }
                            num{ &e, n = i }
                            put{ &e, a = "; " }
                        }
                        i = i + 1
                    }
                    put{ &e, a = "} p; " }
                }
                put{ &e, a = "};\n" }
            }
            cap{ fields } => {
                define_fields{ &e, fields }
                struct_head{ &e, id }
                members{ &e, fields }
                put{ &e, a = "};\n" }
            }
            nptr{ ptr } => { define{ &e, id = ptr } }      // a ?c::String's struct
            else => {}
        }
    }

    // The fields of a struct, or of a capability with fields (§15), which is a struct of C
    // function pointers.
    fn struct_members { e: E, t: ir::TypeId } -> []ir::Field {
        match ty{ e, id = t } {
            record{ fields } => { return fields }
            cap{ fields } => { return fields }
            else => { @panic("emit: field of a non-struct") }
        }
    }

    // What fields of these types need: a definition of each type held by value, and a typedef
    // of each.
    fn define_fields { mut e: E, fields: []ir::Field } {
        let mut i = 0
        while i < fields.len {
            define{ &e, id = fields[i].ty }
            i = i + 1
        }
    }

    fn struct_head { mut e: E, id: ir::TypeId } {
        put{ &e, a = "struct " }
        tn{ &e, t = id }
        put{ &e, a = " { " }
    }

    fn members { mut e: E, fields: []ir::Field } {
        let mut i = 0
        while i < fields.len {
            let f = fields[i]
            tn{ &e, t = f.ty }
            put{ &e, a = " m_" }
            raw{ &e, b = f.name }
            put{ &e, a = "; " }
            i = i + 1
        }
    }

    // `typedef R (*cN)(ctx_fn *, P...);`: the code of a value of function type N.
    fn code_type { mut e: E, id: ir::TypeId } {
        let func{ params, ret } = ty{ e, id } else { @panic("emit: code of a non-function type") }
        typedef{ &e, id = ret }
        let mut j = 0
        while j < params.len {
            if not params[j].mutable { typedef{ &e, id = params[j].ty } }
            j = j + 1
        }
        put{ &e, a = "typedef " }
        tn{ &e, t = ret }
        put{ &e, a = " (*c" }
        num{ &e, n = number{ l = &e.lt, id } }
        put{ &e, a = ")(ctx_fn *" }
        j = 0
        while j < params.len {
            put{ &e, a = ", " }
            code_param{ &e, q = params[j] }
            j = j + 1
        }
        put{ &e, a = ");\n" }
    }

    // Checks the C layout against the IR's.
    fn asserts { mut e: E, id: ir::TypeId } {
        match ty{ e, id } {
            record{ size, align, fields } => {
                size_assert{ &e, id, size, align }
                let mut i = 0
                while i < fields.len {
                    let f = fields[i]
                    offset_assert{ &e, id, variant = null, f }
                    i = i + 1
                }
            }
            cap{ size, align, fields } => {
                if fields.len == 0 { return }
                size_assert{ &e, id, size, align }
                let mut i = 0
                while i < fields.len {
                    offset_assert{ &e, id, variant = null, f = fields[i] }
                    i = i + 1
                }
            }
            tagged{ size, align, variants } => {
                size_assert{ &e, id, size, align }
                let mut i = 0
                while i < variants.len {
                    let v = variants[i]
                    let fields = v.fields ifnull { i = i + 1; continue }
                    let mut j = 0
                    while j < fields.len {
                        offset_assert{ &e, id, variant = @as(u32, i), f = fields[j] }
                        j = j + 1
                    }
                    i = i + 1
                }
            }
            else => {}
        }
    }

    fn size_assert { mut e: E, id: ir::TypeId, size: u64, align: u64 } {
        put{ &e, a = "_Static_assert(sizeof(" }
        tn{ &e, t = id }
        put{ &e, a = ") == " }
        num{ &e, n = size }
        put{ &e, a = " && _Alignof(" }
        tn{ &e, t = id }
        put{ &e, a = ") == " }
        num{ &e, n = align }
        put{ &e, a = ", \"layout of " }
        tn{ &e, t = id }
        put{ &e, a = "\");\n" }
    }

    fn offset_assert { mut e: E, id: ir::TypeId, variant: ?u32, f: ir::Field } {
        put{ &e, a = "_Static_assert(offsetof(" }
        tn{ &e, t = id }
        put{ &e, a = ", " }
        if variant != null {
            put{ &e, a = "p.v" }
            num{ &e, n = variant }
            ch{ &e, c = '.' }
        }
        put{ &e, a = "m_" }
        raw{ &e, b = f.name }
        put{ &e, a = ") == " }
        num{ &e, n = f.offset }
        put{ &e, a = ", \"offset in " }
        tn{ &e, t = id }
        put{ &e, a = "\");\n" }
    }

    // A function type's field as a C parameter type: `mut` ones are void*.
    // A C function's param type: a `mut` param's pointer, or the value.
    fn param_type { mut e: E, q: ir::Param } {
        if q.mutable { put{ &e, a = "void *" } } else { tn{ &e, t = q.ty } }
    }

    // A function value's param type: a big read-only one is a pointer (§14.6).
    fn code_param { mut e: E, q: ir::Param } {
        param_type{ &e, q }
        if by_ref{ e, q } { put{ &e, a = " *" } }
    }

    // ---- functions

    //   extern R xN(P...) __asm__(CTX_SYMBOL("symbol"));
    fn c_prototype { mut e: E, f: ir::Func } {
        put{ &e, a = "extern " }
        tn{ &e, t = f.ret }
        ch{ &e, c = ' ' }
        mark_id{ &e, kind = 'x', id = f.id }
        ch{ &e, c = '(' }
        c_params{ &e, params = f.params }
        put{ &e, a = ") __asm__(CTX_SYMBOL(" }
        cstr{ &e, b = f.symbol }
        put{ &e, a = "));\n" }
    }

    //   extern T vN __asm__(CTX_SYMBOL("symbol"));
    fn c_variable { mut e: E, id: u32 } {
        let v = e.p.vars[id]
        put{ &e, a = "extern " }
        tn{ &e, t = v.ty }
        ch{ &e, c = ' ' }
        mark_id{ &e, kind = 'v', id }
        put{ &e, a = " __asm__(CTX_SYMBOL(" }
        cstr{ &e, b = v.symbol }
        put{ &e, a = "));\n" }
    }

    // A C function's parameter types: no capabilities, a `mut` one as a pointer.
    fn c_params { mut e: E, params: []ir::Param } {
        let mut first = true
        let mut i = 0
        while i < params.len {
            if not is_cap{ e, t = params[i].ty } {
                if not first { put{ &e, a = ", " } }
                param_type{ &e, q = params[i] }
                first = false
            }
            i = i + 1
        }
        if first { put{ &e, a = "void" } }
    }

    // Const N, in read-only data: its value is literals only (the checker computed it), which
    // GNU C takes as a static initializer, compound literals included.
    //   static const tT qN = VALUE;
    fn const_def { mut e: E, id: u32 } {
        let c = e.p.consts[id]
        e.temp = 0
        put{ &e, a = "// " }
        raw{ &e, b = c.name }
        put{ &e, a = "\nstatic const " }
        tn{ &e, t = c.ty }
        ch{ &e, c = ' ' }
        mark_id{ &e, kind = 'q', id }
        put{ &e, a = " = " }
        e.static_init = true
        expr{ &e, x = c.value }
        e.static_init = false
        put{ &e, a = ";\n\n" }
    }

    // `R f_NAME(P l0, ...)`, static in a program of one unit; an extern fn's `static R eN(...)`.
    fn signature { mut e: E, f: ir::Func } {
        if f.symbol.len > 0 { put{ &e, a = "static " } } else { mark_id{ &e, kind = 's', id = 0 } }
        tn{ &e, t = f.ret }
        ch{ &e, c = ' ' }
        mark_id{ &e, kind = 'f', id = f.id }
        ch{ &e, c = '(' }
        if f.params.len == 0 { put{ &e, a = "void" } }
        let mut i = 0
        while i < f.params.len {
            if i > 0 { put{ &e, a = ", " } }
            if f.symbol.len > 0 {
                param_type{ &e, q = f.params[i] }
            } else {
                tn{ &e, t = f.locals[i].ty }
                if by_ref{ e, q = f.params[i] } { put{ &e, a = " *" } }
            }
            put{ &e, a = " l" }
            num{ &e, n = i }
            i = i + 1
        }
        ch{ &e, c = ')' }
    }

    //   static R eN(...) { return xN(l0, l2); }
    // after xN's prototype (c_prototype).
    fn external { mut e: E, f: ir::Func } {
        put{ &e, a = "// " }
        raw{ &e, b = f.name }
        ch{ &e, c = '\n' }
        signature{ &e, f }
        put{ &e, a = " {\n    " }
        if not is_void{ e, t = f.ret } { put{ &e, a = "return " } }
        mark_id{ &e, kind = 'x', id = f.id }
        ch{ &e, c = '(' }
        let mut first = true
        let mut i = 0
        while i < f.params.len {
            if not is_cap{ e, t = f.params[i].ty } {
                if not first { put{ &e, a = ", " } }
                ch{ &e, c = 'l' }
                num{ &e, n = i }
                first = false
            }
            i = i + 1
        }
        put{ &e, a = ");\n}\n\n" }
    }

    fn is_cap { e: E, t: ir::TypeId } -> bool {
        return ty{ e, id = t } is cap
    }

    fn is_cfn { e: E, t: ir::TypeId } -> bool {
        return ty{ e, id = t } is cfn
    }

    // A call through a C function pointer: the callee, then the args, in C's order without the
    // capabilities.
    fn c_call { mut e: E, callee: ir::Expr, args: []ir::Arg } {
        let cfn{ params } = ty{ e, id = callee.ty } else { @panic("emit: a C call of a non-C function") }
        let kf = fresh{ &e }
        put{ &e, a = "({ " }
        declare{ &e, t = callee.ty, k = kf }
        expr{ &e, x = callee }
        put{ &e, a = "; " }
        let tt = temps_args{ &e, args }
        tmp{ &e, k = kf }
        ch{ &e, c = '(' }
        let mut first = true
        let mut j = 0
        while j < params.len {
            if not is_cap{ e, t = params[j].ty } {
                if not first { put{ &e, a = ", " } }
                first = false
                let mut i = 0
                while i < args.len {
                    if args[i].index == j { operand{ &e, x = args[i].value, tt, i = @as(u32, i) } }
                    i = i + 1
                }
            }
            j = j + 1
        }
        ch{ &e, c = ')' }
        close_temps{ &e, tt }
        put{ &e, a = "; })" }
    }

    fn function { mut e: E, f: ir::Func } {
        e.f = f
        e.temp = 0
        put{ &e, a = "// " }
        raw{ &e, b = f.name }
        ch{ &e, c = '\n' }
        signature{ &e, f }
        put{ &e, a = " {" }
        e.depth = 1
        let mut i = f.params.len
        while i < f.locals.len {
            nl{ &e }
            tn{ &e, t = f.locals[i].ty }
            put{ &e, a = " l" }
            num{ &e, n = i }
            ch{ &e, c = ';' }
            i = i + 1
        }
        nl{ &e }
        put{ &e, a = "CTX_STACK_CHECK();" }
        // The body goes into a buffer first: its records' slots, and whether it borrows any,
        // go before it.
        confine{ &e, f }
        e.loops = 0
        e.given = Given::other
        e.stacked = false
        list::clear{ list = &e.slots }
        let head = e.o
        e.o = ir_print::out{ heap = e.heap, types = e.p.types }
        nl{ &e }
        block{ &e, b = f.body }
        let body = list::items{ list = e.o.bytes }
        e.o = head
        let slots = list::items{ list = e.slots }
        i = 0
        while i < slots.len {
            nl{ &e }
            let adapter = slots[i] >= SLOT_ADAPTER
            let k = if adapter { slots[i] - SLOT_ADAPTER } else { slots[i] }
            if adapter {
                put{ &e, a = "ctx_adapter" }
            } else {
                put{ &e, a = "struct " }
                mark_id{ &e, kind = 'b', id = k }
            }
            put{ &e, a = " _r" }
            num{ &e, n = k }
            ch{ &e, c = ';' }
            i = i + 1
        }
        if e.stacked {
            nl{ &e }
            put{ &e, a = "CTX_RECORDS;" }
        }
        raw{ &e, b = body }
        if not is_void{ e, t = f.ret } {
            nl{ &e }
            put{ &e, a = "__builtin_unreachable();" }
        }
        e.depth = 0
        put{ &e, a = "\n}\n\n" }
    }

    // The file table, and `int main` (spec §15, Entry point). It gives the runtime the file
    // table and the `#panic` fn (ctx_on_panic), then calls the `#start` fn with C's argc and
    // argv and main as a function value (ctx_main_value), which supplies main's capabilities and
    // returns its exit code. Without a start fn, it calls main itself, with no args; without a
    // panic fn, a panic stops the program at once (ctxrt.c, `report`).
    fn entry { mut e: E } {
        let f = e.p.fns[e.p.main]
        put{ &e, a = "static const char *const ctx_file_table[] = {" }
        let mut i = 0
        while i < e.p.files.len {
            cstr{ &e, b = e.p.files[i] }
            put{ &e, a = ", " }
            i = i + 1
        }
        put{ &e, a = "\"\" };\n\n" }
        if e.p.panic != NONE {
            let h = e.p.fns[e.p.panic]
            put{ &e, a = "static void ctx_on_panic(ctx_slice msg, ctx_slice file, uint32_t line, uint32_t col) {\n    static char cap[1];\n    " }
            mark_id{ &e, kind = 'f', id = h.id }
            ch{ &e, c = '(' }
            supply{ &e, f = h }
            put{ &e, a = ");\n}\n\n" }
        }
        if e.p.start == NONE {
            put{ &e, a = "int main(int argc, char **argv) {\n" }
            begin{ &e }
            put{ &e, a = "    static char cap[1];\n    " }
            if is_void{ e, t = f.ret } {
                call_main{ &e, f, args = "" }
                put{ &e, a = ";\n    return 0;\n}\n" }
            } else {
                put{ &e, a = "return " }
                call_main{ &e, f, args = "" }
                put{ &e, a = ";\n}\n" }
            }
            return
        }
        let s = e.p.fns[e.p.start]
        let run = param_type_of{ e, f = s, name = "main" }
        if run != NONE {
            let func{ params, ret } = ty{ e, id = run } else { @panic("emit: a start fn's main isn't a function") }
            put{ &e, a = "static " }
            tn{ &e, t = ret }
            put{ &e, a = " ctx_main_code(ctx_fn *self, " }
            code_param{ &e, q = params[0] }
            put{ &e, a = " args) {\n    static char cap[1];\n    (void)self;\n    " }
            if is_void{ e, t = f.ret } {
                call_main{ &e, f, args = "args" }
                put{ &e, a = ";\n    return 0;\n}\n" }
            } else {
                put{ &e, a = "return " }
                call_main{ &e, f, args = "args" }
                put{ &e, a = ";\n}\n" }
            }
            put{ &e, a = "static ctx_fn ctx_main_value = { (void (*)(void))ctx_main_code };\n\n" }
        }
        put{ &e, a = "int main(int argc, char **argv) {\n" }
        begin{ &e }
        put{ &e, a = "    static char cap[1];\n    return " }
        mark_id{ &e, kind = 'f', id = s.id }
        ch{ &e, c = '(' }
        supply{ &e, f = s }
        put{ &e, a = ");\n}\n" }
    }

    // `ctx_start(...)`: the file table and the panic fn, for the runtime's panics.
    fn begin { mut e: E } {
        put{ &e, a = "    ctx_start(ctx_file_table, " }
        num{ &e, n = e.p.files.len }
        put{ &e, a = ", CTX_PROGRAM_NAME, " }
        put{ &e, a = if e.p.panic != NONE { "ctx_on_panic" } else { "0" } }
        put{ &e, a = ");\n" }
    }

    // `f_main(...)`: main's capabilities, and its args from the C expression `args`, or none
    // if that is empty.
    fn call_main { mut e: E, f: ir::Func, args: []u8 } {
        mark_id{ &e, kind = 'f', id = f.id }
        ch{ &e, c = '(' }
        let mut i = 0
        while i < f.params.len {
            if i > 0 { put{ &e, a = ", " } }
            let q = f.params[i]
            if q.mutable {
                put{ &e, a = "(void *)cap" }
            } else if slice::eq_bytes{ a = q.name, b = "args" } {
                if args.len == 0 {
                    ch{ &e, c = '(' }
                    tn{ &e, t = q.ty }
                    put{ &e, a = "){0}" }
                } else {
                    put{ &e, a = "CTX_BITCAST(" }
                    tn{ &e, t = q.ty }
                    put{ &e, a = ", " }
                    put{ &e, a = args }
                    ch{ &e, c = ')' }
                }
            } else {
                ch{ &e, c = '(' }
                tn{ &e, t = q.ty }
                put{ &e, a = "){}" }
            }
            i = i + 1
        }
        ch{ &e, c = ')' }
    }

    // The arguments of a `#start` or `#panic` fn f, which the checker allows (check::hook_field):
    // its capabilities, and each other field from the C variable of its name, converted to the
    // field's C type, and `main` as ctx_main_value.
    fn supply { mut e: E, f: ir::Func } {
        let mut i = 0
        while i < f.params.len {
            if i > 0 { put{ &e, a = ", " } }
            let q = f.params[i]
            if q.mutable {
                put{ &e, a = "(void *)cap" }
            } else if is_cap{ e, t = q.ty } {
                ch{ &e, c = '(' }
                tn{ &e, t = q.ty }
                put{ &e, a = "){}" }
            } else if slice::eq_bytes{ a = q.name, b = "main" } {
                put{ &e, a = "&ctx_main_value" }
            } else {
                put{ &e, a = "CTX_BITCAST(" }
                tn{ &e, t = q.ty }
                put{ &e, a = ", " }
                raw{ &e, b = q.name }
                ch{ &e, c = ')' }
            }
            i = i + 1
        }
    }

    // The type of f's param `name`, or NONE without one.
    fn param_type_of { e: E, f: ir::Func, name: []u8 } -> ir::TypeId {
        let mut i = 0
        while i < f.params.len {
            if slice::eq_bytes{ a = f.params[i].name, b = name } { return f.params[i].ty }
            i = i + 1
        }
        return NONE
    }

    // ---- statements

    // `{ ... }`: the statements, then the block's deferred bodies.
    fn block { mut e: E, b: ir::Block } {
        ch{ &e, c = '{' }
        open_block{ &e }
        let mut i = 0
        while i < b.stmts.len {
            nl{ &e }
            stmt{ &e, s = b.stmts[i] }
            i = i + 1
        }
        close_block{ &e }
        ch{ &e, c = '}' }
    }

    // A branch of an `if` or `match` expression: like block, with its value into _tRES.
    fn value_block { mut e: E, b: ir::Block, res: u32 } {
        ch{ &e, c = '{' }
        open_block{ &e }
        let mut i = 0
        while i < b.stmts.len {
            nl{ &e }
            stmt{ &e, s = b.stmts[i] }
            i = i + 1
        }
        if b.result != null {
            nl{ &e }
            tmp{ &e, k = res }
            put{ &e, a = " = " }
            expr{ &e, x = b.result.* }
            ch{ &e, c = ';' }
        }
        close_block{ &e }
        ch{ &e, c = '}' }
    }

    fn open_block { mut e: E } {
        e.depth = e.depth + 1
        push_scope{ &e, s = Scope::block }
    }

    fn close_block { mut e: E } {
        defers{ &e, stop = Stop::block }
        while true {
            let s = list::pop{ list = &e.scopes } ifnull { break }
            let block = s else { continue }
            break
        }
        e.depth = e.depth - 1
        nl{ &e }
    }

    fn push_scope { mut e: E, s: Scope } {
        try! list::push{ list = &e.scopes, item = s }
    }

    // The deferred bodies between here and the nearest `stop`, innermost first.
    fn defers { mut e: E, stop: Stop } {
        let mut i = e.scopes.len
        while i > 0 {
            i = i - 1
            let s = list::items{ list = e.scopes }[i]
            match s {
                deferred{ body } => {
                    nl{ &e }
                    block{ &e, b = body }
                }
                block => { match stop { block => { return } else => {} } }
                loop{ label } => {
                    match stop {
                        loop => { return }
                        label{ id } => { if label != null and label == id { return } }
                        else => {}
                    }
                }
            }
        }
    }

    // break or continue: to the innermost loop, or to the loop with `label` through a goto.
    fn jump { mut e: E, label: ?u32, word: []u8, target: []u8 } {
        if label == null {
            defers{ &e, stop = Stop::loop }
            put{ &e, a = " " }
            put{ &e, a = word }
            put{ &e, a = ";" }
            return
        }
        defers{ &e, stop = Stop::label{ id = label } }
        put{ &e, a = " goto " }
        put{ &e, a = target }
        num{ &e, n = label }
        put{ &e, a = ";" }
    }

    fn has_defers { e: E, stop: Stop } -> bool {
        let mut i = e.scopes.len
        while i > 0 {
            i = i - 1
            match list::items{ list = e.scopes }[i] {
                deferred => { return true }
                block    => { match stop { block => { return false } else => {} } }
                loop     => { match stop { loop | label => { return false } else => {} } }
            }
        }
        return false
    }

    fn stmt { mut e: E, s: ir::Stmt } {
        match s {
            define{ slot, init } => {
                target{ &e, slot }
                put{ &e, a = " = " }
                if list::items{ list = e.confined }[slot] == CONFINED { e.given = Given::local }
                expr{ &e, x = init }
                ch{ &e, c = ';' }
            }
            zero{ slot } => {
                put{ &e, a = "memset(&" }
                target{ &e, slot }
                put{ &e, a = ", 0, sizeof " }
                target{ &e, slot }
                put{ &e, a = ");" }
            }
            assign{ place, value } => {
                // ctxi computes the value, then the place.
                if pure{ e, x = value } or fixed_place{ x = place } {
                    expr{ &e, x = place }
                    put{ &e, a = " = " }
                    expr{ &e, x = value }
                    ch{ &e, c = ';' }
                } else {
                    let k = fresh{ &e }
                    put{ &e, a = "{ " }
                    declare{ &e, t = value.ty, k }
                    expr{ &e, x = value }
                    put{ &e, a = "; " }
                    expr{ &e, x = place }
                    put{ &e, a = " = " }
                    tmp{ &e, k }
                    put{ &e, a = "; }" }
                }
            }
            eval{ e = x } => {
                if not is_void{ e, t = x.ty } { put{ &e, a = "(void)" } }
                expr{ &e, x }
                ch{ &e, c = ';' }
            }
            cond{ c, then, els } => {
                put{ &e, a = "if (" }
                expr{ &e, x = c }
                put{ &e, a = ") " }
                block{ &e, b = then }
                if els != null {
                    put{ &e, a = " else " }
                    block{ &e, b = els }
                }
            }
            loop{ c, body, label } => {
                if label != null {
                    put{ &e, a = "{ __label__ _cont" }
                    num{ &e, n = label }
                    put{ &e, a = ", _brk" }
                    num{ &e, n = label }
                    put{ &e, a = "; _cont" }
                    num{ &e, n = label }
                    put{ &e, a = ": " }
                }
                put{ &e, a = "while (" }
                e.loops = e.loops + 1
                expr{ &e, x = c }
                put{ &e, a = ") " }
                push_scope{ &e, s = Scope::loop{ label } }
                block{ &e, b = body }
                _ = list::pop{ list = &e.scopes }
                e.loops = e.loops - 1
                if label != null {
                    put{ &e, a = " _brk" }
                    num{ &e, n = label }
                    put{ &e, a = ":; }" }
                }
            }
            brk{ label } => { jump{ &e, label, word = "break", target = "_brk" } }
            cont{ label } => { jump{ &e, label, word = "continue", target = "_cont" } }
            ret{ value } => { ret{ &e, value } }
            deferred{ body } => {
                push_scope{ &e, s = Scope::deferred{ body } }
                put{ &e, a = "/* defer */" }
            }
            panic{ pos, msg } => {
                put{ &e, a = "ctx_panic(" }
                position{ &e, p = pos }
                put{ &e, a = ", " }
                cstr{ &e, b = msg }
                put{ &e, a = ");" }
            }
            choose{ scrut, through, arms } => {
                let k = fresh{ &e }
                let union_t = union_type{ e, t = scrut.ty, through }
                use{ &e, t = union_t }
                put{ &e, a = "{ " }
                declare{ &e, t = scrut.ty, k }
                expr{ &e, x = scrut }
                put{ &e, a = ";" }
                arm_chain{ &e, arms, k, through, union_t, res = null }
                put{ &e, a = " }" }
            }
            switch{ scrut, cases } => {
                let k = fresh{ &e }
                put{ &e, a = "{ " }
                declare{ &e, t = scrut.ty, k }
                expr{ &e, x = scrut }
                put{ &e, a = ";" }
                case_chain{ &e, cases, k, t = scrut.ty, res = null }
                put{ &e, a = " }" }
            }
            let_else{ init, variant, binds, els_variant, els_binds, els } => {
                let k = fresh{ &e }
                let u = init.ty
                put{ &e, a = "{ " }
                declare{ &e, t = u, k }
                expr{ &e, x = init }
                put{ &e, a = "; if (!" }
                tag_is{ &e, k, through = false, union_t = u, variant }
                put{ &e, a = ") { " }
                if els_variant != null {
                    bind_all{ &e, binds = els_binds, k, through = false, union_t = u, variant = els_variant }
                }
                block{ &e, b = els }
                put{ &e, a = " } " }
                bind_all{ &e, binds, k, through = false, union_t = u, variant }
                ch{ &e, c = '}' }
            }
        }
    }

    // `return`: the value into a temporary, then every deferred body, then return.
    fn ret { mut e: E, value: ?ir::Expr } {
        let deferred = has_defers{ e, stop = Stop::function }
        let v = value ifnull {
            if deferred {
                ch{ &e, c = '{' }
                defers{ &e, stop = Stop::function }
                put{ &e, a = " return; }" }
            } else {
                put{ &e, a = "return;" }
            }
            return
        }
        if not deferred {
            put{ &e, a = "return " }
            expr{ &e, x = v }
            ch{ &e, c = ';' }
            return
        }
        let k = fresh{ &e }
        put{ &e, a = "{ " }
        declare{ &e, t = v.ty, k }
        expr{ &e, x = v }
        ch{ &e, c = ';' }
        defers{ &e, stop = Stop::function }
        put{ &e, a = " return " }
        tmp{ &e, k }
        put{ &e, a = "; }" }
    }

    // The arms of a match on _tK: an if-else chain, since `break` inside a C switch would leave
    // the switch, not the loop. With res, each arm is a value block into _tRES.
    fn arm_chain { mut e: E, arms: []ir::Arm, k: u32, through: bool, union_t: ir::TypeId, res: ?u32 } {
        let mut i = 0
        while i < arms.len {
            let a = arms[i]
            ch{ &e, c = ' ' }
            if i > 0 { put{ &e, a = "else " } }
            if a.pats.len > 0 {
                put{ &e, a = "if (" }
                let mut j = 0
                while j < a.pats.len {
                    if j > 0 { put{ &e, a = " || " } }
                    tag_is{ &e, k, through, union_t, variant = a.pats[j].variant }
                    j = j + 1
                }
                put{ &e, a = ") " }
            }
            arm_body{ &e, a, k, through, union_t, res }
            i = i + 1
        }
    }

    // The cases of a switch on _tK, of integer type t: an if-else chain, as for a match.
    fn case_chain { mut e: E, cases: []ir::Case, k: u32, t: ir::TypeId, res: ?u32 } {
        let mut i: usize = 0
        while i < cases.len {
            let c = cases[i]
            ch{ &e, c = ' ' }
            if i > 0 { put{ &e, a = "else " } }
            if c.values.len > 0 or c.ranges.len > 0 {
                put{ &e, a = "if (" }
                let mut j: usize = 0
                while j < c.values.len {
                    if j > 0 { put{ &e, a = " || " } }
                    tmp{ &e, k }
                    put{ &e, a = " == " }
                    int_lit{ &e, t, n = c.values[j] }
                    j = j + 1
                }
                j = 0
                while j < c.ranges.len {
                    if j > 0 or c.values.len > 0 { put{ &e, a = " || " } }
                    put{ &e, a = "(" }
                    tmp{ &e, k }
                    put{ &e, a = " >= " }
                    int_lit{ &e, t, n = c.ranges[j].lo }
                    put{ &e, a = " && " }
                    tmp{ &e, k }
                    put{ &e, a = " <= " }
                    int_lit{ &e, t, n = c.ranges[j].hi }
                    put{ &e, a = ")" }
                    j = j + 1
                }
                put{ &e, a = ") " }
            }
            put{ &e, a = "{ " }
            match res {
                null          => { block{ &e, b = c.body } }
                some{ value } => { value_block{ &e, b = c.body, res = value } }
            }
            put{ &e, a = " }" }
            i = i + 1
        }
    }

    // An integer literal of type t.
    fn int_lit { mut e: E, t: ir::TypeId, n: ir::Int } {
        cast_open{ &e, t }
        if n.negative {
            put{ &e, a = "(-(int64_t)" }
            num{ &e, n = n.value - 1 }
            put{ &e, a = "LL - 1)" }
        } else {
            num{ &e, n = n.value }
            put{ &e, a = "ULL" }
        }
        put{ &e, a = "))" }
    }

    // `(_tK.tag == V)`, or for a ?*T `(_tK == 0)` or `(_tK != 0)`
    fn tag_is { mut e: E, k: u32, through: bool, union_t: ir::TypeId, variant: u32 } {
        ch{ &e, c = '(' }
        if is_nptr{ e, t = union_t } {
            if through { put{ &e, a = "(*" } }
            tmp{ &e, k }
            if through { ch{ &e, c = ')' } }
            nptr_member{ &e, t = union_t }
            put{ &e, a = if variant == 0 { " == 0)" } else { " != 0)" } }
            return
        }
        tmp{ &e, k }
        if through { put{ &e, a = "->tag == " } } else { put{ &e, a = ".tag == " } }
        num{ &e, n = variant }
        ch{ &e, c = ')' }
    }

    fn is_nptr { e: E, t: ir::TypeId } -> bool {
        return ty{ e, id = t } is nptr
    }

    // Whether t is a nullable pointer whose payload is a struct around the pointer (a
    // ?c::String) rather than the pointer itself.
    fn nptr_record { e: E, t: ir::TypeId } -> bool {
        let nptr{ ptr } = ty{ e, id = t } else { return false }
        return ty{ e, id = ptr } is record
    }

    // `.m_NAME`, the pointer inside a ?c::String's struct; nothing for a ?*T.
    fn nptr_member { mut e: E, t: ir::TypeId } {
        let nptr{ ptr } = ty{ e, id = t } else { return }
        if ty{ e, id = ptr } is record{ fields } {
            put{ &e, a = ".m_" }
            raw{ &e, b = fields[0].name }
        }
    }

    // With several patterns, the bindings depend on which one matched.
    fn arm_body { mut e: E, a: ir::Arm, k: u32, through: bool, union_t: ir::TypeId, res: ?u32 } {
        put{ &e, a = "{ " }
        if a.pats.len == 1 {
            let p = a.pats[0]
            bind_all{ &e, binds = p.binds, k, through, union_t, variant = p.variant }
        } else if a.pats.len > 1 and a.pats[0].binds.len > 0 {
            let mut j = 0
            while j < a.pats.len {
                let p = a.pats[j]
                if j > 0 { put{ &e, a = "else " } }
                put{ &e, a = "if (" }
                tag_is{ &e, k, through, union_t, variant = p.variant }
                put{ &e, a = ") { " }
                bind_all{ &e, binds = p.binds, k, through, union_t, variant = p.variant }
                put{ &e, a = "} " }
                j = j + 1
            }
        }
        match res {
            null          => { block{ &e, b = a.body } }
            some{ value } => { value_block{ &e, b = a.body, res = value } }
        }
        put{ &e, a = " }" }
    }

    // Each binding's slot gets its field of variant `variant` of _tK, or the field's address.
    fn bind_all { mut e: E, binds: []ir::Bind, k: u32, through: bool, union_t: ir::TypeId, variant: u32 } {
        let mut i = 0
        while i < binds.len {
            let b = binds[i]
            target{ &e, slot = b.slot }
            put{ &e, a = " = " }
            if b.by_ref { ch{ &e, c = '&' } }
            if is_nptr{ e, t = union_t } {
                // the payload is the pointer itself
                if through { put{ &e, a = "(*" } }
                tmp{ &e, k }
                if through { ch{ &e, c = ')' } }
            } else {
                tmp{ &e, k }
                if through { put{ &e, a = "->" } } else { ch{ &e, c = '.' } }
                payload_member{ &e, union_t, variant, field = b.field }
            }
            put{ &e, a = "; " }
            i = i + 1
        }
    }

    // `p.vV.m_NAME`
    fn payload_member { mut e: E, union_t: ir::TypeId, variant: u32, field: u32 } {
        put{ &e, a = "p.v" }
        num{ &e, n = variant }
        put{ &e, a = ".m_" }
        let tagged{ variants } = ty{ e, id = union_t } else { @panic("emit: payload of a non-union") }
        let fields = variants[variant].fields ifnull { @panic("emit: variant has no payload") }
        raw{ &e, b = fields[field].name }
    }

    // The union a match scrutinee of type t holds, through a pointer if `through`.
    fn union_type { e: E, t: ir::TypeId, through: bool } -> ir::TypeId {
        if not through { return t }
        let ptr{ elem } = ty{ e, id = t } else { @panic("emit: match through a non-pointer") }
        return elem
    }

    // ---- expressions

    fn expr { mut e: E, x: ir::Expr } {
        use{ &e, t = x.ty }
        let given = e.given
        e.given = Given::other
        match x.k {
            int{ negative, value } => { int_lit{ &e, t = x.ty, n = ir::Int{ negative, value } } }
            float{ value } => {
                cast_open{ &e, t = x.ty }
                // A const's value may be infinite or NaN, which C spells with math.h's macros.
                if value != value {
                    put{ &e, a = "NAN" }
                } else if value > 1.7976931348623157e308 {
                    put{ &e, a = "INFINITY" }
                } else if value < -1.7976931348623157e308 {
                    put{ &e, a = "(-INFINITY)" }
                } else {
                    let mut buf: [32]u8
                    raw{ &e, b = utf8::fmt_f64{ n = value, into = buf[..] }.bytes }
                }
                put{ &e, a = "))" }
            }
            boolean{ value } => {
                if value { put{ &e, a = "((bool)1)" } } else { put{ &e, a = "((bool)0)" } }
            }
            str{ bytes } => {
                compound{ &e, t = x.ty }
                if bytes.len > 0 {
                    put{ &e, a = "{ " }
                    cstr{ &e, b = bytes }
                    put{ &e, a = " }" }
                }
                put{ &e, a = "})" }
            }
            cstr{ bytes } => {
                // A C string literal: static storage, with C's NUL after the bytes.
                cast_open{ &e, t = x.ty }
                cstr{ &e, b = bytes }
                put{ &e, a = "))" }
            }
            sbytes{ bytes } => {
                // A C string literal has static storage; its terminator isn't part of the view.
                compound{ &e, t = x.ty }
                put{ &e, a = " .m_ptr = (void *)" }
                cstr{ &e, b = bytes }
                put{ &e, a = ", .m_len = " }
                num{ &e, n = bytes.len }
                put{ &e, a = " })" }
            }
            nil => {
                if is_nptr{ e, t = x.ty } and not nptr_record{ e, t = x.ty } {
                    cast_open{ &e, t = x.ty }
                    put{ &e, a = "0))" }
                } else {
                    compound{ &e, t = x.ty }
                    put{ &e, a = "0})" }
                }
            }
            local{ slot } => { local{ &e, slot } }
            constref{ id } => { mark_id{ &e, kind = 'q', id } }
            cvar{ id } => { mark_id{ &e, kind = 'v', id } }
            deref{ ptr } => {
                put{ &e, a = "(*" }
                expr{ &e, x = ptr.* }
                ch{ &e, c = ')' }
            }
            field{ base, index } => {
                ch{ &e, c = '(' }
                expr{ &e, x = base.* }
                put{ &e, a = ").m_" }
                raw{ &e, b = struct_members{ e, t = base.ty }[index].name }
            }
            index{ base, i, pos } => { index{ &e, base = base.*, i = i.*, pos } }
            sindex{ base, i, pos } => { sindex{ &e, base = base.*, i = i.*, pos } }
            ssub{ base, lo, hi, pos } => { ssub{ &e, t = x.ty, base = base.*, lo = lo.*, hi, pos } }
            payload{ base, variant, field } => {
                ch{ &e, c = '(' }
                expr{ &e, x = base.* }
                if is_nptr{ e, t = base.ty } {
                    ch{ &e, c = ')' }
                } else {
                    put{ &e, a = ")." }
                    payload_member{ &e, union_t = base.ty, variant, field }
                }
            }
            addr{ place } => {
                put{ &e, a = "(&" }
                expr{ &e, x = place.* }
                ch{ &e, c = ')' }
            }
            seq{ first, then } => {
                put{ &e, a = "({ (void)(" }
                expr{ &e, x = first.* }
                put{ &e, a = "); " }
                expr{ &e, x = then.* }
                put{ &e, a = "; })" }
            }
            with{ slot, init, body } => {
                put{ &e, a = "({ " }
                target{ &e, slot }
                put{ &e, a = " = " }
                expr{ &e, x = init.* }
                put{ &e, a = "; " }
                expr{ &e, x = body.* }
                put{ &e, a = "; })" }
            }
            neg{ e = a, pos } => {
                let p = prim_of{ e, t = x.ty } ifnull { @panic("emit: neg of a non-number") }
                if is_float{ p } {
                    put{ &e, a = "(-(" }
                    expr{ &e, x = a.* }
                    put{ &e, a = "))" }
                } else {
                    put{ &e, a = "ctx_neg_" }
                    suffix{ &e, p }
                    ch{ &e, c = '(' }
                    expr{ &e, x = a.* }
                    put{ &e, a = ", " }
                    position{ &e, p = pos }
                    ch{ &e, c = ')' }
                }
            }
            lnot{ e = a } => {
                put{ &e, a = "(!" }
                expr{ &e, x = a.* }
                ch{ &e, c = ')' }
            }
            // C's && and || already go left to right, and must not evaluate b early.
            land{ a, b } => { logical{ &e, a = a.*, op = " && ", b = b.* } }
            lor{ a, b }  => { logical{ &e, a = a.*, op = " || ", b = b.* } }
            arith{ op, a, b, pos } => { arith{ &e, t = x.ty, op, a = a.*, b = b.*, pos } }
            bits{ op, a, b } => {
                cast_open{ &e, t = x.ty }
                match op {
                    bit_and => { infix{ &e, a = a.*, op = " & ", b = b.* } }
                    bit_or  => { infix{ &e, a = a.*, op = " | ", b = b.* } }
                    bit_xor => { infix{ &e, a = a.*, op = " ^ ", b = b.* } }
                }
                put{ &e, a = "))" }
            }
            shift{ op, a, b, pos } => { shift{ &e, t = x.ty, op, a = a.*, b = b.*, pos } }
            cmp{ op, a, b } => {
                let text = match op {
                    eq => { 0 } ne => { 1 } lt => { 2 } le => { 3 } gt => { 4 } ge => { 5 }
                }
                if text == 0 { infix{ &e, a = a.*, op = " == ", b = b.* } }
                if text == 1 { infix{ &e, a = a.*, op = " != ", b = b.* } }
                if text == 2 { infix{ &e, a = a.*, op = " < ", b = b.* } }
                if text == 3 { infix{ &e, a = a.*, op = " <= ", b = b.* } }
                if text == 4 { infix{ &e, a = a.*, op = " > ", b = b.* } }
                if text == 5 { infix{ &e, a = a.*, op = " >= ", b = b.* } }
            }
            ptradd{ p, n } => {
                // C's pointer arithmetic needs the type pointed to.
                if ty{ e, id = x.ty } is ptr{ elem } { use{ &e, t = elem } }
                infix{ &e, a = p.*, op = " + ", b = n.* }
            }
            isnull{ e = a } => {
                put{ &e, a = "((" }
                expr{ &e, x = a.* }
                ch{ &e, c = ')' }
                nptr_member{ &e, t = a.ty }
                put{ &e, a = if is_nptr{ e, t = a.ty } { " == 0)" } else { ".tag == 0)" } }
            }
            notnull{ e = a } => {
                put{ &e, a = "((" }
                expr{ &e, x = a.* }
                ch{ &e, c = ')' }
                nptr_member{ &e, t = a.ty }
                put{ &e, a = if is_nptr{ e, t = a.ty } { " != 0)" } else { ".tag != 0)" } }
            }
            widen{ e = a } => { convert_to{ &e, t = x.ty, a = a.* } }
            trunc{ e = a } => { convert_to{ &e, t = x.ty, a = a.* } }
            cast{ e = a }  => { convert_to{ &e, t = x.ty, a = a.* } }
            ptraddr{ e = a } => {
                put{ &e, a = "((uint64_t)(uintptr_t)(" }
                expr{ &e, x = a.* }
                put{ &e, a = "))" }
            }
            some{ e = a } => {
                if nptr_record{ e, t = x.ty } {
                    expr{ &e, x = a.* }                     // the same struct, under a typedef
                } else if is_nptr{ e, t = x.ty } {
                    convert_to{ &e, t = x.ty, a = a.* }
                } else {
                    compound{ &e, t = x.ty }
                    put{ &e, a = " .tag = 1, .p.v1.m_value = " }
                    expr{ &e, x = a.* }
                    put{ &e, a = " })" }
                }
            }
            fnconv{ e = a } => { fnconv{ &e, to = x.ty, a = a.*, given } }
            call{ callee, args } => { call{ &e, callee, args } }
            dcall{ callee, args } => { dcall{ &e, callee = callee.*, args } }
            bind{ callee, args } => { bind{ &e, t = x.ty, callee, args, given } }
            dbind{ callee, args } => { dbind{ &e, t = x.ty, callee = callee.*, args, given } }
            fnref{ callee } => {
                if is_cfn{ e, t = x.ty } {
                    if e.p.fns[callee].symbol.len > 0 {
                        mark_id{ &e, kind = 'x', id = callee }      // a named extern fn as a C function pointer
                    } else {
                        let k = callback{ &e, callee, t = x.ty }
                        mark_id{ &e, kind = 'k', id = k }           // a callback: the C function calling it
                    }
                    return
                }
                thunk{ &e, callee, t = x.ty }
                put{ &e, a = "(&" }
                mark_id{ &e, kind = 'g', id = callee }
                ch{ &e, c = ')' }
            }
            record{ items } => { literal{ &e, t = x.ty, variant = null, items } }
            variant{ index, items } => { literal{ &e, t = x.ty, variant = index, items } }
            array{ elems } => { array{ &e, t = x.ty, elems } }
            repeat{ elem } => { repeat{ &e, t = x.ty, elem = elem.* } }
            ifx{ c, then, els } => {
                let res = fresh{ &e }
                put{ &e, a = "({ " }
                result_var{ &e, t = x.ty, k = res }
                put{ &e, a = "if (" }
                expr{ &e, x = c.* }
                put{ &e, a = ") " }
                value_block{ &e, b = then, res }
                put{ &e, a = " else " }
                value_block{ &e, b = els, res }
                ch{ &e, c = ' ' }
                tmp{ &e, k = res }
                put{ &e, a = "; })" }
            }
            matchx{ scrut, through, arms } => {
                let res = fresh{ &e }
                let k = fresh{ &e }
                let union_t = union_type{ e, t = scrut.ty, through }
                use{ &e, t = union_t }
                put{ &e, a = "({ " }
                result_var{ &e, t = x.ty, k = res }
                declare{ &e, t = scrut.ty, k }
                expr{ &e, x = scrut.* }
                ch{ &e, c = ';' }
                arm_chain{ &e, arms, k, through, union_t, res }
                ch{ &e, c = ' ' }
                tmp{ &e, k = res }
                put{ &e, a = "; })" }
            }
            switchx{ scrut, cases } => {
                let res = fresh{ &e }
                let k = fresh{ &e }
                put{ &e, a = "({ " }
                result_var{ &e, t = x.ty, k = res }
                declare{ &e, t = scrut.ty, k }
                expr{ &e, x = scrut.* }
                ch{ &e, c = ';' }
                case_chain{ &e, cases, k, t = scrut.ty, res }
                ch{ &e, c = ' ' }
                tmp{ &e, k = res }
                put{ &e, a = "; })" }
            }
            convert{ e = a, pos } => { as{ &e, t = x.ty, a = a.*, pos } }
            wrap{ op, a, b } => {
                let tt = temps2{ &e, a = a.*, b = b.* }
                cast_open{ &e, t = x.ty }
                put{ &e, a = "(uint64_t)" }
                operand{ &e, x = a.*, tt, i = 0 }
                match op {
                    add => { put{ &e, a = " + " } }
                    sub => { put{ &e, a = " - " } }
                    else => { put{ &e, a = " * " } }
                }
                put{ &e, a = "(uint64_t)" }
                operand{ &e, x = b.*, tt, i = 1 }
                put{ &e, a = "))" }
                close_temps{ &e, tt }
            }
        }
    }

    // `((tT)(`: close it with `))`.
    fn cast_open { mut e: E, t: ir::TypeId } {
        put{ &e, a = "((" }
        tn{ &e, t }
        put{ &e, a = ")(" }
    }

    // `((tT){`
    fn compound { mut e: E, t: ir::TypeId } {
        put{ &e, a = "((" }
        tn{ &e, t }
        put{ &e, a = "){" }
    }

    fn convert_to { mut e: E, t: ir::TypeId, a: ir::Expr } {
        cast_open{ &e, t }
        expr{ &e, x = a }
        put{ &e, a = "))" }
    }

    fn logical { mut e: E, a: ir::Expr, op: []u8, b: ir::Expr } {
        ch{ &e, c = '(' }
        expr{ &e, x = a }
        put{ &e, a = op }
        expr{ &e, x = b }
        ch{ &e, c = ')' }
    }

    // `(A OP B)`, in ctxi's order.
    fn infix { mut e: E, a: ir::Expr, op: []u8, b: ir::Expr } {
        let tt = temps2{ &e, a, b }
        ch{ &e, c = '(' }
        operand{ &e, x = a, tt, i = 0 }
        put{ &e, a = op }
        operand{ &e, x = b, tt, i = 1 }
        ch{ &e, c = ')' }
        close_temps{ &e, tt }
    }

    fn arith { mut e: E, t: ir::TypeId, op: ir::ArithOp, a: ir::Expr, b: ir::Expr, pos: ir::Pos } {
        let p = prim_of{ e, t } ifnull { @panic("emit: arithmetic on a non-number") }
        if is_float{ p } {
            match op {
                add => { infix{ &e, a, op = " + ", b } }
                sub => { infix{ &e, a, op = " - ", b } }
                mul => { infix{ &e, a, op = " * ", b } }
                div => { infix{ &e, a, op = " / ", b } }
                rem => {
                    let tt = temps2{ &e, a, b }
                    cast_open{ &e, t }
                    put{ &e, a = "fmod(" }
                    operand{ &e, x = a, tt, i = 0 }
                    put{ &e, a = ", " }
                    operand{ &e, x = b, tt, i = 1 }
                    put{ &e, a = ")))" }
                    close_temps{ &e, tt }
                }
            }
            return
        }
        let tt = temps2{ &e, a, b }
        match op {
            add => { put{ &e, a = "ctx_add_" } }
            sub => { put{ &e, a = "ctx_sub_" } }
            mul => { put{ &e, a = "ctx_mul_" } }
            div => { put{ &e, a = "ctx_div_" } }
            rem => { put{ &e, a = "ctx_rem_" } }
        }
        suffix{ &e, p }
        ch{ &e, c = '(' }
        operand{ &e, x = a, tt, i = 0 }
        put{ &e, a = ", " }
        operand{ &e, x = b, tt, i = 1 }
        put{ &e, a = ", " }
        position{ &e, p = pos }
        ch{ &e, c = ')' }
        close_temps{ &e, tt }
    }

    // `((tT)((uint64_t)A << ctx_shcount_i(B, BITS, pos)))`: shl in unsigned arithmetic, so the bits
    // shifted out are dropped; shr is C's, which is arithmetic for a signed A with gcc and clang.
    fn shift { mut e: E, t: ir::TypeId, op: ir::ShiftOp, a: ir::Expr, b: ir::Expr, pos: ir::Pos } {
        let p = prim_of{ e, t } ifnull { @panic("emit: shift of a non-integer") }
        let cp = prim_of{ e, t = b.ty } ifnull { @panic("emit: shift count of a non-integer") }
        let tt = temps2{ &e, a, b }
        cast_open{ &e, t }
        match op {
            shl => {
                put{ &e, a = "(uint64_t)" }
                operand{ &e, x = a, tt, i = 0 }
                put{ &e, a = " << " }
            }
            shr => {
                operand{ &e, x = a, tt, i = 0 }
                put{ &e, a = " >> " }
            }
        }
        if is_signed{ p = cp } { put{ &e, a = "ctx_shcount_i(" } } else { put{ &e, a = "ctx_shcount_u(" } }
        operand{ &e, x = b, tt, i = 1 }
        put{ &e, a = ", " }
        num{ &e, n = bit_width{ p } }
        put{ &e, a = ", " }
        position{ &e, p = pos }
        put{ &e, a = ")))" }
        close_temps{ &e, tt }
    }

    // `(*({ S s = (B); uint64_t i = I; s.m_ptr + ctx_idx(i, s.m_len, pos); }))`: a slice's
    // element, as a place.
    fn sindex { mut e: E, base: ir::Expr, i: ir::Expr, pos: ir::Pos } {
        let ks = fresh{ &e }
        let ki = fresh{ &e }
        put{ &e, a = "(*({ " }
        tn{ &e, t = base.ty }
        ch{ &e, c = ' ' }
        tmp{ &e, k = ks }
        put{ &e, a = " = (" }
        expr{ &e, x = base }
        put{ &e, a = "); uint64_t " }
        tmp{ &e, k = ki }
        put{ &e, a = " = " }
        expr{ &e, x = i }
        put{ &e, a = "; " }
        tmp{ &e, k = ks }
        put{ &e, a = ".m_ptr + ctx_idx(" }
        tmp{ &e, k = ki }
        put{ &e, a = ", " }
        tmp{ &e, k = ks }
        put{ &e, a = ".m_len, " }
        position{ &e, p = pos }
        put{ &e, a = "); }))" }
    }

    // `({ S s = (B); uint64_t lo = LO; uint64_t hi = HI; ctx_range(lo, hi, s.m_len, pos);
    // (S){ .m_ptr = s.m_ptr + lo, .m_len = hi - lo }; })`, where HI defaults to s.m_len.
    fn ssub { mut e: E, t: ir::TypeId, base: ir::Expr, lo: ir::Expr, hi: ?*ir::Expr, pos: ir::Pos } {
        // C's pointer arithmetic needs the elements' type.
        if ty{ e, id = struct_members{ e, t }[0].ty } is ptr{ elem } { use{ &e, t = elem } }
        let ks = fresh{ &e }
        let kl = fresh{ &e }
        let kh = fresh{ &e }
        put{ &e, a = "({ " }
        tn{ &e, t }
        ch{ &e, c = ' ' }
        tmp{ &e, k = ks }
        put{ &e, a = " = (" }
        expr{ &e, x = base }
        put{ &e, a = "); uint64_t " }
        tmp{ &e, k = kl }
        put{ &e, a = " = " }
        expr{ &e, x = lo }
        put{ &e, a = "; uint64_t " }
        tmp{ &e, k = kh }
        put{ &e, a = " = " }
        match hi {
            null          => { tmp{ &e, k = ks }; put{ &e, a = ".m_len" } }
            some{ value } => { expr{ &e, x = value.* } }
        }
        put{ &e, a = "; ctx_range(" }
        tmp{ &e, k = kl }
        put{ &e, a = ", " }
        tmp{ &e, k = kh }
        put{ &e, a = ", " }
        tmp{ &e, k = ks }
        put{ &e, a = ".m_len, " }
        position{ &e, p = pos }
        put{ &e, a = "); (" }
        tn{ &e, t }
        put{ &e, a = "){ .m_ptr = " }
        tmp{ &e, k = ks }
        put{ &e, a = ".m_ptr + " }
        tmp{ &e, k = kl }
        put{ &e, a = ", .m_len = " }
        tmp{ &e, k = kh }
        put{ &e, a = " - " }
        tmp{ &e, k = kl }
        put{ &e, a = " }; })" }
    }

    fn bit_width { p: ir::Prim } -> u64 {
        return match p {
            i8 => { 8 } u8 => { 8 } i16 => { 16 } u16 => { 16 } i32 => { 32 } u32 => { 32 } else => { 64 }
        }
    }

    // `(B).a[ctx_idx(I, N, pos)]`, with the base before the index.
    fn index { mut e: E, base: ir::Expr, i: ir::Expr, pos: ir::Pos } {
        let arr{ n } = ty{ e, id = base.ty } else { @panic("emit: index of a non-array") }
        if not ordered{ e, a = base, b = i } {
            ch{ &e, c = '(' }
            expr{ &e, x = base }
            put{ &e, a = ").a[ctx_idx(" }
            expr{ &e, x = i }
            put{ &e, a = ", " }
            num{ &e, n }
            put{ &e, a = ", " }
            position{ &e, p = pos }
            put{ &e, a = ")]" }
            return
        }
        let kb = fresh{ &e }
        let ki = fresh{ &e }
        let place = is_place{ x = base }
        if place { put{ &e, a = "(*({ " } } else { put{ &e, a = "({ " } }
        tn{ &e, t = base.ty }
        if place { put{ &e, a = " *" } } else { ch{ &e, c = ' ' } }
        tmp{ &e, k = kb }
        if place { put{ &e, a = " = &(" } } else { put{ &e, a = " = (" } }
        expr{ &e, x = base }
        put{ &e, a = "); uint64_t " }
        tmp{ &e, k = ki }
        put{ &e, a = " = " }
        expr{ &e, x = i }
        put{ &e, a = "; " }
        if place { ch{ &e, c = '&' } }
        tmp{ &e, k = kb }
        if place { put{ &e, a = "->a[ctx_idx(" } } else { put{ &e, a = ".a[ctx_idx(" } }
        tmp{ &e, k = ki }
        put{ &e, a = ", " }
        num{ &e, n }
        put{ &e, a = ", " }
        position{ &e, p = pos }
        put{ &e, a = ")]; })" }
        if place { ch{ &e, c = ')' } }
    }

    // @as between numbers: range-checked for integer results.
    fn as { mut e: E, t: ir::TypeId, a: ir::Expr, pos: ir::Pos } {
        let dst = prim_of{ e, t } ifnull { @panic("emit: @as to a non-number") }
        let src = prim_of{ e, t = a.ty } ifnull { @panic("emit: @as of a non-number") }
        if is_float{ p = dst } {
            cast_open{ &e, t }
            if not is_float{ p = src } { put{ &e, a = "(double)" } }
            expr{ &e, x = a }
            put{ &e, a = "))" }
            return
        }
        let signed_dst = is_signed{ p = dst }
        cast_open{ &e, t }
        if is_float{ p = src } {
            // ctx_f2i_s(v, LO, HI) or ctx_f2i_u(v, HI)
            if signed_dst { put{ &e, a = "ctx_f2i_s((double)(" } } else { put{ &e, a = "ctx_f2i_u((double)(" } }
            expr{ &e, x = a }
            put{ &e, a = "), " }
            if signed_dst {
                limit{ &e, p = dst, low = true }
                put{ &e, a = ", " }
            }
            limit{ &e, p = dst, low = false }
        } else if is_signed{ p = src } {
            // ctx_as_s(v, LO, HI); a u64 destination's HI is INT64_MAX, all an i64 can reach.
            put{ &e, a = "ctx_as_s((int64_t)(" }
            expr{ &e, x = a }
            put{ &e, a = "), " }
            if signed_dst {
                limit{ &e, p = dst, low = true }
                put{ &e, a = ", " }
                limit{ &e, p = dst, low = false }
            } else if dst_is_u64{ p = dst } {
                put{ &e, a = "0, INT64_MAX" }
            } else {
                put{ &e, a = "0, " }
                limit{ &e, p = dst, low = false }
            }
        } else {
            put{ &e, a = "ctx_as_u((uint64_t)(" }
            expr{ &e, x = a }
            put{ &e, a = "), " }
            limit{ &e, p = dst, low = false }
        }
        put{ &e, a = ", \"" }
        prim_name{ &e, p = dst }
        put{ &e, a = "\", " }
        position{ &e, p = pos }
        put{ &e, a = ")))" }
    }

    fn dst_is_u64 { p: ir::Prim } -> bool {
        return match p { u64 => { true } usize => { true } else => { false } }
    }

    // INTn_MIN or INTn_MAX, or UINTn_MAX.
    fn limit { mut e: E, p: ir::Prim, low: bool } {
        match p {
            i8    => { if low { put{ &e, a = "INT8_MIN" } } else { put{ &e, a = "INT8_MAX" } } }
            i16   => { if low { put{ &e, a = "INT16_MIN" } } else { put{ &e, a = "INT16_MAX" } } }
            i32   => { if low { put{ &e, a = "INT32_MIN" } } else { put{ &e, a = "INT32_MAX" } } }
            i64   => { if low { put{ &e, a = "INT64_MIN" } } else { put{ &e, a = "INT64_MAX" } } }
            u8    => { put{ &e, a = "UINT8_MAX" } }
            u16   => { put{ &e, a = "UINT16_MAX" } }
            u32   => { put{ &e, a = "UINT32_MAX" } }
            else  => { put{ &e, a = "UINT64_MAX" } }
        }
    }

    // A struct or variant literal.
    fn literal { mut e: E, t: ir::TypeId, variant: ?u32, items: []ir::Arg } {
        if nptr_record{ e, t } {
            // `null` is the struct with a 0 pointer; `some{ value = s }` is s
            if items.len == 1 {
                expr{ &e, x = items[0].value }
            } else {
                compound{ &e, t }
                put{ &e, a = "0})" }
            }
            return
        }
        if is_nptr{ e, t } {
            // `null` is 0; `some{ value = p }` is p
            cast_open{ &e, t }
            if items.len == 1 { expr{ &e, x = items[0].value } } else { ch{ &e, c = '0' } }
            put{ &e, a = "))" }
            return
        }
        if ty{ e, id = t } is record{ fields, untagged } {
            if untagged {
                // An extern union's one field, over zeroed bytes: C leaves the rest of a
                // union literal's bytes unspecified.
                //   ({ tN _tK; memset(&_tK, 0, sizeof _tK); _tK.m_f = VALUE; _tK; })
                let k = e.temp
                e.temp = e.temp + 1
                put{ &e, a = "({ " }
                tn{ &e, t }
                put{ &e, a = " _t" }
                num{ &e, n = k }
                put{ &e, a = "; memset(&_t" }
                num{ &e, n = k }
                put{ &e, a = ", 0, sizeof _t" }
                num{ &e, n = k }
                put{ &e, a = "); _t" }
                num{ &e, n = k }
                put{ &e, a = ".m_" }
                raw{ &e, b = fields[items[0].index].name }
                put{ &e, a = " = " }
                expr{ &e, x = items[0].value }
                put{ &e, a = "; _t" }
                num{ &e, n = k }
                put{ &e, a = "; })" }
                return
            }
        }
        let tt = temps_args{ &e, args = items }
        compound{ &e, t }
        let mut names: []ir::Field
        let mut payload = false
        match ty{ e, id = t } {
            record{ fields } => { names = fields }
            cap{ fields } => { names = fields }
            tagged{ variants } => {
                let v = variant ifnull { @panic("emit: variant literal without a variant") }
                put{ &e, a = " .tag = " }
                num{ &e, n = v }
                let fs = variants[v].fields
                if fs != null {
                    names = fs
                    payload = true
                    put{ &e, a = ", .p.v" }
                    num{ &e, n = v }
                    put{ &e, a = " = {" }
                }
            }
            else => { @panic("emit: literal of a non-struct") }
        }
        let mut i = 0
        while i < items.len {
            let a = items[i]
            put{ &e, a = " .m_" }
            raw{ &e, b = names[a.index].name }
            put{ &e, a = " = " }
            operand{ &e, x = a.value, tt, i = @as(u32, i) }
            ch{ &e, c = ',' }
            i = i + 1
        }
        if payload { put{ &e, a = " }" } }
        put{ &e, a = " })" }
        close_temps{ &e, tt }
    }

    fn array { mut e: E, t: ir::TypeId, elems: []ir::Expr } {
        let tt = temps_list{ &e, xs = elems }
        compound{ &e, t }
        if elems.len > 0 {
            put{ &e, a = "{ " }
            let mut i = 0
            while i < elems.len {
                if i > 0 { put{ &e, a = ", " } }
                operand{ &e, x = elems[i], tt, i = @as(u32, i) }
                i = i + 1
            }
            put{ &e, a = " }" }
        }
        put{ &e, a = "})" }
        close_temps{ &e, tt }
    }

    // [x; N]: x once, copied N times. In a static initializer, a range designator does it.
    fn repeat { mut e: E, t: ir::TypeId, elem: ir::Expr } {
        let arr{ n } = ty{ e, id = t } else { @panic("emit: repeat of a non-array") }
        if e.static_init {
            compound{ &e, t }
            if n > 0 {
                put{ &e, a = "{ [0 ... " }
                num{ &e, n = n - 1 }
                put{ &e, a = "] = " }
                expr{ &e, x = elem }
                put{ &e, a = " }" }
            }
            put{ &e, a = "})" }
            return
        }
        let kv = fresh{ &e }
        let ka = fresh{ &e }
        put{ &e, a = "({ " }
        declare{ &e, t = elem.ty, k = kv }
        expr{ &e, x = elem }
        put{ &e, a = "; " }
        tn{ &e, t }
        ch{ &e, c = ' ' }
        tmp{ &e, k = ka }
        put{ &e, a = "; for (uint64_t _i = 0; _i < " }
        num{ &e, n }
        put{ &e, a = "; _i++) " }
        tmp{ &e, k = ka }
        put{ &e, a = ".a[_i] = " }
        tmp{ &e, k = kv }
        put{ &e, a = "; " }
        tmp{ &e, k = ka }
        put{ &e, a = "; })" }
    }

    // ---- calls and function values

    // f_NAME(args in parameter order), evaluated in the IR's order.
    fn call { mut e: E, callee: u32, args: []ir::Arg } {
        let f = e.p.fns[callee]
        let c = Callee{ params = f.params, ext = f.symbol.len > 0, value = null }
        let tt = temps_call{ &e, args, c }
        mark_id{ &e, kind = 'f', id = callee }
        ch{ &e, c = '(' }
        in_order{ &e, args, c, tt }
        ch{ &e, c = ')' }
        close_temps{ &e, tt }
    }

    // The args, by parameter index.
    fn in_order { mut e: E, args: []ir::Arg, c: Callee, tt: Temps } {
        let mut j = 0
        while j < c.params.len {
            if j > 0 { put{ &e, a = ", " } }
            let mut i = 0
            while i < args.len {
                let a = args[i]
                if a.index == j {
                    let k = @as(u32, i)
                    match pass{ e, args, i, c } {
                        value => {
                            e.given = Given::call
                            operand{ &e, x = a.value, tt, i = k }
                            e.given = Given::other
                        }
                        place => {
                            if tt.on { tmp{ &e, k = tt.base + k } } else { address{ &e, x = a.value } }
                        }
                        copy => {
                            ch{ &e, c = '&' }
                            tmp{ &e, k = tt.base + k }
                        }
                    }
                }
                i = i + 1
            }
            j = j + 1
        }
    }

    // The callee first, then the args; called through its code.
    fn dcall { mut e: E, callee: ir::Expr, args: []ir::Arg } {
        if is_cfn{ e, t = callee.ty } {
            c_call{ &e, callee, args }
            return
        }
        let func{ params } = ty{ e, id = callee.ty } else { @panic("emit: call of a non-function") }
        let c = Callee{ params, ext = false, value = callee }
        let kf = fresh{ &e }
        put{ &e, a = "({ ctx_fn *" }
        tmp{ &e, k = kf }
        put{ &e, a = " = " }
        e.given = Given::call
        expr{ &e, x = callee }
        put{ &e, a = "; " }
        let tt = temps_call{ &e, args, c }
        put{ &e, a = "((" }
        mark_id{ &e, kind = 'c', id = callee.ty }
        put{ &e, a = ")" }
        tmp{ &e, k = kf }
        put{ &e, a = "->code)(" }
        tmp{ &e, k = kf }
        if params.len > 0 { put{ &e, a = ", " } }
        in_order{ &e, args, c, tt }
        ch{ &e, c = ')' }
        close_temps{ &e, tt }
        put{ &e, a = "; })" }
    }

    // A bound function: a record holding the code and the given args (Records). The record's
    // type and code go before the function (aux).
    fn bind { mut e: E, t: ir::TypeId, callee: u32, args: []ir::Arg, given: Given } {
        let f = e.p.fns[callee]
        let k = e.sites
        e.sites = e.sites + 1
        record{ &e, k, inner = false, args }
        let func{ params, ret } = ty{ e, id = t } else { @panic("emit: bind to a non-function type") }
        to_aux{ &e }
        code_head{ &e, kind = 'b', id = k, ret, params }
        record_self{ &e, k }
        if not is_void{ e, t = ret } { put{ &e, a = "return " } }
        mark_id{ &e, kind = 'f', id = callee }
        ch{ &e, c = '(' }
        forward{ &e, target = f.params, ext = f.symbol.len > 0, args, given = params }
        put{ &e, a = ");\n}\n\n" }
        to_aux{ &e }
        new_record{ &e, k, inner = null, args, t, given }
    }

    // A bound function value: like bind, calling the callee value through its code.
    fn dbind { mut e: E, t: ir::TypeId, callee: ir::Expr, args: []ir::Arg, given: Given } {
        let func{ params = target } = ty{ e, id = callee.ty } else { @panic("emit: bind of a non-function") }
        let k = e.sites
        e.sites = e.sites + 1
        record{ &e, k, inner = true, args }
        let func{ params, ret } = ty{ e, id = t } else { @panic("emit: bind to a non-function type") }
        to_aux{ &e }
        code_head{ &e, kind = 'b', id = k, ret, params }
        record_self{ &e, k }
        if not is_void{ e, t = ret } { put{ &e, a = "return " } }
        put{ &e, a = "((" }
        mark_id{ &e, kind = 'c', id = callee.ty }
        put{ &e, a = ")s->inner->code)(s->inner" }
        if target.len > 0 { put{ &e, a = ", " } }
        forward{ &e, target, ext = false, args, given = params }
        put{ &e, a = ");\n}\n\n" }
        to_aux{ &e }
        new_record{ &e, k, inner = callee, args, t, given }
    }

    //   struct bK *s = (struct bK *)self;
    fn record_self { mut e: E, k: u32 } {
        put{ &e, a = "    struct " }
        mark_id{ &e, kind = 'b', id = k }
        put{ &e, a = " *s = (struct " }
        mark_id{ &e, kind = 'b', id = k }
        put{ &e, a = " *)self;\n    " }
    }

    // `struct bK { ctx_fn base; [ctx_fn *inner;] T cI; ... };` for the args it captures.
    fn record { mut e: E, k: u32, inner: bool, args: []ir::Arg } {
        to_aux{ &e }
        put{ &e, a = "struct " }
        mark_id{ &e, kind = 'b', id = k }
        put{ &e, a = " { ctx_fn base; " }
        if inner { put{ &e, a = "ctx_fn *inner; " } }
        let mut i = 0
        while i < args.len {
            let a = args[i]
            tn{ &e, t = a.value.ty }
            put{ &e, a = " c" }
            num{ &e, n = a.index }
            put{ &e, a = "; " }
            i = i + 1
        }
        put{ &e, a = "};\n" }
        to_aux{ &e }
    }

    fn func_bound { e: E, t: ir::TypeId } -> bool {
        return ty{ e, id = t } is func{ bound } and bound
    }

    // ---- Records
    //
    // Where a function value's record goes (ctxrt.h, function values):
    //   - a `fn` value's is a named function's static record, or an adapter or widening thunk of
    //     another `fn` value, which the runtime keeps one of for each pair (ctx_adapt): there are
    //     finitely many;
    //   - a bind that captures nothing has a static record;
    //   - a `&fn` value's is a slot in the frame when no earlier record of the same site can be
    //     called once the site runs again: the site runs at most once per invocation (no loop
    //     is around it), or what it makes is only called or passed to a call (Given::call: a
    //     callee can't keep a `&fn`, §6), or only held by a local that nothing else is ever put
    //     in and that is only called or passed to calls (Given::local, confine), which the
    //     next run of the site gives the new record;
    //   - otherwise it is borrowed from the runtime's stack, until the function returns.
    // A slot's record is built in a temporary and copied in once the args are evaluated, so the
    // args may still call the slot's old record.

    // What takes the value being written: a call, as an argument or the function called; a
    // confined local's `let` (Records); anything else.
    union Given { call, local, other }

    union Store { canon, fixed, slot, stack }

    fn store { mut e: E, t: ir::TypeId, given: Given, empty: bool } -> Store {
        if not func_bound{ e, t } { return Store::canon }
        if empty { return Store::fixed }
        if e.loops == 0 or not (given is other) { return Store::slot }
        e.stacked = true
        return Store::stack
    }

    // What a record's own callee and args are given: a slot's that a call takes can be slots too.
    fn inner_given { s: Store, given: Given } -> Given {
        if s is slot and given is call { return Given::call }
        return Given::other
    }

    // A local's state in confine: no `let` seen yet, one `let` and only taken by calls so far
    // (CONFINED), or anything else.
    const UNSEEN: u8 = 0
    const CONFINED: u8 = 1
    const LOOSE: u8 = 2

    // Which of f's `&fn` locals are confined: given a value by one `let` alone, never assigned,
    // and only called or passed to calls (Records).
    fn confine { mut e: E, f: ir::Func } {
        list::clear{ list = &e.confined }
        let mut i: usize = 0
        while i < f.locals.len {
            let mine = i >= f.params.len and func_bound{ e, t = f.locals[i].ty }
            try! list::push{ list = &e.confined, item = if mine { UNSEEN } else { LOOSE } }
            i = i + 1
        }
        c_block{ &e, b = f.body }
        i = 0
        while i < f.locals.len {
            if list::items{ list = e.confined }[i] == UNSEEN { list::items{ list = e.confined }[i] = LOOSE }
            i = i + 1
        }
    }

    fn loose { mut e: E, slot: u32 } {
        list::items{ list = e.confined }[slot] = LOOSE
    }

    fn c_block { mut e: E, b: ir::Block } {
        let mut i = 0
        while i < b.stmts.len {
            c_stmt{ &e, s = b.stmts[i] }
            i = i + 1
        }
        if b.result != null { c_expr{ &e, x = b.result.*, taken = false } }
    }

    fn c_binds { mut e: E, binds: []ir::Bind } {
        let mut i = 0
        while i < binds.len {
            loose{ &e, slot = binds[i].slot }
            i = i + 1
        }
    }

    fn c_arms { mut e: E, arms: []ir::Arm } {
        let mut i = 0
        while i < arms.len {
            let mut j = 0
            while j < arms[i].pats.len {
                c_binds{ &e, binds = arms[i].pats[j].binds }
                j = j + 1
            }
            c_block{ &e, b = arms[i].body }
            i = i + 1
        }
    }

    fn c_cases { mut e: E, cases: []ir::Case } {
        let mut i = 0
        while i < cases.len {
            c_block{ &e, b = cases[i].body }
            i = i + 1
        }
    }

    fn c_stmt { mut e: E, s: ir::Stmt } {
        match s {
            define{ slot, init } => {
                c_expr{ &e, x = init, taken = false }
                let st = list::items{ list = e.confined }[slot]
                list::items{ list = e.confined }[slot] = if st == UNSEEN { CONFINED } else { LOOSE }
            }
            zero{ slot } => { loose{ &e, slot } }
            assign{ place, value } => {
                if place.k is local{ slot } { loose{ &e, slot } } else { c_expr{ &e, x = place, taken = false } }
                c_expr{ &e, x = value, taken = false }
            }
            eval{ e = x } => { c_expr{ &e, x, taken = false } }
            cond{ c, then, els } => {
                c_expr{ &e, x = c, taken = false }
                c_block{ &e, b = then }
                match els {
                    some{ value } => { c_block{ &e, b = value } }
                    null => {}
                }
            }
            loop{ c, body } => {
                c_expr{ &e, x = c, taken = false }
                c_block{ &e, b = body }
            }
            brk | cont | panic => {}
            ret{ value } => {
                match value {
                    some{ value = v } => { c_expr{ &e, x = v, taken = false } }
                    null => {}
                }
            }
            deferred{ body } => { c_block{ &e, b = body } }
            choose{ scrut, arms } => {
                c_expr{ &e, x = scrut, taken = false }
                c_arms{ &e, arms }
            }
            switch{ scrut, cases } => {
                c_expr{ &e, x = scrut, taken = false }
                c_cases{ &e, cases }
            }
            let_else{ init, binds, els_binds, els } => {
                c_expr{ &e, x = init, taken = false }
                c_binds{ &e, binds }
                c_binds{ &e, binds = els_binds }
                c_block{ &e, b = els }
            }
        }
    }

    fn c_args { mut e: E, args: []ir::Arg, taken: bool } {
        let mut i = 0
        while i < args.len {
            c_expr{ &e, x = args[i].value, taken }
            i = i + 1
        }
    }

    // x, which a call takes if `taken`.
    fn c_expr { mut e: E, x: ir::Expr, taken: bool } {
        match x.k {
            int | float | boolean | str | sbytes | cstr | nil | constref | cvar | fnref => {}
            local{ slot } => { if not taken { loose{ &e, slot } } }
            deref{ ptr = a } | field{ base = a } | payload{ base = a } | addr{ place = a } | neg{ e = a }
            | lnot{ e = a } | isnull{ e = a } | notnull{ e = a } | widen{ e = a } | some{ e = a }
            | fnconv{ e = a } | repeat{ elem = a } | convert{ e = a } | trunc{ e = a } | cast{ e = a }
            | ptraddr{ e = a } => {
                c_expr{ &e, x = a.*, taken = false }
            }
            index{ base, i } | sindex{ base, i } => {
                c_expr{ &e, x = base.*, taken = false }
                c_expr{ &e, x = i.*, taken = false }
            }
            ssub{ base, lo, hi } => {
                c_expr{ &e, x = base.*, taken = false }
                c_expr{ &e, x = lo.*, taken = false }
                if hi != null { c_expr{ &e, x = hi.*, taken = false } }
            }
            seq{ first, then } => {
                c_expr{ &e, x = first.*, taken = false }
                c_expr{ &e, x = then.*, taken = false }
            }
            with{ slot, init, body } => {
                loose{ &e, slot }
                c_expr{ &e, x = init.*, taken = false }
                c_expr{ &e, x = body.*, taken = false }
            }
            land{ a, b } | lor{ a, b } | arith{ a, b } | bits{ a, b } | shift{ a, b } | cmp{ a, b }
            | wrap{ a, b } => {
                c_expr{ &e, x = a.*, taken = false }
                c_expr{ &e, x = b.*, taken = false }
            }
            ptradd{ p, n } => {
                c_expr{ &e, x = p.*, taken = false }
                c_expr{ &e, x = n.*, taken = false }
            }
            call{ args } => { c_args{ &e, args, taken = true } }
            dcall{ callee, args } => {
                c_expr{ &e, x = callee.*, taken = true }
                c_args{ &e, args, taken = true }
            }
            bind{ args } => { c_args{ &e, args, taken = false } }
            dbind{ callee, args } => {
                c_expr{ &e, x = callee.*, taken = false }
                c_args{ &e, args, taken = false }
            }
            record{ items } | variant{ items } => { c_args{ &e, args = items, taken = false } }
            array{ elems } => {
                let mut i = 0
                while i < elems.len {
                    c_expr{ &e, x = elems[i], taken = false }
                    i = i + 1
                }
            }
            ifx{ c, then, els } => {
                c_expr{ &e, x = c.*, taken = false }
                c_block{ &e, b = then }
                c_block{ &e, b = els }
            }
            matchx{ scrut, arms } => {
                c_expr{ &e, x = scrut.*, taken = false }
                c_arms{ &e, arms }
            }
            switchx{ scrut, cases } => {
                c_expr{ &e, x = scrut.*, taken = false }
                c_cases{ &e, cases }
            }
        }
    }

    // Record bK, filled in IR order: callee, then args.
    fn new_record { mut e: E, k: u32, inner: ?ir::Expr, args: []ir::Arg, t: ir::TypeId, given: Given } {
        let s = store{ &e, t, given, empty = args.len == 0 and inner == null }
        match s {
            canon => {
                // A widening thunk of a `fn` value (lower.ctx, widen_fn): an adapter's layout.
                if inner != null or args.len != 1 or not (ty{ e, id = args[0].value.ty } is func) {
                    @panic("emit: a `fn` record that isn't a widening thunk")
                }
                put{ &e, a = "ctx_adapt(" }
                expr{ &e, x = args[0].value }
                put{ &e, a = ", (void (*)(void))" }
                mark_id{ &e, kind = 'b', id = k }
                put{ &e, a = "_code)" }
                return
            }
            fixed => {
                put{ &e, a = "({ static struct " }
                mark_id{ &e, kind = 'b', id = k }
                put{ &e, a = " _r = { { (void (*)(void))" }
                mark_id{ &e, kind = 'b', id = k }
                put{ &e, a = "_code } }; (ctx_fn *)&_r; })" }
                return
            }
            else => {}
        }
        let kr = fresh{ &e }
        let to: []u8 = if s is slot { "." } else { "->" }
        put{ &e, a = "({ struct " }
        mark_id{ &e, kind = 'b', id = k }
        if s is slot {
            ch{ &e, c = ' ' }
            tmp{ &e, k = kr }
            put{ &e, a = "; " }
        } else {
            put{ &e, a = " *" }
            tmp{ &e, k = kr }
            put{ &e, a = " = ctx_rec_alloc(sizeof(struct " }
            mark_id{ &e, kind = 'b', id = k }
            put{ &e, a = ")); " }
        }
        tmp{ &e, k = kr }
        put{ &e, a = to }
        put{ &e, a = "base.code = (void (*)(void))" }
        mark_id{ &e, kind = 'b', id = k }
        put{ &e, a = "_code; " }
        let g = inner_given{ s, given }
        match inner {
            some{ value } => {
                tmp{ &e, k = kr }
                put{ &e, a = to }
                put{ &e, a = "inner = " }
                e.given = g
                expr{ &e, x = value }
                put{ &e, a = "; " }
            }
            null => {}
        }
        let mut i = 0
        while i < args.len {
            let a = args[i]
            tmp{ &e, k = kr }
            put{ &e, a = to }
            ch{ &e, c = 'c' }
            num{ &e, n = a.index }
            put{ &e, a = " = " }
            e.given = g
            expr{ &e, x = a.value }
            put{ &e, a = "; " }
            i = i + 1
        }
        if s is slot {
            try! list::push{ list = &e.slots, item = k }
            put{ &e, a = "_r" }
            num{ &e, n = k }
            put{ &e, a = " = " }
            tmp{ &e, k = kr }
            put{ &e, a = "; (ctx_fn *)&_r" }
            num{ &e, n = k }
        } else {
            put{ &e, a = "(ctx_fn *)" }
            tmp{ &e, k = kr }
        }
        put{ &e, a = "; })" }
    }

    // `static R NAME_code(ctx_fn *self, P a0, ...) {`, NAME being the marker's.
    fn code_head { mut e: E, kind: u8, id: u32, ret: ir::TypeId, params: []ir::Param } {
        put{ &e, a = "static " }
        tn{ &e, t = ret }
        ch{ &e, c = ' ' }
        mark_id{ &e, kind, id }
        put{ &e, a = "_code(ctx_fn *self" }
        let mut i = 0
        while i < params.len {
            put{ &e, a = ", " }
            code_param{ &e, q = params[i] }
            put{ &e, a = " a" }
            num{ &e, n = i }
            i = i + 1
        }
        put{ &e, a = ") {\n" }
    }

    // The target's params in order: a captured arg (s->cJ) or the code's param of the same name.
    // A param the target takes by reference (§14.6; never one of an extern fn: ext) gets an
    // address.
    fn forward { mut e: E, target: []ir::Param, ext: bool, args: []ir::Arg, given: []ir::Param } {
        let mut j = 0
        while j < target.len {
            if j > 0 { put{ &e, a = ", " } }
            let to_ref = not ext and by_ref{ e, q = target[j] }
            let mut captured = false
            let mut i = 0
            while i < args.len {
                if args[i].index == j { captured = true }
                i = i + 1
            }
            if captured {
                if to_ref { ch{ &e, c = '&' } }
                put{ &e, a = "s->c" }
                num{ &e, n = j }
            } else {
                by_name{ &e, name = target[j].name, params = given, c = false, to_ref }
            }
            j = j + 1
        }
    }

    // `aI` for the param named `name`: its address if the target takes it by reference and the
    // code doesn't, its value if the code does and the target doesn't. The code's params are a
    // C function type's if c.
    fn by_name { mut e: E, name: ir::Bytes, params: []ir::Param, c: bool, to_ref: bool } {
        let mut i = 0
        while i < params.len {
            if slice::eq_bytes{ a = params[i].name, b = name } {
                let from_ref = not c and by_ref{ e, q = params[i] }
                if to_ref and not from_ref { ch{ &e, c = '&' } }
                if from_ref and not to_ref { put{ &e, a = "(*" } }
                ch{ &e, c = 'a' }
                num{ &e, n = i }
                if from_ref and not to_ref { ch{ &e, c = ')' } }
                return
            }
            i = i + 1
        }
        @panic("emit: a function value's param is missing")
    }

    // Function callee's value is gN, a static record whose code hN calls it, of type t: each
    // unit that uses it has its own (thunk_def).
    fn thunk { mut e: E, callee: u32, t: ir::TypeId } {
        if list::items{ list = e.thunks }[callee] == NONE { list::items{ list = e.thunks }[callee] = t }
    }

    //   static R hN_code(ctx_fn *self, P a0, ...) { (void)self; return f_NAME(...); }
    //   static ctx_fn gN = { (void (*)(void))hN_code };
    fn thunk_def { mut e: E, callee: u32 } {
        let f = e.p.fns[callee]
        let func{ params, ret } = ty{ e, id = list::items{ list = e.thunks }[callee] } else { @panic("emit: fnref of a non-function type") }
        code_head{ &e, kind = 'h', id = callee, ret, params }
        put{ &e, a = "    (void)self;\n    " }
        if not is_void{ e, t = ret } { put{ &e, a = "return " } }
        mark_id{ &e, kind = 'f', id = callee }
        ch{ &e, c = '(' }
        forward{ &e, target = f.params, ext = f.symbol.len > 0, args = slice::empty(ir::Arg){}, given = params }
        put{ &e, a = ");\n}\nstatic ctx_fn " }
        mark_id{ &e, kind = 'g', id = callee }
        put{ &e, a = " = { (void (*)(void))" }
        mark_id{ &e, kind = 'h', id = callee }
        put{ &e, a = "_code };\n\n" }
    }

    // A C function of C function type t that calls function callee (callback_def). Returns its
    // number.
    fn callback { mut e: E, callee: u32, t: ir::TypeId } -> u32 {
        let mut k = 0
        while k < e.callbacks.len {
            let q = list::items{ list = e.callbacks }[k]
            if q.callee == callee and q.ty == t { return @as(u32, k) }
            k = k + 1
        }
        try! list::push{ list = &e.callbacks, item = Callback{ callee, ty = t } }
        return @as(u32, k)
    }

    //   R k_NAME(P a1, ...)
    // static unless there are several units: C may compare its address, so it is one function,
    // in its callee's unit.
    fn callback_head { mut e: E, k: u32 } {
        let c = list::items{ list = e.callbacks }[k]
        let cfn{ params, ret } = ty{ e, id = c.ty } else { @panic("emit: a callback of a non-C function type") }
        mark_id{ &e, kind = 's', id = 0 }
        tn{ &e, t = ret }
        ch{ &e, c = ' ' }
        mark_id{ &e, kind = 'k', id = k }
        ch{ &e, c = '(' }
        let mut first = true
        let mut i = 0
        while i < params.len {
            if not is_cap{ e, t = params[i].ty } {
                if not first { put{ &e, a = ", " } }
                param_type{ &e, q = params[i] }
                put{ &e, a = " a" }
                num{ &e, n = i }
                first = false
            }
            i = i + 1
        }
        if first { put{ &e, a = "void" } }
        ch{ &e, c = ')' }
    }

    // Callback k: C's params, without capabilities, by name to its function's, which supplies
    // the capabilities itself (§18).
    //   R k_NAME(P a1, ...) { static char cap[1]; return f_NAME((void *)cap, a1, (tC){}); }
    fn callback_def { mut e: E, k: u32 } {
        let c = list::items{ list = e.callbacks }[k]
        let f = e.p.fns[c.callee]
        let cfn{ params, ret } = ty{ e, id = c.ty } else { @panic("emit: a callback of a non-C function type") }
        put{ &e, a = "// callback " }
        raw{ &e, b = f.name }
        ch{ &e, c = '\n' }
        callback_head{ &e, k }
        put{ &e, a = " {\n    " }
        let mut i = 0
        while i < f.params.len {
            if f.params[i].mutable and is_cap{ e, t = f.params[i].ty } {
                put{ &e, a = "static char cap[1];\n    " }
                break
            }
            i = i + 1
        }
        if not is_void{ e, t = ret } { put{ &e, a = "return " } }
        mark_id{ &e, kind = 'f', id = c.callee }
        ch{ &e, c = '(' }
        let mut j = 0
        while j < f.params.len {
            if j > 0 { put{ &e, a = ", " } }
            let q = f.params[j]
            if is_cap{ e, t = q.ty } {
                if q.mutable {
                    put{ &e, a = "(void *)cap" }
                } else {
                    ch{ &e, c = '(' }
                    tn{ &e, t = q.ty }
                    put{ &e, a = "){}" }
                }
            } else {
                by_name{ &e, name = q.name, params, c = true, to_ref = by_ref{ e, q } }
            }
            j = j + 1
        }
        put{ &e, a = ");\n}\n\n" }
    }

    // A function value of type `from` as type `to`. The same fields need nothing; more fields
    // need an adapter that drops them (adapter_def), whose record goes where a bind's would
    // (Records).
    fn fnconv { mut e: E, to: ir::TypeId, a: ir::Expr, given: Given } {
        let func{ params = src } = ty{ e, id = a.ty } else { @panic("emit: fnconv of a non-function") }
        let func{ params = dst } = ty{ e, id = to } else { @panic("emit: fnconv to a non-function") }
        if same_params{ a = src, b = dst } {
            e.given = given
            expr{ &e, x = a }
            return
        }
        let mut k = 0
        while k < e.adapters.len {
            let q = list::items{ list = e.adapters }[k]
            if q.from == a.ty and q.to == to { break }
            k = k + 1
        }
        if k == e.adapters.len { try! list::push{ list = &e.adapters, item = Pair{ from = a.ty, to } } }
        let s = store{ &e, t = to, given, empty = false }
        if s is canon {
            if a.k is fnref {
                put{ &e, a = "({ static ctx_adapter _r = { { (void (*)(void))" }
                mark_id{ &e, kind = 'a', id = @as(u32, k) }
                put{ &e, a = "_code }, " }
                expr{ &e, x = a }
                put{ &e, a = " }; &_r.base; })" }
                return
            }
            put{ &e, a = "ctx_adapt(" }
            expr{ &e, x = a }
            put{ &e, a = ", (void (*)(void))" }
            mark_id{ &e, kind = 'a', id = @as(u32, k) }
            put{ &e, a = "_code)" }
            return
        }
        let kr = fresh{ &e }
        put{ &e, a = "({ ctx_adapter " }
        if s is slot {
            tmp{ &e, k = kr }
            put{ &e, a = " = { { (void (*)(void))" }
            mark_id{ &e, kind = 'a', id = @as(u32, k) }
            put{ &e, a = "_code }, " }
            e.given = inner_given{ s, given }
            expr{ &e, x = a }
            let site = e.sites
            e.sites = e.sites + 1
            try! list::push{ list = &e.slots, item = site + SLOT_ADAPTER }
            put{ &e, a = " }; _r" }
            num{ &e, n = site }
            put{ &e, a = " = " }
            tmp{ &e, k = kr }
            put{ &e, a = "; &_r" }
            num{ &e, n = site }
            put{ &e, a = ".base; })" }
            return
        }
        ch{ &e, c = '*' }
        tmp{ &e, k = kr }
        put{ &e, a = " = ctx_rec_alloc(sizeof(ctx_adapter)); " }
        tmp{ &e, k = kr }
        put{ &e, a = "->base.code = (void (*)(void))" }
        mark_id{ &e, kind = 'a', id = @as(u32, k) }
        put{ &e, a = "_code; " }
        tmp{ &e, k = kr }
        put{ &e, a = "->inner = " }
        expr{ &e, x = a }
        put{ &e, a = "; &" }
        tmp{ &e, k = kr }
        put{ &e, a = "->base; })" }
    }

    //   static R aN_code(ctx_fn *self, P a0, ...) { ctx_fn *in = ...; return ((cT)in->code)(in, ...); }
    fn adapter_def { mut e: E, k: u32 } {
        let q = list::items{ list = e.adapters }[k]
        let func{ params = src, ret } = ty{ e, id = q.from } else { @panic("emit: fnconv of a non-function") }
        let func{ params = dst } = ty{ e, id = q.to } else { @panic("emit: fnconv to a non-function") }
        code_head{ &e, kind = 'a', id = k, ret, params = dst }
        put{ &e, a = "    ctx_fn *in = ((ctx_adapter *)self)->inner;\n    " }
        if not is_void{ e, t = ret } { put{ &e, a = "return " } }
        put{ &e, a = "((" }
        mark_id{ &e, kind = 'c', id = q.from }
        put{ &e, a = ")in->code)(in" }
        if src.len > 0 { put{ &e, a = ", " } }
        forward{ &e, target = src, ext = false, args = slice::empty(ir::Arg){}, given = dst }
        put{ &e, a = ");\n}\n\n" }
    }

    fn same_params { a: []ir::Param, b: []ir::Param } -> bool {
        if a.len != b.len { return false }
        let mut i = 0
        while i < a.len {
            let x = a[i]
            let y = b[i]
            if x.ty != y.ty or x.mutable != y.mutable or not slice::eq_bytes{ a = x.name, b = y.name } { return false }
            i = i + 1
        }
        return true
    }

    // Swaps the output with the aux buffer.
    fn to_aux { mut e: E } {
        let o = e.o
        e.o = e.aux
        e.aux = o
    }

    // ---- evaluation order
    //
    // C leaves the order of operands open; ctxi goes left to right. Operands go into temporaries
    // when the order could show: some operand has an effect or can panic, and at least two of
    // them aren't constants.

    // Temporaries for a node's operands: tt.base is the first _tK, or tt.on is false.
    struct Temps { on: bool, base: u32 }

    fn temps2 { mut e: E, a: ir::Expr, b: ir::Expr } -> Temps {
        if not ordered{ e, a, b } { return Temps{ on = false, base = 0 } }
        let base = e.temp
        e.temp = e.temp + 2
        put{ &e, a = "({ " }
        declare{ &e, t = a.ty, k = base }
        expr{ &e, x = a }
        put{ &e, a = "; " }
        declare{ &e, t = b.ty, k = base + 1 }
        expr{ &e, x = b }
        put{ &e, a = "; " }
        return Temps{ on = true, base }
    }

    fn temps_args { mut e: E, args: []ir::Arg } -> Temps {
        let mut effects: usize = 0
        let mut vars: usize = 0
        let mut i = 0
        while i < args.len {
            let x = args[i].value
            if not pure{ e, x } { effects = effects + 1 }
            if not constant{ x } { vars = vars + 1 }
            i = i + 1
        }
        if effects == 0 or vars < 2 { return Temps{ on = false, base = 0 } }
        let base = e.temp
        e.temp = e.temp + @as(u32, args.len)
        put{ &e, a = "({ " }
        i = 0
        while i < args.len {
            let x = args[i].value
            declare{ &e, t = x.ty, k = base + @as(u32, i) }
            expr{ &e, x }
            put{ &e, a = "; " }
            i = i + 1
        }
        return Temps{ on = true, base }
    }

    fn temps_list { mut e: E, xs: []ir::Expr } -> Temps {
        let mut effects: usize = 0
        let mut vars: usize = 0
        let mut i = 0
        while i < xs.len {
            let x = xs[i]
            if not pure{ e, x } { effects = effects + 1 }
            if not constant{ x } { vars = vars + 1 }
            i = i + 1
        }
        if effects == 0 or vars < 2 { return Temps{ on = false, base = 0 } }
        let base = e.temp
        e.temp = e.temp + @as(u32, xs.len)
        put{ &e, a = "({ " }
        i = 0
        while i < xs.len {
            let x = xs[i]
            declare{ &e, t = x.ty, k = base + @as(u32, i) }
            expr{ &e, x }
            put{ &e, a = "; " }
            i = i + 1
        }
        return Temps{ on = true, base }
    }

    // ---- arguments passed by reference (spec §14.6)
    //
    // A big read-only param (by_ref) takes a pointer. The caller passes the address of the
    // argument's place when nothing can change that place during the call, so the callee sees
    // the value the argument had when it was evaluated; otherwise the address of a copy made
    // then. The place is passed if it is a const's, or the place of a local (or through one, as
    // `p.*.x` is through `p`) that no other argument, and not the callee, can reach: no
    // argument whose type holds a pointer comes from that local (`&x`, `x[..]`, `p`, a bind
    // holding `&x`), no `&fn` local is passed or called, and no argument after it may write
    // memory. That covers §3.1's overlapping `mut` references, and more.

    // A call's callee: its params, whether it is an extern fn (whose params are C's, never by
    // reference), and the function value called, if it is one.
    struct Callee { params: []ir::Param, ext: bool, value: ?ir::Expr }

    // How an argument goes: its value; the address of its place; the address of a temporary.
    union Pass { value, place, copy }

    fn by_ref { e: E, q: ir::Param } -> bool {
        if q.mutable { return false }
        let big = match ty{ e, id = q.ty } {
            record | tagged | arr => { true }
            else => { false }
        }
        return big and size_of{ e, t = q.ty } > BYREF
    }

    fn size_of { e: E, t: ir::TypeId } -> u64 {
        return match ty{ e, id = t } {
            prim{ p } => { bit_width{ p } / 8 }
            arr{ n, elem } => { n * size_of{ e, t = elem } }
            record{ size } | tagged{ size } | cap{ size } => { size }
            void => { 0 }
            else => { 8 }
        }
    }

    fn pass { e: E, args: []ir::Arg, i: usize, c: Callee } -> Pass {
        let a = args[i]
        if c.ext or not by_ref{ e, q = c.params[a.index] } { return Pass::value }
        let x = a.value
        if not is_place{ x } { return Pass::copy }
        let slot = match root{ x } {
            slot{ n } => { n }
            constant => { return Pass::place }
            other => { return Pass::copy }
        }
        let mut j = 0
        while j < args.len {
            if j != i {
                let y = args[j].value
                if j > i and writes{ e, x = y } { return Pass::copy }
                if reaches{ e, x = y, slot } { return Pass::copy }
            }
            j = j + 1
        }
        match c.value {
            some{ value } => { if reaches{ e, x = value, slot } { return Pass::copy } }
            null => {}
        }
        return Pass::place
    }

    // Where a place's memory is: in a local (or through a pointer read from one), in a const,
    // or elsewhere.
    union Root { slot{ n: u32 }, constant, other }

    fn root { x: ir::Expr } -> Root {
        return match x.k {
            local{ slot }   => { Root::slot{ n = slot } }
            constref        => { Root::constant }
            field{ base = b } | payload{ base = b } | index{ base = b } | sindex{ base = b }
            | ssub{ base = b } | deref{ ptr = b } | addr{ place = b } => { root{ x = b.* } }
            else            => { Root::other }
        }
    }

    // Could value x point into memory rooted at local `slot` (root)? Only a value whose type
    // holds a pointer can.
    fn reaches { e: E, x: ir::Expr, slot: u32 } -> bool {
        if not has_ptr{ e, t = x.ty } { return false }
        if ty{ e, id = x.ty } is func { return holds{ e, x, slot } }
        match root{ x } {
            slot{ n } => { return n == slot }
            constant => { return false }
            other => {}
        }
        return match x.k {
            int | float | boolean | str | sbytes | cstr | nil | fnref | cvar => { false }
            some{ e = a } | widen{ e = a } | cast{ e = a } | seq{ then = a } | ptradd{ p = a } => {
                reaches{ e, x = a.*, slot }
            }
            with{ init, body } => { reaches{ e, x = init.*, slot } or reaches{ e, x = body.*, slot } }
            record{ items } | variant{ items } => { reaches_args{ e, args = items, slot } }
            call{ args } => { reaches_args{ e, args, slot } }
            array{ elems } => {
                let mut i = 0
                while i < elems.len {
                    if reaches{ e, x = elems[i], slot } { return true }
                    i = i + 1
                }
                false
            }
            else => { true }
        }
    }

    fn reaches_args { e: E, args: []ir::Arg, slot: u32 } -> bool {
        let mut i = 0
        while i < args.len {
            if reaches{ e, x = args[i].value, slot } { return true }
            i = i + 1
        }
        return false
    }

    // A function value x: a `fn` holds no places, a bind those its args reach, and a `&fn`
    // context field none of this function's (§3.1); any other `&fn` may hold any.
    fn holds { e: E, x: ir::Expr, slot: u32 } -> bool {
        let func{ bound } = ty{ e, id = x.ty } else { return true }
        if not bound { return false }
        return match x.k {
            fnref | nil => { false }
            bind{ args } => { reaches_args{ e, args, slot } }
            dbind{ callee, args } => { reaches{ e, x = callee.*, slot } or reaches_args{ e, args, slot } }
            fnconv{ e = a } => { holds{ e, x = a.*, slot } }
            local{ slot = n } => { n >= e.f.params.len }
            else => { true }
        }
    }

    // Does a type hold a pointer: a pointer, a slice, a function value?
    fn has_ptr { e: E, t: ir::TypeId } -> bool {
        return match ty{ e, id = t } {
            ptr | nptr | func | cfn => { true }
            arr{ elem } => { has_ptr{ e, t = elem } }
            record{ fields } => { fields_ptr{ e, fields } }
            tagged{ variants } => {
                let mut i = 0
                while i < variants.len {
                    let fs = variants[i].fields
                    if fs != null and fields_ptr{ e, fields = fs } { return true }
                    i = i + 1
                }
                false
            }
            else => { false }
        }
    }

    fn fields_ptr { e: E, fields: []ir::Field } -> bool {
        let mut i = 0
        while i < fields.len {
            if has_ptr{ e, t = fields[i].ty } { return true }
            i = i + 1
        }
        return false
    }

    // May evaluating x write memory: does it call a function, or run statements?
    fn writes { e: E, x: ir::Expr } -> bool {
        return match x.k {
            int | float | boolean | str | sbytes | cstr | nil | local | constref | cvar | fnref => { false }
            deref{ ptr = a } | field{ base = a } | payload{ base = a } | addr{ place = a }
            | lnot{ e = a } | isnull{ e = a } | notnull{ e = a } | widen{ e = a } | some{ e = a }
            | cast{ e = a } | ptraddr{ e = a } | trunc{ e = a } | fnconv{ e = a } | repeat{ elem = a }
            | neg{ e = a } | convert{ e = a } => {
                writes{ e, x = a.* }
            }
            seq{ first = a, then = b } | land{ a, b } | lor{ a, b } | cmp{ a, b } | bits{ a, b }
            | ptradd{ p = a, n = b } | wrap{ a, b } | arith{ a, b } | shift{ a, b }
            | index{ base = a, i = b } | sindex{ base = a, i = b } | with{ init = a, body = b } => {
                writes{ e, x = a.* } or writes{ e, x = b.* }
            }
            ssub{ base, lo, hi } => {
                let h = match hi { some{ value } => { writes{ e, x = value.* } } null => { false } }
                writes{ e, x = base.* } or writes{ e, x = lo.* } or h
            }
            record{ items } | variant{ items } | bind{ args = items } => {
                let mut i = 0
                while i < items.len {
                    if writes{ e, x = items[i].value } { return true }
                    i = i + 1
                }
                false
            }
            array{ elems } => {
                let mut i = 0
                while i < elems.len {
                    if writes{ e, x = elems[i] } { return true }
                    i = i + 1
                }
                false
            }
            else => { true }
        }
    }

    // `&(PLACE)`, cast to a pointer that isn't const if the place is a const's.
    fn address { mut e: E, x: ir::Expr } {
        if root{ x } is constant {
            put{ &e, a = "((" }
            tn{ &e, t = x.ty }
            put{ &e, a = " *)&(" }
            expr{ &e, x }
            put{ &e, a = "))" }
            return
        }
        put{ &e, a = "&(" }
        expr{ &e, x }
        ch{ &e, c = ')' }
    }

    // temps_args for a call: an argument passed as a copy needs its temporary, and one passed
    // as its place has a pointer to it.
    fn temps_call { mut e: E, args: []ir::Arg, c: Callee } -> Temps {
        let mut effects: usize = 0
        let mut vars: usize = 0
        let mut copies = false
        let mut i = 0
        while i < args.len {
            let x = args[i].value
            if not pure{ e, x } { effects = effects + 1 }
            if not constant{ x } { vars = vars + 1 }
            if pass{ e, args, i, c } is copy { copies = true }
            i = i + 1
        }
        if not copies and (effects == 0 or vars < 2) { return Temps{ on = false, base = 0 } }
        let base = e.temp
        e.temp = e.temp + @as(u32, args.len)
        put{ &e, a = "({ " }
        i = 0
        while i < args.len {
            let x = args[i].value
            tn{ &e, t = x.ty }
            if pass{ e, args, i, c } is place {
                put{ &e, a = " *" }
                tmp{ &e, k = base + @as(u32, i) }
                put{ &e, a = " = " }
                address{ &e, x }
            } else {
                ch{ &e, c = ' ' }
                tmp{ &e, k = base + @as(u32, i) }
                put{ &e, a = " = " }
                e.given = Given::call
                expr{ &e, x }
            }
            put{ &e, a = "; " }
            i = i + 1
        }
        return Temps{ on = true, base }
    }

    // Operand i: its temporary, or the expression itself.
    fn operand { mut e: E, x: ir::Expr, tt: Temps, i: u32 } {
        if tt.on { tmp{ &e, k = tt.base + i } } else { expr{ &e, x } }
    }

    fn close_temps { mut e: E, tt: Temps } {
        if tt.on { put{ &e, a = "; })" } }
    }

    // Must a and b go into temporaries?
    fn ordered { e: E, a: ir::Expr, b: ir::Expr } -> bool {
        let pa = pure{ e, x = a }
        let pb = pure{ e, x = b }
        if pa and pb { return false }
        return not constant{ x = a } and not constant{ x = b }
    }

    // No effects, no panics: reading it earlier or later gives the same result, as long as
    // nothing between writes memory.
    fn pure { e: E, x: ir::Expr } -> bool {
        return match x.k {
            int | float | boolean | str | sbytes | cstr | nil | local | fnref => { true }
            deref{ ptr = a } | field{ base = a } | payload{ base = a } | addr{ place = a }
            | lnot{ e = a } | isnull{ e = a } | notnull{ e = a } | widen{ e = a } | some{ e = a }
            | cast{ e = a } | ptraddr{ e = a } | trunc{ e = a } | fnconv{ e = a } | repeat{ elem = a } => {
                pure{ e, x = a.* }
            }
            seq{ first = a, then = b } | land{ a, b } | lor{ a, b } | cmp{ a, b } | bits{ a, b }
            | ptradd{ p = a, n = b } | wrap{ a, b } => {
                pure{ e, x = a.* } and pure{ e, x = b.* }
            }
            arith{ a, b }      => { float_type{ e, t = x.ty } and pure{ e, x = a.* } and pure{ e, x = b.* } }
            neg{ e = a }       => { float_type{ e, t = x.ty } and pure{ e, x = a.* } }
            record{ items }    => { pure_args{ e, args = items } }
            variant{ items }   => { pure_args{ e, args = items } }
            array{ elems }     => {
                let mut i = 0
                let mut ok = true
                while i < elems.len {
                    if not pure{ e, x = elems[i] } { ok = false }
                    i = i + 1
                }
                ok
            }
            else => { false }
        }
    }

    fn pure_args { e: E, args: []ir::Arg } -> bool {
        let mut i = 0
        while i < args.len {
            if not pure{ e, x = args[i].value } { return false }
            i = i + 1
        }
        return true
    }

    // The same value whenever it is computed, whatever else runs.
    fn constant { x: ir::Expr } -> bool {
        return match x.k {
            int | float | boolean | str | sbytes | cstr | nil | fnref => { true }
            addr{ place } => { fixed_place{ x = place.* } }
            else    => { false }
        }
    }

    // A place whose address doesn't depend on memory: a local, or a field or payload of one.
    fn fixed_place { x: ir::Expr } -> bool {
        return match x.k {
            local                         => { true }
            field{ base } | payload{ base } => { fixed_place{ x = base.* } }
            else             => { false }
        }
    }

    fn is_place { x: ir::Expr } -> bool {
        return match x.k {
            local | constref => { true }
            deref | sindex   => { true }
            field{ base }   => { is_place{ x = base.* } }
            index{ base }   => { is_place{ x = base.* } }
            payload{ base } => { is_place{ x = base.* } }
            else            => { false }
        }
    }

    // ---- types, briefly

    fn ty { e: E, id: ir::TypeId } -> ir::Type {
        return e.p.types[id]
    }

    fn is_void { e: E, t: ir::TypeId } -> bool {
        return ty{ e, id = t } is void
    }

    fn prim_of { e: E, t: ir::TypeId } -> ?ir::Prim {
        let prim{ p } = ty{ e, id = t } else { return null }
        return p
    }

    fn float_type { e: E, t: ir::TypeId } -> bool {
        let value = prim_of{ e, t } ifnull { return false }
        return is_float{ p = value }
    }

    fn is_float { p: ir::Prim } -> bool {
        return match p { f32 => { true } f64 => { true } else => { false } }
    }

    fn is_signed { p: ir::Prim } -> bool {
        return match p { i8 => { true } i16 => { true } i32 => { true } i64 => { true } else => { false } }
    }

    // The runtime's name for an integer type: usize is u64.
    fn suffix { mut e: E, p: ir::Prim } {
        match p {
            usize => { put{ &e, a = "u64" } }
            else  => { prim_name{ &e, p } }
        }
    }

    fn prim_name { mut e: E, p: ir::Prim } {
        match p {
            i8    => { put{ &e, a = "i8" } }
            i16   => { put{ &e, a = "i16" } }
            i32   => { put{ &e, a = "i32" } }
            i64   => { put{ &e, a = "i64" } }
            u8    => { put{ &e, a = "u8" } }
            u16   => { put{ &e, a = "u16" } }
            u32   => { put{ &e, a = "u32" } }
            u64   => { put{ &e, a = "u64" } }
            usize => { put{ &e, a = "usize" } }
            f32   => { put{ &e, a = "f32" } }
            f64   => { put{ &e, a = "f64" } }
            bool  => { put{ &e, a = "bool" } }
        }
    }

    // ---- text

    fn fresh { mut e: E } -> u32 {
        let k = e.temp
        e.temp = e.temp + 1
        return k
    }

    // `tT _tK = `
    fn declare { mut e: E, t: ir::TypeId, k: u32 } {
        tn{ &e, t }
        ch{ &e, c = ' ' }
        tmp{ &e, k }
        put{ &e, a = " = " }
    }

    // `tT _tK; `, the result of an `if` or `match` expression.
    fn result_var { mut e: E, t: ir::TypeId, k: u32 } {
        tn{ &e, t }
        ch{ &e, c = ' ' }
        tmp{ &e, k }
        put{ &e, a = "; " }
    }

    fn tmp { mut e: E, k: u32 } {
        put{ &e, a = "_t" }
        num{ &e, n = k }
    }

    // Slot `slot`'s value: lN, or (*lN) for a param passed by reference.
    fn local { mut e: E, slot: u32 } {
        let r = ref_slot{ e, slot }
        if r { put{ &e, a = "(*" } }
        ch{ &e, c = 'l' }
        num{ &e, n = slot }
        if r { ch{ &e, c = ')' } }
    }

    // Slot `slot`, to be written: never a param passed by reference, which is the caller's.
    fn target { mut e: E, slot: u32 } {
        if ref_slot{ e, slot } { @panic("emit: a write to a param passed by reference") }
        local{ &e, slot }
    }

    fn ref_slot { e: E, slot: u32 } -> bool {
        return slot < e.f.params.len and e.f.symbol.len == 0 and by_ref{ e, q = e.f.params[slot] }
    }

    // Type t's name: a marker, or in the types of a unit (unit_text), its name there.
    fn tn { mut e: E, t: ir::TypeId } {
        if not e.direct {
            mark_id{ &e, kind = 't', id = t }
            return
        }
        ch{ &e, c = 't' }
        num{ &e, n = number{ l = &e.lt, id = t } }
    }

    // Type t, whose definition the function needs whether or not its text names it: the type of
    // an expression, or one its C reaches through a pointer.
    fn use { mut e: E, t: ir::TypeId } {
        if e.direct { return }
        if e.assembling {
            _ = number{ l = &e.lt, id = t }
            return
        }
        let mark = e.f.id + 1
        if list::items{ list = e.used }[t] == mark { return }
        list::items{ list = e.used }[t] = mark
        try! list::push{ list = &e.uses, item = t }
    }

    // `LINE, COL, FILE`: the file by its id (start), not the IR's index.
    fn position { mut e: E, p: ir::Pos } {
        num{ &e, n = p.line }
        put{ &e, a = ", " }
        num{ &e, n = p.col }
        put{ &e, a = ", " }
        num{ &e, n = list::items{ list = e.files }[p.file] }
    }

    // A C string literal: printable ASCII as is, except `"`, `\` and `?`; other bytes as octal.
    fn cstr { mut e: E, b: ir::Bytes } {
        ch{ &e, c = '"' }
        let mut i = 0
        while i < b.len {
            let c = b[i]
            if c >= 32 and c <= 126 and c != '"' and c != '\\' and c != '?' {
                ch{ &e, c }
            } else {
                ch{ &e, c = '\\' }
                ch{ &e, c = '0' + c / 64 }
                ch{ &e, c = '0' + c / 8 % 8 }
                ch{ &e, c = '0' + c % 8 }
            }
            i = i + 1
        }
        ch{ &e, c = '"' }
    }

    fn nl { mut e: E } {
        ch{ &e, c = '\n' }
        let mut i = 0
        while i < e.depth {
            put{ &e, a = "    " }
            i = i + 1
        }
    }

    fn put { mut e: E, a: []u8 } {
        ir_print::text{ o = &e.o, a }
    }

    fn ch { mut e: E, c: u8 } {
        ir_print::char{ o = &e.o, c }
    }

    fn num { mut e: E, n: u64 } {
        ir_print::num{ o = &e.o, n }
    }

    fn raw { mut e: E, b: ir::Bytes } {
        ir_print::bytes{ o = &e.o, b }
    }

}
