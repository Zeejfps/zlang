// Compile-time consts (§14): a const whose initializer folding can't compute is evaluated. The
// initializer is lowered as a program of its own (lower::alone), run in the interpreter
// (eval.ctx) without the externs `ctxc interp` emulates, and its result read back by the const's
// type into a check::Val, the value folding would have computed. A converted literal (PLAN.md
// 4.5) is computed the same way, by running its `#convert` fn on its bytes.
//
//   let v = comptime::value{ &c, d, e }            // const d, whose initializer is e; null after an error
//   let v = comptime::literal{ &c, f, e, bytes }   // literal e, converted by fn f
//
// A const has no context, so it holds no capability, and nothing it runs can reach the world:
// an extern fn stops it. So do a panic, running out of fuel and too deep a recursion, each a
// compile error at the initializer. A conversion takes only its literal, so the same holds, and
// its error result is a compile error at the literal too. The result holds no pointer but a []u8
// or *u8 into a literal's bytes, which outlive compiling as the program's static data.

namespace comptime {
    type Heap = arena::Arena
    type Id = types::Id

    const FUEL: u64 = 100000000             // the steps a const may take, a few seconds' worth
    const STACK: u64 = 4194304              // the bytes of ctxc's stack its calls may take
    const SCRATCH: usize = 33554432         // the interpreter's memory: its 16 MiB stack and data

    // A result being read back: the machine that computed it, and what it is the value of, for
    // messages: "const `NAME`" or "string literal".
    struct Reader { m: *mut eval::M, what: []u8, at: source::Span }

    // Const d's value, computed by running its initializer e; null after reporting why it has
    // none. A const it needs is computed first, as lowering meets it.
    fn value { mut c: check::Checker, d: u32, e: syntax::Expr } -> ?check::Val {
        let name = check::get_decl{ c, d }.qual
        let mut w = check::message{ c }
        try! @fmt(&w, "const `{}`", check::str{ s = name })
        let what = utf8::view{ b = w }.bytes
        let at = check::expr_at{ e }
        let p = lower::alone{ &c, d } ifnull { return null }
        let mem = scratch{ &c, at, what } ifnull { return null }
        let mut heap = arena::new{ buf = mem }
        let mut m = eval::machine{ heap = &heap, p, name, emulate = false, fuel = c.fuel, stack = c.stack }
        let out = eval::run{ &m, callee = p.main, args = slice::empty([]u8){} }
        let mut r = Reader{ m = &m, what, at }
        let a = result{ &c, &r, out, p } ifnull { return null }
        return back{ &c, &r, t = check::get_decl{ c, d }.ty, a }
    }

    // The value conversion f gives literal e, whose bytes are `bytes`: f's result, run on them,
    // or for a !T its value, since an error is a compile error at the literal, printed as @fmt
    // prints one. Null after reporting why it has none.
    fn literal { mut c: check::Checker, f: u32, e: syntax::Expr, bytes: []u8 } -> ?check::Val {
        let what: []u8 = "string literal"
        let at = check::expr_at{ e }
        // The same bytes convert the same way.
        let mut kb = list::new(u8){ realloc = arena::alloc, heap = c.heap }
        try! list::push{ list = &kb, item = @trunc(u8, f) }
        try! list::push{ list = &kb, item = @trunc(u8, f >> 8) }
        try! list::push{ list = &kb, item = @trunc(u8, f >> 16) }
        try! list::push{ list = &kb, item = @trunc(u8, f >> 24) }
        let mut i: usize = 0
        while i < bytes.len {
            try! list::push{ list = &kb, item = bytes[i] }
            i = i + 1
        }
        let key = list::items{ list = kb }
        let known = map::get{ m = c.lit_cache, key }
        if known != null { return known }
        let p = program{ &c, f, at } ifnull { return null }
        let mem = scratch{ &c, at, what } ifnull { return null }
        let mut heap = arena::new{ buf = mem }
        let name = check::get_decl{ c, d = f }.qual
        let mut m = eval::machine{ heap = &heap, p, name, emulate = false, fuel = c.fuel, stack = c.stack }
        // f's one field, a strlit: a view of the bytes in static data, with the hidden zero after them.
        let s = eval::literal{ &m, bytes } iferr {
            report{ &c, at, what, msg = "couldn't be computed while compiling: out of memory" }
            return null
        }
        let mut arg: [16]u8
        eval::put_bits{ b = arg[..8], v = s }
        eval::put_bits{ b = arg[8..], v = @as(u64, bytes.len) }
        let view: []u8 = arg[..]
        let args: [1][]u8 = [view]
        let out = eval::run{ &m, callee = p.main, args = args[..] }
        let mut r = Reader{ m = &m, what, at }
        let a = result{ &c, &r, out, p } ifnull { return null }
        let ty = types::prune{ s = c.ty, t = check::get_decl{ c, d = f }.ret }
        let res{ ok, errs } = types::get{ s = c.ty, id = ty } else {
            let v = back{ &c, &r, t = ty, a } ifnull { return null }
            try! map::put{ m = &c.lit_cache, key, value = v }
            return v
        }
        // r holds the address of m, a local, so a reporter's result isn't returned as it is.
        let u = check::union_offsets{ &c, t = ty } ifnull {
            _ = unknown{ &c, r, t = ty }
            return null
        }
        let tag = load{ &r, a, n = 4 } ifnull {
            _ = unread{ &c, r }
            return null
        }
        if tag > 1 {
            _ = no_variant{ &c, r, t = ty, tag }
            return null
        }
        if tag == 1 {
            let mut b = check::message{ c }
            try! @fmt(&b, "{}: ", check::str{ s = what })
            try! error_text{ &c, &r, t = errs, a = a + u.offs[1][0], &b }
            check::error{ &c, at, msg = utf8::view{ b } }
            return null
        }
        let v = back{ &c, &r, t = ok, a = a + u.offs[0][0] } ifnull { return null }
        try! map::put{ m = &c.lit_cache, key, value = v }
        return v
    }

    // Conversion f as a program of its own, lowered the first time a literal needs it; null if
    // it can't be, after reporting why. Its code can't need the value of a literal it converts.
    fn program { mut c: check::Checker, f: u32, at: source::Span } -> ?ir::Program {
        let known = map::get{ m = c.conv_progs, key = f }
        if known != null { return known }
        let name = check::get_decl{ c, d = f }.qual
        if check::has_id{ xs = list::items{ list = c.converting }, n = f } {
            let mut b = check::message{ c }
            try! @fmt(&b, "string literal needs `{}` to run while compiling, and running `{}` needs this literal's value", check::str{ s = name }, check::str{ s = name })
            check::error{ &c, at, msg = utf8::view{ b } }
            return null
        }
        check::push{ xs = &c.converting, n = f }
        let p = lower::alone{ &c, d = f }
        _ = list::pop{ list = &c.converting }
        if p == null { return null }
        try! map::put{ m = &c.conv_progs, key = f, value = p }
        return p
    }

    // The interpreter's memory, allocated once: each run starts over in it. Null after reporting
    // that there is none.
    fn scratch { mut c: check::Checker, at: source::Span, what: []u8 } -> ?alloc::Bytes {
        if c.scratch.len == 0 {
            c.scratch = alloc::resize(u8, Heap){ realloc = arena::alloc, heap = c.heap, mem = slice::empty(u8){}, count = SCRATCH } iferr {
                report{ &c, at, what, msg = "couldn't be computed while compiling: out of memory" }
                return null
            }
        }
        return c.scratch
    }

    // The address of a run's result, copied where the reader can address it; null after
    // reporting why the run stopped, or why its result can't be copied.
    fn result { mut c: check::Checker, mut r: Reader, out: eval::Outcome, p: ir::Program } -> ?eval::Addr {
        let ok{ value } = out else {
            stopped{ &c, at = r.at, what = r.what, m = r.m.*, p }
            return null
        }
        let a = eval::heap_bytes{ m = r.m, n = @as(u64, value.len) } iferr {
            report{ &c, at = r.at, what = r.what, msg = "couldn't be computed while compiling: out of memory" }
            return null
        }
        let dst = eval::at{ m = r.m, a, n = @as(u64, value.len) } iferr {
            _ = unread{ &c, r }
            return null
        }
        slice::copy(u8){ dst, src = value }
        return a
    }

    // An error of type t at a, as @fmt writes one (lower's error_write): its name, and its
    // payload as `{ field = value, ... }`, each value a number or bool, or `_`.
    fn error_text { mut c: check::Checker, mut r: Reader, t: Id, a: eval::Addr, mut b: utf8::Builder(Heap) } -> ! {
        let et = check::eset_of{ &c, t }
        let vs = check::variants_of{ &c, t = et }
        let u = check::union_offsets{ &c, t = et } ifnull { return }
        let tag = load{ &r, a, n = 4 } ifnull { return }
        if tag >= @as(u64, vs.len) { return }
        let index = @as(usize, tag)
        try utf8::push{ &b, s = check::str{ s = vs[index].name } }
        let fields = vs[index].fields ifnull { return }
        if fields.len == 0 { return }
        let mut i: usize = 0
        while i < fields.len {
            try @fmt(&b, "{}{} = ", check::str{ s = if i == 0 { "{ " } else { ", " } }, check::str{ s = fields[i].name })
            try field_text{ &c, &r, t = fields[i].ty, a = a + u.offs[index][i], &b }
            i = i + 1
        }
        try utf8::push{ &b, s = " }" }
    }

    // A value of type t at a, as an error's field in a message: a number or bool, or `_` for
    // any other type. The compiler names no std type, so a utf8::String is `_` too.
    fn field_text { mut c: check::Checker, mut r: Reader, t: Id, a: eval::Addr, mut b: utf8::Builder(Heap) } -> ! {
        let ty = types::prune{ s = c.ty, t }
        let p = types::prim_of{ s = c.ty, t = ty }
        if p != null {
            let v = scalar{ &r, ty, p, a } ifnull { return utf8::push{ &b, s = "_" } }
            match v {
                int{ negative, magnitude } => { return @fmt(&b, "{}{}", check::str{ s = if negative { "-" } else { "" } }, magnitude) }
                float{ value } => {
                    if p == types::Prim::f32 { return utf8::push_f32{ &b, n = @as(f32, value) } }
                    return utf8::push_f64{ &b, n = value }
                }
                boolean{ value } => { return utf8::push_bool{ &b, v = value } }
                else => {}
            }
        }
        return utf8::push{ &b, s = "_" }
    }

    // Why the run of `what` stopped, as an error at at.
    fn stopped { mut c: check::Checker, at: source::Span, what: []u8, m: eval::M, p: ir::Program } {
        let mut b = check::message{ c }
        match m.why {
            panic{ pos, msg } => {
                try! @fmt(&b, "panicked while compiling: {}", check::str{ s = msg })
                if pos != null {
                    let file = if pos.file < p.files.len { p.files[pos.file] } else { "" }
                    if slice::eq_bytes{ a = file, b = c.files[at.file].name } {
                        try! @fmt(&b, ", at {}:{}", pos.line, pos.col)
                    } else {
                        try! @fmt(&b, ", at {}:{}:{}", check::str{ s = file }, pos.line, pos.col)
                    }
                }
            }
            fuel => { try! @fmt(&b, "ran out of fuel while compiling: it took more than {} steps", c.fuel) }
            deep => {
                let text = failure{ m }
                let rest = if text.len > 10 and slice::eq_bytes{ a = text[..10], b = "too deep: " } { text[10..] } else { text }
                try! @fmt(&b, "recursed too deeply while compiling: {}", check::str{ s = rest })
            }
            external{ name = f } => { try! @fmt(&b, "calls extern fn `{}`, which can't run while compiling", check::str{ s = f }) }
            none => { try! @fmt(&b, "couldn't be computed while compiling: {}", check::str{ s = failure{ m } }) }
        }
        report{ &c, at, what, msg = utf8::view{ b } }
    }

    fn failure { m: eval::M } -> []u8 {
        return match m.stop {
            failed{ msg } => { msg }
            panic{ text } => { text }
            else => { "" }
        }
    }

    // "WHAT MSG" at at: "const `NAME` MSG" or "string literal MSG".
    fn report { mut c: check::Checker, at: source::Span, what: []u8, msg: utf8::String } {
        let mut b = check::message{ c }
        try! @fmt(&b, "{} {}", check::str{ s = what }, msg)
        check::error{ &c, at, msg = utf8::view{ b } }
    }

    // ---- reading the result back

    // The value of type t at address a, as folding gives it: a []u8, strlit or *u8 as the bytes
    // of the literal it points into. Null after reporting what it can't hold, or why it can't
    // be read.
    fn back { mut c: check::Checker, mut r: Reader, t: Id, a: eval::Addr } -> ?check::Val {
        let ty = types::prune{ s = c.ty, t }
        match types::get{ s = c.ty, id = ty } {
            prim{ p } => {
                let v = scalar{ &r, ty, p, a } ifnull { return unread{ &c, r } }
                return v
            }
            enumeration{ decl } => {
                let p = types::prim_of{ s = c.ty, t = types::prune{ s = c.ty, t = check::get_decl{ c, d = decl }.ty } } ifnull { return unknown{ &c, r, t = ty } }
                let v = scalar{ &r, ty, p, a } ifnull { return unread{ &c, r } }
                return v
            }
            array{ n, elem } => {
                let et = types::prune{ s = c.ty, t = elem }
                let lay = check::layout{ &c, t = et } ifnull { return unknown{ &c, r, t = ty } }
                if et == types::U8 {
                    let bytes = mem{ &r, a, n } ifnull { return unread{ &c, r } }
                    return check::Val::str{ ty, bytes = keep{ c, bytes } }
                }
                let mut out = list::new(check::Val){ realloc = arena::alloc, heap = c.heap }
                let mut i: u64 = 0
                while i < n {
                    let v = back{ &c, &r, t = et, a = a + i * lay.size } ifnull { return null }
                    try! list::push{ list = &out, item = v }
                    i = i + 1
                }
                return check::Val::array{ ty, elems = list::items{ list = out } }
            }
            slice{ elem, mutable } => {
                if types::prune{ s = c.ty, t = elem } == types::U8 and not mutable { return view{ &c, &r, ty, a } }
                let ptr = word{ &r, a } ifnull { return unread{ &c, r } }
                return pointer{ &c, r, t = ty, p = ptr }
            }
            strlit => { return view{ &c, &r, ty, a } }
            ptr{ elem, mutable } => {
                let p = word{ &r, a } ifnull { return unread{ &c, r } }
                // A *u8 into a literal's bytes: the rest of them, with the hidden zero after them,
                // as a c::String's pointer is.
                if types::prune{ s = c.ty, t = elem } == types::U8 and not mutable {
                    let rest = eval::literal_rest{ m = r.m.*, a = p }
                    if rest != null { return check::Val::cstr{ ty, bytes = rest } }
                }
                return pointer{ &c, r, t = ty, p }
            }
            record{ decl } => {
                if check::untagged_type{ c, t = ty } { return cannot{ &c, r, what = "an extern union" } }
                let fields = check::struct_fields{ &c, t = ty }
                let offs = check::struct_offsets{ &c, t = ty } ifnull { return unknown{ &c, r, t = ty } }
                let mut out = list::new(check::Val){ realloc = arena::alloc, heap = c.heap }
                let mut i: usize = 0
                while i < fields.len {
                    let v = back{ &c, &r, t = fields[i].ty, a = a + offs.offs[i] } ifnull { return null }
                    try! list::push{ list = &out, item = v }
                    i = i + 1
                }
                return check::Val::record{ ty, fields = list::items{ list = out } }
            }
            opt{ elem } => {
                if check::nullable_ptr{ c, t = ty } {
                    // the pointer itself, null as 0
                    let p = word{ &r, a } ifnull { return unread{ &c, r } }
                    if p == 0 { return check::Val::nil{ ty } }
                    let v = back{ &c, &r, t = elem, a } ifnull { return null }
                    return check::Val::variant{ ty, index = 1, fields = one{ c, v } }
                }
                return tagged{ &c, &r, ty, a }
            }
            sum => { return tagged{ &c, &r, ty, a } }
            func => { return cannot{ &c, r, what = "a function value: it would point to memory that doesn't outlive compiling" } }
            else => {
                let mut b = check::message{ c }
                try! @fmt(&b, "a value of type {}", check::tstr{ c, t = ty })
                return cannot{ &c, r, what = utf8::view{ b }.bytes }
            }
        }
    }

    // A []u8 or strlit: the bytes of the literal it views.
    fn view { mut c: check::Checker, mut r: Reader, ty: Id, a: eval::Addr } -> ?check::Val {
        let ptr = word{ &r, a } ifnull { return unread{ &c, r } }
        let len = word{ &r, a = a + 8 } ifnull { return unread{ &c, r } }
        if len == 0 { return check::Val::sbytes{ ty, bytes = slice::empty(u8){} } }
        let rest = eval::literal_rest{ m = r.m.*, a = ptr }
        if rest != null and len <= @as(u64, rest.len) { return check::Val::sbytes{ ty, bytes = rest[..@as(usize, len)] } }
        return pointer{ &c, r, t = ty, p = ptr }
    }

    // A union or optional with a tag: null, or the variant with its payload's fields.
    fn tagged { mut c: check::Checker, mut r: Reader, ty: Id, a: eval::Addr } -> ?check::Val {
        let tag = load{ &r, a, n = 4 } ifnull { return unread{ &c, r } }
        let index = @trunc(u32, tag)
        if types::get{ s = c.ty, id = ty } is opt and index == 0 { return check::Val::nil{ ty } }
        let vs = check::variants_of{ &c, t = ty }
        let u = check::union_offsets{ &c, t = ty } ifnull { return unknown{ &c, r, t = ty } }
        if tag >= @as(u64, vs.len) { return no_variant{ &c, r, t = ty, tag } }
        let fields = vs[index].fields ifnull { return check::Val::variant{ ty, index, fields = slice::empty(check::Val){} } }
        let mut out = list::new(check::Val){ realloc = arena::alloc, heap = c.heap }
        let mut j: usize = 0
        while j < fields.len {
            let v = back{ &c, &r, t = fields[j].ty, a = a + u.offs[index][j] } ifnull { return null }
            try! list::push{ list = &out, item = v }
            j = j + 1
        }
        return check::Val::variant{ ty, index, fields = list::items{ list = out } }
    }

    // A number, bool or enum value of prim p.
    fn scalar { mut r: Reader, ty: Id, p: types::Prim, a: eval::Addr } -> ?check::Val {
        let n = @as(u64, types::bits{ p })
        let v = load{ &r, a, n = n / 8 } ifnull { return null }
        if p == types::Prim::bool { return check::Val::boolean{ ty, value = v != 0 } }
        if p == types::Prim::f64 { return check::Val::float{ ty, value = eval::f64_of{ v } } }
        if p == types::Prim::f32 { return check::Val::float{ ty, value = @as(f64, eval::f32_of{ v }) } }
        if types::signed{ p } {
            if n == 64 and v >= 9223372036854775808 { return check::Val::int{ ty, negative = true, magnitude = @wrap_sub(@as(u64, 0), v) } }
            if n < 64 and v >= @as(u64, 1) << @trunc(u32, n - 1) {
                return check::Val::int{ ty, negative = true, magnitude = (@as(u64, 1) << @trunc(u32, n)) - v }
            }
        }
        return check::Val::int{ ty, negative = false, magnitude = v }
    }

    // What a pointer p of type t that isn't a literal's bytes can't be: it points into memory
    // that only the run had, or a literal's bytes are something else's than a []u8's.
    fn pointer { mut c: check::Checker, r: Reader, t: Id, p: eval::Addr } -> ?check::Val {
        if eval::literal_rest{ m = r.m.*, a = p } != null {
            let mut b = check::message{ c }
            try! @fmt(&b, "a {} into a literal: only a []u8 or a *u8 can point into one", check::tstr{ c, t })
            return cannot{ &c, r, what = utf8::view{ b }.bytes }
        }
        let region = p >> eval::SHIFT
        let regions = list::items{ list = r.m.regions }
        let mut what: []u8 = "a pointer"
        if region == @as(u64, eval::STACK) {
            what = "a pointer to the stack"
        } else if region > @as(u64, eval::STACK) and region < @as(u64, regions.len) {
            if not regions[@as(usize, region)].writable {
                return cannot{ &c, r, what = "a pointer into const storage: const values cannot retain array views" }
            }
            what = "a pointer to the heap"
        }
        let mut b = check::message{ c }
        try! @fmt(&b, "{}: it would point to memory that doesn't outlive compiling", check::str{ s = what })
        return cannot{ &c, r, what = utf8::view{ b }.bytes }
    }

    // Null, after reporting "const `NAME` can't hold WHAT", or "string literal can't ...".
    fn cannot { mut c: check::Checker, r: Reader, what: []u8 } -> ?check::Val {
        let mut b = check::message{ c }
        try! @fmt(&b, "can't hold {}", check::str{ s = what })
        report{ &c, at = r.at, what = r.what, msg = utf8::view{ b } }
        return null
    }

    // Null, after reporting that the result's tag, which a value made through an extern union
    // can set to anything, names no variant of t.
    fn no_variant { mut c: check::Checker, r: Reader, t: Id, tag: u64 } -> ?check::Val {
        let mut b = check::message{ c }
        try! @fmt(&b, "a {} with tag {}: it has no such variant", check::tstr{ c, t }, tag)
        return cannot{ &c, r, what = utf8::view{ b }.bytes }
    }

    // Null, after reporting that a value of type t can't be read back: ctxc has no layout for it.
    fn unknown { mut c: check::Checker, r: Reader, t: Id } -> ?check::Val {
        let mut b = check::message{ c }
        try! @fmt(&b, "a value of type {}, whose layout isn't known", check::tstr{ c, t })
        return cannot{ &c, r, what = utf8::view{ b }.bytes }
    }

    // Null, after reporting why the result's memory couldn't be read, as the interpreter says.
    fn unread { mut c: check::Checker, r: Reader } -> ?check::Val {
        let mut b = check::message{ c }
        try! @fmt(&b, "couldn't be computed while compiling: {}", check::str{ s = failure{ m = r.m.* } })
        report{ &c, at = r.at, what = r.what, msg = utf8::view{ b } }
        return null
    }

    fn word { mut r: Reader, a: eval::Addr } -> ?u64 {
        return load{ &r, a, n = 8 }
    }

    fn load { mut r: Reader, a: eval::Addr, n: u64 } -> ?u64 {
        return eval::load{ m = r.m, a, n } iferr { null }
    }

    fn mem { mut r: Reader, a: eval::Addr, n: u64 } -> ?[]u8 {
        return eval::at{ m = r.m, a, n } iferr { null }
    }

    // bytes, copied out of the interpreter's memory, which the next const reuses.
    fn keep { c: check::Checker, bytes: []u8 } -> []u8 {
        let out = try! alloc::resize(u8, Heap){ realloc = arena::alloc, heap = c.heap, mem = slice::empty(u8){}, count = bytes.len }
        slice::copy(u8){ dst = out, src = bytes }
        return out
    }

    fn one { c: check::Checker, v: check::Val } -> []check::Val {
        let mut out = list::new(check::Val){ realloc = arena::alloc, heap = c.heap }
        try! list::push{ list = &out, item = v }
        return list::items{ list = out }
    }
}
