// The checker, a port of ctxi/checker.py. So far: collecting declarations into namespaces,
// resolving the types in their signatures (§10, §12), enum values and array lengths, layouts,
// const initializers, function bodies with their statements, expressions, calls, binds,
// `match`, `let ... else` and narrowing (§8), definite initialization (§11), the safety checks
// (exclusivity §3.1, escape analysis §14, bound-function scope §6), and the rules for `main`
// (§15). Monomorphization and IR come next (PLAN.md stage 6).
//
//   let mut c = check::new{ files, std_files, &heap, &diags }
//   check::program{ &c }
//
// It reports what ctxi reports, in the same order: the phases run as ctxi's do, over the files
// and declarations in ctxi's order. Instead of stopping at an error it goes on, with the error
// type (types::ERROR) where a type couldn't be resolved, and reports each message once.
//
// What it learns goes in side tables keyed by a node's file and id, not into the tree: the
// declaration each syntax declaration became, what each name refers to, each type expression's
// and expression's type, the local each `let` and binder declares, and the conversions ctxi
// writes into its tree as nodes.

namespace check {
    type Heap = arena::Arena
    type Id = types::Id

    const NONE: u32 = 4294967295

    // A diagnostic about the program as a whole, such as a missing `main`, has this file and is
    // shown at 1:1.
    const NO_FILE: u32 = 4294967295

    // The namespaces every program has. Universe holds the primitives and capabilities, std the
    // standard library's top level, and root the program's own, which sees std's names.
    const UNIVERSE: u32 = 0
    const STD: u32 = 1
    const ROOT: u32 = 2

    // Checker.calling when no callee is being checked: no expression has this key.
    const NO_CALLEE: u64 = 18446744073709551615

    // An @fmt's error set is owned by SITE + the index of its Site: no declaration has so
    // large an index.
    const SITE: u32 = 2147483648

    // A source file: std's files come first, then the program's.
    struct File { name: []u8, text: []u8, lines: []u32, tree: syntax::File }

    enum Kind: u8 { func, record, sum, enumeration, alias, constant, external, cap, fault }

    // A union variant, resolved. A variant without a payload has null fields.
    struct Variant { name: []u8, fields: ?[]types::Field }

    // A declaration: what the checker knows of it. fields are a struct's fields or a function's
    // context, ty a const's type, an enum's base or a non-generic alias's type.
    struct Decl {
        kind:     Kind,
        name:     syntax::Name,
        ns:       u32,
        qual:     []u8,                 // the name with its namespaces, as messages show it
        syn:      syntax::Decl,
        tparams:  []syntax::Name,
        fields:   []types::Field,
        variants: []Variant,
        ret:      Id,
        ty:       Id,
        values:   []i64,                // an enum's, one per variant
        symbol:   []u8,                 // an extern fn's C symbol
        callback: bool,                 // a fn with `#c::callback`: C may call it (§18)
        includes: []u32,                // what a capability includes, directly or not (§15)
        vars:     []mut CVar,           // a capability's C variables, its own and included ones
    }

    // A capability's C variable (§15): `extern name: T` reads the C symbol `name`, or the one
    // `#c::symbol` gives. owner is the capability that declares it: only a function of owner's
    // namespace may read it, and owner's own entry has the symbol, once attributes are checked
    // (var_symbol).
    struct CVar { name: []u8, ty: Id, owner: u32, symbol: []u8 }

    // What a name in a path refers to.
    union Entry {
        space{ ns: u32 },
        decl{ i: u32 },
        prim{ p: types::Prim },
        anyerr,                         // `error`: the type of any error (§8, Errors)
        strlit,                         // a string literal's type (§11, Literals)
        attr{ a: Attribute },           // an attribute the compiler declares
    }

    // The attributes the compiler declares, in the universe: `#convert` (§18, Literal
    // conversions) and `#write` (§13, Formatting).
    enum Attribute: u8 { convert, write }

    struct Space {
        name:   []u8,
        qual:   []u8,
        parent: u32,                         // NONE for the universe
        paths:  map::Map([]u8, Entry, Heap),  // namespaces and types
        values: map::Map([]u8, Entry, Heap),  // functions and consts
    }

    // A use of a name, for the side table: what it resolved to.
    union Ref {
        space{ ns: u32 },
        decl{ i: u32 },
        prim{ p: types::Prim },
        param{ decl: u32, index: u32 },
        local{ var: u32 },
        anyerr,
        strlit,
        attr{ a: Attribute },
    }

    // Where a type expression is resolved: a namespace, and the generic parameters in scope,
    // with the types they stand for. owner declares them.
    struct Scope { ns: u32, owner: u32, names: []syntax::Name, args: []Id }

    struct Layout { size: u64, align: u64 }

    struct Checker {
        heap:      *mut Heap,
        diags:     *mut diag::Diags,
        files:     []File,
        std_files: usize,               // files[..std_files] are std's
        ty:        types::Store,
        spaces:    list::List(Space, Heap),
        decls:     list::List(Decl, Heap),
        // Declarations of each kind, in the order ctxi checks them.
        structs:   list::List(u32, Heap),
        unions:    list::List(u32, Heap),
        enums:     list::List(u32, Heap),
        aliases:   list::List(u32, Heap),
        consts:    list::List(u32, Heap),
        fns:       list::List(u32, Heap),
        externs:   list::List(u32, Heap),
        caps:      list::List(u32, Heap),          // capabilities with fields
        caps_done: map::Map(u32, bool, Heap),      // those whose fields are resolved
        cap_stack: list::List(u32, Heap),          // those being resolved, for a cycle of inclusions
        alias_stack: list::List(u32, Heap),
        const_stack: list::List(u32, Heap),
        // Side tables, keyed by key{ file, id }.
        decl_of:   map::Map(u64, u32, Heap),     // a syntax declaration's Decl
        space_of:  map::Map(u64, u32, Heap),     // a namespace declaration's Space
        uses:      map::Map(u64, Ref, Heap),     // a Name's referent
        type_of:   map::Map(u64, Id, Heap),      // a TypeExpr's type
        layouts:   map::Map(Id, Layout, Heap),
        busy:      map::Map(Id, bool, Heap),     // layouts being computed
        main:      u32,                          // NONE unless `main` is valid
        converts:  list::List(u32, Heap),        // the fns with a valid `#convert`, in order
        writers:   list::List(u32, Heap),        // the fns with a valid `#write`, in order
        cstr_decl: u32,                          // c::String, for its C layout, or NONE
        calling:   u64,                          // the callee being checked, whose field may be a capability's
        // The body being checked: a const's initializer or a function's body.
        sc:        Scope,
        ret:       Id,
        lits:      list::List(syntax::Expr, Heap),    // literals, whose types are settled at the end
        gvars:     list::List(GVar, Heap),            // generic arguments to infer
        fmts:      list::List(syntax::Expr, Heap),    // the body's @fmt calls, whose writers are settled at the end
        vars:      list::List(Var, Heap),             // the locals of every body, by index
        scope:     list::List(Binding, Heap),         // what is in scope, innermost last
        marks:     list::List(usize, Heap),           // where each open scope starts in `scope`
        depth:     u32,                               // open scopes, less the context's
        loop_depth: u32,
        loops:     list::List(Loop, Heap),            // the enclosing loops, innermost last
        loop_base: usize,                             // loops[..loop_base] are outside the defer
        defers:    u32,                               // `defer` bodies around the statement
        dead:      bool,                              // the flow state: see State
        defs:      []u32,
        maybe:     []u32,
        body_errors: usize,                           // errors before the body
        flow_errors: usize,                           // flow errors in the body
        // Side tables for expressions and statements, keyed by key{ file, id }.
        expr_ty:   map::Map(u64, Id, Heap),           // an expression's type; a branch value's too
        convs:     map::Map(u64, Conv, Heap),         // an implicit conversion of its value
        refs:      map::Map(u64, PathRef, Heap),      // what a path (or a callee) names
        literal:   map::Map(u64, bool, Heap),         // braces: a literal (true) or a call
        spreads:   map::Map(u64, bool, Heap),         // braces whose `..e`s are checked
        access:    map::Map(u64, Access, Heap),       // how a field or index reaches its value
        narrowed:  map::Map(u64, Id, Heap),           // a narrowed field's own ?T
        local_of:  map::Map(u64, u32, Heap),          // the local a `let` or a binder's field declares
        is_vars:   map::Map(u64, []u32, Heap),        // the locals an `is` binds, by its key
        forwards:  map::Map(u64, []Forward, Heap),    // what `..` supplies to a call
        site_of:   map::Map(u64, u32, Heap),          // an @fmt's site, by its key
        holds:     map::Map(u64, []Place, Heap),      // the places a bind holds
        // A loop that a jump from an inner loop leaves or repeats has an id (1, 2, ... in each
        // body), and the jump names it.
        loop_ids:  map::Map(u64, u32, Heap),          // a `while` statement's id
        jump_ids:  map::Map(u64, u32, Heap),          // the id of the loop a jump targets
        label_ids: u32,                               // ids given in this body
        first_var: map::Map(u32, u32, Heap),          // a function's first local: its first context field
        // Const values (§14): a const whose initializer checked is foldable if folding can
        // compute it, and its value is computed after every initializer has been checked. One
        // that needs more is evaluated (comptime.ctx), once the bodies are checked and the error
        // sets inferred (evaluate).
        foldable:  map::Map(u32, bool, Heap),
        evaluated: map::Map(u32, bool, Heap),
        values:    map::Map(u32, Val, Heap),
        folding:   list::List(u32, Heap),             // consts being computed, for cycles
        unfolded:  u32,                               // an evaluated const that folding met, or NONE
        can_eval:  bool,                              // whether evaluated consts can be computed yet
        fuel:      u64,                               // the steps evaluating a const may take
        stack:     u64,                               // the bytes of ctxc's stack its calls may take
        scratch:   alloc::Bytes,                      // the interpreter's memory, for one const at a time
        // Literal conversions (PLAN.md 4.4): a literal where a T is expected is the result of
        // the conversion to T, which runs once the bodies are checked, as an evaluated const.
        lit_convs: map::Map(u64, u32, Heap),          // a literal's conversion, by its key; NONE once it failed
        lit_list:  list::List(syntax::Expr, Heap),    // the converted literals, in the order they were checked
        lit_values: map::Map(u64, Val, Heap),         // their values, once computed
        lit_cache: map::Map([]u8, Val, Heap),         // by the conversion and the literal's bytes
        conv_progs: map::Map(u32, ir::Program, Heap), // each conversion as a program of its own
        converting: list::List(u32, Heap),            // the conversions being lowered, for cycles
        // The sets of Var.derived and Var.held.
        derived:   list::List([]u32, Heap),
        held:      list::List([]Place, Heap),
        // Errors (§8, Errors): their declarations, numbered in this order, and each function's
        // set, inferred from what flows into it while its body is checked (infer_sets).
        faults:    list::List(u32, Heap),
        fn_decl:   u32,                               // the function whose body is checked, or NONE
        flows:     map::Map(u32, Flow, Heap),         // by function
        sets:      map::Map(u32, []u32, Heap),        // by function, once inferred
        pending:   list::List(Pending, Heap),         // matches on errors, finished once they are
        pat_errs:  map::Map(u64, u32, Heap),          // the error a pattern names, by its name's key
        escapes:   list::List(Escape, Heap),          // escape errors that wait on the sets
        sites:     list::List(Site, Heap),            // every @fmt, whose set is owned by SITE + its index
        fault_writers: map::Map(u64, []Writer, Heap), // an error hole's field writers, by fault_key
        ptr_faults: bool,                             // whether some error's payload holds a pointer
    }

    // What flows into a function's error set: the errors it returns (atoms), the functions whose
    // errors it passes up (subs), and whether any error at all may (from a function type).
    struct Flow { atoms: []u32, subs: []u32, any: bool }

    // A match on errors, whose arms are checked against the set once it is inferred: the errors
    // it lists, where, and the arm that takes the rest (`else` or `err`), if any.
    struct Pending { at: source::Span, errs: Id, listed: []u32, spans: []source::Span, rest: ?source::Span, rest_word: []u8 }

    // An escape error (§14) about a value of type t that only a function's error set, unknown
    // while the bodies are checked, can make real: reported once the sets are inferred if t then
    // holds a pointer, and if flow errors were reported in its body when it was found.
    struct Escape { t: Id, at: source::Span, msg: utf8::String, report: bool }

    // A local, context field or match binding, or a narrowed view of one (ctxi's VarInfo).
    enum VarKind: u8 { ctx, local, bind, narrow }

    struct Var {
        name:       []u8,
        ty:         Id,
        kind:       VarKind,
        mutable:    bool,
        indirect:   bool,           // it holds a pointer to the place: a `mut` field, a `&f` binding
        tracked:    bool,           // `let x: T` without a value, which must be assigned before use
        narrow_of:  u32,            // what a narrowed view narrows, or NONE
        depth:      u32,
        loop_depth: u32,
        at:         source::Span,
        // For the safety checks: the locals whose addresses its value may hold (§14) and the
        // places a `&fn` in it holds (§3.1), as indexes into Checker.derived and .held. As in
        // ctxi, a narrowed view shares its local's set, the bindings of a pattern share one,
        // and a set grows in place.
        derived:    u32,
        held:       u32,
    }

    // What a scope holds: a local by name, or the narrowed type of a path of struct fields
    // (`a.b.c`) from a local.
    union Binding {
        local{ name: []u8, var: u32 },
        path{ root: u32, steps: [][]u8, ty: Id },
    }

    // An enclosing loop, with the flow state at each `break` that leaves it and each `continue`
    // that repeats it.
    struct Loop { label: []u8, key: u64, breaks: list::List(State, Heap), conts: list::List(State, Heap) }

    // The flow state at a point of a body (ctxi's State): the tracked locals assigned on every
    // path to it (defs) and on some path (maybe), and whether every path has ended (dead). A
    // local is tracked if it is declared without a value (`let x: T`), and only tracked locals
    // are in the sets. The sets are never changed in place, so a saved state stays as it was.
    struct State { defs: []u32, maybe: []u32, dead: bool }

    // How a field, index or `.len` expression reaches its value (ctxi's Field.kind and
    // Index.kind): through a pointer (p), in an array or slice (s). cvar is a capability's C
    // variable (§15), read through the capability or a pointer to it, and lit a strlit's bytes.
    enum Access: u8 { field, pfield, plen, len, slen, sptr, arr, slice, parr, ptr, cvar, lit }

    // A field that `..` supplies: the local of the same name, as `&name` for a `mut` field. ty is
    // the local's type, arg the argument's.
    struct Forward { name: []u8, var: u32, mutable: bool, ty: Id, arg: Id, conv: ?Conv }

    // A piece of an @fmt format: text, or a hole, `{}`. How it is written is known once the body
    // is finished: push is `write`, by writer, `error`, an error hole, whose name writer writes,
    // or `call`, a function hole called with the sink. ty is a hole's type then, and at is
    // where it is.
    struct Piece { hole: bool, text: []u8, push: []u8, writer: Writer, ty: Id, at: source::Span }

    // What narrows when a condition is true or false (§8): a local (var) or a path of struct
    // fields from one (root, with var NONE), narrowed to ty. With bind, var is a binding of an
    // `is` (§8, Is), declared where the fact holds, unless clash: another binding of its name
    // holds there too, and neither is declared.
    struct Fact { var: u32, root: u32, steps: [][]u8, ty: Id, at: source::Span, bind: bool, clash: bool }

    struct Facts { yes: []Fact, no: []Fact }

    // A branch of an `if` or `match` expression: the type of its value, or NO_TYPE if it has
    // none or leaves, and the expression (or nested `if` or `match`) that gives it.
    struct Branch { t: Id, value: Value }

    union Value { none, expr{ e: syntax::Expr }, nested{ s: syntax::Stmt } }

    // A generic argument left to inference, and how to describe it if inference fails.
    struct GVar { v: Id, param: []u8, owner: []u8, at: source::Span }

    // An implicit conversion, spelled out in ctxi's tree as a Coerce (to ?T) or ToSlice node. A
    // `null` takes its optional type, and widening is left for the IR. An array sliced with
    // `a[lo..hi]` is sliced through its address, a pointer of type ptr.
    union Conv { some{ to: Id }, slice{ to: Id }, addr_slice{ ptr: Id, to: Id } }

    // What a path in an expression names.
    union PathRef {
        local{ var: u32 },
        func{ decl: u32, targs: []Id },
        constant{ decl: u32 },
        variant{ ty: Id, index: u32 },
        enumval{ ty: Id, index: u32 },
        path{ e: Entry, seg: syntax::Seg },          // a type or namespace: not a value
        fault{ decl: u32 },                          // an error (§8, Errors)
    }

    fn new { files: []File, std_files: usize, mut heap: Heap, mut diags: diag::Diags } -> Checker {
        let mut c = Checker{
            heap = &heap, diags = &diags, files, std_files,
            ty = types::store{ &heap },
            spaces = list::new(Space){ realloc = arena::alloc, &heap },
            decls = list::new(Decl){ realloc = arena::alloc, &heap },
            structs = ids{ &heap }, unions = ids{ &heap }, enums = ids{ &heap }, aliases = ids{ &heap },
            consts = ids{ &heap }, fns = ids{ &heap }, externs = ids{ &heap }, caps = ids{ &heap },
            caps_done = map::new(u32, bool){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            cap_stack = ids{ &heap }, alias_stack = ids{ &heap }, const_stack = ids{ &heap },
            decl_of = map::new(u64, u32){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            space_of = map::new(u64, u32){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            uses = map::new(u64, Ref){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            type_of = map::new(u64, Id){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            layouts = map::new(Id, Layout){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            busy = map::new(Id, bool){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            main = NONE,
            converts = ids{ &heap },
            writers = ids{ &heap },
            cstr_decl = NONE,
            calling = NO_CALLEE,
            sc = Scope{ ns = ROOT, owner = NONE, names = no_names{}, args = slice::empty(Id){} },
            ret = types::VOID,
            lits = list::new(syntax::Expr){ realloc = arena::alloc, &heap },
            gvars = list::new(GVar){ realloc = arena::alloc, &heap },
            fmts = list::new(syntax::Expr){ realloc = arena::alloc, &heap },
            vars = list::new(Var){ realloc = arena::alloc, &heap },
            scope = list::new(Binding){ realloc = arena::alloc, &heap },
            marks = list::new(usize){ realloc = arena::alloc, &heap },
            depth = 0, loop_depth = 0,
            loops = list::new(Loop){ realloc = arena::alloc, &heap },
            loop_base = 0, defers = 0, dead = false,
            defs = slice::empty(u32){}, maybe = slice::empty(u32){}, body_errors = 0, flow_errors = 0,
            expr_ty = map::new(u64, Id){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            convs = map::new(u64, Conv){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            refs = map::new(u64, PathRef){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            literal = map::new(u64, bool){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            spreads = map::new(u64, bool){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            access = map::new(u64, Access){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            narrowed = map::new(u64, Id){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            local_of = map::new(u64, u32){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            is_vars = map::new(u64, []u32){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            forwards = map::new(u64, []Forward){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            site_of = map::new(u64, u32){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            holds = map::new(u64, []Place){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            loop_ids = map::new(u64, u32){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            jump_ids = map::new(u64, u32){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            label_ids = 0,
            first_var = map::new(u32, u32){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            foldable = map::new(u32, bool){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            evaluated = map::new(u32, bool){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            values = map::new(u32, Val){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            folding = ids{ &heap },
            unfolded = NONE, can_eval = false,
            fuel = comptime::FUEL, stack = comptime::STACK, scratch = slice::empty(u8){},
            lit_convs = map::new(u64, u32){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            lit_list = list::new(syntax::Expr){ realloc = arena::alloc, &heap },
            lit_values = map::new(u64, Val){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            lit_cache = map::new([]u8, Val){ realloc = arena::alloc, &heap, hash = map::hash_bytes, eq = slice::eq_bytes },
            conv_progs = map::new(u32, ir::Program){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            converting = ids{ &heap },
            derived = list::new([]u32){ realloc = arena::alloc, &heap },
            held = list::new([]Place){ realloc = arena::alloc, &heap },
            faults = ids{ &heap },
            fn_decl = NONE,
            flows = map::new(u32, Flow){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            sets = map::new(u32, []u32){ realloc = arena::alloc, &heap, hash = map::hash_u32, eq = map::eq_u32 },
            pending = list::new(Pending){ realloc = arena::alloc, &heap },
            pat_errs = map::new(u64, u32){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            escapes = list::new(Escape){ realloc = arena::alloc, &heap },
            sites = list::new(Site){ realloc = arena::alloc, &heap },
            fault_writers = map::new(u64, []Writer){ realloc = arena::alloc, &heap, hash = map::hash_u64, eq = map::eq_u64 },
            ptr_faults = false,
        }
        _ = space{ &c, name = "", parent = NONE }
        _ = space{ &c, name = "", parent = UNIVERSE }
        _ = space{ &c, name = "", parent = STD }
        let mut i: usize = 0
        while i < types::PRIM_NAMES.len {
            let p = @as(types::Prim, i)
            put_name{ &c, ns = UNIVERSE, values = false, name = types::PRIM_NAMES[i], e = Entry::prim{ p } }
            i = i + 1
        }
        put_name{ &c, ns = UNIVERSE, values = false, name = "error", e = Entry::anyerr }
        put_name{ &c, ns = UNIVERSE, values = false, name = "strlit", e = Entry::strlit }
        put_name{ &c, ns = UNIVERSE, values = false, name = "convert", e = Entry::attr{ a = Attribute::convert } }
        put_name{ &c, ns = UNIVERSE, values = false, name = "write", e = Entry::attr{ a = Attribute::write } }
        return c
    }

    fn ids { mut heap: Heap } -> list::List(u32, Heap) {
        return list::new(u32){ realloc = arena::alloc, &heap }
    }

    // ---- the phases (ctxi's Checker.check: check_decls, then check_bodies)

    fn program { mut c: Checker } {
        declarations{ &c }
        each{ &c, xs = c.consts, what = Phase::const_values }
        each{ &c, xs = c.consts, what = Phase::fold }
        attributes{ &c }
        each{ &c, xs = c.fns, what = Phase::bodies }
        infer_sets{ &c }
        finish_matches{ &c }
        finish_escapes{ &c }
        evaluate{ &c }
        check_main{ &c }
    }

    // The consts folding can't compute (§14), evaluated in order, or earlier where another const
    // needs one, then the converted literals (PLAN.md 4.5), so that what stops one is reported
    // here. Only a program without errors is: lowering needs every body it reaches checked.
    fn evaluate { mut c: Checker } {
        if c.diags.errors > 0 { return }
        c.can_eval = true
        each{ &c, xs = c.consts, what = Phase::fold }
        let ls = list::items{ list = c.lit_list }
        let mut i: usize = 0
        while i < ls.len {
            _ = literal_value{ &c, e = ls[i] }
            i = i + 1
        }
    }

    fn declarations { mut c: Checker } {
        let mut f: usize = 0
        while f < c.files.len {
            collect{ &c, file = @as(u32, f), decls = c.files[f].tree.decls, ns = if f < c.std_files { STD } else { ROOT } }
            f = f + 1
        }
        c.cstr_decl = std_decl{ c, space = "c", name = "String" }
        generic_params{ &c, xs = c.structs }
        generic_params{ &c, xs = c.unions }
        generic_params{ &c, xs = c.fns }
        each{ &c, xs = c.structs, what = Phase::structs }
        each{ &c, xs = c.caps, what = Phase::caps }
        each{ &c, xs = c.unions, what = Phase::unions }
        each{ &c, xs = c.enums, what = Phase::enums }
        each{ &c, xs = c.aliases, what = Phase::aliases }
        each{ &c, xs = c.faults, what = Phase::faults }
        each{ &c, xs = c.consts, what = Phase::consts }
        each{ &c, xs = c.fns, what = Phase::sigs }
        each{ &c, xs = c.externs, what = Phase::sigs }
        compiler_attributes{ &c }
        c.ptr_faults = faults_hold_ptr{ &c, ds = list::items{ list = c.faults } }
    }

    union Phase { structs, faults, caps, unions, enums, aliases, consts, sigs, const_values, fold, bodies }

    fn each { mut c: Checker, xs: list::List(u32, Heap), what: Phase } {
        let items = list::items{ list = xs }
        let mut i: usize = 0
        while i < items.len {
            let d = items[i]
            match what {
                structs => { resolve_struct{ &c, d } }
                faults  => { resolve_fault{ &c, d } }
                caps    => { resolve_cap{ &c, d } }
                unions  => { resolve_union{ &c, d } }
                enums   => { resolve_enum{ &c, d } }
                aliases => { resolve_alias{ &c, d } }
                consts  => { resolve_const{ &c, d } }
                sigs    => { resolve_sig{ &c, d } }
                const_values => { check_const{ &c, d } }
                bodies  => { check_fn{ &c, d } }
                fold    => {
                    _ = const_value{ &c, d, at = get_decl{ c, d }.syn.span }
                    c.unfolded = NONE
                }
            }
            i = i + 1
        }
    }

    fn collect { mut c: Checker, file: u32, decls: []syntax::Decl, ns: u32 } {
        let mut i: usize = 0
        while i < decls.len {
            let x = decls[i]
            match x.k {
                error => {}
                func{ name, tparams, external } => {
                    let d = declare{ &c, kind = if external { Kind::external } else { Kind::func }, x, file, name, tparams, ns }
                    add_name{ &c, ns, values = true, name, e = Entry::decl{ i = d }, at = x.span }
                    if external {
                        list::at{ list = c.decls, i = d }.symbol = name.text
                        push{ xs = &c.externs, n = d }
                    } else {
                        push{ xs = &c.fns, n = d }
                    }
                }
                constant{ name } => {
                    let d = declare{ &c, kind = Kind::constant, x, file, name, tparams = no_names{}, ns }
                    add_name{ &c, ns, values = true, name, e = Entry::decl{ i = d }, at = x.span }
                    push{ xs = &c.consts, n = d }
                }
                record{ name, tparams } => {
                    let d = declare{ &c, kind = Kind::record, x, file, name, tparams, ns }
                    add_name{ &c, ns, values = false, name, e = Entry::decl{ i = d }, at = x.span }
                    push{ xs = &c.structs, n = d }
                }
                sum{ name, tparams } => {
                    let d = declare{ &c, kind = Kind::sum, x, file, name, tparams, ns }
                    add_name{ &c, ns, values = false, name, e = Entry::decl{ i = d }, at = x.span }
                    push{ xs = &c.unions, n = d }
                }
                enumeration{ name } => {
                    let d = declare{ &c, kind = Kind::enumeration, x, file, name, tparams = no_names{}, ns }
                    add_name{ &c, ns, values = false, name, e = Entry::decl{ i = d }, at = x.span }
                    push{ xs = &c.enums, n = d }
                }
                alias{ name, tparams } => {
                    let d = declare{ &c, kind = Kind::alias, x, file, name, tparams, ns }
                    add_name{ &c, ns, values = false, name, e = Entry::decl{ i = d }, at = x.span }
                    push{ xs = &c.aliases, n = d }
                }
                cap{ name, fields } => {
                    let d = declare{ &c, kind = Kind::cap, x, file, name, tparams = no_names{}, ns }
                    add_name{ &c, ns, values = false, name, e = Entry::decl{ i = d }, at = x.span }
                    if fields != null { push{ xs = &c.caps, n = d } }
                }
                fault{ name } => {
                    let d = declare{ &c, kind = Kind::fault, x, file, name, tparams = no_names{}, ns }
                    if slice::eq_bytes{ a = name.text, b = "ok" } or slice::eq_bytes{ a = name.text, b = "err" } {
                        errorf{ &c, at = name.span, msg = @fmt("an error can't be named `{}`: a match on a `!T` has the arms `ok` and `err`", str{ s = name.text }) }
                    }
                    add_name{ &c, ns, values = true, name, e = Entry::decl{ i = d }, at = x.span }
                    push{ xs = &c.faults, n = d }
                }
                space{ name, decls = inner } => {
                    let child = space{ &c, name = name.text, parent = ns }
                    try! map::put{ m = &c.space_of, key = key{ file, id = x.id }, value = child }
                    add_name{ &c, ns, values = false, name, e = Entry::space{ ns = child }, at = x.span }
                    collect{ &c, file, decls = inner, ns = child }
                }
            }
            i = i + 1
        }
    }

    fn no_names {} -> []syntax::Name {
        return slice::empty(syntax::Name){}
    }

    fn declare { mut c: Checker, kind: Kind, x: syntax::Decl, file: u32, name: syntax::Name, tparams: []syntax::Name, ns: u32 } -> u32 {
        let d = @as(u32, c.decls.len)
        let item = Decl{
            kind, name, ns, qual = qualify{ c, ns, name = name.text }, syn = x, tparams,
            fields = slice::empty(types::Field){}, variants = slice::empty(Variant){},
            ret = types::VOID, ty = types::ERROR, values = slice::empty(i64){}, symbol = "",
            callback = false, includes = slice::empty(u32){}, vars = slice::empty(CVar){},
        }
        try! list::push{ list = &c.decls, item }
        try! map::put{ m = &c.decl_of, key = key{ file, id = x.id }, value = d }
        return d
    }

    fn space { mut c: Checker, name: []u8, parent: u32 } -> u32 {
        let ns = @as(u32, c.spaces.len)
        let qual = if parent == NONE { name } else { qualify{ c, ns = parent, name } }
        let item = Space{
            name, qual, parent,
            paths = map::new([]u8, Entry){ realloc = arena::alloc, heap = c.heap, hash = map::hash_bytes, eq = slice::eq_bytes },
            values = map::new([]u8, Entry){ realloc = arena::alloc, heap = c.heap, hash = map::hash_bytes, eq = slice::eq_bytes },
        }
        try! list::push{ list = &c.spaces, item }
        return ns
    }

    // name inside namespace ns, as `a::b::name`. The top-level namespaces have no name.
    fn qualify { c: Checker, ns: u32, name: []u8 } -> []u8 {
        let prefix = get_space{ c, ns }.qual
        if prefix.len == 0 { return name }
        let mut b = message{ c }
        try! @fmt(&b, "{}::{}", str{ s = prefix }, str{ s = name })
        return utf8::view{ b }.bytes
    }

    fn add_name { mut c: Checker, ns: u32, values: bool, name: syntax::Name, e: Entry, at: source::Span } {
        if name.text.len == 0 { return }          // missing: the parser has reported it
        let sp = get_space{ c, ns }
        let table = if values { sp.values } else { sp.paths }
        if map::has{ m = table, key = name.text } {
            errorf{ &c, at, msg = @fmt("`{}` is already declared in this scope", str{ s = name.text }) }
            return
        }
        put_name{ &c, ns, values, name = name.text, e }
    }

    fn put_name { mut c: Checker, ns: u32, values: bool, name: []u8, e: Entry } {
        let sp = list::at{ list = c.spaces, i = ns }
        let into = if values { &sp.values } else { &sp.paths }
        try! map::put{ m = into, key = name, value = e }
    }

    fn generic_params { mut c: Checker, xs: list::List(u32, Heap) } {
        let items = list::items{ list = xs }
        let mut i: usize = 0
        while i < items.len {
            let d = get_decl{ c, d = items[i] }
            let ps = d.tparams
            let mut dup = false
            let mut j: usize = 0
            while j < ps.len {
                let mut k: usize = 0
                while k < j {
                    if slice::eq_bytes{ a = ps[j].text, b = ps[k].text } { dup = true }
                    k = k + 1
                }
                j = j + 1
            }
            if dup {
                errorf{ &c, at = d.syn.span, msg = @fmt("duplicate generic parameter in `{}`", str{ s = d.name.text }) }
            }
            i = i + 1
        }
    }

    // The scope of declaration d's own generic parameters, each standing for itself.
    fn own_scope { mut c: Checker, d: u32 } -> Scope {
        let x = get_decl{ c, d }
        let mut args = list::new(Id){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < x.tparams.len {
            push{ xs = &args, n = types::intern{ s = &c.ty, t = types::Type::param{ decl = d, index = @as(u32, i) } } }
            i = i + 1
        }
        return Scope{ ns = x.ns, owner = d, names = x.tparams, args = list::items{ list = args } }
    }

    fn resolve_struct { mut c: Checker, d: u32 } {
        let x = get_decl{ c, d }
        let sc = own_scope{ &c, d }
        let mut out = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
        if x.syn.k is record{ fields } {
            let mut i: usize = 0
            while i < fields.len {
                let f = fields[i]
                if seen_field{ fields, i } { duplicate{ &c, what = "field", name = f.name, at = f.span } }
                let t = rtype{ &c, te = f.ty, sc, allow_bound = false }
                add_field{ xs = &out, f = types::Field{ name = f.name.text, mutable = false, ty = t } }
                i = i + 1
            }
        }
        list::at{ list = c.decls, i = d }.fields = list::items{ list = out }
    }

    // An error's payload (§8, Errors), resolved as a struct's fields are.
    fn resolve_fault { mut c: Checker, d: u32 } {
        let x = get_decl{ c, d }
        let sc = own_scope{ &c, d }
        let mut out = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
        if x.syn.k is fault{ fields = fs } {
            let fields = fs ifnull { slice::empty(syntax::Field){} }
            let mut i: usize = 0
            while i < fields.len {
                let f = fields[i]
                if seen_field{ fields, i } { duplicate{ &c, what = "field", name = f.name, at = f.span } }
                let t = rtype{ &c, te = f.ty, sc, allow_bound = false }
                if holds_fail{ &c, t, depth = 0 } {
                    errorf{ &c, at = f.span, msg = @fmt("error `{}`'s field `{}` can't hold {}: a payload holds no `!T` or error", str{ s = x.name.text }, str{ s = f.name.text }, tstr{ c, t }) }
                }
                add_field{ xs = &out, f = types::Field{ name = f.name.text, mutable = false, ty = t } }
                i = i + 1
            }
        }
        list::at{ list = c.decls, i = d }.fields = list::items{ list = out }
    }

    // Whether t is or holds a `!T` or an error, as a field, an element or a payload.
    fn holds_fail { mut c: Checker, t: Id, depth: u32 } -> bool {
        if depth > 64 { return false }
        let x = types::prune{ s = c.ty, t }
        match types::get{ s = c.ty, id = x } {
            res | errs | eset => { return true }
            array{ elem } | opt{ elem } => { return holds_fail{ &c, t = elem, depth = depth + 1 } }
            record => {
                let fs = struct_fields{ &c, t = x }
                let mut i: usize = 0
                while i < fs.len {
                    if holds_fail{ &c, t = fs[i].ty, depth = depth + 1 } { return true }
                    i = i + 1
                }
                return false
            }
            sum => {
                let vs = variants_of{ &c, t = x }
                let mut i: usize = 0
                while i < vs.len {
                    let fs = vs[i].fields ifnull { slice::empty(types::Field){} }
                    let mut j: usize = 0
                    while j < fs.len {
                        if holds_fail{ &c, t = fs[j].ty, depth = depth + 1 } { return true }
                        j = j + 1
                    }
                    i = i + 1
                }
                return false
            }
            else => { return false }
        }
    }

    // An error's payload: null for an error declared without braces.
    fn fault_fields { c: Checker, d: u32 } -> ?[]types::Field {
        if get_decl{ c, d }.syn.k is fault{ fields } and fields == null { return null }
        return get_decl{ c, d }.fields
    }

    // §15: a capability's fields are C function pointers, called through it (§12, C function
    // pointers). A `?extern fn` would have to be read to be unwrapped, which a field can't be.
    // `extern name: T` is a C variable instead, which takes no space in it. `..Name` puts
    // another's fields and variables where it stands, so that one is resolved first, on demand.
    // A capability with fields may include only others with fields: a function of its namespace
    // makes one, and could otherwise give away the permission of one that only `main` receives.
    fn resolve_cap { mut c: Checker, d: u32 } {
        if map::has{ m = c.caps_done, key = d } { return }
        let x = get_decl{ c, d }
        let sc = own_scope{ &c, d }
        let mut out = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
        let mut from = list::new(u32){ realloc = arena::alloc, heap = c.heap }    // each field's inclusion, or NONE
        let mut vars = list::new(CVar){ realloc = arena::alloc, heap = c.heap }
        let mut vfrom = list::new(u32){ realloc = arena::alloc, heap = c.heap }   // each variable's inclusion, or NONE
        let mut incl = list::new(u32){ realloc = arena::alloc, heap = c.heap }
        let mut bare = NONE                     // the first capability without fields included
        let mut bare_at = x.syn.span
        push{ xs = &c.cap_stack, n = d }
        if x.syn.k is cap{ fields = fs, includes } {
            let fields = fs ifnull { slice::empty(syntax::Field){} }
            let mut j: usize = 0
            let mut i: usize = 0
            while i <= fields.len {
                while j < includes.len and includes[j].at == i {
                    let y = include_cap{ &c, d, inc = includes[j], sc, out = &out, from = &from, vars = &vars, vfrom = &vfrom, incl = &incl }
                    if y != NONE and bare == NONE and get_decl{ c, d = y }.fields.len == 0 {
                        bare = y
                        bare_at = includes[j].span
                    }
                    j = j + 1
                }
                if i == fields.len { break }
                let f = fields[i]
                if f.external {
                    add_cvar{ &c, d, f, sc, out = list::items{ list = out }, from = list::items{ list = from }, vars = &vars, vfrom = &vfrom }
                    i = i + 1
                    continue
                }
                let t = rtype{ &c, te = f.ty, sc, allow_bound = false }
                let mut ok = t == types::ERROR
                if types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is func{ external } { ok = external }
                if not ok {
                    errorf{ &c, at = f.span, msg = @fmt("capability `{}`'s field `{}` must be a C function pointer, `extern fn{{ ... }}`, not {}", str{ s = x.name.text }, str{ s = f.name.text }, tstr{ c, t }) }
                }
                let came = cap_member{ out = list::items{ list = out }, from = list::items{ list = from }, vars = list::items{ list = vars }, vfrom = list::items{ list = vfrom }, name = f.name.text }
                if came != null and f.name.text.len > 0 { cap_clash{ &c, x, name = f.name, at = f.span, came } }
                add_field{ xs = &out, f = types::Field{ name = f.name.text, mutable = false, ty = t } }
                push{ xs = &from, n = NONE }
                i = i + 1
            }
        }
        if out.len > 0 and bare != NONE {
            let y = get_decl{ c, d = bare }
            let why: utf8::String = if y.vars.len > 0 { "it has only C variables" } else { "it has no fields" }
            errorf{ &c, at = bare_at, msg = @fmt("capability `{}` can't include `{}`: {}", str{ s = x.name.text }, str{ s = y.name.text }, why) }
        }
        _ = list::pop{ list = &c.cap_stack }
        put_bool{ m = &c.caps_done, k = d }
        list::at{ list = c.decls, i = d }.fields = list::items{ list = out }
        list::at{ list = c.decls, i = d }.vars = list::items{ list = vars }
        list::at{ list = c.decls, i = d }.includes = list::items{ list = incl }
    }

    // `extern name: T` in capability d's braces (§15): the C variable `name`, of a type C has.
    fn add_cvar { mut c: Checker, d: u32, f: syntax::Field, sc: Scope, out: []types::Field, from: []u32, mut vars: list::List(CVar, Heap), mut vfrom: list::List(u32, Heap) } {
        let x = get_decl{ c, d }
        let t = rtype{ &c, te = f.ty, sc, allow_bound = false }
        if not c_variable{ c, t } {
            errorf{ &c, at = f.span, msg = @fmt("capability `{}`'s C variable `{}` can't have type {}: C has no equivalent of it", str{ s = x.name.text }, str{ s = f.name.text }, tstr{ c, t }) }
        }
        let came = cap_member{ out, from, vars = list::items{ list = vars }, vfrom = list::items{ list = vfrom }, name = f.name.text }
        if came != null and f.name.text.len > 0 { cap_clash{ &c, x, name = f.name, at = f.span, came } }
        try! list::push{ list = &vars, item = CVar{ name = f.name.text, ty = t, owner = d, symbol = f.name.text } }
        push{ xs = &vfrom, n = NONE }
    }

    // A C variable's type: one C has, stored as C stores it. A slice is a pair only ctxlang
    // makes, and a capability isn't stored at all.
    fn c_variable { c: Checker, t: Id } -> bool {
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } {
            error | prim | enumeration | ptr | record => { return true }
            opt => { return nullable_ptr{ c, t } }
            func{ external } => { return external }
            else => { return false }
        }
    }

    // Where a capability being resolved already has a field or C variable `name` from: NONE if
    // it declares it itself, else the capability it includes it through; null if it has none.
    fn cap_member { out: []types::Field, from: []u32, vars: []CVar, vfrom: []u32, name: []u8 } -> ?u32 {
        let k = types::field_index{ fields = out, name }
        if k != null { return from[k] }
        let mut i: usize = 0
        while i < vars.len {
            if slice::eq_bytes{ a = vars[i].name, b = name } { return vfrom[i] }
            i = i + 1
        }
        return null
    }

    // Capability x declares `name`, which it already has: from itself (came is NONE) or from
    // the capability it includes it through.
    fn cap_clash { mut c: Checker, x: Decl, name: syntax::Name, at: source::Span, came: u32 } {
        if came == NONE {
            duplicate{ &c, what = "field", name, at }
            return
        }
        errorf{ &c, at, msg = @fmt("capability `{}` declares `{}`, which it includes from `{}`", str{ s = x.name.text }, str{ s = name.text }, str{ s = get_decl{ c, d = came }.name.text }) }
    }

    // `..Name` in capability d's braces: Name's fields and C variables, which must each reach d
    // once. from and vfrom record the inclusion each came through, and incl gains Name and what
    // Name includes. Returns Name's declaration, or NONE if it isn't a capability.
    fn include_cap { mut c: Checker, d: u32, inc: syntax::Include, sc: Scope, mut out: list::List(types::Field, Heap), mut from: list::List(u32, Heap), mut vars: list::List(CVar, Heap), mut vfrom: list::List(u32, Heap), mut incl: list::List(u32, Heap) } -> u32 {
        let x = get_decl{ c, d }
        let t = rtype{ &c, te = inc.ty, sc, allow_bound = false }
        if t == types::ERROR { return NONE }
        let mut i = NONE
        if types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is cap{ decl } { i = decl }
        if i == NONE {
            errorf{ &c, at = inc.span, msg = @fmt("capability `{}` can only include a capability, not {}", str{ s = x.name.text }, tstr{ c, t }) }
            return NONE
        }
        // A cycle: Name is still being resolved, d through the ones after it.
        let stack = list::items{ list = c.cap_stack }
        let mut k: usize = 0
        while k < stack.len and stack[k] != i { k = k + 1 }
        if k < stack.len {
            let mut b = message{ c }
            try! @fmt(&b, "capability `{}` includes itself", str{ s = get_decl{ c, d = i }.name.text })
            let mut n = k + 1
            while n < stack.len {
                let sep: utf8::String = if n == k + 1 { ", through " } else { ", " }
                try! @fmt(&b, "{}`{}`", sep, str{ s = get_decl{ c, d = stack[n] }.name.text })
                n = n + 1
            }
            error{ &c, at = inc.span, msg = utf8::view{ b } }
            return NONE
        }
        let mut braced = false
        if get_decl{ c, d = i }.syn.k is cap{ fields } { braced = fields != null }
        if braced { resolve_cap{ &c, d = i } }
        let y = get_decl{ c, d = i }
        let mut clash = false
        let mut f: usize = 0
        while f < y.fields.len + y.vars.len {
            let field = f < y.fields.len
            let name = if field { y.fields[f].name } else { y.vars[f - y.fields.len].name }
            let came = cap_member{ out = list::items{ list = out }, from = list::items{ list = from }, vars = list::items{ list = vars }, vfrom = list::items{ list = vfrom }, name }
            if came == null {
                if field {
                    add_field{ xs = &out, f = y.fields[f] }
                    push{ xs = &from, n = i }
                } else {
                    try! list::push{ list = &vars, item = y.vars[f - y.fields.len] }
                    push{ xs = &vfrom, n = i }
                }
            } else if not clash and name.len > 0 {
                clash = true
                let mut b = message{ c }
                if came == NONE {
                    try! @fmt(&b, "capability `{}` declares `{}`, which it includes from `{}`", str{ s = x.name.text }, str{ s = name }, str{ s = y.name.text })
                } else {
                    try! @fmt(&b, "capability `{}` includes `{}` twice: from `{}` and from `{}`", str{ s = x.name.text }, str{ s = name }, str{ s = get_decl{ c, d = came }.name.text }, str{ s = y.name.text })
                }
                error{ &c, at = inc.span, msg = utf8::view{ b } }
            }
            f = f + 1
        }
        push{ xs = &incl, n = i }
        let mut n: usize = 0
        while n < y.includes.len {
            push{ xs = &incl, n = y.includes[n] }
            n = n + 1
        }
        return i
    }

    // Whether a is a capability that includes capability b, directly or through others, and so
    // converts to it (§15): a copy, since a capability's fields never change.
    fn includes_cap { c: Checker, a: Id, b: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t = a } } is cap{ decl = x }
               and types::get{ s = c.ty, id = types::prune{ s = c.ty, t = b } } is cap{ decl = y }
               and has_id{ xs = get_decl{ c, d = x }.includes, n = y }
    }

    // Whether pointer type a points to a capability that includes the one b points to, as a
    // `mut` field's argument may (§15): `&gl` for `mut gl: Gl2_0`, with `gl: Gl3_3`.
    fn includes_cap_ptr { c: Checker, a: Id, b: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t = a } } is ptr{ elem = x, mutable = m }
               and types::get{ s = c.ty, id = types::prune{ s = c.ty, t = b } } is ptr{ elem = y, mutable = n }
               and (m or not n) and includes_cap{ c, a = x, b = y }
    }

    // Whether capability b's fields are the first of capability a's, as when a's first item is
    // `..B`: then a pointer to an a is one to a b.
    fn cap_prefix { c: Checker, a: Id, b: Id } -> bool {
        let fa = cap_fields{ c, t = a }
        let fb = cap_fields{ c, t = b }
        if fb.len > fa.len { return false }
        let mut i: usize = 0
        while i < fb.len {
            if not slice::eq_bytes{ a = fa[i].name, b = fb[i].name } { return false }
            i = i + 1
        }
        return true
    }

    fn cap_fields { c: Checker, t: Id } -> []types::Field {
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } {
            cap{ decl } => { return get_decl{ c, d = decl }.fields }
            else => { return slice::empty(types::Field){} }
        }
    }

    // Whether t is a capability with fields (§15), which only a function of its namespace can
    // construct, and so neither the runtime nor a callback's thunk can supply.
    fn loaded_cap { c: Checker, t: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is cap{ decl } and get_decl{ c, d = decl }.fields.len > 0
    }

    // Whether a value of type t is or holds a capability with fields, as a field, an element or
    // a payload. A place of such a type is assigned only once (§15): a `mut` field may have been
    // given a copy of the capability, which replacing it would leave behind.
    fn holds_cap { mut c: Checker, t: Id, depth: u32 } -> bool {
        if depth > 64 { return false }
        let x = types::prune{ s = c.ty, t }
        if loaded_cap{ c, t = x } { return true }
        match types::get{ s = c.ty, id = x } {
            array{ elem } | opt{ elem } => { return holds_cap{ &c, t = elem, depth = depth + 1 } }
            record => { return fields_hold_cap{ &c, fields = struct_fields{ &c, t = x }, depth } }
            sum => {
                let vs = variants_of{ &c, t = x }
                let mut i: usize = 0
                while i < vs.len {
                    let fs = vs[i].fields ifnull { slice::empty(types::Field){} }
                    if fields_hold_cap{ &c, fields = fs, depth } { return true }
                    i = i + 1
                }
                return false
            }
            else => { return false }
        }
    }

    fn fields_hold_cap { mut c: Checker, fields: []types::Field, depth: u32 } -> bool {
        let mut i: usize = 0
        while i < fields.len {
            if holds_cap{ &c, t = fields[i].ty, depth = depth + 1 } { return true }
            i = i + 1
        }
        return false
    }

    // An assignment to a place of type t, which mustn't replace a capability with fields unless
    // it is the one assignment of a `let x: T` (once).
    fn check_cap_assign { mut c: Checker, t: Id, once: bool, at: source::Span } {
        if once or not holds_cap{ &c, t, depth = 0 } { return }
        let what: utf8::String = if loaded_cap{ c, t } { "is" } else { "holds" }
        errorf{ &c, at, msg = @fmt("cannot assign {}, which {} a capability with fields: one is never replaced, only declared with its value or assigned once to a `let x: T`", tstr{ c, t }, what) }
    }

    // The first of fields with a capability with fields, or null.
    fn loaded_field { c: Checker, fields: []types::Field } -> ?types::Field {
        let mut i: usize = 0
        while i < fields.len {
            if loaded_cap{ c, t = fields[i].ty } { return fields[i] }
            i = i + 1
        }
        return null
    }

    fn resolve_union { mut c: Checker, d: u32 } {
        let x = get_decl{ c, d }
        let sc = own_scope{ &c, d }
        let mut out = list::new(Variant){ realloc = arena::alloc, heap = c.heap }
        if x.syn.k is sum{ variants } {
            let mut i: usize = 0
            while i < variants.len {
                let v = variants[i]
                let mut k: usize = 0
                while k < i {
                    if slice::eq_bytes{ a = variants[k].name.text, b = v.name.text } and v.name.text.len > 0 {
                        duplicate{ &c, what = "variant", name = v.name, at = v.span }
                        break
                    }
                    k = k + 1
                }
                let vfields = v.fields
                if vfields == null {
                    add_variant{ xs = &out, v = Variant{ name = v.name.text, fields = null } }
                } else {
                    let mut fs = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
                    let mut j: usize = 0
                    while j < vfields.len {
                        let f = vfields[j]
                        if seen_field{ fields = vfields, i = j } { duplicate{ &c, what = "field", name = f.name, at = f.span } }
                        let t = rtype{ &c, te = f.ty, sc, allow_bound = false }
                        add_field{ xs = &fs, f = types::Field{ name = f.name.text, mutable = false, ty = t } }
                        j = j + 1
                    }
                    add_variant{ xs = &out, v = Variant{ name = v.name.text, fields = list::items{ list = fs } } }
                }
                i = i + 1
            }
        }
        list::at{ list = c.decls, i = d }.variants = list::items{ list = out }
    }

    // Whether fields[i]'s name comes earlier in fields.
    fn seen_field { fields: []syntax::Field, i: usize } -> bool {
        if fields[i].name.text.len == 0 { return false }
        let mut k: usize = 0
        while k < i {
            if slice::eq_bytes{ a = fields[k].name.text, b = fields[i].name.text } { return true }
            k = k + 1
        }
        return false
    }

    // "duplicate field `a`"
    fn duplicate { mut c: Checker, what: utf8::String, name: syntax::Name, at: source::Span } {
        errorf{ &c, at, msg = @fmt("duplicate {} `{}`", what, str{ s = name.text }) }
    }

    // The base type, and each variant's value: the one given, or one more than the last.
    fn resolve_enum { mut c: Checker, d: u32 } {
        let x = get_decl{ c, d }
        let empty = Scope{ ns = x.ns, owner = NONE, names = no_names{}, args = slice::empty(Id){} }
        let mut values = list::new(i64){ realloc = arena::alloc, heap = c.heap }
        if x.syn.k is enumeration{ base, variants } {
            let mut t = rtype{ &c, te = base, sc = empty, allow_bound = false }
            if t != types::ERROR and not types::is_int{ s = c.ty, t } {
                errorf{ &c, at = base.span, msg = @fmt("enum `{}` needs an integer base type, got {}", str{ s = x.name.text }, tstr{ c, t }) }
                t = types::ERROR
            }
            list::at{ list = c.decls, i = d }.ty = t
            let mut next: ?i64 = 0
            let mut i: usize = 0
            while i < variants.len {
                let v = variants[i]
                let mut k: usize = 0
                while k < i {
                    if slice::eq_bytes{ a = variants[k].name.text, b = v.name.text } and v.name.text.len > 0 {
                        duplicate{ &c, what = "variant", name = v.name, at = v.span }
                        break
                    }
                    k = k + 1
                }
                let given = v.value
                let value = if given == null { next } else { const_int{ &c, e = given, ns = x.ns, what = "an enum value" } }
                next = null
                if value != null {
                    if t != types::ERROR { enum_value{ &c, t, name = v.name, value, at = v.span, variants, before = list::items{ list = values } } }
                    if value < 9223372036854775807 { next = value + 1 }
                }
                push_i64{ xs = &values, n = if value == null { 0 } else { value } }
                i = i + 1
            }
        }
        list::at{ list = c.decls, i = d }.values = list::items{ list = values }
    }

    // Checks that enum value `value` of variant `name` fits t and that no earlier one has it.
    fn enum_value { mut c: Checker, t: Id, name: syntax::Name, value: i64, at: source::Span, variants: []syntax::EnumVariant, before: []i64 } {
        let p = @as(types::Prim, t - types::FIRST_PRIM)
        if not types::fits{ p, negative = value < 0, magnitude = magnitude{ v = value } } {
            errorf{ &c, at, msg = @fmt("value {} of `{}` does not fit in {}", value, str{ s = name.text }, tstr{ c, t }) }
        }
        let mut k: usize = 0
        while k < before.len {
            if before[k] == value {
                errorf{ &c, at, msg = @fmt("`{}` has the same value ({}) as `{}`", str{ s = name.text }, value, str{ s = variants[k].name.text }) }
                return
            }
            k = k + 1
        }
    }

    fn magnitude { v: i64 } -> u64 {
        if v >= 0 { return @as(u64, v) }
        return @as(u64, -(v + 1)) + 1
    }

    // A generic alias is resolved where it is used; a plain one here, for its errors.
    fn resolve_alias { mut c: Checker, d: u32 } {
        let x = get_decl{ c, d }
        if x.tparams.len > 0 { return }
        let t = decl_type{ &c, e = Entry::decl{ i = d }, name = x.name, args = null, at = x.syn.span, partial = false, allow_bound = true }
        list::at{ list = c.decls, i = d }.ty = t
    }

    fn resolve_const { mut c: Checker, d: u32 } {
        let x = get_decl{ c, d }
        if x.syn.k is constant{ ty } {
            let empty = Scope{ ns = x.ns, owner = NONE, names = no_names{}, args = slice::empty(Id){} }
            let mut t = rtype{ &c, te = ty, sc = empty, allow_bound = false }
            if holds_fail{ &c, t, depth = 0 } {
                error{ &c, at = ty.span, msg = "a const can't hold a `!T` or an error" }
                t = types::ERROR
            }
            list::at{ list = c.decls, i = d }.ty = t
        }
    }

    // A function's (or an extern fn's) context fields and return type.
    fn resolve_sig { mut c: Checker, d: u32 } {
        let x = get_decl{ c, d }
        let sc = own_scope{ &c, d }
        if x.syn.k is func{ params, ret, external } {
            let fields = context{ &c, params, sc }
            let mut r = types::VOID
            if ret != null { r = ret_type{ &c, te = ret, sc, owner = d } }
            let at = list::at{ list = c.decls, i = d }
            at.fields = fields
            at.ret = r
            if external { extern_sig{ &c, x, params, ret, fields, r } }
        }
    }

    // §18: an extern fn passes and returns only what C has: numbers, bool, enums, pointers,
    // slices and structs. Capability fields aren't passed.
    fn extern_sig { mut c: Checker, x: Decl, params: []syntax::Param, ret: ?syntax::TypeExpr, fields: []types::Field, r: Id } {
        let mut what = message{ c }
        try! @fmt(&what, "extern fn `{}`", str{ s = x.name.text })
        let ret_at: ?source::Span = if ret == null { null } else { ret.span }
        c_signature{ &c, what = utf8::view{ b = what }, params, ret_at, fields, r }
    }

    // The fields and result of what C calls (`what`: an extern fn or an extern fn type) must
    // have C equivalents.
    fn c_signature { mut c: Checker, what: utf8::String, params: []syntax::Param, ret_at: ?source::Span, fields: []types::Field, r: Id } {
        let mut i: usize = 0
        while i < fields.len and i < params.len {
            let f = fields[i]
            if not c_compatible{ c, t = f.ty } {
                errorf{ &c, at = params[i].span, msg = @fmt("{} can't pass `{}` to C: it has type {}, which C has no equivalent of", what, str{ s = f.name }, tstr{ c, t = f.ty }) }
            }
            i = i + 1
        }
        if ret_at != null and r != types::VOID and not c_compatible{ c, t = r } {
            errorf{ &c, at = ret_at, msg = @fmt("{} can't return {}: C has no equivalent of it", what, tstr{ c, t = r }) }
        }
    }

    fn c_compatible { c: Checker, t: Id } -> bool {
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } {
            error | prim | cap | enumeration | ptr | slice | record => { return true }
            opt => { return nullable_ptr{ c, t } }
            func{ external } => { return external }
            else => { return false }
        }
    }

    // The fields of a context, `{ mut name: T, ... }`, of a function or a function type.
    fn context { mut c: Checker, params: []syntax::Param, sc: Scope } -> []types::Field {
        let mut out = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < params.len {
            let f = params[i]
            let mut k: usize = 0
            while k < i {
                if slice::eq_bytes{ a = params[k].name.text, b = f.name.text } and f.name.text.len > 0 {
                    errorf{ &c, at = f.span, msg = @fmt("duplicate context field `{}`", str{ s = f.name.text }) }
                    break
                }
                k = k + 1
            }
            let t = rtype{ &c, te = f.ty, sc, allow_bound = not f.mutable }
            add_field{ xs = &out, f = types::Field{ name = f.name.text, mutable = f.mutable, ty = t } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // §15: the entry point exists, isn't generic, returns i32 or nothing, and takes capabilities
    // and `args`. It is `main`, or in a build program (§19), which has no `main`, `build`. Only
    // `build` may take a `Build`.
    fn check_main { mut c: Checker } {
        let mut m = root_fn{ c, name = "main" }
        let mut entry: []u8 = "main"
        if m == NONE {
            m = root_fn{ c, name = "build" }
            entry = "build"
        }
        if m == NONE {
            error{ &c, at = nowhere{}, msg = "no `fn main` entry point" }
            return
        }
        let x = get_decl{ c, d = m }
        let at = x.syn.span
        let bad = c.diags.errors
        if x.tparams.len > 0 {
            errorf{ &c, at, msg = @fmt("`{}` cannot be generic", str{ s = entry }) }
        }
        if x.ret != types::VOID and x.ret != types::I32 and x.ret != types::ERROR {
            errorf{ &c, at, msg = @fmt("`{}` can only return i32 (the exit code), not {}", str{ s = entry }, tstr{ c, t = x.ret }) }
        }
        let args_t = std_type{ &c, name = "Args" }
        let build_cap = std_decl_top{ c, name = "Build" }
        let mut i: usize = 0
        while i < x.fields.len {
            let f = x.fields[i]
            let t = f.ty
            if slice::eq_bytes{ a = f.name, b = "args" } and not f.mutable {
                if t != args_t and t != types::ERROR and args_t != types::ERROR {
                    errorf{ &c, at, msg = @fmt("`{}` context field `args` must have type Args, got {}", str{ s = entry }, tstr{ c, t }) }
                }
            } else if t != types::ERROR {
                match types::get{ s = c.ty, id = t } {
                    cap{ decl } => {
                        if decl == build_cap and slice::eq_bytes{ a = entry, b = "main" } {
                            error{ &c, at, msg = "`main` cannot take a Build: only a build program's `fn build` receives one" }
                        } else if loaded_cap{ c, t } {
                            errorf{ &c, at, msg = @fmt("`{}` cannot take `{}`: a capability with fields comes from a function of its namespace, not the runtime", str{ s = entry }, tstr{ c, t }) }
                        }
                    }
                    else => {
                        errorf{ &c, at, msg = @fmt("`{}` context field `{}` must have a capability type or be `args: Args`, got {}", str{ s = entry }, str{ s = f.name }, tstr{ c, t }) }
                    }
                }
            }
            i = i + 1
        }
        if c.diags.errors == bad { c.main = m }
    }

    // The function the program's top level declares as `name`, or NONE.
    fn root_fn { c: Checker, name: []u8 } -> u32 {
        let found = map::get{ m = get_space{ c, ns = ROOT }.values, key = name }
        if found is decl{ i } and get_decl{ c, d = i }.kind == Kind::func { return i }
        return NONE
    }

    // The declaration std's top level has as `name`, such as the capability `Build`, or NONE.
    fn std_decl_top { c: Checker, name: []u8 } -> u32 {
        let decl{ i } = map::get{ m = get_space{ c, ns = STD }.paths, key = name } else { return NONE }
        return i
    }

    // ---- the attributes the compiler declares: `#convert` and `#write`

    // The fns with `#convert` or `#write`, checked once their signatures are resolved: a literal
    // where a T is expected becomes the result of the conversion to T (str_lit), in a const's
    // initializer too, and an @fmt writes each piece with a writer (fmt_calls), so they are
    // known before any body is checked.
    fn compiler_attributes { mut c: Checker } {
        let mut f: usize = 0
        while f < c.files.len {
            compiler_attr_list{ &c, file = @as(u32, f), decls = c.files[f].tree.decls, ns = if f < c.std_files { STD } else { ROOT } }
            f = f + 1
        }
    }

    fn compiler_attr_list { mut c: Checker, file: u32, decls: []syntax::Decl, ns: u32 } {
        let mut i: usize = 0
        while i < decls.len {
            let x = decls[i]
            let mut seen_convert = false
            let mut seen_write = false
            let mut k: usize = 0
            while k < x.attrs.len {
                let a = x.attrs[k]
                let which = compiler_attr{ c, a, ns }
                if which != null {
                    use_attr{ &c, a, which }
                    match which {
                        convert => {
                            convert_attr{ &c, x, file, a, seen = seen_convert }
                            seen_convert = true
                        }
                        write => {
                            write_attr{ &c, x, file, a, seen = seen_write }
                            seen_write = true
                        }
                    }
                }
                k = k + 1
            }
            if x.k is space{ decls = inner } {
                let child = map::get{ m = c.space_of, key = key{ file, id = x.id } }
                if child != null { compiler_attr_list{ &c, file, decls = inner, ns = child } }
            }
            i = i + 1
        }
    }

    // A compiler attribute's name, for messages.
    fn attr_name { a: Attribute } -> []u8 {
        return match a { convert => { "convert" } write => { "write" } }
    }

    // The attribute the compiler declares that a names, if it is one: `#convert` or `#write`
    // where no declaration of the program or std shadows the name.
    fn compiler_attr { c: Checker, a: syntax::Attr, ns: u32 } -> ?Attribute {
        let braced{ callee } = a.value.k else { return null }
        let path{ segs } = callee.k else { return null }
        if segs.len != 1 or segs[0].targs != null { return null }
        let attr{ a = which } = lookup_path{ c, ns, name = segs[0].name.text } else { return null }
        return which
    }

    // Records what a compiler attribute's name refers to. It takes no fields: `#convert` or
    // `#write` alone.
    fn use_attr { mut c: Checker, a: syntax::Attr, which: Attribute } {
        let braced{ callee, items } = a.value.k else { return }
        let path{ segs } = callee.k else { return }
        use{ &c, n = segs[0].name, r = Ref::attr{ a = which } }
        if items.len > 0 {
            errorf{ &c, at = items[0].span, msg = @fmt("`{}` takes no fields", str{ s = segs[0].name.text }) }
        }
    }

    // `#convert` on x: a fn with a body and no generic parameters, whose context is one
    // read-only field of a literal type and whose result is a T or a !T. With only a literal
    // field it takes no capability, so it can run while compiling.
    fn convert_attr { mut c: Checker, x: syntax::Decl, file: u32, a: syntax::Attr, seen: bool } {
        let func{ tparams, params, ret, external } = x.k else {
            error{ &c, at = a.span, msg = "`convert` applies only to a fn" }
            return
        }
        if external {
            error{ &c, at = a.span, msg = "`convert` applies only to a fn with a body, not an extern fn" }
            return
        }
        if seen {
            error{ &c, at = a.span, msg = "duplicate `convert` attribute" }
            return
        }
        if tparams.len > 0 {
            error{ &c, at = a.span, msg = "a `convert` fn can't be generic" }
            return
        }
        let d = map::get{ m = c.decl_of, key = key{ file, id = x.id } } ifnull { return }
        let fd = get_decl{ c, d }
        let one = fd.fields.len == 1
        if one and types::prune{ s = c.ty, t = fd.fields[0].ty } == types::ERROR { return }
        if not one or fd.fields[0].mutable or types::prune{ s = c.ty, t = fd.fields[0].ty } != types::STRLIT {
            let at = if params.len > 0 { params[0].span } else { x.span }
            error{ &c, at, msg = "a `convert` fn takes one read-only field of a literal type: `s: strlit`" }
            return
        }
        let t = converts_to{ c, f = d }
        if t == types::ERROR { return }
        let ret_at = if ret == null { x.span } else { ret.span }
        if t == types::VOID {
            error{ &c, at = ret_at, msg = "a `convert` fn must return a T or a !T: the literal's value" }
            return
        }
        if not convertible{ c, t } {
            errorf{ &c, at = ret_at, msg = @fmt("a `convert` fn can't give a {}: a string literal is one already", tstr{ c, t }) }
            return
        }
        push{ xs = &c.converts, n = d }
    }

    // The type conversion f gives a literal: its result's T, or VOID if it has none.
    fn converts_to { c: Checker, f: u32 } -> Id {
        let r = types::prune{ s = c.ty, t = get_decl{ c, d = f }.ret }
        if types::get{ s = c.ty, id = r } is res{ ok } { return types::prune{ s = c.ty, t = ok } }
        return r
    }

    // Whether a literal where a t is expected may be converted: not where the language makes it
    // a strlit, a []u8 or a [N]u8 itself, also inside ?.
    fn convertible { c: Checker, t: Id } -> bool {
        let mut u = types::prune{ s = c.ty, t }
        if types::get{ s = c.ty, id = u } is opt{ elem } { u = types::prune{ s = c.ty, t = elem } }
        match types::get{ s = c.ty, id = u } {
            strlit => { return false }
            slice{ elem } => { return types::prune{ s = c.ty, t = elem } != types::U8 }
            array{ elem } => { return types::prune{ s = c.ty, t = elem } != types::U8 }
            else => { return true }
        }
    }

    // The conversion that makes a literal in namespace ns a t (PLAN.md 4.4), or null if there
    // is none. Only one that code in ns could name counts: std's code sees std's conversions,
    // and the program's sees std's and its own.
    fn conversion { c: Checker, t: Id, ns: u32 } -> ?u32 {
        if t == types::ERROR or not convertible{ c, t } { return null }
        let fs = list::items{ list = c.converts }
        let mut i: usize = 0
        while i < fs.len {
            if converts_to{ c, f = fs[i] } == t and reaches{ c, from = ns, ns = get_decl{ c, d = fs[i] }.ns } { return fs[i] }
            i = i + 1
        }
        return null
    }

    // A conversion to t other than f that a literal in namespace ns sees, or null if f is the
    // only one (PLAN.md 4.6).
    fn other_conversion { c: Checker, t: Id, f: u32, ns: u32 } -> ?u32 {
        let fs = list::items{ list = c.converts }
        let mut i: usize = 0
        while i < fs.len {
            if fs[i] != f and converts_to{ c, f = fs[i] } == t and reaches{ c, from = ns, ns = get_decl{ c, d = fs[i] }.ns } { return fs[i] }
            i = i + 1
        }
        return null
    }

    // Whether code in namespace `from` can name what namespace ns holds (§10, Name lookup): ns
    // is `from` or around it, or a named namespace in one that is, as `a::b::` names it. The
    // program's top level has no name, so std's code names none of the program's declarations.
    fn reaches { c: Checker, from: u32, ns: u32 } -> bool {
        let mut n = ns
        while n != NONE {
            if encloses{ c, outer = n, inner = from } { return true }
            let sp = get_space{ c, ns = n }
            if sp.parent == NONE { return false }
            let space{ ns = named } = map::get{ m = get_space{ c, ns = sp.parent }.paths, key = sp.name } else { return false }
            if named != n { return false }
            n = sp.parent
        }
        return false
    }

    // Whether namespace outer is inner or around it.
    fn encloses { c: Checker, outer: u32, inner: u32 } -> bool {
        let mut n = inner
        while n != NONE {
            if n == outer { return true }
            n = get_space{ c, ns = n }.parent
        }
        return false
    }

    // The value of a converted literal e: what its conversion gives (comptime::literal),
    // computed the first time it is needed, once the bodies are checked. Null if it has none,
    // after reporting why.
    fn literal_value { mut c: Checker, e: syntax::Expr } -> ?Val {
        let k = expr_key{ e }
        let known = map::get{ m = c.lit_values, key = k }
        if known != null { return known }
        let f = map::get{ m = c.lit_convs, key = k } ifnull { return null }
        if f == NONE or not c.can_eval { return null }
        let str{ bytes } = e.k else { return null }
        let before = c.diags.errors
        let v = comptime::literal{ &c, f, e, bytes } ifnull {
            try! map::put{ m = &c.lit_convs, key = k, value = NONE }
            if c.diags.errors == before { error{ &c, at = expr_at{ e }, msg = "string literal couldn't be computed while compiling" } }
            return null
        }
        try! map::put{ m = &c.lit_values, key = k, value = v }
        return v
    }

    // ---- attributes (§18; PLAN.md stage 3 gives them to generators)

    // Every declaration's attributes, each checked as a const literal of the struct it names.
    // The compiler acts on std's `c::symbol` and `c::callback` and ignores the rest.
    fn attributes { mut c: Checker } {
        let mut f: usize = 0
        while f < c.files.len {
            attribute_list{ &c, file = @as(u32, f), decls = c.files[f].tree.decls, ns = if f < c.std_files { STD } else { ROOT } }
            f = f + 1
        }
    }

    fn attribute_list { mut c: Checker, file: u32, decls: []syntax::Decl, ns: u32 } {
        let symbol_decl = std_decl{ c, space = "c", name = "symbol" }
        let callback_decl = std_decl{ c, space = "c", name = "callback" }
        let mut i: usize = 0
        while i < decls.len {
            let x = decls[i]
            let mut seen = false
            let mut seen_callback = false
            let mut k: usize = 0
            while k < x.attrs.len {
                let a = x.attrs[k]
                if compiler_attr{ c, a, ns } != null {
                    // checked with the signatures (compiler_attributes)
                } else if attribute{ &c, a, ns } is record{ ty, fields } {
                    let rd = record_decl{ c, t = ty }
                    if rd == NONE {
                    } else if rd == symbol_decl {
                        symbol_attr{ &c, x, file, a, fields, seen }
                        seen = true
                    } else if rd == callback_decl {
                        callback_attr{ &c, x, file, a, seen = seen_callback }
                        seen_callback = true
                    }
                }
                k = k + 1
            }
            match x.k {
                space{ decls = inner } => {
                    let child = map::get{ m = c.space_of, key = key{ file, id = x.id } }
                    if child != null { attribute_list{ &c, file, decls = inner, ns = child } }
                }
                cap{ fields } => {
                    if fields != null { field_attributes{ &c, x, file, fields, ns, symbol_decl, callback_decl } }
                }
                else => {}
            }
            i = i + 1
        }
    }

    // The attributes of capability x's fields: `c::symbol` on a C variable gives its symbol (§15,
    // rule 12), and the rest but `c::callback` are checked and ignored.
    fn field_attributes { mut c: Checker, x: syntax::Decl, file: u32, fields: []syntax::Field, ns: u32, symbol_decl: u32, callback_decl: u32 } {
        let d = map::get{ m = c.decl_of, key = key{ file, id = x.id } } ifnull { return }
        let mut i: usize = 0
        while i < fields.len {
            let f = fields[i]
            let mut seen = false
            let mut k: usize = 0
            while k < f.attrs.len {
                let a = f.attrs[k]
                let which = compiler_attr{ c, a, ns }
                if which != null {
                    use_attr{ &c, a, which }
                    errorf{ &c, at = a.span, msg = @fmt("`{}` applies only to a fn", str{ s = attr_name{ a = which } }) }
                } else if attribute{ &c, a, ns } is record{ ty, fields = vals } {
                    let rd = record_decl{ c, t = ty }
                    if rd == NONE {
                    } else if rd == symbol_decl {
                        var_symbol_attr{ &c, d, f, a, fields = vals, seen }
                        seen = true
                    } else if rd == callback_decl {
                        error{ &c, at = a.span, msg = "`c::callback` applies only to a fn" }
                    }
                }
                k = k + 1
            }
            i = i + 1
        }
    }

    // `#c::symbol{ name }` on capability d's field f: the symbol of the C variable it is.
    fn var_symbol_attr { mut c: Checker, d: u32, f: syntax::Field, a: syntax::Attr, fields: []Val, seen: bool } {
        if not f.external {
            error{ &c, at = a.span, msg = "`c::symbol` on a capability's field applies only to a C variable, `extern name: T`" }
            return
        }
        if seen {
            error{ &c, at = a.span, msg = "duplicate `c::symbol` attribute" }
            return
        }
        let name = symbol_name{ &c, a, fields } ifnull { return }
        let vs = get_decl{ c, d }.vars
        let mut i: usize = 0
        while i < vs.len {
            if vs[i].owner == d and slice::eq_bytes{ a = vs[i].name, b = f.name.text } { vs[i].symbol = name }
            i = i + 1
        }
    }

    // The C symbol a capability's variable v reads: its own entry's, in the capability that
    // declares it, which `#c::symbol` may have set after v was copied into others.
    fn var_symbol { c: Checker, v: CVar } -> []u8 {
        let vs = get_decl{ c, d = v.owner }.vars
        let mut i: usize = 0
        while i < vs.len {
            if vs[i].owner == v.owner and slice::eq_bytes{ a = vs[i].name, b = v.name } { return vs[i].symbol }
            i = i + 1
        }
        return v.symbol
    }

    // An attribute's value: a const literal of a struct (§14), or null after reporting why not.
    fn attribute { mut c: Checker, a: syntax::Attr, ns: u32 } -> ?Val {
        begin_body{ &c, sc = Scope{ ns, owner = NONE, names = no_names{}, args = slice::empty(Id){} }, ret = types::VOID }
        let before = c.diags.errors
        let t = expr{ &c, e = a.value, exp = types::NO_TYPE }
        finish{ &c }
        if c.diags.errors != before { return null }
        let lit = map::get{ m = c.literal, key = expr_key{ e = a.value } }
        if lit == null or not lit or record_decl{ c, t } == NONE {
            error{ &c, at = expr_at{ e = a.value }, msg = "an attribute must be a struct literal" }
            return null
        }
        _ = const_ok{ &c, e = a.value, strict = true }
        if c.diags.errors != before { return null }
        let v = fold{ &c, e = a.value }
        if v == null and c.unfolded != NONE {
            errorf{ &c, at = expr_at{ e = a.value }, msg = @fmt("an attribute can't use `{}`: its value is computed by running code", str{ s = get_decl{ c, d = c.unfolded }.name.text }) }
            c.unfolded = NONE
        }
        return v
    }

    // `#c::symbol{ name }` on an extern fn: the C symbol it calls.
    fn symbol_attr { mut c: Checker, x: syntax::Decl, file: u32, a: syntax::Attr, fields: []Val, seen: bool } {
        let mut external = false
        if x.k is func{ external = e } { external = e }
        if not external {
            error{ &c, at = a.span, msg = "`c::symbol` applies only to an extern fn" }
            return
        }
        if seen {
            error{ &c, at = a.span, msg = "duplicate `c::symbol` attribute" }
            return
        }
        let name = symbol_name{ &c, a, fields } ifnull { return }
        let d = map::get{ m = c.decl_of, key = key{ file, id = x.id } }
        if d != null { list::at{ list = c.decls, i = d }.symbol = name }
    }

    // The name a `c::symbol` attribute a gives, from its fields, or null after reporting that
    // it isn't a C identifier.
    fn symbol_name { mut c: Checker, a: syntax::Attr, fields: []Val } -> ?[]u8 {
        let mut name: []u8 = ""
        if fields.len == 1 and fields[0] is sbytes{ bytes } { name = bytes }
        if not c_ident{ s = name } {
            errorf{ &c, at = a.span, msg = @fmt("`{}` is not a C identifier", str{ s = name }) }
            return null
        }
        return name
    }

    // `#c::callback` on a fn: C may call it through a pointer, so it converts to an extern fn
    // type (§12, C function pointers) whose fields include its own. Its fields and result must
    // have C equivalents, and it can't be generic: C's pointer is to one function.
    fn callback_attr { mut c: Checker, x: syntax::Decl, file: u32, a: syntax::Attr, seen: bool } {
        let func{ tparams, params, ret, external } = x.k else {
            error{ &c, at = a.span, msg = "`c::callback` applies only to a fn" }
            return
        }
        if external {
            error{ &c, at = a.span, msg = "`c::callback` applies only to a fn with a body, not an extern fn" }
            return
        }
        if seen {
            error{ &c, at = a.span, msg = "duplicate `c::callback` attribute" }
            return
        }
        if tparams.len > 0 {
            error{ &c, at = a.span, msg = "a `c::callback` fn can't be generic" }
            return
        }
        let d = map::get{ m = c.decl_of, key = key{ file, id = x.id } }
        if d == null { return }
        let at = list::at{ list = c.decls, i = d }
        at.callback = true
        let mut what = message{ c }
        try! @fmt(&what, "callback `{}`", str{ s = at.name.text })
        let ret_at: ?source::Span = if ret == null { null } else { ret.span }
        c_signature{ &c, what = utf8::view{ b = what }, params, ret_at, fields = at.fields, r = at.ret }
        let lf = loaded_field{ c, fields = at.fields }
        if lf != null {
            errorf{ &c, at = x.span, msg = @fmt("callback `{}` can't take `{}`: capability {} {}", str{ s = at.name.text }, str{ s = lf.name }, tstr{ c, t = lf.ty }, str{ s = NO_THUNK }) }
        }
    }

    // Why a callback can't receive a capability with fields.
    const NO_THUNK: []u8 = "has fields, and nothing can supply one when C calls the callback"

    // A letter or `_`, then letters, digits and `_`.
    fn c_ident { s: []u8 } -> bool {
        if s.len == 0 or ascii::is_digit{ c = s[0] } { return false }
        let mut i: usize = 0
        while i < s.len {
            if not ascii::is_alnum{ c = s[i] } and s[i] != '_' { return false }
            i = i + 1
        }
        return true
    }

    // Whether struct declaration d is an extern union, whose fields all start at offset 0 (§12,
    // Untagged unions).
    fn is_untagged { c: Checker, d: u32 } -> bool {
        return get_decl{ c, d }.syn.k is record{ untagged } and untagged
    }

    fn untagged_type { c: Checker, t: Id } -> bool {
        let d = record_decl{ c, t }
        return d != NONE and is_untagged{ c, d }
    }

    // The struct declaration of type t, or NONE if it isn't a struct.
    fn record_decl { c: Checker, t: Id } -> u32 {
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } {
            record{ decl } => { return decl }
            else => { return NONE }
        }
    }

    // The declaration std's namespace `space` has as `name`, or NONE.
    fn std_decl { c: Checker, space: []u8, name: []u8 } -> u32 {
        let space{ ns } = map::get{ m = get_space{ c, ns = STD }.paths, key = space } else { return NONE }
        let decl{ i } = map::get{ m = get_space{ c, ns }.paths, key = name } else { return NONE }
        return i
    }

    // A type std declares at its top level, such as `Args`.
    fn std_type { mut c: Checker, name: []u8 } -> Id {
        let e = lookup_path{ c, ns = STD, name }
        if e == null { return types::ERROR }
        let n = syntax::Name{ id = NONE, span = nowhere{}, text = name }
        return decl_type{ &c, e, name = n, args = null, at = nowhere{}, partial = false, allow_bound = false }
    }

    // ---- type expressions

    fn rtype { mut c: Checker, te: syntax::TypeExpr, sc: Scope, allow_bound: bool } -> Id {
        let t = resolve{ &c, te, sc, allow_bound }
        try! map::put{ m = &c.type_of, key = key{ file = te.span.file, id = te.id }, value = t }
        return t
    }

    fn resolve { mut c: Checker, te: syntax::TypeExpr, sc: Scope, allow_bound: bool } -> Id {
        match te.k {
            error => { return types::ERROR }
            path{ segs } => { return path_type{ &c, segs, sc, allow_bound } }
            ptr{ mutable, elem } => {
                let t = rtype{ &c, te = elem.*, sc, allow_bound = false }
                return types::ptr{ s = &c.ty, elem = t, mutable }
            }
            opt{ elem } => {
                let t = rtype{ &c, te = elem.*, sc, allow_bound = false }
                return types::opt{ s = &c.ty, elem = t }
            }
            slice{ mutable, elem } => {
                let t = rtype{ &c, te = elem.*, sc, allow_bound = false }
                return types::slice{ s = &c.ty, elem = t, mutable }
            }
            array{ n, elem } => {
                let len = const_int{ &c, e = n.*, ns = sc.ns, what = "an array length" }
                let mut ok = len != null
                if len != null and len < 0 {
                    error{ &c, at = te.span, msg = "array length must not be negative" }
                    ok = false
                }
                let t = rtype{ &c, te = elem.*, sc, allow_bound = false }
                if len == null or not ok { return types::ERROR }
                return types::array{ s = &c.ty, n = @as(u64, len), elem = t }
            }
            func{ bound, params, ret, external } => {
                let fields = context{ &c, params, sc }
                let mut r = types::VOID
                if ret != null { r = ret_type{ &c, te = ret.*, sc, owner = NONE } }
                if bound and not allow_bound {
                    error{ &c, at = te.span, msg = "`&fn` can only be the type of a local or a read-only context field" }
                    return types::ERROR
                }
                if external {
                    let ret_at: ?source::Span = if ret == null { null } else { ret.span }
                    c_signature{ &c, what = "an extern fn type", params, ret_at, fields, r }
                }
                return types::func{ s = &c.ty, fields, ret = r, bound, external }
            }
            // `!T` anywhere but a function's own result, where there is no body to infer a set
            // from, fails with any error.
            fail{ elem } => {
                let ok = if elem == null { types::VOID } else { rtype{ &c, te = elem.*, sc, allow_bound = false } }
                return types::res{ s = &c.ty, ok, errs = types::errs{ s = &c.ty, owner = NONE, one = NONE } }
            }
        }
    }

    // A function's result type. `!T` there fails with the errors owner's body can produce, or
    // with any error in a function type (owner NONE), which has no body to infer them from.
    fn ret_type { mut c: Checker, te: syntax::TypeExpr, sc: Scope, owner: u32 } -> Id {
        let fail{ elem } = te.k else { return rtype{ &c, te, sc, allow_bound = false } }
        let ok = if elem == null { types::VOID } else { rtype{ &c, te = elem.*, sc, allow_bound = false } }
        let t = types::res{ s = &c.ty, ok, errs = types::errs{ s = &c.ty, owner, one = NONE } }
        try! map::put{ m = &c.type_of, key = key{ file = te.span.file, id = te.id }, value = t }
        return t
    }

    fn path_type { mut c: Checker, segs: []syntax::Seg, sc: Scope, allow_bound: bool } -> Id {
        let s0 = segs[0]
        if missing{ segs } { return types::ERROR }
        if segs.len == 1 {
            let mut k: usize = 0
            while k < sc.names.len {
                if slice::eq_bytes{ a = sc.names[k].text, b = s0.name.text } {
                    use{ &c, n = s0.name, r = Ref::param{ decl = sc.owner, index = @as(u32, k) } }
                    if s0.targs != null {
                        errorf{ &c, at = s0.name.span, msg = @fmt("generic parameter `{}` takes no type arguments", str{ s = s0.name.text }) }
                        return types::ERROR
                    }
                    return sc.args[k]
                }
                k = k + 1
            }
        }
        let first = lookup_path{ c, ns = sc.ns, name = s0.name.text }
        if first == null {
            if segs.len == 1 and is_infer{ segs } {
                error{ &c, at = s0.name.span, msg = "`_` is a type only as the type argument of @as, @trunc or @cast, where it is the type expected" }
                return types::ERROR
            }
            unknown{ &c, n = s0.name }
            return types::ERROR
        }
        let mut e = first
        refer{ &c, n = s0.name, e }
        let mut i: usize = 1
        while i < segs.len {
            let prev = segs[i - 1]
            let s = segs[i]
            let mut inner = NONE
            if e is space{ ns } { inner = ns }
            if prev.targs != null or inner == NONE {
                errorf{ &c, at = prev.name.span, msg = @fmt("`{}` is not a namespace", str{ s = prev.name.text }) }
                return types::ERROR
            }
            let next = map::get{ m = get_space{ c, ns = inner }.paths, key = s.name.text }
            if next == null {
                errorf{ &c, at = s.name.span, msg = @fmt("no type or namespace `{}` in `{}`", str{ s = s.name.text }, str{ s = prev.name.text }) }
                return types::ERROR
            }
            e = next
            refer{ &c, n = s.name, e }
            i = i + 1
        }
        let last = segs[segs.len - 1]
        let targs = last.targs
        let mut args: ?[]Id = null
        if targs != null {
            let mut xs = list::new(Id){ realloc = arena::alloc, heap = c.heap }
            let mut k: usize = 0
            while k < targs.len {
                push{ xs = &xs, n = rtype{ &c, te = targs[k], sc, allow_bound = false } }
                k = k + 1
            }
            args = list::items{ list = xs }
        }
        return decl_type{ &c, e, name = last.name, args, at = last.name.span, partial = false, allow_bound }
    }

    // Whether a path has a missing name, which the parser has reported.
    fn missing { segs: []syntax::Seg } -> bool {
        let mut i: usize = 0
        while i < segs.len {
            if segs[i].name.text.len == 0 { return true }
            i = i + 1
        }
        return false
    }

    fn unknown { mut c: Checker, n: syntax::Name } {
        errorf{ &c, at = n.span, msg = @fmt("unknown type or namespace `{}`", str{ s = n.text }) }
    }

    // The type that path entry e names, with args if it was given any. If partial, as where a
    // literal or a variant names a generic type, the arguments not given are inferred: each is a
    // new variable, which must be bound by the end of the body.
    fn decl_type { mut c: Checker, e: Entry, name: syntax::Name, args: ?[]Id, at: source::Span, partial: bool, allow_bound: bool } -> Id {
        let given: usize = if args == null { 0 } else { args.len }
        match e {
            prim{ p } => {
                if given > 0 { no_targs{ &c, what = types::PRIM_NAMES[@as(usize, p)], at } }
                return types::prim{ p }
            }
            anyerr => {
                if given > 0 { no_targs{ &c, what = "error", at } }
                return types::errs{ s = &c.ty, owner = NONE, one = NONE }
            }
            strlit => {
                if given > 0 { no_targs{ &c, what = "strlit", at } }
                return types::STRLIT
            }
            attr => {
                errorf{ &c, at, msg = @fmt("`{}` is an attribute, not a type", str{ s = name.text }) }
                return types::ERROR
            }
            space{ ns } => {
                errorf{ &c, at, msg = @fmt("namespace `{}` used as a type", str{ s = get_space{ c, ns }.name }) }
                return types::ERROR
            }
            decl{ i } => {
                let x = get_decl{ c, d = i }
                if x.kind == Kind::cap {
                    if given > 0 { no_targs{ &c, what = x.name.text, at } }
                    return types::cap{ s = &c.ty, decl = i }
                }
                let n = x.tparams.len
                if given > n or (given < n and not partial) {
                    errorf{ &c, at, msg = @fmt("`{}` expects {} type argument(s), got {}", str{ s = x.name.text }, n, given) }
                    return types::ERROR
                }
                let mut all = list::new(Id){ realloc = arena::alloc, heap = c.heap }
                if args != null {
                    let mut k: usize = 0
                    while k < args.len {
                        push{ xs = &all, n = args[k] }
                        k = k + 1
                    }
                }
                while all.len < n {
                    let v = types::fresh{ s = &c.ty, kind = types::VarKind::any }
                    generic_var{ &c, v, param = x.tparams[all.len], owner = x.name, at }
                    push{ xs = &all, n = v }
                }
                let xs: []Id = list::items{ list = all }
                match x.kind {
                    record => { return types::record{ s = &c.ty, decl = i, args = xs } }
                    sum => { return types::sum{ s = &c.ty, decl = i, args = xs } }
                    enumeration => { return types::intern{ s = &c.ty, t = types::Type::enumeration{ decl = i } } }
                    alias => {
                        let items = list::items{ list = c.alias_stack }
                        let mut k: usize = 0
                        while k < items.len {
                            if items[k] == i {
                                errorf{ &c, at, msg = @fmt("type alias `{}` refers to itself", str{ s = x.name.text }) }
                                return types::ERROR
                            }
                            k = k + 1
                        }
                        push{ xs = &c.alias_stack, n = i }
                        let mut t = types::ERROR
                        if x.syn.k is alias{ ty } {
                            t = rtype{ &c, te = ty, sc = Scope{ ns = x.ns, owner = i, names = x.tparams, args = xs }, allow_bound }
                        }
                        _ = list::pop{ list = &c.alias_stack }
                        return t
                    }
                    else => { @panic("check: a value in a path table") }
                }
            }
        }
    }

    fn no_targs { mut c: Checker, what: []u8, at: source::Span } {
        errorf{ &c, at, msg = @fmt("`{}` takes no type arguments", str{ s = what }) }
    }

    // ---- compile-time integers: array lengths and enum values (ctxi's const_int)

    // The value of e, or null after reporting why it has none. `what` names what it is for.
    fn const_int { mut c: Checker, e: syntax::Expr, ns: u32, what: utf8::String } -> ?i64 {
        let at = expr_at{ e }
        match e.k {
            error => { return null }
            int{ negative, value } => {
                if value == null or value > 9223372036854775808 or (value == 9223372036854775808 and not negative) {
                    too_large{ &c, at }
                    return null
                }
                if value == 9223372036854775808 { return -9223372036854775807 - 1 }
                let v = @as(i64, value)
                return if negative { -v } else { v }
            }
            neg{ e = inner } => {
                let v = const_int{ &c, e = inner.*, ns, what }
                if v == null { return null }
                if v == -9223372036854775807 - 1 {
                    too_large{ &c, at }
                    return null
                }
                return -v
            }
            binary{ op, a, b } => {
                if is_const_op{ op } {
                    let x = const_int{ &c, e = a.*, ns, what }
                    let y = const_int{ &c, e = b.*, ns, what }
                    if x == null or y == null { return null }
                    return arith{ &c, op, x, y, at }
                }
            }
            path{ segs } => {
                let d = const_decl{ &c, segs, ns, at }
                if d != null and d != NONE {
                    let x = get_decl{ c, d }
                    let items = list::items{ list = c.const_stack }
                    let mut k: usize = 0
                    while k < items.len {
                        if items[k] == d {
                            errorf{ &c, at, msg = @fmt("const `{}` refers to itself", str{ s = x.name.text }) }
                            return null
                        }
                        k = k + 1
                    }
                    let mut v: ?i64 = null
                    if x.syn.k is constant{ value } {
                        if calls{ e = value } {
                            // It is evaluated (§14), long after the declarations need it.
                            errorf{ &c, at, msg = @fmt("{} can't use `{}`: its value is computed by calling a function", what, str{ s = x.name.text }) }
                            return null
                        }
                        push{ xs = &c.const_stack, n = d }
                        v = const_int{ &c, e = value, ns = x.ns, what }
                        _ = list::pop{ list = &c.const_stack }
                    }
                    return v
                }
                if d == null { return null }
            }
            else => {}
        }
        errorf{ &c, at, msg = @fmt("{} must be a compile-time integer constant", what) }
        return null
    }

    // Whether an integer initializer calls a function: braces where an integer is are a call.
    fn calls { e: syntax::Expr } -> bool {
        match e.k {
            braced => { return true }
            neg{ e = x } => { return calls{ e = x.* } }
            binary{ a, b } => { return calls{ e = a.* } or calls{ e = b.* } }
            else => { return false }
        }
    }

    fn too_large { mut c: Checker, at: source::Span } {
        error{ &c, at, msg = "integer constant is too large" }
    }

    fn is_const_op { op: tok::Kind } -> bool {
        return op == tok::Kind::plus or op == tok::Kind::minus or op == tok::Kind::star or op == tok::Kind::slash
            or op == tok::Kind::percent or op == tok::Kind::amp or op == tok::Kind::pipe or op == tok::Kind::caret
            or op == tok::Kind::shl or op == tok::Kind::shr
    }

    fn arith { mut c: Checker, op: tok::Kind, x: i64, y: i64, at: source::Span } -> ?i64 {
        let min: i64 = -9223372036854775807 - 1
        if op == tok::Kind::slash or op == tok::Kind::percent {
            if y == 0 {
                error{ &c, at, msg = "division by zero in constant" }
                return null
            }
            if x == min and y == -1 {
                if op == tok::Kind::percent { return 0 }
                too_large{ &c, at }
                return null
            }
            return if op == tok::Kind::slash { x / y } else { x % y }
        }
        if op == tok::Kind::shl or op == tok::Kind::shr {
            if y < 0 or y >= 64 {
                error{ &c, at, msg = "shift count out of range in constant" }
                return null
            }
            return if op == tok::Kind::shl { x << y } else { x >> y }
        }
        if op == tok::Kind::amp { return x & y }
        if op == tok::Kind::pipe { return x | y }
        if op == tok::Kind::caret { return x ^ y }
        let r = if op == tok::Kind::plus { @wrap_add(x, y) } else if op == tok::Kind::minus { @wrap_sub(x, y) } else { @wrap_mul(x, y) }
        let over = if op == tok::Kind::plus {
            (x >= 0) == (y >= 0) and (r >= 0) != (x >= 0)
        } else if op == tok::Kind::minus {
            (x >= 0) != (y >= 0) and (r >= 0) != (x >= 0)
        } else {
            x != 0 and ((x == -1 and y == min) or (y == min and x != 1) or r / x != y)
        }
        if over {
            too_large{ &c, at }
            return null
        }
        return r
    }

    // The const a path names: its Decl, NONE if it names something else, or null after an
    // error. As in ctxi, a name is looked up among values and a longer path through namespaces.
    fn const_decl { mut c: Checker, segs: []syntax::Seg, ns: u32, at: source::Span } -> ?u32 {
        if missing{ segs } { return null }
        let last = segs[segs.len - 1]
        let mut found: ?Entry = null
        if segs.len == 1 {
            found = lookup_value{ c, ns, name = last.name.text }
        } else {
            let first = lookup_path{ c, ns, name = segs[0].name.text }
            if first == null {
                errorf{ &c, at, msg = @fmt("unknown type or namespace `{}`", str{ s = segs[0].name.text }) }
                return null
            }
            let mut p: ?Entry = first
            let mut i: usize = 1
            while i < segs.len - 1 {
                p = if p is space{ ns = n } { map::get{ m = get_space{ c, ns = n }.paths, key = segs[i].name.text } } else { null }
                i = i + 1
            }
            if p is space{ ns = n } { found = map::get{ m = get_space{ c, ns = n }.values, key = last.name.text } }
        }
        if found is decl{ i } and get_decl{ c, d = i }.kind == Kind::constant {
            use{ &c, n = last.name, r = Ref::decl{ i } }
            return i
        }
        return NONE
    }

    // ---- lookup

    // A namespace or type, from namespace ns outward.
    fn lookup_path { c: Checker, ns: u32, name: []u8 } -> ?Entry {
        let mut n = ns
        while n != NONE {
            let sp = get_space{ c, ns = n }
            let e = map::get{ m = sp.paths, key = name }
            if e != null { return e }
            n = sp.parent
        }
        return null
    }

    // A function or const, from namespace ns outward.
    fn lookup_value { c: Checker, ns: u32, name: []u8 } -> ?Entry {
        let mut n = ns
        while n != NONE {
            let sp = get_space{ c, ns = n }
            let e = map::get{ m = sp.values, key = name }
            if e != null { return e }
            n = sp.parent
        }
        return null
    }

    // Records what name n refers to.
    fn use { mut c: Checker, n: syntax::Name, r: Ref } {
        if n.id == NONE { return }
        try! map::put{ m = &c.uses, key = key{ file = n.span.file, id = n.id }, value = r }
    }

    fn refer { mut c: Checker, n: syntax::Name, e: Entry } {
        match e {
            space{ ns } => { use{ &c, n, r = Ref::space{ ns } } }
            decl{ i } => { use{ &c, n, r = Ref::decl{ i } } }
            prim{ p } => { use{ &c, n, r = Ref::prim{ p } } }
            anyerr => { use{ &c, n, r = Ref::anyerr } }
            strlit => { use{ &c, n, r = Ref::strlit } }
            attr{ a } => { use{ &c, n, r = Ref::attr{ a } } }
        }
    }

    fn key { file: u32, id: u32 } -> u64 {
        return (@as(u64, file) << 32) | id
    }

    fn get_space { c: Checker, ns: u32 } -> Space {
        return list::items{ list = c.spaces }[ns]
    }

    fn get_decl { c: Checker, d: u32 } -> Decl {
        return list::items{ list = c.decls }[d]
    }

    // ---- types as text (ctxi's tstr)

    fn tstr { c: Checker, t: Id } -> utf8::String {
        let mut b = message{ c }
        try! write_type{ c, t, &b }
        return utf8::view{ b }
    }

    fn write_type { c: Checker, t: Id, mut b: utf8::Builder(Heap) } -> ! {
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } {
            var{ n } => {
                match types::var_of{ s = c.ty, n }.kind {
                    int => { return utf8::push{ &b, s = "{integer}" } }
                    float => { return utf8::push{ &b, s = "{float}" } }
                    any => { return utf8::push{ &b, s = "_" } }
                }
            }
            error => { return utf8::push{ &b, s = "{error}" } }
            void => { return utf8::push{ &b, s = "no value" } }
            nil => { return utf8::push{ &b, s = "null" } }
            strlit => { return utf8::push{ &b, s = "strlit" } }
            prim{ p } => { return utf8::push{ &b, s = str{ s = types::PRIM_NAMES[@as(usize, p)] } } }
            cap{ decl } => { return utf8::push{ &b, s = str{ s = get_decl{ c, d = decl }.name.text } } }
            ptr{ elem, mutable } => {
                try utf8::push{ &b, s = if mutable { "*mut " } else { "*" } }
                return write_type{ c, t = elem, &b }
            }
            slice{ elem, mutable } => {
                try utf8::push{ &b, s = if mutable { "[]mut " } else { "[]" } }
                return write_type{ c, t = elem, &b }
            }
            array{ n, elem } => {
                try @fmt(&b, "[{}]", n)
                return write_type{ c, t = elem, &b }
            }
            opt{ elem } => {
                try utf8::push{ &b, s = "?" }
                return write_type{ c, t = elem, &b }
            }
            enumeration{ decl } => { return utf8::push{ &b, s = str{ s = get_decl{ c, d = decl }.qual } } }
            record{ decl, args } => { return generic{ c, decl, args, &b } }
            sum{ decl, args } => { return generic{ c, decl, args, &b } }
            func{ fields, ret, bound, external } => {
                try utf8::push{ &b, s = if bound { "&fn{" } else if external { "extern fn{" } else { "fn{" } }
                let mut i: usize = 0
                while i < fields.len {
                    let f = fields[i]
                    try utf8::push{ &b, s = if i == 0 { " " } else { ", " } }
                    try utf8::push{ &b, s = if f.mutable { "mut " } else { "" } }
                    try @fmt(&b, "{}: ", str{ s = f.name })
                    try write_type{ c, t = f.ty, &b }
                    i = i + 1
                }
                if fields.len > 0 { try utf8::push{ &b, s = " " } }
                try utf8::push{ &b, s = "}" }
                if ret != types::VOID {
                    try utf8::push{ &b, s = " -> " }
                    try write_type{ c, t = ret, &b }
                }
            }
            param{ decl, index } => { return utf8::push{ &b, s = str{ s = get_decl{ c, d = decl }.tparams[index].text } } }
            errs{ owner, one } => {
                if one != NONE { return utf8::push{ &b, s = str{ s = get_decl{ c, d = one }.qual } } }
                if owner == NONE { return utf8::push{ &b, s = "error" } }
                if owner >= SITE {
                    try utf8::push{ &b, s = "error of " }
                    return site_text{ c, owner, &b }
                }
                return @fmt(&b, "error of `{}`", str{ s = get_decl{ c, d = owner }.qual })
            }
            eset{ errs } => {
                try utf8::push{ &b, s = "error{" }
                let mut i: usize = 0
                while i < errs.len {
                    if i > 0 { try utf8::push{ &b, s = ", " } }
                    try utf8::push{ &b, s = str{ s = get_decl{ c, d = errs[i] }.qual } }
                    i = i + 1
                }
                return utf8::push{ &b, s = "}" }
            }
            res{ ok, errs } => {
                try utf8::push{ &b, s = "!" }
                if ok != types::VOID { try write_type{ c, t = ok, &b } }
            }
        }
    }

    // What errors of type t (an errs) may be, for messages: "the errors of `f`", "`fs::eof`" or
    // "any error".
    fn set_text { c: Checker, t: Id, mut b: utf8::Builder(Heap) } -> ! {
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } {
            errs{ owner, one } => {
                if one != NONE { return @fmt(&b, "`{}`", str{ s = get_decl{ c, d = one }.qual }) }
                if owner == NONE { return utf8::push{ &b, s = "any error" } }
                if owner >= SITE {
                    try utf8::push{ &b, s = "the errors of " }
                    return site_text{ c, owner, &b }
                }
                return @fmt(&b, "the errors of `{}`", str{ s = get_decl{ c, d = owner }.qual })
            }
            else => { return write_type{ c, t, &b } }
        }
    }

    // `name(A, B)`, or `name` without arguments.
    fn generic { c: Checker, decl: u32, args: []Id, mut b: utf8::Builder(Heap) } -> ! {
        try utf8::push{ &b, s = str{ s = get_decl{ c, d = decl }.qual } }
        if args.len == 0 { return }
        try utf8::push{ &b, s = "(" }
        let mut i: usize = 0
        while i < args.len {
            if i > 0 { try utf8::push{ &b, s = ", " } }
            try write_type{ c, t = args[i], &b }
            i = i + 1
        }
        return utf8::push{ &b, s = ")" }
    }

    // ---- bodies: const initializers and functions (ctxi's check_const and check_fn)

    fn check_const { mut c: Checker, d: u32 } {
        let x = get_decl{ c, d }
        if x.syn.k is constant{ value } {
            begin_body{ &c, sc = Scope{ ns = x.ns, owner = NONE, names = no_names{}, args = slice::empty(Id){} }, ret = types::VOID }
            let before = c.diags.errors
            expect{ &c, e = value, t = x.ty }
            finish{ &c }
            if c.diags.errors == before {
                let folds = const_ok{ &c, e = value, strict = false }
                if c.diags.errors == before {
                    if folds { put_bool{ m = &c.foldable, k = d } } else { put_bool{ m = &c.evaluated, k = d } }
                }
            }
        }
    }

    // A function's body, with its context fields in the outermost scope.
    fn check_fn { mut c: Checker, d: u32 } {
        let x = get_decl{ c, d }
        if x.syn.k is func{ params, body } {
            begin_body{ &c, sc = own_scope{ &c, d }, ret = x.ret }
            c.fn_decl = d
            try! map::put{ m = &c.first_var, key = d, value = @as(u32, c.vars.len) }
            let mut i: usize = 0
            while i < x.fields.len and i < params.len {
                let f = x.fields[i]
                let v = new_var{ &c, name = f.name, ty = f.ty, kind = VarKind::ctx, mutable = f.mutable, at = params[i].span }
                list::at{ list = c.vars, i = v }.indirect = f.mutable
                bind_name{ &c, name = f.name, var = v }
                i = i + 1
            }
            block{ &c, b = body }
            if x.ret != types::VOID and x.ret != types::ERROR and not c.dead and not void_result{ c, t = x.ret } {
                errorf{ &c, at = x.syn.span, msg = @fmt("`{}` must end every path in `return` or `@panic()`", str{ s = x.name.text }) }
            }
            finish{ &c }
        }
    }

    fn begin_body { mut c: Checker, sc: Scope, ret: Id } {
        c.sc = sc
        c.ret = ret
        c.fn_decl = NONE
        list::clear{ list = &c.lits }
        list::clear{ list = &c.gvars }
        list::clear{ list = &c.fmts }
        list::clear{ list = &c.scope }
        list::clear{ list = &c.marks }
        list::clear{ list = &c.loops }
        add_mark{ &c, n = 0 }
        c.depth = 0
        c.loop_depth = 0
        c.loop_base = 0
        c.defers = 0
        c.dead = false
        c.defs = slice::empty(u32){}
        c.maybe = slice::empty(u32){}
        c.body_errors = c.diags.errors
        c.flow_errors = 0
        c.label_ids = 0
    }

    // Settles the body's literals: those whose type nothing fixed get the defaults, i32 and
    // f64, and each integer must fit its type. Then each @fmt finds its writers, for the
    // settled types. Last, every generic argument must be known.
    fn finish { mut c: Checker } {
        let fs = list::items{ list = c.fmts }
        let lits = list::items{ list = c.lits }
        let mut i: usize = 0
        while i < lits.len {
            let t = type_of_expr{ c, e = lits[i] }
            let v = types::unbound{ s = c.ty, t }
            if v != null {
                let float = types::var_of{ s = c.ty, n = v }.kind == types::VarKind::float
                _ = types::unify{ s = &c.ty, a = t, b = if float { types::prim{ p = types::Prim::f64 } } else { types::I32 } }
            }
            i = i + 1
        }
        i = 0
        while i < fs.len {
            fmt_calls{ &c, e = fs[i] }
            i = i + 1
        }
        i = 0
        while i < lits.len {
            let e = lits[i]
            if e.k is int{ negative, value } {
                let t = types::prune{ s = c.ty, t = type_of_expr{ c, e } }
                let p = types::prim_of{ s = c.ty, t }
                if p != null and (value == null or not types::fits{ p, negative, magnitude = value }) {
                    let mut b = message{ c }
                    let sign: utf8::String = if negative { "-" } else { "" }
                    let digits = if value == null { str{ s = source_text{ c, span = e.span } } } else { message_u64{ c, n = value } }
                    try! @fmt(&b, "literal {}{} does not fit in {}", sign, digits, tstr{ c, t })
                    try! fixed_by{ c, t = type_of_expr{ c, e }, &b }
                    error{ &c, at = expr_at{ e }, msg = utf8::view{ b } }
                }
            }
            i = i + 1
        }
        let gs = list::items{ list = c.gvars }
        i = 0
        while i < gs.len {
            let g = gs[i]
            if types::has_vars{ s = c.ty, t = g.v } {
                errorf{ &c, at = g.at, msg = @fmt("cannot infer type parameter `{}` of `{}`", str{ s = g.param }, str{ s = g.owner }) }
            }
            if types::has_bound_fn{ s = c.ty, t = g.v } {
                errorf{ &c, at = g.at, msg = @fmt("type parameter `{}` of `{}` cannot be a `&fn` type", str{ s = g.param }, str{ s = g.owner }) }
            }
            i = i + 1
        }
        list::clear{ list = &c.gvars }
    }

    fn message_u64 { c: Checker, n: u64 } -> utf8::String {
        let mut b = message{ c }
        try! @fmt(&b, "{}", n)
        return utf8::view{ b }
    }

    fn source_text { c: Checker, span: source::Span } -> []u8 {
        return c.files[span.file].text[span.start..span.end]
    }

    // `, which it gets from `n` at 3:9`: why a literal of type t has its type, if an operand
    // fixed it.
    fn fixed_by { c: Checker, t: Id, mut b: utf8::Builder(Heap) } -> ! {
        let mut x = t
        while true {
            match types::get{ s = c.ty, id = x } {
                var{ n } => {
                    let v = types::var_of{ s = c.ty, n }
                    let f = v.fixed
                    if f != null {
                        let file = c.files[f.at.file]
                        let p = source::position{ text = file.text, lines = file.lines, offset = f.at.start }
                        if f.path.len > 0 {
                            return @fmt(&b, ", which it gets from `{}` at {}:{}", str{ s = f.path }, p.line, p.col)
                        }
                        return @fmt(&b, ", which it gets from the operand at {}:{}", p.line, p.col)
                    }
                    if v.ref == types::NO_TYPE { return }
                    x = v.ref
                }
                else => { return }
            }
        }
    }

    // A generic argument to infer by the end of the body.
    fn generic_var { mut c: Checker, v: Id, param: syntax::Name, owner: syntax::Name, at: source::Span } {
        try! list::push{ list = &c.gvars, item = GVar{ v, param = param.text, owner = owner.text, at } }
    }

    // §14: whether folding can compute a const's initializer: literals, other consts, enum
    // values, operators, `@size_of`, `@align_of`, and literals of these. What it can't is
    // evaluated (comptime.ctx), or, in an attribute (strict), an error.
    fn const_ok { mut c: Checker, e: syntax::Expr, strict: bool } -> bool {
        let at = expr_at{ e }
        if map::get{ m = c.convs, key = expr_key{ e } } is slice {
            return unfoldable{ &c, at, strict, msg = "must be computable at compile time" }
        }
        match e.k {
            error | int | float | boolean | nil => { return true }
            str => {
                if map::has{ m = c.lit_convs, key = expr_key{ e } } { return unfoldable{ &c, at, strict, msg = "cannot convert a string literal: its conversion runs code" } }
                return true
            }
            neg{ e = x } => { return const_ok{ &c, e = x.*, strict } }
            lnot{ e = x } => { return const_ok{ &c, e = x.*, strict } }
            binary{ a, b } => {
                let x = const_ok{ &c, e = a.*, strict }
                let y = const_ok{ &c, e = b.*, strict }
                return x and y
            }
            array{ elems } => { return const_list{ &c, xs = elems, strict } }
            repeat{ elem } => { return const_ok{ &c, e = elem.*, strict } }
            path => {
                let r = map::get{ m = c.refs, key = expr_key{ e } }
                if not (r is constant | variant | enumval) { return unfoldable{ &c, at, strict, msg = "may only refer to consts" } }
                return true
            }
            builtin{ name, args } => {
                let mut ok = true
                if not slice::eq_bytes{ a = name.text, b = "size_of" } and not slice::eq_bytes{ a = name.text, b = "align_of" } {
                    if strict {
                        errorf{ &c, at, msg = @fmt("@{} is not allowed in an attribute", str{ s = name.text }) }
                    }
                    ok = false
                }
                return const_list{ &c, xs = args, strict } and ok
            }
            braced{ items } => {
                let lit = map::get{ m = c.literal, key = expr_key{ e } }
                let mut ok = true
                if lit == null or not lit {
                    ok = unfoldable{ &c, at, strict, msg = "cannot call a function" }
                    if not strict { return false }
                } else if untagged_type{ c, t = type_of_expr{ c, e } } {
                    error{ &c, at, msg = if strict { "an attribute cannot hold an extern union" } else { "a const cannot hold an extern union" } }
                    return false
                }
                let mut i: usize = 0
                while i < items.len {
                    if not const_ok{ &c, e = items[i].value, strict } { ok = false }
                    i = i + 1
                }
                return ok
            }
            else => { return unfoldable{ &c, at, strict, msg = "must be computable at compile time" } }
        }
    }

    // False, after reporting `an attribute MSG` if strict.
    fn unfoldable { mut c: Checker, at: source::Span, strict: bool, msg: []u8 } -> bool {
        if strict {
            errorf{ &c, at, msg = @fmt("an attribute {}", str{ s = msg }) }
        }
        return false
    }

    fn const_list { mut c: Checker, xs: []syntax::Expr, strict: bool } -> bool {
        let mut ok = true
        let mut i: usize = 0
        while i < xs.len {
            if not const_ok{ &c, e = xs[i], strict } { ok = false }
            i = i + 1
        }
        return ok
    }

    // ---- const values (§14), computed at compile time (ctxi's Checker.fold)
    //
    // The operations are the runtime's, and what would panic at run time is a compile error at
    // the operation. An integer is a sign and a magnitude, so every value of every integer type
    // fits, and an intermediate result too large for a u64 overflows every type.

    union Val {
        int{ ty: Id, negative: bool, magnitude: u64 },
        float{ ty: Id, value: f64 },            // an f32's value is one an f32 holds
        boolean{ ty: Id, value: bool },
        str{ ty: Id, bytes: []u8 },             // a [N]u8
        sbytes{ ty: Id, bytes: []u8 },          // a view of static bytes
        cstr{ ty: Id, bytes: []u8 },            // a *u8 to static bytes with a NUL after them
        nil{ ty: Id },
        record{ ty: Id, fields: []Val },        // a struct's fields, in order
        variant{ ty: Id, index: u32, fields: []Val },
        array{ ty: Id, elems: []Val },
        repeat{ ty: Id, elem: *Val },           // N copies, N from the array type
    }

    struct Num { negative: bool, magnitude: u64 }

    fn put_bool { mut m: map::Map(u32, bool, Heap), k: u32 } {
        try! map::put{ m = &m, key = k, value = true }
    }

    // The value of const d, computed the first time it is needed; null if its initializer has
    // an error, or computing it did. at is where it is needed, for a cycle. An evaluated const
    // has none until the bodies are checked: folding that meets one notes it in unfolded, and
    // the consts folding it was for are evaluated too.
    fn const_value { mut c: Checker, d: u32, at: source::Span } -> ?Val {
        let known = map::get{ m = c.values, key = d }
        if known != null { return known }
        let folds = map::has{ m = c.foldable, key = d }
        if not folds and not map::has{ m = c.evaluated, key = d } { return null }
        if not folds and not c.can_eval {
            c.unfolded = d
            return null
        }
        let x = get_decl{ c, d }
        if has_id{ xs = list::items{ list = c.folding }, n = d } {
            errorf{ &c, at, msg = @fmt("const `{}` refers to itself", str{ s = x.name.text }) }
            return null
        }
        push{ xs = &c.folding, n = d }
        let mut v: ?Val = null
        if x.syn.k is constant{ value } {
            if folds {
                v = fold_to{ &c, e = value, t = x.ty }
            } else {
                // A value missing without an error would reach lowering, which has none to give.
                let before = c.diags.errors
                v = comptime::value{ &c, d, e = value }
                if v == null and c.diags.errors == before {
                    errorf{ &c, at = expr_at{ e = value }, msg = @fmt("const `{}` couldn't be computed while compiling", str{ s = x.qual }) }
                }
            }
        }
        _ = list::pop{ list = &c.folding }
        let got = v
        if got == null {
            _ = map::remove{ m = &c.foldable, key = d }
            _ = map::remove{ m = &c.evaluated, key = d }
            if folds and c.unfolded != NONE { put_bool{ m = &c.evaluated, k = d } }
            return null
        }
        try! map::put{ m = &c.values, key = d, value = got }
        return got
    }

    // e's value, as a value of type t, which it widens to.
    fn fold_to { mut c: Checker, e: syntax::Expr, t: Id } -> ?Val {
        let v = fold{ &c, e }
        if v == null { return null }
        return retype{ c, v, t = types::prune{ s = c.ty, t } }
    }

    fn retype { c: Checker, v: Val, t: Id } -> Val {
        if not (types::get{ s = c.ty, id = t } is prim | enumeration) { return v }
        match v {
            int{ negative, magnitude } => { return Val::int{ ty = t, negative, magnitude } }
            float{ value } => { return Val::float{ ty = t, value } }
            else => { return v }
        }
    }

    // e's value, inside the conversion the checker recorded for it.
    fn fold { mut c: Checker, e: syntax::Expr } -> ?Val {
        let conv = map::get{ m = c.convs, key = expr_key{ e } }
        if conv != null {
            match conv {
                some{ to } => {
                    let t = types::prune{ s = c.ty, t = to }
                    let mut elem = types::ERROR
                    if types::get{ s = c.ty, id = t } is opt{ elem = x } { elem = x }
                    let inner = fold_node{ &c, e }
                    if inner == null { return null }
                    return Val::variant{ ty = t, index = 1, fields = one_val{ c, v = retype{ c, v = inner, t = types::prune{ s = c.ty, t = elem } } } }
                }
                else => { return null }
            }
        }
        return fold_node{ &c, e }
    }

    fn one_val { c: Checker, v: Val } -> []Val {
        let mut out = list::new(Val){ realloc = arena::alloc, heap = c.heap }
        add_val{ xs = &out, v }
        return list::items{ list = out }
    }

    fn add_val { mut xs: list::List(Val, Heap), v: Val } {
        try! list::push{ list = &xs, item = v }
    }

    fn fold_node { mut c: Checker, e: syntax::Expr } -> ?Val {
        let t = types::prune{ s = c.ty, t = type_of_expr{ c, e } }
        match e.k {
            int{ negative, value } => {
                let m = if value == null { 0 } else { value }
                return Val::int{ ty = t, negative = negative and m != 0, magnitude = m }
            }
            float{ negative, value } => {
                let v = if negative { -value } else { value }
                return Val::float{ ty = t, value = if is_f32{ t } { f32r{ x = v } } else { v } }
            }
            boolean{ value } => { return Val::boolean{ ty = t, value } }
            nil => { return Val::nil{ ty = t } }
            // A converted literal isn't folded: its conversion runs (const_ok).
            str{ bytes } => {
                match types::get{ s = c.ty, id = t } {
                    array => { return Val::str{ ty = t, bytes } }
                    slice | strlit => { return Val::sbytes{ ty = t, bytes } }
                    else => { return null }
                }
            }
            path => {
                let r = map::get{ m = c.refs, key = expr_key{ e } }
                if r == null { return null }
                match r {
                    constant{ decl } => { return const_value{ &c, d = decl, at = expr_at{ e } } }
                    enumval{ ty, index } => {
                        match types::get{ s = c.ty, id = ty } {
                            enumeration{ decl } => {
                                let v = get_decl{ c, d = decl }.values[index]
                                return Val::int{ ty = t, negative = v < 0, magnitude = magnitude{ v } }
                            }
                            else => { return null }
                        }
                    }
                    variant{ index } => { return Val::variant{ ty = t, index, fields = slice::empty(Val){} } }
                    else => { return null }
                }
            }
            braced{ callee, items } => { return fold_literal{ &c, e, callee = callee.*, items, t } }
            array{ elems } => {
                let et = elem_type{ c, t }
                let mut out = list::new(Val){ realloc = arena::alloc, heap = c.heap }
                let mut i: usize = 0
                while i < elems.len {
                    let v = fold_to{ &c, e = elems[i], t = et }
                    if v == null { return null }
                    add_val{ xs = &out, v }
                    i = i + 1
                }
                return Val::array{ ty = t, elems = list::items{ list = out } }
            }
            repeat{ elem } => {
                let v = fold_to{ &c, e = elem.*, t = elem_type{ c, t } }
                if v == null { return null }
                let p = try! alloc::new{ realloc = arena::alloc, heap = c.heap, value = v }
                return Val::repeat{ ty = t, elem = p }
            }
            builtin{ name, targ } => {
                if targ == null { return null }
                let te = targ.*
                let tt = map::get{ m = c.type_of, key = key{ file = te.span.file, id = te.id } }
                if tt == null { return null }
                let lay = layout{ &c, t = types::prune{ s = c.ty, t = tt } }
                if lay == null { return null }
                let n = if slice::eq_bytes{ a = name.text, b = "size_of" } { lay.size } else { lay.align }
                return Val::int{ ty = t, negative = false, magnitude = n }
            }
            lnot{ e = x } => {
                let v = fold{ &c, e = x.* }
                if v == null { return null }
                return Val::boolean{ ty = t, value = not bool_of{ v } }
            }
            neg{ e = x } => {
                let v = fold{ &c, e = x.* }
                if v == null { return null }
                if v is float{ value } { return Val::float{ ty = t, value = -value } }
                let n = num_of{ v }
                return fits_in{ &c, n = Num{ negative = not n.negative and n.magnitude != 0, magnitude = n.magnitude }, t, at = expr_at{ e } }
            }
            binary{ op, a, b } => { return fold_binary{ &c, e, op, a = a.*, b = b.*, t } }
            else => { return null }
        }
    }

    // A struct or variant literal: its fields' values in the order of the fields.
    fn fold_literal { mut c: Checker, e: syntax::Expr, callee: syntax::Expr, items: []syntax::Item, t: Id } -> ?Val {
        let mut fields = struct_fields{ &c, t }
        let mut index = NONE
        if map::get{ m = c.refs, key = expr_key{ e = callee } } is variant{ index = vi } {
            index = vi
            let fs = variants_of{ &c, t }[vi].fields
            fields = if fs == null { slice::empty(types::Field){} } else { fs }
        }
        let mut out = list::new(Val){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < fields.len {
            let mut k = items.len
            let mut found = NONE
            while k > 0 {
                k = k - 1
                if slice::eq_bytes{ a = items[k].name.text, b = fields[i].name } {
                    found = @as(u32, k)
                    break
                }
            }
            if found == NONE { return null }
            let v = fold_to{ &c, e = items[found].value, t = fields[i].ty }
            if v == null { return null }
            add_val{ xs = &out, v }
            i = i + 1
        }
        if index == NONE { return Val::record{ ty = t, fields = list::items{ list = out } } }
        return Val::variant{ ty = t, index, fields = list::items{ list = out } }
    }

    fn fold_binary { mut c: Checker, e: syntax::Expr, op: tok::Kind, a: syntax::Expr, b: syntax::Expr, t: Id } -> ?Val {
        let at = expr_at{ e }
        if op == tok::Kind::kw_and or op == tok::Kind::kw_or {
            // As at run time, the right side counts only if the left doesn't decide.
            let x = fold{ &c, e = a }
            if x == null { return null }
            let l = bool_of{ v = x }
            if l == (op == tok::Kind::kw_or) { return Val::boolean{ ty = t, value = l } }
            let y = fold{ &c, e = b }
            if y == null { return null }
            return Val::boolean{ ty = t, value = bool_of{ v = y } }
        }
        let an = is_null{ e = a }
        if (op == tok::Kind::eq or op == tok::Kind::ne) and (an or is_null{ e = b }) {
            let x = fold{ &c, e = if an { b } else { a } }
            if x == null { return null }
            let null_now = x is nil
            return Val::boolean{ ty = t, value = null_now == (op == tok::Kind::eq) }
        }
        let x = fold{ &c, e = a }
        if x == null { return null }
        let y = fold{ &c, e = b }
        if y == null { return null }
        if op == tok::Kind::eq or op == tok::Kind::ne or op == tok::Kind::lt or op == tok::Kind::le or op == tok::Kind::gt or op == tok::Kind::ge {
            return Val::boolean{ ty = t, value = compare{ op, x, y } }
        }
        if is_float_type{ c, t } {
            let p = float_of{ v = x }
            let q = float_of{ v = y }
            let r = if op == tok::Kind::plus { p + q } else if op == tok::Kind::minus { p - q } else if op == tok::Kind::star { p * q } else if op == tok::Kind::slash { p / q } else { p % q }
            return Val::float{ ty = t, value = if is_f32{ t } { f32r{ x = r } } else { r } }
        }
        let p = num_of{ v = x }
        let q = num_of{ v = y }
        let prim = types::prim_of{ s = c.ty, t }
        if prim == null { return null }
        if op == tok::Kind::amp or op == tok::Kind::pipe or op == tok::Kind::caret {
            let u = bits_of{ n = p }
            let v = bits_of{ n = q }
            let r = if op == tok::Kind::amp { u & v } else if op == tok::Kind::pipe { u | v } else { u ^ v }
            return int_val{ ty = t, n = from_bits{ x = r, signed = types::signed{ p = prim } } }
        }
        if op == tok::Kind::shl or op == tok::Kind::shr {
            let w = @as(u64, types::bits{ p = prim })
            if q.negative or q.magnitude >= w {
                error{ &c, at, msg = "shift count out of range in constant" }
                return null
            }
            let n = @as(u32, q.magnitude)
            if op == tok::Kind::shr {
                if types::signed{ p = prim } {
                    let s = @trunc(i64, bits_of{ n = p }) >> n
                    return int_val{ ty = t, n = from_bits{ x = @trunc(u64, s), signed = true } }
                }
                return int_val{ ty = t, n = Num{ negative = false, magnitude = p.magnitude >> n } }
            }
            let mut r = bits_of{ n = p } << n
            if w < 64 { r = r & ((@as(u64, 1) << @as(u32, w)) - 1) }
            if types::signed{ p = prim } and w < 64 and r >= @as(u64, 1) << @as(u32, w - 1) {
                return int_val{ ty = t, n = Num{ negative = true, magnitude = (@as(u64, 1) << @as(u32, w)) - r } }
            }
            return int_val{ ty = t, n = from_bits{ x = r, signed = types::signed{ p = prim } and w == 64 } }
        }
        if op == tok::Kind::slash or op == tok::Kind::percent {
            if q.magnitude == 0 {
                error{ &c, at, msg = "division by zero in constant" }
                return null
            }
            if op == tok::Kind::percent {
                let m = p.magnitude % q.magnitude
                return int_val{ ty = t, n = Num{ negative = p.negative and m != 0, magnitude = m } }
            }
            let d = p.magnitude / q.magnitude
            return fits_in{ &c, n = Num{ negative = p.negative != q.negative and d != 0, magnitude = d }, t, at }
        }
        let r = if op == tok::Kind::plus { num_add{ a = p, b = q } } else if op == tok::Kind::minus { num_add{ a = p, b = num_neg{ n = q } } } else { num_mul{ a = p, b = q } }
        if r == null {
            error{ &c, at, msg = "integer overflow in constant" }
            return null
        }
        return fits_in{ &c, n = r, t, at }
    }

    fn int_val { ty: Id, n: Num } -> Val {
        return Val::int{ ty, negative = n.negative, magnitude = n.magnitude }
    }

    // n as a value of integer type t, after reporting at `at` that it doesn't fit.
    fn fits_in { mut c: Checker, n: Num, t: Id, at: source::Span } -> ?Val {
        let p = types::prim_of{ s = c.ty, t }
        if p == null or not types::fits{ p, negative = n.negative, magnitude = n.magnitude } {
            error{ &c, at, msg = "integer overflow in constant" }
            return null
        }
        return int_val{ ty = t, n }
    }

    fn num_of { v: Val } -> Num {
        match v {
            int{ negative, magnitude } => { return Num{ negative, magnitude } }
            else => { return Num{ negative = false, magnitude = 0 } }
        }
    }

    fn float_of { v: Val } -> f64 {
        match v {
            float{ value } => { return value }
            else => { return 0.0 }
        }
    }

    fn bool_of { v: Val } -> bool {
        return v is boolean{ value } and value
    }

    fn num_neg { n: Num } -> Num {
        return Num{ negative = not n.negative and n.magnitude != 0, magnitude = n.magnitude }
    }

    // a + b, or null if its magnitude is past a u64's.
    fn num_add { a: Num, b: Num } -> ?Num {
        if a.negative == b.negative {
            let m = @wrap_add(a.magnitude, b.magnitude)
            if m < a.magnitude { return null }
            return Num{ negative = a.negative and m != 0, magnitude = m }
        }
        if a.magnitude >= b.magnitude {
            let m = a.magnitude - b.magnitude
            return Num{ negative = a.negative and m != 0, magnitude = m }
        }
        return Num{ negative = b.negative, magnitude = b.magnitude - a.magnitude }
    }

    fn num_mul { a: Num, b: Num } -> ?Num {
        if a.magnitude != 0 and b.magnitude > 18446744073709551615 / a.magnitude { return null }
        let m = a.magnitude * b.magnitude
        return Num{ negative = a.negative != b.negative and m != 0, magnitude = m }
    }

    fn num_less { a: Num, b: Num } -> bool {
        if a.negative != b.negative { return a.negative }
        if a.negative { return a.magnitude > b.magnitude }
        return a.magnitude < b.magnitude
    }

    // n's two's complement bits, which an integer of any type up to 64 bits has sign-extended.
    fn bits_of { n: Num } -> u64 {
        return if n.negative { @wrap_sub(0, n.magnitude) } else { n.magnitude }
    }

    fn from_bits { x: u64, signed: bool } -> Num {
        if signed and x >= 9223372036854775808 { return Num{ negative = true, magnitude = @wrap_sub(0, x) } }
        return Num{ negative = false, magnitude = x }
    }

    fn compare { op: tok::Kind, x: Val, y: Val } -> bool {
        let mut less = false
        let mut same = false
        match x {
            int => {
                let p = num_of{ v = x }
                let q = num_of{ v = y }
                less = num_less{ a = p, b = q }
                same = p.negative == q.negative and p.magnitude == q.magnitude
            }
            float{ value } => {
                // IEEE: every comparison with a NaN is false, but != is true.
                let q = float_of{ v = y }
                if op == tok::Kind::eq { return value == q }
                if op == tok::Kind::ne { return value != q }
                if op == tok::Kind::lt { return value < q }
                if op == tok::Kind::le { return value <= q }
                if op == tok::Kind::gt { return value > q }
                return value >= q
            }
            boolean{ value } => { same = value == bool_of{ v = y } }
            else => {}
        }
        if op == tok::Kind::eq { return same }
        if op == tok::Kind::ne { return not same }
        if op == tok::Kind::lt { return less }
        if op == tok::Kind::le { return less or same }
        if op == tok::Kind::gt { return not less and not same }
        return not less
    }

    fn is_float_type { c: Checker, t: Id } -> bool {
        return types::is_float{ s = c.ty, t }
    }

    fn is_f32 { t: Id } -> bool {
        return t == types::prim{ p = types::Prim::f32 }
    }

    // x rounded to the nearest f32, as an f32 operation's result is.
    fn f32r { x: f64 } -> f64 {
        return @as(f64, @as(f32, x))
    }

    fn elem_type { c: Checker, t: Id } -> Id {
        match types::get{ s = c.ty, id = t } {
            array{ elem } => { return types::prune{ s = c.ty, t = elem } }
            else => { return types::ERROR }
        }
    }

    // ---- scopes and locals (ctxi's scopes, VarInfo and declare)

    fn new_var { mut c: Checker, name: []u8, ty: Id, kind: VarKind, mutable: bool, at: source::Span } -> u32 {
        let v = @as(u32, c.vars.len)
        let item = Var{
            name, ty, kind, mutable, indirect = false, tracked = false, narrow_of = NONE,
            depth = c.depth, loop_depth = c.loop_depth, at,
            derived = new_derived{ &c, xs = slice::empty(u32){} },
            held = new_held{ &c, xs = slice::empty(Place){} },
        }
        try! list::push{ list = &c.vars, item }
        return v
    }

    fn get_var { c: Checker, v: u32 } -> Var {
        return list::items{ list = c.vars }[v]
    }

    // What narrowed view v is a view of, through any number of narrowings.
    fn root_var { c: Checker, v: u32 } -> u32 {
        let mut x = v
        while get_var{ c, v = x }.narrow_of != NONE { x = get_var{ c, v = x }.narrow_of }
        return x
    }

    fn open { mut c: Checker } {
        add_mark{ &c, n = c.scope.len }
        c.depth = c.depth + 1
    }

    fn close { mut c: Checker } {
        let m = list::pop{ list = &c.marks }
        if m != null { c.scope.len = m }
        c.depth = c.depth - 1
    }

    fn add_mark { mut c: Checker, n: usize } {
        try! list::push{ list = &c.marks, item = n }
    }

    fn add_binding { mut c: Checker, b: Binding } {
        try! list::push{ list = &c.scope, item = b }
    }

    // Puts local var in the innermost scope as `name`, over any earlier one there.
    fn bind_name { mut c: Checker, name: []u8, var: u32 } {
        add_binding{ &c, b = Binding::local{ name, var } }
    }

    // Declares local v in the innermost scope. Only a narrowed view of a local from an outer
    // scope, made by narrowing after an `if`, may already have its name there.
    fn declare_var { mut c: Checker, v: u32 } {
        let x = get_var{ c, v }
        let old = in_scope{ c, name = x.name }
        if old != NONE and x.name.len > 0 {
            let o = get_var{ c, v = old }
            if not (o.kind == VarKind::narrow and get_var{ c, v = root_var{ c, v = old } }.depth < c.depth) {
                errorf{ &c, at = x.at, msg = @fmt("`{}` is already declared in this scope", str{ s = x.name }) }
            }
        }
        let at = list::at{ list = c.vars, i = v }
        at.depth = c.depth
        at.loop_depth = c.loop_depth
        bind_name{ &c, name = x.name, var = v }
    }

    fn declare_all { mut c: Checker, vars: []u32 } {
        let mut i: usize = 0
        while i < vars.len {
            declare_var{ &c, v = vars[i] }
            i = i + 1
        }
    }

    // The local the innermost scope has as `name`, or NONE.
    fn in_scope { c: Checker, name: []u8 } -> u32 {
        let xs = list::items{ list = c.scope }
        let marks = list::items{ list = c.marks }
        let start = if marks.len == 0 { 0 } else { marks[marks.len - 1] }
        let mut i = xs.len
        while i > start {
            i = i - 1
            match xs[i] {
                local{ name = n, var } => { if slice::eq_bytes{ a = n, b = name } { return var } }
                path => {}
            }
        }
        return NONE
    }

    // The local named `name`, innermost scope first, or NONE (ctxi's lookup_local). A scope
    // holds only its latest local of a name. With callable, only one that holds a function
    // counts.
    fn lookup_local { c: Checker, name: []u8, callable: bool } -> u32 {
        let xs = list::items{ list = c.scope }
        let marks = list::items{ list = c.marks }
        let mut s = marks.len
        let mut end = xs.len
        while s > 0 {
            s = s - 1
            let start = marks[s]
            let mut i = end
            while i > start {
                i = i - 1
                let mut found = NONE
                match xs[i] {
                    local{ name = n, var } => { if slice::eq_bytes{ a = n, b = name } { found = var } }
                    path => {}
                }
                if found != NONE {
                    if not callable or is_fn{ c, t = get_var{ c, v = found }.ty } { return found }
                    break
                }
            }
            end = start
        }
        return NONE
    }

    fn is_fn { c: Checker, t: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is func
    }

    // The local a name in an expression refers to, or NONE. In a call or literal, a local that
    // doesn't hold a function gives way to an outer one that does, or else to a function or
    // type of the same name (§10).
    fn local_named { c: Checker, name: []u8, call: bool } -> u32 {
        let v = lookup_local{ c, name, callable = false }
        if v == NONE or not call or is_fn{ c, t = get_var{ c, v }.ty } { return v }
        let alt = lookup_local{ c, name, callable = true }
        if alt != NONE { return alt }
        if lookup_value{ c, ns = c.sc.ns, name } != null or lookup_path{ c, ns = c.sc.ns, name } != null { return NONE }
        return v
    }

    fn put_local { mut c: Checker, key: u64, v: u32 } {
        try! map::put{ m = &c.local_of, key, value = v }
    }

    fn stmt_key { s: syntax::Stmt } -> u64 {
        return key{ file = s.span.file, id = s.id }
    }

    fn name_key { n: syntax::Name } -> u64 {
        return key{ file = n.span.file, id = n.id }
    }

    // Whether t has a zero value (§11, Initialization). depth stops a struct that holds itself.
    fn has_zero { mut c: Checker, t: Id, depth: u32 } -> bool {
        if depth > 64 { return false }
        let x = types::prune{ s = c.ty, t }
        match types::get{ s = c.ty, id = x } {
            error | prim | opt | slice => { return true }
            array{ elem } => { return has_zero{ &c, t = elem, depth = depth + 1 } }
            record => {
                let fs = struct_fields{ &c, t = x }
                let mut i: usize = 0
                while i < fs.len {
                    if not has_zero{ &c, t = fs[i].ty, depth = depth + 1 } { return false }
                    i = i + 1
                }
                return true
            }
            else => { return false }
        }
    }

    // ---- the flow state and definite initialization (§11, Initialization)

    fn save { c: Checker } -> State {
        return State{ defs = c.defs, maybe = c.maybe, dead = c.dead }
    }

    fn restore { mut c: Checker, s: State } {
        c.defs = s.defs
        c.maybe = s.maybe
        c.dead = s.dead
    }

    // Where paths join: a local is assigned if it is on every path that goes on, and maybe
    // assigned if it is on any. If none goes on, neither does the join.
    fn merge { c: Checker, xs: []State } -> State {
        let mut maybe: []u32 = slice::empty(u32){}
        let mut defs: []u32 = slice::empty(u32){}
        let mut live = false
        let mut i: usize = 0
        while i < xs.len {
            maybe = set_union{ c, a = maybe, b = xs[i].maybe }
            if not xs[i].dead {
                defs = if live { set_meet{ c, a = defs, b = xs[i].defs } } else { xs[i].defs }
                live = true
            }
            i = i + 1
        }
        if not live {
            i = 0
            while i < xs.len {
                defs = set_union{ c, a = defs, b = xs[i].defs }
                i = i + 1
            }
        }
        return State{ defs, maybe, dead = not live }
    }

    fn set_add { c: Checker, xs: []u32, n: u32 } -> []u32 {
        if has_id{ xs, n } { return xs }
        let mut out = list::new(u32){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < xs.len {
            push{ xs = &out, n = xs[i] }
            i = i + 1
        }
        push{ xs = &out, n }
        return list::items{ list = out }
    }

    fn set_union { c: Checker, a: []u32, b: []u32 } -> []u32 {
        let mut out = a
        let mut i: usize = 0
        while i < b.len {
            out = set_add{ c, xs = out, n = b[i] }
            i = i + 1
        }
        return out
    }

    fn set_meet { c: Checker, a: []u32, b: []u32 } -> []u32 {
        let mut out = list::new(u32){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < a.len {
            if has_id{ xs = b, n = a[i] } { push{ xs = &out, n = a[i] } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // Reports a flow error, unless the body already has another error: what flow checks find
    // after a type error is mostly noise.
    fn flow_error { mut c: Checker, at: source::Span, msg: utf8::String } {
        if c.diags.errors != c.body_errors + c.flow_errors { return }
        error{ &c, at, msg }
        c.flow_errors = c.diags.errors - c.body_errors
    }

    // A read of local v, which must be assigned by then if it is tracked.
    fn check_read { mut c: Checker, v: u32, at: source::Span } {
        let r = root_var{ c, v }
        let x = get_var{ c, v = r }
        if x.tracked and not has_id{ xs = c.defs, n = r } and not c.dead {
            let mut b = message{ c }
            try! @fmt(&b, "`{}` may be read before it is assigned", str{ s = x.name })
            flow_error{ &c, at, msg = utf8::view{ b } }
        }
    }

    // A tracked local that `since` doesn't have as maybe assigned but `now` does, and that may
    // be assigned only once: declared with `let`, outside loops deeper than max_loop. NONE if
    // there is none.
    fn assigned_since { c: Checker, vars: []u32, since: []u32, max_loop: u32 } -> u32 {
        let now = vars_in_order{ c, xs = vars }
        let mut i: usize = 0
        while i < now.len {
            let x = get_var{ c, v = now[i] }
            if not has_id{ xs = since, n = now[i] } and x.tracked and not x.mutable and x.loop_depth <= max_loop { return now[i] }
            i = i + 1
        }
        return NONE
    }

    // ---- statements (ctxi's s_* methods)

    fn block { mut c: Checker, b: syntax::Block } {
        open{ &c }
        stmts{ &c, xs = b.stmts }
        close{ &c }
    }

    fn stmts { mut c: Checker, xs: []syntax::Stmt } {
        let mut i: usize = 0
        while i < xs.len {
            stmt{ &c, s = xs[i] }
            i = i + 1
        }
    }

    fn stmt { mut c: Checker, s: syntax::Stmt } {
        match s.k {
            error => {}
            local{ mutable, name, ty, init } => { let_stmt{ &c, s, mutable, name, ty, init } }
            let_else{ variant, binders, init, els_variant, els_binders, els } => {
                let_else{ &c, s, variant, binders, init, els_variant, els_binders, els }
            }
            assign{ place, value } => { assign{ &c, place, value, at = s.span } }
            eval{ e } => { eval_stmt{ &c, e } }
            discard{ e } => {
                if typed{ &c, e } == types::VOID { error{ &c, at = expr_at{ e }, msg = "nothing to discard: this returns no value" } }
            }
            cond{ x } => { _ = check_if{ &c, x, at = s.span, exp = types::NO_TYPE, value = false, may_leave = false } }
            loop{ label, c = cond, body } => { while_stmt{ &c, label, cond, body, at = s.span, k = stmt_key{ s } } }
            choose{ x } => { _ = check_match{ &c, x, at = s.span, exp = types::NO_TYPE, value = false, may_leave = false } }
            ret{ value } => { return_stmt{ &c, value, at = s.span } }
            brk{ label } => { jump{ &c, word = "break", label, at = s.span, k = stmt_key{ s } } }
            cont{ label } => { jump{ &c, word = "continue", label, at = s.span, k = stmt_key{ s } } }
            deferred{ body } => {
                // Checked where it is, but it runs later, so the path goes on as before it. A
                // jump in it sees only the loops inside it.
                let s0 = save{ c }
                let base = c.loop_base
                c.loop_base = c.loops.len
                c.defers = c.defers + 1
                block{ &c, b = body }
                c.defers = c.defers - 1
                c.loop_base = base
                let v = assigned_since{ c, vars = c.maybe, since = s0.maybe, max_loop = 4294967295 }
                if v != NONE {
                    let mut b = message{ c }
                    try! @fmt(&b, "cannot assign `{}` in a defer: declare it with `let mut`", str{ s = get_var{ c, v }.name })
                    flow_error{ &c, at = s.span, msg = utf8::view{ b } }
                }
                restore{ &c, s = s0 }
            }
        }
    }

    fn let_stmt { mut c: Checker, s: syntax::Stmt, mutable: bool, name: syntax::Name, ty: ?syntax::TypeExpr, init: ?syntax::Expr } {
        let mut t = types::ERROR
        if ty != null {
            t = rtype{ &c, te = ty, sc = c.sc, allow_bound = true }
            if init != null { expect{ &c, e = init, t } }
        } else if init != null {
            t = value_type{ &c, e = init }
        }
        let v = new_var{ &c, name = name.text, ty = t, kind = VarKind::local, mutable, at = s.span }
        let mut held: []Place = slice::empty(Place){}
        if init == null {
            if not (mutable and has_zero{ &c, t, depth = 0 }) { list::at{ list = c.vars, i = v }.tracked = true }
        } else {
            let ds = derives{ &c, e = init }
            held = held_of{ c, e = init }
            let d = new_derived{ &c, xs = ds }
            let h = new_held{ &c, xs = held }
            let at = list::at{ list = c.vars, i = v }
            at.derived = d
            at.held = h
        }
        declare_var{ &c, v }
        put_local{ &c, key = stmt_key{ s }, v }
        if held.len > 0 { check_bound_scope{ &c, v, places = held, at = s.span } }
    }

    fn assign { mut c: Checker, place: syntax::Expr, value: syntax::Expr, at: source::Span } {
        let mut v = NONE
        if place.k is path{ segs } {
            let s0 = segs[0]
            if segs.len == 1 and s0.targs == null and s0.name.text.len > 0 {
                v = lookup_local{ c, name = s0.name.text, callable = false }
                if v != NONE { use{ &c, n = s0.name, r = Ref::local{ var = v } } }
            }
        }
        if v != NONE {
            let x = get_var{ c, v }
            put_ref{ &c, e = place, r = PathRef::local{ var = v } }
            set_type{ &c, e = place, t = x.ty }
            if not x.mutable and not x.tracked {
                let why: utf8::String = if x.indirect { "bound through a read-only pointer" } else { "read-only" }
                errorf{ &c, at = expr_at{ e = place }, msg = @fmt("cannot assign to `{}`: it is {}", str{ s = x.name }, why) }
            }
            expect{ &c, e = value, t = x.ty }
            check_cap_assign{ &c, t = x.ty, once = x.tracked and not x.mutable, at = expr_at{ e = place } }
            if x.tracked {
                if not x.mutable and has_id{ xs = c.maybe, n = v } and not c.dead {
                    let mut b = message{ c }
                    try! @fmt(&b, "`{}` may be assigned more than once", str{ s = x.name })
                    flow_error{ &c, at, msg = utf8::view{ b } }
                }
                c.defs = set_add{ c, xs = c.defs, n = v }
                c.maybe = set_add{ c, xs = c.maybe, n = v }
            }
            check_store{ &c, root = v, through = false, rhs = value, at }
            if types::get{ s = c.ty, id = types::prune{ s = c.ty, t = x.ty } } is func{ bound } {
                if bound {
                    let held = held_of{ c, e = value }
                    add_held{ &c, v, xs = held }
                    check_bound_scope{ &c, v, places = held, at }
                }
            }
            return
        }
        let lt = expr{ &c, e = place, exp = types::NO_TYPE }
        check_mutable{ &c, e = place }
        expect{ &c, e = value, t = lt }
        check_cap_assign{ &c, t = lt, once = false, at = expr_at{ e = place } }
        let p = place_path{ c, e = place }
        check_store{ &c, root = if p == null { NONE } else { p.root }, through = p == null, rhs = value, at }
    }

    // A statement of an expression alone: a call or a builtin that returns nothing.
    fn eval_stmt { mut c: Checker, e: syntax::Expr } {
        let mut name = str{ s = "this call" }
        let mut t = types::ERROR
        match e.k {
            error => { return }
            braced{ callee } => {
                t = typed{ &c, e }
                let lit = map::get{ m = c.literal, key = expr_key{ e } }
                if lit != null and lit {
                    error{ &c, at = expr_at{ e }, msg = "an expression statement must be a call" }
                    return
                }
                if callee.k is path{ segs } { name = path_text{ c, segs } }
            }
            builtin{ name = n } => {
                t = typed{ &c, e }
                if slice::eq_bytes{ a = n.text, b = "panic" } { c.dead = true }
                let mut b = message{ c }
                try! @fmt(&b, "@{}", str{ s = n.text })
                name = utf8::view{ b }
            }
            trye{ e = x, panics } => {
                // `try f{ ... }`: a call whose error is passed up, or with `try!` panics.
                t = typed{ &c, e }
                let word: utf8::String = if panics { "try!" } else { "try" }
                let mut call = false
                match x.k {
                    braced{ callee } => {
                        let lit = map::get{ m = c.literal, key = expr_key{ e = x.* } }
                        call = lit == null or not lit
                        let mut b = message{ c }
                        match callee.k {
                            path{ segs } => { try! @fmt(&b, "{} {}", word, path_text{ c, segs }) }
                            else => { try! utf8::push{ &b, s = word } }
                        }
                        name = utf8::view{ b }
                    }
                    builtin{ name = n } => {
                        call = slice::eq_bytes{ a = n.text, b = "fmt" }
                        let mut b = message{ c }
                        try! @fmt(&b, "{} @fmt", word)
                        name = utf8::view{ b }
                    }
                    else => {}
                }
                if not call {
                    error{ &c, at = expr_at{ e }, msg = "an expression statement must be a call: `try` one, as in `try f{ ... }`" }
                    return
                }
            }
            matchx{ x } => {
                if not x.is_iferr {
                    error{ &c, at = expr_at{ e }, msg = "an expression statement must be a call" }
                    _ = expr{ &c, e, exp = types::NO_TYPE }
                    return
                }
                t = typed{ &c, e }
                name = "iferr"
            }
            else => {
                error{ &c, at = expr_at{ e }, msg = "an expression statement must be a call" }
                _ = expr{ &c, e, exp = types::NO_TYPE }
                return
            }
        }
        if t != types::VOID and t != types::ERROR {
            errorf{ &c, at = expr_at{ e }, msg = @fmt("the result of `{}` ({}) is unused: use it, or discard it with `_ = ...`", name, tstr{ c, t }) }
        }
    }

    fn return_stmt { mut c: Checker, value: ?syntax::Expr, at: source::Span } {
        if c.defers > 0 { error{ &c, at, msg = "cannot `return` from a defer" } }
        if value == null {
            if c.ret != types::VOID and c.ret != types::ERROR and not void_result{ c, t = c.ret } { error{ &c, at, msg = "`return` needs a value here" } }
        } else if c.ret == types::VOID {
            error{ &c, at, msg = "this function has no return type" }
            _ = expr{ &c, e = value, exp = types::NO_TYPE }
        } else {
            expect{ &c, e = value, t = c.ret }
            let found = derives{ &c, e = value }
            if found.len > 0 {
                let ds = vars_in_order{ c, xs = found }
                let mut b = message{ c }
                try! @fmt(&b, "returned value holds the address of local `{}`", str{ s = get_var{ c, v = ds[0] }.name })
                escape_error{ &c, t = value_ty{ c, k = expr_key{ e = value } }, at, msg = utf8::view{ b } }
            }
        }
        c.dead = true
    }

    // `break` or `continue`, with the loop it leaves.
    fn jump { mut c: Checker, word: utf8::String, label: ?syntax::Name, at: source::Span, k: u64 } {
        let in_defer: utf8::String = if c.defers > 0 { " in this defer" } else { "" }
        if c.loops.len == c.loop_base {
            errorf{ &c, at, msg = @fmt("`{}` outside a loop{}", word, in_defer) }
            c.dead = true
            return
        }
        let mut target = c.loops.len - 1
        if label != null {
            let loops = list::items{ list = c.loops }
            let mut found = false
            let mut i = loops.len
            while i > c.loop_base {
                i = i - 1
                if slice::eq_bytes{ a = loops[i].label, b = label.text } {
                    target = i
                    found = true
                    if i < loops.len - 1 { name_jump{ &c, loop_key = loops[i].key, jump_key = k } }
                    break
                }
            }
            if not found {
                errorf{ &c, at, msg = @fmt("no enclosing loop is labeled `{}`{}", str{ s = label.text }, in_defer) }
                c.dead = true
                return
            }
        }
        let l = list::at{ list = c.loops, i = target }
        let jumps = if slice::eq_bytes{ a = word.bytes, b = "break" } { &l.breaks } else { &l.conts }
        try! list::push{ list = jumps, item = save{ c } }
        c.dead = true
    }

    // A jump from an inner loop to an outer one: the outer one gets an id if it has none.
    fn name_jump { mut c: Checker, loop_key: u64, jump_key: u64 } {
        let known = map::get{ m = c.loop_ids, key = loop_key }
        let mut id: u32 = 0
        if known == null {
            c.label_ids = c.label_ids + 1
            id = c.label_ids
            try! map::put{ m = &c.loop_ids, key = loop_key, value = id }
        } else {
            id = known
        }
        try! map::put{ m = &c.jump_ids, key = jump_key, value = id }
    }

    fn while_stmt { mut c: Checker, label: ?syntax::Name, cond: syntax::Expr, body: syntax::Block, at: source::Span, k: u64 } {
        let mut name: []u8 = ""
        if label != null {
            name = label.text
            let loops = list::items{ list = c.loops }
            let mut i = c.loop_base
            while i < loops.len {
                if name.len > 0 and slice::eq_bytes{ a = loops[i].label, b = name } {
                    errorf{ &c, at = label.span, msg = @fmt("loop label `{}` is already used by an enclosing loop", str{ s = name }) }
                    break
                }
                i = i + 1
            }
        }
        expect{ &c, e = cond, t = types::BOOL }
        let s0 = save{ c }
        let f = facts{ c, e = cond }
        let lp = Loop{
            label = name,
            key = k,
            breaks = list::new(State){ realloc = arena::alloc, heap = c.heap },
            conts = list::new(State){ realloc = arena::alloc, heap = c.heap },
        }
        try! list::push{ list = &c.loops, item = lp }
        c.loop_depth = c.loop_depth + 1
        open{ &c }
        assume{ &c, facts = f.yes, after_if = false }
        stmts{ &c, xs = body.stmts }
        close{ &c }
        c.loop_depth = c.loop_depth - 1
        let popped = list::pop{ list = &c.loops }
        let l = if popped == null { lp } else { popped }
        let breaks = list::items{ list = l.breaks }
        let conts = list::items{ list = l.conts }
        // A `let x: T` from outside the loop must not be assigned on a path that can repeat it:
        // the end of the body, or a `continue`.
        let mut i: usize = 0
        while i <= conts.len {
            let back = if i == 0 { save{ c } } else { conts[i - 1] }
            if not back.dead {
                let v = assigned_since{ c, vars = back.maybe, since = s0.maybe, max_loop = c.loop_depth }
                if v != NONE {
                    let mut b = message{ c }
                    try! @fmt(&b, "`{}` may be assigned more than once: it is assigned in a loop that can repeat; declare it with `let mut`", str{ s = get_var{ c, v }.name })
                    flow_error{ &c, at, msg = utf8::view{ b } }
                    break
                }
            }
            i = i + 1
        }
        let mut maybe = set_union{ c, a = s0.maybe, b = c.maybe }
        i = 0
        while i < breaks.len {
            maybe = set_union{ c, a = maybe, b = breaks[i].maybe }
            i = i + 1
        }
        i = 0
        while i < conts.len {
            maybe = set_union{ c, a = maybe, b = conts[i].maybe }
            i = i + 1
        }
        let mut forever = false
        if cond.k is boolean{ value } { forever = value }
        if forever {
            // `while true` leaves only through a break; without one it ends the path.
            let after = if breaks.len > 0 { merge{ c, xs = breaks } } else { State{ defs = s0.defs, maybe = slice::empty(u32){}, dead = true } }
            restore{ &c, s = State{ defs = after.defs, maybe, dead = s0.dead or after.dead } }
        } else {
            restore{ &c, s = State{ defs = s0.defs, maybe, dead = s0.dead } }
        }
    }

    // ---- `if` and `match`, as statements and as expressions

    // An `if`. As an expression (value), its type, or NO_TYPE if every branch leaves and that
    // is allowed (may_leave, for one that is the value of an enclosing branch).
    fn check_if { mut c: Checker, x: syntax::If, at: source::Span, exp: Id, value: bool, may_leave: bool } -> Id {
        let cond = x.c.*
        expect{ &c, e = cond, t = types::BOOL }
        let f = facts{ c, e = cond }
        let s0 = save{ c }
        let none = slice::empty(u32){}
        let mut bs = list::new(Branch){ realloc = arena::alloc, heap = c.heap }
        add_branch{ xs = &bs, b = branch{ &c, b = x.then, vars = none, facts = f.yes, exp, value } }
        let s1 = save{ c }
        restore{ &c, s = s0 }
        let els = x.els
        if els != null { add_branch{ xs = &bs, b = branch{ &c, b = els, vars = none, facts = f.no, exp, value } } }
        let s2 = save{ c }
        restore{ &c, s = merge{ c, xs = two_states{ c, a = s1, b = s2 } } }
        if value { return join{ &c, at, bs = list::items{ list = bs }, exp, may_leave } }
        if not s0.dead {
            // If one branch always leaves, what the other assumes holds to the end of the block.
            if s1.dead { assume{ &c, facts = f.no, after_if = true } }
            if els != null and s2.dead { assume{ &c, facts = f.yes, after_if = true } }
        }
        return types::NO_TYPE
    }

    fn two_states { c: Checker, a: State, b: State } -> []State {
        let mut xs = list::new(State){ realloc = arena::alloc, heap = c.heap }
        add_state{ &xs, s = a }
        add_state{ &xs, s = b }
        return list::items{ list = xs }
    }

    fn add_state { mut xs: list::List(State, Heap), s: State } {
        try! list::push{ list = &xs, item = s }
    }

    fn add_branch { mut xs: list::List(Branch, Heap), b: Branch } {
        try! list::push{ list = &xs, item = b }
    }

    // A block of an `if` or `match`, which starts with vars declared or facts assumed.
    fn branch { mut c: Checker, b: syntax::Block, vars: []u32, facts: []Fact, exp: Id, value: bool } -> Branch {
        if value { return value_block{ &c, b, vars, facts, exp } }
        open{ &c }
        declare_all{ &c, vars }
        assume{ &c, facts, after_if = false }
        stmts{ &c, xs = b.stmts }
        close{ &c }
        return Branch{ t = types::NO_TYPE, value = Value::none }
    }

    // A branch of an `if` or `match` expression: its last statement gives its value. A trailing
    // `if` with an `else`, or `match`, is itself the value, unless every one of its branches
    // leaves. Its type is NO_TYPE if the branch never finishes.
    fn value_block { mut c: Checker, b: syntax::Block, vars: []u32, facts: []Fact, exp: Id } -> Branch {
        let entry = c.dead
        open{ &c }
        declare_all{ &c, vars }
        assume{ &c, facts, after_if = false }
        let xs = b.stmts
        let v = if xs.len == 0 { Value::none } else { branch_value{ s = xs[xs.len - 1] } }
        let has = not (v is none)
        stmts{ &c, xs = if has { xs[..xs.len - 1] } else { xs } }
        let mut t = types::NO_TYPE
        match v {
            nested{ s } => {
                t = nested_value{ &c, s, exp }
                if t != types::NO_TYPE { put_type{ &c, k = stmt_key{ s }, t } }
            }
            expr{ e } => {
                t = expr{ &c, e, exp }
                if t == types::VOID {
                    error{ &c, at = expr_at{ e }, msg = "this branch has no value: its last expression returns nothing" }
                    t = types::ERROR
                }
            }
            none => {}
        }
        if has and t != types::NO_TYPE {
            branch_escape{ &c, v }
        } else if not c.dead {
            error{ &c, at = b.span, msg = "this branch must end in a value, or leave with `return`, `break`, `continue` or `@panic()`" }
        }
        close{ &c }
        if c.dead and not entry { t = types::NO_TYPE }
        return Branch{ t, value = v }
    }

    // A branch's value must not hold the address of a local of the branch, or a bound function
    // holding one (§11, If and match expressions, rule 8).
    fn branch_escape { mut c: Checker, v: Value } {
        let at = match v { expr{ e } => { expr_at{ e } } nested{ s } => { s.span } none => { nowhere{} } }
        let t = match v { expr{ e } => { value_ty{ c, k = expr_key{ e } } } nested{ s } => { value_ty{ c, k = stmt_key{ s } } } none => { types::NO_TYPE } }
        let found = derives_value{ &c, v }
        let ds = vars_in_order{ c, xs = found }
        let mut i: usize = 0
        while i < ds.len {
            let l = get_var{ c, v = ds[i] }
            if l.depth == c.depth {
                let mut b = message{ c }
                try! @fmt(&b, "the value of this branch holds the address of local `{}`, which ends with the branch", str{ s = l.name })
                escape_error{ &c, t, at, msg = utf8::view{ b } }
                return
            }
            i = i + 1
        }
        let hs = places_in_order{ c, xs = held_value{ c, v } }
        i = 0
        while i < hs.len {
            let r = get_var{ c, v = hs[i].root }
            if r.depth == c.depth {
                let mut b = message{ c }
                try! @fmt(&b, "the value of this branch holds `{}`, which ends with the branch", str{ s = r.name })
                flow_error{ &c, at, msg = utf8::view{ b } }
                return
            }
            i = i + 1
        }
    }

    // What gives a branch its value, if s is its last statement.
    fn branch_value { s: syntax::Stmt } -> Value {
        match s.k {
            choose => { return Value::nested{ s } }
            cond{ x } => { if x.els != null { return Value::nested{ s } } }
            eval{ e } => {
                if e.k is builtin{ name } and slice::eq_bytes{ a = name.text, b = "panic" } { return Value::none }
                return Value::expr{ e }
            }
            else => {}
        }
        return Value::none
    }

    fn nested_value { mut c: Checker, s: syntax::Stmt, exp: Id } -> Id {
        match s.k {
            cond{ x } => { return check_if{ &c, x, at = s.span, exp, value = true, may_leave = true } }
            choose{ x } => { return check_match{ &c, x, at = s.span, exp, value = true, may_leave = true } }
            else => { return types::NO_TYPE }
        }
    }

    fn put_type { mut c: Checker, k: u64, t: Id } {
        try! map::put{ m = &c.expr_ty, key = k, value = t }
    }

    // The type of an `if` or `match` expression, from its branches: with an expected type that
    // every branch converts to, that type. Otherwise the first branch type that every other
    // converts to (widening, `null` and T to ?T). Each branch's value is converted to it.
    fn join { mut c: Checker, at: source::Span, bs: []mut Branch, exp: Id, may_leave: bool } -> Id {
        let mut live: usize = 0
        let mut first = NONE
        let mut i: usize = 0
        while i < bs.len {
            if bs[i].t != types::NO_TYPE {
                if first == NONE { first = @as(u32, i) }
                live = live + 1
            }
            i = i + 1
        }
        if live == 0 {
            if may_leave { return types::NO_TYPE }
            error{ &c, at, msg = "no branch of this expression produces a value; use a statement instead" }
            return types::ERROR
        }
        view_literals{ &c, bs }
        let mut target = types::NO_TYPE
        if exp != types::NO_TYPE and all_convert{ &c, bs, t = exp } {
            target = exp
        } else {
            let mut has_null = false
            i = 0
            while i < bs.len {
                if bs[i].t != types::NO_TYPE and types::prune{ s = c.ty, t = bs[i].t } == types::NULL { has_null = true }
                i = i + 1
            }
            i = 0
            while i < bs.len and target == types::NO_TYPE {
                if bs[i].t != types::NO_TYPE {
                    let mut cand = types::prune{ s = c.ty, t = bs[i].t }
                    if cand != types::NULL {
                        if has_null and not is_opt{ c, t = cand } { cand = types::opt{ s = &c.ty, elem = cand } }
                        if all_convert{ &c, bs, t = cand } { target = cand }
                    }
                }
                i = i + 1
            }
            if target == types::NO_TYPE {
                let mut all_null = true
                i = 0
                while i < bs.len {
                    if bs[i].t != types::NO_TYPE and types::prune{ s = c.ty, t = bs[i].t } != types::NULL { all_null = false }
                    i = i + 1
                }
                if all_null { return types::NULL }
                let a = bs[first].t
                let mut other = types::NO_TYPE
                i = @as(usize, first) + 1
                while i < bs.len {
                    if bs[i].t != types::NO_TYPE {
                        let ok = coerce{ &c, a = bs[i].t, e = a }
                        if ok is fail { other = bs[i].t }
                        if other != types::NO_TYPE { break }
                    }
                    i = i + 1
                }
                if other == types::NO_TYPE { other = a }
                errorf{ &c, at, msg = @fmt("branches have different types: {} and {}", tstr{ c, t = a }, tstr{ c, t = other }) }
                return types::ERROR
            }
        }
        i = 0
        while i < bs.len {
            let br = bs[i]
            if br.t != types::NO_TYPE {
                match br.value {
                    expr{ e } => { coerce_node{ &c, e, at = br.t, t = target } }
                    nested{ s } => { coerce_key{ &c, k = stmt_key{ s }, pos = s.span, a = br.t, t = target } }
                    none => {}
                }
            }
            i = i + 1
        }
        return target
    }

    // Whether every branch with a value converts to t, trying them in order.
    fn all_convert { mut c: Checker, bs: []mut Branch, t: Id } -> bool {
        let mut i: usize = 0
        while i < bs.len {
            if bs[i].t != types::NO_TYPE and coerce{ &c, a = bs[i].t, e = t } is fail { return false }
            i = i + 1
        }
        return true
    }

    fn is_opt { c: Checker, t: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is opt
    }

    // Branches that are bare string literals, retyped when another branch is of a type a
    // literal can be, a strlit, a []u8 or one with a conversion (PLAN.md 4.4):
    // `match p { a => { name } b => { "text" } }` gives a utf8::String when `name` is one.
    fn view_literals { mut c: Checker, bs: []mut Branch } {
        let mut hint = types::NO_TYPE
        let mut i: usize = 0
        while i < bs.len and hint == types::NO_TYPE {
            let br = bs[i]
            if br.t != types::NO_TYPE {
                let lit = literal_kind{ c, v = br.value }
                if lit == 2 {
                    hint = br.t
                } else if lit == 0 {
                    let mut u = types::prune{ s = c.ty, t = br.t }
                    if conversion{ c, t = u, ns = c.sc.ns } != null { hint = br.t }
                    if types::get{ s = c.ty, id = u } is opt{ elem } { u = types::prune{ s = c.ty, t = elem } }
                    match types::get{ s = c.ty, id = u } {
                        strlit => { hint = br.t }
                        slice{ elem } => { if types::prune{ s = c.ty, t = elem } == types::U8 { hint = br.t } }
                        else => {}
                    }
                    if conversion{ c, t = u, ns = c.sc.ns } != null { hint = br.t }
                }
            }
            i = i + 1
        }
        if hint == types::NO_TYPE { return }
        i = 0
        while i < bs.len {
            let br = bs[i]
            if br.t != types::NO_TYPE and literal_kind{ c, v = br.value } == 1 and br.value is expr{ e } { bs[i].t = expr{ &c, e, exp = hint } }
            i = i + 1
        }
    }

    // 1 if a branch's value is a string literal that became an array, 2 if one that became a
    // view, 0 if it isn't one.
    fn literal_kind { c: Checker, v: Value } -> u32 {
        if v is expr{ e } {
            if e.k is str {
                match types::get{ s = c.ty, id = types::prune{ s = c.ty, t = type_of_expr{ c, e } } } {
                    array => { return 1 }
                    else => { return 2 }
                }
            }
        }
        return 0
    }

    // A `match` (§8, Match), through a pointer if the scrutinee is one. As an expression (value),
    // its type as for check_if.
    fn check_match { mut c: Checker, x: syntax::Match, at: source::Span, exp: Id, value: bool, may_leave: bool } -> Id {
        let scrut = x.scrut.*
        let st = typed{ &c, e = scrut }
        let mut ut = st
        let mut through = false
        let mut ptr_mut = false
        if types::get{ s = c.ty, id = st } is ptr{ elem, mutable } {
            through = true
            ptr_mut = mutable
            ut = types::prune{ s = c.ty, t = elem }
        }
        let mut ok = st != types::ERROR and ut != types::ERROR
        if ok and x.is_ifnull and not is_opt{ c, t = st } {
            errorf{ &c, at = expr_at{ e = scrut }, msg = @fmt("`ifnull` needs an optional value, got {}", tstr{ c, t = st }) }
            ok = false
        } else if ok and x.is_iferr and not is_res{ c, t = st } {
            errorf{ &c, at = expr_at{ e = scrut }, msg = @fmt("`iferr` needs a `!T` value, got {}", tstr{ c, t = st }) }
            ok = false
        } else if ok and (is_res{ c, t = ut } or is_errs{ c, t = ut }) {
            if not through { return check_fail_match{ &c, x, at, exp, value, may_leave, t = ut } }
            error{ &c, at = expr_at{ e = scrut }, msg = "match cannot go through a pointer to a `!T` or an error; match on the value with `.*`" }
            ok = false
        } else if ok and through and is_enum{ c, t = ut } {
            error{ &c, at = expr_at{ e = scrut }, msg = "match cannot go through a pointer to an enum; match on the value with `.*`" }
            ok = false
        } else if ok and untagged_type{ c, t = ut } {
            error{ &c, at = expr_at{ e = scrut }, msg = "an extern union has no tag to match on: read the field you know it holds" }
            ok = false
        } else if ok and not has_variants{ c, t = ut } {
            errorf{ &c, at = expr_at{ e = scrut }, msg = @fmt("match needs a union, enum or optional value, got {}", tstr{ c, t = st }) }
            ok = false
        }
        let vs: []Variant = if ok { variants_of{ &c, t = ut } } else { slice::empty(Variant){} }
        // With `match &p`, nothing in the arms may reach p but their bindings.
        let forb: ?Place = match scrut.k { addr{ e = inner } => { place_path{ c, e = inner.* } } else => { null } }
        let scrut_derived = new_derived{ &c, xs = if through { no_vars{} } else { derives{ &c, e = scrut } } }
        let s0 = save{ c }
        let mut seen = list::new(u32){ realloc = arena::alloc, heap = c.heap }
        let mut has_else = false
        let mut results = list::new(State){ realloc = arena::alloc, heap = c.heap }
        let mut bs = list::new(Branch){ realloc = arena::alloc, heap = c.heap }
        let arms = x.arms
        let mut i: usize = 0
        while i < arms.len {
            let arm = arms[i]
            let mut first: []u32 = slice::empty(u32){}
            let mut first_name: []u8 = ""
            if arm.pats.len == 0 {
                if i != arms.len - 1 {
                    error{ &c, at = arm.span, msg = "`else` must be the last arm" }
                } else if ok and seen.len == vs.len {
                    error{ &c, at = arm.span, msg = "`else` is unreachable: every variant is already listed" }
                }
                has_else = true
            }
            let mut k: usize = 0
            while k < arm.pats.len {
                let p = arm.pats[k]
                let vi = variant_index{ vs, name = p.variant.text }
                let mut known = ok
                if ok and vi == NONE {
                    if p.variant.text.len > 0 {
                        errorf{ &c, at = p.span, msg = @fmt("{} has no variant `{}`", tstr{ c, t = ut }, str{ s = p.variant.text }) }
                    }
                    known = false
                } else if ok and has_id{ xs = list::items{ list = seen }, n = vi } {
                    errorf{ &c, at = p.span, msg = @fmt("variant `{}` appears in more than one arm", str{ s = p.variant.text }) }
                } else if ok {
                    push{ xs = &seen, n = vi }
                }
                let fields: ?[]types::Field = if known { vs[vi].fields } else { null }
                let bv = pattern_vars{ &c, variant = p.variant.text, known, fields, binders = p.binders, through, ptr_mut, derived = scrut_derived, at = p.span }
                if k == 0 {
                    first = bv
                    first_name = p.variant.text
                } else {
                    same_binds{ &c, first_name, first, variant = p.variant.text, mine = bv, binders = p.binders, at = p.span, within = "arm" }
                }
                k = k + 1
            }
            restore{ &c, s = s0 }
            add_branch{ xs = &bs, b = branch{ &c, b = arm.body, vars = first, facts = slice::empty(Fact){}, exp, value } }
            add_state{ xs = &results, s = save{ c } }
            if forb != null { scan_stmts{ &c, sc = Scan{ forb, via = binding_names{ c, vars = first } }, xs = arm.body.stmts } }
            i = i + 1
        }
        if ok and not has_else and seen.len < vs.len {
            let mut b = message{ c }
            try! utf8::push{ &b, s = "match isn't exhaustive: missing " }
            let mut n: usize = 0
            let mut j: usize = 0
            while j < vs.len {
                if not has_id{ xs = list::items{ list = seen }, n = @as(u32, j) } {
                    if n > 0 { try! utf8::push{ &b, s = ", " } }
                    try! utf8::push{ &b, s = str{ s = vs[j].name } }
                    n = n + 1
                }
                j = j + 1
            }
            error{ &c, at, msg = utf8::view{ b } }
        }
        restore{ &c, s = merge{ c, xs = list::items{ list = results } } }
        if value { return join{ &c, at, bs = list::items{ list = bs }, exp, may_leave } }
        return types::NO_TYPE
    }

    // "`a`, `b`", or "the arm bindings" if there are none.
    fn binding_names { c: Checker, vars: []u32 } -> utf8::String {
        if vars.len == 0 { return "the arm bindings" }
        let mut b = message{ c }
        let mut i: usize = 0
        while i < vars.len {
            if i > 0 { try! utf8::push{ &b, s = ", " } }
            try! @fmt(&b, "`{}`", str{ s = get_var{ c, v = vars[i] }.name })
            i = i + 1
        }
        return utf8::view{ b }
    }

    fn has_variants { c: Checker, t: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is sum | opt | enumeration
    }

    fn variant_index { vs: []Variant, name: []u8 } -> u32 {
        let mut i: usize = 0
        while i < vs.len {
            if slice::eq_bytes{ a = vs[i].name, b = name } { return @as(u32, i) }
            i = i + 1
        }
        return NONE
    }

    fn has_id { xs: []u32, n: u32 } -> bool {
        let mut i: usize = 0
        while i < xs.len {
            if xs[i] == n { return true }
            i = i + 1
        }
        return false
    }

    // The locals a pattern for a variant binds. fields are the variant's payload, if it is
    // known. Through a pointer scrutinee, `&f` binds the field as a place, mutable through a
    // `*mut`.
    fn pattern_vars { mut c: Checker, variant: []u8, known: bool, fields: ?[]types::Field, binders: []syntax::Binder, through: bool, ptr_mut: bool, derived: u32, at: source::Span } -> []u32 {
        let mut out = list::new(u32){ realloc = arena::alloc, heap = c.heap }
        if known and binders.len > 0 and fields == null {
            errorf{ &c, at, msg = @fmt("variant `{}` has no payload", str{ s = variant }) }
        }
        let mut i: usize = 0
        while i < binders.len {
            let bd = binders[i]
            let field = bd.field.text
            let mut ft = types::ERROR
            if known and fields != null {
                let f = types::find_field{ fields, name = field }
                if f == null {
                    if field.len > 0 {
                        errorf{ &c, at = bd.span, msg = @fmt("variant `{}` has no field `{}`", str{ s = variant }, str{ s = field }) }
                    }
                } else {
                    ft = f.ty
                    if bound_before{ binders, i } {
                        errorf{ &c, at = bd.span, msg = @fmt("`{}` is bound twice", str{ s = field }) }
                    }
                }
            }
            if known and bd.by_ref and not through {
                errorf{ &c, at = bd.span, msg = @fmt("`&{}` needs a pointer scrutinee", str{ s = field }) }
            }
            let local = bd.local
            let name = if local == null { field } else { local.text }
            let v = new_var{ &c, name, ty = ft, kind = VarKind::bind, mutable = bd.by_ref and ptr_mut, at = bd.span }
            let at_v = list::at{ list = c.vars, i = v }
            at_v.indirect = bd.by_ref
            at_v.derived = derived
            put_local{ &c, key = name_key{ n = bd.field }, v }
            push{ xs = &out, n = v }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // Whether binders[i]'s field is bound earlier in the pattern.
    fn bound_before { binders: []syntax::Binder, i: usize } -> bool {
        let mut k: usize = 0
        while k < i {
            if slice::eq_bytes{ a = binders[k].field.text, b = binders[i].field.text } { return true }
            k = k + 1
        }
        return false
    }

    // A later pattern of an arm, or of an `is` (within names which), must bind what its first
    // pattern does, each name with the same type and bound the same way. Each of its names then
    // refers to the first pattern's local.
    fn same_binds { mut c: Checker, first_name: []u8, first: []u32, variant: []u8, mine: []u32, binders: []syntax::Binder, at: source::Span, within: []u8 } {
        let mut used = list::new(bool){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < mine.len {
            try! list::push{ list = &used, item = false }
            i = i + 1
        }
        let flags = list::items{ list = used }
        i = 0
        while i < first.len {
            let fv = get_var{ c, v = first[i] }
            let mut j = mine.len
            let mut found = NONE
            while j > 0 {
                j = j - 1
                if not flags[j] and slice::eq_bytes{ a = get_var{ c, v = mine[j] }.name, b = fv.name } {
                    found = @as(u32, j)
                    break
                }
            }
            if found == NONE {
                errorf{ &c, at, msg = @fmt("`{}` must bind `{}`, as `{}` in the same {} does", str{ s = variant }, str{ s = fv.name }, str{ s = first_name }, str{ s = within }) }
            } else {
                let mut k: usize = 0
                while k < mine.len {
                    if slice::eq_bytes{ a = get_var{ c, v = mine[k] }.name, b = fv.name } { flags[k] = true }
                    k = k + 1
                }
                let v = get_var{ c, v = mine[found] }
                if not types::unify{ s = &c.ty, a = v.ty, b = fv.ty } {
                    errorf{ &c, at = v.at, msg = @fmt("`{}` is {} in `{}` but {} in `{}`", str{ s = fv.name }, tstr{ c, t = fv.ty }, str{ s = first_name }, tstr{ c, t = v.ty }, str{ s = variant }) }
                } else if v.indirect != fv.indirect {
                    errorf{ &c, at = v.at, msg = @fmt("`{}` must be bound with `&` in both `{}` and `{}`, or in neither", str{ s = fv.name }, str{ s = first_name }, str{ s = variant }) }
                }
                put_local{ &c, key = name_key{ n = binders[found].field }, v = first[i] }
            }
            i = i + 1
        }
        i = 0
        while i < mine.len {
            if not flags[i] {
                let v = get_var{ c, v = mine[i] }
                errorf{ &c, at = v.at, msg = @fmt("`{}` binds `{}`, which `{}` in the same {} does not", str{ s = variant }, str{ s = v.name }, str{ s = first_name }, str{ s = within }) }
                return
            }
            i = i + 1
        }
    }

    // `let variant{ ... } = e else { ... }`: the bindings live on in the enclosing block, and
    // the else block, which runs for every other variant, must leave (§11, Let-else).
    fn let_else { mut c: Checker, s: syntax::Stmt, variant: syntax::Name, binders: []syntax::Binder, init: syntax::Expr, els_variant: ?syntax::Name, els_binders: []syntax::Binder, els: syntax::Block } {
        let vt = value_type{ &c, e = init }
        let t = types::prune{ s = c.ty, t = vt }
        let mut ok = t != types::ERROR
        match types::get{ s = c.ty, id = t } {
            ptr => {
                error{ &c, at = expr_at{ e = init }, msg = "a `let` pattern cannot match through a pointer; use `match`" }
                ok = false
            }
            sum | opt | res => {}
            else => {
                if ok and untagged_type{ c, t } {
                    error{ &c, at = expr_at{ e = init }, msg = "an extern union has no tag to match on: read the field you know it holds" }
                    ok = false
                } else if ok {
                    errorf{ &c, at = expr_at{ e = init }, msg = @fmt("a `let` pattern needs a union or optional value, got {}", tstr{ c, t }) }
                    ok = false
                }
            }
        }
        let mut vs: []Variant = if ok { variants_of{ &c, t } } else { slice::empty(Variant){} }
        let mut vi = variant_index{ vs, name = variant.text }
        // On a `?U` for a union U, a variant of U: null goes to the else block with U's others.
        let mut deep = false
        if ok and vi == NONE {
            if types::get{ s = c.ty, id = t } is opt{ elem } {
                let u = types::prune{ s = c.ty, t = elem }
                if types::get{ s = c.ty, id = u } is sum {
                    let uvs = variants_of{ &c, t = u }
                    let ui = variant_index{ vs = uvs, name = variant.text }
                    if ui != NONE {
                        vs = uvs
                        vi = ui
                        deep = true
                    }
                }
            }
        }
        let mut known = ok
        if ok and vi == NONE {
            if variant.text.len > 0 {
                errorf{ &c, at = s.span, msg = @fmt("{} has no variant `{}`", tstr{ c, t }, str{ s = variant.text }) }
            }
            known = false
        }
        let fields: ?[]types::Field = if known { vs[vi].fields } else { null }
        let derived = new_derived{ &c, xs = derives{ &c, e = init } }
        let bvars = pattern_vars{ &c, variant = variant.text, known, fields, binders, through = false, ptr_mut = false, derived, at = s.span }
        let mut evars: []u32 = slice::empty(u32){}
        if els_variant != null {
            let ev = els_variant.text
            let evi = variant_index{ vs, name = ev }
            let mut eknown = known and evi != NONE and not deep
            if known and deep {
                errorf{ &c, at = els.span, msg = @fmt("`else {}` can't follow `{}` of an optional's value: the `else` takes null too", str{ s = ev }, str{ s = variant.text }) }
            } else if known and evi == NONE {
                if ev.len > 0 {
                    errorf{ &c, at = els.span, msg = @fmt("{} has no variant `{}`", tstr{ c, t }, str{ s = ev }) }
                }
            } else if known and slice::eq_bytes{ a = ev, b = variant.text } {
                errorf{ &c, at = els.span, msg = @fmt("variant `{}` appears on both sides of the `else`", str{ s = variant.text }) }
            } else if known and vs.len != 2 {
                let mut b = message{ c }
                try! @fmt(&b, "`else {}` would skip ", str{ s = ev })
                let mut n: usize = 0
                let mut j: usize = 0
                while j < vs.len {
                    if not slice::eq_bytes{ a = vs[j].name, b = variant.text } and not slice::eq_bytes{ a = vs[j].name, b = ev } {
                        if n > 0 { try! utf8::push{ &b, s = ", " } }
                        try! utf8::push{ &b, s = str{ s = vs[j].name } }
                        n = n + 1
                    }
                    j = j + 1
                }
                try! utf8::push{ &b, s = "; a pattern after `else` must name the only other variant" }
                error{ &c, at = els.span, msg = utf8::view{ b } }
            }
            let efields: ?[]types::Field = if eknown { vs[evi].fields } else { null }
            evars = pattern_vars{ &c, variant = ev, known = eknown, fields = efields, binders = els_binders, through = false, ptr_mut = false, derived, at = els.span }
        }
        let s0 = save{ c }
        open{ &c }
        declare_all{ &c, vars = evars }
        stmts{ &c, xs = els.stmts }
        close{ &c }
        if not c.dead {
            error{ &c, at = els.span, msg = "the `else` of a `let` pattern must leave: end it with `return`, `break`, `continue` or `@panic()`" }
        }
        restore{ &c, s = State{ defs = s0.defs, maybe = set_union{ c, a = s0.maybe, b = c.maybe }, dead = s0.dead } }
        declare_all{ &c, vars = bvars }
    }

    // e, `x is P` (§8, Is): whether x holds one of the patterns' variants. On a `?U` for a union or
    // enum U, a pattern other than `null` or `some` names one of U's variants. Every pattern binds
    // what the first does, as in a match arm, and its locals are declared where the test is known
    // true (facts).
    fn check_is { mut c: Checker, e: syntax::Expr, x: syntax::Expr, pats: []syntax::Pattern } -> Id {
        let t = typed{ &c, e = x }
        let mut ok = t != types::ERROR
        match types::get{ s = c.ty, id = t } {
            ptr => {
                error{ &c, at = expr_at{ e = x }, msg = "`is` cannot test through a pointer; use `match`" }
                ok = false
            }
            sum | opt | enumeration => {}
            else => {
                if ok and (is_res{ c, t } or is_errs{ c, t }) {
                    error{ &c, at = expr_at{ e = x }, msg = "`is` cannot test a `!T` or an error; use `match` or `iferr`" }
                } else if ok and untagged_type{ c, t } {
                    error{ &c, at = expr_at{ e = x }, msg = "an extern union has no tag to match on: read the field you know it holds" }
                } else if ok {
                    errorf{ &c, at = expr_at{ e = x }, msg = @fmt("`is` needs a union, enum or optional value, got {}", tstr{ c, t }) }
                }
                ok = false
            }
        }
        let vs: []Variant = if ok { variants_of{ &c, t } } else { slice::empty(Variant){} }
        let mut inner: []Variant = slice::empty(Variant){}
        if ok {
            if types::get{ s = c.ty, id = t } is opt{ elem } {
                let u = types::prune{ s = c.ty, t = elem }
                if types::get{ s = c.ty, id = u } is sum | enumeration { inner = variants_of{ &c, t = u } }
            }
        }
        let derived = new_derived{ &c, xs = derives{ &c, e = x } }
        let mut first: []u32 = slice::empty(u32){}
        let mut i: usize = 0
        while i < pats.len {
            let p = pats[i]
            let name = p.variant.text
            let mut from = vs
            let mut vi = variant_index{ vs, name }
            if vi == NONE and inner.len > 0 {
                from = inner
                vi = variant_index{ vs = inner, name }
            }
            let mut known = ok
            if p.quals.len > 0 {
                errorf{ &c, at = p.span, msg = @fmt("`is` names a variant alone: write `{}`", str{ s = name }) }
                known = false
            } else if ok and vi == NONE {
                if name.len > 0 {
                    errorf{ &c, at = p.span, msg = @fmt("{} has no variant `{}`", tstr{ c, t }, str{ s = name }) }
                }
                known = false
            } else if ok and listed_before{ pats, i } {
                errorf{ &c, at = p.span, msg = @fmt("variant `{}` is listed twice", str{ s = name }) }
            }
            let fields: ?[]types::Field = if known { from[vi].fields } else { null }
            let bv = pattern_vars{ &c, variant = name, known, fields, binders = p.binders, through = false, ptr_mut = false, derived, at = p.span }
            if i == 0 {
                first = bv
                try! map::put{ m = &c.is_vars, key = expr_key{ e }, value = bv }
            } else {
                same_binds{ &c, first_name = pats[0].variant.text, first, variant = name, mine = bv, binders = p.binders, at = p.span, within = "test" }
            }
            i = i + 1
        }
        return types::BOOL
    }

    // Whether pats[i]'s variant is named earlier.
    fn listed_before { pats: []syntax::Pattern, i: usize } -> bool {
        let mut k: usize = 0
        while k < i {
            if slice::eq_bytes{ a = pats[k].variant.text, b = pats[i].variant.text } { return true }
            k = k + 1
        }
        return false
    }

    // ---- narrowing (§8, Optional)

    // What the checked condition e narrows when it is true and when it is false.
    fn facts { c: Checker, e: syntax::Expr } -> Facts {
        let none = slice::empty(Fact){}
        match e.k {
            lnot{ e = x } => {
                let f = facts{ c, e = x.* }
                return Facts{ yes = f.no, no = f.yes }
            }
            binary{ op, a, b } => {
                if op == tok::Kind::kw_and or op == tok::Kind::kw_or {
                    let f1 = facts{ c, e = a.* }
                    let f2 = facts{ c, e = b.* }
                    if op == tok::Kind::kw_and {
                        return Facts{ yes = fact_union{ c, a = f1.yes, b = f2.yes }, no = fact_meet{ c, a = f1.no, b = f2.no } }
                    }
                    return Facts{ yes = fact_meet{ c, a = f1.yes, b = f2.yes }, no = fact_union{ c, a = f1.no, b = f2.no } }
                }
                let an = is_null{ e = a.* }
                if (op == tok::Kind::eq or op == tok::Kind::ne) and an != is_null{ e = b.* } {
                    let f = fact{ c, e = if an { b.* } else { a.* } }
                    if f == null { return Facts{ yes = none, no = none } }
                    let mut one = list::new(Fact){ realloc = arena::alloc, heap = c.heap }
                    add_fact{ xs = &one, f }
                    let xs: []Fact = list::items{ list = one }
                    if op == tok::Kind::ne { return Facts{ yes = xs, no = none } }
                    return Facts{ yes = none, no = xs }
                }
            }
            isx{ e = x, pats } => {
                // x itself narrows as `x != null` would: when true, or when false if a pattern
                // is `null`.
                let mut xs = list::new(Fact){ realloc = arena::alloc, heap = c.heap }
                let mut no: []Fact = none
                let f = fact{ c, e = x.* }
                if f != null {
                    if names_null{ pats } {
                        let mut one = list::new(Fact){ realloc = arena::alloc, heap = c.heap }
                        add_fact{ xs = &one, f }
                        no = list::items{ list = one }
                    } else {
                        add_fact{ xs = &xs, f }
                    }
                }
                let vars = map::get{ m = c.is_vars, key = expr_key{ e } }
                if vars != null {
                    let mut i: usize = 0
                    while i < vars.len {
                        let v = get_var{ c, v = vars[i] }
                        add_fact{ xs = &xs, f = Fact{ var = vars[i], root = NONE, steps = slice::empty([]u8){}, ty = v.ty, at = v.at, bind = true, clash = false } }
                        i = i + 1
                    }
                }
                return Facts{ yes = list::items{ list = xs }, no }
            }
            else => {}
        }
        return Facts{ yes = none, no = none }
    }

    // Whether one of an `is`'s patterns is `null`.
    fn names_null { pats: []syntax::Pattern } -> bool {
        let mut i: usize = 0
        while i < pats.len {
            if slice::eq_bytes{ a = pats[i].variant.text, b = "null" } { return true }
            i = i + 1
        }
        return false
    }

    // The fact that e is not null, if e can be narrowed: a read-only local or context field,
    // or a path of struct fields from one.
    fn fact { c: Checker, e: syntax::Expr } -> ?Fact {
        let t = types::prune{ s = c.ty, t = type_of_expr{ c, e } }
        let mut elem = types::NO_TYPE
        match types::get{ s = c.ty, id = t } { opt{ elem = x } => { elem = x } else => { return null } }
        match e.k {
            path => {
                if map::get{ m = c.refs, key = expr_key{ e } } is local{ var } {
                    if get_var{ c, v = var }.mutable { return null }
                    return Fact{ var, root = NONE, steps = slice::empty([]u8){}, ty = elem, at = expr_at{ e }, bind = false, clash = false }
                }
            }
            field => {
                if access_of{ c, e } is field {
                    let p = place_path{ c, e }
                    if p != null {
                        let root = get_var{ c, v = p.root }
                        if not root.mutable and not root.indirect and all_fields{ steps = p.steps } {
                            return Fact{ var = NONE, root = p.root, steps = p.steps, ty = elem, at = expr_at{ e }, bind = false, clash = false }
                        }
                    }
                }
            }
            else => {}
        }
        return null
    }

    fn add_fact { mut xs: list::List(Fact, Heap), f: Fact } {
        try! list::push{ list = &xs, item = f }
    }

    fn all_fields { steps: [][]u8 } -> bool {
        let mut i: usize = 0
        while i < steps.len {
            if slice::eq_bytes{ a = steps[i], b = "[" } { return false }
            i = i + 1
        }
        return true
    }

    // Facts of a, then those of b whose local or path a doesn't have. A binding whose name both
    // bind clashes, and stays once.
    fn fact_union { c: Checker, a: []Fact, b: []Fact } -> []Fact {
        let mut out = list::new(Fact){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < a.len {
            let mut f = a[i]
            if f.bind and binds_name{ c, xs = b, f } { f.clash = true }
            add_fact{ xs = &out, f }
            i = i + 1
        }
        i = 0
        while i < b.len {
            let f = b[i]
            if f.bind {
                if not binds_name{ c, xs = a, f } { add_fact{ xs = &out, f } }
            } else if not has_fact{ xs = a, f } {
                add_fact{ xs = &out, f }
            }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // Whether xs has a binding of f's name.
    fn binds_name { c: Checker, xs: []Fact, f: Fact } -> bool {
        let name = get_var{ c, v = f.var }.name
        let mut i: usize = 0
        while i < xs.len {
            if xs[i].bind and slice::eq_bytes{ a = get_var{ c, v = xs[i].var }.name, b = name } { return true }
            i = i + 1
        }
        return false
    }

    // Facts of a whose local or path b also has.
    fn fact_meet { c: Checker, a: []Fact, b: []Fact } -> []Fact {
        let mut out = list::new(Fact){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < a.len {
            if has_fact{ xs = b, f = a[i] } { add_fact{ xs = &out, f = a[i] } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn has_fact { xs: []Fact, f: Fact } -> bool {
        let mut i: usize = 0
        while i < xs.len {
            let g = xs[i]
            if f.var != NONE or g.var != NONE {
                if f.var == g.var { return true }
            } else if f.root == g.root and same_steps{ a = f.steps, b = g.steps } {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn same_steps { a: [][]u8, b: [][]u8 } -> bool {
        if a.len != b.len { return false }
        let mut i: usize = 0
        while i < a.len {
            if not slice::eq_bytes{ a = a[i], b = b[i] } { return false }
            i = i + 1
        }
        return true
    }

    // Narrows each fact's local or path in the innermost scope. After an `if`, a local's
    // narrowed view replaces it there, or shadows it if it is from an outer scope. A binding is
    // declared there.
    fn assume { mut c: Checker, facts: []Fact, after_if: bool } {
        let mut i: usize = 0
        while i < facts.len {
            let f = facts[i]
            if f.bind {
                // As a let-else's binding, after an `if` too.
                if not f.clash { declare_var{ &c, v = f.var } }
            } else if f.var == NONE {
                add_binding{ &c, b = Binding::path{ root = f.root, steps = f.steps, ty = f.ty } }
            } else {
                let name = get_var{ c, v = f.var }.name
                let nv = new_var{ &c, name, ty = f.ty, kind = VarKind::narrow, mutable = false, at = f.at }
                let at = list::at{ list = c.vars, i = nv }
                at.narrow_of = f.var
                at.derived = get_var{ c, v = f.var }.derived
                if after_if { bind_name{ &c, name, var = nv } } else { declare_var{ &c, v = nv } }
            }
            i = i + 1
        }
    }

    // A place that doesn't go through a deref (§3.1): its root local, and its steps, a field's
    // name or `[` for an index.
    struct Place { root: u32, steps: [][]u8 }

    fn place_path { c: Checker, e: syntax::Expr } -> ?Place {
        match e.k {
            path => {
                if map::get{ m = c.refs, key = expr_key{ e } } is local{ var } { return Place{ root = root_var{ c, v = var }, steps = slice::empty([]u8){} } }
            }
            field{ base, name } => {
                if access_of{ c, e } is field {
                    let p = place_path{ c, e = base.* }
                    if p != null {
                        // An extern union's fields share their bytes: `|` marks such a step, and
                        // overlap counts any two of them at one depth as the same.
                        let step = if untagged_type{ c, t = type_of_expr{ c, e = base.* } } { union_step{ c, name = name.text } } else { name.text }
                        return Place{ root = p.root, steps = add_step{ c, steps = p.steps, step } }
                    }
                }
            }
            index{ base } => {
                if access_of{ c, e } is arr {
                    let p = place_path{ c, e = base.* }
                    if p != null { return Place{ root = p.root, steps = add_step{ c, steps = p.steps, step = "[" } } }
                }
            }
            else => {}
        }
        return null
    }

    fn union_step { c: Checker, name: []u8 } -> []u8 {
        let mut b = message{ c }
        try! utf8::push{ &b, s = "|" }
        try! utf8::push{ &b, s = str{ s = name } }
        return utf8::view{ b }.bytes
    }

    fn add_step { c: Checker, steps: [][]u8, step: []u8 } -> [][]u8 {
        let mut out = list::new([]u8){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i <= steps.len {
            let s = if i < steps.len { steps[i] } else { step }
            try! list::push{ list = &out, item = s }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // The narrowed type of field path e, or NO_TYPE.
    fn narrowed_path { c: Checker, e: syntax::Expr } -> Id {
        let p = place_path{ c, e }
        if p == null { return types::NO_TYPE }
        let xs = list::items{ list = c.scope }
        let mut i = xs.len
        while i > 0 {
            i = i - 1
            match xs[i] {
                path{ root, steps, ty } => { if root == p.root and same_steps{ a = steps, b = p.steps } { return ty } }
                local => {}
            }
        }
        return types::NO_TYPE
    }

    fn access_of { c: Checker, e: syntax::Expr } -> ?Access {
        return map::get{ m = c.access, key = expr_key{ e } }
    }

    fn put_access { mut c: Checker, e: syntax::Expr, a: Access } {
        try! map::put{ m = &c.access, key = expr_key{ e }, value = a }
    }

    // ---- places (§11, Places)

    // Checks that e is a place, and says whether it is (after reporting it if not).
    fn check_place { mut c: Checker, e: syntax::Expr } -> bool {
        let mut msg = str{ s = "" }
        match e.k {
            error | deref => { return true }
            path{ segs } => {
                let r = map::get{ m = c.refs, key = expr_key{ e } }
                if r == null { return true }       // it didn't resolve, which is reported
                let what: utf8::String = match r { local => { "" } constant => { "a const, not a place" } else => { "not a place" } }
                if what.bytes.len == 0 { return true }
                let mut b = message{ c }
                try! @fmt(&b, "`{}` is {}", path_text{ c, segs }, what)
                msg = utf8::view{ b }
            }
            field{ base, name } => {
                let a = access_of{ c, e }
                if a is field { return check_place{ &c, e = base.* } }
                if a is null | pfield { return true }
                let mut b = message{ c }
                try! @fmt(&b, "`.{}` is not a place", str{ s = name.text })
                msg = utf8::view{ b }
            }
            index{ base } => {
                if access_of{ c, e } is arr { return check_place{ &c, e = base.* } }
                return true
            }
            else => { msg = "expression is not a place" }
        }
        error{ &c, at = expr_at{ e }, msg }
        return false
    }

    fn check_mutable { mut c: Checker, e: syntax::Expr } {
        if not check_place{ &c, e } { return }
        match e.k {
            error => { return }
            path => {
                let r = map::get{ m = c.refs, key = expr_key{ e } }
                if r == null { return }
                if r is local{ var } {
                    let v = get_var{ c, v = var }
                    if not v.mutable {
                        let why: utf8::String = if v.indirect { ": it is bound through a read-only pointer" } else { "" }
                        errorf{ &c, at = expr_at{ e }, msg = @fmt("`{}` is not a mutable place{}", str{ s = v.name }, why) }
                    }
                }
                return
            }
            field{ base } => {
                if access_of{ c, e } is field {
                    check_mutable{ &c, e = base.* }
                    return
                }
            }
            index{ base } => {
                if access_of{ c, e } is arr {
                    check_mutable{ &c, e = base.* }
                    return
                }
            }
            else => {}
        }
        if not place_mutable{ c, e } {
            let pt = pointer_of{ c, e }
            let want: utf8::String = match types::get{ s = c.ty, id = pt } { slice => { "[]mut" } else => { "*mut" } }
            errorf{ &c, at = expr_at{ e }, msg = @fmt("cannot write through {}; it needs to be a `{}`", tstr{ c, t = pt }, want) }
        }
    }

    // Whether place e is mutable (§11, Places): through a deref, only through a `*mut` or a
    // `[]mut`.
    fn place_mutable { c: Checker, e: syntax::Expr } -> bool {
        match e.k {
            path => {
                if map::get{ m = c.refs, key = expr_key{ e } } is local{ var } { return get_var{ c, v = var }.mutable }
                return true
            }
            field{ base } => { if access_of{ c, e } is field { return place_mutable{ c, e = base.* } } }
            index{ base } => { if access_of{ c, e } is arr { return place_mutable{ c, e = base.* } } }
            deref => {}
            else => { return true }
        }
        match types::get{ s = c.ty, id = pointer_of{ c, e } } {
            ptr{ mutable } => { return mutable }
            slice{ mutable } => { return mutable }
            else => { return true }
        }
    }

    // The pointer or slice a place through a deref goes through: the type of its base.
    fn pointer_of { c: Checker, e: syntax::Expr } -> Id {
        match e.k {
            field{ base } => { return types::prune{ s = c.ty, t = type_of_expr{ c, e = base.* } } }
            index{ base } => { return types::prune{ s = c.ty, t = type_of_expr{ c, e = base.* } } }
            deref{ base } => { return types::prune{ s = c.ty, t = type_of_expr{ c, e = base.* } } }
            else => { return types::ERROR }
        }
    }

    // ---- safety: escape analysis (§14), bound-function scope (§6) and exclusivity (§3.1)

    fn new_derived { mut c: Checker, xs: []u32 } -> u32 {
        let i = @as(u32, c.derived.len)
        try! list::push{ list = &c.derived, item = xs }
        return i
    }

    fn new_held { mut c: Checker, xs: []Place } -> u32 {
        let i = @as(u32, c.held.len)
        try! list::push{ list = &c.held, item = xs }
        return i
    }

    fn derived_of { c: Checker, v: u32 } -> []u32 {
        return list::items{ list = c.derived }[get_var{ c, v }.derived]
    }

    fn held_by { c: Checker, v: u32 } -> []Place {
        return list::items{ list = c.held }[get_var{ c, v }.held]
    }

    fn add_derived { mut c: Checker, v: u32, xs: []u32 } {
        let i = get_var{ c, v }.derived
        let now = set_union{ c, a = list::items{ list = c.derived }[i], b = xs }
        list::items{ list = c.derived }[i] = now
    }

    fn add_held { mut c: Checker, v: u32, xs: []Place } {
        let i = get_var{ c, v }.held
        let now = place_union{ c, a = list::items{ list = c.held }[i], b = xs }
        list::items{ list = c.held }[i] = now
    }

    // The places of a, then those of b that a doesn't have.
    fn place_union { c: Checker, a: []Place, b: []Place } -> []Place {
        let mut out = list::new(Place){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < a.len + b.len {
            let p = if i < a.len { a[i] } else { b[i - a.len] }
            let xs: []Place = list::items{ list = out }
            let mut have = false
            let mut k: usize = 0
            while k < xs.len {
                if xs[k].root == p.root and same_steps{ a = xs[k].steps, b = p.steps } { have = true }
                k = k + 1
            }
            if not have { add_place{ xs = &out, p } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn add_place { mut xs: list::List(Place, Heap), p: Place } {
        try! list::push{ list = &xs, item = p }
    }

    // Whether a value of type t can hold a pointer: only such values carry where they point.
    fn contains_ptr { mut c: Checker, t: Id, seen: []u32 } -> bool {
        return holds_ptr{ &c, t, seen, unknown = true }
    }

    // Whether t can hold a pointer. An error type holds one if an error of its set has a payload
    // that does (§8, Errors). A function's set is unknown until infer_sets: until then, with
    // unknown, it counts as holding one if any error of the program does, which keeps what values
    // are derived from sound, and without, as holding none, which leaves what is certain. A bound
    // function holds what its bind's read-only arguments were derived from (§6).
    fn holds_ptr { mut c: Checker, t: Id, seen: []u32, unknown: bool } -> bool {
        if t == types::NO_TYPE { return false }
        let x = types::prune{ s = c.ty, t }
        match types::get{ s = c.ty, id = x } {
            ptr | slice | strlit | param => { return true }
            func{ bound } => { return bound }
            opt{ elem } => { return holds_ptr{ &c, t = elem, seen, unknown } }
            array{ elem } => { return holds_ptr{ &c, t = elem, seen, unknown } }
            record{ decl } => {
                if has_id{ xs = seen, n = decl } { return false }
                let inner = set_add{ c, xs = seen, n = decl }
                let fs = struct_fields{ &c, t = x }
                let mut i: usize = 0
                while i < fs.len {
                    if holds_ptr{ &c, t = fs[i].ty, seen = inner, unknown } { return true }
                    i = i + 1
                }
                return false
            }
            sum{ decl } => {
                if has_id{ xs = seen, n = decl } { return false }
                let inner = set_add{ c, xs = seen, n = decl }
                let vs = variants_of{ &c, t = x }
                let mut i: usize = 0
                while i < vs.len {
                    let fs = vs[i].fields
                    if fs != null {
                        let mut j: usize = 0
                        while j < fs.len {
                            if holds_ptr{ &c, t = fs[j].ty, seen = inner, unknown } { return true }
                            j = j + 1
                        }
                    }
                    i = i + 1
                }
                return false
            }
            res{ ok, errs } => { return holds_ptr{ &c, t = ok, seen, unknown } or holds_ptr{ &c, t = errs, seen, unknown } }
            errs{ owner, one } => {
                if one != NONE { return faults_hold_ptr{ &c, ds = one_id{ c, n = one } } }
                if owner == NONE { return c.ptr_faults }        // any error
                let set = map::get{ m = c.sets, key = owner }
                if set != null { return faults_hold_ptr{ &c, ds = set } }
                return unknown and c.ptr_faults
            }
            eset{ errs } => { return faults_hold_ptr{ &c, ds = errs } }
            else => { return false }
        }
    }

    // Whether one of errors ds has a payload that can hold a pointer. A payload holds no error
    // (resolve_fault), so this doesn't come back to one.
    fn faults_hold_ptr { mut c: Checker, ds: []u32 } -> bool {
        let mut i: usize = 0
        while i < ds.len {
            let fs = get_decl{ c, d = ds[i] }.fields
            let mut j: usize = 0
            while j < fs.len {
                if contains_ptr{ &c, t = fs[j].ty, seen = no_vars{} } { return true }
                j = j + 1
            }
            i = i + 1
        }
        return false
    }

    // Reports an escape error (§14) about a value of type t: now if t holds a pointer for certain,
    // or, if only a function's error set can make it hold one, once the sets are inferred
    // (finish_escapes).
    fn escape_error { mut c: Checker, t: Id, at: source::Span, msg: utf8::String } {
        if holds_ptr{ &c, t, seen = no_vars{}, unknown = false } {
            flow_error{ &c, at, msg }
            return
        }
        let report = c.diags.errors == c.body_errors + c.flow_errors        // as flow_error decides
        try! list::push{ list = &c.escapes, item = Escape{ t, at, msg, report } }
    }

    // The escape errors that waited on the sets: each is real if its value's type holds a pointer
    // now that they are known.
    fn finish_escapes { mut c: Checker } {
        let xs = list::items{ list = c.escapes }
        let mut i: usize = 0
        while i < xs.len {
            let x = xs[i]
            if x.report and holds_ptr{ &c, t = x.t, seen = no_vars{}, unknown = false } { error{ &c, at = x.at, msg = x.msg } }
            i = i + 1
        }
    }

    fn one_id { c: Checker, n: u32 } -> []u32 {
        return set_add{ c, xs = no_vars{}, n }
    }

    // The type e's value has after any conversion.
    fn value_ty { c: Checker, k: u64 } -> Id {
        let conv = map::get{ m = c.convs, key = k }
        if conv != null { return conv_target{ conv } }
        let t = map::get{ m = c.expr_ty, key = k }
        return if t == null { types::NO_TYPE } else { t }
    }

    fn no_vars {} -> []u32 {
        return slice::empty(u32){}
    }

    // The locals whose addresses e's value may hold (ctxi's derives).
    fn derives { mut c: Checker, e: syntax::Expr } -> []u32 {
        if not contains_ptr{ &c, t = value_ty{ c, k = expr_key{ e } }, seen = no_vars{} } { return no_vars{} }
        return derives_raw{ &c, e }
    }

    fn derives_raw { mut c: Checker, e: syntax::Expr } -> []u32 {
        if map::get{ m = c.convs, key = expr_key{ e } } is addr_slice { return derive_addr{ &c, x = e } }
        match e.k {
            addr{ e = x } => { return derive_addr{ &c, x = x.* } }
            path => {
                if map::get{ m = c.refs, key = expr_key{ e } } is local{ var } { return derived_of{ c, v = var } }
            }
            range{ base } => { return derives_raw{ &c, e = base.* } }
            field{ base } => {
                if access_of{ c, e } is sptr | field | lit { return derives_raw{ &c, e = base.* } }
            }
            index{ base } => {
                if access_of{ c, e } is arr { return derives_raw{ &c, e = base.* } }
            }
            builtin{ name, args } => {
                if args.len > 0 and (slice::eq_bytes{ a = name.text, b = "slice" } or slice::eq_bytes{ a = name.text, b = "cast" }) {
                    return derives_raw{ &c, e = args[0] }
                }
                // A writer copies its holes' values, as a bind does.
                let st = site_at{ c, e }
                if st != null and st.value {
                    let mut out = no_vars{}
                    let mut i: usize = 0
                    while i < st.holes.len {
                        out = set_union{ c, a = out, b = derives{ &c, e = st.holes[i] } }
                        i = i + 1
                    }
                    return out
                }
            }
            braced{ items, bind } => {
                let lit = map::get{ m = c.literal, key = expr_key{ e } }
                let is_lit = lit != null and lit
                let fields = callee_fields{ c, e }
                let mut out = no_vars{}
                let mut i: usize = 0
                while i < items.len {
                    if is_lit or not field_is_mut{ fields, name = items[i].name.text } {
                        out = set_union{ c, a = out, b = derives{ &c, e = items[i].value } }
                    }
                    i = i + 1
                }
                let fw = map::get{ m = c.forwards, key = expr_key{ e } }
                if fw != null {
                    i = 0
                    while i < fw.len {
                        let f = fw[i]
                        if not f.mutable {
                            let conv_to = if f.conv == null { f.ty } else { conv_target{ conv = f.conv } }
                            if contains_ptr{ &c, t = conv_to, seen = no_vars{} } { out = set_union{ c, a = out, b = derived_of{ c, v = f.var } } }
                        }
                        i = i + 1
                    }
                }
                return out
            }
            binary{ op, a } => {
                if is_arith{ op } and types::get{ s = c.ty, id = types::prune{ s = c.ty, t = type_of_expr{ c, e = a.* } } } is ptr { return derives_raw{ &c, e = a.* } }
            }
            array{ elems } => {
                let mut out = no_vars{}
                let mut i: usize = 0
                while i < elems.len {
                    out = set_union{ c, a = out, b = derives{ &c, e = elems[i] } }
                    i = i + 1
                }
                return out
            }
            repeat{ elem } => { return derives{ &c, e = elem.* } }
            ifx{ x } => { return derives_if{ &c, x } }
            matchx{ x } => { return derives_match{ &c, x } }
            trye{ e = x } => { return derives_raw{ &c, e = x.* } }
            else => {}
        }
        return no_vars{}
    }

    fn conv_target { conv: ?Conv } -> Id {
        // `conv != null` first: on a ?Conv, `some` names the optional's own variant.
        if conv != null and conv is some{ to } | slice{ to } | addr_slice{ to } { return to }
        return types::NO_TYPE
    }

    // The operators whose left side may be a pointer, for pointer arithmetic.
    fn is_arith { op: tok::Kind } -> bool {
        return op == tok::Kind::plus or op == tok::Kind::minus or op == tok::Kind::star or op == tok::Kind::slash
            or op == tok::Kind::percent or op == tok::Kind::amp or op == tok::Kind::pipe or op == tok::Kind::caret
    }

    // The context fields of the function a call calls.
    fn callee_fields { c: Checker, e: syntax::Expr } -> []types::Field {
        if e.k is braced{ callee } and types::get{ s = c.ty, id = types::prune{ s = c.ty, t = type_of_expr{ c, e = callee.* } } } is func{ fields } { return fields }
        return slice::empty(types::Field){}
    }

    fn field_is_mut { fields: []types::Field, name: []u8 } -> bool {
        let f = types::find_field{ fields, name }
        return f != null and f.mutable
    }

    // `&x`: a stack pointer to x's root local, unless it points into the caller; through a
    // deref, whatever the pointer is derived from.
    fn derive_addr { mut c: Checker, x: syntax::Expr } -> []u32 {
        let p = place_path{ c, e = x }
        if p != null {
            if get_var{ c, v = p.root }.indirect { return no_vars{} }
            return set_add{ c, xs = no_vars{}, n = p.root }
        }
        let mut b = x
        while access_of{ c, e = b } is field | arr {
            match b.k {
                field{ base } => { b = base.* }
                index{ base } => { b = base.* }
                else => { return no_vars{} }
            }
        }
        match b.k {
            field{ base } => { return derives_raw{ &c, e = base.* } }
            index{ base } => { return derives_raw{ &c, e = base.* } }
            deref{ base } => { return derives_raw{ &c, e = base.* } }
            else => { return no_vars{} }
        }
    }

    fn derives_if { mut c: Checker, x: syntax::If } -> []u32 {
        let mut out = derives_block{ &c, b = x.then }
        let els = x.els
        if els != null { out = set_union{ c, a = out, b = derives_block{ &c, b = els } } }
        return out
    }

    fn derives_match { mut c: Checker, x: syntax::Match } -> []u32 {
        let mut out = no_vars{}
        let mut i: usize = 0
        while i < x.arms.len {
            out = set_union{ c, a = out, b = derives_block{ &c, b = x.arms[i].body } }
            i = i + 1
        }
        return out
    }

    // What the value of a branch of an `if` or `match` expression is derived from.
    fn derives_block { mut c: Checker, b: syntax::Block } -> []u32 {
        if b.stmts.len == 0 { return no_vars{} }
        return derives_value{ &c, v = branch_value{ s = b.stmts[b.stmts.len - 1] } }
    }

    fn derives_value { mut c: Checker, v: Value } -> []u32 {
        match v {
            expr{ e } => { return derives{ &c, e } }
            nested{ s } => {
                if not contains_ptr{ &c, t = value_ty{ c, k = stmt_key{ s } }, seen = no_vars{} } { return no_vars{} }
                match s.k {
                    cond{ x } => { return derives_if{ &c, x } }
                    choose{ x } => { return derives_match{ &c, x } }
                    else => {}
                }
            }
            none => {}
        }
        return no_vars{}
    }

    // The places a `&fn` value holds: a `&fn` local's, a bind's, or those of the branches of an
    // `if` or `match` expression.
    fn held_of { c: Checker, e: syntax::Expr } -> []Place {
        let none: []Place = slice::empty(Place){}
        if map::get{ m = c.convs, key = expr_key{ e } } != null { return none }
        match e.k {
            path => {
                if map::get{ m = c.refs, key = expr_key{ e } } is local{ var } { return held_by{ c, v = var } }
            }
            braced{ bind } => {
                if bind {
                    let h = map::get{ m = c.holds, key = expr_key{ e } }
                    if h != null { return h }
                }
            }
            builtin => {
                // A writer, an @fmt without a sink, holds what its holes hold.
                let h = map::get{ m = c.holds, key = expr_key{ e } }
                if h != null { return h }
            }
            ifx{ x } => {
                let mut out = held_block{ c, b = x.then }
                let els = x.els
                if els != null { out = place_concat{ c, a = out, b = held_block{ c, b = els } } }
                return out
            }
            matchx{ x } => {
                let mut out = none
                let mut i: usize = 0
                while i < x.arms.len {
                    out = place_concat{ c, a = out, b = held_block{ c, b = x.arms[i].body } }
                    i = i + 1
                }
                return out
            }
            else => {}
        }
        return none
    }

    fn held_block { c: Checker, b: syntax::Block } -> []Place {
        if b.stmts.len == 0 { return slice::empty(Place){} }
        return held_value{ c, v = branch_value{ s = b.stmts[b.stmts.len - 1] } }
    }

    fn held_value { c: Checker, v: Value } -> []Place {
        let none: []Place = slice::empty(Place){}
        match v {
            expr{ e } => { return held_of{ c, e } }
            nested{ s } => {
                if map::get{ m = c.convs, key = stmt_key{ s } } != null { return none }
                match s.k {
                    cond{ x } => {
                        let mut out = held_block{ c, b = x.then }
                        let els = x.els
                        if els != null { out = place_concat{ c, a = out, b = held_block{ c, b = els } } }
                        return out
                    }
                    choose{ x } => {
                        let mut out = none
                        let mut i: usize = 0
                        while i < x.arms.len {
                            out = place_concat{ c, a = out, b = held_block{ c, b = x.arms[i].body } }
                            i = i + 1
                        }
                        return out
                    }
                    else => {}
                }
            }
            none => {}
        }
        return none
    }

    fn place_concat { c: Checker, a: []Place, b: []Place } -> []Place {
        if b.len == 0 { return a }
        let mut out = list::new(Place){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < a.len + b.len {
            add_place{ xs = &out, p = if i < a.len { a[i] } else { b[i - a.len] } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // Locals in the order of their declarations, so that a message about one of several names
    // the one ctxi names.
    fn vars_in_order { c: Checker, xs: []u32 } -> []u32 {
        let mut out = list::new(u32){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < xs.len {
            push{ xs = &out, n = xs[i] }
            let ys = list::items{ list = out }
            let mut k = ys.len - 1
            while k > 0 and get_var{ c, v = ys[k] }.at.start < get_var{ c, v = ys[k - 1] }.at.start {
                let t = ys[k]
                ys[k] = ys[k - 1]
                ys[k - 1] = t
                k = k - 1
            }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // Places ordered by their roots' declarations, then by their steps: a field before an index,
    // fields by name, a prefix first.
    fn places_in_order { c: Checker, xs: []Place } -> []Place {
        let mut out = list::new(Place){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < xs.len {
            add_place{ xs = &out, p = xs[i] }
            let ys = list::items{ list = out }
            let mut k = ys.len - 1
            while k > 0 and place_less{ c, a = ys[k], b = ys[k - 1] } {
                let t = ys[k]
                ys[k] = ys[k - 1]
                ys[k - 1] = t
                k = k - 1
            }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn place_less { c: Checker, a: Place, b: Place } -> bool {
        let ra = get_var{ c, v = a.root }.at.start
        let rb = get_var{ c, v = b.root }.at.start
        if ra != rb { return ra < rb }
        let mut i: usize = 0
        while i < a.steps.len and i < b.steps.len {
            let x = a.steps[i]
            let y = b.steps[i]
            let xi = slice::eq_bytes{ a = x, b = "[" }
            let yi = slice::eq_bytes{ a = y, b = "[" }
            if xi != yi { return yi }
            if not xi and not slice::eq_bytes{ a = x, b = y } { return bytes_less{ a = x, b = y } }
            i = i + 1
        }
        return a.steps.len < b.steps.len
    }

    fn bytes_less { a: []u8, b: []u8 } -> bool {
        let mut i: usize = 0
        while i < a.len and i < b.len {
            if a[i] != b[i] { return a[i] < b[i] }
            i = i + 1
        }
        return a.len < b.len
    }

    // A store of rhs into a place rooted at local root, or through a pointer (through). The
    // place can't hold the address of a local that ends before it, or that is the caller's.
    fn check_store { mut c: Checker, root: u32, through: bool, rhs: syntax::Expr, at: source::Span } {
        let found = derives{ &c, e = rhs }
        if found.len == 0 { return }
        let t = value_ty{ c, k = expr_key{ e = rhs } }
        let ds = vars_in_order{ c, xs = found }
        let name = get_var{ c, v = ds[0] }.name
        if through {
            let mut b = message{ c }
            try! @fmt(&b, "cannot store the address of local `{}` through a pointer", str{ s = name })
            escape_error{ &c, t, at, msg = utf8::view{ b } }
            return
        }
        let r = get_var{ c, v = root }
        if r.indirect {
            let mut b = message{ c }
            try! @fmt(&b, "cannot store the address of local `{}` in `{}`, which belongs to the caller", str{ s = name }, str{ s = r.name })
            escape_error{ &c, t, at, msg = utf8::view{ b } }
            return
        }
        let mut i: usize = 0
        while i < ds.len {
            let l = get_var{ c, v = ds[i] }
            if r.depth < l.depth {
                let mut b = message{ c }
                try! @fmt(&b, "`{}` outlives local `{}` whose address it would hold", str{ s = r.name }, str{ s = l.name })
                escape_error{ &c, t, at, msg = utf8::view{ b } }
                return
            }
            i = i + 1
        }
        add_derived{ &c, v = root, xs = ds }
    }

    // A bound function stored in local v can't hold a place that ends before v does (§6).
    fn check_bound_scope { mut c: Checker, v: u32, places: []Place, at: source::Span } {
        let held = places_in_order{ c, xs = places }
        let x = get_var{ c, v }
        let mut i: usize = 0
        while i < held.len {
            let r = get_var{ c, v = held[i].root }
            if x.depth < r.depth {
                let mut b = message{ c }
                try! @fmt(&b, "bound function stored in `{}` holds `{}`, which does not live as long", str{ s = x.name }, str{ s = r.name })
                flow_error{ &c, at, msg = utf8::view{ b } }
                return
            }
            i = i + 1
        }
    }

    // A call's mut references, `&p` for a `mut` field (holder empty), and the places held by its
    // bound-function arguments (holder names the argument), which must not overlap (§3.1).
    struct HeldRef { p: Place, holder: []u8 }

    fn check_exclusive { mut c: Checker, e: syntax::Expr, items: []syntax::Item, fields: []types::Field } -> []Place {
        let mut refs = list::new(HeldRef){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < items.len {
            let it = items[i]
            let f = types::find_field{ fields, name = it.name.text }
            if f != null {
                if f.mutable {
                    if it.value.k is addr{ e = x } {
                        let p = place_path{ c, e = x.* }
                        if p != null { add_ref{ xs = &refs, r = HeldRef{ p, holder = "" } } }
                    }
                } else {
                    let holder = match it.value.k {
                        path{ segs } => { if map::get{ m = c.convs, key = expr_key{ e = it.value } } == null { segs[0].name.text } else { it.name.text } }
                        else => { it.name.text }
                    }
                    held_refs{ xs = &refs, c, places = held_of{ c, e = it.value }, holder }
                }
            }
            i = i + 1
        }
        let fw = map::get{ m = c.forwards, key = expr_key{ e } }
        if fw != null {
            i = 0
            while i < fw.len {
                let f = fw[i]
                if f.mutable {
                    add_ref{ xs = &refs, r = HeldRef{ p = Place{ root = root_var{ c, v = f.var }, steps = slice::empty([]u8){} }, holder = "" } }
                } else if f.conv == null {
                    held_refs{ xs = &refs, c, places = held_by{ c, v = f.var }, holder = f.name }
                }
                i = i + 1
            }
        }
        let rs = list::items{ list = refs }
        overlapping{ &c, e, rs }
        return places_of{ c, rs }
    }

    // The first two of call e's mut references rs that overlap, if any, as an error.
    fn overlapping { mut c: Checker, e: syntax::Expr, rs: []HeldRef } {
        let mut i: usize = 0
        while i < rs.len {
            let mut j = i + 1
            while j < rs.len {
                let a = rs[i]
                let b = rs[j]
                if overlap{ p = a.p, q = b.p } {
                    let mut m = message{ c }
                    if a.holder.len == 0 and b.holder.len == 0 {
                        try! @fmt(&m, "two mut references to `{}` in one call", place_str{ c, p = a.p })
                    } else {
                        let holder = if b.holder.len > 0 { b.holder } else { a.holder }
                        let place = if a.holder.len == 0 { a.p } else { b.p }
                        try! @fmt(&m, "`{}` overlaps a place held by `{}`", place_str{ c, p = place }, str{ s = holder })
                    }
                    flow_error{ &c, at = expr_at{ e }, msg = utf8::view{ b = m } }
                    return
                }
                j = j + 1
            }
            i = i + 1
        }
    }

    fn add_ref { mut xs: list::List(HeldRef, Heap), r: HeldRef } {
        try! list::push{ list = &xs, item = r }
    }

    fn held_refs { mut xs: list::List(HeldRef, Heap), c: Checker, places: []Place, holder: []u8 } {
        let ps = places_in_order{ c, xs = places }
        let mut i: usize = 0
        while i < ps.len {
            add_ref{ &xs, r = HeldRef{ p = ps[i], holder } }
            i = i + 1
        }
    }

    fn places_of { c: Checker, rs: []HeldRef } -> []Place {
        let mut out = list::new(Place){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < rs.len {
            add_place{ xs = &out, p = rs[i].p }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // Two places overlap if one's steps are a prefix of the other's, from the same root. Any two
    // index steps count as the same.
    fn overlap { p: Place, q: Place } -> bool {
        if p.root != q.root { return false }
        let mut i: usize = 0
        while i < p.steps.len and i < q.steps.len {
            let a = p.steps[i]
            let b = q.steps[i]
            let both_union = a.len > 0 and b.len > 0 and a[0] == '|' and b[0] == '|'
            if not both_union and not slice::eq_bytes{ a, b } { return false }
            i = i + 1
        }
        return true
    }

    // `a.b[_]`
    fn place_str { c: Checker, p: Place } -> utf8::String {
        let mut b = message{ c }
        try! utf8::push{ &b, s = str{ s = get_var{ c, v = p.root }.name } }
        let mut i: usize = 0
        while i < p.steps.len {
            if slice::eq_bytes{ a = p.steps[i], b = "[" } {
                try! utf8::push{ &b, s = "[_]" }
            } else if p.steps[i].len > 0 and p.steps[i][0] == '|' {
                try! utf8::push{ &b, s = "." }
                try! utf8::push{ &b, s = str{ s = p.steps[i][1..] } }
            } else {
                try! utf8::push{ &b, s = "." }
                try! utf8::push{ &b, s = str{ s = p.steps[i] } }
            }
            i = i + 1
        }
        return utf8::view{ b }
    }

    // ---- accesses inside the arms of `match &p` (§8, Match, rule 7): none may overlap p except
    // through the arm's bindings.

    struct Scan { forb: Place, via: utf8::String }

    fn scan_stmts { mut c: Checker, sc: Scan, xs: []syntax::Stmt } {
        let mut i: usize = 0
        while i < xs.len {
            scan_stmt{ &c, sc, s = xs[i] }
            i = i + 1
        }
    }

    fn scan_stmt { mut c: Checker, sc: Scan, s: syntax::Stmt } {
        match s.k {
            local{ init } => { if init != null { scan{ &c, sc, e = init } } }
            let_else{ init, els } => {
                scan{ &c, sc, e = init }
                scan_stmts{ &c, sc, xs = els.stmts }
            }
            assign{ place, value } => {
                scan{ &c, sc, e = place }
                scan{ &c, sc, e = value }
            }
            eval{ e } => { scan{ &c, sc, e } }
            discard{ e } => { scan{ &c, sc, e } }
            cond{ x } => { scan_if{ &c, sc, x } }
            loop{ c = cond, body } => {
                scan{ &c, sc, e = cond }
                scan_stmts{ &c, sc, xs = body.stmts }
            }
            choose{ x } => { scan_match{ &c, sc, x } }
            ret{ value } => { if value != null { scan{ &c, sc, e = value } } }
            deferred{ body } => { scan_stmts{ &c, sc, xs = body.stmts } }
            else => {}
        }
    }

    fn scan_if { mut c: Checker, sc: Scan, x: syntax::If } {
        scan{ &c, sc, e = x.c.* }
        scan_stmts{ &c, sc, xs = x.then.stmts }
        let els = x.els
        if els != null { scan_stmts{ &c, sc, xs = els.stmts } }
    }

    fn scan_match { mut c: Checker, sc: Scan, x: syntax::Match } {
        scan{ &c, sc, e = x.scrut.* }
        let mut i: usize = 0
        while i < x.arms.len {
            scan_stmts{ &c, sc, xs = x.arms[i].body.stmts }
            i = i + 1
        }
    }

    fn scan_list { mut c: Checker, sc: Scan, xs: []syntax::Expr } {
        let mut i: usize = 0
        while i < xs.len {
            scan{ &c, sc, e = xs[i] }
            i = i + 1
        }
    }

    fn scan { mut c: Checker, sc: Scan, e: syntax::Expr } {
        match e.k {
            path | field | index | deref => {
                let ap = access_path{ c, e }
                if ap != null and overlap{ p = ap, q = sc.forb } { forbidden{ &c, sc, at = expr_at{ e } } }
                let mut n = e
                while true {
                    match n.k {
                        field{ base } => { n = base.* }
                        deref{ base } => { n = base.* }
                        index{ base, i } => {
                            scan{ &c, sc, e = i.* }
                            n = base.*
                        }
                        else => { break }
                    }
                }
                if not (n.k is path) { scan{ &c, sc, e = n } }
            }
            braced{ callee, items } => {
                let mut scan_callee = true
                if callee.k is path { scan_callee = map::get{ m = c.refs, key = expr_key{ e = callee.* } } is local }
                if scan_callee { scan{ &c, sc, e = callee.* } }
                let mut i: usize = 0
                while i < items.len {
                    scan{ &c, sc, e = items[i].value }
                    i = i + 1
                }
                // What `..` supplies is a use of each local it names.
                let fw = map::get{ m = c.forwards, key = expr_key{ e } }
                if fw != null {
                    i = 0
                    while i < fw.len {
                        let p = Place{ root = root_var{ c, v = fw[i].var }, steps = slice::empty([]u8){} }
                        if overlap{ p, q = sc.forb } { forbidden{ &c, sc, at = expr_at{ e } } }
                        i = i + 1
                    }
                }
            }
            neg{ e = x } => { scan{ &c, sc, e = x.* } }
            lnot{ e = x } => { scan{ &c, sc, e = x.* } }
            addr{ e = x } => { scan{ &c, sc, e = x.* } }
            binary{ a, b } => {
                scan{ &c, sc, e = a.* }
                scan{ &c, sc, e = b.* }
            }
            array{ elems } => { scan_list{ &c, sc, xs = elems } }
            repeat{ elem } => { scan{ &c, sc, e = elem.* } }
            builtin{ args } => { scan_list{ &c, sc, xs = args } }
            range{ base, lo, hi } => {
                scan{ &c, sc, e = base.* }
                if lo != null { scan{ &c, sc, e = lo.* } }
                if hi != null { scan{ &c, sc, e = hi.* } }
            }
            ifx{ x } => { scan_if{ &c, sc, x } }
            matchx{ x } => { scan_match{ &c, sc, x } }
            trye{ e = x } => { scan{ &c, sc, e = x.* } }
            isx{ e = x } => { scan{ &c, sc, e = x.* } }
            else => {}
        }
    }

    fn forbidden { mut c: Checker, sc: Scan, at: source::Span } {
        let mut b = message{ c }
        try! @fmt(&b, "{} overlaps the match scrutinee; access it only through {}", place_str{ c, p = sc.forb }, sc.via)
        flow_error{ &c, at, msg = utf8::view{ b } }
    }

    // The place an access reads, as far as it is known: through a pointer or slice, the place
    // of the pointer (ctxi's access_path).
    fn access_path { c: Checker, e: syntax::Expr } -> ?Place {
        match e.k {
            path => {
                if map::get{ m = c.refs, key = expr_key{ e } } is local{ var } { return Place{ root = root_var{ c, v = var }, steps = slice::empty([]u8){} } }
            }
            field{ base, name } => {
                let ap = access_path{ c, e = base.* }
                if ap != null and access_of{ c, e } is field {
                    return Place{ root = ap.root, steps = add_step{ c, steps = ap.steps, step = name.text } }
                }
                return ap
            }
            index{ base } => {
                let ap = access_path{ c, e = base.* }
                if ap != null and access_of{ c, e } is arr {
                    return Place{ root = ap.root, steps = add_step{ c, steps = ap.steps, step = "[" } }
                }
                return ap
            }
            deref{ base } => { return access_path{ c, e = base.* } }
            else => {}
        }
        return null
    }

    // ---- expressions (ctxi's e_* methods)

    fn expr_key { e: syntax::Expr } -> u64 {
        return key{ file = e.span.file, id = e.id }
    }

    fn type_of_expr { c: Checker, e: syntax::Expr } -> Id {
        let t = map::get{ m = c.expr_ty, key = expr_key{ e } }
        return if t == null { types::ERROR } else { t }
    }

    // The type recorded under key k: an expression's, or a nested `if` or `match`'s as a branch
    // value.
    fn type_of_key { c: Checker, k: u64 } -> Id {
        let t = map::get{ m = c.expr_ty, key = k }
        return if t == null { types::ERROR } else { t }
    }

    fn set_type { mut c: Checker, e: syntax::Expr, t: Id } {
        try! map::put{ m = &c.expr_ty, key = expr_key{ e }, value = t }
    }

    // Checks e, of type exp if it has an expected type (types::NO_TYPE otherwise), and records
    // its type.
    fn expr { mut c: Checker, e: syntax::Expr, exp: Id } -> Id {
        let t = expr_kind{ &c, e, exp }
        set_type{ &c, e, t }
        return t
    }

    // Checks that e has a type that converts to t.
    fn expect { mut c: Checker, e: syntax::Expr, t: Id } {
        let at = expr{ &c, e, exp = t }
        coerce_node{ &c, e, at, t }
    }

    // The type of an expression that must have a value, from which a new local gets its type.
    fn value_type { mut c: Checker, e: syntax::Expr } -> Id {
        let t = expr{ &c, e, exp = types::NO_TYPE }
        if t == types::NULL { error{ &c, at = expr_at{ e }, msg = "cannot infer the type of `null` here; add a type" } }
        if t == types::VOID { error{ &c, at = expr_at{ e }, msg = "expression has no value" } }
        return t
    }

    fn coerce_node { mut c: Checker, e: syntax::Expr, at: Id, t: Id } {
        coerce_key{ &c, k = expr_key{ e }, pos = expr_at{ e }, a = at, t }
    }

    // Converts the value with key k, of type a, to t, and records how. pos is where it is.
    fn coerce_key { mut c: Checker, k: u64, pos: source::Span, a: Id, t: Id } {
        let to = inner_target{ c, a, t }
        match convert{ &c, a, t, pos } {
            fail | same => {}
            some => { put_conv_key{ &c, k, conv = Conv::some{ to } } }
            to_slice => { put_conv_key{ &c, k, conv = Conv::slice{ to } } }
            to_null => { put_type{ &c, k, t = to } }
        }
    }

    // The type a value of type a becomes inside t: when t is a `!T` and a is neither a `!T` nor
    // an error, a becomes the result's value, a T; otherwise t.
    fn inner_target { c: Checker, a: Id, t: Id } -> Id {
        let res{ ok } = types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } else { return t }
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t = a } } {
            res | errs => { return t }
            else => { return ok }
        }
    }

    // Whether errors of type `from` may become errors of type `into` (both errs), which records
    // that they do when into is the set of the function being checked. A set takes another's
    // errors only there, or when it is any error: a function type's, which has no body to infer
    // a set from.
    fn flows { mut c: Checker, from: Id, into: Id } -> bool {
        let x = types::prune{ s = c.ty, t = from }
        let y = types::prune{ s = c.ty, t = into }
        if x == y { return true }
        let errs{ owner = io, one = ie } = types::get{ s = c.ty, id = y } else { return false }
        if io == NONE and ie == NONE { return true }
        if io == NONE or io != c.fn_decl { return false }
        let errs{ owner = fo, one = fe } = types::get{ s = c.ty, id = x } else { return false }
        let f = map::get{ m = c.flows, key = io } ifnull { Flow{ atoms = no_vars{}, subs = no_vars{}, any = false } }
        let mut g = f
        if fe != NONE {
            g.atoms = set_add{ c, xs = f.atoms, n = fe }
        } else if fo == NONE {
            g.any = true
        } else if fo != io {
            g.subs = set_add{ c, xs = f.subs, n = fo }
        }
        try! map::put{ m = &c.flows, key = io, value = g }
        return true
    }

    // How a value of type a converts to t, after reporting at pos that it doesn't.
    fn convert { mut c: Checker, a: Id, t: Id, pos: source::Span } -> Coercion {
        if a == types::VOID {
            error{ &c, at = pos, msg = "expression has no value" }
            return Coercion::fail
        }
        let how = coerce{ &c, a, e = t }
        if how is fail {
            let mut b = message{ c }
            try! mismatch{ &c, a, e = t, &b }
            error{ &c, at = pos, msg = utf8::view{ b } }
        }
        return how
    }

    fn put_conv { mut c: Checker, e: syntax::Expr, conv: Conv } {
        put_conv_key{ &c, k = expr_key{ e }, conv }
    }

    fn put_conv_key { mut c: Checker, k: u64, conv: Conv } {
        try! map::put{ m = &c.convs, key = k, value = conv }
    }

    // A conversion as recorded, for a value that has no node.
    fn conv_of { how: Coercion, t: Id } -> ?Conv {
        match how {
            some => { return Conv::some{ to = t } }
            to_slice => { return Conv::slice{ to = t } }
            else => { return null }
        }
    }

    union Coercion { fail, same, some, to_slice, to_null }

    // How a value of type a converts to type e, if it does.
    fn coerce { mut c: Checker, a: Id, e: Id } -> Coercion {
        let x = types::prune{ s = c.ty, t = a }
        let y = types::prune{ s = c.ty, t = e }
        if x == types::ERROR or y == types::ERROR { return Coercion::same }
        let ty = types::get{ s = c.ty, id = y }
        // A T becomes a `!T`'s value; a `!T` or an error keeps its errors, which may join the
        // function's (flows).
        match ty {
            res{ ok = u, errs = into } => {
                match types::get{ s = c.ty, id = x } {
                    res{ ok = t, errs = from } => {
                        if not types::unify{ s = &c.ty, a = t, b = u } { return Coercion::fail }
                        return if flows{ &c, from, into } { Coercion::same } else { Coercion::fail }
                    }
                    errs => { return if flows{ &c, from = x, into } { Coercion::same } else { Coercion::fail } }
                    var{ n } => {
                        if types::var_of{ s = c.ty, n }.kind == types::VarKind::any {
                            return if types::unify{ s = &c.ty, a = x, b = y } { Coercion::same } else { Coercion::fail }
                        }
                    }
                    else => {}
                }
                if types::prune{ s = c.ty, t = u } == types::VOID { return Coercion::fail }
                return coerce{ &c, a = x, e = u }
            }
            errs => {
                if types::get{ s = c.ty, id = x } is errs { return if flows{ &c, from = x, into = y } { Coercion::same } else { Coercion::fail } }
            }
            else => {}
        }
        if x == types::NULL {
            match ty { opt => { return Coercion::to_null } else => { return Coercion::fail } }
        }
        let tx = types::get{ s = c.ty, id = x }
        match ty {
            slice{ elem = ee, mutable = em } => {
                if tx is ptr{ elem = ae, mutable = am } {
                    if types::get{ s = c.ty, id = types::prune{ s = c.ty, t = ae } } is array{ elem } and (am or not em) and types::unify{ s = &c.ty, a = elem, b = ee } { return Coercion::to_slice }
                }
            }
            opt{ elem = ee } => {
                match tx {
                    opt{ elem = ae } => {
                        if types::get{ s = c.ty, id = types::prune{ s = c.ty, t = ae } } is ptr | slice and types::widens{ s = &c.ty, a = ae, b = ee } { return Coercion::same }
                        return if types::unify{ s = &c.ty, a = x, b = y } { Coercion::same } else { Coercion::fail }
                    }
                    var{ n } => {
                        if types::var_of{ s = c.ty, n }.kind == types::VarKind::any {
                            return if types::unify{ s = &c.ty, a = x, b = y } { Coercion::same } else { Coercion::fail }
                        }
                    }
                    else => {}
                }
                if types::unify{ s = &c.ty, a = x, b = ee } or types::widens{ s = &c.ty, a = x, b = ee } or includes_cap{ c, a = x, b = ee } { return Coercion::some }
                return Coercion::fail
            }
            cap => {
                if includes_cap{ c, a = x, b = y } { return Coercion::same }
            }
            func{ bound = eb, external = ee } => {
                if tx is func{ bound = ab, external = ae } {
                    // A C function pointer and a ctxlang function value don't convert either
                    // way; two C function types must be the same.
                    if ae != ee { return Coercion::fail }
                    if ee { return if types::unify{ s = &c.ty, a = x, b = y } { Coercion::same } else { Coercion::fail } }
                    if ab and not eb { return Coercion::fail }
                    return if fn_accepts{ &c, g = x, s = y } { Coercion::same } else { Coercion::fail }
                }
            }
            else => {}
        }
        if types::unify{ s = &c.ty, a = x, b = y } or types::widens{ s = &c.ty, a = x, b = y } { return Coercion::same }
        return Coercion::fail
    }

    // §5: whether function type g is accepted where s is expected, bound-ness aside.
    fn fn_accepts { mut c: Checker, g: Id, s: Id } -> bool {
        match types::get{ s = c.ty, id = g } {
            func{ fields = gf, ret = gr } => {
                match types::get{ s = c.ty, id = s } {
                    func{ fields = sf, ret = sr } => {
                        let mut i: usize = 0
                        while i < gf.len {
                            let f = gf[i]
                            let h = types::find_field{ fields = sf, name = f.name }
                            if h == null or h.mutable != f.mutable or not types::unify{ s = &c.ty, a = f.ty, b = h.ty } { return false }
                            i = i + 1
                        }
                        return types::unify{ s = &c.ty, a = gr, b = sr }
                    }
                    else => { return false }
                }
            }
            else => { return false }
        }
    }

    fn mismatch { mut c: Checker, a: Id, e: Id, mut b: utf8::Builder(Heap) } -> ! {
        let x = types::prune{ s = c.ty, t = a }
        let y = types::prune{ s = c.ty, t = e }
        if types::get{ s = c.ty, id = x } is func{ fields = af, bound = ab, external = ae } {
            if types::get{ s = c.ty, id = y } is func{ fields = ef, bound = eb, external = ee } {
                if ee and not ae {
                    try @fmt(&b, "a ctxlang function can't be passed as a C function pointer (")
                    try write_type{ c, t = y, &b }
                    return @fmt(&b, "): only an extern fn or a `#c::callback` fn can")
                }
                if ae and not ee {
                    try @fmt(&b, "a C function pointer (")
                    try write_type{ c, t = x, &b }
                    try @fmt(&b, ") can't be used as a ctxlang ")
                    return write_type{ c, t = y, &b }
                }
                if not (ab and not eb) and not ae {
                    let mut i: usize = 0
                    while i < af.len {
                        let f = af[i]
                        if types::find_field{ fields = ef, name = f.name } == null {
                            let m: utf8::String = if f.mutable { "mut " } else { "" }
                            try @fmt(&b, "function needs `{}{}`, which ", m, str{ s = f.name })
                            try write_type{ c, t = y, &b }
                            return @fmt(&b, " doesn't provide")
                        }
                        i = i + 1
                    }
                }
            }
        }
        // Two results, or two functions returning one, whose errors differ.
        let xr = result_of{ c, t = x }
        let yr = result_of{ c, t = y }
        if types::get{ s = c.ty, id = xr } is res{ ok = xo, errs = xe } {
            if types::get{ s = c.ty, id = yr } is res{ ok = yo, errs = ye } {
                if types::prune{ s = c.ty, t = xo } == types::prune{ s = c.ty, t = yo } and xe != ye {
                    if xr != x {
                        try @fmt(&b, "a function whose `!T` fails with its body's errors can't be a value of type ")
                        try write_type{ c, t = y, &b }
                        return @fmt(&b, ", whose `!T` fails with any error")
                    }
                    try @fmt(&b, "expected ")
                    try write_type{ c, t = y, &b }
                    try @fmt(&b, " failing with ")
                    try set_text{ c, t = ye, &b }
                    try @fmt(&b, ", got one failing with ")
                    try set_text{ c, t = xe, &b }
                    return @fmt(&b, ": errors join only the result of the function that returns them")
                }
            }
        }
        try @fmt(&b, "expected ")
        try write_type{ c, t = y, &b }
        try @fmt(&b, ", got ")
        return write_type{ c, t = x, &b }
    }

    // t's result if t is a function type, else t.
    fn result_of { c: Checker, t: Id } -> Id {
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } {
            func{ ret } => { return types::prune{ s = c.ty, t = ret } }
            else => { return types::prune{ s = c.ty, t } }
        }
    }

    fn expr_kind { mut c: Checker, e: syntax::Expr, exp: Id } -> Id {
        match e.k {
            error => { return types::ERROR }
            int => {
                add_lit{ &c, e }
                return types::fresh{ s = &c.ty, kind = types::VarKind::int }
            }
            float => {
                add_lit{ &c, e }
                return types::fresh{ s = &c.ty, kind = types::VarKind::float }
            }
            str{ bytes } => { return str_lit{ &c, e, bytes, exp } }
            boolean => { return types::BOOL }
            nil => { return types::NULL }
            path{ segs } => { return path_expr{ &c, e, segs, exp } }
            braced{ callee, items, forward, bind } => { return braced{ &c, e, callee = callee.*, items, forward, bind, exp } }
            neg{ e = x } => {
                let t = expr{ &c, e = x.*, exp }
                if not is_num{ c, t } {
                    errorf{ &c, at = expr_at{ e }, msg = @fmt("unary `-` needs a number, got {}", tstr{ c, t }) }
                }
                return t
            }
            lnot{ e = x } => {
                expect{ &c, e = x.*, t = types::BOOL }
                return types::BOOL
            }
            binary{ op, a, b } => { return binary{ &c, e, op, a = a.*, b = b.*, exp } }
            array{ elems } => { return array_lit{ &c, e, elems, exp } }
            repeat{ elem, count } => { return repeat{ &c, elem = elem.*, count = count.*, exp } }
            builtin{ name, targ, args } => { return builtin{ &c, e, name, targ, args, exp } }
            field{ base, name } => { return field_expr{ &c, e, base = base.*, name } }
            deref{ base } => {
                let bt = typed{ &c, e = base.* }
                match types::get{ s = c.ty, id = bt } {
                    ptr{ elem } => { return elem }
                    error => { return types::ERROR }
                    else => {
                        errorf{ &c, at = expr_at{ e }, msg = @fmt("`.*` needs a pointer, got {}", tstr{ c, t = bt }) }
                        return types::ERROR
                    }
                }
            }
            index{ base, i } => {
                let bt = typed{ &c, e = base.* }
                expect{ &c, e = i.*, t = types::USIZE }
                match types::get{ s = c.ty, id = bt } {
                    array{ elem } => {
                        put_access{ &c, e, a = Access::arr }
                        return elem
                    }
                    slice{ elem } => {
                        put_access{ &c, e, a = Access::slice }
                        return elem
                    }
                    ptr{ elem } => {
                        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t = elem } } {
                            array{ elem = inner } => {
                                put_access{ &c, e, a = Access::parr }
                                return inner
                            }
                            else => {
                                put_access{ &c, e, a = Access::ptr }
                                return elem
                            }
                        }
                    }
                    error => { return types::ERROR }
                    else => {
                        errorf{ &c, at = expr_at{ e }, msg = @fmt("cannot index {}", tstr{ c, t = bt }) }
                        return types::ERROR
                    }
                }
            }
            range{ base, lo, hi } => { return range_expr{ &c, e, base = base.*, lo, hi } }
            addr{ e = x } => {
                let t = expr{ &c, e = x.*, exp = types::NO_TYPE }
                if not check_place{ &c, e = x.* } { return types::ERROR }
                let m = place_mutable{ c, e = x.* }
                return types::ptr{ s = &c.ty, elem = t, mutable = m }
            }
            ifx{ x } => { return check_if{ &c, x, at = expr_at{ e }, exp, value = true, may_leave = false } }
            matchx{ x } => { return check_match{ &c, x, at = expr_at{ e }, exp, value = true, may_leave = false } }
            trye{ e = x, panics } => { return try_expr{ &c, e, x = x.*, panics } }
            isx{ e = x, pats } => { return check_is{ &c, e, x = x.*, pats } }
        }
    }

    // `try x` (§8, Errors): x's value, or x's error returned from the function, whose set gains
    // x's errors. x is a `!T`, in a function returning `!U`. `try! x` panics instead, in any
    // function.
    fn try_expr { mut c: Checker, e: syntax::Expr, x: syntax::Expr, panics: bool } -> Id {
        let t = typed{ &c, e = x }
        if t == types::ERROR { return types::ERROR }
        let res{ ok, errs } = types::get{ s = c.ty, id = t } else {
            errorf{ &c, at = expr_at{ e = x }, msg = @fmt("`{}` needs a `!T` value, got {}", str{ s = if panics { "try!" } else { "try" } }, tstr{ c, t }) }
            return types::ERROR
        }
        if panics { return ok }
        if c.defers > 0 {
            error{ &c, at = expr_at{ e }, msg = "cannot `try` in a defer: it may return" }
            return ok
        }
        if c.ret == types::ERROR { return ok }
        let res{ errs = own } = types::get{ s = c.ty, id = types::prune{ s = c.ty, t = c.ret } } else {
            let mut b = message{ c }
            if c.ret == types::VOID {
                try! utf8::push{ &b, s = "`try` passes an error up: it needs a function that returns `!T`, not one without a result type" }
            } else {
                try! @fmt(&b, "`try` passes an error up: it needs a function that returns `!T`, not {}", tstr{ c, t = c.ret })
            }
            error{ &c, at = expr_at{ e }, msg = utf8::view{ b } }
            return ok
        }
        // Like `return`, `try` can't hand the caller an error that holds the address of a local.
        if contains_ptr{ &c, t = errs, seen = no_vars{} } {
            let found = derives_raw{ &c, e = x }
            if found.len > 0 {
                let ds = vars_in_order{ c, xs = found }
                let mut b = message{ c }
                try! @fmt(&b, "`try` would return an error that may hold the address of local `{}`", str{ s = get_var{ c, v = ds[0] }.name })
                escape_error{ &c, t = errs, at = expr_at{ e }, msg = utf8::view{ b } }
            }
        }
        _ = flows{ &c, from = errs, into = own }
        return ok
    }

    // `base[lo..hi]`. An array place is sliced through its address, a `*[N]T` directly.
    fn range_expr { mut c: Checker, e: syntax::Expr, base: syntax::Expr, lo: ?*syntax::Expr, hi: ?*syntax::Expr } -> Id {
        let mut bt = typed{ &c, e = base }
        let mut addr = types::NO_TYPE
        let mut ok = true
        if types::get{ s = c.ty, id = bt } is array {
            if check_place{ &c, e = base } {
                let m = place_mutable{ c, e = base }
                addr = types::ptr{ s = &c.ty, elem = bt, mutable = m }
                bt = addr
            } else {
                ok = false
            }
        }
        if types::get{ s = c.ty, id = bt } is ptr{ elem, mutable } {
            if types::get{ s = c.ty, id = types::prune{ s = c.ty, t = elem } } is array{ elem = ae } {
                let st = types::slice{ s = &c.ty, elem = ae, mutable }
                put_conv{ &c, e = base, conv = if addr == types::NO_TYPE { Conv::slice{ to = st } } else { Conv::addr_slice{ ptr = addr, to = st } } }
                bt = st
            }
        }
        let mut t = bt
        if not ok {
            t = types::ERROR
        } else {
            if not (types::get{ s = c.ty, id = bt } is slice | error) {
                errorf{ &c, at = expr_at{ e }, msg = @fmt("cannot slice {}", tstr{ c, t = bt }) }
                t = types::ERROR
            }
        }
        if lo != null { expect{ &c, e = lo.*, t = types::USIZE } }
        if hi != null { expect{ &c, e = hi.*, t = types::USIZE } }
        return t
    }

    // The type of e, pruned, with no expected type. (Pruning in the same call would copy the store
    // before checking e adds to it.)
    fn typed { mut c: Checker, e: syntax::Expr } -> Id {
        let t = expr{ &c, e, exp = types::NO_TYPE }
        return types::prune{ s = c.ty, t }
    }

    fn add_lit { mut c: Checker, e: syntax::Expr } {
        try! list::push{ list = &c.lits, item = e }
    }

    fn is_int { c: Checker, t: Id } -> bool {
        let x = types::prune{ s = c.ty, t }
        if x == types::ERROR { return true }
        match types::get{ s = c.ty, id = x } {
            var{ n } => { return types::var_of{ s = c.ty, n }.kind == types::VarKind::int }
            else => { return types::is_int{ s = c.ty, t = x } }
        }
    }

    fn is_num { c: Checker, t: Id } -> bool {
        let x = types::prune{ s = c.ty, t }
        if x == types::ERROR { return true }
        match types::get{ s = c.ty, id = x } {
            var{ n } => { return types::var_of{ s = c.ty, n }.kind != types::VarKind::any }
            else => { return types::is_int{ s = c.ty, t = x } or types::is_float{ s = c.ty, t = x } }
        }
    }

    // A string literal is a strlit where one is expected (also inside ?), a view of static bytes
    // where a []u8 is, the result of the conversion to T where a T is (PLAN.md 4.4), and a [N]u8
    // array value otherwise. What text or a C string is, std's conversions say. Where a ?T is
    // expected, a conversion to ?T comes before one to T.
    fn str_lit { mut c: Checker, e: syntax::Expr, bytes: []u8, exp: Id } -> Id {
        _ = map::remove{ m = &c.lit_convs, key = expr_key{ e } }
        let mut want = types::NO_TYPE
        if exp != types::NO_TYPE {
            want = types::prune{ s = c.ty, t = exp }
            if types::get{ s = c.ty, id = want } is opt{ elem } and conversion{ c, t = want, ns = c.sc.ns } == null { want = types::prune{ s = c.ty, t = elem } }
        }
        if want != types::NO_TYPE {
            match types::get{ s = c.ty, id = want } {
                strlit => { return want }
                slice{ elem, mutable } => {
                    if types::prune{ s = c.ty, t = elem } == types::U8 {
                        if mutable { error{ &c, at = expr_at{ e }, msg = "a string literal is read-only; it cannot be a []mut u8" } }
                        return types::slice{ s = &c.ty, elem = types::U8, mutable = false }
                    }
                }
                else => {}
            }
            let f = conversion{ c, t = want, ns = c.sc.ns }
            if f != null {
                // Two are an error here, where a literal would use them, and not before: two
                // libraries may each declare one, and a program may call either.
                let g = other_conversion{ c, t = want, f, ns = c.sc.ns }
                if g != null {
                    errorf{ &c, at = expr_at{ e }, msg = @fmt("string literal has two conversions to {}: `{}` and `{}`", tstr{ c, t = want }, str{ s = get_decl{ c, d = f }.qual }, str{ s = get_decl{ c, d = g }.qual }) }
                    return want
                }
                try! map::put{ m = &c.lit_convs, key = expr_key{ e }, value = f }
                try! list::push{ list = &c.lit_list, item = e }
                return want
            }
        }
        return types::array{ s = &c.ty, n = bytes.len, elem = types::U8 }
    }

    fn path_text { c: Checker, segs: []syntax::Seg } -> utf8::String {
        let mut b = message{ c }
        let mut i: usize = 0
        while i < segs.len {
            if i > 0 { try! utf8::push{ &b, s = "::" } }
            try! utf8::push{ &b, s = str{ s = segs[i].name.text } }
            i = i + 1
        }
        return utf8::view{ b }
    }

    fn path_expr { mut c: Checker, e: syntax::Expr, segs: []syntax::Seg, exp: Id } -> Id {
        let r = resolve_path{ &c, e, segs, call = false }
        if r == null { return types::ERROR }
        match r {
            local{ var } => {
                check_read{ &c, v = var, at = expr_at{ e } }
                return get_var{ c, v = var }.ty
            }
            func{ decl, targs } => {
                let ct = c_fn_value{ &c, d = decl, exp, at = expr_at{ e } }
                if ct != types::NO_TYPE { return ct }
                return fn_type{ &c, d = decl, targs }
            }
            constant{ decl } => { return get_decl{ c, d = decl }.ty }
            variant{ ty, index } => {
                let v = variants_of{ &c, t = ty }[index]
                if v.fields != null {
                    errorf{ &c, at = expr_at{ e }, msg = @fmt("variant `{}` has a payload; construct it with `{}{{ ... }}`", str{ s = v.name }, path_text{ c, segs }) }
                }
                same_decl{ &c, t = ty, exp }
                return ty
            }
            enumval{ ty } => { return ty }
            path => {
                errorf{ &c, at = expr_at{ e }, msg = @fmt("`{}` is a type, not a value", path_text{ c, segs }) }
                return types::ERROR
            }
            fault{ decl } => {
                if fault_fields{ c, d = decl } != null {
                    errorf{ &c, at = expr_at{ e }, msg = @fmt("error `{}` has a payload; construct it with `{}{{ ... }}`", str{ s = get_decl{ c, d = decl }.qual }, path_text{ c, segs }) }
                }
                return types::errs{ s = &c.ty, owner = NONE, one = decl }
            }
        }
    }

    // Where the expected type is the same generic struct or union as t, unifies them, so its
    // arguments flow into t's.
    fn same_decl { mut c: Checker, t: Id, exp: Id } {
        if exp == types::NO_TYPE { return }
        let pe = types::prune{ s = c.ty, t = exp }
        match types::get{ s = c.ty, id = t } {
            record{ decl } => {
                if types::get{ s = c.ty, id = pe } is record{ decl = d } and d == decl { _ = types::unify{ s = &c.ty, a = t, b = pe } }
            }
            sum{ decl } => {
                if types::get{ s = c.ty, id = pe } is sum{ decl = d } and d == decl { _ = types::unify{ s = &c.ty, a = t, b = pe } }
            }
            else => {}
        }
    }

    // A named extern fn where a C function pointer (or `?` one) is expected: its own address,
    // of the extern fn type of its declaration. A `#c::callback` fn there is a C function that
    // calls it, of the expected type if the fn accepts its fields (§5), or of its own fields in
    // their order if not, which the conversion then reports. NO_TYPE otherwise.
    fn c_fn_value { mut c: Checker, d: u32, exp: Id, at: source::Span } -> Id {
        let x = get_decl{ c, d }
        if (x.kind != Kind::external and not x.callback) or exp == types::NO_TYPE { return types::NO_TYPE }
        let mut want = types::prune{ s = c.ty, t = exp }
        if types::get{ s = c.ty, id = want } is opt{ elem } { want = types::prune{ s = c.ty, t = elem } }
        if types::get{ s = c.ty, id = want } is func{ external, fields } {
            if external and x.callback {
                let lf = loaded_field{ c, fields }
                if lf != null {
                    errorf{ &c, at, msg = @fmt("callback `{}` can't have type {}: its field `{}` is capability {}, which {}", str{ s = x.name.text }, tstr{ c, t = want }, str{ s = lf.name }, tstr{ c, t = lf.ty }, str{ s = NO_THUNK }) }
                    return types::ERROR
                }
                let own = types::func{ s = &c.ty, fields = x.fields, ret = x.ret, bound = false, external = false }
                if fn_accepts{ &c, g = own, s = want } { return want }
            }
            if external { return types::func{ s = &c.ty, fields = x.fields, ret = x.ret, bound = false, external = true } }
        }
        return types::NO_TYPE
    }

    fn fn_type { mut c: Checker, d: u32, targs: []Id } -> Id {
        let x = get_decl{ c, d }
        let fields = subst_fields{ &c, fields = x.fields, decl = d, args = targs }
        let ret = if targs.len == 0 { x.ret } else { types::subst{ s = &c.ty, t = x.ret, decl = d, args = targs } }
        return types::func{ s = &c.ty, fields, ret, bound = false, external = false }
    }

    fn targs_of { mut c: Checker, seg: syntax::Seg } -> ?[]Id {
        let targs = seg.targs
        if targs == null { return null }
        let mut xs = list::new(Id){ realloc = arena::alloc, heap = c.heap }
        let mut k: usize = 0
        while k < targs.len {
            push{ xs = &xs, n = rtype{ &c, te = targs[k], sc = c.sc, allow_bound = false } }
            k = k + 1
        }
        return list::items{ list = xs }
    }

    // What a path names (ctxi's resolve_path), or null after an error. In a call or literal
    // (`call`), a local that doesn't hold a function would be passed over (§10).
    fn resolve_path { mut c: Checker, e: syntax::Expr, segs: []syntax::Seg, call: bool } -> ?PathRef {
        if missing{ segs } { return null }
        let r = resolve_segs{ &c, segs, call }
        if r != null { put_ref{ &c, e, r } }
        return r
    }

    fn put_ref { mut c: Checker, e: syntax::Expr, r: PathRef } {
        try! map::put{ m = &c.refs, key = expr_key{ e }, value = r }
    }

    fn resolve_segs { mut c: Checker, segs: []syntax::Seg, call: bool } -> ?PathRef {
        let ns = c.sc.ns
        let s0 = segs[0]
        if segs.len == 1 {
            let v = local_named{ c, name = s0.name.text, call }
            if v != NONE {
                if s0.targs != null {
                    errorf{ &c, at = s0.name.span, msg = @fmt("`{}` is not generic", str{ s = s0.name.text }) }
                    return null
                }
                use{ &c, n = s0.name, r = Ref::local{ var = v } }
                return PathRef::local{ var = v }
            }
            let g = lookup_value{ c, ns, name = s0.name.text }
            if g != null {
                refer{ &c, n = s0.name, e = g }
                return value_ref{ &c, g, seg = s0 }
            }
            let p = lookup_path{ c, ns, name = s0.name.text }
            if p != null {
                refer{ &c, n = s0.name, e = p }
                return PathRef::path{ e = p, seg = s0 }
            }
            errorf{ &c, at = s0.name.span, msg = @fmt("unknown name `{}`", str{ s = s0.name.text }) }
            return null
        }
        let first = lookup_path{ c, ns, name = s0.name.text }
        if first == null {
            unknown{ &c, n = s0.name }
            return null
        }
        refer{ &c, n = s0.name, e = first }
        let mut d = first
        let mut i: usize = 1
        while i < segs.len {
            let s = segs[i]
            let prev = segs[i - 1]
            let last = i == segs.len - 1
            let mut inner = NONE
            if d is space{ ns = n } { inner = n }
            if inner != NONE {
                if prev.targs != null {
                    errorf{ &c, at = prev.name.span, msg = @fmt("namespace `{}` takes no type arguments", str{ s = prev.name.text }) }
                    return null
                }
                let sp = get_space{ c, ns = inner }
                if last {
                    let v = map::get{ m = sp.values, key = s.name.text }
                    if v != null {
                        refer{ &c, n = s.name, e = v }
                        return value_ref{ &c, g = v, seg = s }
                    }
                }
                let p = map::get{ m = sp.paths, key = s.name.text }
                if p == null {
                    errorf{ &c, at = s.name.span, msg = @fmt("`{}` not found in namespace `{}`", str{ s = s.name.text }, str{ s = prev.name.text }) }
                    return null
                }
                refer{ &c, n = s.name, e = p }
                d = p
                i = i + 1
                continue
            }
            let dt = decl_type{ &c, e = d, name = prev.name, args = targs_of{ &c, seg = prev }, at = prev.name.span, partial = true, allow_bound = false }
            let t = types::prune{ s = c.ty, t = dt }
            if t == types::ERROR { return null }
            if last {
                let mut names: [][]u8 = slice::empty([]u8){}
                let mut is_enum = false
                match types::get{ s = c.ty, id = t } {
                    sum => { names = variant_names{ &c, t } }
                    enumeration{ decl } => {
                        names = enum_names{ c, d = decl }
                        is_enum = true
                    }
                    else => {}
                }
                if names.len > 0 or is_enum or is_sum{ c, t } {
                    if s.targs != null {
                        error{ &c, at = s.name.span, msg = "a variant takes no type arguments" }
                        return null
                    }
                    let mut k: usize = 0
                    while k < names.len {
                        if slice::eq_bytes{ a = names[k], b = s.name.text } {
                            if is_enum { return PathRef::enumval{ ty = t, index = @as(u32, k) } }
                            return PathRef::variant{ ty = t, index = @as(u32, k) }
                        }
                        k = k + 1
                    }
                    errorf{ &c, at = s.name.span, msg = @fmt("{} has no variant `{}`", tstr{ c, t }, str{ s = s.name.text }) }
                    return null
                }
            }
            errorf{ &c, at = s.name.span, msg = @fmt("`{}` has no member `{}`", str{ s = prev.name.text }, str{ s = s.name.text }) }
            return null
        }
        return PathRef::path{ e = d, seg = segs[segs.len - 1] }
    }

    fn is_sum { c: Checker, t: Id } -> bool {
        return types::get{ s = c.ty, id = t } is sum
    }

    fn variant_names { mut c: Checker, t: Id } -> [][]u8 {
        let vs = variants_of{ &c, t }
        let mut out = list::new([]u8){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < vs.len {
            try! list::push{ list = &out, item = vs[i].name }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn enum_names { c: Checker, d: u32 } -> [][]u8 {
        let mut out = list::new([]u8){ realloc = arena::alloc, heap = c.heap }
        if get_decl{ c, d }.syn.k is enumeration{ variants } {
            let mut i: usize = 0
            while i < variants.len {
                try! list::push{ list = &out, item = variants[i].name.text }
                i = i + 1
            }
        }
        return list::items{ list = out }
    }

    // A function or const as a value: a function's type arguments not given are inferred.
    fn value_ref { mut c: Checker, g: Entry, seg: syntax::Seg } -> ?PathRef {
        match g {
            decl{ i } => {
                let x = get_decl{ c, d = i }
                if x.kind == Kind::constant {
                    if seg.targs != null {
                        errorf{ &c, at = seg.name.span, msg = @fmt("const `{}` takes no type arguments", str{ s = x.name.text }) }
                        return null
                    }
                    return PathRef::constant{ decl = i }
                }
                if x.kind == Kind::fault {
                    if seg.targs != null {
                        errorf{ &c, at = seg.name.span, msg = @fmt("error `{}` takes no type arguments", str{ s = x.name.text }) }
                        return null
                    }
                    return PathRef::fault{ decl = i }
                }
                let explicit = targs_of{ &c, seg }
                let mut all = list::new(Id){ realloc = arena::alloc, heap = c.heap }
                if explicit != null {
                    if explicit.len > x.tparams.len {
                        errorf{ &c, at = seg.name.span, msg = @fmt("`{}` expects at most {} type argument(s), got {}", str{ s = x.name.text }, x.tparams.len, explicit.len) }
                        return null
                    }
                    let mut k: usize = 0
                    while k < explicit.len {
                        push{ xs = &all, n = explicit[k] }
                        k = k + 1
                    }
                }
                while all.len < x.tparams.len {
                    let v = types::fresh{ s = &c.ty, kind = types::VarKind::any }
                    generic_var{ &c, v, param = x.tparams[all.len], owner = x.name, at = seg.name.span }
                    push{ xs = &all, n = v }
                }
                return PathRef::func{ decl = i, targs = list::items{ list = all } }
            }
            else => { return null }
        }
    }

    // ---- braces: calls, binds and literals

    // Braces after callee: a call, a bind or a literal. `..e` supplies fields only in a
    // capability's literal (§15). Each kind checks its spreads before its other items, and
    // those of braces that turned out to be none, or an error, are checked here.
    fn braced { mut c: Checker, e: syntax::Expr, callee: syntax::Expr, items: []syntax::Item, forward: bool, bind: bool, exp: Id } -> Id {
        let t = braced_as{ &c, e, callee, items, forward, bind, exp }
        if not map::has{ m = c.spreads, key = expr_key{ e } } { no_spread{ &c, e, items } }
        return t
    }

    fn braced_as { mut c: Checker, e: syntax::Expr, callee: syntax::Expr, items: []syntax::Item, forward: bool, bind: bool, exp: Id } -> Id {
        let mut ct = types::ERROR
        let mut name = str{ s = "function" }
        match callee.k {
            path{ segs } => {
                let r = resolve_path{ &c, e = callee, segs, call = true }
                if r == null { return types::ERROR }
                name = path_text{ c, segs }
                match r {
                    path{ e = d, seg } => { return struct_lit{ &c, e, d, seg, items, forward, bind, exp } }
                    variant{ ty, index } => { return variant_lit{ &c, e, ut = ty, vi = index, items, forward, bind, exp } }
                    enumval => {
                        errorf{ &c, at = expr_at{ e }, msg = @fmt("`{}` is an enum value; write it without braces", name) }
                        return types::ERROR
                    }
                    func{ decl, targs } => { ct = fn_type{ &c, d = decl, targs } }
                    fault{ decl } => { return fault_lit{ &c, e, decl, items, forward, bind } }
                    constant{ decl } => { ct = get_decl{ c, d = decl }.ty }
                    local{ var } => {
                        check_read{ &c, v = var, at = expr_at{ e = callee } }
                        ct = get_var{ c, v = var }.ty
                    }
                }
                set_type{ &c, e = callee, t = ct }
            }
            else => {
                let outer = c.calling
                c.calling = expr_key{ e = callee }
                ct = expr{ &c, e = callee, exp = types::NO_TYPE }
                c.calling = outer
                // Calling through a capability's field needs the capability mutable, as passing
                // it as a `mut` field does.
                if callee.k is field{ base } and cap_base{ c, e = base.* } { check_mutable{ &c, e = callee } }
            }
        }
        let ft = types::prune{ s = c.ty, t = ct }
        if ft == types::ERROR { return types::ERROR }
        if not (types::get{ s = c.ty, id = ft } is func) {
            errorf{ &c, at = expr_at{ e = callee }, msg = @fmt("`{}` has type {} and cannot be called", name, tstr{ c, t = ct }) }
            return types::ERROR
        }
        return call_args{ &c, e, ft, name, items, forward, bind }
    }

    fn set_literal { mut c: Checker, e: syntax::Expr, literal: bool } {
        try! map::put{ m = &c.literal, key = expr_key{ e }, value = literal }
    }

    // The fields supplied in braces must exist and be supplied once. `what` names the callee.
    fn supplied { mut c: Checker, items: []syntax::Item, fields: []types::Field, what: utf8::String } {
        let mut i: usize = 0
        while i < items.len {
            let it = items[i]
            if it.spread {
                // a capability literal's, which cap_lit checks
            } else if types::find_field{ fields, name = it.name.text } == null {
                errorf{ &c, at = it.span, msg = @fmt("{} has no field `{}`", what, str{ s = it.name.text }) }
            } else {
                let mut k: usize = 0
                while k < i {
                    if slice::eq_bytes{ a = items[k].name.text, b = it.name.text } {
                        errorf{ &c, at = it.span, msg = @fmt("`{}` is supplied more than once", str{ s = it.name.text }) }
                        break
                    }
                    k = k + 1
                }
            }
            i = i + 1
        }
    }

    // Each `..e` of braces e that aren't a capability's literal: an error.
    fn no_spread { mut c: Checker, e: syntax::Expr, items: []syntax::Item } {
        spreads_checked{ &c, e }
        let mut i: usize = 0
        while i < items.len {
            let it = items[i]
            if it.spread {
                _ = expr{ &c, e = it.value, exp = types::NO_TYPE }
                errorf{ &c, at = it.span, msg = @fmt("`..{}` is allowed only in a capability's literal", str{ s = source_text{ c, span = it.value.span } }) }
            }
            i = i + 1
        }
    }

    fn spreads_checked { mut c: Checker, e: syntax::Expr } {
        try! map::put{ m = &c.spreads, key = expr_key{ e }, value = true }
    }

    fn given { items: []syntax::Item, name: []u8 } -> bool {
        let mut i: usize = 0
        while i < items.len {
            if slice::eq_bytes{ a = items[i].name.text, b = name } { return true }
            i = i + 1
        }
        return false
    }

    // A call or a bind of function type ft (ctxi's call_args).
    fn call_args { mut c: Checker, e: syntax::Expr, ft: Id, name: utf8::String, items: []syntax::Item, forward: bool, bind: bool } -> Id {
        set_literal{ &c, e, literal = false }
        no_spread{ &c, e, items }
        let mut fields: []types::Field = slice::empty(types::Field){}
        let mut ret = types::VOID
        if types::get{ s = c.ty, id = ft } is func{ fields = fs, ret = r, external } {
            fields = fs
            ret = r
            if bind and external {
                error{ &c, at = expr_at{ e }, msg = "a C function pointer can't be bound with `_`: call it with every field" }
                return types::ERROR
            }
        }
        let mut b = message{ c }
        try! @fmt(&b, "`{}`", name)
        supplied{ &c, items, fields, what = utf8::view{ b } }
        let mut i: usize = 0
        while i < items.len {
            let it = items[i]
            let f = types::find_field{ fields, name = it.name.text }
            if f != null {
                if f.mutable {
                    let want = types::ptr{ s = &c.ty, elem = f.ty, mutable = true }
                    match it.value.k {
                        addr{ e = x } => {
                            // `&p`: p must be a mutable place.
                            let at = expr{ &c, e = it.value, exp = types::NO_TYPE }
                            check_mutable{ &c, e = x.* }
                            mut_arg{ &c, e = it.value, at, t = want }
                        }
                        else => { mut_arg{ &c, e = it.value, at = expr{ &c, e = it.value, exp = want }, t = want } }
                    }
                } else {
                    expect{ &c, e = it.value, t = f.ty }
                }
            }
            i = i + 1
        }
        let mut missing = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
        let mut fwd = list::new(Forward){ realloc = arena::alloc, heap = c.heap }
        i = 0
        while i < fields.len {
            let f = fields[i]
            if not given{ items, name = f.name } {
                if forward {
                    let v = lookup_local{ c, name = f.name, callable = false }
                    if v == NONE {
                        errorf{ &c, at = expr_at{ e }, msg = @fmt("`..` cannot supply `{}`: no local or context field named `{}`", str{ s = f.name }, str{ s = f.name }) }
                    } else {
                        try! list::push{ list = &fwd, item = forwarded{ &c, f, v, at = expr_at{ e } } }
                    }
                } else {
                    add_field{ xs = &missing, f }
                }
            }
            i = i + 1
        }
        if fwd.len > 0 {
            try! map::put{ m = &c.forwards, key = expr_key{ e }, value = list::items{ list = fwd } }
        }
        let gone = list::items{ list = missing }
        if gone.len > 0 and not bind and not forward {
            let mut m = message{ c }
            try! @fmt(&m, "call to `{}` is missing ", name)
            try! names{ fields = gone, b = &m }
            error{ &c, at = expr_at{ e }, msg = utf8::view{ b = m } }
        }
        let refs = check_exclusive{ &c, e, items, fields }
        if bind {
            try! map::put{ m = &c.holds, key = expr_key{ e }, value = refs }
            return types::func{ s = &c.ty, fields = gone, ret, bound = true, external = false }
        }
        return ret
    }

    // A `mut` field's argument, of type at where t is wanted: the types match, or at points to a
    // capability that includes the one t points to (§15).
    fn mut_arg { mut c: Checker, e: syntax::Expr, at: Id, t: Id } {
        if not includes_cap_ptr{ c, a = at, b = t } { coerce_node{ &c, e, at, t } }
    }

    // What `..` supplies for field f: local v, or `&v` if f is `mut` (§3, rule 7).
    fn forwarded { mut c: Checker, f: types::Field, v: u32, at: source::Span } -> Forward {
        check_read{ &c, v, at }
        let x = get_var{ c, v }
        if f.mutable {
            let arg = types::ptr{ s = &c.ty, elem = x.ty, mutable = x.mutable }
            if not x.mutable {
                let why: utf8::String = if x.indirect { ": it is bound through a read-only pointer" } else { "" }
                errorf{ &c, at, msg = @fmt("`{}` is not a mutable place{}", str{ s = x.name }, why) }
            }
            let want = types::ptr{ s = &c.ty, elem = f.ty, mutable = true }
            let how = if includes_cap_ptr{ c, a = arg, b = want } { Coercion::same } else { convert{ &c, a = arg, t = want, pos = at } }
            return Forward{ name = f.name, var = v, mutable = true, ty = x.ty, arg, conv = conv_of{ how, t = want } }
        }
        let to = inner_target{ c, a = x.ty, t = f.ty }
        let how = convert{ &c, a = x.ty, t = f.ty, pos = at }
        return Forward{ name = f.name, var = v, mutable = false, ty = x.ty, arg = x.ty, conv = conv_of{ how, t = to } }
    }

    // "`a`, `b`"
    fn names { fields: []types::Field, mut b: utf8::Builder(Heap) } -> ! {
        let mut i: usize = 0
        while i < fields.len {
            if i > 0 { try utf8::push{ &b, s = ", " } }
            try @fmt(&b, "`{}`", str{ s = fields[i].name })
            i = i + 1
        }
    }

    fn struct_lit { mut c: Checker, e: syntax::Expr, d: Entry, seg: syntax::Seg, items: []syntax::Item, forward: bool, bind: bool, exp: Id } -> Id {
        let dt = decl_type{ &c, e = d, name = seg.name, args = targs_of{ &c, seg }, at = seg.name.span, partial = true, allow_bound = false }
        let t = types::prune{ s = c.ty, t = dt }
        if t == types::ERROR { return types::ERROR }
        let mut decl = NONE
        match types::get{ s = c.ty, id = t } {
            record{ decl = x } => { decl = x }
            cap{ decl = x } => {
                if not loaded_cap{ c, t } {
                    errorf{ &c, at = seg.name.span, msg = @fmt("`{}` is a capability: only `main` receives one, from the runtime", str{ s = seg.name.text }) }
                    return types::ERROR
                }
                return cap_lit{ &c, e, t, decl = x, seg, items, forward, bind, exp }
            }
            else => {}
        }
        if decl == NONE {
            errorf{ &c, at = seg.name.span, msg = @fmt("`{}` is not a struct", str{ s = seg.name.text }) }
            return types::ERROR
        }
        same_decl{ &c, t, exp }
        no_spread{ &c, e, items }
        let mut b = message{ c }
        if is_untagged{ c, d = decl } {
            try! @fmt(&b, "extern union `{}`", str{ s = get_decl{ c, d = decl }.name.text })
            return untagged_lit{ &c, e, t, fields = struct_fields{ &c, t }, what = utf8::view{ b }, items, forward, bind }
        }
        try! @fmt(&b, "struct `{}`", str{ s = get_decl{ c, d = decl }.name.text })
        return fields_lit{ &c, e, t, fields = struct_fields{ &c, t }, what = utf8::view{ b }, items, spread = slice::empty(types::Field){}, forward, bind }
    }

    // A capability with fields (§15): only a function of the namespace that declares it, which
    // isn't pure, can make one, so code that holds no capability can't. Effects reach a function
    // through a capability or a bound function, which may hold one (§1.3).
    fn cap_lit { mut c: Checker, e: syntax::Expr, t: Id, decl: u32, seg: syntax::Seg, items: []syntax::Item, forward: bool, bind: bool, exp: Id } -> Id {
        spreads_checked{ &c, e }
        let x = get_decl{ c, d = decl }
        let owner = c.sc.owner
        let in_fn = owner != NONE and get_decl{ c, d = owner }.kind == Kind::func
        if not in_fn or get_decl{ c, d = owner }.ns != x.ns {
            let qual = get_space{ c, ns = x.ns }.qual
            let mut b = message{ c }
            if qual.len == 0 {
                try! @fmt(&b, "capability `{}` can only be made by a function at the top level, which declares it", str{ s = seg.name.text })
            } else {
                try! @fmt(&b, "capability `{}` can only be made by a function of namespace `{}`, which declares it", str{ s = seg.name.text }, str{ s = qual })
            }
            error{ &c, at = seg.name.span, msg = utf8::view{ b } }
            return types::ERROR
        }
        let fs = get_decl{ c, d = owner }.fields
        let mut holds = false
        let mut i: usize = 0
        while i < fs.len {
            match types::get{ s = c.ty, id = types::prune{ s = c.ty, t = fs[i].ty } } {
                cap => { holds = true }
                func{ bound } => { if bound { holds = true } }
                else => {}
            }
            i = i + 1
        }
        if not holds {
            errorf{ &c, at = seg.name.span, msg = @fmt("capability `{}` can only be made by a function that holds a capability or a bound function: `{}` takes neither", str{ s = seg.name.text }, str{ s = get_decl{ c, d = owner }.name.text }) }
            return types::ERROR
        }
        same_decl{ &c, t, exp }
        // `..e` supplies the fields of a capability t includes, each once.
        let mut spread = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
        i = 0
        while i < items.len {
            let it = items[i]
            if it.spread {
                let st = expr{ &c, e = it.value, exp = types::NO_TYPE }
                if includes_cap{ c, a = t, b = st } {
                    let sf = cap_fields{ c, t = st }
                    let mut k: usize = 0
                    while k < sf.len {
                        if given{ items, name = sf[k].name } or types::find_field{ fields = list::items{ list = spread }, name = sf[k].name } != null {
                            errorf{ &c, at = it.span, msg = @fmt("`{}` is supplied more than once", str{ s = sf[k].name }) }
                            break
                        }
                        k = k + 1
                    }
                    k = 0
                    while k < sf.len {
                        add_field{ xs = &spread, f = sf[k] }
                        k = k + 1
                    }
                } else if types::prune{ s = c.ty, t = st } != types::ERROR {
                    errorf{ &c, at = expr_at{ e = it.value }, msg = @fmt("`..{}` has type {}, which capability `{}` doesn't include", str{ s = source_text{ c, span = it.value.span } }, tstr{ c, t = st }, str{ s = x.name.text }) }
                }
            }
            i = i + 1
        }
        let mut b = message{ c }
        try! @fmt(&b, "capability `{}`", str{ s = x.name.text })
        return fields_lit{ &c, e, t, fields = x.fields, what = utf8::view{ b }, items, spread = list::items{ list = spread }, forward, bind }
    }

    // An extern union's literal (§12, Untagged unions) sets exactly one field; the rest of its
    // bytes are zero.
    fn untagged_lit { mut c: Checker, e: syntax::Expr, t: Id, fields: []types::Field, what: utf8::String, items: []syntax::Item, forward: bool, bind: bool } -> Id {
        set_literal{ &c, e, literal = true }
        if forward or bind {
            let word: utf8::String = if forward { ".." } else { "_" }
            errorf{ &c, at = expr_at{ e }, msg = @fmt("`{}` is not allowed in a literal", word) }
        }
        supplied{ &c, items, fields, what }
        if items.len != 1 {
            errorf{ &c, at = expr_at{ e }, msg = @fmt("{} literal must set exactly one field", what) }
        }
        let mut i: usize = 0
        while i < items.len {
            let f = types::find_field{ fields, name = items[i].name.text }
            if f != null { expect{ &c, e = items[i].value, t = f.ty } }
            i = i + 1
        }
        return t
    }

    // An error with its payload, `fs::os{ code = c }`: an error of its own alone.
    fn fault_lit { mut c: Checker, e: syntax::Expr, decl: u32, items: []syntax::Item, forward: bool, bind: bool } -> Id {
        let q = str{ s = get_decl{ c, d = decl }.qual }
        let fields = fault_fields{ c, d = decl } ifnull {
            errorf{ &c, at = expr_at{ e }, msg = @fmt("error `{}` has no payload; write it without braces", q) }
            return types::ERROR
        }
        no_spread{ &c, e, items }
        let t = types::errs{ s = &c.ty, owner = NONE, one = decl }
        let mut b = message{ c }
        try! @fmt(&b, "error `{}`", q)
        return fields_lit{ &c, e, t, fields, what = utf8::view{ b }, items, spread = slice::empty(types::Field){}, forward, bind }
    }

    fn variant_lit { mut c: Checker, e: syntax::Expr, ut: Id, vi: u32, items: []syntax::Item, forward: bool, bind: bool, exp: Id } -> Id {
        let v = variants_of{ &c, t = ut }[vi]
        let fields = v.fields
        if fields == null {
            errorf{ &c, at = expr_at{ e }, msg = @fmt("variant `{}` has no payload; write it without braces", str{ s = v.name }) }
            return types::ERROR
        }
        same_decl{ &c, t = ut, exp }
        no_spread{ &c, e, items }
        let mut b = message{ c }
        try! @fmt(&b, "variant `{}`", str{ s = v.name })
        return fields_lit{ &c, e, t = ut, fields, what = utf8::view{ b }, items, spread = slice::empty(types::Field){}, forward, bind }
    }

    // A literal's items, and the fields its spreads supply (a capability's, §15).
    fn fields_lit { mut c: Checker, e: syntax::Expr, t: Id, fields: []types::Field, what: utf8::String, items: []syntax::Item, spread: []types::Field, forward: bool, bind: bool } -> Id {
        set_literal{ &c, e, literal = true }
        if forward or bind {
            let word: utf8::String = if forward { ".." } else { "_" }
            errorf{ &c, at = expr_at{ e }, msg = @fmt("`{}` is not allowed in a literal", word) }
        }
        supplied{ &c, items, fields, what }
        let mut missing = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < fields.len {
            if not given{ items, name = fields[i].name } and types::find_field{ fields = spread, name = fields[i].name } == null {
                add_field{ xs = &missing, f = fields[i] }
            }
            i = i + 1
        }
        let gone = list::items{ list = missing }
        if gone.len > 0 {
            let mut b = message{ c }
            try! @fmt(&b, "{} is missing ", what)
            try! names{ fields = gone, &b }
            error{ &c, at = expr_at{ e }, msg = utf8::view{ b } }
        }
        i = 0
        while i < items.len {
            let f = types::find_field{ fields, name = items[i].name.text }
            if f != null { expect{ &c, e = items[i].value, t = f.ty } }
            i = i + 1
        }
        return t
    }

    // ---- operators

    fn binary { mut c: Checker, e: syntax::Expr, op: tok::Kind, a: syntax::Expr, b: syntax::Expr, exp: Id } -> Id {
        let at = expr_at{ e }
        let opname = str{ s = parser::kind_text{ k = op } }
        if op == tok::Kind::kw_and or op == tok::Kind::kw_or {
            expect{ &c, e = a, t = types::BOOL }
            // The right side runs only if the left is true (`and`) or false (`or`).
            open{ &c }
            let f = facts{ c, e = a }
            assume{ &c, facts = if op == tok::Kind::kw_and { f.yes } else { f.no }, after_if = false }
            expect{ &c, e = b, t = types::BOOL }
            close{ &c }
            return types::BOOL
        }
        if op == tok::Kind::eq or op == tok::Kind::ne {
            let ln = is_null{ e = a }
            let rn = is_null{ e = b }
            if ln or rn {
                if ln and rn {
                    error{ &c, at, msg = "cannot compare null with null" }
                    return types::BOOL
                }
                let x = if ln { b } else { a }
                let xt = typed{ &c, e = x }
                if xt != types::ERROR and not (types::get{ s = c.ty, id = xt } is opt) {
                    errorf{ &c, at, msg = @fmt("only an optional can be compared with null, got {}", tstr{ c, t = xt }) }
                }
                set_type{ &c, e = if ln { a } else { b }, t = xt }
                return types::BOOL
            }
            let lt = expr{ &c, e = a, exp = types::NO_TYPE }
            let rt = expr{ &c, e = b, exp = lt }
            let t = operand_type{ &c, lt, rt, a, b }
            if t == types::NO_TYPE {
                cannot_compare{ &c, lt, rt, at }
                return types::BOOL
            }
            let eq = is_num{ c, t } or t == types::BOOL or types::get{ s = c.ty, id = t } is ptr | enumeration
            if not eq {
                errorf{ &c, at, msg = @fmt("{} has no built-in equality", tstr{ c, t }) }
            }
            return types::BOOL
        }
        if op == tok::Kind::lt or op == tok::Kind::le or op == tok::Kind::gt or op == tok::Kind::ge {
            let lt = expr{ &c, e = a, exp = types::NO_TYPE }
            let rt = expr{ &c, e = b, exp = lt }
            let t = operand_type{ &c, lt, rt, a, b }
            if t == types::NO_TYPE {
                cannot_compare{ &c, lt, rt, at }
            } else if not is_num{ c, t } {
                errorf{ &c, at, msg = @fmt("`{}` needs numbers, got {}", opname, tstr{ c, t }) }
            }
            return types::BOOL
        }
        if op == tok::Kind::shl or op == tok::Kind::shr {
            let t = expr{ &c, e = a, exp }
            if not is_int{ c, t } {
                errorf{ &c, at, msg = @fmt("`{}` needs an integer to shift, got {}", opname, tstr{ c, t }) }
            }
            let ct = expr{ &c, e = b, exp = types::NO_TYPE }
            if not is_int{ c, t = ct } {
                errorf{ &c, at, msg = @fmt("a shift count must be an integer, got {}", tstr{ c, t = ct }) }
            }
            return t
        }
        let lt = expr{ &c, e = a, exp }
        let plt = types::prune{ s = c.ty, t = lt }
        if types::get{ s = c.ty, id = plt } is ptr {
            if op != tok::Kind::plus {
                errorf{ &c, at, msg = @fmt("`{}` is not defined on pointers", opname) }
            }
            expect{ &c, e = b, t = types::USIZE }
            return plt
        }
        let rt = expr{ &c, e = b, exp = lt }
        let t = operand_type{ &c, lt, rt, a, b }
        if t == types::NO_TYPE {
            errorf{ &c, at, msg = @fmt("operands of `{}` have incompatible types: {} and {}; convert one with @as", opname, tstr{ c, t = lt }, tstr{ c, t = rt }) }
            return types::ERROR
        }
        if op == tok::Kind::amp or op == tok::Kind::pipe or op == tok::Kind::caret {
            if not is_int{ c, t } {
                errorf{ &c, at, msg = @fmt("`{}` needs integers, got {}", opname, tstr{ c, t }) }
            }
        } else if not is_num{ c, t } {
            errorf{ &c, at, msg = @fmt("`{}` needs numbers, got {}", opname, tstr{ c, t }) }
        }
        return t
    }

    fn is_null { e: syntax::Expr } -> bool {
        return e.k is nil
    }

    fn cannot_compare { mut c: Checker, lt: Id, rt: Id, at: source::Span } {
        errorf{ &c, at, msg = @fmt("cannot compare {} with {}", tstr{ c, t = lt }, tstr{ c, t = rt }) }
    }

    // The common type of two operands: equal types, or the one the other widens to, or NO_TYPE.
    // A literal whose type the other operand fixes remembers that operand, for finish.
    fn operand_type { mut c: Checker, lt: Id, rt: Id, a: syntax::Expr, b: syntax::Expr } -> Id {
        let pl = types::prune{ s = c.ty, t = lt }
        let pr = types::prune{ s = c.ty, t = rt }
        let vl = types::unbound{ s = c.ty, t = pl }
        let vr = types::unbound{ s = c.ty, t = pr }
        if vl != null and types::prim_of{ s = c.ty, t = pr } != null { fix{ &c, n = vl, by = b } }
        if vr != null and types::prim_of{ s = c.ty, t = pl } != null { fix{ &c, n = vr, by = a } }
        if types::unify{ s = &c.ty, a = lt, b = rt } { return types::prune{ s = c.ty, t = lt } }
        if types::widens{ s = &c.ty, a = rt, b = lt } { return types::prune{ s = c.ty, t = lt } }
        if types::widens{ s = &c.ty, a = lt, b = rt } { return types::prune{ s = c.ty, t = rt } }
        return types::NO_TYPE
    }

    fn fix { mut c: Checker, n: u32, by: syntax::Expr } {
        let mut path: []u8 = ""
        if by.k is path{ segs } { path = path_text{ c, segs }.bytes }
        list::at{ list = c.ty.vars, i = n }.fixed = types::Fixed{ at = expr_at{ e = by }, path }
    }

    fn array_lit { mut c: Checker, e: syntax::Expr, elems: []syntax::Expr, exp: Id } -> Id {
        let mut et = types::NO_TYPE
        if exp != types::NO_TYPE and types::get{ s = c.ty, id = types::prune{ s = c.ty, t = exp } } is array{ elem } { et = elem }
        if elems.len == 0 {
            if et == types::NO_TYPE {
                error{ &c, at = expr_at{ e }, msg = "an empty array literal needs a known type" }
                return types::ERROR
            }
            return types::array{ s = &c.ty, n = 0, elem = et }
        }
        let mut i: usize = 0
        while i < elems.len {
            if et == types::NO_TYPE { et = value_type{ &c, e = elems[i] } } else { expect{ &c, e = elems[i], t = et } }
            i = i + 1
        }
        return types::array{ s = &c.ty, n = elems.len, elem = et }
    }

    fn repeat { mut c: Checker, elem: syntax::Expr, count: syntax::Expr, exp: Id } -> Id {
        let n = const_int{ &c, e = count, ns = c.sc.ns, what = "an array length" }
        let mut et = types::NO_TYPE
        if exp != types::NO_TYPE and types::get{ s = c.ty, id = types::prune{ s = c.ty, t = exp } } is array{ elem = x } { et = x }
        if et != types::NO_TYPE { expect{ &c, e = elem, t = et } } else { et = value_type{ &c, e = elem } }
        if n == null or n < 0 { return types::ERROR }
        return types::array{ s = &c.ty, n = @as(u64, n), elem = et }
    }

    // ---- postfix

    fn field_expr { mut c: Checker, e: syntax::Expr, base: syntax::Expr, name: syntax::Name } -> Id {
        let bt = typed{ &c, e = base }
        if bt == types::ERROR or name.text.len == 0 { return types::ERROR }
        let is_len = slice::eq_bytes{ a = name.text, b = "len" }
        match types::get{ s = c.ty, id = bt } {
            ptr{ elem } => {
                let inner = types::prune{ s = c.ty, t = elem }
                match types::get{ s = c.ty, id = inner } {
                    record => {
                        put_access{ &c, e, a = Access::pfield }
                        return field_type{ &c, st = inner, e, name }
                    }
                    cap => {
                        let v = cap_var{ c, t = inner, name = name.text }
                        if v != null { return read_cvar{ &c, e, v } }
                        if loaded_cap{ c, t = inner } {
                            put_access{ &c, e, a = Access::pfield }
                            return cap_field{ &c, st = inner, e, name }
                        }
                    }
                    array => {
                        if is_len {
                            put_access{ &c, e, a = Access::plen }
                            return types::USIZE
                        }
                    }
                    else => {}
                }
            }
            cap => {
                let v = cap_var{ c, t = bt, name = name.text }
                if v != null { return read_cvar{ &c, e, v } }
                if loaded_cap{ c, t = bt } {
                    put_access{ &c, e, a = Access::field }
                    return cap_field{ &c, st = bt, e, name }
                }
            }
            record => {
                put_access{ &c, e, a = Access::field }
                let ft = field_type{ &c, st = bt, e, name }
                if ft == types::ERROR { return ft }
                // A narrowed field path (§8): the expression is the ?T field's payload.
                let nt = narrowed_path{ c, e }
                if nt != types::NO_TYPE {
                    try! map::put{ m = &c.narrowed, key = expr_key{ e }, value = ft }
                    return nt
                }
                return ft
            }
            array => {
                if is_len {
                    put_access{ &c, e, a = Access::len }
                    return types::USIZE
                }
            }
            slice{ elem, mutable } => {
                if is_len {
                    put_access{ &c, e, a = Access::slen }
                    return types::USIZE
                }
                if slice::eq_bytes{ a = name.text, b = "ptr" } {
                    put_access{ &c, e, a = Access::sptr }
                    return types::ptr{ s = &c.ty, elem, mutable }
                }
            }
            // A literal's bytes, which like a slice's `.ptr` aren't a place: nothing replaces them.
            strlit => {
                if slice::eq_bytes{ a = name.text, b = "bytes" } {
                    put_access{ &c, e, a = Access::lit }
                    return types::slice{ s = &c.ty, elem = types::U8, mutable = false }
                }
            }
            var => {
                errorf{ &c, at = expr_at{ e }, msg = @fmt("the type of this expression must be known before `.{}`", str{ s = name.text }) }
                return types::ERROR
            }
            else => {}
        }
        return no_field{ &c, t = bt, e, name }
    }

    fn field_type { mut c: Checker, st: Id, e: syntax::Expr, name: syntax::Name } -> Id {
        let f = types::find_field{ fields = struct_fields{ &c, t = st }, name = name.text }
        if f != null { return f.ty }
        return no_field{ &c, t = st, e, name }
    }

    // A capability's field (§15) can only be called: read as a value, it could reach code whose
    // signature doesn't name the capability.
    fn cap_field { mut c: Checker, st: Id, e: syntax::Expr, name: syntax::Name } -> Id {
        let ft = field_type{ &c, st, e, name }
        if ft != types::ERROR and c.calling != expr_key{ e } {
            errorf{ &c, at = expr_at{ e }, msg = @fmt("`{}` is a field of capability {}: it can only be called, as `{}{{ ... }}`", str{ s = name.text }, tstr{ c, t = st }, str{ s = source_text{ c, span = e.span } }) }
        }
        return ft
    }

    // Capability t's C variable `name` (§15), its own or one it includes, or null.
    fn cap_var { c: Checker, t: Id, name: []u8 } -> ?CVar {
        if types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is cap{ decl } {
            let vs = get_decl{ c, d = decl }.vars
            let mut i: usize = 0
            while i < vs.len {
                if slice::eq_bytes{ a = vs[i].name, b = name } { return vs[i] }
                i = i + 1
            }
        }
        return null
    }

    // A read of a capability's C variable v (§15). Only a function of the namespace that
    // declares v's capability may read it, so that namespace wraps it for everyone else. It is
    // the variable's value, not a place: neither assigned nor addressed.
    fn read_cvar { mut c: Checker, e: syntax::Expr, v: CVar } -> Id {
        put_access{ &c, e, a = Access::cvar }
        let x = get_decl{ c, d = v.owner }
        let f = c.fn_decl
        if f == NONE or get_decl{ c, d = f }.kind != Kind::func or get_decl{ c, d = f }.ns != x.ns {
            let qual = get_space{ c, ns = x.ns }.qual
            let mut b = message{ c }
            if qual.len == 0 {
                try! @fmt(&b, "`{}` is a C variable of capability `{}`: only a function at the top level, which declares it, can read it", str{ s = v.name }, str{ s = x.name.text })
            } else {
                try! @fmt(&b, "`{}` is a C variable of capability `{}`: only a function of namespace `{}`, which declares it, can read it", str{ s = v.name }, str{ s = x.name.text }, str{ s = qual })
            }
            error{ &c, at = expr_at{ e }, msg = utf8::view{ b } }
        }
        return v.ty
    }

    // Whether e is a capability with fields, or a pointer to one.
    fn cap_base { c: Checker, e: syntax::Expr } -> bool {
        let t = types::prune{ s = c.ty, t = type_of_expr{ c, e } }
        match types::get{ s = c.ty, id = t } {
            ptr{ elem } => { return loaded_cap{ c, t = elem } }
            else => { return loaded_cap{ c, t } }
        }
    }

    fn no_field { mut c: Checker, t: Id, e: syntax::Expr, name: syntax::Name } -> Id {
        errorf{ &c, at = expr_at{ e }, msg = @fmt("{} has no field `{}`", tstr{ c, t }, str{ s = name.text }) }
        return types::ERROR
    }

    // ---- builtins (the parser has checked each name and its number of arguments)

    // `_` alone: as the type argument of @as, @trunc or @cast, the type expected (§13).
    fn is_infer { segs: []syntax::Seg } -> bool {
        return segs.len == 1 and segs[0].targs == null and slice::eq_bytes{ a = segs[0].name.text, b = "_" }
    }

    // The type `_` stands for in @as, @trunc or @cast: the type expected, or its payload if that
    // is optional, as for a string literal (§11 Literals).
    fn expected_targ { mut c: Checker, name: []u8, exp: Id, at: source::Span } -> Id {
        if exp != types::NO_TYPE {
            let mut want = types::prune{ s = c.ty, t = exp }
            if types::get{ s = c.ty, id = want } is opt{ elem } { want = types::prune{ s = c.ty, t = elem } }
            match types::get{ s = c.ty, id = want } {
                var => {}
                error => { return types::ERROR }
                else => { return want }
            }
        }
        errorf{ &c, at, msg = @fmt("@{}(_, ...) takes the type expected here, and nothing here expects one: write the type", str{ s = name }) }
        return types::ERROR
    }

    fn builtin { mut c: Checker, e: syntax::Expr, name: syntax::Name, targ: ?*syntax::TypeExpr, args: []syntax::Expr, exp: Id } -> Id {
        let at = expr_at{ e }
        let n = name.text
        let typed_arg = slice::eq_bytes{ a = n, b = "as" } or slice::eq_bytes{ a = n, b = "trunc" } or slice::eq_bytes{ a = n, b = "cast" }
        let mut tt = types::NO_TYPE
        if targ != null {
            let te = targ.*
            let infer = match te.k { path{ segs } => { is_infer{ segs } } else => { false } }
            if infer and typed_arg {
                tt = expected_targ{ &c, name = n, exp, at = te.span }
                try! map::put{ m = &c.type_of, key = key{ file = te.span.file, id = te.id }, value = tt }
            } else {
                tt = rtype{ &c, te, sc = c.sc, allow_bound = false }
            }
        }
        if slice::eq_bytes{ a = n, b = "size_of" } or slice::eq_bytes{ a = n, b = "align_of" } { return types::USIZE }
        // After a syntax error, a builtin may lack arguments the parser has reported missing.
        let need: usize = if typed_arg or slice::eq_bytes{ a = n, b = "addr" } { 1 } else if slice::eq_bytes{ a = n, b = "panic" } or slice::eq_bytes{ a = n, b = "fmt" } { 0 } else { 2 }
        if args.len < need or (typed_arg and targ == null) { return types::ERROR }
        if slice::eq_bytes{ a = n, b = "panic" } {
            if args.len > 0 {
                if not (args[0].k is str) { error{ &c, at = expr_at{ e = args[0] }, msg = "@panic takes a string literal" } }
                _ = expr{ &c, e = args[0], exp = types::NO_TYPE }
            }
            return types::VOID
        }
        if slice::eq_bytes{ a = n, b = "fmt" } { return fmt_builtin{ &c, e, args, exp } }
        if slice::eq_bytes{ a = n, b = "as" } {
            let x = args[0]
            let src = typed{ &c, e = x }
            if tt == types::ERROR or src == types::ERROR { return tt }
            if is_enum{ c, t = tt } {
                if not is_int{ c, t = src } {
                    errorf{ &c, at = expr_at{ e = x }, msg = @fmt("@as to an enum takes an integer, got {}", tstr{ c, t = src }) }
                }
                return tt
            }
            if is_enum{ c, t = src } {
                if not is_int{ c, t = tt } {
                    errorf{ &c, at, msg = @fmt("@as converts an enum to an integer type, not {}", tstr{ c, t = tt }) }
                }
                return tt
            }
            if not is_num{ c, t = tt } {
                errorf{ &c, at, msg = @fmt("@as needs a numeric target type, got {}", tstr{ c, t = tt }) }
            } else if not is_num{ c, t = src } {
                error{ &c, at = expr_at{ e = x }, msg = "@as converts numbers only" }
            }
            return tt
        }
        if slice::eq_bytes{ a = n, b = "trunc" } {
            if not is_int{ c, t = tt } {
                errorf{ &c, at, msg = @fmt("@trunc needs an integer target type, got {}", tstr{ c, t = tt }) }
            }
            let at0 = expr{ &c, e = args[0], exp = types::NO_TYPE }
            if not is_int{ c, t = at0 } {
                error{ &c, at = expr_at{ e = args[0] }, msg = "@trunc converts integers only" }
            }
            return tt
        }
        if slice::eq_bytes{ a = n, b = "cast" } {
            // Pointers and C function pointers (extern fn types) cast to each other.
            let target = types::get{ s = c.ty, id = types::prune{ s = c.ty, t = tt } }
            let mut to_mut = false
            let mut ok = tt == types::ERROR
            match target {
                ptr{ mutable } => { ok = true; to_mut = mutable }
                func{ external } => { ok = external }
                else => {}
            }
            if not ok {
                errorf{ &c, at, msg = @fmt("@cast needs a pointer or extern fn target type, got {}", tstr{ c, t = tt }) }
            }
            let src = typed{ &c, e = args[0] }
            if src != types::ERROR {
                match types::get{ s = c.ty, id = src } {
                    ptr{ mutable } => {
                        if ok and to_mut and not mutable {
                            errorf{ &c, at = expr_at{ e = args[0] }, msg = @fmt("@cast cannot make {} writable", tstr{ c, t = src }) }
                        }
                    }
                    func{ external } => {
                        if not external { error{ &c, at = expr_at{ e = args[0] }, msg = "@cast can't take a ctxlang function: only a pointer or an extern fn value" } }
                    }
                    opt => {
                        let msg: utf8::String = if nullable_ptr{ c, t = src } { "@cast needs a value that isn't null: check the optional first" } else { "@cast needs a pointer or extern fn argument" }
                        error{ &c, at = expr_at{ e = args[0] }, msg }
                    }
                    else => { error{ &c, at = expr_at{ e = args[0] }, msg = "@cast needs a pointer or extern fn argument" } }
                }
            }
            return tt
        }
        if slice::eq_bytes{ a = n, b = "slice" } {
            let pt = typed{ &c, e = args[0] }
            let mut out = types::ERROR
            match types::get{ s = c.ty, id = pt } {
                ptr{ elem, mutable } => { out = types::slice{ s = &c.ty, elem, mutable } }
                error => {}
                else => {
                    errorf{ &c, at = expr_at{ e = args[0] }, msg = @fmt("@slice needs a pointer, got {}", tstr{ c, t = pt }) }
                }
            }
            expect{ &c, e = args[1], t = types::USIZE }
            return out
        }
        if slice::eq_bytes{ a = n, b = "addr" } {
            let pt = typed{ &c, e = args[0] }
            if not (types::get{ s = c.ty, id = pt } is ptr | error) { error{ &c, at = expr_at{ e = args[0] }, msg = "@addr needs a pointer argument" } }
            return types::USIZE
        }
        // @wrap_add, @wrap_sub, @wrap_mul
        let lt = expr{ &c, e = args[0], exp }
        let rt = expr{ &c, e = args[1], exp = lt }
        if not types::unify{ s = &c.ty, a = lt, b = rt } or not is_int{ c, t = lt } {
            errorf{ &c, at, msg = @fmt("@{} needs two integers of the same type", str{ s = n }) }
        }
        return lt
    }

    fn is_enum { c: Checker, t: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is enumeration
    }

    // ---- @fmt(b, "format", args...) (§13, Formatting): writes into a sink

    // An instance of a `#write` fn, or decl NONE for none.
    struct Writer { decl: u32, targs: []Id }

    // The writers of a value to a sink that some code sees: one, and the decl of a second if
    // there is one, which is an error.
    struct Writers { one: Writer, two: u32 }

    // An @fmt: where it is, the namespace it is in, whose writers it sees, the B of its sink, a
    // `*mut B` (ptr), and its format's pieces, with the holes' values in order. A hole that is
    // an @fmt without a sink is replaced by its own pieces and holes (fmt_parts). Each piece is
    // written by a `#write` fn for B (fmt_calls). Its errors are a set of its own, inferred as a
    // function's is (infer_sets), owned by SITE + its index. faults are the errors whose fields
    // an error hole's writers are looked up for (fault_writers). An @fmt without a sink (value)
    // is a bound function of type ty.
    struct Site {
        at: source::Span, ns: u32, sink: Id, ptr: Id, sink_at: source::Span,
        pieces: []mut Piece, holes: []syntax::Expr, faults: []u32, value: bool, ty: Id,
    }

    fn no_writer {} -> Writer {
        return Writer{ decl = NONE, targs = slice::empty(Id){} }
    }

    // `@fmt(b, "format", args...)` writes into b, a `*mut B`; `@fmt("format", args...)`, whose
    // format comes first, is a writer: a bound function of the type expected, `&fn{ mut b: B }
    // -> !`, which writes the same into the sink it is called with.
    fn fmt_builtin { mut c: Checker, e: syntax::Expr, args: []syntax::Expr, exp: Id } -> Id {
        if args.len == 0 { return fmt_type{ &c } }         // the parser has reported it
        let value = args[0].k is str
        let mut ok = true
        let mut bt = types::ERROR
        let mut ty = types::ERROR
        let mut first: usize = 1
        if value {
            first = 0
            let fd = writer_field{ c, t = exp }
            if fd != null {
                bt = types::ptr{ s = &c.ty, elem = fd.ty, mutable = true }
                let ret = result_of{ c, t = exp }
                ty = types::func{ s = &c.ty, fields = one_field{ c, f = fd }, ret, bound = true, external = false }
            } else if exp == types::NO_TYPE {
                error{ &c, at = expr_at{ e }, msg = "an @fmt without a sink needs a type to be: a writer, a function of its sink such as `utf8::Fmt(S)`" }
                ok = false
            } else if types::prune{ s = c.ty, t = exp } != types::ERROR {
                errorf{ &c, at = expr_at{ e }, msg = @fmt("an @fmt without a sink is a writer, `&fn{{ mut b: B }} -> !`, not {}", tstr{ c, t = exp }) }
                ok = false
            } else {
                ok = false
            }
        } else {
            bt = typed{ &c, e = args[0] }
            if args.len < 2 {
                error{ &c, at = expr_at{ e }, msg = "@fmt needs a format after its sink: a string literal" }
                ok = false
            }
        }
        let b = args[0]
        let sink = sink_of{ c, t = bt }
        if sink == types::NO_TYPE {
            if bt != types::ERROR {
                errorf{ &c, at = expr_at{ e = b }, msg = @fmt("@fmt writes to a `*mut` sink, got {}", tstr{ c, t = bt }) }
            }
            ok = false
        } else if sink == types::ERROR {
            ok = false
        } else if not has_writer{ &c, b = sink, ns = c.sc.ns } {
            errorf{ &c, at = expr_at{ e = if value { e } else { b } }, msg = @fmt("@fmt has no writer to {}: no `#write` fn it sees has a sink of that type", tstr{ c, t = sink }) }
            ok = false
        } else if not (types::get{ s = c.ty, id = types::prune{ s = c.ty, t = bt } } is ptr{ mutable } and mutable) {
            if b.k is addr{ e = x } {
                check_mutable{ &c, e = x.* }
            } else {
                errorf{ &c, at = expr_at{ e = b }, msg = @fmt("@fmt writes to a `*mut` sink, got {}", tstr{ c, t = bt }) }
            }
            ok = false
        }
        let mut pieces = list::new(Piece){ realloc = arena::alloc, heap = c.heap }
        let mut holes = list::new(syntax::Expr){ realloc = arena::alloc, heap = c.heap }
        if args.len > first {
            if not fmt_parts{ &c, e, f = args[first], args = args[first + 1..], &pieces, &holes } { ok = false }
        }
        let hs = list::items{ list = holes }
        let held = fmt_exclusive{ &c, e, sink = if value { null } else { b }, holes = hs }
        if not ok { return if value { types::ERROR } else { fmt_type{ &c } } }
        let si = @as(u32, c.sites.len)
        let rt = types::res{ s = &c.ty, ok = types::VOID, errs = types::errs{ s = &c.ty, owner = SITE + si, one = NONE } }
        if not value { ty = rt }
        let st = Site{
            at = expr_at{ e }, ns = c.sc.ns, sink, ptr = bt, sink_at = expr_at{ e = if value { e } else { b } },
            pieces = list::items{ list = pieces }, holes = hs, faults = no_vars{}, value, ty,
        }
        try! list::push{ list = &c.sites, item = st }
        try! map::put{ m = &c.site_of, key = expr_key{ e }, value = si }
        try! list::push{ list = &c.fmts, item = e }
        if value { try! map::put{ m = &c.holds, key = expr_key{ e }, value = held } }
        return ty
    }

    // The pieces of format f, after the arguments' values in holes, each typed: a string
    // literal as the text is, a strlit. An argument that is an @fmt without a sink isn't a
    // value: its own pieces and arguments take its hole's place, so that writers nest. Whether all is well, after reporting what isn't.
    fn fmt_parts { mut c: Checker, e: syntax::Expr, f: syntax::Expr, args: []syntax::Expr, mut pieces: list::List(Piece, Heap), mut holes: list::List(syntax::Expr, Heap) } -> bool {
        let ps: ?[]mut Piece = match f.k {
            str{ bytes } => { fmt_pieces{ &c, s = bytes, at = expr_at{ e = f } } }
            error => { null }
            else => {
                error{ &c, at = expr_at{ e = f }, msg = "@fmt takes its format as a string literal" }
                null
            }
        }
        let mut ok = ps != null
        let mut i: usize = 0
        while i < args.len {
            let h = args[i]
            if not is_writer_fmt{ e = h } {
                let want = match h.k { str => { types::STRLIT } else => { types::NO_TYPE } }
                _ = expr{ &c, e = h, exp = want }
            }
            i = i + 1
        }
        if ps != null {
            let mut n: usize = 0
            i = 0
            while i < ps.len {
                if ps[i].hole { n = n + 1 }
                i = i + 1
            }
            if n != args.len {
                let s1: utf8::String = if n == 1 { "" } else { "s" }
                let s2: utf8::String = if args.len == 1 { "" } else { "s" }
                let s3: utf8::String = if args.len == 1 { "s" } else { "" }
                errorf{ &c, at = expr_at{ e }, msg = @fmt("the format has {} hole{} but {} argument{} follow{} it", n, s1, args.len, s2, s3) }
                ok = false
            }
        }
        let mut k: usize = 0
        i = 0
        while ps != null and i < ps.len {
            let p = ps[i]
            if not p.hole {
                add_piece{ xs = &pieces, p }
            } else if k < args.len {
                let h = args[k]
                k = k + 1
                if h.k is builtin{ args = inner } and is_writer_fmt{ e = h } {
                    if not fmt_parts{ &c, e = h, f = inner[0], args = inner[1..], &pieces, &holes } { ok = false }
                } else {
                    add_piece{ xs = &pieces, p }
                    try! list::push{ list = &holes, item = h }
                }
            }
            i = i + 1
        }
        // The arguments past the holes, which are an error, are still checked.
        while k < args.len {
            let h = args[k]
            if h.k is builtin{ args = inner } and is_writer_fmt{ e = h } {
                let mut ignored = list::new(Piece){ realloc = arena::alloc, heap = c.heap }
                let mut also = list::new(syntax::Expr){ realloc = arena::alloc, heap = c.heap }
                _ = fmt_parts{ &c, e = h, f = inner[0], args = inner[1..], pieces = &ignored, holes = &also }
            }
            k = k + 1
        }
        return ok
    }

    // Whether e is an @fmt without a sink: its format, a string literal, comes first.
    fn is_writer_fmt { e: syntax::Expr } -> bool {
        let builtin{ name, args } = e.k else { return false }
        return slice::eq_bytes{ a = name.text, b = "fmt" } and args.len > 0 and args[0].k is str
    }

    // The sink's field of the writer type t that an @fmt without a sink is: a bound function
    // with one `mut` field, of the sink's type, that returns a bare `!`. Its other fields, if
    // any, are dropped when it is called (§5). Null if t isn't one.
    fn writer_field { c: Checker, t: Id } -> ?types::Field {
        if t == types::NO_TYPE { return null }
        let func{ fields, ret, bound, external } = types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } else { return null }
        if not bound or external or not void_result{ c, t = ret } { return null }
        let mut found: ?types::Field = null
        let mut i: usize = 0
        while i < fields.len {
            if fields[i].mutable {
                if found != null { return null }
                found = fields[i]
            }
            i = i + 1
        }
        return found
    }

    fn one_field { c: Checker, f: types::Field } -> []types::Field {
        let mut out = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
        add_field{ xs = &out, f }
        return list::items{ list = out }
    }

    // The type of an @fmt that has no site: a bare `!` that may fail with any error.
    fn fmt_type { mut c: Checker } -> Id {
        return types::res{ s = &c.ty, ok = types::VOID, errs = types::errs{ s = &c.ty, owner = NONE, one = NONE } }
    }

    // B, for a sink of type t, `*B` or `*mut B`; NO_TYPE for anything else.
    fn sink_of { c: Checker, t: Id } -> Id {
        if types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is ptr{ elem } { return types::prune{ s = c.ty, t = elem } }
        return types::NO_TYPE
    }

    // A name, or a path of fields from one: evaluating it again gives the same place, so
    // lowering needs no temporary for it.
    fn simple_place { e: syntax::Expr } -> bool {
        let mut x = e
        while true {
            match x.k {
                field{ base } => { x = base.* }
                path{ segs } => { return segs.len == 1 and segs[0].targs == null }
                else => { return false }
            }
        }
        return false
    }

    // The sink's place, if it is `&p`, and the places the holes' bound functions hold are one
    // call's mut references (§3.1): `@fmt(&b, "{}", w{ &b, _ })` is two. The holes' are what a
    // writer holds, as a bind's are.
    fn fmt_exclusive { mut c: Checker, e: syntax::Expr, sink: ?syntax::Expr, holes: []syntax::Expr } -> []Place {
        let mut refs = list::new(HeldRef){ realloc = arena::alloc, heap = c.heap }
        if sink != null and sink.k is addr{ e = x } {
            let p = place_path{ c, e = x.* }
            if p != null { add_ref{ xs = &refs, r = HeldRef{ p, holder = "" } } }
        }
        let mut i: usize = 0
        while i < holes.len {
            let h = holes[i]
            let holder = match h.k {
                path{ segs } => { if map::get{ m = c.convs, key = expr_key{ e = h } } == null { segs[0].name.text } else { source_text{ c, span = h.span } } }
                else => { source_text{ c, span = h.span } }
            }
            held_refs{ xs = &refs, c, places = held_of{ c, e = h }, holder }
            i = i + 1
        }
        overlapping{ &c, e, rs = list::items{ list = refs } }
        return places_of{ c, rs = list::items{ list = refs } }
    }

    // ---- `#write` fns and the writers an @fmt finds

    // `#write` on x (§13, Formatting): a fn whose context is two fields, the sink, `mut`, and the
    // value, read-only, and whose result is a bare `!`, or nothing for one that records failure
    // itself. It may be generic, but neither field's type is a bare type parameter and every
    // parameter appears in a field's type, so that matching a hole's type finds them all. The
    // value isn't a function: a function in a hole is called with the sink.
    fn write_attr { mut c: Checker, x: syntax::Decl, file: u32, a: syntax::Attr, seen: bool } {
        let func{ tparams, params, ret } = x.k else {
            error{ &c, at = a.span, msg = "`write` applies only to a fn" }
            return
        }
        if seen {
            error{ &c, at = a.span, msg = "duplicate `write` attribute" }
            return
        }
        let d = map::get{ m = c.decl_of, key = key{ file, id = x.id } } ifnull { return }
        let fd = get_decl{ c, d }
        let fs = fd.fields
        let mut i: usize = 0
        while i < fs.len {
            if types::prune{ s = c.ty, t = fs[i].ty } == types::ERROR { return }
            i = i + 1
        }
        if fs.len != 2 or fs[0].mutable == fs[1].mutable or params.len != 2 {
            let at = if params.len > 0 { params[0].span } else { x.span }
            error{ &c, at, msg = "a `write` fn takes two fields: the sink, `mut`, and the value, read-only" }
            return
        }
        let r = types::prune{ s = c.ty, t = fd.ret }
        if r == types::ERROR { return }
        if r != types::VOID and not void_result{ c, t = r } {
            error{ &c, at = if ret == null { x.span } else { ret.span }, msg = "a `write` fn returns a bare `!`, or nothing" }
            return
        }
        i = 0
        while i < 2 {
            let t = types::prune{ s = c.ty, t = fs[i].ty }
            let what: utf8::String = if fs[i].mutable { "sink" } else { "value" }
            if types::get{ s = c.ty, id = t } is param {
                errorf{ &c, at = params[i].span, msg = @fmt("a `write` fn's {} can't be a bare type parameter", what) }
                return
            }
            if not fs[i].mutable and types::get{ s = c.ty, id = t } is func {
                error{ &c, at = params[i].span, msg = "a `write` fn's value can't be a function: an @fmt hole calls a function with the sink" }
                return
            }
            i = i + 1
        }
        i = 0
        while i < tparams.len {
            let k = @as(u32, i)
            if not types::mentions{ s = c.ty, t = fs[0].ty, decl = d, index = k } and not types::mentions{ s = c.ty, t = fs[1].ty, decl = d, index = k } {
                errorf{ &c, at = tparams[i].span, msg = @fmt("a `write` fn's type parameter `{}` must appear in its fields", str{ s = tparams[i].text }) }
                return
            }
            i = i + 1
        }
        push{ xs = &c.writers, n = d }
    }

    // A `#write` fn's sink field and value field.
    fn sink_field { c: Checker, d: u32 } -> types::Field {
        let fs = get_decl{ c, d }.fields
        return if fs[0].mutable { fs[0] } else { fs[1] }
    }

    fn value_field { c: Checker, d: u32 } -> types::Field {
        let fs = get_decl{ c, d }.fields
        return if fs[0].mutable { fs[1] } else { fs[0] }
    }

    // Whether some `#write` fn that code in namespace ns sees writes to a sink of type b.
    fn has_writer { mut c: Checker, b: Id, ns: u32 } -> bool {
        let ws = list::items{ list = c.writers }
        let mut i: usize = 0
        while i < ws.len {
            let x = get_decl{ c, d = ws[i] }
            if reaches{ c, from = ns, ns = x.ns } and types::instance{ s = c.ty, p = sink_field{ c, d = ws[i] }.ty, t = b, decl = ws[i], args = no_args{ &c, n = x.tparams.len } } { return true }
            i = i + 1
        }
        return false
    }

    // n generic arguments, none known yet.
    fn no_args { mut c: Checker, n: usize } -> []mut Id {
        let mut out = list::new(Id){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < n {
            try! list::push{ list = &out, item = types::NO_TYPE }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // The writers of a t to a sink of type b that code in namespace ns sees (§13): `#write` fns
    // whose fields' types, with some generic arguments, are exactly b and t. No widening: a u32
    // widens to both an i64 and a u64.
    fn writers_of { mut c: Checker, b: Id, t: Id, ns: u32 } -> Writers {
        let ws = list::items{ list = c.writers }
        let mut one = no_writer{}
        let mut i: usize = 0
        while i < ws.len {
            let d = ws[i]
            let x = get_decl{ c, d }
            if reaches{ c, from = ns, ns = x.ns } {
                let args = no_args{ &c, n = x.tparams.len }
                if types::instance{ s = c.ty, p = sink_field{ c, d }.ty, t = b, decl = d, args } and types::instance{ s = c.ty, p = value_field{ c, d }.ty, t, decl = d, args } {
                    if one.decl != NONE { return Writers{ one, two = d } }
                    one = Writer{ decl = d, targs = args }
                }
            }
            i = i + 1
        }
        return Writers{ one, two = NONE }
    }

    // The writer of a t to a sink of type b that code in namespace ns sees, or null after
    // reporting at `at` that there is none, or that there are two. why ends the message.
    fn writer_of { mut c: Checker, b: Id, t: Id, ns: u32, at: source::Span, why: utf8::String } -> ?Writer {
        let found = writers_of{ &c, b, t, ns }
        if found.two != NONE {
            errorf{ &c, at, msg = @fmt("@fmt has two writers of {} to {}: `{}` and `{}`", tstr{ c, t }, tstr{ c, t = b }, str{ s = get_decl{ c, d = found.one.decl }.qual }, str{ s = get_decl{ c, d = found.two }.qual }) }
            return null
        }
        if found.one.decl == NONE {
            let mut m = message{ c }
            try! @fmt(&m, "@fmt has no writer of {} to {}{}", tstr{ c, t }, tstr{ c, t = b }, why)
            if is_enum{ c, t } {
                try! utf8::push{ b = &m, s = ": convert it with `@as`" }
            } else if types::get{ s = c.ty, id = t } is opt {
                try! utf8::push{ b = &m, s = ": give it a value with `ifnull`" }
            }
            error{ &c, at, msg = utf8::view{ b = m } }
            return null
        }
        return found.one
    }

    // What a writer adds to an @fmt's set: its own, unless it returns nothing.
    fn add_writer_set { c: Checker, mut flow: Flow, d: u32 } {
        if types::prune{ s = c.ty, t = get_decl{ c, d }.ret } != types::VOID { flow.subs = set_add{ c, xs = flow.subs, n = d } }
    }

    // The text of an error type owned by a site: its position, "`@fmt` at 3:9".
    fn site_text { c: Checker, owner: u32, mut b: utf8::Builder(Heap) } -> ! {
        let at = list::items{ list = c.sites }[@as(usize, owner - SITE)].at
        let file = c.files[at.file]
        let p = source::position{ text = file.text, lines = file.lines, offset = at.start }
        return @fmt(&b, "`@fmt` at {}:{}", p.line, p.col)
    }

    // The pieces of a format: text as it is, except that `{{` and `}}` stand for braces, and
    // holes, `{}`. Null after reporting at `at` what is wrong with it.
    fn fmt_pieces { mut c: Checker, s: []u8, at: source::Span } -> ?[]mut Piece {
        let mut out = list::new(Piece){ realloc = arena::alloc, heap = c.heap }
        let mut text = list::new(u8){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < s.len {
            let ch = s[i]
            let next: u8 = if i + 1 < s.len { s[i + 1] } else { 0 }
            if (ch == '{' and next == '{') or (ch == '}' and next == '}') {
                push_byte{ xs = &text, n = ch }
                i = i + 2
            } else if ch == '{' {
                let mut j = i + 1
                while j < s.len and s[j] != '}' { j = j + 1 }
                if j >= s.len {
                    error{ &c, at, msg = "the format has a `{` without a `}`; write `{{` for a brace" }
                    return null
                }
                if j != i + 1 {
                    let mut m = message{ c }
                    try! utf8::push{ b = &m, s = "bad hole `" }
                    let mut q = i
                    while q <= j {
                        let code: u32 = if s[q] < 128 { s[q] } else { 65533 }      // as ctxi's "replace"
                        try! utf8::push_char{ b = &m, c = code }
                        q = q + 1
                    }
                    try! utf8::push{ b = &m, s = "` in the format: a hole is `{}`, and a function writes a value another way, as `utf8::write_hex{ n, _ }`" }
                    error{ &c, at, msg = utf8::view{ b = m } }
                    return null
                }
                if text.len > 0 {
                    add_piece{ xs = &out, p = Piece{ hole = false, text = list::items{ list = text }, push = "", writer = no_writer{}, ty = types::STRLIT, at } }
                    text = list::new(u8){ realloc = arena::alloc, heap = c.heap }
                }
                add_piece{ xs = &out, p = Piece{ hole = true, text = "", push = "", writer = no_writer{}, ty = types::NO_TYPE, at } }
                i = j + 1
            } else if ch == '}' {
                error{ &c, at, msg = "the format has a `}` without a `{`; write `}}` for a brace" }
                return null
            } else {
                push_byte{ xs = &text, n = ch }
                i = i + 1
            }
        }
        if text.len > 0 {
            add_piece{ xs = &out, p = Piece{ hole = false, text = list::items{ list = text }, push = "", writer = no_writer{}, ty = types::STRLIT, at } }
        }

        return list::items{ list = out }
    }

    fn push_byte { mut xs: list::List(u8, Heap), n: u8 } {
        try! list::push{ list = &xs, item = n }
    }

    fn add_piece { mut xs: list::List(Piece, Heap), p: Piece } {
        try! list::push{ list = &xs, item = p }
    }

    // The site of an @fmt, or null if it has none.
    fn site_at { c: Checker, e: syntax::Expr } -> ?Site {
        let si = map::get{ m = c.site_of, key = expr_key{ e } } ifnull { return null }
        return list::items{ list = c.sites }[@as(usize, si)]
    }

    // The pieces of an @fmt, or null if it has no site.
    fn site_pieces { c: Checker, e: syntax::Expr } -> ?[]mut Piece {
        let st = site_at{ c, e } ifnull { return null }
        return st.pieces
    }

    // How each piece of an @fmt is written, once the body's types are settled, and what its set
    // gains from them (write_calls).
    fn fmt_calls { mut c: Checker, e: syntax::Expr } {
        let si = map::get{ m = c.site_of, key = expr_key{ e } } ifnull { return }
        let st = list::items{ list = c.sites }[@as(usize, si)]
        let sink = types::zonk{ s = &c.ty, t = st.sink }
        list::at{ list = c.sites, i = @as(usize, si) }.sink = sink
        let mut flow = Flow{ atoms = no_vars{}, subs = no_vars{}, any = true }
        if not write_calls{ &c, site = st, sink, &flow } { flow.any = true }
        try! map::put{ m = &c.flows, key = SITE + si, value = flow }
    }

    // The pieces of an @fmt (§13): text by the writer of a strlit, a hole by the writer of its
    // type, an error by the compiler, and a function by calling it with the sink.
    fn write_calls { mut c: Checker, site: Site, sink: Id, mut flow: Flow } -> bool {
        let args = site.holes
        let ps = site.pieces
        flow.any = false
        let mut text = no_writer{}
        let mut h: usize = 0
        let mut i: usize = 0
        while i < ps.len {
            let p = ps[i]
            let mut at = p.at
            let mut t = types::STRLIT
            let mut why: utf8::String = ", for its text"
            if p.hole {
                let x = args[h]
                h = h + 1
                t = types::zonk{ s = &c.ty, t = type_of_expr{ c, e = x } }
                at = expr_at{ e = x }
                ps[i].ty = t
                ps[i].at = at
                why = ""
                if t == types::ERROR { return false }
                if x.k is str{ bytes } { fmt_text_ok{ &c, text = bytes, at } }
            } else {
                fmt_text_ok{ &c, text = p.text, at }
            }
            if is_errs{ c, t } or t == types::STRLIT {
                // Text, a strlit, and an error's name and braces are written by the writer of a
                // strlit; an error's fields are looked up once its set is known (infer_sets).
                if text.decl == NONE {
                    if is_errs{ c, t } { why = ", for an error's name" }
                    text = writer_of{ &c, b = sink, t = types::STRLIT, ns = site.ns, at, why } ifnull { return false }
                    add_writer_set{ c, &flow, d = text.decl }
                }
                ps[i].push = if is_errs{ c, t } { "error" } else { "write" }
                ps[i].writer = text
            } else if types::get{ s = c.ty, id = t } is func{ fields, ret, external } and not external and fields.len == 1 and fields[0].mutable and void_result{ c, t = ret } {
                ps[i].push = "call"
                flow.any = true
                call_hole{ &c, x = args[h - 1], site }
            } else {
                let w = writer_of{ &c, b = sink, t, ns = site.ns, at, why } ifnull { return false }
                add_writer_set{ c, &flow, d = w.decl }
                ps[i].push = "write"
                ps[i].writer = w
            }
            i = i + 1
        }
        return true
    }

    // Text must be valid UTF-8: the checker rejects a format that isn't, whatever the sink.
    fn fmt_text_ok { mut c: Checker, text: []u8, at: source::Span } {
        match utf8::from{ bytes = text } {
            ok => {}
            utf8::invalid{ at = bad } => {
                errorf{ &c, at, msg = @fmt("string literal is not valid UTF-8 (byte {})", bad) }
            }
        }
    }

    // A function hole x, which the @fmt calls with its sink in its one field: the sink, or a
    // writer's, must be a pointer to the field's type.
    fn call_hole { mut c: Checker, x: syntax::Expr, site: Site } {
        if types::get{ s = c.ty, id = types::prune{ s = c.ty, t = type_of_expr{ c, e = x } } } is func{ fields } {
            let want = types::ptr{ s = &c.ty, elem = fields[0].ty, mutable = true }
            _ = convert{ &c, a = site.ptr, t = want, pos = if site.value { expr_at{ e = x } } else { site.sink_at } }
        }
    }

    // The writers of an error's fields, for an error hole of site si: each field's, or none if
    // there is none, which writes `_`. Looked up while the sets are inferred, for each error a
    // hole's set gains, and keyed by the site and the error (fault_writers). Their sets join
    // the site's.
    fn fault_field_writers { mut c: Checker, si: u32, d: u32, at: source::Span } {
        let st = list::items{ list = c.sites }[@as(usize, si)]
        let fields = fault_fields{ c, d } ifnull { slice::empty(types::Field){} }
        let mut out = list::new(Writer){ realloc = arena::alloc, heap = c.heap }
        let mut flow = map::get{ m = c.flows, key = SITE + si } ifnull { Flow{ atoms = no_vars{}, subs = no_vars{}, any = false } }
        let mut k: usize = 0
        while k < fields.len {
            let found = writers_of{ &c, b = st.sink, t = fields[k].ty, ns = st.ns }
            if found.two != NONE {
                errorf{ &c, at, msg = @fmt("@fmt has two writers of {} to {}, for `{}`'s field `{}`: `{}` and `{}`", tstr{ c, t = fields[k].ty }, tstr{ c, t = st.sink }, str{ s = get_decl{ c, d }.qual }, str{ s = fields[k].name }, str{ s = get_decl{ c, d = found.one.decl }.qual }, str{ s = get_decl{ c, d = found.two }.qual }) }
            }
            if found.one.decl != NONE { add_writer_set{ c, &flow, d = found.one.decl } }
            try! list::push{ list = &out, item = found.one }
            k = k + 1
        }
        try! map::put{ m = &c.fault_writers, key = fault_key{ si, d }, value = list::items{ list = out } }
        try! map::put{ m = &c.flows, key = SITE + si, value = flow }
    }

    fn fault_key { si: u32, d: u32 } -> u64 {
        return (@as(u64, si) << 32) | @as(u64, d)
    }

    // ---- errors (§8, Errors)

    fn is_res { c: Checker, t: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is res
    }

    fn is_errs { c: Checker, t: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is errs | eset
    }

    // Whether t is a bare `!`: a function returning it returns no value, or fails.
    fn void_result { c: Checker, t: Id } -> bool {
        return types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is res{ ok } and types::prune{ s = c.ty, t = ok } == types::VOID
    }

    // The errors an error of type t may be, once the sets are inferred: a function's set, one
    // error, or every error of the program.
    fn set_of { c: Checker, t: Id } -> []u32 {
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } {
            errs{ owner, one } => {
                if one != NONE { return one_id{ c, n = one } }
                if owner == NONE { return list::items{ list = c.faults } }
                return map::get{ m = c.sets, key = owner } ifnull { no_vars{} }
            }
            eset{ errs } => { return errs }
            else => { return no_vars{} }
        }
    }

    // An error type as its set: the type lowering gives it, shared by every type with its errors.
    fn eset_of { mut c: Checker, t: Id } -> Id {
        return types::eset{ s = &c.ty, errs = set_of{ c, t } }
    }

    // The error a pattern names, `name` or `a::b::name`, or NONE after saying why it names none.
    fn fault_named { mut c: Checker, p: syntax::Pattern } -> u32 {
        let n = p.variant
        if n.text.len == 0 { return NONE }
        let mut found: ?Entry = null
        if p.quals.len == 0 {
            found = lookup_value{ c, ns = c.sc.ns, name = n.text }
        } else {
            let q0 = p.quals[0]
            if q0.text.len == 0 { return NONE }
            let first = lookup_path{ c, ns = c.sc.ns, name = q0.text } ifnull {
                unknown{ &c, n = q0 }
                return NONE
            }
            refer{ &c, n = q0, e = first }
            let mut e = first
            let mut i: usize = 0
            while i < p.quals.len {
                let prev = p.quals[i]
                let space{ ns } = e else {
                    errorf{ &c, at = prev.span, msg = @fmt("`{}` is not a namespace", str{ s = prev.text }) }
                    return NONE
                }
                if i + 1 == p.quals.len {
                    found = map::get{ m = get_space{ c, ns }.values, key = n.text }
                } else {
                    let q = p.quals[i + 1]
                    e = map::get{ m = get_space{ c, ns }.paths, key = q.text } ifnull {
                        errorf{ &c, at = q.span, msg = @fmt("no namespace `{}` in `{}`", str{ s = q.text }, str{ s = prev.text }) }
                        return NONE
                    }
                    refer{ &c, n = q, e }
                }
                i = i + 1
            }
        }
        let f = found
        if f is decl{ i } and get_decl{ c, d = i }.kind == Kind::fault {
            refer{ &c, n, e = f }
            return i
        }
        let mut b = message{ c }
        try! utf8::push{ &b, s = if f == null { "no error `" } else { "`" } }
        let mut i: usize = 0
        while i < p.quals.len {
            try! @fmt(&b, "{}::", str{ s = p.quals[i].text })
            i = i + 1
        }
        try! utf8::push{ &b, s = str{ s = n.text } }
        try! utf8::push{ &b, s = if f == null { "`" } else { "` is not an error" } }
        error{ &c, at = p.span, msg = utf8::view{ b } }
        return NONE
    }

    // A match on a `!T` or an error (§8, Errors). On a `!T`, `ok` and `err` are its variants,
    // and errors may be listed next to `ok`: then an `else`, or an `err` arm, which binds the
    // error, takes the rest. On an error, the arms list errors. Whether each listed error can
    // happen, and whether every one that can is listed, waits for the sets (finish_matches). As
    // `iferr` on a bare `!`, it has no value, and its `ok` arm is skipped.
    fn check_fail_match { mut c: Checker, x: syntax::Match, at: source::Span, exp: Id, value: bool, may_leave: bool, t: Id } -> Id {
        let scrut = x.scrut.*
        let mut vs: []Variant = slice::empty(Variant){}
        let mut errs = t
        let mut bare = false
        if types::get{ s = c.ty, id = t } is res{ ok, errs = e } {
            vs = variants_of{ &c, t }
            errs = e
            bare = x.is_iferr and types::prune{ s = c.ty, t = ok } == types::VOID
        }
        let is_r = vs.len > 0
        let scrut_derived = new_derived{ &c, xs = derives{ &c, e = scrut } }
        let s0 = save{ c }
        let mut seen = list::new(u32){ realloc = arena::alloc, heap = c.heap }       // 0 for `ok`, 1 for `err`
        let mut listed = list::new(u32){ realloc = arena::alloc, heap = c.heap }
        let mut spans = list::new(source::Span){ realloc = arena::alloc, heap = c.heap }
        let mut rest: ?source::Span = null
        let mut rest_word: []u8 = "else"
        let mut has_else = false
        let mut results = list::new(State){ realloc = arena::alloc, heap = c.heap }
        let mut bs = list::new(Branch){ realloc = arena::alloc, heap = c.heap }
        let arms = x.arms
        let mut i: usize = 0
        while i < arms.len {
            let arm = arms[i]
            let skip = bare and i == 0
            let mut first: []u32 = slice::empty(u32){}
            let mut first_name: []u8 = ""
            if arm.pats.len == 0 {
                if i != arms.len - 1 {
                    error{ &c, at = arm.span, msg = "`else` must be the last arm" }
                } else if seen.len == 2 {
                    error{ &c, at = arm.span, msg = "`else` is unreachable: every variant is already listed" }
                }
                has_else = true
                rest = arm.span
                rest_word = "else"
            }
            let mut kinds: u32 = 0          // 1: `ok` or `err`, 2: errors
            let mut k: usize = 0
            while k < arm.pats.len {
                let p = arm.pats[k]
                let word = p.variant.text
                let mut fields: ?[]types::Field = null
                let mut known = true
                if is_r and p.quals.len == 0 and (slice::eq_bytes{ a = word, b = "ok" } or slice::eq_bytes{ a = word, b = "err" }) {
                    kinds = kinds | 1
                    let vi: u32 = if slice::eq_bytes{ a = word, b = "ok" } { 0 } else { 1 }
                    if has_id{ xs = list::items{ list = seen }, n = vi } {
                        errorf{ &c, at = p.span, msg = @fmt("variant `{}` appears in more than one arm", str{ s = word }) }
                    } else {
                        push{ xs = &seen, n = vi }
                    }
                    if vi == 1 {
                        rest = p.span
                        rest_word = "err"
                    }
                    fields = vs[vi].fields
                } else {
                    kinds = kinds | 2
                    let d = fault_named{ &c, p }
                    if d == NONE {
                        known = false
                    } else {
                        let q = str{ s = get_decl{ c, d }.qual }
                        if has_id{ xs = list::items{ list = seen }, n = 1 } {
                            errorf{ &c, at = p.span, msg = @fmt("error `{}` comes after `err`, which takes every error", q) }
                        } else if has_id{ xs = list::items{ list = listed }, n = d } {
                            errorf{ &c, at = p.span, msg = @fmt("error `{}` appears in more than one arm", q) }
                        } else {
                            push{ xs = &listed, n = d }
                            try! list::push{ list = &spans, item = p.span }
                        }
                        fields = fault_fields{ c, d }
                        try! map::put{ m = &c.pat_errs, key = name_key{ n = p.variant }, value = d }
                    }
                }
                let bv = if skip { no_vars{} } else { pattern_vars{ &c, variant = word, known, fields, binders = p.binders, through = false, ptr_mut = false, derived = scrut_derived, at = p.span } }
                if k == 0 {
                    first = bv
                    first_name = word
                } else {
                    same_binds{ &c, first_name, first, variant = word, mine = bv, binders = p.binders, at = p.span, within = "arm" }
                }
                k = k + 1
            }
            if kinds == 3 { error{ &c, at = arm.span, msg = "an arm can't list `ok` or `err` with errors" } }
            restore{ &c, s = s0 }
            if skip {
                add_branch{ xs = &bs, b = Branch{ t = types::NO_TYPE, value = Value::none } }
            } else {
                add_branch{ xs = &bs, b = branch{ &c, b = arm.body, vars = first, facts = slice::empty(Fact){}, exp, value = value and not bare } }
            }
            add_state{ xs = &results, s = save{ c } }
            i = i + 1
        }
        let ok_seen = has_id{ xs = list::items{ list = seen }, n = 0 }
        let err_seen = has_id{ xs = list::items{ list = seen }, n = 1 }
        if is_r and listed.len > 0 and not ok_seen {
            error{ &c, at, msg = "a match that lists errors must list `ok` too" }
        } else if is_r and not has_else and (not ok_seen or (not err_seen and listed.len == 0)) {
            let missing: utf8::String = if not ok_seen and not err_seen and listed.len == 0 { "ok, err" } else if not ok_seen { "ok" } else { "err" }
            errorf{ &c, at, msg = @fmt("match isn't exhaustive: missing {}", missing) }
        }
        if listed.len > 0 or not is_r {
            let p = Pending{
                at, errs, listed = list::items{ list = listed }, spans = list::items{ list = spans },
                rest = if has_else or err_seen { rest } else { null }, rest_word,
            }
            try! list::push{ list = &c.pending, item = p }
        }
        restore{ &c, s = merge{ c, xs = list::items{ list = results } } }
        if bare { return types::VOID }
        if value { return join{ &c, at, bs = list::items{ list = bs }, exp, may_leave } }
        return types::NO_TYPE
    }

    // Each function's and @fmt's error set: the errors that flow into it, and the sets of the
    // functions and @fmts whose errors flow into it, until no set grows. An error hole's set
    // adds the writers of each of its errors' fields as it grows (fault_field_writers). Sets
    // only grow and are finite, so this ends, through recursion too. A set is in declaration
    // order: each error's number.
    fn infer_sets { mut c: Checker } {
        let mut owners = list::new(u32){ realloc = arena::alloc, heap = c.heap }
        let ds = list::items{ list = c.fns }
        let mut i: usize = 0
        while i < ds.len {
            push{ xs = &owners, n = ds[i] }
            i = i + 1
        }
        i = 0
        while i < c.sites.len {
            push{ xs = &owners, n = SITE + @as(u32, i) }
            i = i + 1
        }
        let fs = list::items{ list = owners }
        let mut any = map::new(u32, bool){ realloc = arena::alloc, heap = c.heap, hash = map::hash_u32, eq = map::eq_u32 }
        i = 0
        while i < fs.len {
            let d = fs[i]
            let f = map::get{ m = c.flows, key = d }
            if f != null {
                try! map::put{ m = &c.sets, key = d, value = f.atoms }
                if f.any { put_bool{ m = &any, k = d } }
            }
            i = i + 1
        }
        let mut changed = true
        while changed {
            changed = false
            if error_holes{ &c, any } { changed = true }
            i = 0
            while i < fs.len {
                let d = fs[i]
                let f = map::get{ m = c.flows, key = d }
                if f != null and not map::has{ m = any, key = d } {
                    let mut cur = map::get{ m = c.sets, key = d } ifnull { no_vars{} }
                    let mut k: usize = 0
                    while k < f.subs.len {
                        let sub = f.subs[k]
                        if map::has{ m = any, key = sub } {
                            put_bool{ m = &any, k = d }
                            changed = true
                            break
                        }
                        let theirs = map::get{ m = c.sets, key = sub } ifnull { no_vars{} }
                        let n = set_union{ c, a = cur, b = theirs }
                        if n.len != cur.len {
                            cur = n
                            changed = true
                        }
                        k = k + 1
                    }
                    try! map::put{ m = &c.sets, key = d, value = cur }
                }
                i = i + 1
            }
        }
        i = 0
        while i < fs.len {
            let d = fs[i]
            let set = if map::has{ m = any, key = d } { list::items{ list = c.faults } } else { map::get{ m = c.sets, key = d } ifnull { no_vars{} } }
            try! map::put{ m = &c.sets, key = d, value = sorted_ids{ c, xs = set } }
            i = i + 1
        }
    }

    // The writers of the fields of each error that an error hole's set has gained, for each
    // @fmt; whether one was looked up. A set with `any` is every error.
    fn error_holes { mut c: Checker, any: map::Map(u32, bool, Heap) } -> bool {
        let mut grew = false
        let mut si: usize = 0
        while si < c.sites.len {
            let st = list::items{ list = c.sites }[si]
            let mut k: usize = 0
            while k < st.pieces.len {

                let p = st.pieces[k]
                if p.hole and slice::eq_bytes{ a = p.push, b = "error" } {
                    let set = current_set{ c, t = p.ty, any }
                    let mut j: usize = 0
                    while j < set.len {
                        let now = list::items{ list = c.sites }[si]
                        if not has_id{ xs = now.faults, n = set[j] } {
                            list::at{ list = c.sites, i = si }.faults = set_add{ c, xs = now.faults, n = set[j] }
                            fault_field_writers{ &c, si = @as(u32, si), d = set[j], at = p.at }
                            grew = true
                        }
                        j = j + 1
                    }
                }
                k = k + 1
            }
            si = si + 1
        }
        return grew
    }

    // The errors an error of type t may be while the sets are inferred: as set_of, with a
    // function or @fmt in `any` failing with every error.
    fn current_set { c: Checker, t: Id, any: map::Map(u32, bool, Heap) } -> []u32 {
        if types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } is errs{ owner, one } and one == NONE and owner != NONE and map::has{ m = any, key = owner } {
            return list::items{ list = c.faults }
        }
        return set_of{ c, t }
    }

    fn sorted_ids { c: Checker, xs: []u32 } -> []u32 {
        let mut out = list::new(u32){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < xs.len {
            push{ xs = &out, n = xs[i] }
            let ys = list::items{ list = out }
            let mut k = ys.len - 1
            while k > 0 and ys[k] < ys[k - 1] {
                let tmp = ys[k]
                ys[k] = ys[k - 1]
                ys[k - 1] = tmp
                k = k - 1
            }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // The matches on errors, against the inferred sets: each error listed must be one that can
    // happen, and without an `else` or `err` arm every one that can must be listed.
    fn finish_matches { mut c: Checker } {
        let ps = list::items{ list = c.pending }
        let mut i: usize = 0
        while i < ps.len {
            let p = ps[i]
            let set = set_of{ c, t = p.errs }
            let mut j: usize = 0
            while j < p.listed.len {
                if not has_id{ xs = set, n = p.listed[j] } {
                    let mut b = message{ c }
                    try! @fmt(&b, "error `{}` can't happen here: ", str{ s = get_decl{ c, d = p.listed[j] }.qual })
                    if set.len == 0 {
                        try! utf8::push{ &b, s = "this can't fail" }
                    } else {
                        try! utf8::push{ &b, s = "this fails only with " }
                        try! fault_names{ c, ds = set, &b }
                    }
                    error{ &c, at = p.spans[j], msg = utf8::view{ b } }
                }
                j = j + 1
            }
            let mut missing = list::new(u32){ realloc = arena::alloc, heap = c.heap }
            j = 0
            while j < set.len {
                if not has_id{ xs = p.listed, n = set[j] } { push{ xs = &missing, n = set[j] } }
                j = j + 1
            }
            let rest = p.rest
            if rest == null {
                if missing.len > 0 {
                    let mut b = message{ c }
                    try! utf8::push{ &b, s = "match isn't exhaustive: missing " }
                    try! fault_names{ c, ds = list::items{ list = missing }, &b }
                    error{ &c, at = p.at, msg = utf8::view{ b } }
                }
            } else if missing.len == 0 {
                errorf{ &c, at = rest, msg = @fmt("`{}` is unreachable: every error is already listed", str{ s = p.rest_word }) }
            }
            i = i + 1
        }
    }

    // "a::x, b::y"
    fn fault_names { c: Checker, ds: []u32, mut b: utf8::Builder(Heap) } -> ! {
        let mut i: usize = 0
        while i < ds.len {
            if i > 0 { try utf8::push{ &b, s = ", " } }
            try utf8::push{ &b, s = str{ s = get_decl{ c, d = ds[i] }.qual } }
            i = i + 1
        }
    }

    // ---- the fields of declared types

    // The type a non-generic struct or union declaration declares.
    fn types_of_decl { mut c: Checker, d: u32 } -> Id {
        let none = slice::empty(Id){}
        if get_decl{ c, d }.kind == Kind::record { return types::record{ s = &c.ty, decl = d, args = none } }
        return types::sum{ s = &c.ty, decl = d, args = none }
    }

    // A struct type's fields, with its generic arguments in place.
    fn struct_fields { mut c: Checker, t: Id } -> []types::Field {
        match types::get{ s = c.ty, id = t } {
            record{ decl, args } => { return subst_fields{ &c, fields = get_decl{ c, d = decl }.fields, decl, args } }
            cap{ decl } => { return get_decl{ c, d = decl }.fields }
            else => { return slice::empty(types::Field){} }
        }
    }

    // A union's or optional's variants, with generic arguments in place, or an enum's.
    fn variants_of { mut c: Checker, t: Id } -> []Variant {
        let mut out = list::new(Variant){ realloc = arena::alloc, heap = c.heap }
        match types::get{ s = c.ty, id = t } {
            enumeration{ decl } => {
                let names = enum_names{ c, d = decl }
                let mut i: usize = 0
                while i < names.len {
                    add_variant{ xs = &out, v = Variant{ name = names[i], fields = null } }
                    i = i + 1
                }
            }
            opt{ elem } => {
                add_variant{ xs = &out, v = Variant{ name = "null", fields = null } }
                let mut fs = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
                add_field{ xs = &fs, f = types::Field{ name = "value", mutable = false, ty = elem } }
                add_variant{ xs = &out, v = Variant{ name = "some", fields = list::items{ list = fs } } }
            }
            sum{ decl, args } => {
                let vs = get_decl{ c, d = decl }.variants
                let mut i: usize = 0
                while i < vs.len {
                    let v = vs[i]
                    let fs = v.fields
                    if fs == null {
                        add_variant{ xs = &out, v }
                    } else {
                        add_variant{ xs = &out, v = Variant{ name = v.name, fields = subst_fields{ &c, fields = fs, decl, args } } }
                    }
                    i = i + 1
                }
            }
            // `!T`: `ok{ value }` (`ok` alone for a bare `!`) and `err{ error }`.
            res{ ok, errs } => {
                if types::prune{ s = c.ty, t = ok } == types::VOID {
                    add_variant{ xs = &out, v = Variant{ name = "ok", fields = null } }
                } else {
                    let mut fs = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
                    add_field{ xs = &fs, f = types::Field{ name = "value", mutable = false, ty = ok } }
                    add_variant{ xs = &out, v = Variant{ name = "ok", fields = list::items{ list = fs } } }
                }
                let mut es = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
                add_field{ xs = &es, f = types::Field{ name = "error", mutable = false, ty = errs } }
                add_variant{ xs = &out, v = Variant{ name = "err", fields = list::items{ list = es } } }
            }
            // An error: one variant per error of its set, which must be inferred by now.
            errs => { return variants_of{ &c, t = eset_of{ &c, t } } }
            eset{ errs } => {
                let mut i: usize = 0
                while i < errs.len {
                    let d = get_decl{ c, d = errs[i] }
                    add_variant{ xs = &out, v = Variant{ name = d.qual, fields = fault_fields{ c, d = errs[i] } } }
                    i = i + 1
                }
            }
            else => {}
        }
        return list::items{ list = out }
    }

    fn subst_fields { mut c: Checker, fields: []types::Field, decl: u32, args: []Id } -> []types::Field {
        if args.len == 0 { return fields }
        let mut out = list::new(types::Field){ realloc = arena::alloc, heap = c.heap }
        let mut i: usize = 0
        while i < fields.len {
            let f = fields[i]
            add_field{ xs = &out, f = types::Field{ name = f.name, mutable = f.mutable, ty = types::subst{ s = &c.ty, t = f.ty, decl, args } } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // ---- layout (ctxi's Runtime.layout)

    // The size and alignment of t, or null if it has none: it is generic, erroneous, or of
    // infinite size.
    fn layout { mut c: Checker, t: Id } -> ?Layout {
        let known = map::get{ m = c.layouts, key = t }
        if known != null { return known }
        if map::has{ m = c.busy, key = t } { return null }
        try! map::put{ m = &c.busy, key = t, value = true }
        let lay = compute{ &c, t }
        _ = map::remove{ m = &c.busy, key = t }
        if lay != null {
            try! map::put{ m = &c.layouts, key = t, value = lay }
        }
        return lay
    }

    fn compute { mut c: Checker, t: Id } -> ?Layout {
        match types::get{ s = c.ty, id = t } {
            prim{ p } => {
                let n = @as(u64, types::bits{ p } / 8)
                return Layout{ size = n, align = n }
            }
            ptr | func => { return Layout{ size = 8, align = 8 } }
            slice | strlit => { return Layout{ size = 16, align = 8 } }
            cap{ decl } => {
                if get_decl{ c, d = decl }.fields.len == 0 { return Layout{ size = 0, align = 1 } }
                let offs = struct_offsets{ &c, t }
                if offs == null { return null }
                return offs.layout
            }
            void => { return Layout{ size = 0, align = 1 } }
            enumeration{ decl } => { return layout{ &c, t = get_decl{ c, d = decl }.ty } }
            array{ n, elem } => {
                let el = layout{ &c, t = elem }
                if el == null { return null }
                if el.size != 0 and n > 18446744073709551615 / el.size { return null }
                return Layout{ size = n * el.size, align = el.align }
            }
            record => {
                let offs = struct_offsets{ &c, t }
                if offs == null { return null }
                return offs.layout
            }
            opt | sum | res | eset => {
                if nullable_ptr{ c, t } { return Layout{ size = 8, align = 8 } }
                let u = union_offsets{ &c, t }
                if u == null { return null }
                return u.layout
            }
            errs => { return layout{ &c, t = eset_of{ &c, t } } }
            else => { return null }
        }
    }

    // Whether t is a `?*T` or `?*mut T`, which is a pointer whose null is the address 0: a `*T`
    // is never null (§12), so the tag isn't needed, and the layout is C's. So are a `?extern fn`
    // and a `?c::String`, a struct around a pointer that is never null.
    fn nullable_ptr { c: Checker, t: Id } -> bool {
        match types::get{ s = c.ty, id = types::prune{ s = c.ty, t } } {
            opt{ elem } => {
                match types::get{ s = c.ty, id = types::prune{ s = c.ty, t = elem } } {
                    ptr => { return true }
                    func{ external } => { return external }
                    record{ decl } => { return decl == c.cstr_decl and decl != NONE }
                    else => { return false }
                }
            }
            else => { return false }
        }
    }

    // A struct's layout and the offset of each field.
    struct Offsets { layout: Layout, offs: []u64 }

    fn struct_offsets { mut c: Checker, t: Id } -> ?Offsets {
        let fields = struct_fields{ &c, t }
        let untagged = untagged_type{ c, t }
        let mut offs = list::new(u64){ realloc = arena::alloc, heap = c.heap }
        let mut off: u64 = 0
        let mut al: u64 = 1
        let mut i: usize = 0
        while i < fields.len {
            let fl = layout{ &c, t = fields[i].ty }
            if fl == null { return null }
            if untagged {
                // every field at 0, as in a C union
                push_u64{ xs = &offs, n = 0 }
                if fl.size > off { off = fl.size }
            } else {
                off = align_up{ n = off, a = fl.align }
                push_u64{ xs = &offs, n = off }
                off = off + fl.size
            }
            if fl.align > al { al = fl.align }
            i = i + 1
        }
        return Offsets{ layout = Layout{ size = align_up{ n = off, a = al }, align = al }, offs = list::items{ list = offs } }
    }

    // A union's layout: the tag is a u32 at 0, and the payload at pay_off. offs holds each
    // variant's field offsets, from the start of the union.
    struct UnionOffsets { layout: Layout, pay_off: u64, offs: [][]mut u64 }

    fn union_offsets { mut c: Checker, t: Id } -> ?UnionOffsets {
        let vs = variants_of{ &c, t }
        let mut rel = list::new([]mut u64){ realloc = arena::alloc, heap = c.heap }
        let mut pal: u64 = 1
        let mut psize: u64 = 0
        let mut i: usize = 0
        while i < vs.len {
            let fs = vs[i].fields
            let mut offs = list::new(u64){ realloc = arena::alloc, heap = c.heap }
            if fs != null {
                let mut off: u64 = 0
                let mut j: usize = 0
                while j < fs.len {
                    let fl = layout{ &c, t = fs[j].ty }
                    if fl == null { return null }
                    off = align_up{ n = off, a = fl.align }
                    push_u64{ xs = &offs, n = off }
                    off = off + fl.size
                    if fl.align > pal { pal = fl.align }
                    j = j + 1
                }
                if off > psize { psize = off }
            }
            try! list::push{ list = &rel, item = list::items{ list = offs } }
            i = i + 1
        }
        let al: u64 = if pal > 4 { pal } else { 4 }
        let pay = align_up{ n = 4, a = pal }
        let all = list::items{ list = rel }
        i = 0
        while i < all.len {
            let xs = all[i]
            let mut j: usize = 0
            while j < xs.len {
                xs[j] = xs[j] + pay
                j = j + 1
            }
            i = i + 1
        }
        return UnionOffsets{ layout = Layout{ size = align_up{ n = pay + psize, a = al }, align = al }, pay_off = pay, offs = all }
    }

    fn align_up { n: u64, a: u64 } -> u64 {
        return (n + a - 1) / a * a
    }

    // ---- diagnostics

    // Reports msg at the start of span at, unless the same message is already there: a type
    // alias is resolved at each use, and its errors would repeat.
    fn error { mut c: Checker, at: source::Span, msg: utf8::String } {
        let ds = diag::items{ diags = c.diags.* }
        let mut i: usize = 0
        while i < ds.len {
            let d = ds[i]
            if d.span.file == at.file and d.span.start == at.start and utf8::eq{ a = d.msg, b = msg } { return }
            i = i + 1
        }
        diag::error{ diags = c.diags, span = at, msg }
    }

    // error, with a message that msg writes: `errorf{ &c, at, msg = @fmt("no `{}`", name) }`.
    fn errorf { mut c: Checker, at: source::Span, msg: utf8::Fmt(Heap) } {
        let mut b = message{ c }
        try! msg{ &b }
        error{ &c, at, msg = utf8::view{ b } }
    }

    fn nowhere {} -> source::Span {
        return source::Span{ file = NO_FILE, start = 0, end = 0 }
    }

    // Where diagnostics about expression e point: its `at`.
    fn expr_at { e: syntax::Expr } -> source::Span {
        return source::Span{ file = e.span.file, start = e.at, end = e.span.end }
    }

    fn message { c: Checker } -> utf8::Builder(Heap) {
        return utf8::builder{ realloc = arena::alloc, heap = c.heap }
    }

    fn str { s: []u8 } -> utf8::String {
        return utf8::String{ bytes = s }
    }


    fn push { mut xs: list::List(u32, Heap), n: u32 } {
        try! list::push{ list = &xs, item = n }
    }

    fn push_i64 { mut xs: list::List(i64, Heap), n: i64 } {
        try! list::push{ list = &xs, item = n }
    }

    fn push_u64 { mut xs: list::List(u64, Heap), n: u64 } {
        try! list::push{ list = &xs, item = n }
    }

    fn add_field { mut xs: list::List(types::Field, Heap), f: types::Field } {
        try! list::push{ list = &xs, item = f }
    }

    fn add_variant { mut xs: list::List(Variant, Heap), v: Variant } {
        try! list::push{ list = &xs, item = v }
    }
}
