// Diagnostics. The front end reports every problem it finds instead of stopping at the first:
// each phase appends to one Diags, passed down as a `mut diags` context field. Message text is
// the interface tests match on, so it follows ctxi's wording.

namespace diag {
    union Severity { error, warning }

    // A related place, such as where something was first borrowed.
    struct Note { span: source::Span, msg: utf8::String }

    struct Diag { severity: Severity, span: source::Span, msg: utf8::String, notes: []Note }

    // At most `cap` are kept, CAP unless `keep_all` lifts it, so a broken file can't flood an
    // editor. `dropped` counts the rest, which the driver says after those it shows (report.ctx).
    const CAP: usize = 100

    struct Diags { items: list::List(Diag, arena::Arena), errors: usize, dropped: usize, cap: usize }

    fn new { heap: *mut arena::Arena } -> Diags {
        return Diags{ items = list::new(Diag){ realloc = arena::alloc, heap }, errors = 0, dropped = 0, cap = CAP }
    }

    // Lifts the cap, for `ctxc check`: every diagnostic is kept.
    fn keep_all { mut diags: Diags } {
        diags.cap = 18446744073709551615
    }

    fn error { mut diags: Diags, span: source::Span, msg: utf8::String } {
        add{ &diags, d = Diag{ severity = Severity::error, span, msg, notes = slice::empty(Note){} } }
    }

    fn add { mut diags: Diags, d: Diag } {
        match d.severity {
            error => { diags.errors = diags.errors + 1 }
            warning => {}
        }
        if diags.items.len >= diags.cap {
            diags.dropped = diags.dropped + 1
            return
        }
        try! list::push{ list = &diags.items, item = d }
    }

    fn items { diags: Diags } -> []Diag {
        return list::items{ list = diags.items }
    }

    // Where the diagnostics stand, for rewind.
    struct Mark { len: usize, errors: usize, dropped: usize }

    fn mark { diags: Diags } -> Mark {
        return Mark{ len = diags.items.len, errors = diags.errors, dropped = diags.dropped }
    }

    // Drops what was reported since `to` was taken, for a phase that then has one diagnostic
    // to give in place of all of it.
    fn rewind { mut diags: Diags, to: Mark } {
        diags.items.len = to.len
        diags.errors = to.errors
        diags.dropped = to.dropped
    }
}
