// Text dumps of the front end's results, first written for differential tests against ctxi, the
// Python front end (removed in stage 8). One line per token, then per comment, then per
// diagnostic, with positions as LINE:COL and widths in characters:
//
//   1:1+2 nl kw fn                 a token: position, width, nl if a newline comes before it,
//   1:9+1 op {                     then its class and value
//   3:5-4:7 comment
//   5:1 error unterminated literal

namespace dump {
    type Out = utf8::Builder(arena::Arena)

    fn tokens { mut out: Out, mut heap: arena::Arena, text: []u8, lexed: lexer::Lexed, diags: diag::Diags } {
        let lines = source::line_starts{ text, &heap }
        let mut i: usize = 0
        while i < lexed.tokens.len {
            token{ &out, &heap, text, lines, t = lexed.tokens[i] }
            i = i + 1
        }
        i = 0
        while i < lexed.comments.len {
            let s = lexed.comments[i]
            pos{ &out, p = source::position{ text, lines, offset = s.start } }
            put{ &out, s = "-" }
            pos{ &out, p = source::position{ text, lines, offset = s.end } }
            put{ &out, s = " comment\n" }
            i = i + 1
        }
        let ds = diag::items{ diags }
        i = 0
        while i < ds.len {
            let d = ds[i]
            pos{ &out, p = source::position{ text, lines, offset = d.span.start } }
            put{ &out, s = " error " }
            let mut k: usize = 0
            while k < d.msg.bytes.len {
                let c = d.msg.bytes[k]
                if c == '\n' { put{ &out, s = "\\n" } } else { byte{ &out, c } }
                k = k + 1
            }
            put{ &out, s = "\n" }
            i = i + 1
        }
    }

    fn token { mut out: Out, mut heap: arena::Arena, text: []u8, lines: []u32, t: tok::Token } {
        let s = text[t.span.start..t.span.end]
        pos{ &out, p = source::position{ text, lines, offset = t.span.start } }
        put{ &out, s = "+" }
        let mut width: u64 = 0
        let mut i: usize = 0
        while i < s.len {
            if not utf8::is_cont{ b = s[i] } { width = width + 1 }
            i = i + 1
        }
        _ = utf8::push_u64{ b = &out, n = width }
        if t.nl { put{ &out, s = " nl" } }
        let k = t.kind
        if k == tok::Kind::eof {
            put{ &out, s = " eof" }
        } else if k == tok::Kind::error {
            put{ &out, s = " error" }
        } else if k == tok::Kind::ident {
            put{ &out, s = " id " }
            raw{ &out, s }
        } else if tok::is_keyword{ kind = k } {
            put{ &out, s = " kw " }
            raw{ &out, s }
        } else if tok::is_op{ kind = k } {
            put{ &out, s = " op " }
            raw{ &out, s }
        } else if k == tok::Kind::builtin {
            put{ &out, s = " builtin " }
            raw{ &out, s = s[1..] }
        } else if k == tok::Kind::int or k == tok::Kind::char {
            put{ &out, s = if k == tok::Kind::int { " int " } else { " char " } }
            let v = lexer::int_value{ text = s }
            if v == null {
                put{ &out, s = "toobig" }
            } else {
                _ = utf8::push_u64{ b = &out, n = v }
            }
        } else if k == tok::Kind::float {
            put{ &out, s = " float " }
            _ = utf8::push_f64{ b = &out, n = lexer::float_value{ &heap, text = s } }
        } else {
            put{ &out, s = " str \"" }
            let bytes = lexer::str_value{ &heap, text = s }
            i = 0
            while i < bytes.len {
                let c = bytes[i]
                if c >= 32 and c < 127 and c != '"' and c != '\\' {
                    byte{ &out, c }
                } else {
                    put{ &out, s = "\\x" }
                    byte{ &out, c = hex_digit{ n = c / 16 } }
                    byte{ &out, c = hex_digit{ n = c % 16 } }
                }
                i = i + 1
            }
            put{ &out, s = "\"" }
        }
        put{ &out, s = "\n" }
    }

    fn pos { mut out: Out, p: source::Pos } {
        _ = utf8::push_u64{ b = &out, n = p.line }
        put{ &out, s = ":" }
        _ = utf8::push_u64{ b = &out, n = p.col }
    }

    fn hex_digit { n: u8 } -> u8 {
        if n < 10 { return '0' + n }
        return 'a' + n - 10
    }

    fn put { mut out: Out, s: utf8::String } {
        try! utf8::push{ b = &out, s }
    }

    // Source bytes, which the lexer has checked are valid UTF-8 wherever it made a token.
    fn raw { mut out: Out, s: []u8 } {
        put{ &out, s = utf8::String{ bytes = s } }
    }

    // One byte, which may be part of a character.
    fn byte { mut out: Out, c: u8 } {
        try! list::push{ list = &out.bytes, item = c }
    }
}

// A syntax tree, one node per line, children indented by two spaces. A line starts with the
// node's position, except for `-` (an absent optional child) and `else` (the other side of a
// let-else). Then the diagnostics, as for tokens.
//
//   1:1 fn main
//     1:9 field mut io
//       1:17 tpath
//         1:17 seg Io
//     -
//     1:22 block
namespace tree {
    struct Dumper { out: *mut dump::Out, text: []u8, lines: []u32, depth: u32 }

    fn file { mut out: dump::Out, mut heap: arena::Arena, text: []u8, f: syntax::File, diags: diag::Diags } {
        let lines = source::line_starts{ text, &heap }
        let mut d = Dumper{ out = &out, text, lines, depth = 0 }
        let mut i: usize = 0
        while i < f.decls.len {
            decl{ &d, x = f.decls[i] }
            i = i + 1
        }
        let ds = diag::items{ diags }
        i = 0
        while i < ds.len {
            let g = ds[i]
            dump::pos{ &out, p = source::position{ text, lines, offset = g.span.start } }
            dump::put{ &out, s = " error " }
            let mut k: usize = 0
            while k < g.msg.bytes.len {
                let c = g.msg.bytes[k]
                if c == '\n' { dump::put{ &out, s = "\\n" } } else { dump::byte{ &out, c } }
                k = k + 1
            }
            dump::put{ &out, s = "\n" }
            i = i + 1
        }
    }

    // ---- lines

    // Starts a line at offset `at`.
    fn start { mut d: Dumper, at: u32 } {
        indent{ &d }
        dump::pos{ out = d.out, p = source::position{ text = d.text, lines = d.lines, offset = at } }
        put{ &d, s = " " }
    }

    fn indent { mut d: Dumper } {
        let mut i: u32 = 0
        while i < d.depth {
            put{ &d, s = "  " }
            i = i + 1
        }
    }

    fn put { mut d: Dumper, s: utf8::String } {
        dump::put{ out = d.out, s }
    }

    fn raw { mut d: Dumper, s: []u8 } {
        dump::raw{ out = d.out, s }
    }

    fn end { mut d: Dumper } {
        put{ &d, s = "\n" }
    }

    // A line holding `s` alone, at `at`.
    fn line { mut d: Dumper, at: u32, s: utf8::String } {
        start{ &d, at }
        put{ &d, s }
        end{ &d }
    }

    fn none { mut d: Dumper } {
        indent{ &d }
        put{ &d, s = "-\n" }
    }

    fn name { mut d: Dumper, n: syntax::Name } {
        if n.text.len == 0 { put{ &d, s = "<missing>" } } else { raw{ &d, s = n.text } }
    }

    // `kind NAME(T,U)`
    fn named { mut d: Dumper, at: u32, kind: utf8::String, n: syntax::Name, tparams: []syntax::Name } {
        start{ &d, at }
        put{ &d, s = kind }
        put{ &d, s = " " }
        name{ &d, n }
        if tparams.len > 0 {
            put{ &d, s = "(" }
            let mut i: usize = 0
            while i < tparams.len {
                if i > 0 { put{ &d, s = "," } }
                name{ &d, n = tparams[i] }
                i = i + 1
            }
            put{ &d, s = ")" }
        }
        end{ &d }
    }

    // ---- declarations

    fn decl { mut d: Dumper, x: syntax::Decl } {
        let at = x.span.start
        let untyped: []syntax::Name = slice::empty(syntax::Name){}
        let mut i: usize = 0
        while i < x.attrs.len {
            line{ &d, at = x.attrs[i].span.start, s = "attr" }
            d.depth = d.depth + 1
            expr{ &d, e = x.attrs[i].value }
            d.depth = d.depth - 1
            i = i + 1
        }
        match x.k {
            error => { line{ &d, at, s = "invalid" } }
            func{ name = n, tparams, params, ret, body, external } => {
                named{ &d, at, kind = if external { "extern fn" } else { "fn" }, n, tparams }
                d.depth = d.depth + 1
                param_list{ &d, xs = params }
                opt_type{ &d, t = ret }
                if not external { block{ &d, b = body } }
                d.depth = d.depth - 1
            }
            record{ name = n, tparams, fields, untagged } => {
                named{ &d, at, kind = if untagged { "extern union" } else { "struct" }, n, tparams }
                d.depth = d.depth + 1
                field_list{ &d, xs = fields }
                d.depth = d.depth - 1
            }
            sum{ name = n, tparams, variants } => {
                named{ &d, at, kind = "union", n, tparams }
                d.depth = d.depth + 1
                let mut i: usize = 0
                while i < variants.len {
                    let v = variants[i]
                    start{ &d, at = v.span.start }
                    put{ &d, s = "variant " }
                    name{ &d, n = v.name }
                    let fields = v.fields
                    if fields != null { put{ &d, s = "{}" } }
                    end{ &d }
                    if fields != null {
                        d.depth = d.depth + 1
                        field_list{ &d, xs = fields }
                        d.depth = d.depth - 1
                    }
                    i = i + 1
                }
                d.depth = d.depth - 1
            }
            enumeration{ name = n, base, variants } => {
                named{ &d, at, kind = "enum", n, tparams = untyped }
                d.depth = d.depth + 1
                type_expr{ &d, t = base }
                let mut i: usize = 0
                while i < variants.len {
                    let v = variants[i]
                    start{ &d, at = v.span.start }
                    put{ &d, s = "variant " }
                    name{ &d, n = v.name }
                    end{ &d }
                    let value = v.value
                    if value != null {
                        d.depth = d.depth + 1
                        expr{ &d, e = value }
                        d.depth = d.depth - 1
                    }
                    i = i + 1
                }
                d.depth = d.depth - 1
            }
            alias{ name = n, tparams, ty } => {
                named{ &d, at, kind = "type", n, tparams }
                sub_type{ &d, t = ty }
            }
            constant{ name = n, ty, value } => {
                named{ &d, at, kind = "const", n, tparams = untyped }
                d.depth = d.depth + 1
                type_expr{ &d, t = ty }
                expr{ &d, e = value }
                d.depth = d.depth - 1
            }
            cap{ name = n, fields, includes } => {
                named{ &d, at, kind = "capability", n, tparams = untyped }
                if fields == null {
                    end{ &d }
                } else {
                    // Each `..Name` where it stands among the fields, which sets the layout.
                    d.depth = d.depth + 1
                    let mut j: usize = 0
                    let mut i: usize = 0
                    while i <= fields.len {
                        while j < includes.len and includes[j].at == i {
                            start{ &d, at = includes[j].span.start }
                            put{ &d, s = "include" }
                            end{ &d }
                            sub_type{ &d, t = includes[j].ty }
                            j = j + 1
                        }
                        if i == fields.len { break }
                        field_list{ &d, xs = fields[i..i + 1] }
                        i = i + 1
                    }
                    d.depth = d.depth - 1
                }
            }
            fault{ name = n, fields } => {
                named{ &d, at, kind = "error", n, tparams = untyped }
                if fields == null {
                    end{ &d }
                } else {
                    d.depth = d.depth + 1
                    field_list{ &d, xs = fields }
                    d.depth = d.depth - 1
                }
            }
            space{ name = n, decls } => {
                named{ &d, at, kind = "namespace", n, tparams = untyped }
                d.depth = d.depth + 1
                let mut i: usize = 0
                while i < decls.len {
                    decl{ &d, x = decls[i] }
                    i = i + 1
                }
                d.depth = d.depth - 1
            }
        }
    }

    fn param_list { mut d: Dumper, xs: []syntax::Param } {
        let mut i: usize = 0
        while i < xs.len {
            let f = xs[i]
            start{ &d, at = f.span.start }
            put{ &d, s = if f.mutable { "field mut " } else { "field " } }
            name{ &d, n = f.name }
            end{ &d }
            sub_type{ &d, t = f.ty }
            i = i + 1
        }
    }

    fn field_list { mut d: Dumper, xs: []syntax::Field } {
        let mut i: usize = 0
        while i < xs.len {
            let f = xs[i]
            let mut k: usize = 0
            while k < f.attrs.len {
                line{ &d, at = f.attrs[k].span.start, s = "attr" }
                d.depth = d.depth + 1
                expr{ &d, e = f.attrs[k].value }
                d.depth = d.depth - 1
                k = k + 1
            }
            start{ &d, at = f.span.start }
            put{ &d, s = if f.external { "extern field " } else if f.stat { "static field " } else { "field " } }
            name{ &d, n = f.name }
            end{ &d }
            sub_type{ &d, t = f.ty }
            i = i + 1
        }
    }

    // ---- types

    fn opt_type { mut d: Dumper, t: ?syntax::TypeExpr } {
        if t == null { none{ &d } } else { type_expr{ &d, t } }
    }

    fn type_expr { mut d: Dumper, t: syntax::TypeExpr } {
        let at = t.span.start
        match t.k {
            error => { line{ &d, at, s = "invalid" } }
            path{ segs } => {
                line{ &d, at, s = "tpath" }
                seg_list{ &d, segs }
            }
            ptr{ mutable, elem } => {
                line{ &d, at, s = if mutable { "tptr mut" } else { "tptr" } }
                sub_type{ &d, t = elem.* }
            }
            opt{ elem } => {
                line{ &d, at, s = "topt" }
                sub_type{ &d, t = elem.* }
            }
            fail{ elem, set } => {
                line{ &d, at, s = "tfail" }
                if set != null { sub_type{ &d, t = set.* } }
                if elem != null { sub_type{ &d, t = elem.* } }
            }
            slice{ mutable, elem } => {
                line{ &d, at, s = if mutable { "tslice mut" } else { "tslice" } }
                sub_type{ &d, t = elem.* }
            }
            array{ n, elem } => {
                line{ &d, at, s = "tarray" }
                d.depth = d.depth + 1
                expr{ &d, e = n.* }
                type_expr{ &d, t = elem.* }
                d.depth = d.depth - 1
            }
            func{ bound, params, ret, external } => {
                line{ &d, at, s = if bound { "tfn bound" } else if external { "tfn extern" } else { "tfn" } }
                d.depth = d.depth + 1
                param_list{ &d, xs = params }
                if ret == null { none{ &d } } else { type_expr{ &d, t = ret.* } }
                d.depth = d.depth - 1
            }
        }
    }

    fn sub_type { mut d: Dumper, t: syntax::TypeExpr } {
        d.depth = d.depth + 1
        type_expr{ &d, t }
        d.depth = d.depth - 1
    }

    // The segments of a path, one level down.
    fn seg_list { mut d: Dumper, segs: []syntax::Seg } {
        d.depth = d.depth + 1
        let mut i: usize = 0
        while i < segs.len {
            let s = segs[i]
            start{ &d, at = s.name.span.start }
            put{ &d, s = "seg " }
            name{ &d, n = s.name }
            let targs = s.targs
            if targs != null { put{ &d, s = "()" } }
            end{ &d }
            if targs != null {
                d.depth = d.depth + 1
                let mut k: usize = 0
                while k < targs.len {
                    type_expr{ &d, t = targs[k] }
                    k = k + 1
                }
                d.depth = d.depth - 1
            }
            i = i + 1
        }
        d.depth = d.depth - 1
    }

    // ---- statements

    fn block { mut d: Dumper, b: syntax::Block } {
        line{ &d, at = b.span.start, s = "block" }
        d.depth = d.depth + 1
        let mut i: usize = 0
        while i < b.stmts.len {
            stmt{ &d, s = b.stmts[i] }
            i = i + 1
        }
        d.depth = d.depth - 1
    }

    fn opt_expr { mut d: Dumper, e: ?syntax::Expr } {
        if e == null { none{ &d } } else { expr{ &d, e } }
    }

    fn opt_sub { mut d: Dumper, e: ?*syntax::Expr } {
        if e == null { none{ &d } } else { expr{ &d, e = e.* } }
    }

    fn binder_list { mut d: Dumper, xs: []syntax::Binder } {
        let mut i: usize = 0
        while i < xs.len {
            let b = xs[i]
            start{ &d, at = b.span.start }
            put{ &d, s = if b.by_ref { "bind &" } else { "bind " } }
            name{ &d, n = b.field }
            let local = b.local
            if local != null and not slice::eq_bytes{ a = local.text, b = b.field.text } {
                put{ &d, s = " = " }
                name{ &d, n = local }
            }
            end{ &d }
            i = i + 1
        }
    }

    // `word` or `word LABEL`
    fn jump { mut d: Dumper, at: u32, word: utf8::String, label: ?syntax::Name } {
        start{ &d, at }
        put{ &d, s = word }
        if label != null {
            put{ &d, s = " " }
            name{ &d, n = label }
        }
        end{ &d }
    }

    fn stmt { mut d: Dumper, s: syntax::Stmt } {
        let at = s.span.start
        match s.k {
            error => { line{ &d, at, s = "invalid" } }
            local{ mutable, name = n, ty, init } => {
                start{ &d, at }
                put{ &d, s = if mutable { "let mut " } else { "let " } }
                name{ &d, n }
                end{ &d }
                d.depth = d.depth + 1
                opt_type{ &d, t = ty }
                opt_expr{ &d, e = init }
                d.depth = d.depth - 1
            }
            let_else{ variant, binders, init, els_variant, els_binders, els } => {
                start{ &d, at }
                put{ &d, s = "letelse " }
                name{ &d, n = variant }
                end{ &d }
                d.depth = d.depth + 1
                binder_list{ &d, xs = binders }
                expr{ &d, e = init }
                indent{ &d }
                put{ &d, s = "else" }
                if els_variant != null {
                    put{ &d, s = " " }
                    name{ &d, n = els_variant }
                }
                end{ &d }
                d.depth = d.depth + 1
                binder_list{ &d, xs = els_binders }
                d.depth = d.depth - 1
                block{ &d, b = els }
                d.depth = d.depth - 1
            }
            assign{ place, value } => {
                line{ &d, at, s = "assign" }
                d.depth = d.depth + 1
                expr{ &d, e = place }
                expr{ &d, e = value }
                d.depth = d.depth - 1
            }
            eval{ e } => {
                line{ &d, at, s = "do" }
                sub{ &d, e }
            }
            discard{ e } => {
                line{ &d, at, s = "discard" }
                sub{ &d, e }
            }
            cond{ x } => { if_node{ &d, at, x } }
            loop{ label, c, body } => {
                start{ &d, at }
                put{ &d, s = "while" }
                if label != null {
                    put{ &d, s = " " }
                    name{ &d, n = label }
                    put{ &d, s = " " }
                    dump::pos{ out = d.out, p = source::position{ text = d.text, lines = d.lines, offset = label.span.start } }
                }
                end{ &d }
                d.depth = d.depth + 1
                expr{ &d, e = c }
                block{ &d, b = body }
                d.depth = d.depth - 1
            }
            choose{ x } => { match_node{ &d, at, x } }
            ret{ value } => {
                line{ &d, at, s = "return" }
                if value != null { sub{ &d, e = value } }
            }
            brk{ label } => { jump{ &d, at, word = "break", label } }
            cont{ label } => { jump{ &d, at, word = "continue", label } }
            deferred{ body } => {
                line{ &d, at, s = "defer" }
                d.depth = d.depth + 1
                block{ &d, b = body }
                d.depth = d.depth - 1
            }
        }
    }

    fn if_node { mut d: Dumper, at: u32, x: syntax::If } {
        line{ &d, at, s = "if" }
        d.depth = d.depth + 1
        expr{ &d, e = x.c.* }
        block{ &d, b = x.then }
        let els = x.els
        if els == null { none{ &d } } else { block{ &d, b = els } }
        d.depth = d.depth - 1
    }

    fn match_node { mut d: Dumper, at: u32, x: syntax::Match } {
        line{ &d, at, s = if x.is_ifnull { "match ifnull" } else if x.is_iferr { "match iferr" } else { "match" } }
        d.depth = d.depth + 1
        expr{ &d, e = x.scrut.* }
        let mut i: usize = 0
        while i < x.arms.len {
            let arm = x.arms[i]
            line{ &d, at = arm.span.start, s = "arm" }
            d.depth = d.depth + 1
            let mut k: usize = 0
            while k < arm.pats.len {
                pattern{ &d, pat = arm.pats[k] }
                k = k + 1
            }
            block{ &d, b = arm.body }
            d.depth = d.depth - 1
            i = i + 1
        }
        d.depth = d.depth - 1
    }

    fn pattern { mut d: Dumper, pat: syntax::Pattern } {
        start{ &d, at = pat.span.start }
        put{ &d, s = "pat " }
        let mut q: usize = 0
        while q < pat.quals.len {
            name{ &d, n = pat.quals[q] }
            put{ &d, s = "::" }
            q = q + 1
        }
        name{ &d, n = pat.variant }
        end{ &d }
        d.depth = d.depth + 1
        binder_list{ &d, xs = pat.binders }
        d.depth = d.depth - 1
    }

    // ---- expressions

    fn sub { mut d: Dumper, e: syntax::Expr } {
        d.depth = d.depth + 1
        expr{ &d, e }
        d.depth = d.depth - 1
    }

    fn expr { mut d: Dumper, e: syntax::Expr } {
        let at = e.at
        match e.k {
            error => { line{ &d, at, s = "invalid" } }
            int{ negative, value } => {
                start{ &d, at }
                put{ &d, s = "int " }
                if value == null {
                    put{ &d, s = if negative { "-toobig" } else { "toobig" } }
                } else {
                    if negative and value != 0 { put{ &d, s = "-" } }
                    _ = utf8::push_u64{ b = d.out, n = value }
                }
                end{ &d }
            }
            float{ negative, value } => {
                start{ &d, at }
                put{ &d, s = if negative { "float -" } else { "float " } }
                _ = utf8::push_f64{ b = d.out, n = value }
                end{ &d }
            }
            str{ bytes } => {
                start{ &d, at }
                put{ &d, s = "str \"" }
                let mut i: usize = 0
                while i < bytes.len {
                    let c = bytes[i]
                    if c >= 32 and c < 127 and c != '"' and c != '\\' {
                        dump::byte{ out = d.out, c }
                    } else {
                        put{ &d, s = "\\x" }
                        dump::byte{ out = d.out, c = dump::hex_digit{ n = c / 16 } }
                        dump::byte{ out = d.out, c = dump::hex_digit{ n = c % 16 } }
                    }
                    i = i + 1
                }
                put{ &d, s = "\"" }
                end{ &d }
            }
            boolean{ value } => { line{ &d, at, s = if value { "true" } else { "false" } } }
            nil => { line{ &d, at, s = "null" } }
            path{ segs } => {
                line{ &d, at, s = "path" }
                seg_list{ &d, segs }
            }
            field{ base, name = n } => {
                start{ &d, at }
                put{ &d, s = "dot " }
                name{ &d, n }
                end{ &d }
                sub{ &d, e = base.* }
            }
            deref{ base } => {
                line{ &d, at, s = "deref" }
                sub{ &d, e = base.* }
            }
            index{ base, i } => {
                line{ &d, at, s = "index" }
                d.depth = d.depth + 1
                expr{ &d, e = base.* }
                expr{ &d, e = i.* }
                d.depth = d.depth - 1
            }
            range{ base, lo, hi } => {
                line{ &d, at, s = "range" }
                d.depth = d.depth + 1
                expr{ &d, e = base.* }
                opt_sub{ &d, e = lo }
                opt_sub{ &d, e = hi }
                d.depth = d.depth - 1
            }
            braced{ callee, items, forward, bind } => {
                start{ &d, at }
                put{ &d, s = "braced" }
                if forward { put{ &d, s = " .." } }
                if bind { put{ &d, s = " _" } }
                end{ &d }
                d.depth = d.depth + 1
                expr{ &d, e = callee.* }
                let mut i: usize = 0
                while i < items.len {
                    let item = items[i]
                    start{ &d, at = item.span.start }
                    if item.spread {
                        put{ &d, s = "spread" }
                    } else {
                        put{ &d, s = "item " }
                        name{ &d, n = item.name }
                    }
                    end{ &d }
                    sub{ &d, e = item.value }
                    i = i + 1
                }
                d.depth = d.depth - 1
            }
            neg{ e = x } => {
                line{ &d, at, s = "neg" }
                sub{ &d, e = x.* }
            }
            lnot{ e = x } => {
                line{ &d, at, s = "not" }
                sub{ &d, e = x.* }
            }
            addr{ e = x } => {
                line{ &d, at, s = "addr" }
                sub{ &d, e = x.* }
            }
            binary{ op, a, b } => {
                start{ &d, at }
                put{ &d, s = "binary " }
                raw{ &d, s = parser::kind_text{ k = op } }
                end{ &d }
                d.depth = d.depth + 1
                expr{ &d, e = a.* }
                expr{ &d, e = b.* }
                d.depth = d.depth - 1
            }
            array{ elems } => {
                line{ &d, at, s = "array" }
                d.depth = d.depth + 1
                let mut i: usize = 0
                while i < elems.len {
                    expr{ &d, e = elems[i] }
                    i = i + 1
                }
                d.depth = d.depth - 1
            }
            repeat{ elem, count } => {
                line{ &d, at, s = "repeat" }
                d.depth = d.depth + 1
                expr{ &d, e = elem.* }
                expr{ &d, e = count.* }
                d.depth = d.depth - 1
            }
            builtin{ name = n, targ, args } => {
                start{ &d, at }
                put{ &d, s = "@" }
                name{ &d, n }
                end{ &d }
                d.depth = d.depth + 1
                if targ != null { type_expr{ &d, t = targ.* } }
                let mut i: usize = 0
                while i < args.len {
                    expr{ &d, e = args[i] }
                    i = i + 1
                }
                d.depth = d.depth - 1
            }
            ifx{ x } => { if_node{ &d, at, x } }
            matchx{ x } => { match_node{ &d, at, x } }
            trye{ e = x, panics } => {
                line{ &d, at, s = if panics { "try!" } else { "try" } }
                sub{ &d, e = x.* }
            }
            isx{ e = x, pats } => {
                line{ &d, at, s = "is" }
                d.depth = d.depth + 1
                expr{ &d, e = x.* }
                let mut i: usize = 0
                while i < pats.len {
                    pattern{ &d, pat = pats[i] }
                    i = i + 1
                }
                d.depth = d.depth - 1
            }
        }
    }
}

// The checked program: the diagnostics first, as `error FILE:LINE:COL MSG`, then one line per declaration, in the
// files' order and into namespaces, with const initializers and function bodies under theirs,
// then `main` if it is valid.
//
//   struct arena::Arena 24 8
//     buf: []mut u8 @0
//   fn arena::new { buf: []mut u8 } -> arena::Arena
namespace decls {
    type Out = dump::Out

    fn file { mut out: Out, mut c: check::Checker } {
        let ds = diag::items{ diags = c.diags.* }
        let mut i: usize = 0
        while i < ds.len {
            diagnostic{ &out, c, d = ds[i] }
            i = i + 1
        }
        let mut f: usize = 0
        while f < c.files.len {
            list_decls{ &out, &c, file = @as(u32, f), xs = c.files[f].tree.decls }
            f = f + 1
        }
        if c.main != check::NONE { dump::put{ &out, s = "main\n" } }
    }

    fn diagnostic { mut out: Out, c: check::Checker, d: diag::Diag } {
        if d.span.file == check::NO_FILE {
            try! @fmt(&out, "error :1:1 ")
        } else {
            let f = c.files[d.span.file]
            let p = source::position{ text = f.text, lines = f.lines, offset = d.span.start }
            try! @fmt(&out, "error {}:{}:{} ", check::str{ s = f.name }, p.line, p.col)
        }
        let mut k: usize = 0
        while k < d.msg.bytes.len {
            let ch = d.msg.bytes[k]
            if ch == 10 { dump::put{ &out, s = "\\n" } } else { dump::byte{ &out, c = ch } }
            k = k + 1
        }
        dump::put{ &out, s = "\n" }
    }

    fn list_decls { mut out: Out, mut c: check::Checker, file: u32, xs: []syntax::Decl } {
        let mut i: usize = 0
        while i < xs.len {
            let x = xs[i]
            let key = check::key{ file, id = x.id }
            match x.k {
                space{ decls } => {
                    let ns = map::get{ m = c.space_of, key }
                    if ns != null {
                        try! @fmt(&out, "namespace {}\n", check::str{ s = check::get_space{ c, ns }.qual })
                    }
                    list_decls{ &out, &c, file, xs = decls }
                }
                else => {
                    let d = map::get{ m = c.decl_of, key }
                    if d != null { decl{ &out, &c, i = d } }
                }
            }
            i = i + 1
        }
    }

    fn decl { mut out: Out, mut c: check::Checker, i: u32 } {
        let d = check::get_decl{ c, d = i }
        let q = check::str{ s = d.qual }
        let generic = d.tparams.len > 0
        match d.kind {
            record => {
                let word: utf8::String = if check::is_untagged{ c, d = i } { "extern union" } else { "struct" }
                try! @fmt(&out, "{} {}", word, q)
                try! tparams{ d, b = &out }
                let t = check::types_of_decl{ &c, d = i }
                let mut offs: []u64 = slice::empty(u64){}
                if not generic {
                    let o = check::struct_offsets{ &c, t }
                    if o == null {
                        dump::put{ &out, s = " ?" }
                    } else {
                        try! @fmt(&out, " {} {}", o.layout.size, o.layout.align)
                        offs = o.offs
                    }
                }
                dump::put{ &out, s = "\n" }
                let mut j: usize = 0
                while j < d.fields.len {
                    let f = d.fields[j]
                    try! @fmt(&out, "  {}: {}", check::str{ s = f.name }, check::tstr{ c, t = f.ty })
                    if j < offs.len { try! @fmt(&out, " @{}", offs[j]) }
                    dump::put{ &out, s = "\n" }
                    j = j + 1
                }
            }
            sum => {
                try! @fmt(&out, "union {}", q)
                try! tparams{ d, b = &out }
                let t = check::types_of_decl{ &c, d = i }
                let mut offs: [][]mut u64 = slice::empty([]mut u64){}
                if not generic {
                    let o = check::union_offsets{ &c, t }
                    if o == null {
                        dump::put{ &out, s = " ?" }
                    } else {
                        try! @fmt(&out, " {} {} {}", o.layout.size, o.layout.align, o.pay_off)
                        offs = o.offs
                    }
                }
                dump::put{ &out, s = "\n" }
                let mut j: usize = 0
                while j < d.variants.len {
                    let v = d.variants[j]
                    try! @fmt(&out, "  {}", check::str{ s = v.name })
                    let fs = v.fields
                    if fs != null {
                        dump::put{ &out, s = if fs.len == 0 { "{}" } else { "{ " } }
                        let mut k: usize = 0
                        while k < fs.len {
                            if k > 0 { dump::put{ &out, s = ", " } }
                            try! @fmt(&out, "{}: {}", check::str{ s = fs[k].name }, check::tstr{ c, t = fs[k].ty })
                            if j < offs.len and k < offs[j].len { try! @fmt(&out, " @{}", offs[j][k]) }
                            k = k + 1
                        }
                        if fs.len > 0 { dump::put{ &out, s = " }" } }
                    }
                    dump::put{ &out, s = "\n" }
                    j = j + 1
                }
            }
            enumeration => {
                try! @fmt(&out, "enum {}: {}\n", q, check::tstr{ c, t = d.ty })
                if d.syn.k is enumeration{ variants } {
                    let mut j: usize = 0
                    while j < variants.len and j < d.values.len {
                        try! @fmt(&out, "  {} = {}\n", check::str{ s = variants[j].name.text }, d.values[j])
                        j = j + 1
                    }
                }
            }
            alias => {
                if generic {
                    try! @fmt(&out, "type {}", q)
                    try! tparams{ d, b = &out }
                    try! @fmt(&out, "\n")
                } else {
                    try! @fmt(&out, "type {} = {}\n", q, check::tstr{ c, t = d.ty })
                }
            }
            constant => {
                try! @fmt(&out, "const {}: {}\n", q, check::tstr{ c, t = d.ty })
                if d.syn.k is constant{ value } { expr{ &out, c, e = value, depth = 1 } }
                let v = map::get{ m = c.values, key = i }
                if v != null {
                    dump::put{ &out, s = "  value " }
                    value{ &out, c, v }
                    dump::put{ &out, s = "\n" }
                }
            }
            func => {
                try! @fmt(&out, "fn {}", q)
                try! tparams{ d, b = &out }
                try! @fmt(&out, " ")
                try! sig{ c, d, b = &out }
                try! @fmt(&out, "\n")
                if d.syn.k is func{ body } { stmts{ &out, c, xs = body.stmts, depth = 1 } }
            }
            fault => {
                try! @fmt(&out, "error {}", q)
                let fs = check::fault_fields{ c, d = i }
                if fs != null { dump::put{ &out, s = if fs.len == 0 { "{}" } else { "{ " } } }
                let all = d.fields
                let mut j: usize = 0
                while j < all.len {
                    if j > 0 { dump::put{ &out, s = ", " } }
                    try! @fmt(&out, "{}: {}", check::str{ s = all[j].name }, check::tstr{ c, t = all[j].ty })
                    j = j + 1
                }
                if all.len > 0 { dump::put{ &out, s = " }" } }
                dump::put{ &out, s = "\n" }
            }
            cap => {
                try! @fmt(&out, "capability {}", q)
                let o = check::struct_offsets{ &c, t = types::cap{ s = &c.ty, decl = i } }
                if d.fields.len > 0 and o != null { try! @fmt(&out, " {} {}", o.layout.size, o.layout.align) }
                dump::put{ &out, s = "\n" }
                let mut j: usize = 0
                while j < d.fields.len {
                    let f = d.fields[j]
                    try! @fmt(&out, "  {}: {}", check::str{ s = f.name }, check::tstr{ c, t = f.ty })
                    if o != null and j < o.offs.len { try! @fmt(&out, " @{}", o.offs[j]) }
                    dump::put{ &out, s = "\n" }
                    j = j + 1
                }
                j = 0
                while j < d.vars.len {
                    let v = d.vars[j]
                    let kw: []u8 = if v.stat { "static" } else { "extern" }
                    try! @fmt(&out, "  {} {}: {}\n", check::str{ s = kw }, check::str{ s = v.name }, check::tstr{ c, t = v.ty })
                    j = j + 1
                }
            }
            external => {
                try! @fmt(&out, "extern fn {} = {} ", q, check::str{ s = d.symbol })
                try! sig{ c, d, b = &out }
                try! @fmt(&out, "\n")
            }
        }
    }

    // ---- bodies: a line per statement, children indented under it

    fn stmts { mut out: Out, c: check::Checker, xs: []syntax::Stmt, depth: u32 } {
        let mut i: usize = 0
        while i < xs.len {
            stmt{ &out, c, s = xs[i], depth }
            i = i + 1
        }
    }

    fn line { mut out: Out, depth: u32, s: utf8::String } {
        indent{ &out, depth }
        try! @fmt(&out, "{}\n", s)
    }

    // `word` or `word LABEL`
    fn labeled { mut out: Out, depth: u32, word: utf8::String, label: ?syntax::Name } {
        indent{ &out, depth }
        dump::put{ &out, s = word }
        if label != null { try! @fmt(&out, " {}", check::str{ s = label.text }) }
        dump::put{ &out, s = "\n" }
    }

    fn stmt { mut out: Out, c: check::Checker, s: syntax::Stmt, depth: u32 } {
        let d = depth + 1
        match s.k {
            error => { line{ &out, depth, s = "error" } }
            local{ mutable, name, init } => {
                indent{ &out, depth }
                let m: utf8::String = if mutable { "mut " } else { "" }
                try! @fmt(&out, "let {}{}: {}\n", m, check::str{ s = name.text }, local_ty{ c, k = check::stmt_key{ s } })
                if init != null { expr{ &out, c, e = init, depth = d } }
            }
            let_else{ variant, binders, init, els_variant, els_binders, els } => {
                indent{ &out, depth }
                try! @fmt(&out, "letelse {}\n", check::str{ s = variant.text })
                expr{ &out, c, e = init, depth = d }
                binds{ &out, c, xs = binders, depth = d }
                labeled{ &out, depth = d, word = "else", label = els_variant }
                binds{ &out, c, xs = els_binders, depth = d + 1 }
                stmts{ &out, c, xs = els.stmts, depth = d + 1 }
            }
            assign{ place, value } => {
                line{ &out, depth, s = "assign" }
                expr{ &out, c, e = place, depth = d }
                expr{ &out, c, e = value, depth = d }
            }
            eval{ e } => {
                line{ &out, depth, s = "eval" }
                expr{ &out, c, e, depth = d }
            }
            discard{ e } => {
                line{ &out, depth, s = "discard" }
                expr{ &out, c, e, depth = d }
            }
            cond{ x } => {
                line{ &out, depth, s = "if" }
                if_parts{ &out, c, x, depth = d, value = false }
            }
            loop{ label, c = cond, body } => {
                labeled{ &out, depth, word = "while", label }
                expr{ &out, c, e = cond, depth = d }
                line{ &out, depth = d, s = "do" }
                stmts{ &out, c, xs = body.stmts, depth = d + 1 }
            }
            choose{ x } => {
                line{ &out, depth, s = "match" }
                match_parts{ &out, c, x, depth = d, value = false }
            }
            ret{ value } => {
                line{ &out, depth, s = "return" }
                if value != null { expr{ &out, c, e = value, depth = d } }
            }
            brk{ label } => { labeled{ &out, depth, word = "break", label } }
            cont{ label } => { labeled{ &out, depth, word = "continue", label } }
            deferred{ body } => {
                line{ &out, depth, s = "defer" }
                stmts{ &out, c, xs = body.stmts, depth = d }
            }
        }
    }

    // The type of the local a `let` or a binder declares.
    fn local_ty { c: check::Checker, k: u64 } -> utf8::String {
        let v = map::get{ m = c.local_of, key = k }
        if v == null { return "none" }
        return check::tstr{ c, t = check::get_var{ c, v }.ty }
    }

    // `bind [&]NAME: T` for each binding of a pattern.
    fn binds { mut out: Out, c: check::Checker, xs: []syntax::Binder, depth: u32 } {
        let mut i: usize = 0
        while i < xs.len {
            let v = map::get{ m = c.local_of, key = check::name_key{ n = xs[i].field } }
            if v != null {
                let x = check::get_var{ c, v }
                indent{ &out, depth }
                let amp: utf8::String = if x.indirect { "&" } else { "" }
                try! @fmt(&out, "bind {}{}: {}\n", amp, check::str{ s = x.name }, check::tstr{ c, t = x.ty })
            }
            i = i + 1
        }
    }

    fn if_parts { mut out: Out, c: check::Checker, x: syntax::If, depth: u32, value: bool } {
        expr{ &out, c, e = x.c.*, depth }
        line{ &out, depth, s = "then" }
        block{ &out, c, b = x.then, depth = depth + 1, value }
        let els = x.els
        if els != null {
            line{ &out, depth, s = "else" }
            block{ &out, c, b = els, depth = depth + 1, value }
        }
    }

    fn match_parts { mut out: Out, c: check::Checker, x: syntax::Match, depth: u32, value: bool } {
        expr{ &out, c, e = x.scrut.*, depth }
        let mut i: usize = 0
        while i < x.arms.len {
            let arm = x.arms[i]
            indent{ &out, depth }
            dump::put{ &out, s = "arm " }
            if arm.pats.len == 0 { dump::put{ &out, s = "else" } }
            let mut k: usize = 0
            while k < arm.pats.len {
                if k > 0 { dump::put{ &out, s = " | " } }
                dump::put{ &out, s = check::str{ s = arm.pats[k].variant.text } }
                k = k + 1
            }
            dump::put{ &out, s = "\n" }
            if arm.pats.len > 0 { binds{ &out, c, xs = arm.pats[0].binders, depth = depth + 1 } }
            block{ &out, c, b = arm.body, depth = depth + 1, value }
            i = i + 1
        }
    }

    // A block of an `if` or `match`. A branch of an expression (value) ends in `value` over what
    // gives it its value, if anything does.
    fn block { mut out: Out, c: check::Checker, b: syntax::Block, depth: u32, value: bool } {
        let xs = b.stmts
        if not value or xs.len == 0 {
            stmts{ &out, c, xs, depth }
            return
        }
        match check::branch_value{ s = xs[xs.len - 1] } {
            none => { stmts{ &out, c, xs, depth } }
            expr{ e } => {
                stmts{ &out, c, xs = xs[..xs.len - 1], depth }
                line{ &out, depth, s = "value" }
                expr{ &out, c, e, depth = depth + 1 }
            }
            nested{ s } => {
                stmts{ &out, c, xs = xs[..xs.len - 1], depth }
                line{ &out, depth, s = "value" }
                let k = check::stmt_key{ s }
                let d = wrap{ &out, c, k, depth = depth + 1 }
                match s.k {
                    cond{ x } => {
                        indent{ &out, depth = d }
                        try! @fmt(&out, "if {}\n", ty_at{ c, k })
                        if_parts{ &out, c, x, depth = d + 1, value = true }
                    }
                    choose{ x } => {
                        indent{ &out, depth = d }
                        try! @fmt(&out, "match {}\n", ty_at{ c, k })
                        match_parts{ &out, c, x, depth = d + 1, value = true }
                    }
                    else => {}
                }
            }
        }
    }

    // The type recorded for the expression (or branch value) with key k, or `none`.
    fn ty_at { c: check::Checker, k: u64 } -> utf8::String {
        let t = map::get{ m = c.expr_ty, key = k }
        if t == null or t == types::NO_TYPE { return "none" }
        return check::tstr{ c, t }
    }

    // The conversion of the value with key k, if it has one, as the lines around it. Returns the
    // depth of the value itself.
    fn wrap { mut out: Out, c: check::Checker, k: u64, depth: u32 } -> u32 {
        let conv = map::get{ m = c.convs, key = k }
        if conv == null { return depth }
        indent{ &out, depth }
        match conv {
            some{ to } => {
                try! @fmt(&out, "some {}\n", check::tstr{ c, t = to })
                return depth + 1
            }
            slice{ to } => {
                try! @fmt(&out, "slice {}\n", check::tstr{ c, t = to })
                return depth + 1
            }
            addr_slice{ ptr, to } => {
                try! @fmt(&out, "slice {}\n", check::tstr{ c, t = to })
                indent{ &out, depth = depth + 1 }
                try! @fmt(&out, "addr {}\n", check::tstr{ c, t = ptr })
                return depth + 2
            }
        }
    }

    // What `..` supplied to a call: `path T`, under `addr` for a `mut` field.
    fn forwards { mut out: Out, c: check::Checker, e: syntax::Expr, depth: u32 } {
        let fw = map::get{ m = c.forwards, key = check::expr_key{ e } }
        if fw == null { return }
        let mut i: usize = 0
        while i < fw.len {
            let f = fw[i]
            let mut d = depth
            let conv = f.conv
            if conv != null {
                indent{ &out, depth = d }
                match conv {
                    some{ to } => { try! @fmt(&out, "some {}\n", check::tstr{ c, t = to }) }
                    slice{ to } | addr_slice{ to } => { try! @fmt(&out, "slice {}\n", check::tstr{ c, t = to }) }
                }
                d = d + 1
            }
            if f.mutable {
                indent{ &out, depth = d }
                try! @fmt(&out, "addr {}\n", check::tstr{ c, t = f.arg })
                d = d + 1
            }
            indent{ &out, depth = d }
            try! @fmt(&out, "path {}\n", check::tstr{ c, t = f.ty })
            i = i + 1
        }
    }

    // An expression: a line `KIND TYPE`, children indented under it.
    fn expr { mut out: Out, c: check::Checker, e: syntax::Expr, depth: u32 } {
        let k = check::expr_key{ e }
        let d = wrap{ &out, c, k, depth }
        indent{ &out, depth = d }
        let t = ty_at{ c, k }
        let none = slice::empty(syntax::Expr){}
        let mut kids: []syntax::Expr = none
        let mut head: utf8::String = "?"
        let mut one: ?syntax::Expr = null
        let mut two: ?syntax::Expr = null
        match e.k {
            field{ base, name } => {
                try! @fmt(&out, "field {} {}\n", check::str{ s = name.text }, t)
                expr{ &out, c, e = base.*, depth = d + 1 }
                return
            }
            deref{ base } => {
                head = "deref"
                one = base.*
            }
            index{ base, i } => {
                head = "index"
                one = base.*
                two = i.*
            }
            range{ base, lo, hi } => {
                let l: utf8::String = if lo != null { "lo" } else { "" }
                let h: utf8::String = if hi != null { "hi" } else { "" }
                try! @fmt(&out, "range {}..{} {}\n", l, h, t)
                expr{ &out, c, e = base.*, depth = d + 1 }
                if lo != null { expr{ &out, c, e = lo.*, depth = d + 1 } }
                if hi != null { expr{ &out, c, e = hi.*, depth = d + 1 } }
                return
            }
            addr{ e = x } => {
                head = "addr"
                one = x.*
            }
            ifx{ x } => {
                try! @fmt(&out, "if {}\n", t)
                if_parts{ &out, c, x, depth = d + 1, value = true }
                return
            }
            matchx{ x } => {
                try! @fmt(&out, "match {}\n", t)
                match_parts{ &out, c, x, depth = d + 1, value = true }
                return
            }
            int => { head = "int" }
            float => { head = "float" }
            str => { head = "str" }
            boolean => { head = "bool" }
            nil => { head = "null" }
            path => { head = "path" }
            array{ elems } => {
                head = "array"
                kids = elems
            }
            repeat{ elem } => {
                head = "repeat"
                one = elem.*
            }
            braced{ items } => {
                try! @fmt(&out, "braced {}\n", t)
                let mut i: usize = 0
                while i < items.len {
                    expr{ &out, c, e = items[i].value, depth = d + 1 }
                    i = i + 1
                }
                forwards{ &out, c, e, depth = d + 1 }
                return
            }
            neg{ e = x } => {
                head = "neg"
                one = x.*
            }
            lnot{ e = x } => {
                head = "not"
                one = x.*
            }
            trye{ e = x, panics } => {
                head = if panics { "try!" } else { "try" }
                one = x.*
            }
            isx{ e = x, pats } => {
                try! @fmt(&out, "is {}\n", t)
                expr{ &out, c, e = x.*, depth = d + 1 }
                let mut i: usize = 0
                while i < pats.len {
                    indent{ &out, depth = d + 1 }
                    dump::put{ &out, s = "pat " }
                    dump::put{ &out, s = check::str{ s = pats[i].variant.text } }
                    dump::put{ &out, s = "\n" }
                    binds{ &out, c, xs = pats[i].binders, depth = d + 2 }
                    i = i + 1
                }
                return
            }
            binary{ op, a, b } => {
                try! @fmt(&out, "binary {} {}\n", check::str{ s = parser::kind_text{ k = op } }, t)
                expr{ &out, c, e = a.*, depth = d + 1 }
                expr{ &out, c, e = b.*, depth = d + 1 }
                return
            }
            builtin{ name, args } => {
                try! @fmt(&out, "@{} {}\n", check::str{ s = name.text }, t)
                let mut i: usize = 0
                while i < args.len {
                    expr{ &out, c, e = args[i], depth = d + 1 }
                    i = i + 1
                }
                // How an @fmt writes each piece of its format: a writer, or a utf8 push.
                let ps = check::site_pieces{ c, e }
                if ps != null {
                    i = 0
                    while i < ps.len {
                        indent{ &out, depth = d + 1 }
                        try! @fmt(&out, "fmt {}", check::str{ s = ps[i].push })
                        let w = ps[i].writer
                        if w.decl != check::NONE { try! @fmt(&out, " {}", check::str{ s = check::get_decl{ c, d = w.decl }.qual }) }
                        try! @fmt(&out, "\n")
                        i = i + 1
                    }
                }
                return
            }
            else => {}
        }
        try! @fmt(&out, "{} {}\n", head, t)
        let x = one
        if x != null { expr{ &out, c, e = x, depth = d + 1 } }
        let y = two
        if y != null { expr{ &out, c, e = y, depth = d + 1 } }
        let mut i: usize = 0
        while i < kids.len {
            expr{ &out, c, e = kids[i], depth = d + 1 }
            i = i + 1
        }
    }

    // A const's value: `N:T` for a number, `"BYTES"` or `view "BYTES"`, `{V, ...}` for a struct,
    // `I{V, ...}` for variant I, `[V, ...]` for an array and `[V; N]` for N copies.
    fn value { mut out: Out, c: check::Checker, v: check::Val } {
        match v {
            int{ ty, negative, magnitude } => {
                let sign: utf8::String = if negative { "-" } else { "" }
                try! @fmt(&out, "{}{}:{}", sign, magnitude, check::tstr{ c, t = ty })
            }
            float{ ty, value } => {
                let mut buf: [32]u8
                let s = if ty == types::prim{ p = types::Prim::f32 } { utf8::fmt_f32{ n = @as(f32, value), into = buf[..] } } else { utf8::fmt_f64{ n = value, into = buf[..] } }
                try! @fmt(&out, "{}:{}", s, check::tstr{ c, t = ty })
            }
            boolean{ value } => { dump::put{ &out, s = if value { "true" } else { "false" } } }
            nil => { dump::put{ &out, s = "null" } }
            str{ bytes } => { quote{ &out, b = bytes } }
            sbytes{ bytes } => {
                dump::put{ &out, s = "view " }
                quote{ &out, b = bytes }
            }
            cstr{ bytes } => {
                dump::put{ &out, s = "cstr " }
                quote{ &out, b = bytes }
            }
            record{ fields } => {
                dump::put{ &out, s = "{" }
                values{ &out, c, xs = fields }
                dump::put{ &out, s = "}" }
            }
            variant{ index, fields } => {
                try! @fmt(&out, "{}{{", index)
                values{ &out, c, xs = fields }
                dump::put{ &out, s = "}" }
            }
            array{ elems } => {
                dump::put{ &out, s = "[" }
                values{ &out, c, xs = elems }
                dump::put{ &out, s = "]" }
            }
            repeat{ ty, elem } => {
                dump::put{ &out, s = "[" }
                value{ &out, c, v = elem.* }
                let mut n: u64 = 0
                if types::get{ s = c.ty, id = ty } is array{ n = k } { n = k }
                try! @fmt(&out, "; {}]", n)
            }
        }
    }

    fn values { mut out: Out, c: check::Checker, xs: []check::Val } {
        let mut i: usize = 0
        while i < xs.len {
            if i > 0 { dump::put{ &out, s = ", " } }
            value{ &out, c, v = xs[i] }
            i = i + 1
        }
    }

    // Bytes as the IR quotes them: printable ASCII other than `"` and `\` as is, every other
    // byte as \xHH.
    fn quote { mut out: Out, b: []u8 } {
        dump::put{ &out, s = "\"" }
        let mut i: usize = 0
        while i < b.len {
            let ch = b[i]
            if ch >= 32 and ch <= 126 and ch != '"' and ch != '\\' {
                dump::byte{ &out, c = ch }
            } else {
                try! @fmt(&out, "\\x{}", utf8::push_hex{ n = ch, width = 2, zero = true, _ })
            }
            i = i + 1
        }
        dump::put{ &out, s = "\"" }
    }

    fn indent { mut out: Out, depth: u32 } {
        let mut i: u32 = 0
        while i < depth {
            dump::put{ &out, s = "  " }
            i = i + 1
        }
    }

    // `(T, S)` after a generic declaration's name.
    fn tparams { d: check::Decl, mut b: Out } -> ! {
        if d.tparams.len == 0 { return }
        try utf8::push{ &b, s = "(" }
        let mut i: usize = 0
        while i < d.tparams.len {
            if i > 0 { try utf8::push{ &b, s = ", " } }
            try utf8::push{ &b, s = check::str{ s = d.tparams[i].text } }
            i = i + 1
        }
        try utf8::push{ &b, s = ")" }
    }

    // `{ mut io: Io, n: i64 } -> R`
    fn sig { c: check::Checker, d: check::Decl, mut b: Out } -> ! {
        try utf8::push{ &b, s = "{" }
        let mut i: usize = 0
        while i < d.fields.len {
            let f = d.fields[i]
            let m: utf8::String = if f.mutable { "mut " } else { "" }
            try @fmt(&b, "{}{}{}: ", check::str{ s = if i == 0 { " " } else { ", " } }, m, check::str{ s = f.name })
            try check::write_type{ c, t = f.ty, &b }
            i = i + 1
        }
        if d.fields.len > 0 { try utf8::push{ &b, s = " " } }
        try utf8::push{ &b, s = "}" }
        if d.ret != types::VOID {
            try utf8::push{ &b, s = " -> " }
            try check::write_type{ c, t = d.ret, &b }
        }
    }

}
