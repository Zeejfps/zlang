// Semantic types, a port of the data half of ctxi/types.py. The checker's half (printing,
// layout, fields of a declared type) needs its declarations and lives in check.ctx.
//
// Types are interned in a Store: each distinct type has one Id, so two types are equal exactly
// when their ids are. Ids for the error type, `no value`, `null`, the primitives and the
// capabilities are fixed (the consts below); every other id comes from `intern`.
//
// The error type stands for a type that couldn't be resolved. It is equal to itself only, but
// the checker accepts it wherever a type is expected and reports nothing more about it, so one
// mistake gives one message.

namespace types {
    type Id = u32
    type Heap = arena::Arena

    enum Prim: u8 { i8, i16, i32, i64, u8, u16, u32, u64, usize, f32, f64, bool }

    const PRIM_NAMES: [12][]u8 = [
        "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize", "f32", "f64", "bool",
    ]

    enum Cap: u8 { io, fs, mem }

    const CAP_NAMES: [3][]u8 = ["Io", "Fs", "Mem"]

    const ERROR: Id = 0
    const VOID: Id = 1
    const NULL: Id = 2
    const FIRST_PRIM: Id = 3             // Prim p has id FIRST_PRIM + p
    const FIRST_CAP: Id = 15             // Cap c has id FIRST_CAP + c
    const I32: Id = 5
    const U8: Id = 7
    const USIZE: Id = 11
    const BOOL: Id = 14

    // A context field of a function type, in declaration order.
    struct Field { name: []u8, mutable: bool, ty: Id }

    // decl indexes the checker's table of declarations (check::Decl).
    union Type {
        error,
        void,                                   // what a function without `-> R` returns
        nil,                                    // the type of `null` before it meets a ?T
        prim{ p: Prim },
        cap{ c: Cap },
        ptr{ elem: Id, mutable: bool },
        slice{ elem: Id, mutable: bool },
        array{ n: u64, elem: Id },
        opt{ elem: Id },
        record{ decl: u32, args: []Id },        // a struct
        sum{ decl: u32, args: []Id },           // a union
        enumeration{ decl: u32 },
        func{ fields: []Field, ret: Id, bound: bool },
        param{ decl: u32, index: u32 },         // generic parameter `index` of decl, opaque
        var{ n: u32 },                          // inference variable n (Store.vars)
    }

    // An inference variable: `any` for a generic argument, `int` or `float` for a literal,
    // which it may be bound only to a type of its kind. ref is NO_TYPE while it is unbound.
    // A literal's variable can remember the operand that fixed its type, for messages.
    enum VarKind: u8 { any, int, float }

    struct Var { kind: VarKind, ref: Id, fixed: ?Fixed }

    struct Fixed { at: source::Span, path: []u8 }       // path: the operand if it is a name

    const NO_TYPE: Id = 4294967295

    struct Store {
        heap:  *mut Heap,
        items: list::List(Type, Heap),          // indexed by Id
        index: map::Map(Type, Id, Heap),
        vars:  list::List(Var, Heap),
    }

    fn store { mut heap: Heap } -> Store {
        let mut s = Store{
            heap = &heap,
            items = list::new(Type){ realloc = arena::alloc, &heap },
            index = map::new(Type, Id){ realloc = arena::alloc, &heap, hash, eq },
            vars = list::new(Var){ realloc = arena::alloc, &heap },
        }
        _ = intern{ &s, t = Type::error }
        _ = intern{ &s, t = Type::void }
        _ = intern{ &s, t = Type::nil }
        let mut i: usize = 0
        while i < PRIM_NAMES.len {
            _ = intern{ &s, t = Type::prim{ p = @as(Prim, i) } }
            i = i + 1
        }
        i = 0
        while i < CAP_NAMES.len {
            _ = intern{ &s, t = Type::cap{ c = @as(Cap, i) } }
            i = i + 1
        }
        return s
    }

    // The id of t, which gets a new one if no equal type has one yet.
    fn intern { mut s: Store, t: Type } -> Id {
        let known = map::get{ m = s.index, key = t }
        if known != null { return known }
        let id = @as(Id, s.items.len)
        if not list::push{ list = &s.items, item = t } or not map::put{ m = &s.index, key = t, value = id } {
            @panic("types: out of memory")
        }
        return id
    }

    fn get { s: Store, id: Id } -> Type {
        return list::items{ list = s.items }[id]
    }

    fn prim { p: Prim } -> Id { return FIRST_PRIM + @as(Id, p) }
    fn cap { c: Cap } -> Id { return FIRST_CAP + @as(Id, c) }

    // ---- building

    fn ptr { mut s: Store, elem: Id, mutable: bool } -> Id {
        return intern{ &s, t = Type::ptr{ elem, mutable } }
    }

    fn slice { mut s: Store, elem: Id, mutable: bool } -> Id {
        return intern{ &s, t = Type::slice{ elem, mutable } }
    }

    fn opt { mut s: Store, elem: Id } -> Id {
        return intern{ &s, t = Type::opt{ elem } }
    }

    fn array { mut s: Store, n: u64, elem: Id } -> Id {
        return intern{ &s, t = Type::array{ n, elem } }
    }

    // The type of a function with fields and ret, a copy of which the store keeps.
    fn func { mut s: Store, fields: []Field, ret: Id, bound: bool } -> Id {
        return intern{ &s, t = Type::func{ fields = copy(Field){ s, xs = fields }, ret, bound } }
    }

    fn record { mut s: Store, decl: u32, args: []Id } -> Id {
        return intern{ &s, t = Type::record{ decl, args = copy(Id){ s, xs = args } } }
    }

    fn sum { mut s: Store, decl: u32, args: []Id } -> Id {
        return intern{ &s, t = Type::sum{ decl, args = copy(Id){ s, xs = args } } }
    }

    fn copy(T) { s: Store, xs: []T } -> []T {
        if xs.len == 0 { return xs }
        let some{ value = out } = alloc::resize(T){ realloc = arena::alloc, heap = s.heap, mem = slice::empty(T){}, count = xs.len } else {
            @panic("types: out of memory")
        }
        slice::copy{ dst = out, src = xs }
        return out
    }

    // t with generic parameter i of decl replaced by args[i].
    fn subst { mut s: Store, t: Id, decl: u32, args: []Id } -> Id {
        match get{ s, id = t } {
            param{ decl = d, index } => {
                if d == decl and index < args.len { return args[index] }
                return t
            }
            ptr{ elem, mutable } => { return ptr{ &s, elem = subst{ &s, t = elem, decl, args }, mutable } }
            slice{ elem, mutable } => { return slice{ &s, elem = subst{ &s, t = elem, decl, args }, mutable } }
            opt{ elem } => { return opt{ &s, elem = subst{ &s, t = elem, decl, args } } }
            array{ n, elem } => { return array{ &s, n, elem = subst{ &s, t = elem, decl, args } } }
            record{ decl = d, args = xs } => {
                return record{ &s, decl = d, args = subst_all{ &s, ts = xs, decl, args } }
            }
            sum{ decl = d, args = xs } => {
                return sum{ &s, decl = d, args = subst_all{ &s, ts = xs, decl, args } }
            }
            func{ fields, ret, bound } => {
                let mut fs = list::new(Field){ realloc = arena::alloc, heap = s.heap }
                let mut i: usize = 0
                while i < fields.len {
                    let f = fields[i]
                    add{ xs = &fs, item = Field{ name = f.name, mutable = f.mutable, ty = subst{ &s, t = f.ty, decl, args } } }
                    i = i + 1
                }
                return func{ &s, fields = list::items{ list = fs }, ret = subst{ &s, t = ret, decl, args }, bound }
            }
            else => { return t }
        }
    }

    fn subst_all { mut s: Store, ts: []Id, decl: u32, args: []Id } -> []Id {
        let mut out = list::new(Id){ realloc = arena::alloc, heap = s.heap }
        let mut i: usize = 0
        while i < ts.len {
            add{ xs = &out, item = subst{ &s, t = ts[i], decl, args } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn add(T) { mut xs: list::List(T, Heap), item: T } {
        if not list::push{ list = &xs, item } { @panic("types: out of memory") }
    }

    // ---- questions

    fn is_int { s: Store, t: Id } -> bool {
        return t >= FIRST_PRIM and t <= prim{ p = Prim::usize }
    }

    fn is_float { s: Store, t: Id } -> bool {
        return t == prim{ p = Prim::f32 } or t == prim{ p = Prim::f64 }
    }

    // The width in bits of a primitive, and whether it is signed.
    fn bits { p: Prim } -> u32 {
        match p {
            i8 | u8 | bool => { return 8 }
            i16 | u16 => { return 16 }
            i32 | u32 | f32 => { return 32 }
            else => { return 64 }
        }
    }

    fn signed { p: Prim } -> bool {
        match p {
            i8 | i16 | i32 | i64 | f32 | f64 => { return true }
            else => { return false }
        }
    }

    // Whether integer value v, of magnitude and sign, fits in integer type p.
    fn fits { p: Prim, negative: bool, magnitude: u64 } -> bool {
        let b = bits{ p }
        if signed{ p } {
            let limit = @as(u64, 1) << (b - 1)        // -limit ..= limit - 1
            return if negative { magnitude <= limit } else { magnitude < limit }
        }
        if negative { return magnitude == 0 }
        return b == 64 or magnitude < @as(u64, 1) << b
    }

    // ---- interning

    fn hash { key: Type } -> u64 {
        match key {
            error => { return 1 }
            void => { return 2 }
            nil => { return 3 }
            prim{ p } => { return mix{ h = 4, n = @as(u64, p) } }
            cap{ c } => { return mix{ h = 5, n = @as(u64, c) } }
            ptr{ elem, mutable } => { return mix{ h = mix{ h = 6, n = elem }, n = flag{ b = mutable } } }
            slice{ elem, mutable } => { return mix{ h = mix{ h = 7, n = elem }, n = flag{ b = mutable } } }
            array{ n, elem } => { return mix{ h = mix{ h = 8, n }, n = elem } }
            opt{ elem } => { return mix{ h = 9, n = elem } }
            record{ decl, args } => { return mix_ids{ h = mix{ h = 10, n = decl }, ids = args } }
            sum{ decl, args } => { return mix_ids{ h = mix{ h = 11, n = decl }, ids = args } }
            enumeration{ decl } => { return mix{ h = 12, n = decl } }
            func{ fields, ret, bound } => {
                let mut h = mix{ h = mix{ h = 13, n = ret }, n = flag{ b = bound } }
                let mut i: usize = 0
                while i < fields.len {
                    let f = fields[i]
                    h = mix{ h = mix{ h = mix{ h, n = map::hash_bytes{ key = f.name } }, n = flag{ b = f.mutable } }, n = f.ty }
                    i = i + 1
                }
                return h
            }
            param{ decl, index } => { return mix{ h = mix{ h = 14, n = decl }, n = index } }
            var{ n } => { return mix{ h = 15, n } }
        }
    }

    fn mix { h: u64, n: u64 } -> u64 {
        return @wrap_mul(h ^ n, 1099511628211) ^ (h >> 29)
    }

    fn flag { b: bool } -> u64 { return if b { 1 } else { 0 } }

    fn mix_ids { h: u64, ids: []Id } -> u64 {
        let mut x = mix{ h, n = ids.len }
        let mut i: usize = 0
        while i < ids.len {
            x = mix{ h = x, n = ids[i] }
            i = i + 1
        }
        return x
    }

    fn eq { a: Type, b: Type } -> bool {
        match a {
            error => { match b { error => { return true } else => { return false } } }
            void => { match b { void => { return true } else => { return false } } }
            nil => { match b { nil => { return true } else => { return false } } }
            prim{ p } => { match b { prim{ p = q } => { return p == q } else => { return false } } }
            cap{ c } => { match b { cap{ c = d } => { return c == d } else => { return false } } }
            ptr{ elem, mutable } => {
                match b { ptr{ elem = e, mutable = m } => { return elem == e and mutable == m } else => { return false } }
            }
            slice{ elem, mutable } => {
                match b { slice{ elem = e, mutable = m } => { return elem == e and mutable == m } else => { return false } }
            }
            array{ n, elem } => {
                match b { array{ n = k, elem = e } => { return n == k and elem == e } else => { return false } }
            }
            opt{ elem } => { match b { opt{ elem = e } => { return elem == e } else => { return false } } }
            record{ decl, args } => {
                match b { record{ decl = d, args = xs } => { return decl == d and same_ids{ a = args, b = xs } } else => { return false } }
            }
            sum{ decl, args } => {
                match b { sum{ decl = d, args = xs } => { return decl == d and same_ids{ a = args, b = xs } } else => { return false } }
            }
            enumeration{ decl } => { match b { enumeration{ decl = d } => { return decl == d } else => { return false } } }
            func{ fields, ret, bound } => {
                match b {
                    func{ fields = fs, ret = r, bound = bd } => {
                        if ret != r or bound != bd or fields.len != fs.len { return false }
                        let mut i: usize = 0
                        while i < fields.len {
                            let f = fields[i]
                            let g = fs[i]
                            if f.ty != g.ty or f.mutable != g.mutable or not slice::eq_bytes{ a = f.name, b = g.name } {
                                return false
                            }
                            i = i + 1
                        }
                        return true
                    }
                    else => { return false }
                }
            }
            param{ decl, index } => {
                match b { param{ decl = d, index = k } => { return decl == d and index == k } else => { return false } }
            }
            var{ n } => { match b { var{ n = k } => { return n == k } else => { return false } } }
        }
    }

    // ---- inference (ctxi's TVar, prune, unify and widens)

    fn fresh { mut s: Store, kind: VarKind } -> Id {
        let n = @as(u32, s.vars.len)
        if not list::push{ list = &s.vars, item = Var{ kind, ref = NO_TYPE, fixed = null } } { @panic("types: out of memory") }
        return intern{ &s, t = Type::var{ n } }
    }

    fn var_of { s: Store, n: u32 } -> Var {
        return list::items{ list = s.vars }[n]
    }

    // The variable t is, if it is an unbound one after pruning.
    fn unbound { s: Store, t: Id } -> ?u32 {
        match get{ s, id = prune{ s, t } } {
            var{ n } => { return n }
            else => { return null }
        }
    }

    // t, or what the variables it is bound to are bound to, down to a type that isn't a bound
    // variable.
    fn prune { s: Store, t: Id } -> Id {
        let mut x = t
        while true {
            match get{ s, id = x } {
                var{ n } => {
                    let r = var_of{ s, n }.ref
                    if r == NO_TYPE { return x }
                    x = r
                }
                else => { return x }
            }
        }
    }

    // t with every bound variable inside it replaced by its binding.
    fn zonk { mut s: Store, t: Id } -> Id {
        let x = prune{ s, t }
        match get{ s, id = x } {
            ptr{ elem, mutable } => { return ptr{ &s, elem = zonk{ &s, t = elem }, mutable } }
            slice{ elem, mutable } => { return slice{ &s, elem = zonk{ &s, t = elem }, mutable } }
            opt{ elem } => { return opt{ &s, elem = zonk{ &s, t = elem } } }
            array{ n, elem } => { return array{ &s, n, elem = zonk{ &s, t = elem } } }
            record{ decl, args } => { return record{ &s, decl, args = zonk_all{ &s, ts = args } } }
            sum{ decl, args } => { return sum{ &s, decl, args = zonk_all{ &s, ts = args } } }
            func{ fields, ret, bound } => {
                let mut fs = list::new(Field){ realloc = arena::alloc, heap = s.heap }
                let mut i: usize = 0
                while i < fields.len {
                    let f = fields[i]
                    add{ xs = &fs, item = Field{ name = f.name, mutable = f.mutable, ty = zonk{ &s, t = f.ty } } }
                    i = i + 1
                }
                return func{ &s, fields = list::items{ list = fs }, ret = zonk{ &s, t = ret }, bound }
            }
            else => { return x }
        }
    }

    fn zonk_all { mut s: Store, ts: []Id } -> []Id {
        let mut out = list::new(Id){ realloc = arena::alloc, heap = s.heap }
        let mut i: usize = 0
        while i < ts.len {
            add{ xs = &out, item = zonk{ &s, t = ts[i] } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn bind_var { mut s: Store, n: u32, t: Id } {
        list::at{ list = s.vars, i = n }.ref = t
    }

    // Whether variable n occurs in t.
    fn occurs { s: Store, n: u32, t: Id } -> bool {
        match get{ s, id = prune{ s, t } } {
            var{ n = k } => { return k == n }
            ptr{ elem } => { return occurs{ s, n, t = elem } }
            slice{ elem } => { return occurs{ s, n, t = elem } }
            opt{ elem } => { return occurs{ s, n, t = elem } }
            array{ elem } => { return occurs{ s, n, t = elem } }
            record{ args } => { return any_occurs{ s, n, ts = args } }
            sum{ args } => { return any_occurs{ s, n, ts = args } }
            func{ fields, ret } => {
                if occurs{ s, n, t = ret } { return true }
                let mut i: usize = 0
                while i < fields.len {
                    if occurs{ s, n, t = fields[i].ty } { return true }
                    i = i + 1
                }
                return false
            }
            else => { return false }
        }
    }

    fn any_occurs { s: Store, n: u32, ts: []Id } -> bool {
        let mut i: usize = 0
        while i < ts.len {
            if occurs{ s, n, t = ts[i] } { return true }
            i = i + 1
        }
        return false
    }

    // Binds variable n to t, if its kind allows (ctxi's _bind).
    fn bind { mut s: Store, n: u32, t: Id } -> bool {
        let v = var_of{ s, n }
        let other = unbound{ s, t }
        if other != null {
            if v.kind == VarKind::any {
                bind_var{ &s, n, t }
                return true
            }
            let w = var_of{ s, n = other }
            if w.kind == VarKind::any or w.kind == v.kind {
                bind_var{ &s, n = other, t = intern{ &s, t = Type::var{ n } } }
                return true
            }
            return false
        }
        if v.kind == VarKind::int and not is_int{ s, t } { return false }
        if v.kind == VarKind::float and not is_float{ s, t } { return false }
        if occurs{ s, n, t } { return false }
        bind_var{ &s, n, t }
        return true
    }

    // Makes a and b the same type by binding variables, if they can be. The error type is the
    // same as every type. As in ctxi, a failed attempt may leave some variables bound.
    fn unify { mut s: Store, a: Id, b: Id } -> bool {
        let x = prune{ s, t = a }
        let y = prune{ s, t = b }
        if x == y or x == ERROR or y == ERROR { return true }
        let vx = unbound{ s, t = x }
        if vx != null { return bind{ &s, n = vx, t = y } }
        let vy = unbound{ s, t = y }
        if vy != null { return bind{ &s, n = vy, t = x } }
        let tb = get{ s, id = y }
        match get{ s, id = x } {
            ptr{ elem, mutable } => {
                match tb { ptr{ elem = e, mutable = m } => { return mutable == m and unify{ &s, a = elem, b = e } } else => { return false } }
            }
            slice{ elem, mutable } => {
                match tb { slice{ elem = e, mutable = m } => { return mutable == m and unify{ &s, a = elem, b = e } } else => { return false } }
            }
            opt{ elem } => {
                match tb { opt{ elem = e } => { return unify{ &s, a = elem, b = e } } else => { return false } }
            }
            array{ n, elem } => {
                match tb { array{ n = k, elem = e } => { return n == k and unify{ &s, a = elem, b = e } } else => { return false } }
            }
            record{ decl, args } => {
                match tb { record{ decl = d, args = xs } => { return decl == d and unify_all{ &s, a = args, b = xs } } else => { return false } }
            }
            sum{ decl, args } => {
                match tb { sum{ decl = d, args = xs } => { return decl == d and unify_all{ &s, a = args, b = xs } } else => { return false } }
            }
            func{ fields, ret, bound } => {
                match tb {
                    func{ fields = fs, ret = r, bound = bd } => {
                        if bound != bd or fields.len != fs.len { return false }
                        let mut i: usize = 0
                        while i < fields.len {
                            let f = fields[i]
                            let g = find_field{ fields = fs, name = f.name }
                            if g == null or g.mutable != f.mutable or not unify{ &s, a = f.ty, b = g.ty } { return false }
                            i = i + 1
                        }
                        return unify{ &s, a = ret, b = r }
                    }
                    else => { return false }
                }
            }
            else => { return false }         // distinct primitives, capabilities or parameters
        }
    }

    // As in ctxi, pairs up to the shorter list.
    fn unify_all { mut s: Store, a: []Id, b: []Id } -> bool {
        let mut i: usize = 0
        while i < a.len and i < b.len {
            if not unify{ &s, a = a[i], b = b[i] } { return false }
            i = i + 1
        }
        return true
    }

    fn find_field { fields: []Field, name: []u8 } -> ?Field {
        let mut i: usize = 0
        while i < fields.len {
            if slice::eq_bytes{ a = fields[i].name, b = name } { return fields[i] }
            i = i + 1
        }
        return null
    }

    // Does a convert implicitly to b (spec §11, Widening)? Only when every value of a is a
    // value of b. `*mut T` converts to `*T` and `[]mut T` to `[]T`.
    fn widens { mut s: Store, a: Id, b: Id } -> bool {
        let x = prune{ s, t = a }
        let y = prune{ s, t = b }
        match get{ s, id = x } {
            ptr{ elem, mutable } => {
                match get{ s, id = y } { ptr{ elem = e, mutable = m } => { return mutable and not m and unify{ &s, a = elem, b = e } } else => { return false } }
            }
            slice{ elem, mutable } => {
                match get{ s, id = y } { slice{ elem = e, mutable = m } => { return mutable and not m and unify{ &s, a = elem, b = e } } else => { return false } }
            }
            else => {}
        }
        let pa = prim_of{ s, t = x }
        let pb = prim_of{ s, t = y }
        if pa == null or pb == null or x == y { return false }
        if pa == Prim::bool or pb == Prim::bool { return false }
        let fa = pa == Prim::f32 or pa == Prim::f64
        let fb = pb == Prim::f32 or pb == Prim::f64
        if fa and fb { return bits{ p = pa } < bits{ p = pb } }
        if fa or fb { return false }
        if pa == Prim::usize { return pb == Prim::u64 }
        if pb == Prim::usize { return not signed{ p = pa } and bits{ p = pa } <= 32 }
        if signed{ p = pa } { return signed{ p = pb } and bits{ p = pb } > bits{ p = pa } }
        return bits{ p = pb } > bits{ p = pa }
    }

    fn prim_of { s: Store, t: Id } -> ?Prim {
        match get{ s, id = t } {
            prim{ p } => { return p }
            else => { return null }
        }
    }

    // Whether t holds an unbound variable.
    fn has_vars { s: Store, t: Id } -> bool {
        match get{ s, id = prune{ s, t } } {
            var => { return true }
            ptr{ elem } => { return has_vars{ s, t = elem } }
            slice{ elem } => { return has_vars{ s, t = elem } }
            opt{ elem } => { return has_vars{ s, t = elem } }
            array{ elem } => { return has_vars{ s, t = elem } }
            record{ args } => { return any_vars{ s, ts = args } }
            sum{ args } => { return any_vars{ s, ts = args } }
            func{ fields, ret } => {
                if has_vars{ s, t = ret } { return true }
                let mut i: usize = 0
                while i < fields.len {
                    if has_vars{ s, t = fields[i].ty } { return true }
                    i = i + 1
                }
                return false
            }
            else => { return false }
        }
    }

    fn any_vars { s: Store, ts: []Id } -> bool {
        let mut i: usize = 0
        while i < ts.len {
            if has_vars{ s, t = ts[i] } { return true }
            i = i + 1
        }
        return false
    }

    // Whether t is, or holds as an element or generic argument, a bound function type.
    fn has_bound_fn { s: Store, t: Id } -> bool {
        match get{ s, id = prune{ s, t } } {
            func{ bound } => { return bound }
            ptr{ elem } => { return has_bound_fn{ s, t = elem } }
            slice{ elem } => { return has_bound_fn{ s, t = elem } }
            opt{ elem } => { return has_bound_fn{ s, t = elem } }
            array{ elem } => { return has_bound_fn{ s, t = elem } }
            record{ args } => { return any_bound_fn{ s, ts = args } }
            sum{ args } => { return any_bound_fn{ s, ts = args } }
            else => { return false }
        }
    }

    fn any_bound_fn { s: Store, ts: []Id } -> bool {
        let mut i: usize = 0
        while i < ts.len {
            if has_bound_fn{ s, t = ts[i] } { return true }
            i = i + 1
        }
        return false
    }

    fn same_ids { a: []Id, b: []Id } -> bool {
        if a.len != b.len { return false }
        let mut i: usize = 0
        while i < a.len {
            if a[i] != b[i] { return false }
            i = i + 1
        }
        return true
    }
}
