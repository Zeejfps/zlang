// What ctxc shows of the front end's diagnostics (diag.ctx). A diagnostic names a span of a
// file by the checker's ids; an Entry is the same with the file's path and its lines and
// columns, which stands by itself, so that `ctxc check` can gather the entries of several
// executables, each checked by a checker of its own, and show each once.
//
// There are two forms, with the same in each (spec §21). As text, a line for the error and one
// under it for each note, a related place:
//
//   PATH:LINE:COL: error: MESSAGE
//     PATH:LINE:COL: note: MESSAGE
//
// and with `--json` a JSON object on a line of its own for each error (`json`), and one that
// sums up after them (`summary`). Both go to standard error. An error about the whole program,
// such as a missing `main`, is at the start of its first file. If the cap dropped some
// (diag::CAP), a last line says so, or the summary does.

namespace report {
    type Heap = arena::Arena

    // Where a diagnostic points: lines and columns from 1, columns counted in characters, up
    // to but not including the end.
    struct Place { path: []u8, line: u32, col: u32, end_line: u32, end_col: u32 }

    // A related place (diag::Note).
    struct Note { at: Place, msg: []u8 }

    // An edit of a fix (diag::Edit): the bytes start up to end of the file at.path, which
    // are `old` in a file of `size` bytes as the compiler read it, become text. own: the file
    // is one of the program's own, not std's and not one its build program generates: the
    // only kind `ctxc check --fix` writes to. around: the whole of the lines the bytes are
    // in, without the last one's line break, for showing the edit, and within: where the
    // bytes start in it.
    struct Edit { at: Place, start: u32, end: u32, old: []u8, size: usize, text: []u8, own: bool, around: []u8, within: u32 }

    // A fix (diag::Fix).
    struct Fix { safe: bool, msg: []u8, edits: []Edit }

    // lacks: the namespace the program lacks, if the error is that (diag::Diag.lacks), for the
    // driver to say where one is declared (drive.ctx, `explain`).
    struct Entry { at: Place, msg: []u8, notes: []Note, lacks: []u8, fixes: []Fix }

    // What a command that checks several programs has gathered (`ctxc check`): each entry
    // once, however many of the programs have it; whether the cap dropped others; and which
    // checks waited for a program without errors (check::WAIT_ORDER and the others).
    struct Found { entries: list::List(Entry, Heap), dropped: bool, waiting: u8 }

    fn found { heap: *mut Heap } -> Found {
        return Found{ entries = list::new(Entry){ realloc = arena::alloc, heap }, dropped = false, waiting = 0 }
    }

    // The diagnostics of checker c as entries, in order. The program's own files are
    // c.files[c.std_files..own_end]: those after them are generated.
    fn resolve { mut heap: Heap, c: check::Checker, ds: []diag::Diag, own_end: usize } -> []Entry {
        let mut out = list::new(Entry){ realloc = arena::alloc, &heap }
        for d in ds {
            let mut notes = list::new(Note){ realloc = arena::alloc, &heap }
            for n in d.notes { try! list::push{ list = &notes, item = Note{ at = place{ c, span = n.span }, msg = n.msg.bytes } } }
            let mut fixes = list::new(Fix){ realloc = arena::alloc, &heap }
            for f in d.fixes {
                let mut edits = list::new(Edit){ realloc = arena::alloc, &heap }
                let mut whole = true
                for e in f.edits {
                    // An edit of no file, or past its file's end, isn't one: the fix is dropped.
                    if e.span.file == check::NO_FILE or @as(usize, e.span.file) >= c.files.len or e.span.end < e.span.start or @as(usize, e.span.end) > c.files[e.span.file].text.len {
                        whole = false
                        break
                    }
                    let file = c.files[e.span.file]
                    let own = @as(usize, e.span.file) >= c.std_files and @as(usize, e.span.file) < own_end
                    let mut from: usize = e.span.start
                    while from > 0 and file.text[from - 1] != '\n' { from = from - 1 }
                    let mut to: usize = e.span.end
                    while to < file.text.len and file.text[to] != '\n' { to = to + 1 }
                    try! list::push{ list = &edits, item = Edit{
                        at = place{ c, span = e.span }, start = e.span.start, end = e.span.end, old = file.text[e.span.start..e.span.end], size = file.text.len, text = e.text, own,
                        around = file.text[from..to], within = e.span.start - @as(u32, from),
                    } }
                }
                if whole and edits.len > 0 { try! list::push{ list = &fixes, item = Fix{ safe = f.safe, msg = f.msg.bytes, edits = list::items{ list = edits } } } }
            }
            try! list::push{ list = &out, item = Entry{ at = place{ c, span = d.span }, msg = d.msg.bytes, notes = list::items{ list = notes }, lacks = d.lacks, fixes = list::items{ list = fixes } } }
        }
        return list::items{ list = out }
    }

    fn place { c: check::Checker, span: source::Span } -> Place {
        if span.file == check::NO_FILE {
            return Place{ path = c.files[c.std_files].name, line = 1, col = 1, end_line = 1, end_col = 1 }
        }
        let f = c.files[span.file]
        let a = source::position{ text = f.text, lines = f.lines, offset = span.start }
        let b = source::position{ text = f.text, lines = f.lines, offset = if span.end < span.start { span.start } else { span.end } }
        return Place{ path = f.name, line = a.line, col = a.col, end_line = b.line, end_col = b.col }
    }

    // Adds to found those of es it doesn't have.
    fn keep { mut found: Found, es: []Entry } {
        for e in es {
            let mut had = false
            for o in list::items{ list = found.entries } {
                if same{ a = o, b = e } {
                    had = true
                    break
                }
            }
            if not had { try! list::push{ list = &found.entries, item = e } }
        }
    }

    fn same { a: Entry, b: Entry } -> bool {
        return a.at.line == b.at.line and a.at.col == b.at.col and a.at.end_line == b.at.end_line and a.at.end_col == b.at.end_col
               and slice::eq_bytes{ a = a.at.path, b = b.at.path } and slice::eq_bytes{ a = a.msg, b = b.msg }
    }

    // Writes es to standard error, as text or as JSON. As text, whether the cap dropped
    // others comes after them; as JSON the summary says it, which the caller writes
    // (`summary`), once it knows the whole of what it reports.
    fn write { mut io: Io, mut heap: Heap, es: []Entry, dropped: bool, as_json: bool } {
        let mut out = utf8::builder{ realloc = arena::alloc, &heap }
        for e in es {
            if as_json { json{ &out, e } } else { text{ &out, e } }
        }
        // How many more isn't known: a body is checked twice, and an error that was dropped
        // twice was counted twice.
        if dropped and not as_json {
            try! @fmt(&out, "ctxc: more than {} errors: these are the first {}, and `ctxc check` reports every one\n", diag::CAP, diag::CAP)
        }
        io::write{ &io, to = io::Stream::err, bytes = utf8::view{ b = out }.bytes }
    }

    // "PATH:LINE:COL: error: MESSAGE", and "  PATH:LINE:COL: note: MESSAGE" for each note.
    fn text { mut out: utf8::Builder(Heap), e: Entry } {
        try! @fmt(&out, "{}:{}:{}: error: {}\n", utf8::String{ bytes = e.at.path }, e.at.line, e.at.col, utf8::String{ bytes = e.msg })
        for n in e.notes {
            try! @fmt(&out, "  {}:{}:{}: note: {}\n", utf8::String{ bytes = n.at.path }, n.at.line, n.at.col, utf8::String{ bytes = n.msg })
        }
    }

    // e as a JSON object on one line (spec §21, rule 9):
    //
    //   {"type":"diagnostic","severity":"error","file":"a.ctx","line":4,"column":12,
    //    "end_line":4,"end_column":14,"message":"...","notes":[{"file":...,"message":"..."}],
    //    "fixes":[{"safe":true,"message":"...","edits":[{"file":...,"text":"..."}]}]}
    fn json { mut out: utf8::Builder(Heap), e: Entry } {
        try! utf8::push{ b = &out, s = "{\"type\":\"diagnostic\",\"severity\":\"error\"," }
        json_place{ &out, at = e.at }
        try! @fmt(&out, ",\"message\":{},\"notes\":[", utf8::push_json{ s = e.msg, _ })
        for n at i in e.notes {
            try! utf8::push{ b = &out, s = if i == 0 { "{" } else { ",{" } }
            json_place{ &out, at = n.at }
            try! @fmt(&out, ",\"message\":{}}}", utf8::push_json{ s = n.msg, _ })
        }
        try! utf8::push{ b = &out, s = "],\"fixes\":[" }
        for f at i in e.fixes {
            try! @fmt(&out, "{}{{\"safe\":{},\"message\":{},\"edits\":[", utf8::String{ bytes = if i == 0 { "" } else { "," } }, f.safe, utf8::push_json{ s = f.msg, _ })
            for x at k in f.edits {
                try! utf8::push{ b = &out, s = if k == 0 { "{" } else { ",{" } }
                json_place{ &out, at = x.at }
                try! @fmt(&out, ",\"text\":{}}}", utf8::push_json{ s = x.text, _ })
            }
            try! utf8::push{ b = &out, s = "]}" }
        }
        try! utf8::push{ b = &out, s = "]}\n" }
    }

    // `"file":"a.ctx","line":4,"column":12,"end_line":4,"end_column":14`
    fn json_place { mut out: utf8::Builder(Heap), at: Place } {
        try! @fmt(&out, "\"file\":{},\"line\":{},\"column\":{},\"end_line\":{},\"end_column\":{}", utf8::push_json{ s = at.path, _ }, at.line, at.col, at.end_line, at.end_col)
    }

    // The record that ends a command's diagnostics as JSON, on standard error: how many
    // errors it reported, whether the cap dropped others (`more`), and which checks waited for
    // a program without errors, by name (`waiting`: `order`, `tasks`, `consts`). After it,
    // under `ctxc run`, standard error is the program's.
    //
    //   {"type":"summary","errors":2,"more":false,"waiting":["order","tasks","consts"]}
    fn summary { mut io: Io, mut heap: Heap, errors: usize, dropped: bool, waiting: u8 } {
        let mut out = utf8::builder{ realloc = arena::alloc, &heap }
        try! @fmt(&out, "{{\"type\":\"summary\",\"errors\":{},\"more\":{},\"waiting\":[", errors, dropped)
        let names: [3]utf8::String = ["\"order\"", "\"tasks\"", "\"consts\""]
        let mut n: usize = 0
        for name at k in names {
            if waiting & (@as(u8, 1) << @as(u8, k)) == 0 { continue }
            if n > 0 { try! utf8::push{ b = &out, s = "," } }
            try! utf8::push{ b = &out, s = name }
            n = n + 1
        }
        try! utf8::push{ b = &out, s = "]}\n" }
        io::write{ &io, to = io::Stream::err, bytes = utf8::view{ b = out }.bytes }
    }
}
