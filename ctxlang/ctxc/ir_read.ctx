// Reads the IR's text form (ir_print.ctx writes it) into an ir::Program.
//
//   let mut r = ir_read::reader{ text, heap = &heap }
//   let prog = try ir_read::program{ &r }      // fails only with alloc::out_of_memory
//   if r.failed { ... r.error, r.error_at ... }
//
// Errors in the text are sticky: the first one is recorded, and every read after it returns a placeholder
// without consuming input, so callers don't check after each step. Strings without escapes are
// views of `text`, so it must outlive the program. Everything else comes from `heap`.

namespace ir_read {
    union Problem {
        expected{ c: u8 },          // this character
        expected_int,
        int_too_large,
        expected_symbol,
        expected_string,
        bad_escape,
        bad_float,
        unknown_tag,                // a node whose tag isn't valid here
        bad_id,                     // a type id out of order
        trailing_text,
    }

    struct Reader {
        text:     ir::Bytes,
        pos:      usize,
        heap:     *mut ir::Heap,
        types:    []ir::Type,   // once they are read: a float's type says if it is f32
        failed:   bool,
        error:    Problem,
        error_at: usize,
    }

    fn reader { text: ir::Bytes, heap: *mut ir::Heap } -> Reader {
        return Reader{
            text, pos = 0, heap, types = slice::empty(ir::Type){},
            failed = false, error = Problem::trailing_text, error_at = 0,
        }
    }

    // ---- the program

    fn program { mut r: Reader } -> !ir::Program {
        word{ &r, w = "ctxir" }
        let version = num{ &r }
        expect{ &r, c = '(' }
        word{ &r, w = "files" }
        let files = try strings{ &r }
        expect{ &r, c = ')' }

        let mut types = list::new(ir::Type){ realloc = arena::alloc, heap = r.heap }
        let mut consts = list::new(ir::Const){ realloc = arena::alloc, heap = r.heap }
        let mut vars = list::new(ir::Var){ realloc = arena::alloc, heap = r.heap }
        let mut fns = list::new(ir::Func){ realloc = arena::alloc, heap = r.heap }
        let mut main = 0
        while true {
            expect{ &r, c = '(' }
            if r.failed { break }
            let tag = sym{ &r }
            if spells{ s = tag, lit = "type" } {
                if id32{ &r } != types.len { fail{ &r, problem = Problem::bad_id } }
                try list::push{ list = &types, item = try type_def{ &r } }
                r.types = list::items{ list = types }
            } else if spells{ s = tag, lit = "const" } {
                if id32{ &r } != consts.len { fail{ &r, problem = Problem::bad_id } }
                let name = try string{ &r }
                let ty = id32{ &r }
                try list::push{ list = &consts, item = ir::Const{ name, ty, value = try expr{ &r } } }
            } else if spells{ s = tag, lit = "var" } {
                if id32{ &r } != vars.len { fail{ &r, problem = Problem::bad_id } }
                let name = try string{ &r }
                let symbol = try string{ &r }
                try list::push{ list = &vars, item = ir::Var{ name, symbol, ty = id32{ &r } } }
            } else if spells{ s = tag, lit = "fn" } {
                try list::push{ list = &fns, item = try function{ &r } }
            } else if spells{ s = tag, lit = "extern" } {
                try list::push{ list = &fns, item = try extern_fn{ &r } }
            } else if spells{ s = tag, lit = "main" } {
                main = id32{ &r }
                expect{ &r, c = ')' }
                break
            } else {
                fail{ &r, problem = Problem::unknown_tag }
            }
            expect{ &r, c = ')' }
        }
        skip_space{ &r }
        if r.pos < r.text.len { fail{ &r, problem = Problem::trailing_text } }
        return ir::Program{
            version, files, types = list::items{ list = types }, consts = list::items{ list = consts },
            vars = list::items{ list = vars }, fns = list::items{ list = fns }, main,
        }
    }

    // After `(type ID `: the type, up to its closing parenthesis.
    fn type_def { mut r: Reader } -> !ir::Type {
        expect{ &r, c = '(' }
        let tag = sym{ &r }
        let mut t = ir::Type::void
        if spells{ s = tag, lit = "prim" } {
            t = ir::Type::prim{ p = prim{ &r } }
        } else if spells{ s = tag, lit = "ptr" } {
            t = ir::Type::ptr{ elem = id32{ &r } }
        } else if spells{ s = tag, lit = "arr" } {
            let n = num{ &r }
            t = ir::Type::arr{ n, elem = id32{ &r } }
        } else if spells{ s = tag, lit = "struct" } or spells{ s = tag, lit = "cunion" } {
            let untagged = spells{ s = tag, lit = "cunion" }
            let name = try string{ &r }
            let size = num{ &r }
            let align = num{ &r }
            t = ir::Type::record{ name, size, align, fields = try fields{ &r }, untagged }
        } else if spells{ s = tag, lit = "union" } {
            let name = try string{ &r }
            let size = num{ &r }
            let align = num{ &r }
            let pay_off = num{ &r }
            t = ir::Type::tagged{ name, size, align, pay_off, variants = try variants{ &r } }
        } else if spells{ s = tag, lit = "fn" } {
            let bound = flag{ &r }
            let params = try params{ &r }
            t = ir::Type::func{ bound, params, ret = id32{ &r } }
        } else if spells{ s = tag, lit = "cfn" } {
            let params = try params{ &r }
            t = ir::Type::cfn{ params, ret = id32{ &r } }
        } else if spells{ s = tag, lit = "nptr" } {
            t = ir::Type::nptr{ ptr = id32{ &r } }
        } else if spells{ s = tag, lit = "cap" } {
            // (cap NAME), or (cap NAME SIZE ALIGN [FIELD...]) for one with fields
            let name = try string{ &r }
            if more{ &r, close = ')' } {
                let size = num{ &r }
                let align = num{ &r }
                t = ir::Type::cap{ name, size, align, fields = try fields{ &r } }
            } else {
                t = ir::Type::cap{ name, size = 0, align = 1, fields = slice::empty(ir::Field){} }
            }
        } else if not spells{ s = tag, lit = "void" } {
            fail{ &r, problem = Problem::unknown_tag }
        }
        expect{ &r, c = ')' }
        return t
    }

    fn prim { mut r: Reader } -> ir::Prim {
        let s = sym{ &r }
        if spells{ s, lit = "i8" } { return ir::Prim::i8 }
        if spells{ s, lit = "i16" } { return ir::Prim::i16 }
        if spells{ s, lit = "i32" } { return ir::Prim::i32 }
        if spells{ s, lit = "i64" } { return ir::Prim::i64 }
        if spells{ s, lit = "u8" } { return ir::Prim::u8 }
        if spells{ s, lit = "u16" } { return ir::Prim::u16 }
        if spells{ s, lit = "u32" } { return ir::Prim::u32 }
        if spells{ s, lit = "u64" } { return ir::Prim::u64 }
        if spells{ s, lit = "usize" } { return ir::Prim::usize }
        if spells{ s, lit = "f32" } { return ir::Prim::f32 }
        if spells{ s, lit = "f64" } { return ir::Prim::f64 }
        if not spells{ s, lit = "bool" } { fail{ &r, problem = Problem::unknown_tag } }
        return ir::Prim::bool
    }

    // [(NAME T OFFSET)...]
    fn fields { mut r: Reader } -> ![]ir::Field {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Field){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            expect{ &r, c = '(' }
            let name = try string{ &r }
            let ty = id32{ &r }
            let offset = num{ &r }
            expect{ &r, c = ')' }
            try list::push{ list = &xs, item = ir::Field{ name, ty, offset } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    // [(NAME _) or (NAME [FIELD...])...]
    fn variants { mut r: Reader } -> ![]ir::Variant {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Variant){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            expect{ &r, c = '(' }
            let name = try string{ &r }
            let fs: ?[]ir::Field = if none{ &r } { null } else { try fields{ &r } }
            expect{ &r, c = ')' }
            try list::push{ list = &xs, item = ir::Variant{ name, fields = fs } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    // [(NAME MUT T)...]
    fn params { mut r: Reader } -> ![]ir::Param {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Param){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            expect{ &r, c = '(' }
            let name = try string{ &r }
            let mutable = flag{ &r }
            let ty = id32{ &r }
            expect{ &r, c = ')' }
            try list::push{ list = &xs, item = ir::Param{ name, mutable, ty } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    // After `(extern `, up to the closing parenthesis.
    fn extern_fn { mut r: Reader } -> !ir::Func {
        let id = id32{ &r }
        let name = try string{ &r }
        let symbol = try string{ &r }
        let params = try params{ &r }
        let ret = id32{ &r }
        return ir::Func{ id, name, symbol, params, ret, locals = slice::empty(ir::Local){}, body = empty_block{} }
    }

    // After `(fn `, up to the closing parenthesis.
    fn function { mut r: Reader } -> !ir::Func {
        let id = id32{ &r }
        let name = try string{ &r }
        let params = try params{ &r }
        let ret = id32{ &r }
        expect{ &r, c = '[' }
        let mut locals = list::new(ir::Local){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            expect{ &r, c = '(' }
            let lname = try string{ &r }
            let ty = id32{ &r }
            expect{ &r, c = ')' }
            try list::push{ list = &locals, item = ir::Local{ name = lname, ty } }
        }
        expect{ &r, c = ']' }
        let body = try block{ &r }
        return ir::Func{ id, name, symbol = "", params, ret, locals = list::items{ list = locals }, body }
    }

    fn empty_block {} -> ir::Block {
        return ir::Block{ stmts = slice::empty(ir::Stmt){}, result = null }
    }

    // ---- statements

    // { STMT... } or { STMT... => EXPR }
    fn block { mut r: Reader } -> !ir::Block {
        expect{ &r, c = '{' }
        let mut stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = r.heap }
        let mut result: ?*ir::Expr = null
        while more{ &r, close = '}' } {
            if eat{ &r, c = '=' } {
                expect{ &r, c = '>' }
                result = try box{ &r, e = try expr{ &r } }
                break
            }
            try list::push{ list = &stmts, item = try stmt{ &r } }
        }
        expect{ &r, c = '}' }
        return ir::Block{ stmts = list::items{ list = stmts }, result }
    }

    fn stmt { mut r: Reader } -> !ir::Stmt {
        expect{ &r, c = '(' }
        let tag = sym{ &r }
        let mut s = ir::Stmt::brk{ label = null }
        if spells{ s = tag, lit = "let" } {
            let slot = id32{ &r }
            s = ir::Stmt::define{ slot, init = try expr{ &r } }
        } else if spells{ s = tag, lit = "do" } {
            s = ir::Stmt::eval{ e = try expr{ &r } }
        } else if spells{ s = tag, lit = "set" } {
            let place = try expr{ &r }
            s = ir::Stmt::assign{ place, value = try expr{ &r } }
        } else if spells{ s = tag, lit = "if" } {
            let c = try expr{ &r }
            let then = try block{ &r }
            let els: ?ir::Block = if none{ &r } { null } else { try block{ &r } }
            s = ir::Stmt::cond{ c, then, els }
        } else if spells{ s = tag, lit = "return" } {
            let value: ?ir::Expr = if none{ &r } { null } else { try expr{ &r } }
            s = ir::Stmt::ret{ value }
        } else if spells{ s = tag, lit = "zero" } {
            s = ir::Stmt::zero{ slot = id32{ &r } }
        } else if spells{ s = tag, lit = "while" } {
            let c = try expr{ &r }
            let body = try block{ &r }
            s = ir::Stmt::loop{ c, body, label = label{ &r } }
        } else if spells{ s = tag, lit = "match" } {
            let scrut = try expr{ &r }
            let through = flag{ &r }
            s = ir::Stmt::choose{ scrut, through, arms = try arms{ &r } }
        } else if spells{ s = tag, lit = "switch" } {
            let scrut = try expr{ &r }
            s = ir::Stmt::switch{ scrut, cases = try cases{ &r } }
        } else if spells{ s = tag, lit = "letelse" } {
            let init = try expr{ &r }
            let variant = id32{ &r }
            let binds = try bind_list{ &r }
            let els_variant = opt_id{ &r }
            let els_binds = try bind_list{ &r }
            s = ir::Stmt::let_else{ init, variant, binds, els_variant, els_binds, els = try block{ &r } }
        } else if spells{ s = tag, lit = "defer" } {
            s = ir::Stmt::deferred{ body = try block{ &r } }
        } else if spells{ s = tag, lit = "panic" } {
            let at = pos{ &r }
            s = ir::Stmt::panic{ pos = at, msg = try string{ &r } }
        } else if spells{ s = tag, lit = "continue" } {
            s = ir::Stmt::cont{ label = label{ &r } }
        } else if spells{ s = tag, lit = "break" } {
            s = ir::Stmt::brk{ label = label{ &r } }
        } else {
            fail{ &r, problem = Problem::unknown_tag }
        }
        expect{ &r, c = ')' }
        return s
    }

    // [([PAT...]|_ BLOCK)...]
    fn arms { mut r: Reader } -> ![]ir::Arm {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Arm){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            expect{ &r, c = '(' }
            let pats = if none{ &r } { slice::empty(ir::Pat){} } else { try pat_list{ &r } }
            let body = try block{ &r }
            expect{ &r, c = ')' }
            try list::push{ list = &xs, item = ir::Arm{ pats, body } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    // [([N...]|_ BLOCK)...]
    fn cases { mut r: Reader } -> ![]ir::Case {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Case){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            expect{ &r, c = '(' }
            let mut values = list::new(ir::Int){ realloc = arena::alloc, heap = r.heap }
            if not none{ &r } {
                expect{ &r, c = '[' }
                while more{ &r, close = ']' } {
                    let negative = eat{ &r, c = '-' }
                    try list::push{ list = &values, item = ir::Int{ negative, value = num{ &r } } }
                }
                expect{ &r, c = ']' }
            }
            let body = try block{ &r }
            expect{ &r, c = ')' }
            try list::push{ list = &xs, item = ir::Case{ values = list::items{ list = values }, body } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    // [(VARIANT [BIND...])...]
    fn pat_list { mut r: Reader } -> ![]ir::Pat {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Pat){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            expect{ &r, c = '(' }
            let variant = id32{ &r }
            let binds = try bind_list{ &r }
            expect{ &r, c = ')' }
            try list::push{ list = &xs, item = ir::Pat{ variant, binds } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    // [(SLOT FIELD BYREF)...]
    fn bind_list { mut r: Reader } -> ![]ir::Bind {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Bind){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            expect{ &r, c = '(' }
            let slot = id32{ &r }
            let field = id32{ &r }
            let by_ref = flag{ &r }
            expect{ &r, c = ')' }
            try list::push{ list = &xs, item = ir::Bind{ slot, field, by_ref } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    // ---- expressions

    fn expr { mut r: Reader } -> !ir::Expr {
        expect{ &r, c = '(' }
        let tag = sym{ &r }
        let ty = id32{ &r }
        let mut k = ir::ExprKind::nil
        if r.failed {
            return ir::Expr{ ty, k }
        }
        // Roughly by how often each appears.
        if spells{ s = tag, lit = "local" } {
            k = ir::ExprKind::local{ slot = id32{ &r } }
        } else if spells{ s = tag, lit = "constref" } {
            k = ir::ExprKind::constref{ id = id32{ &r } }
        } else if spells{ s = tag, lit = "cvar" } {
            k = ir::ExprKind::cvar{ id = id32{ &r } }
        } else if spells{ s = tag, lit = "call" } {
            let callee = id32{ &r }
            k = ir::ExprKind::call{ callee, args = try args{ &r } }
        } else if spells{ s = tag, lit = "addr" } {
            k = ir::ExprKind::addr{ place = try sub{ &r } }
        } else if spells{ s = tag, lit = "deref" } {
            let ptr = try sub{ &r }
            k = ir::ExprKind::deref{ ptr, pos = pos{ &r } }
        } else if spells{ s = tag, lit = "field" } {
            let base = try sub{ &r }
            k = ir::ExprKind::field{ base, index = id32{ &r } }
        } else if spells{ s = tag, lit = "int" } {
            let negative = eat{ &r, c = '-' }
            k = ir::ExprKind::int{ negative, value = num{ &r } }
        } else if spells{ s = tag, lit = "cmp" } {
            let op = cmp_op{ &r }
            let a = try sub{ &r }
            k = ir::ExprKind::cmp{ op, a, b = try sub{ &r } }
        } else if spells{ s = tag, lit = "arith" } {
            let op = arith_op{ &r }
            let a = try sub{ &r }
            let b = try sub{ &r }
            k = ir::ExprKind::arith{ op, a, b, pos = pos{ &r } }
        } else if spells{ s = tag, lit = "bits" } {
            let op = bit_op{ &r }
            let a = try sub{ &r }
            k = ir::ExprKind::bits{ op, a, b = try sub{ &r } }
        } else if spells{ s = tag, lit = "shift" } {
            let op = shift_op{ &r }
            let a = try sub{ &r }
            let b = try sub{ &r }
            k = ir::ExprKind::shift{ op, a, b, pos = pos{ &r } }
        } else if spells{ s = tag, lit = "variant" } {
            let index = id32{ &r }
            k = ir::ExprKind::variant{ index, items = try args{ &r } }
        } else if spells{ s = tag, lit = "struct" } {
            k = ir::ExprKind::record{ items = try args{ &r } }
        } else if spells{ s = tag, lit = "str" } {
            k = ir::ExprKind::str{ bytes = try string{ &r } }
        } else if spells{ s = tag, lit = "sbytes" } {
            k = ir::ExprKind::sbytes{ bytes = try string{ &r } }
        } else if spells{ s = tag, lit = "cstr" } {
            k = ir::ExprKind::cstr{ bytes = try string{ &r } }
        } else if spells{ s = tag, lit = "some" } {
            k = ir::ExprKind::some{ e = try sub{ &r } }
        } else if spells{ s = tag, lit = "widen" } {
            k = ir::ExprKind::widen{ e = try sub{ &r } }
        } else if spells{ s = tag, lit = "payload" } {
            let base = try sub{ &r }
            let variant = id32{ &r }
            k = ir::ExprKind::payload{ base, variant, field = id32{ &r } }
        } else if spells{ s = tag, lit = "index" } {
            let base = try sub{ &r }
            let i = try sub{ &r }
            k = ir::ExprKind::index{ base, i, pos = pos{ &r } }
        } else if spells{ s = tag, lit = "sindex" } {
            let base = try sub{ &r }
            let i = try sub{ &r }
            k = ir::ExprKind::sindex{ base, i, pos = pos{ &r } }
        } else if spells{ s = tag, lit = "ssub" } {
            let base = try sub{ &r }
            let lo = try sub{ &r }
            let hi: ?*ir::Expr = if none{ &r } { null } else { try sub{ &r } }
            k = ir::ExprKind::ssub{ base, lo, hi, pos = pos{ &r } }
        } else if spells{ s = tag, lit = "null" } {
            k = ir::ExprKind::nil
        } else if spells{ s = tag, lit = "bool" } {
            k = ir::ExprKind::boolean{ value = flag{ &r } }
        } else if spells{ s = tag, lit = "isnull" } {
            k = ir::ExprKind::isnull{ e = try sub{ &r } }
        } else if spells{ s = tag, lit = "notnull" } {
            k = ir::ExprKind::notnull{ e = try sub{ &r } }
        } else if spells{ s = tag, lit = "not" } {
            k = ir::ExprKind::lnot{ e = try sub{ &r } }
        } else if spells{ s = tag, lit = "and" } {
            let a = try sub{ &r }
            k = ir::ExprKind::land{ a, b = try sub{ &r } }
        } else if spells{ s = tag, lit = "or" } {
            let a = try sub{ &r }
            k = ir::ExprKind::lor{ a, b = try sub{ &r } }
        } else if spells{ s = tag, lit = "ptradd" } {
            let p = try sub{ &r }
            k = ir::ExprKind::ptradd{ p, n = try sub{ &r } }
        } else if spells{ s = tag, lit = "fnref" } {
            k = ir::ExprKind::fnref{ callee = id32{ &r } }
        } else if spells{ s = tag, lit = "ifx" } {
            let c = try sub{ &r }
            let then = try block{ &r }
            k = ir::ExprKind::ifx{ c, then, els = try block{ &r } }
        } else if spells{ s = tag, lit = "matchx" } {
            let scrut = try sub{ &r }
            let through = flag{ &r }
            k = ir::ExprKind::matchx{ scrut, through, arms = try arms{ &r } }
        } else if spells{ s = tag, lit = "switchx" } {
            let scrut = try sub{ &r }
            k = ir::ExprKind::switchx{ scrut, cases = try cases{ &r } }
        } else if spells{ s = tag, lit = "dcall" } {
            let callee = try sub{ &r }
            k = ir::ExprKind::dcall{ callee, args = try args{ &r } }
        } else if spells{ s = tag, lit = "as" } {
            let e = try sub{ &r }
            k = ir::ExprKind::convert{ e, pos = pos{ &r } }
        } else if spells{ s = tag, lit = "neg" } {
            let e = try sub{ &r }
            k = ir::ExprKind::neg{ e, pos = pos{ &r } }
        } else if spells{ s = tag, lit = "float" } {
            k = ir::ExprKind::float{ value = float{ &r, ty } }
        } else if spells{ s = tag, lit = "array" } {
            k = ir::ExprKind::array{ elems = try exprs{ &r } }
        } else if spells{ s = tag, lit = "repeat" } {
            k = ir::ExprKind::repeat{ elem = try sub{ &r } }
        } else if spells{ s = tag, lit = "seq" } {
            let first = try sub{ &r }
            k = ir::ExprKind::seq{ first, then = try sub{ &r } }
        } else if spells{ s = tag, lit = "with" } {
            let slot = id32{ &r }
            let init = try sub{ &r }
            k = ir::ExprKind::with{ slot, init, body = try sub{ &r } }
        } else if spells{ s = tag, lit = "cast" } {
            k = ir::ExprKind::cast{ e = try sub{ &r } }
        } else if spells{ s = tag, lit = "ptraddr" } {
            k = ir::ExprKind::ptraddr{ e = try sub{ &r } }
        } else if spells{ s = tag, lit = "trunc" } {
            k = ir::ExprKind::trunc{ e = try sub{ &r } }
        } else if spells{ s = tag, lit = "wrap" } {
            let op = arith_op{ &r }
            let a = try sub{ &r }
            k = ir::ExprKind::wrap{ op, a, b = try sub{ &r } }
        } else if spells{ s = tag, lit = "fnconv" } {
            k = ir::ExprKind::fnconv{ e = try sub{ &r } }
        } else if spells{ s = tag, lit = "bind" } {
            let callee = id32{ &r }
            k = ir::ExprKind::bind{ callee, args = try args{ &r } }
        } else if spells{ s = tag, lit = "dbind" } {
            let callee = try sub{ &r }
            k = ir::ExprKind::dbind{ callee, args = try args{ &r } }
        } else {
            fail{ &r, problem = Problem::unknown_tag }
        }
        expect{ &r, c = ')' }
        return ir::Expr{ ty, k }
    }

    // An expression, on the heap.
    fn sub { mut r: Reader } -> !*ir::Expr {
        return try box{ &r, e = try expr{ &r } }
    }

    fn box { mut r: Reader, e: ir::Expr } -> !*ir::Expr {
        let p = try alloc::new{ realloc = arena::alloc, heap = r.heap, value = e }
        return p
    }

    // [E...]
    fn exprs { mut r: Reader } -> ![]ir::Expr {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Expr){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            try list::push{ list = &xs, item = try expr{ &r } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    // [(INDEX E)...]
    fn args { mut r: Reader } -> ![]ir::Arg {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Arg){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            expect{ &r, c = '(' }
            let index = id32{ &r }
            let value = try expr{ &r }
            expect{ &r, c = ')' }
            try list::push{ list = &xs, item = ir::Arg{ index, value } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    fn arith_op { mut r: Reader } -> ir::ArithOp {
        let s = sym{ &r }
        if spells{ s, lit = "add" } { return ir::ArithOp::add }
        if spells{ s, lit = "sub" } { return ir::ArithOp::sub }
        if spells{ s, lit = "mul" } { return ir::ArithOp::mul }
        if spells{ s, lit = "div" } { return ir::ArithOp::div }
        if not spells{ s, lit = "rem" } { fail{ &r, problem = Problem::unknown_tag } }
        return ir::ArithOp::rem
    }

    fn bit_op { mut r: Reader } -> ir::BitOp {
        let s = sym{ &r }
        if spells{ s, lit = "and" } { return ir::BitOp::bit_and }
        if spells{ s, lit = "or" } { return ir::BitOp::bit_or }
        if not spells{ s, lit = "xor" } { fail{ &r, problem = Problem::unknown_tag } }
        return ir::BitOp::bit_xor
    }

    fn shift_op { mut r: Reader } -> ir::ShiftOp {
        let s = sym{ &r }
        if spells{ s, lit = "shl" } { return ir::ShiftOp::shl }
        if not spells{ s, lit = "shr" } { fail{ &r, problem = Problem::unknown_tag } }
        return ir::ShiftOp::shr
    }

    fn cmp_op { mut r: Reader } -> ir::CmpOp {
        let s = sym{ &r }
        if spells{ s, lit = "eq" } { return ir::CmpOp::eq }
        if spells{ s, lit = "ne" } { return ir::CmpOp::ne }
        if spells{ s, lit = "lt" } { return ir::CmpOp::lt }
        if spells{ s, lit = "le" } { return ir::CmpOp::le }
        if spells{ s, lit = "gt" } { return ir::CmpOp::gt }
        if not spells{ s, lit = "ge" } { fail{ &r, problem = Problem::unknown_tag } }
        return ir::CmpOp::ge
    }

    // A float literal of type `ty`: an f32 is read as an f32, so it rounds once.
    fn float { mut r: Reader, ty: ir::TypeId } -> f64 {
        skip_space{ &r }
        let start = r.pos
        while r.pos < r.text.len and not ends_token{ c = r.text[r.pos] } { r.pos = r.pos + 1 }
        let ok{ value = text } = utf8::from{ bytes = r.text[start..r.pos] } else {
            fail{ &r, problem = Problem::bad_float }
            return 0.0
        }
        let mut is32 = false
        if ty < r.types.len {
            let prim{ p } = r.types[ty] else { return 0.0 }
            is32 = match p { f32 => { true } else => { false } }
        }
        if is32 {
            let value = utf8::parse_f32{ s = text } ifnull {
                fail{ &r, problem = Problem::bad_float }
                return 0.0
            }
            return value
        }
        let value = utf8::parse_f64{ s = text } ifnull {
            fail{ &r, problem = Problem::bad_float }
            return 0.0
        }
        return value
    }

    // ---- atoms

    fn pos { mut r: Reader } -> ir::Pos {
        let line = id32{ &r }
        let col = id32{ &r }
        return ir::Pos{ line, col, file = id32{ &r } }
    }

    // [STR...]
    fn strings { mut r: Reader } -> ![]ir::Bytes {
        expect{ &r, c = '[' }
        let mut xs = list::new(ir::Bytes){ realloc = arena::alloc, heap = r.heap }
        while more{ &r, close = ']' } {
            try list::push{ list = &xs, item = try string{ &r } }
        }
        expect{ &r, c = ']' }
        return list::items{ list = xs }
    }

    // "...": a view of the text, or a decoded copy if it has escapes.
    fn string { mut r: Reader } -> !ir::Bytes {
        expect{ &r, c = '"' }
        let start = r.pos
        let mut escaped = false
        while r.pos < r.text.len {
            let c = r.text[r.pos]
            if c == '"' { break }
            if c == '\\' { escaped = true }
            r.pos = r.pos + 1
        }
        let raw = r.text[start..r.pos]
        expect{ &r, c = '"' }
        if not escaped or r.failed { return raw }

        let mut out = list::new(u8){ realloc = arena::alloc, heap = r.heap }
        let mut i = 0
        while i < raw.len {
            let c = raw[i]
            if c != '\\' {
                try list::push{ list = &out, item = c }
                i = i + 1
                continue
            }
            if i + 3 >= raw.len or raw[i + 1] != 'x' {
                fail{ &r, problem = Problem::bad_escape }
                return raw
            }
            let hi = hex{ c = raw[i + 2] } ifnull {
                fail{ &r, problem = Problem::bad_escape }
                return raw
            }
            let lo = hex{ c = raw[i + 3] } ifnull {
                fail{ &r, problem = Problem::bad_escape }
                return raw
            }
            try list::push{ list = &out, item = hi * 16 + lo }
            i = i + 4
        }
        return list::items{ list = out }
    }

    fn hex { c: u8 } -> ?u8 {
        if c >= '0' and c <= '9' { return c - '0' }
        if c >= 'a' and c <= 'f' { return c - 'a' + 10 }
        return null
    }

    // An unsigned decimal integer.
    fn num { mut r: Reader } -> u64 {
        skip_space{ &r }
        let start = r.pos
        let mut v = 0
        while r.pos < r.text.len {
            let c = r.text[r.pos]
            if c < '0' or c > '9' { break }
            let d: u64 = c - '0'
            if v > (18446744073709551615 - d) / 10 {
                fail{ &r, problem = Problem::int_too_large }
                return 0
            }
            v = v * 10 + d
            r.pos = r.pos + 1
        }
        if r.pos == start { fail{ &r, problem = Problem::expected_int } }
        return v
    }

    // An id, slot or index: an integer that fits in a u32.
    fn id32 { mut r: Reader } -> u32 {
        let v = num{ &r }
        if v > 4294967295 {
            fail{ &r, problem = Problem::int_too_large }
            return 0
        }
        return @as(u32, v)
    }

    // A loop label: an id before the closing `)`, if there is one.
    fn label { mut r: Reader } -> ?u32 {
        skip_space{ &r }
        if r.failed or r.pos >= r.text.len or r.text[r.pos] == ')' { return null }
        return id32{ &r }
    }

    // `_`, or an id.
    fn opt_id { mut r: Reader } -> ?u32 {
        if none{ &r } { return null }
        return id32{ &r }
    }

    // 0 or 1.
    fn flag { mut r: Reader } -> bool {
        let v = num{ &r }
        if v > 1 { fail{ &r, problem = Problem::expected_int } }
        return v == 1
    }

    // Consumes `_` if it comes next, as a whole token.
    fn none { mut r: Reader } -> bool {
        skip_space{ &r }
        if r.failed or r.pos >= r.text.len or r.text[r.pos] != '_' { return false }
        if r.pos + 1 < r.text.len and is_ident{ c = r.text[r.pos + 1] } { return false }
        r.pos = r.pos + 1
        return true
    }

    fn sym { mut r: Reader } -> ir::Bytes {
        skip_space{ &r }
        let start = r.pos
        while r.pos < r.text.len and is_ident{ c = r.text[r.pos] } { r.pos = r.pos + 1 }
        if r.pos == start { fail{ &r, problem = Problem::expected_symbol } }
        return r.text[start..r.pos]
    }

    // A symbol that must be w.
    fn word { mut r: Reader, w: []u8 } {
        let s = sym{ &r }
        if not r.failed and not slice::eq_bytes{ a = s, b = w } {
            fail{ &r, problem = Problem::unknown_tag }
        }
    }

    // Does symbol s spell `lit`?
    fn spells { s: ir::Bytes, lit: []u8 } -> bool {
        return slice::eq_bytes{ a = s, b = lit }
    }

    fn is_ident { c: u8 } -> bool {
        return (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '_'
    }

    fn ends_token { c: u8 } -> bool {
        return c == ' ' or c == '\n' or c == ')' or c == ']' or c == '}' or c == '(' or c == '['
    }

    fn skip_space { mut r: Reader } {
        while r.pos < r.text.len {
            let c = r.text[r.pos]
            if c != ' ' and c != '\n' and c != '\r' and c != '\t' { break }
            r.pos = r.pos + 1
        }
    }

    // Is there another item before `close`? False after an error, which ends every list.
    fn more { mut r: Reader, close: u8 } -> bool {
        skip_space{ &r }
        if r.failed or r.pos >= r.text.len { return false }
        return r.text[r.pos] != close
    }

    // Consumes c if it comes next.
    fn eat { mut r: Reader, c: u8 } -> bool {
        skip_space{ &r }
        if r.failed or r.pos >= r.text.len or r.text[r.pos] != c { return false }
        r.pos = r.pos + 1
        return true
    }

    fn expect { mut r: Reader, c: u8 } {
        if not eat{ &r, c } { fail{ &r, problem = Problem::expected{ c } } }
    }

    // Records the first error.
    fn fail { mut r: Reader, problem: Problem } {
        if r.failed { return }
        r.failed = true
        r.error = problem
        r.error_at = r.pos
    }
}
