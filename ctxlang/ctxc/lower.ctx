// Lowering: the checked program as typed IR (ir.ctx), a port of ctxi/irdump.py. It walks the
// syntax trees with the checker's side tables where ctxi walks its rewritten tree, from `main`
// through every function instance it reaches.
//
//   let p = lower::program{ c = &c }
//
// The IR must equal ctxi's byte for byte, so this follows ctxi's order exactly: IR types,
// function instances, consts, locals and files all get their ids in the order the lowering
// first meets them, and ctxi sometimes lowers a later child first (an `if` lowers its `else`
// block before its condition).

namespace lower {
    type Heap = arena::Arena
    type Id = types::Id

    const NONE: u32 = 4294967295
    const VERSION: u64 = 26

    // A function instance: a declaration and its generic arguments. The hidden fn of an @fmt
    // without a sink is an instance too, under the declaration it is in: site is its Site,
    // NONE for any other. So is a widening thunk (widen), under the declaration whose file it
    // goes in. The derived text fn of a type, for a site, has both site and entry, the type
    // (showing), and the fn that gives a `!` fn's exit code has the site CODED (coding).
    struct Inst { decl: u32, targs: []Id, site: u32, widen: ?Widen, entry: Id }

    // A thunk of function type `to` (spec §5): it calls instance callee, or with callee NONE its
    // first param, a function value of type frm, reading each field frm takes read-only and to
    // has `mut` through its pointer, and renumbers the error into to's if its `!T` may fail with
    // more (widening).
    struct Widen { callee: u32, frm: Id, to: Id }

    struct Lower {
        c:         *mut check::Checker,
        heap:      *mut Heap,
        types:     list::List(ir::Type, Heap),
        type_ids:  map::Map(Id, u32, Heap),        // by the checker type, normalized (norm)
        queue:     list::List(Inst, Heap),         // function instances, by id
        fn_ids:    map::Map([]u8, u32, Heap),      // by the instance's key (inst_key)
        fns:       list::List(ir::Func, Heap),
        consts:    list::List(ir::Const, Heap),
        const_ids: map::Map(u32, u32, Heap),       // by the const's Decl
        vars:      list::List(ir::Var, Heap),
        var_owners: list::List(u32, Heap),         // each var's capability Decl, which with its name finds it
        statics:   list::List(ir::Static, Heap),
        static_owners: list::List(u32, Heap),      // each static's capability Decl, as var_owners
        static_names: list::List([]u8, Heap),      // and its own name
        files:     list::List([]u8, Heap),
        file_ids:  map::Map(u32, u32, Heap),       // by the checker's file index
        // The function being lowered: its instance, and its locals' slots.
        decl:      u32,
        targs:     []Id,
        ret:       Id,
        slots:     map::Map(u32, u32, Heap),       // by the checker's Var
        locals:    list::List(ir::Local, Heap),
        failed:    bool,                           // a const or converted literal it met has no value, and said why
        // Each `ifoverflow` being lowered, by its key: its trap (ir::NO_TRAP), which the
        // operations it covers (check's traps) leave for. Trap ids are unique in the program.
        trap_ids:  map::Map(u64, u32, Heap),
        traps:     u32,
        // The operands of the @expect being lowered that are held in locals, by expr key: the
        // comparison reads them there (ex).
        kept:      map::Map(u64, Kept, Heap),
        // In a test build, the fn that runs each of the checker's tests, in their order.
        test_ids:  list::List(u32, Heap),
        // The C libraries to link (ir::Program.links), and the capabilities whose `#c_link`s
        // are among them (reach_links).
        links:     list::List(ir::Link, Heap),
        linked:    list::List(u32, Heap),
    }

    fn program { mut c: check::Checker } -> ir::Program {
        let mut l = lowering{ &c }
        // An entry point that returns `!` or `!i32` is run through the fn that gives its exit
        // code (coding).
        let main = if map::has{ m = c.exit_sites, key = c.main } { coded_id{ &l, d = c.main } } else { fn_id{ &l, decl = c.main, targs = no_ids{} } }
        // A test build's tests, each through the fn that gives its exit code if it returns a `!`.
        if c.testing {
            for t in list::items{ list = c.tests } {
                let id = if map::has{ m = c.exit_sites, key = t.decl } { coded_id{ &l, d = t.decl } } else { fn_id{ &l, decl = t.decl, targs = no_ids{} } }
                try! list::push{ list = &l.test_ids, item = id }
            }
        }
        let s = check::start_fn{ c }
        let start = if s == NONE { NONE } else { fn_id{ &l, decl = s, targs = no_ids{} } }
        let h = check::panic_fn{ c }
        let panic = if h == NONE { NONE } else { fn_id{ &l, decl = h, targs = no_ids{} } }
        let v = check::stack_limit{ c }
        let limit = if let value = v { static_of{ &l, v = value } } else { NONE }
        // Each `#c_export` fn is lowered whether or not the program calls it, since C does.
        let mut exports = list::new(ir::Export){ realloc = arena::alloc, heap = l.heap }
        for d in list::items{ list = c.fns } {
            let x = check::get_decl{ c, d }
            if x.export.len > 0 {
                let ty = tid{ &l, t = types::func{ s = &c.ty, fields = x.fields, ret = x.ret, bound = false, external = true, keeps = slice::empty(types::Keep){}, thread = false } }
                try! list::push{ list = &exports, item = ir::Export{ callee = fn_id{ &l, decl = d, targs = no_ids{} }, ty, name = x.export } }
            }
        }
        let p = finish{ &l, main, start, panic, stack_limit = limit, adapters = true, exports = list::items{ list = exports } }
        if l.failed { @panic("lower: a const or literal without a value") }
        return p
    }

    // Const d's initializer, or fn d, as a program of its own, for the interpreter (comptime.ctx):
    // its main is a function without context that returns the const's value, or fn d, a literal
    // conversion, and the rest is what that reaches. It has its own Lower, so the program's IR
    // doesn't change. Null if a const or converted literal it needs has no value; why is
    // reported.
    fn alone { mut c: check::Checker, d: u32 } -> ?ir::Program {
        let mut l = lowering{ &c }
        let main = fn_id{ &l, decl = d, targs = no_ids{} }
        let p = finish{ &l, main, start = NONE, panic = NONE, stack_limit = NONE, adapters = false, exports = slice::empty(ir::Export){} }
        if l.failed { return null }
        return p
    }

    fn lowering { mut c: check::Checker } -> Lower {
        // Checking is done: a distinct type is its base from here on (§12, Distinct types).
        c.ty.erased = true
        return Lower{
            c = &c, heap = c.heap,
            types = list::new(ir::Type){ realloc = arena::alloc, heap = c.heap },
            type_ids = map::new(Id, u32){ realloc = arena::alloc, heap = c.heap, hash = map::hash_u32, eq = map::eq_u32 },
            queue = list::new(Inst){ realloc = arena::alloc, heap = c.heap },
            fn_ids = map::new([]u8, u32){ realloc = arena::alloc, heap = c.heap, hash = map::hash_bytes, eq = slice::eq_bytes },
            fns = list::new(ir::Func){ realloc = arena::alloc, heap = c.heap },
            consts = list::new(ir::Const){ realloc = arena::alloc, heap = c.heap },
            const_ids = map::new(u32, u32){ realloc = arena::alloc, heap = c.heap, hash = map::hash_u32, eq = map::eq_u32 },
            vars = list::new(ir::Var){ realloc = arena::alloc, heap = c.heap },
            var_owners = list::new(u32){ realloc = arena::alloc, heap = c.heap },
            statics = list::new(ir::Static){ realloc = arena::alloc, heap = c.heap },
            static_owners = list::new(u32){ realloc = arena::alloc, heap = c.heap },
            static_names = list::new([]u8){ realloc = arena::alloc, heap = c.heap },
            files = list::new([]u8){ realloc = arena::alloc, heap = c.heap },
            file_ids = map::new(u32, u32){ realloc = arena::alloc, heap = c.heap, hash = map::hash_u32, eq = map::eq_u32 },
            decl = NONE, targs = no_ids{}, ret = types::VOID,
            slots = map::new(u32, u32){ realloc = arena::alloc, heap = c.heap, hash = map::hash_u32, eq = map::eq_u32 },
            locals = list::new(ir::Local){ realloc = arena::alloc, heap = c.heap },
            failed = false,
            trap_ids = map::new(u64, u32){ realloc = arena::alloc, heap = c.heap, hash = map::hash_u64, eq = map::eq_u64 },
            kept = map::new(u64, Kept){ realloc = arena::alloc, heap = c.heap, hash = map::hash_u64, eq = map::eq_u64 },
            test_ids = list::new(u32){ realloc = arena::alloc, heap = c.heap },
            links = list::new(ir::Link){ realloc = arena::alloc, heap = c.heap },
            linked = list::new(u32){ realloc = arena::alloc, heap = c.heap },
            traps = 0,
        }
    }

    // Lowers the queued instances, and those they reach, into a program, with the functions that
    // run it (adapters: entry_fns) for a program, but not for a const's.
    fn finish { mut l: Lower, main: u32, start: u32, panic: u32, stack_limit: u32, adapters: bool, exports: []ir::Export } -> ir::Program {
        let mut i: usize = 0
        while i < l.queue.len {
            let inst = list::items{ list = l.queue }[i]
            let kind = check::get_decl{ c = l.c.*, d = inst.decl }.kind
            let f = if inst.widen != null {
                widening{ &l, id = @as(u32, i), inst }
            } else if inst.site == DERIVED_EQ or inst.site == DERIVED_HASH {
                deriving{ &l, id = @as(u32, i), inst }
            } else if inst.site == CODED {
                coding{ &l, id = @as(u32, i), inst }
            } else if inst.site != NONE and inst.entry != NONE {
                showing{ &l, id = @as(u32, i), inst }
            } else if inst.entry != NONE {
                entering{ &l, id = @as(u32, i), inst }
            } else if inst.site != NONE {
                hidden{ &l, id = @as(u32, i), inst }
            } else if kind == check::Kind::external {
                external{ &l, id = @as(u32, i), d = inst.decl }
            } else if kind == check::Kind::constant {
                const_fn{ &l, id = @as(u32, i), d = inst.decl }
            } else {
                function{ &l, id = @as(u32, i), inst }
            }
            try! list::push{ list = &l.fns, item = f }
            i = i + 1
        }
        let ends = if adapters { entry_fns{ &l, main, start, panic, limit = stack_limit } } else { Entry{ entry = NONE, on_panic = NONE } }
        let threaded = adapters and threaded_program{ l }
        return ir::Program{
            version = VERSION,
            files = list::items{ list = l.files },
            types = list::items{ list = l.types },
            consts = list::items{ list = l.consts },
            vars = list::items{ list = l.vars },
            statics = list::items{ list = l.statics },
            fns = list::items{ list = l.fns },
            main, start, panic, entry = ends.entry, on_panic = ends.on_panic, stack_limit, threaded, exports,
            links = list::items{ list = l.links },
        }
    }

    // Whether the program may run on several threads (spec §15, Entry point, rule 8): it has a
    // callback that C may call from any thread, as std's thread entry is, so a program that can
    // start a thread is one.
    fn threaded_program { l: Lower } -> bool {
        let q = list::items{ list = l.queue }
        let mut i: usize = 0
        while i < q.len {
            if q[i].site == NONE and q[i].widen == null and q[i].entry == NONE and check::get_decl{ c = l.c.*, d = q[i].decl }.any_thread { return true }
            i = i + 1
        }
        return false
    }

    // ---- the entry point (spec §15, Entry point)
    //
    // What C's main and the runtime call, as functions of the IR, so that each backend runs a
    // program the same way and only passes them what the platform gives:
    //   entry      { argc?, argv? } -> i32: the `#start` fn with its capabilities, the fields
    //              of C's it takes and `main` as a function value; without one, main itself
    //              with no args, whose exit code is 0 if it returns nothing.
    //   main value { args } -> i32: main with its capabilities, for the start fn's `main`.
    //   on panic   { msg?, file?, line?, col? }: turns the stack check off, so that a stack
    //              overflow can be reported, and calls the `#panic` fn.
    // A capability comes from nothing (capref), as the runtime supplies main's.

    struct Entry { entry: u32, on_panic: u32 }

    // A field the caller supplies to a call that supply_call writes, by name.
    struct Given { name: []u8, value: ir::Expr }

    // A function being written: its locals and statements.
    struct Adapter { locals: list::List(ir::Local, Heap), stmts: list::List(ir::Stmt, Heap) }

    fn entry_fns { mut l: Lower, main: u32, start: u32, panic: u32, limit: u32 } -> Entry {
        let m = list::items{ list = l.fns }[main]
        let i32t = tid{ &l, t = types::I32 }
        let mut out = Entry{ entry = NONE, on_panic = NONE }
        // In a test build main is the `#test_main` fn, which is given the tests too.
        let tests = if l.c.testing { test_given{ &l, m } } else { slice::empty(Given){} }

        // main as a function value, for the start fn's `main`
        let mut value: ?ir::Expr = null
        if start != NONE {
            let s = list::items{ list = l.fns }[start]
            let k = param_at{ ps = s.params, name = "main" }
            if k != NONE and not cap_type{ l, t = s.params[k].ty } {
                let ft = s.params[k].ty
                let func{ params } = list::items{ list = l.types }[ft] else { @panic("lower: a start fn's main isn't a function") }
                let mut a = adapter{ l }
                let mut given = list::new(Given){ realloc = arena::alloc, heap = l.heap }
                for g in tests { try! list::push{ list = &given, item = g } }
                let mut i: usize = 0
                while i < params.len {
                    try! list::push{ list = &a.locals, item = ir::Local{ name = params[i].name, ty = params[i].ty } }
                    try! list::push{ list = &given, item = Given{ name = params[i].name, value = mk{ ty = params[i].ty, k = ir::ExprKind::local{ slot = @as(u32, i) } } } }
                    i = i + 1
                }
                returns_code{ &l, &a, call = supply_call{ &l, &a, f = m, given = list::items{ list = given } }, i32t }
                let id = add_adapter{ &l, a, name = "<main value>", params, ret = i32t, near = m, shown = ir::Shown::root }
                value = mk{ ty = ft, k = ir::ExprKind::fnref{ callee = id } }
            }
        }

        // entry
        let mut a = adapter{ l }
        let mut params = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
        let mut given = list::new(Given){ realloc = arena::alloc, heap = l.heap }
        if start != NONE {
            let s = list::items{ list = l.fns }[start]
            let mut i: usize = 0
            while i < s.params.len {
                let q = s.params[i]
                if slice::eq_bytes{ a = q.name, b = "main" } and not cap_type{ l, t = q.ty } {
                    if let v = value { try! list::push{ list = &given, item = Given{ name = q.name, value = v } } }
                } else if not cap_type{ l, t = q.ty } {
                    let slot = @as(u32, a.locals.len)
                    try! list::push{ list = &params, item = q }
                    try! list::push{ list = &a.locals, item = ir::Local{ name = q.name, ty = q.ty } }
                    try! list::push{ list = &given, item = Given{ name = q.name, value = mk{ ty = q.ty, k = ir::ExprKind::local{ slot } } } }
                }
                i = i + 1
            }
            let call = supply_call{ &l, &a, f = s, given = list::items{ list = given } }
            try! list::push{ list = &a.stmts, item = ir::Stmt::ret{ value = call } }
        } else {
            for g in tests { try! list::push{ list = &given, item = g } }
            returns_code{ &l, &a, call = supply_call{ &l, &a, f = m, given = list::items{ list = given } }, i32t }
        }
        out.entry = add_adapter{ &l, a, name = "<entry>", params = list::items{ list = params }, ret = i32t, near = m, shown = ir::Shown::hidden }

        // on panic
        if panic != NONE {
            let h = list::items{ list = l.fns }[panic]
            let mut b = adapter{ l }
            let mut ps = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
            let mut gs = list::new(Given){ realloc = arena::alloc, heap = l.heap }
            let mut i: usize = 0
            while i < h.params.len {
                let q = h.params[i]
                if not cap_type{ l, t = q.ty } {
                    let slot = @as(u32, b.locals.len)
                    try! list::push{ list = &ps, item = q }
                    try! list::push{ list = &b.locals, item = ir::Local{ name = q.name, ty = q.ty } }
                    try! list::push{ list = &gs, item = Given{ name = q.name, value = mk{ ty = q.ty, k = ir::ExprKind::local{ slot } } } }
                }
                i = i + 1
            }
            if limit != NONE {
                let st = list::items{ list = l.statics }[limit].ty
                let pt = tid{ &l, t = types::ptr{ s = &l.c.ty, elem = types::USIZE, mutable = true } }
                let at = mk{ ty = pt, k = ir::ExprKind::saddr{ id = limit } }
                let place = mk{ ty = st, k = ir::ExprKind::deref{ ptr = box{ l, e = at }, pos = ir::Pos{ line = 0, col = 0, file = 0 } } }
                try! list::push{ list = &b.stmts, item = ir::Stmt::assign{ place, value = mk{ ty = st, k = ir::ExprKind::int{ negative = false, value = 0 } } } }
            }
            let call = supply_call{ &l, a = &b, f = h, given = list::items{ list = gs } }
            try! list::push{ list = &b.stmts, item = ir::Stmt::eval{ e = call } }
            out.on_panic = add_adapter{ &l, a = b, name = "<on panic>", params = list::items{ list = ps }, ret = h.ret, near = h, shown = ir::Shown::hidden }
        }
        return out
    }

    fn adapter { l: Lower } -> Adapter {
        return Adapter{ locals = list::new(ir::Local){ realloc = arena::alloc, heap = l.heap }, stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap } }
    }

    // A call of f: each capability from nothing, a read-only one zeroed in a local, and the
    // other fields from given, by name, or zeroed in a local without one.
    fn supply_call { mut l: Lower, mut a: Adapter, f: ir::Func, given: []Given } -> ir::Expr {
        let mut args = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < f.params.len {
            let q = f.params[i]
            let mut v: ?ir::Expr = null
            if q.mutable and cap_type{ l, t = q.ty } {
                v = mk{ ty = f.locals[i].ty, k = ir::ExprKind::capref }
            } else if not cap_type{ l, t = q.ty } {
                let mut k: usize = 0
                while k < given.len {
                    if slice::eq_bytes{ a = given[k].name, b = q.name } { v = given[k].value }
                    k = k + 1
                }
            }
            let value = v ifnull {
                let slot = @as(u32, a.locals.len)
                try! list::push{ list = &a.locals, item = ir::Local{ name = q.name, ty = q.ty } }
                try! list::push{ list = &a.stmts, item = ir::Stmt::zero{ slot } }
                mk{ ty = q.ty, k = ir::ExprKind::local{ slot } }
            }
            add_arg{ xs = &args, a = ir::Arg{ index = @as(u32, i), value } }
            i = i + 1
        }
        return mk{ ty = f.ret, k = ir::ExprKind::call{ callee = f.id, args = list::items{ list = args }, pos = nowhere{} } }
    }

    // `return call`, or `call; return 0` if it gives nothing: an exit code.
    fn returns_code { mut l: Lower, mut a: Adapter, call: ir::Expr, i32t: u32 } {
        if list::items{ list = l.types }[call.ty] is void {
            try! list::push{ list = &a.stmts, item = ir::Stmt::eval{ e = call } }
            try! list::push{ list = &a.stmts, item = ir::Stmt::ret{ value = mk{ ty = i32t, k = ir::ExprKind::int{ negative = false, value = 0 } } } }
            return
        }
        try! list::push{ list = &a.stmts, item = ir::Stmt::ret{ value = call } }
    }

    fn add_adapter { mut l: Lower, a: Adapter, name: []u8, params: []ir::Param, ret: u32, near: ir::Func, shown: ir::Shown } -> u32 {
        let id = @as(u32, l.fns.len)
        try! list::push{ list = &l.fns, item = ir::Func{
            id, name, symbol = "", params, ret, locals = list::items{ list = a.locals },
            body = ir::Block{ stmts = list::items{ list = a.stmts }, result = null }, unit = near.unit, at = near.at,
            file = near.file, shown,
        } }
        return id
    }

    fn cap_type { l: Lower, t: u32 } -> bool {
        return list::items{ list = l.types }[t] is cap
    }

    fn param_at { ps: []ir::Param, name: []u8 } -> u32 {
        let mut i: usize = 0
        while i < ps.len {
            if slice::eq_bytes{ a = ps[i].name, b = name } { return @as(u32, i) }
            i = i + 1
        }
        return NONE
    }

    fn no_ids {} -> []Id {
        return slice::empty(Id){}
    }

    // The id of an instance, queued to be lowered the first time it is met.
    fn fn_id { mut l: Lower, decl: u32, targs: []Id } -> u32 {
        let k = inst_key{ &l, decl, targs }
        let known = map::get{ m = l.fn_ids, key = k }
        if known != null { return known }
        let i = @as(u32, l.queue.len)
        try! map::put{ m = &l.fn_ids, key = k, value = i }
        try! list::push{ list = &l.queue, item = Inst{ decl, targs, site = NONE, widen = null, entry = NONE } }
        let x = check::get_decl{ c = l.c.*, d = decl }
        if x.kind == check::Kind::external {
            for f in x.fields {
                let mut t = f.ty
                if get{ l, t } is ptr{ elem } { t = elem }
                if get{ l, t } is cap{ decl = d } { reach_links{ &l, d } }
            }
        }
        return i
    }

    // Capability d's `#c_link`s and those of the capabilities it includes, each capability's
    // once, the first time the program reaches it (spec §18, Extern functions, rule 11): an
    // extern fn that takes it, or one of its C variables, is called or read. A library two
    // capabilities name is linked for each, so that each lists its own dependencies after it.
    fn reach_links { mut l: Lower, d: u32 } {
        let x = check::get_decl{ c = l.c.*, d }
        if not has{ xs = list::items{ list = l.linked }, n = d } {
            try! list::push{ list = &l.linked, item = d }
            // A relative directory is from the file's.
            let dir = drive::parent{ path = unit_of{ l, x } }
            for k in x.links {
                let mut dirs = list::new(ir::Bytes){ realloc = arena::alloc, heap = l.heap }
                for at in k.dirs { try! list::push{ list = &dirs, item = drive::place{ heap = l.heap, dir, rel = at } } }
                try! list::push{ list = &l.links, item = ir::Link{ lib = k.lib, archive = k.archive, framework = k.framework, dirs = list::items{ list = dirs } } }
            }
        }
        for i in x.includes {
            if not has{ xs = list::items{ list = l.linked }, n = i } { reach_links{ &l, d = i } }
        }
    }

    fn has { xs: []u32, n: u32 } -> bool {
        for x in xs { if x == n { return true } }
        return false
    }

    // The id of the hidden fn of site si (Inst), in the instance being lowered.
    fn site_fn { mut l: Lower, site: u32 } -> u32 {
        let mut b = list::new(u8){ realloc = arena::alloc, heap = l.heap }
        let k = inst_key{ &l, decl = l.decl, targs = l.targs }
        let mut i: usize = 0
        while i < k.len {
            try! list::push{ list = &b, item = k[i] }
            i = i + 1
        }
        put_u32{ xs = &b, n = NONE }         // no type's id: no other key has it here
        put_u32{ xs = &b, n = site }
        let key = list::items{ list = b }
        let known = map::get{ m = l.fn_ids, key }
        if known != null { return known }
        let id = @as(u32, l.queue.len)
        try! map::put{ m = &l.fn_ids, key, value = id }
        try! list::push{ list = &l.queue, item = Inst{ decl = l.decl, targs = l.targs, site, widen = null, entry = NONE } }
        return id
    }

    // An instance's key: its declaration and its normalized arguments, four bytes each.
    fn inst_key { mut l: Lower, decl: u32, targs: []Id } -> []u8 {
        let mut b = list::new(u8){ realloc = arena::alloc, heap = l.heap }
        put_u32{ xs = &b, n = decl }
        let mut i: usize = 0
        while i < targs.len {
            put_u32{ xs = &b, n = norm{ &l, t = targs[i] } }
            i = i + 1
        }
        return list::items{ list = b }
    }

    fn put_u32 { mut xs: list::List(u8, Heap), n: u32 } {
        let mut k: u32 = 0
        while k < 4 {
            try! list::push{ list = &xs, item = @trunc(u8, n >> (k * 8)) }
            k = k + 1
        }
    }

    fn external { mut l: Lower, id: u32, d: u32 } -> ir::Func {
        let x = check::get_decl{ c = l.c.*, d }
        let params = params_of{ &l, fields = x.fields }
        let ret = tid{ &l, t = x.ret }
        let none = slice::empty(ir::Stmt){}
        return ir::Func{
            id, name = x.qual, symbol = x.symbol, params, ret,
            locals = slice::empty(ir::Local){}, body = ir::Block{ stmts = none, result = null },
            unit = unit_of{ l, x }, at = x.syn.span.start, file = file_of{ &l, x }, shown = ir::Shown::frame,
        }
    }

    // The file that declares x.
    fn unit_of { l: Lower, x: check::Decl } -> []u8 {
        return l.c.files[x.syn.span.file].name
    }

    // The file that declares x, among those the IR names (ir::Func.file).
    fn file_of { mut l: Lower, x: check::Decl } -> u32 {
        return pos{ &l, at = x.syn.span }.file
    }

    // The position of a call the compiler wrote: none.
    fn nowhere {} -> ir::Pos {
        return ir::Pos{ line = 0, col = 0, file = 0 }
    }

    fn params_of { mut l: Lower, fields: []types::Field } -> []ir::Param {
        let mut out = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < fields.len {
            let f = fields[i]
            let t = tid{ &l, t = T{ &l, t = f.ty } }
            try! list::push{ list = &out, item = ir::Param{ name = f.name, mutable = f.mutable, ty = t } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // A const's initializer as a function: `return e`, with no context.
    fn const_fn { mut l: Lower, id: u32, d: u32 } -> ir::Func {
        let x = check::get_decl{ c = l.c.*, d }
        l.decl = d
        l.targs = no_ids{}
        map::clear{ m = &l.slots }
        l.locals = list::new(ir::Local){ realloc = arena::alloc, heap = l.heap }
        l.ret = T{ &l, t = x.ty }
        let mut xs = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        if x.syn.k is constant{ value } {
            let r = conv{ &l, e = value, to = l.ret }
            try! list::push{ list = &xs, item = ir::Stmt::ret{ value = r } }
        }
        let ret = tid{ &l, t = l.ret }
        return ir::Func{
            id, name = x.qual, symbol = "", params = slice::empty(ir::Param){}, ret,
            locals = list::items{ list = l.locals }, body = ir::Block{ stmts = list::items{ list = xs }, result = null },
            unit = unit_of{ l, x }, at = x.syn.span.start, file = file_of{ &l, x }, shown = ir::Shown::frame,
        }
    }

    fn function { mut l: Lower, id: u32, inst: Inst } -> ir::Func {
        let x = check::get_decl{ c = l.c.*, d = inst.decl }
        l.decl = inst.decl
        l.targs = inst.targs
        map::clear{ m = &l.slots }
        l.locals = list::new(ir::Local){ realloc = arena::alloc, heap = l.heap }
        l.ret = T{ &l, t = x.ret }
        let first = map::get{ m = l.c.first_var, key = inst.decl }
        let mut params = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < x.fields.len {
            let f = x.fields[i]
            let t = tid{ &l, t = T{ &l, t = f.ty } }
            try! list::push{ list = &params, item = ir::Param{ name = f.name, mutable = f.mutable, ty = t } }
            if first != null { _ = slot{ &l, v = first + @as(u32, i) } }
            i = i + 1
        }
        let mut body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = null }
        if x.syn.k is func{ body = b } { body = block{ &l, b } }
        if check::void_result{ c = l.c.*, t = l.ret } {
            // A function returning a bare `!` that reaches its end returns `ok`.
            let mut xs = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
            let mut i: usize = 0
            while i < body.stmts.len {
                try! list::push{ list = &xs, item = body.stmts[i] }
                i = i + 1
            }
            try! list::push{ list = &xs, item = ir::Stmt::ret{ value = ok_unit{ &l } } }
            body = ir::Block{ stmts = list::items{ list = xs }, result = null }
        }
        let ret = tid{ &l, t = l.ret }
        return ir::Func{
            id, name = inst_name{ l, x, targs = inst.targs }, symbol = "", params = list::items{ list = params }, ret,
            locals = list::items{ list = l.locals }, body, unit = unit_of{ l, x }, at = x.syn.span.start,
            file = file_of{ &l, x }, shown = ir::Shown::frame,
        }
    }

    // An instance's name: its declaration's, with its generic arguments.
    fn inst_name { l: Lower, x: check::Decl, targs: []Id } -> []u8 {
        if targs.len == 0 { return x.qual }
        let mut b = message{ l }
        try! @fmt(&b, "{}(", str{ s = x.qual })
        let mut i: usize = 0
        while i < targs.len {
            if i > 0 { try! utf8::push{ &b, s = ", " } }
            try! utf8::push{ &b, s = check::tstr{ c = l.c.*, t = targs[i] } }
            i = i + 1
        }
        try! utf8::push{ &b, s = ")" }
        return utf8::view{ b }.bytes
    }

    // ---- types

    // t in the function being lowered: bound variables replaced, and generic parameters by its
    // arguments.
    fn T { mut l: Lower, t: Id } -> Id {
        let z = types::zonk{ s = &l.c.ty, t }
        if l.targs.len == 0 { return z }
        return types::subst{ s = &l.c.ty, t = z, decl = l.decl, args = l.targs }
    }

    fn get { l: Lower, t: Id } -> types::Type {
        return types::get{ s = l.c.ty, id = types::prune{ s = l.c.ty, t } }
    }

    // t as ctxi's tkey sees it: without pointer and slice mutability, a function type's fields
    // sorted by name, and a strlit as the []u8 it is. Two types are the same IR type exactly
    // when they normalize to one Id.
    fn norm { mut l: Lower, t: Id } -> Id {
        let x = types::prune{ s = l.c.ty, t }
        match types::get{ s = l.c.ty, id = x } {
            strlit => { return u8_slice{ &l } }
            ptr{ elem } => { return types::ptr{ s = &l.c.ty, elem = norm{ &l, t = elem }, mutable = false } }
            slice{ elem } => { return types::slice{ s = &l.c.ty, elem = norm{ &l, t = elem }, mutable = false } }
            opt{ elem } => { return types::opt{ s = &l.c.ty, elem = norm{ &l, t = elem } } }
            array{ n, elem } => { return types::array{ s = &l.c.ty, n, elem = norm{ &l, t = elem } } }
            record{ decl, args } => { return types::record{ s = &l.c.ty, decl, args = norm_all{ &l, ts = args } } }
            sum{ decl, args } => { return types::sum{ s = &l.c.ty, decl, args = norm_all{ &l, ts = args } } }
            // An error is its set: errors of two functions with the same set are one IR type.
            res{ ok, errs } => { return types::res{ s = &l.c.ty, ok = norm{ &l, t = ok }, errs = norm{ &l, t = errs } } }
            errs => { return check::eset_of{ c = l.c, t = x } }
            func{ fields, ret, bound, external } => {
                let sorted = if external { fields } else { sorted_fields{ l, fields } }
                let mut fs = list::new(types::Field){ realloc = arena::alloc, heap = l.heap }
                let mut i: usize = 0
                while i < sorted.len {
                    let f = sorted[i]
                    add_field{ xs = &fs, f = types::Field{ name = f.name, mutable = f.mutable, ty = norm{ &l, t = f.ty } } }
                    i = i + 1
                }
                // IR has no `&thread fn`: it is a `&fn` there.
                return types::func{ s = &l.c.ty, fields = list::items{ list = fs }, ret = norm{ &l, t = ret }, bound, external, keeps = slice::empty(types::Keep){}, thread = false }
            }
            else => { return x }
        }
    }

    fn norm_all { mut l: Lower, ts: []Id } -> []Id {
        let mut out = list::new(Id){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < ts.len {
            let n = norm{ &l, t = ts[i] }
            try! list::push{ list = &out, item = n }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn add_field { mut xs: list::List(types::Field, Heap), f: types::Field } {
        try! list::push{ list = &xs, item = f }
    }

    // A function type's fields, sorted by name.
    fn sorted_fields { l: Lower, fields: []types::Field } -> []types::Field {
        let mut out = list::new(types::Field){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < fields.len {
            add_field{ xs = &out, f = fields[i] }
            let ys = list::items{ list = out }
            let mut k = ys.len - 1
            while k > 0 and check::bytes_less{ a = ys[k].name, b = ys[k - 1].name } {
                let tmp = ys[k]
                ys[k] = ys[k - 1]
                ys[k - 1] = tmp
                k = k - 1
            }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // The IR type id of t, which is already in the function's terms: an enum is its base type.
    // A new type gets the next id before its parts do.
    fn tid { mut l: Lower, t: Id } -> u32 {
        let mut x = types::prune{ s = l.c.ty, t }
        if types::get{ s = l.c.ty, id = x } is enumeration{ decl } { x = check::get_decl{ c = l.c.*, d = decl }.ty }
        if x == types::STRLIT { x = u8_slice{ &l } }
        let k = norm{ &l, t = x }
        let known = map::get{ m = l.type_ids, key = k }
        if known != null { return known }
        let i = @as(u32, l.types.len)
        try! map::put{ m = &l.type_ids, key = k, value = i }
        try! list::push{ list = &l.types, item = ir::Type::void }
        let d = type_def{ &l, t = x }
        list::items{ list = l.types }[i] = d
        return i
    }

    fn type_def { mut l: Lower, t: Id } -> ir::Type {
        match types::get{ s = l.c.ty, id = t } {
            prim{ p } => { return ir::Type::prim{ p = ir_prim{ p } } }
            ptr{ elem } => { return ir::Type::ptr{ elem = tid{ &l, t = elem } } }
            array{ n, elem } => { return ir::Type::arr{ n, elem = tid{ &l, t = elem } } }
            cap{ decl } => {
                let name = check::get_decl{ c = l.c.*, d = decl }.qual
                let fields = check::struct_fields{ c = l.c, t }
                let mut fs = list::new(ir::Field){ realloc = arena::alloc, heap = l.heap }
                if fields.len == 0 { return ir::Type::cap{ name, size = 0, align = 1, fields = list::items{ list = fs } } }
                let offs = check::struct_offsets{ c = l.c, t }
                if offs == null { @panic("lower: a capability without a layout") }
                let mut i: usize = 0
                while i < fields.len {
                    let ft = tid{ &l, t = fields[i].ty }
                    add_ir_field{ xs = &fs, f = ir::Field{ name = fields[i].name, ty = ft, offset = offs.offs[i] } }
                    i = i + 1
                }
                return ir::Type::cap{ name, size = offs.layout.size, align = offs.layout.align, fields = list::items{ list = fs } }
            }
            void => { return ir::Type::void }
            func{ fields, ret, bound, external } => {
                let sorted = if external { fields } else { sorted_fields{ l, fields } }
                let mut ps = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
                let mut i: usize = 0
                while i < sorted.len {
                    let f = sorted[i]
                    let ft = tid{ &l, t = f.ty }
                    try! list::push{ list = &ps, item = ir::Param{ name = f.name, mutable = f.mutable, ty = ft } }
                    i = i + 1
                }
                if external { return ir::Type::cfn{ params = list::items{ list = ps }, ret = tid{ &l, t = ret } } }
                return ir::Type::func{ bound, params = list::items{ list = ps }, ret = tid{ &l, t = ret } }
            }
            slice{ elem, mutable } => {
                let name = type_name{ l, t }
                let p = tid{ &l, t = types::ptr{ s = &l.c.ty, elem, mutable } }
                let n = tid{ &l, t = types::USIZE }
                let mut fs = list::new(ir::Field){ realloc = arena::alloc, heap = l.heap }
                add_ir_field{ xs = &fs, f = ir::Field{ name = "ptr", ty = p, offset = 0 } }
                add_ir_field{ xs = &fs, f = ir::Field{ name = "len", ty = n, offset = 8 } }
                return ir::Type::record{ name, size = 16, align = 8, fields = list::items{ list = fs }, untagged = false }
            }
            record => {
                let offs = check::struct_offsets{ c = l.c, t }
                if offs == null { @panic("lower: a struct without a layout") }
                let name = type_name{ l, t }
                let fields = check::struct_fields{ c = l.c, t }
                let mut fs = list::new(ir::Field){ realloc = arena::alloc, heap = l.heap }
                let mut i: usize = 0
                while i < fields.len {
                    let ft = tid{ &l, t = fields[i].ty }
                    add_ir_field{ xs = &fs, f = ir::Field{ name = fields[i].name, ty = ft, offset = offs.offs[i] } }
                    i = i + 1
                }
                return ir::Type::record{ name, size = offs.layout.size, align = offs.layout.align, fields = list::items{ list = fs }, untagged = check::untagged_type{ c = l.c.*, t } }
            }
            opt{ elem } => {
                if check::nullable_ptr{ c = l.c.*, t } { return ir::Type::nptr{ ptr = tid{ &l, t = elem } } }
                return tagged{ &l, t }
            }
            sum | res | eset => { return tagged{ &l, t } }
            errs => { return tagged{ &l, t = check::eset_of{ c = l.c, t } } }
            else => { @panic("lower: a type that isn't concrete") }
        }
        return ir::Type::void
    }

    // A union's or optional's IR type: its tag, payload offset and variants.
    fn tagged { mut l: Lower, t: Id } -> ir::Type {
        match types::get{ s = l.c.ty, id = t } {
            opt | sum | res | eset => {
                let u = check::union_offsets{ c = l.c, t }
                if u == null { @panic("lower: a union without a layout") }
                let name = type_name{ l, t }
                let vs = check::variants_of{ c = l.c, t }
                let mut out = list::new(ir::Variant){ realloc = arena::alloc, heap = l.heap }
                let mut i: usize = 0
                while i < vs.len {
                    let fields = vs[i].fields
                    let mut v = ir::Variant{ name = vs[i].name, fields = null }
                    if fields != null {
                        let mut fs = list::new(ir::Field){ realloc = arena::alloc, heap = l.heap }
                        let mut j: usize = 0
                        while j < fields.len {
                            let ft = tid{ &l, t = fields[j].ty }
                            add_ir_field{ xs = &fs, f = ir::Field{ name = fields[j].name, ty = ft, offset = u.offs[i][j] } }
                            j = j + 1
                        }
                        v.fields = list::items{ list = fs }
                    }
                    try! list::push{ list = &out, item = v }
                    i = i + 1
                }
                return ir::Type::tagged{ name, size = u.layout.size, align = u.layout.align, pay_off = u.pay_off, variants = list::items{ list = out } }
            }
            else => { @panic("lower: a type that isn't concrete") }
        }
        return ir::Type::void
    }

    fn add_ir_field { mut xs: list::List(ir::Field, Heap), f: ir::Field } {
        try! list::push{ list = &xs, item = f }
    }

    fn ir_prim { p: types::Prim } -> ir::Prim {
        match p {
            i8 => { return ir::Prim::i8 }
            i16 => { return ir::Prim::i16 }
            i32 => { return ir::Prim::i32 }
            i64 => { return ir::Prim::i64 }
            u8 => { return ir::Prim::u8 }
            u16 => { return ir::Prim::u16 }
            u32 => { return ir::Prim::u32 }
            u64 => { return ir::Prim::u64 }
            usize => { return ir::Prim::usize }
            f32 => { return ir::Prim::f32 }
            f64 => { return ir::Prim::f64 }
            bool => { return ir::Prim::bool }
        }
    }

    // A type's name in the IR: as messages write it, but without pointer mutability.
    fn type_name { l: Lower, t: Id } -> []u8 {
        let mut b = message{ l }
        try! write_type{ l, t, &b }
        return utf8::view{ b }.bytes
    }

    fn write_type { l: Lower, t: Id, mut b: utf8::Builder(Heap) } -> ! {
        match get{ l, t } {
            ptr{ elem } => {
                try utf8::push{ &b, s = "*" }
                try write_type{ l, t = elem, &b }
            }
            slice{ elem } => {
                try utf8::push{ &b, s = "[]" }
                try write_type{ l, t = elem, &b }
            }
            array{ n, elem } => {
                try @fmt(&b, "[{}]", n)
                try write_type{ l, t = elem, &b }
            }
            opt{ elem } => {
                try utf8::push{ &b, s = "?" }
                try write_type{ l, t = elem, &b }
            }
            record{ decl, args } => { try generic{ l, decl, args, &b } }
            sum{ decl, args } => { try generic{ l, decl, args, &b } }
            func{ fields, ret, bound } => {
                try utf8::push{ &b, s = if bound { "&fn{" } else { "fn{" } }
                let mut i: usize = 0
                while i < fields.len {
                    let f = fields[i]
                    try @fmt(&b, "{}{}{}: ", str{ s = if i == 0 { " " } else { ", " } }, str{ s = if f.mutable { "mut " } else { "" } }, str{ s = f.name })
                    try write_type{ l, t = f.ty, &b }
                    i = i + 1
                }
                if fields.len > 0 { try utf8::push{ &b, s = " " } }
                try utf8::push{ &b, s = "}" }
                if ret != types::VOID {
                    try utf8::push{ &b, s = " -> " }
                    try write_type{ l, t = ret, &b }
                }
            }
            else => { try check::write_type{ c = l.c.*, t, &b } }
        }
    }

    fn generic { l: Lower, decl: u32, args: []Id, mut b: utf8::Builder(Heap) } -> ! {
        try utf8::push{ &b, s = str{ s = check::get_decl{ c = l.c.*, d = decl }.qual } }
        if args.len == 0 { return }
        try utf8::push{ &b, s = "(" }
        let mut i: usize = 0
        while i < args.len {
            if i > 0 { try utf8::push{ &b, s = ", " } }
            try write_type{ l, t = args[i], &b }
            i = i + 1
        }
        try utf8::push{ &b, s = ")" }
    }

    // ---- places and positions

    // The slot of local v, which gets the next one the first time it is met. A `mut` field's or
    // a `&f` binding's slot holds a pointer.
    fn slot { mut l: Lower, v: u32 } -> u32 {
        let known = map::get{ m = l.slots, key = v }
        if known != null { return known }
        let s = @as(u32, l.locals.len)
        try! map::put{ m = &l.slots, key = v, value = s }
        let x = check::get_var{ c = l.c.*, v }
        let t = T{ &l, t = x.ty }
        let st = if x.indirect { types::ptr{ s = &l.c.ty, elem = t, mutable = false } } else { t }
        let id = tid{ &l, t = st }
        try! list::push{ list = &l.locals, item = ir::Local{ name = x.name, ty = id } }
        return s
    }

    // A position: its line and column, and the index of its file among those the IR names, in
    // the order it first names them.
    fn pos { mut l: Lower, at: source::Span } -> ir::Pos {
        let known = map::get{ m = l.file_ids, key = at.file }
        let mut f: u32 = 0
        if known == null {
            f = @as(u32, l.files.len)
            let name = l.c.files[at.file].name
            try! map::put{ m = &l.file_ids, key = at.file, value = f }
            try! list::push{ list = &l.files, item = name }
        } else {
            f = known
        }
        let file = l.c.files[at.file]
        let p = source::position{ text = file.text, lines = file.lines, offset = at.start }
        return ir::Pos{ line = p.line, col = p.col, file = f }
    }

    fn epos { mut l: Lower, e: syntax::Expr } -> ir::Pos {
        return pos{ &l, at = check::expr_at{ e } }
    }

    // ---- statements

    fn block { mut l: Lower, b: syntax::Block } -> ir::Block {
        return ir::Block{ stmts = stmts{ &l, xs = b.stmts }, result = null }
    }

    fn stmts { mut l: Lower, xs: []syntax::Stmt } -> []ir::Stmt {
        let mut out = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < xs.len {
            put_stmt{ &l, xs = &out, s = xs[i] }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // s, as one statement, or two for `return e` of an e without a value (§11, rule 7): e, then
    // the `return`.
    fn put_stmt { mut l: Lower, mut xs: list::List(ir::Stmt, Heap), s: syntax::Stmt } {
        if s.k is ret{ value = v } {
            if let e = v {
                if T{ &l, t = check::type_of_expr{ c = l.c.*, e } } == types::VOID {
                    try! list::push{ list = &xs, item = eval_stmt{ &l, e } }
                    let r = if check::void_result{ c = l.c.*, t = l.ret } { ir::Stmt::ret{ value = ok_unit{ &l } } } else { ir::Stmt::ret{ value = null } }
                    try! list::push{ list = &xs, item = r }
                    return
                }
            }
        }
        if s.k is each {
            put_each{ &l, &xs, s }
            return
        }
        try! list::push{ list = &xs, item = stmt{ &l, s } }
        if s.k is local { handle_scope{ &l, &xs, s } }
    }

    // `for` (§11, For), as a `while` over a hidden counter that steps before the body runs, so
    // that a `continue` needs nothing more:
    //
    //   for i in lo..hi { B }      n = lo; end = hi; while n < end { i = n; n = n +% 1; B }
    //   for x at i in e { B }      s = e; n = 0; while n < s.len { x = s[n]; i = n; n = n +% 1; B }
    //
    // `for &x` sets x to the element's address. The step can't wrap: n is below its bound.
    fn put_each { mut l: Lower, mut xs: list::List(ir::Stmt, Heap), s: syntax::Stmt } {
        let each{ item, by_ref, index, iter, hi, body } = s.k else { return }
        let none = ir::Pos{ line = 0, col = 0, file = 0 }
        let bool_ty = tid{ &l, t = types::BOOL }
        let iv = local_of{ l, k = check::name_key{ n = item } }
        let it = T{ &l, t = check::get_var{ c = l.c.*, v = iv }.ty }
        let mut inner = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        let mut c = mk{ ty = bool_ty, k = ir::ExprKind::boolean{ value = false } }
        if let end = hi {
            let ty = tid{ &l, t = it }
            let n = temp{ &l, ty }
            let stop = temp{ &l, ty }
            try! list::push{ list = &xs, item = ir::Stmt::define{ slot = n, init = conv{ &l, e = iter, to = it } } }
            try! list::push{ list = &xs, item = ir::Stmt::define{ slot = stop, init = conv{ &l, e = end, to = it } } }
            let nv = mk{ ty, k = ir::ExprKind::local{ slot = n } }
            let one = mk{ ty, k = ir::ExprKind::int{ negative = false, value = 1 } }
            try! list::push{ list = &inner, item = ir::Stmt::define{ slot = slot{ &l, v = iv }, init = nv } }
            try! list::push{ list = &inner, item = ir::Stmt::assign{ place = nv, value = mk{ ty, k = ir::ExprKind::wrap{ op = ir::ArithOp::add, a = box{ l, e = nv }, b = box{ l, e = one } } } } }
            c = mk{ ty = bool_ty, k = ir::ExprKind::cmp{ op = ir::CmpOp::lt, a = box{ l, e = nv }, b = box{ l, e = mk{ ty, k = ir::ExprKind::local{ slot = stop } } } } }
        } else {
            let ut = tid{ &l, t = types::USIZE }
            let st = tid{ &l, t = types::slice{ s = &l.c.ty, elem = it, mutable = false } }
            let held = temp{ &l, ty = st }
            let n = temp{ &l, ty = ut }
            try! list::push{ list = &xs, item = ir::Stmt::define{ slot = held, init = ex{ &l, e = iter } } }
            try! list::push{ list = &xs, item = ir::Stmt::define{ slot = n, init = int_lit{ &l, t = types::USIZE, n = 0 } } }
            let sv = mk{ ty = st, k = ir::ExprKind::local{ slot = held } }
            let nv = mk{ ty = ut, k = ir::ExprKind::local{ slot = n } }
            let elem = mk{ ty = tid{ &l, t = it }, k = ir::ExprKind::sindex{ base = box{ l, e = sv }, i = box{ l, e = nv }, pos = pos{ &l, at = s.span } } }
            if by_ref {
                let pt = tid{ &l, t = types::ptr{ s = &l.c.ty, elem = it, mutable = false } }
                try! list::push{ list = &inner, item = ir::Stmt::define{ slot = slot{ &l, v = iv }, init = mk{ ty = pt, k = ir::ExprKind::addr{ place = box{ l, e = elem } } } } }
            } else {
                try! list::push{ list = &inner, item = ir::Stmt::define{ slot = slot{ &l, v = iv }, init = elem } }
            }
            if let name = index {
                let xv = local_of{ l, k = check::name_key{ n = name } }
                try! list::push{ list = &inner, item = ir::Stmt::define{ slot = slot{ &l, v = xv }, init = nv } }
            }
            let one = int_lit{ &l, t = types::USIZE, n = 1 }
            try! list::push{ list = &inner, item = ir::Stmt::assign{ place = nv, value = mk{ ty = ut, k = ir::ExprKind::wrap{ op = ir::ArithOp::add, a = box{ l, e = nv }, b = box{ l, e = one } } } } }
            let len = mk{ ty = ut, k = ir::ExprKind::field{ base = box{ l, e = sv }, index = 1 } }
            c = mk{ ty = bool_ty, k = ir::ExprKind::cmp{ op = ir::CmpOp::lt, a = box{ l, e = nv }, b = box{ l, e = len } } }
        }
        let rest = stmts{ &l, xs = body.stmts }
        let mut i: usize = 0
        while i < rest.len {
            try! list::push{ list = &inner, item = rest[i] }
            i = i + 1
        }
        let label = map::get{ m = l.c.loop_ids, key = check::stmt_key{ s } }
        try! list::push{ list = &xs, item = ir::Stmt::loop{ c, body = ir::Block{ stmts = list::items{ list = inner }, result = null }, label } }
    }

    // After a local that is or holds a loan holder (spec §15, Tasks): its scope's end, as a
    // defer, ends what it still holds through the holder's `#scope_end` fn (std's task::end, or
    // task::cancel_all for a group), with its capabilities made from nothing.
    fn handle_scope { mut l: Lower, mut xs: list::List(ir::Stmt, Heap), s: syntax::Stmt } {
        let v = local_of{ l, k = check::stmt_key{ s } }
        let t = T{ &l, t = check::get_var{ c = l.c.*, v }.ty }
        if not check::holds_handle{ c = l.c.*, t } { return }
        let ty = tid{ &l, t }
        let place = mk{ ty, k = ir::ExprKind::local{ slot = slot{ &l, v } } }
        let mut body = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        end_handles{ &l, out = &body, place, t }
        try! list::push{ list = &xs, item = ir::Stmt::deferred{ body = ir::Block{ stmts = list::items{ list = body }, result = null } } }
    }

    fn end_handles { mut l: Lower, mut out: list::List(ir::Stmt, Heap), place: ir::Expr, t: Id } {
        match get{ l, t } {
            array{ n, elem } => {
                let ut = tid{ &l, t = types::USIZE }
                let i = temp{ &l, ty = ut }
                let iv = mk{ ty = ut, k = ir::ExprKind::local{ slot = i } }
                try! list::push{ list = &out, item = ir::Stmt::define{ slot = i, init = int_lit{ &l, t = types::USIZE, n = 0 } } }
                let mut body = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
                let none = ir::Pos{ line = 0, col = 0, file = 0 }
                let at = mk{ ty = tid{ &l, t = elem }, k = ir::ExprKind::index{ base = box{ l, e = place }, i = box{ l, e = iv }, pos = none } }
                end_handles{ &l, out = &body, place = at, t = elem }
                let next = mk{ ty = ut, k = ir::ExprKind::arith{ op = ir::ArithOp::add, a = box{ l, e = iv }, b = box{ l, e = int_lit{ &l, t = types::USIZE, n = 1 } }, pos = none, trap = ir::NO_TRAP } }
                try! list::push{ list = &body, item = ir::Stmt::assign{ place = iv, value = next } }
                let bool_ty = tid{ &l, t = types::BOOL }
                let c = mk{ ty = bool_ty, k = ir::ExprKind::cmp{ op = ir::CmpOp::lt, a = box{ l, e = iv }, b = box{ l, e = int_lit{ &l, t = types::USIZE, n } } } }
                try! list::push{ list = &out, item = ir::Stmt::loop{ c, body = ir::Block{ stmts = list::items{ list = body }, result = null }, label = null } }
            }
            record{ decl, args } => {
                // The holder's `#scope_end` fn, whose generic parameters are the holder's.
                let end = map::get{ m = l.c.scope_ends, key = decl } ifnull { @panic("lower: a loan holder without a scope_end fn") }
                let ts = args
                let x = check::get_decl{ c = l.c.*, d = end }
                let fields = check::subst_fields{ c = l.c, fields = x.fields, decl = end, args = ts }
                let mut call = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
                let mut k: usize = 0
                while k < fields.len {
                    let f = fields[k]
                    let at = tid{ &l, t = arg_type{ &l, f, ptrs = true } }
                    let value = if get{ l, t = f.ty } is cap { mk{ ty = at, k = ir::ExprKind::capref } } else { mk{ ty = at, k = ir::ExprKind::addr{ place = box{ l, e = place } } } }
                    add_arg{ xs = &call, a = ir::Arg{ index = @as(u32, k), value } }
                    k = k + 1
                }
                let e = mk{ ty = tid{ &l, t = types::VOID }, k = ir::ExprKind::call{ callee = fn_id{ &l, decl = end, targs = ts }, args = list::items{ list = call }, pos = nowhere{} } }
                try! list::push{ list = &out, item = ir::Stmt::eval{ e } }
            }
            else => { @panic("lower: a task handle that is neither a handle nor an array of them") }
        }
    }

    // e as a statement: a call, `try` of one or an `iferr`, without a value or with one dropped.
    fn eval_stmt { mut l: Lower, e: syntax::Expr } -> ir::Stmt {
        match e.k {
            builtin{ name, args } => {
                if slice::eq_bytes{ a = name.text, b = "panic" } { return panic_stmt{ &l, e, args } }
            }
            trye{ e = x, panics } => {
                // `try f{ ... }` of a bare `!`: a match with no value.
                if T{ &l, t = check::type_of_expr{ c = l.c.*, e } } == types::VOID {
                    let scrut = ex{ &l, e = x.* }
                    return ir::Stmt::choose{ scrut, through = false, arms = try_arms{ &l, x = x.*, value = false, panics, pos = epos{ &l, e } } }
                }
            }
            matchx{ x } => {
                if T{ &l, t = check::type_of_expr{ c = l.c.*, e } } == types::VOID {
                    return match_stmt{ &l, x, t = types::NO_TYPE, leaving = false }
                }
            }
            else => {}
        }
        return ir::Stmt::eval{ e = ex{ &l, e } }
    }

    fn stmt { mut l: Lower, s: syntax::Stmt } -> ir::Stmt {
        let k = check::stmt_key{ s }
        match s.k {
            local{ init } => {
                let v = local_of{ l, k }
                let sl = slot{ &l, v }
                if init == null { return ir::Stmt::zero{ slot = sl } }
                let t = check::get_var{ c = l.c.*, v }.ty
                return ir::Stmt::define{ slot = sl, init = conv{ &l, e = init, to = t } }
            }
            let_else{ variant, binders, init, els_variant, els_binders, els } => {
                if through_opt{ &l, init, variant = variant.text } {
                    // On a `?U`, for a variant of U: `if not (init is variant{ ... }) { els }`.
                    let mut pats = list::new(syntax::Pattern){ realloc = arena::alloc, heap = l.heap }
                    try! list::push{ list = &pats, item = syntax::Pattern{ span = s.span, quals = slice::empty(syntax::Name){}, variant, binders, value = null, upto = null } }
                    let test = is_ex{ &l, x = init, pats = list::items{ list = pats } }
                    let c = mk{ ty = test.ty, k = ir::ExprKind::lnot{ e = box{ l, e = test } } }
                    return ir::Stmt::cond{ c, then = block{ &l, b = els }, els = null }
                }
                let x = ex{ &l, e = init }
                let ut = T{ &l, t = check::type_of_expr{ c = l.c.*, e = init } }
                let vs = check::variants_of{ c = l.c, t = types::prune{ s = l.c.ty, t = ut } }
                let mut ev: ?u32 = null
                let mut ebinds: []ir::Bind = slice::empty(ir::Bind){}
                if els_variant != null {
                    let evi = variant_at{ vs, name = els_variant.text }
                    ev = evi
                    ebinds = binds{ &l, binders = els_binders, fields = vs[evi].fields }
                }
                let e = block{ &l, b = els }
                let vi = variant_at{ vs, name = variant.text }
                let bs = binds{ &l, binders, fields = vs[vi].fields }
                return ir::Stmt::let_else{ init = x, variant = vi, binds = bs, els_variant = ev, els_binds = ebinds, els = e }
            }
            assign{ place, value } => {
                let p = ex{ &l, e = place }
                return ir::Stmt::assign{ place = p, value = conv{ &l, e = value, to = check::type_of_expr{ c = l.c.*, e = place } } }
            }
            eval{ e } => { return eval_stmt{ &l, e } }
            // A discard's `ifnull` or `iferr` without a value is a statement, as `iferr` on a bare `!` is.
            discard{ e } => { return eval_stmt{ &l, e } }
            cond{ x } => {
                // ctxi lowers the else block first.
                let x_els = x.els
                let mut els: ?ir::Block = null
                if x_els != null { els = block{ &l, b = x_els } }
                let c = ex{ &l, e = x.c.* }
                return ir::Stmt::cond{ c, then = block{ &l, b = x.then }, els }
            }
            loop{ c = cond, body } => {
                let c = ex{ &l, e = cond }
                let b = block{ &l, b = body }
                return ir::Stmt::loop{ c, body = b, label = map::get{ m = l.c.loop_ids, key = k } }
            }
            each => { @panic("lower: a `for` is lowered by put_each") }
            brk => { return ir::Stmt::brk{ label = map::get{ m = l.c.jump_ids, key = k } } }
            cont => { return ir::Stmt::cont{ label = map::get{ m = l.c.jump_ids, key = k } } }
            ret{ value } => {
                if value == null {
                    if check::void_result{ c = l.c.*, t = l.ret } { return ir::Stmt::ret{ value = ok_unit{ &l } } }
                    return ir::Stmt::ret{ value = null }
                }
                return ir::Stmt::ret{ value = conv{ &l, e = value, to = l.ret } }
            }
            deferred{ body } => { return ir::Stmt::deferred{ body = block{ &l, b = body } } }
            // A block of its own is an `if true` of it: the IR has blocks only as parts of
            // statements, and a block's defers run where the `if`'s do.
            scope{ body } => {
                let c = mk{ ty = tid{ &l, t = types::BOOL }, k = ir::ExprKind::boolean{ value = true } }
                return ir::Stmt::cond{ c, then = block{ &l, b = body }, els = null }
            }
            choose{ x } => { return match_stmt{ &l, x, t = types::NO_TYPE, leaving = false } }
            error => { @panic("lower: a statement that didn't parse") }
        }
    }

    // Whether a let-else's variant is one of the U of init's `?U`.
    fn through_opt { mut l: Lower, init: syntax::Expr, variant: []u8 } -> bool {
        match get{ l, t = T{ &l, t = check::type_of_expr{ c = l.c.*, e = init } } } {
            opt => { return not slice::eq_bytes{ a = variant, b = "null" } and not slice::eq_bytes{ a = variant, b = "some" } }
            else => { return false }
        }
    }

    fn local_of { l: Lower, k: u64 } -> u32 {
        let v = nodes::get{ m = l.c.local_of, key = k }
        if v == null { @panic("lower: a binding without a local") }
        return v
    }

    // `@panic()` or `@panic("reason")` as a statement: the reason's bytes, with anything that
    // isn't ASCII as a \xNN escape, as ctxi's backslashreplace writes it.
    fn panic_stmt { mut l: Lower, e: syntax::Expr, args: []syntax::Expr } -> ir::Stmt {
        let p = epos{ &l, e }
        let mut msg = "@panic()"
        if args.len > 0 and args[0].k is str{ bytes } { msg = escaped{ l, bytes } }
        return ir::Stmt::panic{ pos = p, msg }
    }

    fn escaped { l: Lower, bytes: []u8 } -> []u8 {
        let mut b = list::new(u8){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < bytes.len {
            let ch = bytes[i]
            if ch < 128 {
                push_byte{ xs = &b, n = ch }
            } else {
                push_byte{ xs = &b, n = '\\' }
                push_byte{ xs = &b, n = 'x' }
                push_byte{ xs = &b, n = hex{ d = ch / 16 } }
                push_byte{ xs = &b, n = hex{ d = ch % 16 } }
            }
            i = i + 1
        }
        return list::items{ list = b }
    }

    fn hex { d: u8 } -> u8 {
        if d < 10 { return '0' + d }
        return 'a' + d - 10
    }

    fn push_byte { mut xs: list::List(u8, Heap), n: u8 } {
        try! list::push{ list = &xs, item = n }
    }

    fn variant_at { vs: []check::Variant, name: []u8 } -> u32 {
        let i = check::variant_index{ vs, name }
        if i == NONE { @panic("lower: a pattern of no variant") }
        return i
    }

    // A pattern's bindings, each binder's field as its slot.
    fn binds { mut l: Lower, binders: []syntax::Binder, fields: ?[]types::Field } -> []ir::Bind {
        let mut out = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < binders.len {
            let bd = binders[i]
            let v = local_of{ l, k = check::name_key{ n = bd.field } }
            let s = slot{ &l, v }
            add_bind{ xs = &out, b = ir::Bind{ slot = s, field = field_at{ fields, name = bd.field.text }, by_ref = bd.by_ref } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn add_bind { mut xs: list::List(ir::Bind, Heap), b: ir::Bind } {
        try! list::push{ list = &xs, item = b }
    }

    fn field_at { fields: ?[]types::Field, name: []u8 } -> u32 {
        if fields == null { @panic("lower: a binding in a variant without a payload") }
        let mut i: usize = 0
        while i < fields.len {
            if slice::eq_bytes{ a = fields[i].name, b = name } { return @as(u32, i) }
            i = i + 1
        }
        @panic("lower: a binding of no field")
    }

    // A later pattern of an arm binds its first pattern's locals, in their order, each from the
    // field this pattern binds under the same name (ctxi's same_binds).
    fn alt_binds { mut l: Lower, first: []syntax::Binder, binders: []syntax::Binder, fields: ?[]types::Field } -> []ir::Bind {
        let mut out = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < first.len {
            let fv = local_of{ l, k = check::name_key{ n = first[i].field } }
            let name = check::get_var{ c = l.c.*, v = fv }.name
            let mut j = binders.len
            let mut found = NONE
            while j > 0 {
                j = j - 1
                if slice::eq_bytes{ a = binder_local{ b = binders[j] }, b = name } {
                    found = @as(u32, j)
                    break
                }
            }
            if found == NONE { @panic("lower: an arm's patterns bind different names") }
            let bd = binders[found]
            let s = slot{ &l, v = fv }
            add_bind{ xs = &out, b = ir::Bind{ slot = s, field = field_at{ fields, name = bd.field.text }, by_ref = bd.by_ref } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn binder_local { b: syntax::Binder } -> []u8 {
        let local = b.local
        return if local == null { b.field.text } else { local.text }
    }

    // A `match`: on a union or optional, through a pointer to one, or on an enum (a switch). As
    // an expression, of type t; `leaving` for one whose every branch leaves, whose blocks have
    // no value.
    fn match_stmt { mut l: Lower, x: syntax::Match, t: Id, leaving: bool } -> ir::Stmt {
        let scrut = ex{ &l, e = x.scrut.* }
        let ft = fail_scrut{ &l, x }
        if ft != types::NO_TYPE {
            return ir::Stmt::choose{ scrut, through = false, arms = fail_arms{ &l, x, st = ft, t, value = leaving } }
        }
        let rs = map::get{ m = l.c.int_cases, key = check::expr_key{ e = x.scrut.* } }
        if rs != null { return ir::Stmt::switch{ scrut, cases = int_cases{ &l, x, rs, t, value = leaving } } }
        let u = scrut_type{ &l, x }
        if u.enum_decl != NONE {
            return ir::Stmt::switch{ scrut, cases = cases{ &l, x, decl = u.enum_decl, t, value = leaving } }
        }
        return ir::Stmt::choose{ scrut, through = u.through, arms = arms{ &l, x, vs = u.vs, t, value = leaving } }
    }

    // The scrutinee's type if the match is on a `!T` or an error, else NO_TYPE.
    fn fail_scrut { mut l: Lower, x: syntax::Match } -> Id {
        let t = types::prune{ s = l.c.ty, t = T{ &l, t = check::type_of_expr{ c = l.c.*, e = x.scrut.* } } }
        match types::get{ s = l.c.ty, id = t } {
            res | errs | eset => { return t }
            else => { return types::NO_TYPE }
        }
    }

    // The arms of a match on a `!T` or an error, of type st (§8, Errors). On a `!T` they are `ok`
    // and `err`; errors listed beside `ok` become an inner match on the error, which `err` binds,
    // whose last arm is the `err` or `else` arm. As `iferr` on a bare `!`, the `ok` arm is empty.
    fn fail_arms { mut l: Lower, x: syntax::Match, st: Id, t: Id, value: bool } -> []ir::Arm {
        let res{ ok, errs } = types::get{ s = l.c.ty, id = st } else {
            return error_arms{ &l, arms = x.arms, set = check::set_of{ c = l.c.*, t = st }, t, value }
        }
        let vs = check::variants_of{ c = l.c, t = st }
        let bare = x.is_iferr and types::prune{ s = l.c.ty, t = ok } == types::VOID
        let mut listed = false
        let mut i: usize = 0
        while i < x.arms.len {
            let pats = x.arms[i].pats
            if pats.len > 0 and is_error_pat{ l, p = pats[0] } { listed = true }
            i = i + 1
        }
        if not listed and not bare { return arms{ &l, x, vs, t, value } }
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        if bare {
            let none = slice::empty(ir::Bind){}
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 0, binds = none } }, body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = null } }
            let arm = x.arms[1]
            let p = arm.pats[0]
            let pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = binds{ &l, binders = p.binders, fields = vs[1].fields } } }
            add_arm{ l, xs = &out, pats, body = block{ &l, b = arm.body } }
            return list::items{ list = out }
        }
        // The slot `err` binds the error to: its own binding's, or a new one.
        let et = tid{ &l, t = errs }
        let mut slot = NONE
        i = 0
        while i < x.arms.len {
            let arm = x.arms[i]
            if arm.pats.len > 0 and arm.pats[0].quals.len == 0 and slice::eq_bytes{ a = arm.pats[0].variant.text, b = "err" } {
                let bs = arm.pats[0].binders
                if bs.len > 0 { slot = slot{ &l, v = local_of{ l, k = check::name_key{ n = bs[0].field } } } }
            }
            i = i + 1
        }
        if slot == NONE { slot = temp{ &l, ty = et } }
        let set = check::set_of{ c = l.c.*, t = errs }
        let mut inner = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        i = 0
        while i < x.arms.len {
            let arm = x.arms[i]
            let body = if value { value_block{ &l, b = arm.body, t } } else { block{ &l, b = arm.body } }
            if arm.pats.len == 0 or slice::eq_bytes{ a = arm.pats[0].variant.text, b = "err" } and arm.pats[0].quals.len == 0 {
                add_arm{ l, xs = &inner, pats = slice::empty(ir::Pat){}, body }
            } else if is_error_pat{ l, p = arm.pats[0] } {
                add_arm{ l, xs = &inner, pats = error_pats{ &l, pats = arm.pats, set }, body }
            } else {
                let mut pats = list::new(ir::Pat){ realloc = arena::alloc, heap = l.heap }
                let mut k: usize = 0
                while k < arm.pats.len {
                    let p = arm.pats[k]
                    let bs = if k == 0 { binds{ &l, binders = p.binders, fields = vs[0].fields } } else { alt_binds{ &l, first = arm.pats[0].binders, binders = p.binders, fields = vs[0].fields } }
                    try! list::push{ list = &pats, item = ir::Pat{ variant = 0, binds = bs } }
                    k = k + 1
                }
                add_arm{ l, xs = &out, pats = list::items{ list = pats }, body }
            }
            i = i + 1
        }
        let scrut = mk{ ty = et, k = ir::ExprKind::local{ slot } }
        let mut binds = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        add_bind{ xs = &binds, b = ir::Bind{ slot, field = 0, by_ref = false } }
        let mut body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = null }
        if value and t != types::NO_TYPE {
            let m = mk{ ty = tid{ &l, t }, k = ir::ExprKind::matchx{ scrut = box{ l, e = scrut }, through = false, arms = list::items{ list = inner } } }
            body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = box{ l, e = m } }
        } else {
            let mut xs = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
            try! list::push{ list = &xs, item = ir::Stmt::choose{ scrut, through = false, arms = list::items{ list = inner } } }
            body = ir::Block{ stmts = list::items{ list = xs }, result = null }
        }
        add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = list::items{ list = binds } } }, body }
        return list::items{ list = out }
    }

    // The arms of a match on an error of set `set`: each error listed is its place in the set.
    fn error_arms { mut l: Lower, arms: []syntax::Arm, set: []u32, t: Id, value: bool } -> []ir::Arm {
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < arms.len {
            let arm = arms[i]
            let pats = if arm.pats.len == 0 { slice::empty(ir::Pat){} } else { error_pats{ &l, pats = arm.pats, set } }
            let body = if value { value_block{ &l, b = arm.body, t } } else { block{ &l, b = arm.body } }
            add_arm{ l, xs = &out, pats, body }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // An arm's or an `is`'s patterns, each an error of `set`, each binding what the first does.
    fn error_pats { mut l: Lower, pats: []syntax::Pattern, set: []u32 } -> []ir::Pat {
        let mut out = list::new(ir::Pat){ realloc = arena::alloc, heap = l.heap }
        let mut k: usize = 0
        while k < pats.len {
            let p = pats[k]
            let d = map::get{ m = l.c.pat_errs, key = check::name_key{ n = p.variant } } ifnull { @panic("lower: an error pattern that wasn't resolved") }
            let fields = check::fault_fields{ c = l.c.*, d }
            let bs = if k == 0 { binds{ &l, binders = p.binders, fields } } else { alt_binds{ &l, first = pats[0].binders, binders = p.binders, fields } }
            try! list::push{ list = &out, item = ir::Pat{ variant = set_index{ set, d }, binds = bs } }
            k = k + 1
        }
        return list::items{ list = out }
    }

    fn is_error_pat { l: Lower, p: syntax::Pattern } -> bool {
        return map::has{ m = l.c.pat_errs, key = check::name_key{ n = p.variant } }
    }

    // Error d's variant in an error type of `set`.
    fn set_index { set: []u32, d: u32 } -> u32 {
        let mut i: usize = 0
        while i < set.len {
            if set[i] == d { return @as(u32, i) }
            i = i + 1
        }
        @panic("lower: an error outside its set")
    }

    fn one_pat { l: Lower, p: ir::Pat } -> []ir::Pat {
        let mut out = list::new(ir::Pat){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &out, item = p }
        return list::items{ list = out }
    }

    fn add_arm { l: Lower, mut xs: list::List(ir::Arm, Heap), pats: []ir::Pat, body: ir::Block } {
        try! list::push{ list = &xs, item = ir::Arm{ pats, body } }
    }

    // `ok` of a bare `!`, of the function's result type.
    fn ok_unit { mut l: Lower } -> ir::Expr {
        return mk{ ty = tid{ &l, t = l.ret }, k = ir::ExprKind::variant{ index = 0, items = slice::empty(ir::Arg){} } }
    }

    // `try x`'s arms (§8, Errors): `ok` gives the value, unless value is false (a bare `!`), and
    // `err` returns the error in the function's result, or with `try!` panics at pos.
    fn try_arms { mut l: Lower, x: syntax::Expr, value: bool, panics: bool, pos: ir::Pos } -> []ir::Arm {
        let rt = types::prune{ s = l.c.ty, t = T{ &l, t = check::type_of_expr{ c = l.c.*, e = x } } }
        let res{ ok, errs = from } = types::get{ s = l.c.ty, id = rt } else { @panic("lower: try of a value that isn't a result") }
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        let none = slice::empty(ir::Stmt){}
        if value {
            let s = temp{ &l, ty = tid{ &l, t = ok } }
            let mut bs = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
            add_bind{ xs = &bs, b = ir::Bind{ slot = s, field = 0, by_ref = false } }
            let v = mk{ ty = tid{ &l, t = ok }, k = ir::ExprKind::local{ slot = s } }
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 0, binds = list::items{ list = bs } } }, body = ir::Block{ stmts = none, result = box{ l, e = v } } }
        } else {
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 0, binds = slice::empty(ir::Bind){} } }, body = ir::Block{ stmts = none, result = null } }
        }
        if panics {
            let e = temp{ &l, ty = tid{ &l, t = from } }
            let mut bs = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
            add_bind{ xs = &bs, b = ir::Bind{ slot = e, field = 0, by_ref = false } }
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = list::items{ list = bs } } }, body = try_panics{ &l, errs = from, slot = e, pos } }
            return list::items{ list = out }
        }
        let res{ errs = into } = types::get{ s = l.c.ty, id = types::prune{ s = l.c.ty, t = l.ret } } else { @panic("lower: try in a function that doesn't return a result") }
        let et = tid{ &l, t = from }
        let e = temp{ &l, ty = et }
        let mut bs = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        add_bind{ xs = &bs, b = ir::Bind{ slot = e, field = 0, by_ref = false } }
        let err = remap{ &l, x = mk{ ty = et, k = ir::ExprKind::local{ slot = e } }, frm = from, to = into }
        let r = mk{ ty = tid{ &l, t = l.ret }, k = ir::ExprKind::variant{ index = 1, items = one_arg{ l, v = err } } }
        let mut st = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &st, item = ir::Stmt::ret{ value = r } }
        add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = list::items{ list = bs } } }, body = ir::Block{ stmts = list::items{ list = st }, result = null } }
        return list::items{ list = out }
    }

    // `try! x` failed with the error in slot, of type errs: a panic that names it, one message per
    // error of the set, so that naming it needs no memory.
    fn try_panics { mut l: Lower, errs: Id, slot: u32, pos: ir::Pos } -> ir::Block {
        let set = check::set_of{ c = l.c.*, t = errs }
        let et = tid{ &l, t = errs }
        let mut arms = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < set.len {
            let mut b = message{ l }
            try! @fmt(&b, "try! failed: {}", str{ s = check::get_decl{ c = l.c.*, d = set[i] }.qual })
            let mut st = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
            try! list::push{ list = &st, item = ir::Stmt::panic{ pos, msg = utf8::view{ b }.bytes } }
            add_arm{ l, xs = &arms, pats = one_pat{ l, p = ir::Pat{ variant = @as(u32, i), binds = slice::empty(ir::Bind){} } }, body = ir::Block{ stmts = list::items{ list = st }, result = null } }
            i = i + 1
        }
        let mut st = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        let scrut = mk{ ty = et, k = ir::ExprKind::local{ slot } }
        try! list::push{ list = &st, item = ir::Stmt::choose{ scrut, through = false, arms = list::items{ list = arms } } }
        return ir::Block{ stmts = list::items{ list = st }, result = null }
    }

    fn one_arg { l: Lower, v: ir::Expr } -> []ir::Arg {
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        add_arg{ xs = &out, a = ir::Arg{ index = 0, value = v } }
        return list::items{ list = out }
    }

    // Error x, of error type frm, as one of error type `to`, whose set holds frm's: each error
    // becomes the same error in to's numbering, with its payload.
    fn remap { mut l: Lower, x: ir::Expr, frm: Id, to: Id } -> ir::Expr {
        if norm{ &l, t = frm } == norm{ &l, t = to } { return x }
        let fs = check::set_of{ c = l.c.*, t = frm }
        let ts = check::set_of{ c = l.c.*, t = to }
        let ty = tid{ &l, t = to }
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < fs.len {
            let fields = check::fault_fields{ c = l.c.*, d = fs[i] } ifnull { slice::empty(types::Field){} }
            let mut bs = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
            let mut items = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
            let mut k: usize = 0
            while k < fields.len {
                let ft = tid{ &l, t = fields[k].ty }
                let s = temp{ &l, ty = ft }
                add_bind{ xs = &bs, b = ir::Bind{ slot = s, field = @as(u32, k), by_ref = false } }
                add_arg{ xs = &items, a = ir::Arg{ index = @as(u32, k), value = mk{ ty = ft, k = ir::ExprKind::local{ slot = s } } } }
                k = k + 1
            }
            let v = mk{ ty, k = ir::ExprKind::variant{ index = set_index{ set = ts, d = fs[i] }, items = list::items{ list = items } } }
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = @as(u32, i), binds = list::items{ list = bs } } }, body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = box{ l, e = v } } }
            i = i + 1
        }
        return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = x }, through = false, arms = list::items{ list = out } } }
    }

    // A result x, of type frm, as a result of type `to` with the same value type and errors that
    // hold frm's.
    fn res_remap { mut l: Lower, x: ir::Expr, frm: Id, to: Id } -> ir::Expr {
        let res{ ok, errs = fe } = types::get{ s = l.c.ty, id = frm } else { @panic("lower: not a result") }
        let res{ errs = te } = types::get{ s = l.c.ty, id = to } else { @panic("lower: not a result") }
        let ty = tid{ &l, t = to }
        let none = slice::empty(ir::Stmt){}
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        if types::prune{ s = l.c.ty, t = ok } == types::VOID {
            let v = mk{ ty, k = ir::ExprKind::variant{ index = 0, items = slice::empty(ir::Arg){} } }
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 0, binds = slice::empty(ir::Bind){} } }, body = ir::Block{ stmts = none, result = box{ l, e = v } } }
        } else {
            let ot = tid{ &l, t = ok }
            let s = temp{ &l, ty = ot }
            let mut bs = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
            add_bind{ xs = &bs, b = ir::Bind{ slot = s, field = 0, by_ref = false } }
            let v = mk{ ty, k = ir::ExprKind::variant{ index = 0, items = one_arg{ l, v = mk{ ty = ot, k = ir::ExprKind::local{ slot = s } } } } }
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 0, binds = list::items{ list = bs } } }, body = ir::Block{ stmts = none, result = box{ l, e = v } } }
        }
        let et = tid{ &l, t = fe }
        let e = temp{ &l, ty = et }
        let mut bs = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        add_bind{ xs = &bs, b = ir::Bind{ slot = e, field = 0, by_ref = false } }
        let err = remap{ &l, x = mk{ ty = et, k = ir::ExprKind::local{ slot = e } }, frm = fe, to = te }
        let v = mk{ ty, k = ir::ExprKind::variant{ index = 1, items = one_arg{ l, v = err } } }
        add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = list::items{ list = bs } } }, body = ir::Block{ stmts = none, result = box{ l, e = v } } }
        return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = x }, through = false, arms = list::items{ list = out } } }
    }

    // Whether function type a becomes b by widening its result's error (spec §5): the checker
    // allows that or the same result, which have one IR type.
    fn widens { mut l: Lower, a: Id, b: Id } -> bool {
        let func{ ret = ra } = get{ l, t = a } else { return false }
        let func{ ret = rb } = get{ l, t = b } else { return false }
        return norm{ &l, t = ra } != norm{ &l, t = rb }
    }

    // Whether function type a takes a field read-only that b has `mut` (spec §5): a call
    // through b passes its pointer, which a thunk reads.
    fn reads { l: Lower, a: Id, b: Id } -> bool {
        let func{ fields = fa } = get{ l, t = a } else { return false }
        let func{ fields = fb } = get{ l, t = b } else { return false }
        let mut i: usize = 0
        while i < fa.len {
            let h = types::find_field{ fields = fb, name = fa[i].name }
            if h != null and h.mutable and not fa[i].mutable { return true }
            i = i + 1
        }
        return false
    }

    // Function value x, of type frm, as a `to` whose `!T` may fail with any error, or that has
    // `mut` a field x takes read-only (spec §5): a thunk calls it, reading such a field through
    // its pointer, and renumbers its error (widening). A named function, or a bind of one,
    // gets a thunk that calls it directly and takes to's other fields too: it is a value with no
    // record of its own, as the function was, or the bind of it. Any other value is held by a
    // bind of a thunk that calls it through its code.
    fn widen_fn { mut l: Lower, x: ir::Expr, frm: Id, to: Id } -> ir::Expr {
        let ty = tid{ &l, t = to }
        match x.k {
            fnref{ callee } => {
                if direct{ l, callee } { return mk{ ty, k = ir::ExprKind::fnref{ callee = widen_id{ &l, callee, frm, to } } } }
            }
            bind{ callee, args } => {
                if direct{ l, callee } and not supplies{ l, callee, args, to } {
                    return mk{ ty, k = ir::ExprKind::bind{ callee = widen_id{ &l, callee, frm, to }, args } }
                }
            }
            else => {}
        }
        let w = widen_id{ &l, callee = NONE, frm, to }
        return mk{ ty, k = ir::ExprKind::bind{ callee = w, args = one_arg{ l, v = x } } }
    }

    // Whether instance callee is a declared function's, which a widening thunk can call by name.
    fn direct { l: Lower, callee: u32 } -> bool {
        let q = list::items{ list = l.queue }[callee]
        return q.site == NONE and q.widen == null and check::get_decl{ c = l.c.*, d = q.decl }.kind == check::Kind::func
    }

    // Whether a bind of callee supplies a field that function type `to` has too: the thunk that
    // calls callee then can't take both.
    fn supplies { l: Lower, callee: u32, args: []ir::Arg, to: Id } -> bool {
        let func{ fields } = get{ l, t = to } else { return false }
        let own = check::get_decl{ c = l.c.*, d = list::items{ list = l.queue }[callee].decl }.fields
        let mut i: usize = 0
        while i < args.len {
            if types::find_field{ fields, name = own[@as(usize, args[i].index)].name } != null { return true }
            i = i + 1
        }
        return false
    }

    // The id of a widening thunk (Widen), queued the first time it is met: one per callee and
    // type, or per value type and type.
    fn widen_id { mut l: Lower, callee: u32, frm: Id, to: Id } -> u32 {
        let mut b = list::new(u8){ realloc = arena::alloc, heap = l.heap }
        put_u32{ xs = &b, n = NONE }         // no declaration's id: no other key starts with it
        put_u32{ xs = &b, n = callee }
        put_u32{ xs = &b, n = if callee == NONE { norm{ &l, t = frm } } else { 0 } }
        put_u32{ xs = &b, n = norm{ &l, t = to } }
        let key = list::items{ list = b }
        let known = map::get{ m = l.fn_ids, key }
        if known != null { return known }
        let id = @as(u32, l.queue.len)
        try! map::put{ m = &l.fn_ids, key, value = id }
        let decl = if callee == NONE { l.decl } else { list::items{ list = l.queue }[callee].decl }
        try! list::push{ list = &l.queue, item = Inst{ decl, targs = no_ids{}, site = NONE, widen = Widen{ callee, frm, to }, entry = NONE } }
        return id
    }

    // Widening thunk inst.widen as a function. Its context is to's fields after its callee's
    // own, or after the value it calls (`fn`, which no field can be named), each `mut` if to's
    // is. It passes its callee the fields it takes, by name, a read-only one it has `mut` read
    // through its pointer, and returns the result with the error renumbered.
    fn widening { mut l: Lower, id: u32, inst: Inst } -> ir::Func {
        let w = inst.widen ifnull { @panic("lower: a widening thunk that isn't one") }
        let d = check::get_decl{ c = l.c.*, d = inst.decl }
        l.decl = inst.decl
        l.targs = no_ids{}
        map::clear{ m = &l.slots }
        l.locals = list::new(ir::Local){ realloc = arena::alloc, heap = l.heap }
        let func{ fields = tf, ret = tr } = get{ l, t = w.to } else { @panic("lower: a widening to a non-function") }
        l.ret = tr
        let mut ctx = list::new(types::Field){ realloc = arena::alloc, heap = l.heap }
        let mut takes: []types::Field = slice::empty(types::Field){}     // what it calls takes
        let mut cr = types::VOID
        let mut b = message{ l }
        if w.callee == NONE {
            let func{ fields = ff, ret = fr } = get{ l, t = w.frm } else { @panic("lower: a widening of a non-function") }
            add_field{ xs = &ctx, f = types::Field{ name = "fn", mutable = false, ty = w.frm } }
            takes = sorted_fields{ l, fields = ff }
            cr = fr
            try! @fmt(&b, "({})", str{ s = type_name{ l, t = w.frm } })
        } else {
            let q = list::items{ list = l.queue }[w.callee]
            let x = check::get_decl{ c = l.c.*, d = q.decl }
            takes = check::subst_fields{ c = l.c, fields = x.fields, decl = q.decl, args = q.targs }
            cr = if q.targs.len == 0 { x.ret } else { types::subst{ s = &l.c.ty, t = x.ret, decl = q.decl, args = q.targs } }
            let mut i: usize = 0
            while i < takes.len {
                let f = takes[i]
                let h = types::find_field{ fields = tf, name = f.name }
                add_field{ xs = &ctx, f = types::Field{ name = f.name, mutable = f.mutable or (h != null and h.mutable), ty = f.ty } }
                i = i + 1
            }
            try! utf8::push{ &b, s = str{ s = inst_name{ l, x, targs = q.targs } } }
        }
        try! @fmt(&b, " as {}", str{ s = type_name{ l, t = w.to } })
        let mut i: usize = 0
        while i < tf.len {
            if types::find_field{ fields = list::items{ list = ctx }, name = tf[i].name } == null { add_field{ xs = &ctx, f = tf[i] } }
            i = i + 1
        }
        let fs = list::items{ list = ctx }
        let mut params = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
        i = 0
        while i < fs.len {
            let f = fs[i]
            try! list::push{ list = &params, item = ir::Param{ name = f.name, mutable = f.mutable, ty = tid{ &l, t = f.ty } } }
            let st = tid{ &l, t = arg_type{ &l, f, ptrs = true } }
            try! list::push{ list = &l.locals, item = ir::Local{ name = f.name, ty = st } }
            i = i + 1
        }
        let mut body = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        let mut args = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        i = 0
        while i < takes.len {
            let s = types::field_index{ fields = fs, name = takes[i].name } ifnull { @panic("lower: a widening thunk without a field its callee takes") }
            add_arg{ xs = &args, a = ir::Arg{ index = @as(u32, i), value = taken{ &l, f = takes[i], own = fs[s], slot = @as(u32, s), &body } } }
            i = i + 1
        }
        let ct = tid{ &l, t = cr }
        let call = if w.callee == NONE {
            let inner = mk{ ty = tid{ &l, t = w.frm }, k = ir::ExprKind::local{ slot = 0 } }
            mk{ ty = ct, k = ir::ExprKind::dcall{ callee = box{ l, e = inner }, args = list::items{ list = args }, pos = nowhere{} } }
        } else {
            mk{ ty = ct, k = ir::ExprKind::call{ callee = w.callee, args = list::items{ list = args }, pos = nowhere{} } }
        }
        let mut r = call
        if norm{ &l, t = cr } != norm{ &l, t = tr } { r = res_remap{ &l, x = call, frm = types::prune{ s = l.c.ty, t = cr }, to = types::prune{ s = l.c.ty, t = tr } } }
        try! list::push{ list = &body, item = ir::Stmt::ret{ value = r } }
        return ir::Func{
            id, name = utf8::view{ b }.bytes, symbol = "", params = list::items{ list = params }, ret = tid{ &l, t = tr },
            locals = list::items{ list = l.locals }, body = ir::Block{ stmts = list::items{ list = body }, result = null },
            unit = unit_of{ l, x = d }, at = d.syn.span.start, file = file_of{ &l, x = d }, shown = ir::Shown::hidden,
        }
    }

    // A thunk's argument for field f of what it calls, from its own param `own` in slot: the
    // param, or for a read-only f that it has `mut`, the value read through its pointer (§5)
    // into a local of body's, first: the callee sees the value the argument had (§14, rule 6),
    // which another argument may point into.
    fn taken { mut l: Lower, f: types::Field, own: types::Field, slot: u32, mut body: list::List(ir::Stmt, Heap) } -> ir::Expr {
        let at = tid{ &l, t = arg_type{ &l, f = own, ptrs = true } }
        let v = mk{ ty = at, k = ir::ExprKind::local{ slot } }
        if f.mutable or not own.mutable { return v }
        let ft = tid{ &l, t = f.ty }
        let z = temp{ &l, ty = ft }
        let init = mk{ ty = ft, k = ir::ExprKind::deref{ ptr = box{ l, e = v }, pos = ir::Pos{ line = 0, col = 0, file = 0 } } }
        try! list::push{ list = &body, item = ir::Stmt::define{ slot = z, init } }
        return mk{ ty = ft, k = ir::ExprKind::local{ slot = z } }
    }

    // ---- tasks (spec §15, Tasks)

    // A lent function value, in args, at one of the fields lent: a bind written in the call, whose
    // record holds its size (tbind), or the calling fn's own, passed on.
    fn task_record { mut l: Lower, lent: []u32, args: []ir::Arg, at: ir::Pos } -> []ir::Arg {
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < args.len {
            let mut a = args[i]
            if check::has_id{ xs = lent, n = a.index } {
                let v = a.value
                match v.k {
                    bind{ callee, args = bound } => {
                        let q = list::items{ list = l.queue }[callee]
                        let name = check::get_decl{ c = l.c.*, d = q.decl }.qual
                        a.value = mk{ ty = v.ty, k = ir::ExprKind::tbind{ callee, args = bound, name, pos = at } }
                    }
                    local => {}
                    else => { @panic("lower: a lent function value that isn't a bind") }
                }
            }
            try! list::push{ list = &out, item = a }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // The id of the entry thunk of a task whose result is r (@record_copy): it runs the record
    // it is given, and writes what that returns to `result`.
    fn entry_id { mut l: Lower, r: Id } -> u32 {
        let mut b = list::new(u8){ realloc = arena::alloc, heap = l.heap }
        put_u32{ xs = &b, n = NONE }         // no declaration's id
        put_u32{ xs = &b, n = NONE - 2 }     // no widening thunk's callee
        put_u32{ xs = &b, n = norm{ &l, t = r } }
        let key = list::items{ list = b }
        let known = map::get{ m = l.fn_ids, key }
        if known != null { return known }
        let id = @as(u32, l.queue.len)
        try! map::put{ m = &l.fn_ids, key, value = id }
        try! list::push{ list = &l.queue, item = Inst{ decl = l.decl, targs = no_ids{}, site = NONE, widen = null, entry = r } }
        return id
    }

    // Entry thunk inst as a function: `fn{ record: *mut u8, result: *mut u8 }`, calling the
    // record as a `&fn{} -> R` and storing its result at `result`.
    fn entering { mut l: Lower, id: u32, inst: Inst } -> ir::Func {
        let d = check::get_decl{ c = l.c.*, d = inst.decl }
        l.decl = inst.decl
        l.targs = no_ids{}
        map::clear{ m = &l.slots }
        l.locals = list::new(ir::Local){ realloc = arena::alloc, heap = l.heap }
        let r = inst.entry
        l.ret = types::VOID
        let bytes = types::ptr{ s = &l.c.ty, elem = types::U8, mutable = true }
        let pt = tid{ &l, t = bytes }
        let mut params = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &params, item = ir::Param{ name = "record", mutable = false, ty = pt } }
        try! list::push{ list = &params, item = ir::Param{ name = "result", mutable = false, ty = pt } }
        try! list::push{ list = &l.locals, item = ir::Local{ name = "record", ty = pt } }
        try! list::push{ list = &l.locals, item = ir::Local{ name = "result", ty = pt } }
        let ft = tid{ &l, t = types::func{ s = &l.c.ty, fields = slice::empty(types::Field){}, ret = r, bound = true, external = false, keeps = slice::empty(types::Keep){}, thread = false } }
        let rt = tid{ &l, t = r }
        let run = mk{ ty = ft, k = ir::ExprKind::cast{ e = box{ l, e = mk{ ty = pt, k = ir::ExprKind::local{ slot = 0 } } } } }
        let call = mk{ ty = rt, k = ir::ExprKind::dcall{ callee = box{ l, e = run }, args = slice::empty(ir::Arg){}, pos = nowhere{} } }
        let mut body = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        if list::items{ list = l.types }[rt] is void {
            try! list::push{ list = &body, item = ir::Stmt::eval{ e = call } }
        } else {
            let to = tid{ &l, t = types::ptr{ s = &l.c.ty, elem = r, mutable = true } }
            let at = mk{ ty = to, k = ir::ExprKind::cast{ e = box{ l, e = mk{ ty = pt, k = ir::ExprKind::local{ slot = 1 } } } } }
            let place = mk{ ty = rt, k = ir::ExprKind::deref{ ptr = box{ l, e = at }, pos = ir::Pos{ line = 0, col = 0, file = 0 } } }
            try! list::push{ list = &body, item = ir::Stmt::assign{ place, value = call } }
        }
        let mut b = message{ l }
        try! @fmt(&b, "task entry of {}", str{ s = type_name{ l, t = r } })
        return ir::Func{
            id, name = utf8::view{ b }.bytes, symbol = "", params = list::items{ list = params }, ret = tid{ &l, t = types::VOID },
            locals = list::items{ list = l.locals }, body = ir::Block{ stmts = list::items{ list = body }, result = null },
            unit = unit_of{ l, x = d }, at = d.syn.span.start, file = file_of{ &l, x = d }, shown = ir::Shown::root,
        }
    }

    struct Scrut { through: bool, vs: []check::Variant, enum_decl: u32 }

    fn scrut_type { mut l: Lower, x: syntax::Match } -> Scrut {
        let mut t = types::prune{ s = l.c.ty, t = T{ &l, t = check::type_of_expr{ c = l.c.*, e = x.scrut.* } } }
        let mut through = false
        if types::get{ s = l.c.ty, id = t } is ptr{ elem } {
            through = true
            t = types::prune{ s = l.c.ty, t = elem }
        }
        let mut enum_decl = NONE
        if types::get{ s = l.c.ty, id = t } is enumeration{ decl } { enum_decl = decl }
        return Scrut{ through, vs = check::variants_of{ c = l.c, t }, enum_decl }
    }

    fn arms { mut l: Lower, x: syntax::Match, vs: []check::Variant, t: Id, value: bool } -> []ir::Arm {
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < x.arms.len {
            let arm = x.arms[i]
            let mut pats = list::new(ir::Pat){ realloc = arena::alloc, heap = l.heap }
            let mut k: usize = 0
            while k < arm.pats.len {
                let p = arm.pats[k]
                let vi = variant_at{ vs, name = p.variant.text }
                let bs = if k == 0 {
                    binds{ &l, binders = p.binders, fields = vs[vi].fields }
                } else {
                    alt_binds{ &l, first = arm.pats[0].binders, binders = p.binders, fields = vs[vi].fields }
                }
                try! list::push{ list = &pats, item = ir::Pat{ variant = vi, binds = bs } }
                k = k + 1
            }
            let body = if value { value_block{ &l, b = arm.body, t } } else { block{ &l, b = arm.body } }
            try! list::push{ list = &out, item = ir::Arm{ pats = list::items{ list = pats }, body } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // A match on an enum: each arm by the values of its variants.
    fn cases { mut l: Lower, x: syntax::Match, decl: u32, t: Id, value: bool } -> []ir::Case {
        let d = check::get_decl{ c = l.c.*, d = decl }
        let names = check::enum_names{ c = l.c.*, d = decl }
        let mut out = list::new(ir::Case){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < x.arms.len {
            let arm = x.arms[i]
            let mut vals = list::new(ir::Int){ realloc = arena::alloc, heap = l.heap }
            let mut k: usize = 0
            while k < arm.pats.len {
                let vi = name_index{ names, name = arm.pats[k].variant.text }
                try! list::push{ list = &vals, item = int_of{ v = d.values[vi] } }
                k = k + 1
            }
            let body = if value { value_block{ &l, b = arm.body, t } } else { block{ &l, b = arm.body } }
            try! list::push{ list = &out, item = ir::Case{ values = list::items{ list = vals }, ranges = slice::empty(ir::Range){}, body } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // A match on an integer (§8, Match on integers): each arm by the ranges the checker found,
    // rs, a range of one being a value.
    fn int_cases { mut l: Lower, x: syntax::Match, rs: [][]ir::Range, t: Id, value: bool } -> []ir::Case {
        let mut out = list::new(ir::Case){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < x.arms.len {
            let arm = x.arms[i]
            let body = if value { value_block{ &l, b = arm.body, t } } else { block{ &l, b = arm.body } }
            try! list::push{ list = &out, item = int_case{ &l, rs = rs[i], body } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn int_case { mut l: Lower, rs: []ir::Range, body: ir::Block } -> ir::Case {
        let mut vals = list::new(ir::Int){ realloc = arena::alloc, heap = l.heap }
        let mut ranges = list::new(ir::Range){ realloc = arena::alloc, heap = l.heap }
        let mut k: usize = 0
        while k < rs.len {
            let r = rs[k]
            if r.lo.negative == r.hi.negative and r.lo.value == r.hi.value {
                try! list::push{ list = &vals, item = r.lo }
            } else {
                try! list::push{ list = &ranges, item = r }
            }
            k = k + 1
        }
        return ir::Case{ values = list::items{ list = vals }, ranges = list::items{ list = ranges }, body }
    }

    // `x is P | Q` on an integer: a switch giving true for arm's ranges and false otherwise.
    fn int_is { mut l: Lower, x: syntax::Expr, arm: []ir::Range } -> ir::Expr {
        let scrut = ex{ &l, e = x }
        let mut cases = list::new(ir::Case){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &cases, item = int_case{ &l, rs = arm, body = bool_block{ &l, value = true } } }
        try! list::push{ list = &cases, item = ir::Case{ values = slice::empty(ir::Int){}, ranges = slice::empty(ir::Range){}, body = bool_block{ &l, value = false } } }
        return mk{ ty = tid{ &l, t = types::BOOL }, k = ir::ExprKind::switchx{ scrut = box{ l, e = scrut }, cases = list::items{ list = cases } } }
    }

    fn name_index { names: [][]u8, name: []u8 } -> usize {
        let mut i: usize = 0
        while i < names.len {
            if slice::eq_bytes{ a = names[i], b = name } { return i }
            i = i + 1
        }
        @panic("lower: no such enum variant")
    }

    fn int_of { v: i64 } -> ir::Int {
        return ir::Int{ negative = v < 0, value = check::magnitude{ v } }
    }

    // A branch of an `if` or `match` expression of type t: its last statement gives its value,
    // unless the branch always leaves. A nested `if` or `match` whose every branch leaves is a
    // statement.
    fn value_block { mut l: Lower, b: syntax::Block, t: Id } -> ir::Block {
        let xs = b.stmts
        let v = if xs.len == 0 { check::Value::none } else { check::branch_value{ s = xs[xs.len - 1] } }
        if v is none { return ir::Block{ stmts = stmts{ &l, xs }, result = null } }
        let mut out = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i + 1 < xs.len {
            put_stmt{ &l, xs = &out, s = xs[i] }
            i = i + 1
        }
        match v {
            nested{ s } => {
                if nodes::get{ m = l.c.expr_ty, key = check::stmt_key{ s } } == null {
                    let st = leaving{ &l, s }
                    try! list::push{ list = &out, item = st }
                    return ir::Block{ stmts = list::items{ list = out }, result = null }
                }
                let r = nested_full{ &l, s }
                let x = coerce{ &l, x = r, frm = T{ &l, t = check::value_ty{ c = l.c.*, k = check::stmt_key{ s } } }, to = T{ &l, t }, at = s.span }
                return ir::Block{ stmts = list::items{ list = out }, result = box{ l, e = x } }
            }
            expr{ e } => {
                let x = if t == types::NO_TYPE { ex{ &l, e } } else { conv{ &l, e, to = t } }
                return ir::Block{ stmts = list::items{ list = out }, result = box{ l, e = x } }
            }
            none => {}
        }
        return ir::Block{ stmts = list::items{ list = out }, result = null }
    }

    fn leaving { mut l: Lower, s: syntax::Stmt } -> ir::Stmt {
        match s.k {
            cond{ x } => {
                let c = ex{ &l, e = x.c.* }
                let then = value_block{ &l, b = x.then, t = types::NO_TYPE }
                let x_els = x.els
                let mut els: ?ir::Block = null
                if x_els != null { els = value_block{ &l, b = x_els, t = types::NO_TYPE } }
                return ir::Stmt::cond{ c, then, els }
            }
            choose{ x } => { return match_stmt{ &l, x, t = types::NO_TYPE, leaving = true } }
            else => { @panic("lower: a branch value that isn't an if or match") }
        }
    }

    // A nested `if` or `match` giving a branch its value, with its conversion.
    fn nested_full { mut l: Lower, s: syntax::Stmt } -> ir::Expr {
        let k = check::stmt_key{ s }
        let conv = nodes::get{ m = l.c.convs, key = k }
        if conv != null and conv is some{ to } {
            let inner = coerce{ &l, x = nested{ &l, s }, frm = T{ &l, t = check::type_of_key{ c = l.c.*, k } }, to = opt_elem{ l, t = T{ &l, t = to } }, at = s.span }
            return mk{ ty = tid{ &l, t = T{ &l, t = to } }, k = ir::ExprKind::some{ e = box{ l, e = inner } } }
        }
        return nested{ &l, s }
    }

    fn nested { mut l: Lower, s: syntax::Stmt } -> ir::Expr {
        let t = T{ &l, t = check::type_of_key{ c = l.c.*, k = check::stmt_key{ s } } }
        match s.k {
            cond{ x } => { return if_expr{ &l, x, t } }
            choose{ x } => { return match_expr{ &l, x, t } }
            else => { @panic("lower: a branch value that isn't an if or match") }
        }
    }

    fn if_expr { mut l: Lower, x: syntax::If, t: Id } -> ir::Expr {
        let ty = tid{ &l, t }
        let c = ex{ &l, e = x.c.* }
        let then = value_block{ &l, b = x.then, t }
        let x_els = x.els
        let mut els = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = null }
        if x_els != null { els = value_block{ &l, b = x_els, t } }
        return mk{ ty, k = ir::ExprKind::ifx{ c = box{ l, e = c }, then, els } }
    }

    // `x ifoverflow els`: an ovf with a trap of its own, which the operations of x it covers
    // leave for (trap_of).
    fn ovf_expr { mut l: Lower, e: syntax::Expr, x: syntax::Expr, els: syntax::Block, t: Id } -> ir::Expr {
        let ty = tid{ &l, t }
        let trap = l.traps
        l.traps = l.traps + 1
        try! map::put{ m = &l.trap_ids, key = check::expr_key{ e }, value = trap }
        let v = conv{ &l, e = x, to = t }
        let b = value_block{ &l, b = els, t }
        return mk{ ty, k = ir::ExprKind::ovf{ trap, e = box{ l, e = v }, els = b } }
    }

    // The trap e leaves for if it overflows: its `ifoverflow`'s, or ir::NO_TRAP to panic.
    fn trap_of { l: Lower, e: syntax::Expr } -> u32 {
        let region = map::get{ m = l.c.traps, key = check::expr_key{ e } } ifnull { return ir::NO_TRAP }
        return map::get{ m = l.trap_ids, key = region } ifnull { ir::NO_TRAP }
    }

    fn match_expr { mut l: Lower, x: syntax::Match, t: Id } -> ir::Expr {
        let ty = tid{ &l, t }
        let scrut = ex{ &l, e = x.scrut.* }
        let ft = fail_scrut{ &l, x }
        if ft != types::NO_TYPE {
            return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = scrut }, through = false, arms = fail_arms{ &l, x, st = ft, t, value = true } } }
        }
        let rs = map::get{ m = l.c.int_cases, key = check::expr_key{ e = x.scrut.* } }
        if rs != null { return mk{ ty, k = ir::ExprKind::switchx{ scrut = box{ l, e = scrut }, cases = int_cases{ &l, x, rs, t, value = true } } } }
        let u = scrut_type{ &l, x }
        if u.enum_decl != NONE {
            return mk{ ty, k = ir::ExprKind::switchx{ scrut = box{ l, e = scrut }, cases = cases{ &l, x, decl = u.enum_decl, t, value = true } } }
        }
        return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = scrut }, through = u.through, arms = arms{ &l, x, vs = u.vs, t, value = true } } }
    }

    // ---- expressions

    fn mk { ty: u32, k: ir::ExprKind } -> ir::Expr {
        return ir::Expr{ ty, k }
    }

    fn box { l: Lower, e: ir::Expr } -> *ir::Expr {
        let p = try! alloc::new{ realloc = arena::alloc, heap = l.heap, value = e }
        return p
    }

    fn opt_elem { l: Lower, t: Id } -> Id {
        match get{ l, t } {
            opt{ elem } => { return elem }
            else => { @panic("lower: some of a non-optional") }
        }
    }

    // The type e has as ctxi's tree has it: with the conversion around it, if any.
    fn after { mut l: Lower, e: syntax::Expr } -> Id {
        return T{ &l, t = check::value_ty{ c = l.c.*, k = check::expr_key{ e } } }
    }

    // e converted to type `to`, as the checker allowed implicitly.
    fn conv { mut l: Lower, e: syntax::Expr, to: Id } -> ir::Expr {
        let x = ex{ &l, e }
        return coerce{ &l, x, frm = after{ &l, e }, to = T{ &l, t = to }, at = check::expr_at{ e } }
    }

    // x, of type frm, as a `to`; at is where it is.
    fn coerce { mut l: Lower, x: ir::Expr, frm: Id, to: Id, at: source::Span } -> ir::Expr {
        if norm{ &l, t = frm } == norm{ &l, t = to } { return x }
        let a = types::prune{ s = l.c.ty, t = frm }
        let b = types::prune{ s = l.c.ty, t = to }
        // A T becomes a `!T`'s `ok`, an error its `err`; a result or an error with fewer errors
        // is renumbered into the larger set (§8, Errors).
        match get{ l, t = b } {
            res{ ok = u, errs = into } => {
                match get{ l, t = a } {
                    res => { return res_remap{ &l, x, frm = a, to = b } }
                    errs | eset => {
                        let v = remap{ &l, x, frm = a, to = into }
                        return mk{ ty = tid{ &l, t = b }, k = ir::ExprKind::variant{ index = 1, items = one_arg{ l, v } } }
                    }
                    else => {
                        let v = coerce{ &l, x, frm = a, to = u, at }
                        return mk{ ty = tid{ &l, t = b }, k = ir::ExprKind::variant{ index = 0, items = one_arg{ l, v } } }
                    }
                }
            }
            errs | eset => {
                if get{ l, t = a } is errs | eset { return remap{ &l, x, frm = a, to = b } }
            }
            else => {}
        }
        if types::prim_of{ s = l.c.ty, t = a } != null and types::prim_of{ s = l.c.ty, t = b } != null and types::widens{ s = &l.c.ty, a, b } {
            return mk{ ty = tid{ &l, t = b }, k = ir::ExprKind::widen{ e = box{ l, e = x } } }
        }
        match get{ l, t = a } {
            func => {
                if get{ l, t = b } is func {
                    if widens{ &l, a, b } or reads{ l, a, b } { return widen_fn{ &l, x, frm = a, to = b } }
                    return mk{ ty = tid{ &l, t = b }, k = ir::ExprKind::fnconv{ e = box{ l, e = x } } }
                }
            }
            cap => {
                if get{ l, t = b } is cap { return cap_copy{ &l, x, frm = a, to = b } }
            }
            ptr{ elem = pa } => {
                if get{ l, t = b } is ptr{ elem = pb } and get{ l, t = pa } is cap { return cap_ptr{ &l, x, frm = pa, to = pb, pt = b, at } }
            }
            else => {}
        }
        @panic("lower: no implicit conversion")
    }

    // Capability x, of type frm, as the capability `to` it includes (§15): a `to` of the same
    // functions, read from x once.
    fn cap_copy { mut l: Lower, x: ir::Expr, frm: Id, to: Id } -> ir::Expr {
        let ty = tid{ &l, t = to }
        let names = check::cap_fields{ c = l.c.*, t = to }
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        if plain{ x } {
            cap_args{ &l, src = x, frm, names, into = names, out = &out }
            return mk{ ty, k = ir::ExprKind::record{ items = list::items{ list = out } } }
        }
        let s = temp{ &l, ty = x.ty }
        cap_args{ &l, src = mk{ ty = x.ty, k = ir::ExprKind::local{ slot = s } }, frm, names, into = names, out = &out }
        let lit = mk{ ty, k = ir::ExprKind::record{ items = list::items{ list = out } } }
        return mk{ ty, k = ir::ExprKind::with{ slot = s, init = box{ l, e = x }, body = box{ l, e = lit } } }
    }

    // Pointer x to a capability frm as a pointer, of type pt, to the capability `to` it includes,
    // as a `mut` field takes it (§15): x itself if to's fields are the first of frm's, and
    // otherwise the address of a new local, a `to` with x's functions.
    fn cap_ptr { mut l: Lower, x: ir::Expr, frm: Id, to: Id, pt: Id, at: source::Span } -> ir::Expr {
        let ty = tid{ &l, t = pt }
        if check::cap_prefix{ c = l.c.*, a = frm, b = to } { return mk{ ty, k = ir::ExprKind::cast{ e = box{ l, e = x } } } }
        let mut p = x
        let mut ps = NONE
        if not plain{ x } {
            ps = temp{ &l, ty = x.ty }
            p = mk{ ty = x.ty, k = ir::ExprKind::local{ slot = ps } }
        }
        let src = mk{ ty = tid{ &l, t = frm }, k = ir::ExprKind::deref{ ptr = box{ l, e = p }, pos = pos{ &l, at } } }
        let names = check::cap_fields{ c = l.c.*, t = to }
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        cap_args{ &l, src, frm, names, into = names, out = &out }
        let ct = tid{ &l, t = to }
        let s = temp{ &l, ty = ct }
        let lit = mk{ ty = ct, k = ir::ExprKind::record{ items = list::items{ list = out } } }
        let v = mk{ ty = ct, k = ir::ExprKind::local{ slot = s } }
        let a = mk{ ty, k = ir::ExprKind::addr{ place = box{ l, e = v } } }
        let r = mk{ ty, k = ir::ExprKind::with{ slot = s, init = box{ l, e = lit }, body = box{ l, e = a } } }
        if ps == NONE { return r }
        return mk{ ty, k = ir::ExprKind::with{ slot = ps, init = box{ l, e = x }, body = box{ l, e = r } } }
    }

    // An item of a literal of a capability with fields `into` for each field in names: the
    // field of that name of src, a capability of type frm.
    fn cap_args { mut l: Lower, src: ir::Expr, frm: Id, names: []types::Field, into: []types::Field, mut out: list::List(ir::Arg, Heap) } {
        let from = check::cap_fields{ c = l.c.*, t = frm }
        let mut i: usize = 0
        while i < names.len {
            let ft = tid{ &l, t = names[i].ty }
            let j = field_pos{ fields = from, name = names[i].name }
            let v = mk{ ty = ft, k = ir::ExprKind::field{ base = box{ l, e = src }, index = @as(u32, j) } }
            add_arg{ xs = &out, a = ir::Arg{ index = @as(u32, field_pos{ fields = into, name = names[i].name }), value = v } }
            i = i + 1
        }
    }

    // A local that lowering adds, of IR type ty, named `_`, which no local in the source is.
    fn temp { mut l: Lower, ty: u32 } -> u32 {
        let s = @as(u32, l.locals.len)
        try! list::push{ list = &l.locals, item = ir::Local{ name = "_", ty } }
        return s
    }

    // Whether x is a place reached without effects, as a local, a `mut` field or a field of one
    // is: reading it twice reads the same value.
    fn plain { x: ir::Expr } -> bool {
        match x.k {
            local => { return true }
            deref{ ptr } => { return plain{ x = ptr.* } }
            addr{ place } => { return plain{ x = place.* } }
            field{ base } => { return plain{ x = base.* } }
            else => { return false }
        }
    }

    // e as ctxi's tree has it: the node, inside the conversion the checker recorded for it.
    fn ex { mut l: Lower, e: syntax::Expr } -> ir::Expr {
        if l.kept.len > 0 {
            if let k = map::get{ m = l.kept, key = check::expr_key{ e } } { return slot_ex{ ty = k.ty, slot = k.slot } }
        }
        let conv = nodes::get{ m = l.c.convs, key = check::expr_key{ e } }
        if conv == null { return node{ &l, e } }
        match conv {
            some{ to } => {
                let t = T{ &l, t = to }
                let inner = coerce{ &l, x = node{ &l, e }, frm = T{ &l, t = check::type_of_expr{ c = l.c.*, e } }, to = opt_elem{ l, t }, at = check::expr_at{ e } }
                return mk{ ty = tid{ &l, t }, k = ir::ExprKind::some{ e = box{ l, e = inner } } }
            }
            slice{ to } => {
                let t = T{ &l, t = to }
                let at = T{ &l, t = check::type_of_expr{ c = l.c.*, e } }
                let pt = tid{ &l, t = types::ptr{ s = &l.c.ty, elem = slice_elem{ l, t }, mutable = false } }
                let p = mk{ ty = pt, k = ir::ExprKind::cast{ e = box{ l, e = node{ &l, e } } } }
                return to_slice{ &l, t, p, n = array_len{ l, t = ptr_elem{ l, t = at } } }
            }
            addr_slice{ ptr, to } => {
                let t = T{ &l, t = to }
                let pty = T{ &l, t = ptr }
                let pt = tid{ &l, t = types::ptr{ s = &l.c.ty, elem = slice_elem{ l, t }, mutable = false } }
                let at = tid{ &l, t = pty }
                let a = mk{ ty = at, k = ir::ExprKind::addr{ place = box{ l, e = node{ &l, e } } } }
                let p = mk{ ty = pt, k = ir::ExprKind::cast{ e = box{ l, e = a } } }
                return to_slice{ &l, t, p, n = array_len{ l, t = ptr_elem{ l, t = pty } } }
            }
        }
    }

    // A pointer to an array as a slice of all of it: a struct of the pointer and the length.
    fn to_slice { mut l: Lower, t: Id, p: ir::Expr, n: u64 } -> ir::Expr {
        let st = tid{ &l, t }
        let n_ir = mk{ ty = tid{ &l, t = types::USIZE }, k = ir::ExprKind::int{ negative = false, value = n } }
        return mk{ ty = st, k = ir::ExprKind::record{ items = two_args{ l, a = p, b = n_ir } } }
    }

    fn two_args { l: Lower, a: ir::Expr, b: ir::Expr } -> []ir::Arg {
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        add_arg{ xs = &out, a = ir::Arg{ index = 0, value = a } }
        add_arg{ xs = &out, a = ir::Arg{ index = 1, value = b } }
        return list::items{ list = out }
    }

    fn add_arg { mut xs: list::List(ir::Arg, Heap), a: ir::Arg } {
        try! list::push{ list = &xs, item = a }
    }

    fn slice_elem { l: Lower, t: Id } -> Id {
        match get{ l, t } { slice{ elem } => { return elem } else => { @panic("lower: not a slice") } }
    }

    fn ptr_elem { l: Lower, t: Id } -> Id {
        match get{ l, t } { ptr{ elem } => { return elem } else => { @panic("lower: not a pointer") } }
    }

    fn array_len { l: Lower, t: Id } -> u64 {
        match get{ l, t } { array{ n } => { return n } else => { @panic("lower: not an array") } }
    }

    fn elem_of { l: Lower, t: Id } -> Id {
        match get{ l, t } {
            array{ elem } => { return elem }
            slice{ elem } => { return elem }
            ptr{ elem } => { return elem }
            opt{ elem } => { return elem }
            else => { @panic("lower: a type without elements") }
        }
    }

    fn int_lit { mut l: Lower, t: Id, n: u64 } -> ir::Expr {
        return mk{ ty = tid{ &l, t }, k = ir::ExprKind::int{ negative = false, value = n } }
    }

    // A local, a context field or a binding, or a narrowed view of one (the payload of the ?T).
    fn var_ex { mut l: Lower, v: u32, at: source::Span } -> ir::Expr {
        let x = check::get_var{ c = l.c.*, v }
        let t = T{ &l, t = x.ty }
        if x.kind == check::VarKind::narrow {
            let ty = tid{ &l, t }
            let inner = var_ex{ &l, v = x.narrow_of, at }
            return mk{ ty, k = ir::ExprKind::payload{ base = box{ l, e = inner }, variant = 1, field = 0 } }
        }
        let s = slot{ &l, v }
        if x.indirect {
            let ty = tid{ &l, t }
            let pt = tid{ &l, t = types::ptr{ s = &l.c.ty, elem = t, mutable = false } }
            let p = pos{ &l, at }
            let local = mk{ ty = pt, k = ir::ExprKind::local{ slot = s } }
            return mk{ ty, k = ir::ExprKind::deref{ ptr = box{ l, e = local }, pos = p } }
        }
        return mk{ ty = tid{ &l, t }, k = ir::ExprKind::local{ slot = s } }
    }

    fn node { mut l: Lower, e: syntax::Expr } -> ir::Expr {
        let t = T{ &l, t = check::type_of_expr{ c = l.c.*, e } }
        match e.k {
            int{ negative, value } => {
                let v = if value == null { 0 } else { value }
                return mk{ ty = tid{ &l, t }, k = ir::ExprKind::int{ negative = negative and v != 0, value = v } }
            }
            float{ negative, value } => {
                return mk{ ty = tid{ &l, t }, k = ir::ExprKind::float{ value = if negative { -value } else { value } } }
            }
            str{ bytes } => { return str_lit{ &l, e, bytes, t } }
            boolean{ value } => { return mk{ ty = tid{ &l, t }, k = ir::ExprKind::boolean{ value } } }
            nil => { return mk{ ty = tid{ &l, t }, k = ir::ExprKind::nil } }
            path => { return path_ex{ &l, e, t } }
            field{ base, name } => { return field_ex{ &l, e, base = base.*, name, t } }
            deref{ base } => {
                let ty = tid{ &l, t }
                let b = ex{ &l, e = base.* }
                return mk{ ty, k = ir::ExprKind::deref{ ptr = box{ l, e = b }, pos = epos{ &l, e } } }
            }
            index{ base, i } => { return index_ex{ &l, e, base = base.*, i = i.*, t } }
            range{ base, lo, hi } => {
                // A bound keeps its integer type, which the check takes as it is (§12, Slices).
                let lo_ir = if lo == null { int_lit{ &l, t = types::USIZE, n = 0 } } else { ex{ &l, e = lo.* } }
                let mut hi_ir: ?*ir::Expr = null
                if hi != null { hi_ir = box{ l, e = ex{ &l, e = hi.* } } }
                let ty = tid{ &l, t }
                let b = ex{ &l, e = base.* }
                return mk{ ty, k = ir::ExprKind::ssub{ base = box{ l, e = b }, lo = box{ l, e = lo_ir }, hi = hi_ir, pos = epos{ &l, e } } }
            }
            addr{ e = x } => {
                let ty = tid{ &l, t }
                return mk{ ty, k = ir::ExprKind::addr{ place = box{ l, e = ex{ &l, e = x.* } } } }
            }
            neg{ e = x } => {
                let ty = tid{ &l, t }
                let v = ex{ &l, e = x.* }
                return mk{ ty, k = ir::ExprKind::neg{ e = box{ l, e = v }, pos = epos{ &l, e }, trap = trap_of{ l, e } } }
            }
            lnot{ e = x } => {
                let ty = tid{ &l, t }
                return mk{ ty, k = ir::ExprKind::lnot{ e = box{ l, e = ex{ &l, e = x.* } } } }
            }
            bnot{ e = x } => {
                // ~x is x ^ all ones: -1 if signed, 2^N - 1 if unsigned.
                let ty = tid{ &l, t }
                let p = types::prim_of{ s = l.c.ty, t } ifnull { @panic("lower: ~ of a non-integer") }
                let w = types::bits{ p }
                let ones = if types::signed{ p } {
                    ir::ExprKind::int{ negative = true, value = 1 }
                } else {
                    ir::ExprKind::int{ negative = false, value = 18446744073709551615 >> (64 - w) }
                }
                let v = ex{ &l, e = x.* }
                return mk{ ty, k = ir::ExprKind::bits{ op = ir::BitOp::bit_xor, a = box{ l, e = v }, b = box{ l, e = mk{ ty, k = ones } } } }
            }
            binary{ op, a, b } => { return binary{ &l, e, op, a = a.*, b = b.*, t } }
            braced{ callee, items, bind } => { return braced{ &l, e, callee = callee.*, items, bind, t } }
            array | repeat => {
                if map::has{ m = l.c.views, key = check::expr_key{ e } } { return view_ex{ &l, e, t } }
                return array_ex{ &l, e, t }
            }
            builtin{ name, targ, args } => { return builtin{ &l, e, name = name.text, targ, args, t } }
            ifx{ x } => { return if_expr{ &l, x, t } }
            matchx{ x } => { return match_expr{ &l, x, t } }
            overflow{ e = x, els } => { return ovf_expr{ &l, e, x = x.*, els, t } }
            trye{ e = x, panics } => {
                let scrut = ex{ &l, e = x.* }
                let ty = tid{ &l, t }
                return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = scrut }, through = false, arms = try_arms{ &l, x = x.*, value = true, panics, pos = epos{ &l, e } } } }
            }
            isx{ e = x, pats } => {
                let rs = map::get{ m = l.c.int_cases, key = check::expr_key{ e } }
                if rs != null { return int_is{ &l, x = x.*, arm = rs[0] } }
                return is_ex{ &l, x = x.*, pats }
            }
            error => { @panic("lower: an expression that didn't parse") }
            paren_call => { @panic("lower: a call with parentheses, which the checker reports") }
        }
    }

    // `x is P` (§8, Is): a match on x giving true for P's variants and false for the others. On
    // a `?U`, patterns of U's variants go in an inner match on the value, which `some` binds to
    // a temporary. Every pattern binds the first one's locals.
    fn is_ex { mut l: Lower, x: syntax::Expr, pats: []syntax::Pattern } -> ir::Expr {
        let scrut = ex{ &l, e = x }
        let t = types::prune{ s = l.c.ty, t = T{ &l, t = check::type_of_expr{ c = l.c.*, e = x } } }
        if types::get{ s = l.c.ty, id = t } is res | errs | eset { return fail_is{ &l, scrut, t, pats } }
        let vs = check::variants_of{ c = l.c, t }
        let mut own = list::new(syntax::Pattern){ realloc = arena::alloc, heap = l.heap }
        let mut deep = list::new(syntax::Pattern){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < pats.len {
            let xs = if check::variant_index{ vs, name = pats[i].variant.text } == NONE { &deep } else { &own }
            try! list::push{ list = xs, item = pats[i] }
            i = i + 1
        }
        let first = pats[0].binders
        if deep.len == 0 { return test{ &l, scrut, t, vs, pats, first } }
        let u = types::prune{ s = l.c.ty, t = opt_elem{ l, t } }
        let ut = tid{ &l, t = u }
        let slot = temp{ &l, ty = ut }
        let inner = test{ &l, scrut = mk{ ty = ut, k = ir::ExprKind::local{ slot } }, t = u, vs = check::variants_of{ c = l.c, t = u }, pats = list::items{ list = deep }, first }
        let mine = list::items{ list = own }
        let none = slice::empty(ir::Bind){}
        let mut take = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        add_bind{ xs = &take, b = ir::Bind{ slot, field = 0, by_ref = false } }
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 0, binds = none } }, body = bool_block{ &l, value = has_pat{ pats = mine, name = "null" } } }
        let some = pat_named{ pats = mine, name = "some" }
        if some != null {
            let bs = alt_binds{ &l, first, binders = some.binders, fields = vs[1].fields }
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = bs } }, body = bool_block{ &l, value = true } }
        } else {
            let body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = box{ l, e = inner } }
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = list::items{ list = take } } }, body }
        }
        return mk{ ty = tid{ &l, t = types::BOOL }, k = ir::ExprKind::matchx{ scrut = box{ l, e = scrut }, through = false, arms = list::items{ list = out } } }
    }

    // `x is P` on a `!T` or an error, scrut, of type t (§8, Is). `ok` and `err` are a `!T`'s
    // variants. Errors listed are a match on the error: the `!T`'s, or scrut itself.
    fn fail_is { mut l: Lower, scrut: ir::Expr, t: Id, pats: []syntax::Pattern } -> ir::Expr {
        let first = pats[0].binders
        if not is_error_pat{ l, p = pats[0] } { return test{ &l, scrut, t, vs = check::variants_of{ c = l.c, t }, pats, first } }
        let mut errs = t
        if types::get{ s = l.c.ty, id = t } is res{ errs = es } { errs = es }
        let ps = error_pats{ &l, pats, set = check::set_of{ c = l.c.*, t = errs } }
        let ty = tid{ &l, t = types::BOOL }
        let none = slice::empty(ir::Pat){}
        let mut arms = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        add_arm{ l, xs = &arms, pats = ps, body = bool_block{ &l, value = true } }
        add_arm{ l, xs = &arms, pats = none, body = bool_block{ &l, value = false } }
        if errs == t { return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = scrut }, through = false, arms = list::items{ list = arms } } } }
        // A `!T`: its error, then the match on it.
        let et = tid{ &l, t = errs }
        let slot = temp{ &l, ty = et }
        let inner = mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = mk{ ty = et, k = ir::ExprKind::local{ slot } } }, through = false, arms = list::items{ list = arms } } }
        let mut take = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        add_bind{ xs = &take, b = ir::Bind{ slot, field = 0, by_ref = false } }
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = list::items{ list = take } } }, body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = box{ l, e = inner } } }
        add_arm{ l, xs = &out, pats = none, body = bool_block{ &l, value = false } }
        return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = scrut }, through = false, arms = list::items{ list = out } } }
    }

    // Whether scrut, of type t with variants vs, holds one of pats' variants: a switch on an
    // enum, else a match, whose patterns each bind the locals of the `is`'s first pattern, whose
    // binders are first.
    fn test { mut l: Lower, scrut: ir::Expr, t: Id, vs: []check::Variant, pats: []syntax::Pattern, first: []syntax::Binder } -> ir::Expr {
        let ty = tid{ &l, t = types::BOOL }
        let all = pats.len == vs.len
        if types::get{ s = l.c.ty, id = t } is enumeration{ decl } {
            let d = check::get_decl{ c = l.c.*, d = decl }
            let names = check::enum_names{ c = l.c.*, d = decl }
            let mut vals = list::new(ir::Int){ realloc = arena::alloc, heap = l.heap }
            let mut i: usize = 0
            while i < pats.len {
                try! list::push{ list = &vals, item = int_of{ v = d.values[name_index{ names, name = pats[i].variant.text }] } }
                i = i + 1
            }
            let mut cases = list::new(ir::Case){ realloc = arena::alloc, heap = l.heap }
            try! list::push{ list = &cases, item = ir::Case{ values = list::items{ list = vals }, ranges = slice::empty(ir::Range){}, body = bool_block{ &l, value = true } } }
            if not all { try! list::push{ list = &cases, item = ir::Case{ values = slice::empty(ir::Int){}, ranges = slice::empty(ir::Range){}, body = bool_block{ &l, value = false } } } }
            return mk{ ty, k = ir::ExprKind::switchx{ scrut = box{ l, e = scrut }, cases = list::items{ list = cases } } }
        }
        let mut ps = list::new(ir::Pat){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < pats.len {
            let vi = variant_at{ vs, name = pats[i].variant.text }
            let bs = alt_binds{ &l, first, binders = pats[i].binders, fields = vs[vi].fields }
            try! list::push{ list = &ps, item = ir::Pat{ variant = vi, binds = bs } }
            i = i + 1
        }
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        add_arm{ l, xs = &out, pats = list::items{ list = ps }, body = bool_block{ &l, value = true } }
        if not all { add_arm{ l, xs = &out, pats = slice::empty(ir::Pat){}, body = bool_block{ &l, value = false } } }
        return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = scrut }, through = false, arms = list::items{ list = out } } }
    }

    // A value block of a bool alone.
    fn bool_block { mut l: Lower, value: bool } -> ir::Block {
        let x = mk{ ty = tid{ &l, t = types::BOOL }, k = ir::ExprKind::boolean{ value } }
        return ir::Block{ stmts = slice::empty(ir::Stmt){}, result = box{ l, e = x } }
    }

    // Whether one of pats names variant `name`.
    fn has_pat { pats: []syntax::Pattern, name: []u8 } -> bool {
        return pat_named{ pats, name } != null
    }

    // The one of pats that names variant `name`, if any.
    fn pat_named { pats: []syntax::Pattern, name: []u8 } -> ?syntax::Pattern {
        let mut i: usize = 0
        while i < pats.len {
            if slice::eq_bytes{ a = pats[i].variant.text, b = name } { return pats[i] }
            i = i + 1
        }
        return null
    }

    // An array literal, `[a, b]` or `[x; N]`, as an array value of type t.
    fn array_ex { mut l: Lower, e: syntax::Expr, t: Id } -> ir::Expr {
        let ty = tid{ &l, t }
        let et = elem_of{ l, t }
        match e.k {
            array{ elems } => {
                let mut out = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
                let mut i: usize = 0
                while i < elems.len {
                    let x = conv{ &l, e = elems[i], to = et }
                    try! list::push{ list = &out, item = x }
                    i = i + 1
                }
                return mk{ ty, k = ir::ExprKind::array{ elems = list::items{ list = out } } }
            }
            repeat{ elem } => { return mk{ ty, k = ir::ExprKind::repeat{ elem = box{ l, e = conv{ &l, e = elem.*, to = et } } } } }
            else => { @panic("lower: not an array literal") }
        }
    }

    // An array literal that is a view, of slice type t, of its array (check::View): a static
    // array's view as the checker folded it (value), or a view of a hidden local that is set to
    // the array each time the literal runs, `(with SLOT ARRAY VIEW)`.
    fn view_ex { mut l: Lower, e: syntax::Expr, t: Id } -> ir::Expr {
        let w = map::get{ m = l.c.views, key = check::expr_key{ e } } ifnull { @panic("lower: not a view") }
        if w.local == NONE {
            let v = check::fold_view{ c = l.c, e } ifnull {
                l.failed = true
                return value{ &l, v = check::Val::nil{ ty = t } }
            }
            return value{ &l, v }
        }
        let at = T{ &l, t = w.array }
        let a = tid{ &l, t = at }
        let s = temp{ &l, ty = a }
        let local = mk{ ty = a, k = ir::ExprKind::local{ slot = s } }
        let view = to_slice{ &l, t, p = first_of{ &l, place = local, array = at, t }, n = array_len{ l, t = at } }
        let ty = tid{ &l, t }
        return mk{ ty, k = ir::ExprKind::with{ slot = s, init = box{ l, e = array_ex{ &l, e, t = at } }, body = box{ l, e = view } } }
    }

    // A pointer to the first element of `place`, an array of type `array`, as one to an element
    // of slice type t: the array's address, cast.
    fn first_of { mut l: Lower, place: ir::Expr, array: Id, t: Id } -> ir::Expr {
        let pa = tid{ &l, t = types::ptr{ s = &l.c.ty, elem = array, mutable = false } }
        let pe = tid{ &l, t = types::ptr{ s = &l.c.ty, elem = slice_elem{ l, t }, mutable = false } }
        let a = mk{ ty = pa, k = ir::ExprKind::addr{ place = box{ l, e = place } } }
        return mk{ ty = pe, k = ir::ExprKind::cast{ e = box{ l, e = a } } }
    }

    // A string literal: what its conversion gave it while compiling (spec §18), or a [N]u8
    // array, or a view of static bytes as a []u8 or a strlit.
    fn str_lit { mut l: Lower, e: syntax::Expr, bytes: []u8, t: Id } -> ir::Expr {
        if map::has{ m = l.c.lit_convs, key = check::expr_key{ e } } {
            let v = check::literal_value{ c = l.c, e } ifnull {
                l.failed = true
                return value{ &l, v = check::Val::nil{ ty = t } }
            }
            return value{ &l, v }
        }
        match get{ l, t } {
            array => { return mk{ ty = tid{ &l, t }, k = ir::ExprKind::str{ bytes } } }
            slice | strlit => { return mk{ ty = tid{ &l, t = u8_slice{ &l } }, k = ir::ExprKind::sbytes{ bytes } } }
            else => { @panic("lower: a string literal of a type a literal can't be") }
        }
    }

    fn u8_slice { mut l: Lower } -> Id {
        return types::slice{ s = &l.c.ty, elem = types::U8, mutable = false }
    }

    // Const d's value, of type t: a reference to it if it is an aggregate, else the value itself.
    fn const_ex { mut l: Lower, d: u32, t: Id, at: source::Span } -> ir::Expr {
        if get{ l, t } is array | record | sum | opt | slice {
            let ty = tid{ &l, t }
            return mk{ ty, k = ir::ExprKind::constref{ id = const_id{ &l, d, at } } }
        }
        // An integer const's name that converted has the type it converted to (check::const_as).
        let v = const_val{ &l, d, at }
        if v is int{ negative, magnitude } and get{ l, t } is prim { return value{ &l, v = check::Val::int{ ty = t, negative, magnitude } } }
        return value{ &l, v }
    }

    fn path_ex { mut l: Lower, e: syntax::Expr, t: Id } -> ir::Expr {
        let r = nodes::get{ m = l.c.refs, key = check::expr_key{ e } }
        if r == null { @panic("lower: a path that didn't resolve") }
        match r {
            local{ var } => { return var_ex{ &l, v = var, at = check::expr_at{ e } } }
            func{ decl, targs } => {
                let ty = tid{ &l, t }
                let ts = T_all{ &l, ts = targs }
                return mk{ ty, k = ir::ExprKind::fnref{ callee = fn_id{ &l, decl, targs = ts } } }
            }
            constant{ decl } => { return const_ex{ &l, d = decl, t, at = check::expr_at{ e } } }
            enumval{ ty, index } => {
                let d = enum_decl{ l, t = ty }
                let v = check::get_decl{ c = l.c.*, d }.values[index]
                return mk{ ty = tid{ &l, t }, k = ir::ExprKind::int{ negative = v < 0, value = check::magnitude{ v } } }
            }
            variant{ index } => {
                return mk{ ty = tid{ &l, t }, k = ir::ExprKind::variant{ index, items = slice::empty(ir::Arg){} } }
            }
            // An error alone: the one variant of its set.
            fault => { return mk{ ty = tid{ &l, t }, k = ir::ExprKind::variant{ index = 0, items = slice::empty(ir::Arg){} } } }
            path => { @panic("lower: a type as a value") }
        }
    }

    fn enum_decl { l: Lower, t: Id } -> u32 {
        match get{ l, t } { enumeration{ decl } => { return decl } else => { @panic("lower: not an enum") } }
    }

    fn T_all { mut l: Lower, ts: []Id } -> []Id {
        let mut out = list::new(Id){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < ts.len {
            let x = T{ &l, t = ts[i] }
            try! list::push{ list = &out, item = x }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // The id of an array, struct or union const's item, lowered the first time it is met.
    fn const_id { mut l: Lower, d: u32, at: source::Span } -> u32 {
        let known = map::get{ m = l.const_ids, key = d }
        if known != null { return known }
        let i = @as(u32, l.consts.len)
        let x = check::get_decl{ c = l.c.*, d }
        let placeholder = ir::Const{ name = x.qual, ty = 0, value = mk{ ty = 0, k = ir::ExprKind::nil } }
        try! map::put{ m = &l.const_ids, key = d, value = i }
        try! list::push{ list = &l.consts, item = placeholder }
        let t = T{ &l, t = x.ty }
        let ty = tid{ &l, t }
        let v = value{ &l, v = const_val{ &l, d, at } }
        list::items{ list = l.consts }[i] = ir::Const{ name = x.qual, ty, value = v }
        return i
    }

    // The id of C variable `name` (§15) of capability t, or of the one t points to, given the
    // first time it is met.
    fn var_id { mut l: Lower, t: Id, name: []u8 } -> u32 {
        let mut ct = t
        if get{ l, t } is ptr{ elem } { ct = elem }
        let v = check::cap_var{ c = l.c.*, t = ct, name } ifnull { @panic("lower: no such C variable") }
        let vs = list::items{ list = l.vars }
        let owners = list::items{ list = l.var_owners }
        let mut i: usize = 0
        while i < vs.len {
            if owners[i] == v.owner and slice::eq_bytes{ a = vs[i].name, b = name } { return @as(u32, i) }
            i = i + 1
        }
        let ty = tid{ &l, t = T{ &l, t = v.ty } }
        try! list::push{ list = &l.vars, item = ir::Var{ name = v.name, symbol = check::var_symbol{ c = l.c.*, v }, ty } }
        try! list::push{ list = &l.var_owners, item = v.owner }
        reach_links{ &l, d = v.owner }
        return @as(u32, vs.len)
    }

    // The id of a capability's static (§15, rule 13) of capability t, or of the one t points to,
    // given the first time it is met.
    fn static_id { mut l: Lower, t: Id, name: []u8 } -> u32 {
        let mut ct = t
        if get{ l, t } is ptr{ elem } { ct = elem }
        let v = check::cap_var{ c = l.c.*, t = ct, name } ifnull { @panic("lower: no such static") }
        return static_of{ &l, v }
    }

    fn static_of { mut l: Lower, v: check::CVar } -> u32 {
        let owners = list::items{ list = l.static_owners }
        let names = list::items{ list = l.static_names }
        let mut i: usize = 0
        while i < owners.len {
            if owners[i] == v.owner and slice::eq_bytes{ a = names[i], b = v.name } { return @as(u32, i) }
            i = i + 1
        }
        let ty = tid{ &l, t = T{ &l, t = v.ty } }
        let mut b = utf8::builder{ realloc = arena::alloc, heap = l.heap }
        try! @fmt(&b, "{}::{}", utf8::String{ bytes = check::get_decl{ c = l.c.*, d = v.owner }.qual }, utf8::String{ bytes = v.name })
        try! list::push{ list = &l.statics, item = ir::Static{ name = utf8::view{ b }.bytes, ty, local = check::thread_local{ c = l.c.*, v } } }
        try! list::push{ list = &l.static_owners, item = v.owner }
        try! list::push{ list = &l.static_names, item = v.name }
        return @as(u32, owners.len)
    }

    // Const d's value, used at `at`. An evaluated const's is computed here the first time
    // (check's const_value), while another const's initializer is lowered; if it has none, the
    // lowering has failed, and the value is a stand-in.
    fn const_val { mut l: Lower, d: u32, at: source::Span } -> check::Val {
        let v = check::const_value{ c = l.c, d, at } ifnull {
            l.failed = true
            return check::Val::nil{ ty = check::get_decl{ c = l.c.*, d }.ty }
        }
        return v
    }

    // A const's value, which the checker computed, as literals.
    fn value { mut l: Lower, v: check::Val } -> ir::Expr {
        match v {
            int{ ty, negative, magnitude } => { return mk{ ty = tid{ &l, t = ty }, k = ir::ExprKind::int{ negative, value = magnitude } } }
            float{ ty, value = x } => { return mk{ ty = tid{ &l, t = ty }, k = ir::ExprKind::float{ value = x } } }
            boolean{ ty, value = x } => { return mk{ ty = tid{ &l, t = ty }, k = ir::ExprKind::boolean{ value = x } } }
            str{ ty, bytes } => { return mk{ ty = tid{ &l, t = ty }, k = ir::ExprKind::str{ bytes } } }
            sbytes{ ty, bytes } => { return mk{ ty = tid{ &l, t = ty }, k = ir::ExprKind::sbytes{ bytes } } }
            cstr{ ty, bytes } => { return mk{ ty = tid{ &l, t = ty }, k = ir::ExprKind::cstr{ bytes } } }
            nil{ ty } => { return mk{ ty = tid{ &l, t = ty }, k = ir::ExprKind::nil } }
            // A slice's zero value: a record of its pointer and length that sets neither.
            empty{ ty } => { return mk{ ty = tid{ &l, t = ty }, k = ir::ExprKind::record{ items = slice::empty(ir::Arg){} } } }
            record{ ty, fields } => {
                let id = tid{ &l, t = ty }
                return mk{ ty = id, k = ir::ExprKind::record{ items = value_args{ &l, xs = fields } } }
            }
            variant{ ty, index, fields } => {
                let id = tid{ &l, t = ty }
                return mk{ ty = id, k = ir::ExprKind::variant{ index, items = value_args{ &l, xs = fields } } }
            }
            array{ ty, elems } => {
                let id = tid{ &l, t = ty }
                let mut out = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
                let mut i: usize = 0
                while i < elems.len {
                    let x = value{ &l, v = elems[i] }
                    try! list::push{ list = &out, item = x }
                    i = i + 1
                }
                return mk{ ty = id, k = ir::ExprKind::array{ elems = list::items{ list = out } } }
            }
            repeat{ ty, elem } => {
                let id = tid{ &l, t = ty }
                return mk{ ty = id, k = ir::ExprKind::repeat{ elem = box{ l, e = value{ &l, v = elem.* } } } }
            }
            // An array literal's static view: its array is a const of its own, which the view
            // points into, as a const array's does (§12, Slices).
            view{ ty, array } => {
                let x = value{ &l, v = array.* }
                let at = match array.* {
                    array{ ty = a } | repeat{ ty = a } => { a }
                    else => { @panic("lower: a view of a non-array") }
                }
                let id = @as(u32, l.consts.len)
                try! list::push{ list = &l.consts, item = ir::Const{ name = "array literal", ty = x.ty, value = x } }
                let place = mk{ ty = x.ty, k = ir::ExprKind::constref{ id } }
                return to_slice{ &l, t = ty, p = first_of{ &l, place, array = at, t = ty }, n = array_len{ l, t = at } }
            }
        }
    }

    // A struct's or variant's field values as ARGs, in field order.
    fn value_args { mut l: Lower, xs: []check::Val } -> []ir::Arg {
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < xs.len {
            let x = value{ &l, v = xs[i] }
            add_arg{ xs = &out, a = ir::Arg{ index = @as(u32, i), value = x } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn field_ex { mut l: Lower, e: syntax::Expr, base: syntax::Expr, name: syntax::Name, t: Id } -> ir::Expr {
        let bt = T{ &l, t = check::type_of_expr{ c = l.c.*, e = base } }
        let a = check::access_of{ c = l.c.*, e }
        if a is field {
            let narrow = map::get{ m = l.c.narrowed, key = check::expr_key{ e } }
            if narrow != null {
                let nt = tid{ &l, t = T{ &l, t = narrow } }
                let b = ex{ &l, e = base }
                let f = mk{ ty = nt, k = ir::ExprKind::field{ base = box{ l, e = b }, index = field_index{ &l, t = bt, name = name.text } } }
                return mk{ ty = tid{ &l, t }, k = ir::ExprKind::payload{ base = box{ l, e = f }, variant = 1, field = 0 } }
            }
            let ty = tid{ &l, t }
            let b = ex{ &l, e = base }
            return mk{ ty, k = ir::ExprKind::field{ base = box{ l, e = b }, index = field_index{ &l, t = bt, name = name.text } } }
        }
        if a is pfield {
            let elem = ptr_elem{ l, t = bt }
            let et = tid{ &l, t = elem }
            let b = ex{ &l, e = base }
            let d = mk{ ty = et, k = ir::ExprKind::deref{ ptr = box{ l, e = b }, pos = epos{ &l, e } } }
            let ty = tid{ &l, t }
            return mk{ ty, k = ir::ExprKind::field{ base = box{ l, e = d }, index = field_index{ &l, t = elem, name = name.text } } }
        }
        // A capability's C variable: its value, after evaluating the base unless it is a name.
        if a is cvar {
            let ty = tid{ &l, t }
            let v = mk{ ty, k = ir::ExprKind::cvar{ id = var_id{ &l, t = bt, name = name.text } } }
            if base.k is path { return v }
            let b = ex{ &l, e = base }
            return mk{ ty, k = ir::ExprKind::seq{ first = box{ l, e = b }, then = box{ l, e = v } } }
        }
        // A capability's static: the place its address points to, after evaluating the base
        // unless it is a name.
        if a is stat {
            let ty = tid{ &l, t }
            let pt = tid{ &l, t = types::ptr{ s = &l.c.ty, elem = t, mutable = true } }
            let p = mk{ ty = pt, k = ir::ExprKind::saddr{ id = static_id{ &l, t = bt, name = name.text } } }
            let place = mk{ ty, k = ir::ExprKind::deref{ ptr = box{ l, e = p }, pos = epos{ &l, e } } }
            if base.k is path { return place }
            let b = ex{ &l, e = base }
            let first = mk{ ty = pt, k = ir::ExprKind::seq{ first = box{ l, e = b }, then = box{ l, e = p } } }
            return mk{ ty, k = ir::ExprKind::deref{ ptr = box{ l, e = first }, pos = epos{ &l, e } } }
        }
        // A strlit's bytes: the strlit itself, which is a []u8 in the IR.
        if a is lit { return ex{ &l, e = base } }
        let is_ptr = a is sptr
        if is_ptr or a is slen {
            let ty = tid{ &l, t }
            let b = ex{ &l, e = base }
            return mk{ ty, k = ir::ExprKind::field{ base = box{ l, e = b }, index = if is_ptr { 0 } else { 1 } } }
        }
        // `.len` of an array or of a pointer to one: its length, after evaluating the base
        // unless it is a name.
        let is_len = a is len
        let n = if is_len { array_len{ l, t = bt } } else { array_len{ l, t = ptr_elem{ l, t = bt } } }
        let lit = int_lit{ &l, t = types::USIZE, n }
        if is_len and base.k is path { return lit }
        let ty = tid{ &l, t = types::USIZE }
        let b = ex{ &l, e = base }
        return mk{ ty, k = ir::ExprKind::seq{ first = box{ l, e = b }, then = box{ l, e = lit } } }
    }

    fn field_index { mut l: Lower, t: Id, name: []u8 } -> u32 {
        let fs = check::struct_fields{ c = l.c, t = types::prune{ s = l.c.ty, t } }
        let mut i: usize = 0
        while i < fs.len {
            if slice::eq_bytes{ a = fs[i].name, b = name } { return @as(u32, i) }
            i = i + 1
        }
        @panic("lower: no such field")
    }

    fn index_ex { mut l: Lower, e: syntax::Expr, base: syntax::Expr, i: syntax::Expr, t: Id } -> ir::Expr {
        let bt = T{ &l, t = check::type_of_expr{ c = l.c.*, e = base } }
        // An index keeps its integer type, which the check takes as it is (§12, Arrays).
        let ix = ex{ &l, e = i }
        let p = epos{ &l, e }
        let a = check::access_of{ c = l.c.*, e }
        if a is arr {
            let ty = tid{ &l, t }
            let b = ex{ &l, e = base }
            return mk{ ty, k = ir::ExprKind::index{ base = box{ l, e = b }, i = box{ l, e = ix }, pos = p } }
        }
        if a is parr {
            let at = tid{ &l, t = ptr_elem{ l, t = bt } }
            let b = ex{ &l, e = base }
            let arr = mk{ ty = at, k = ir::ExprKind::deref{ ptr = box{ l, e = b }, pos = p } }
            let ty = tid{ &l, t }
            return mk{ ty, k = ir::ExprKind::index{ base = box{ l, e = arr }, i = box{ l, e = ix }, pos = p } }
        }
        if a is slice {
            let ty = tid{ &l, t }
            let b = ex{ &l, e = base }
            return mk{ ty, k = ir::ExprKind::sindex{ base = box{ l, e = b }, i = box{ l, e = ix }, pos = p } }
        }
        // The checker rejects an index on any other pointer (spec §12, Pointers, rule 5).
        @panic("lower: an index on a pointer")
    }

    fn binary { mut l: Lower, e: syntax::Expr, op: tok::Kind, a: syntax::Expr, b: syntax::Expr, t: Id } -> ir::Expr {
        if op == tok::Kind::kw_and or op == tok::Kind::kw_or {
            let ty = tid{ &l, t }
            let x = ex{ &l, e = a }
            let y = ex{ &l, e = b }
            if op == tok::Kind::kw_and { return mk{ ty, k = ir::ExprKind::land{ a = box{ l, e = x }, b = box{ l, e = y } } } }
            return mk{ ty, k = ir::ExprKind::lor{ a = box{ l, e = x }, b = box{ l, e = y } } }
        }
        if op == tok::Kind::eq or op == tok::Kind::ne {
            let an = check::is_null{ e = a }
            if an or check::is_null{ e = b } {
                let ty = tid{ &l, t }
                let x = ex{ &l, e = if an { b } else { a } }
                if op == tok::Kind::eq { return mk{ ty, k = ir::ExprKind::isnull{ e = box{ l, e = x } } } }
                return mk{ ty, k = ir::ExprKind::notnull{ e = box{ l, e = x } } }
            }
            if get{ l, t = after{ &l, e = a } } is opt or get{ l, t = after{ &l, e = b } } is opt { return opt_eq{ &l, op, a, b, t } }
        }
        let cmp = cmp_op{ op }
        if cmp != null {
            let lt = T{ &l, t = check::type_of_expr{ c = l.c.*, e = a } }
            let rt = T{ &l, t = check::type_of_expr{ c = l.c.*, e = b } }
            let common = if prims_widen{ &l, a = lt, b = rt } { rt } else { lt }
            let ty = tid{ &l, t }
            let x = conv{ &l, e = a, to = common }
            let y = conv{ &l, e = b, to = common }
            if (op == tok::Kind::eq or op == tok::Kind::ne) and not compared_whole{ &l, t = common } {
                let r = same{ &l, t = common, a = x, b = y }
                if op == tok::Kind::ne { return mk{ ty, k = ir::ExprKind::lnot{ e = box{ l, e = r } } } }
                return r
            }
            return mk{ ty, k = ir::ExprKind::cmp{ op = cmp, a = box{ l, e = x }, b = box{ l, e = y } } }
        }
        if get{ l, t = check::type_of_expr{ c = l.c.*, e = a } } is ptr {
            let ty = tid{ &l, t }
            let x = ex{ &l, e = a }
            let y = conv{ &l, e = b, to = types::USIZE }
            return mk{ ty, k = ir::ExprKind::ptradd{ p = box{ l, e = x }, n = box{ l, e = y } } }
        }
        if op == tok::Kind::amp or op == tok::Kind::pipe or op == tok::Kind::caret {
            let ty = tid{ &l, t }
            let x = conv{ &l, e = a, to = t }
            let y = conv{ &l, e = b, to = t }
            let bop = if op == tok::Kind::amp { ir::BitOp::bit_and } else if op == tok::Kind::pipe { ir::BitOp::bit_or } else { ir::BitOp::bit_xor }
            return mk{ ty, k = ir::ExprKind::bits{ op = bop, a = box{ l, e = x }, b = box{ l, e = y } } }
        }
        if op == tok::Kind::shl or op == tok::Kind::shr or op == tok::Kind::shl_wrap {
            let ty = tid{ &l, t }
            let x = conv{ &l, e = a, to = t }
            let y = ex{ &l, e = b }
            let sop = if op == tok::Kind::shl { ir::ShiftOp::shl } else if op == tok::Kind::shr { ir::ShiftOp::shr } else { ir::ShiftOp::wrap_shl }
            return mk{ ty, k = ir::ExprKind::shift{ op = sop, a = box{ l, e = x }, b = box{ l, e = y }, pos = epos{ &l, e } } }
        }
        let ty = tid{ &l, t }
        let x = conv{ &l, e = a, to = t }
        let y = conv{ &l, e = b, to = t }
        if check::wrapping{ op } { return mk{ ty, k = ir::ExprKind::wrap{ op = arith_op{ op }, a = box{ l, e = x }, b = box{ l, e = y } } } }
        return mk{ ty, k = ir::ExprKind::arith{ op = arith_op{ op }, a = box{ l, e = x }, b = box{ l, e = y }, pos = epos{ &l, e }, trap = trap_of{ l, e } } }
    }

    // `a == b` or `a != b` with a ?T on one side or both (§11, Expressions, rule 5): equal when
    // both hold equal values, or both are null. A `?*T` is its pointer, null 0, so comparing
    // the pointers is enough. Any other optional is tested and its value read, so the operands
    // are held in temporaries, a's first, unless reading them again is plain.
    fn opt_eq { mut l: Lower, op: tok::Kind, a: syntax::Expr, b: syntax::Expr, t: Id } -> ir::Expr {
        let ty = tid{ &l, t }
        let at = after{ &l, e = a }
        let bt = after{ &l, e = b }
        let ao = get{ l, t = at } is opt
        let bo = get{ l, t = bt } is opt
        let pa = if ao { opt_elem{ l, t = at } } else { at }
        let pb = if bo { opt_elem{ l, t = bt } } else { bt }
        let common = if prims_widen{ &l, a = pa, b = pb } { pb } else { pa }
        let xa = ex{ &l, e = a }
        let xb = ex{ &l, e = b }
        let tagged = (ao and not is_nptr{ l, x = xa }) or (bo and not is_nptr{ l, x = xb })
        let sa = if tagged and not (plain{ x = xa } and plain{ x = xb }) { temp{ &l, ty = xa.ty } } else { NONE }
        let sb = if tagged and not plain{ x = xb } { temp{ &l, ty = xb.ty } } else { NONE }
        let ra = if sa == NONE { xa } else { mk{ ty = xa.ty, k = ir::ExprKind::local{ slot = sa } } }
        let rb = if sb == NONE { xb } else { mk{ ty = xb.ty, k = ir::ExprKind::local{ slot = sb } } }
        let va = coerce{ &l, x = if ao { payload_of{ &l, x = ra, t = pa } } else { ra }, frm = pa, to = common, at = check::expr_at{ e = a } }
        let vb = coerce{ &l, x = if bo { payload_of{ &l, x = rb, t = pb } } else { rb }, frm = pb, to = common, at = check::expr_at{ e = b } }
        let mut r = same{ &l, t = common, a = va, b = vb }
        if tagged {
            if ao and bo {
                let none_a = test_null{ &l, x = ra, holds = false }
                let none = mk{ ty, k = ir::ExprKind::land{ a = box{ l, e = none_a }, b = box{ l, e = test_null{ &l, x = rb, holds = false } } } }
                let some_a = test_null{ &l, x = ra, holds = true }
                let some = mk{ ty, k = ir::ExprKind::land{ a = box{ l, e = some_a }, b = box{ l, e = test_null{ &l, x = rb, holds = true } } } }
                r = mk{ ty, k = ir::ExprKind::lor{ a = box{ l, e = none }, b = box{ l, e = mk{ ty, k = ir::ExprKind::land{ a = box{ l, e = some }, b = box{ l, e = r } } } } } }
            } else {
                r = mk{ ty, k = ir::ExprKind::land{ a = box{ l, e = test_null{ &l, x = if ao { ra } else { rb }, holds = true } }, b = box{ l, e = r } } }
            }
        }
        if op == tok::Kind::ne { r = mk{ ty, k = ir::ExprKind::lnot{ e = box{ l, e = r } } } }
        if sb != NONE { r = mk{ ty, k = ir::ExprKind::with{ slot = sb, init = box{ l, e = xb }, body = box{ l, e = r } } } }
        if sa != NONE { r = mk{ ty, k = ir::ExprKind::with{ slot = sa, init = box{ l, e = xa }, body = box{ l, e = r } } } }
        return r
    }

    // The value optional x holds, of type t, where it is known to hold one.
    fn payload_of { mut l: Lower, x: ir::Expr, t: Id } -> ir::Expr {
        return mk{ ty = tid{ &l, t }, k = ir::ExprKind::payload{ base = box{ l, e = x }, variant = 1, field = 0 } }
    }

    // Whether optional x holds a value, or with holds false, whether it is null.
    fn test_null { mut l: Lower, x: ir::Expr, holds: bool } -> ir::Expr {
        let ty = tid{ &l, t = types::BOOL }
        if holds { return mk{ ty, k = ir::ExprKind::notnull{ e = box{ l, e = x } } } }
        return mk{ ty, k = ir::ExprKind::isnull{ e = box{ l, e = x } } }
    }

    // Whether x, an optional, is a `?*T`: its pointer, with null 0 (§8, Optional, rule 6).
    fn is_nptr { l: Lower, x: ir::Expr } -> bool {
        return list::items{ list = l.types }[x.ty] is nptr
    }

    // Whether prim a widens to prim b (ctxi's widens, on two operands of a comparison).
    fn prims_widen { mut l: Lower, a: Id, b: Id } -> bool {
        return types::widens{ s = &l.c.ty, a, b }
    }

    fn cmp_op { op: tok::Kind } -> ?ir::CmpOp {
        if op == tok::Kind::eq { return ir::CmpOp::eq }
        if op == tok::Kind::ne { return ir::CmpOp::ne }
        if op == tok::Kind::lt { return ir::CmpOp::lt }
        if op == tok::Kind::le { return ir::CmpOp::le }
        if op == tok::Kind::gt { return ir::CmpOp::gt }
        if op == tok::Kind::ge { return ir::CmpOp::ge }
        return null
    }

    fn arith_op { op: tok::Kind } -> ir::ArithOp {
        if op == tok::Kind::plus or op == tok::Kind::plus_wrap { return ir::ArithOp::add }
        if op == tok::Kind::minus or op == tok::Kind::minus_wrap { return ir::ArithOp::sub }
        if op == tok::Kind::star or op == tok::Kind::star_wrap { return ir::ArithOp::mul }
        if op == tok::Kind::slash { return ir::ArithOp::div }
        return ir::ArithOp::rem
    }

    // ---- braces: literals, calls and binds

    fn braced { mut l: Lower, e: syntax::Expr, callee: syntax::Expr, items: []syntax::Item, bind: bool, t: Id } -> ir::Expr {
        let k = check::expr_key{ e }
        let lit = map::get{ m = l.c.literal, key = k }
        let r = nodes::get{ m = l.c.refs, key = check::expr_key{ e = callee } }
        if lit != null and lit {
            if r != null {
                match r {
                    variant{ index } => {
                        let fields = check::variants_of{ c = l.c, t = types::prune{ s = l.c.ty, t } }[index].fields
                        let ty = tid{ &l, t }
                        let fs: []types::Field = if fields == null { slice::empty(types::Field){} } else { fields }
                        return mk{ ty, k = ir::ExprKind::variant{ index, items = item_args{ &l, e, items, fields = fs, ptrs = false } } }
                    }
                    fault{ decl } => {
                        let fs = check::fault_fields{ c = l.c.*, d = decl } ifnull { slice::empty(types::Field){} }
                        let ty = tid{ &l, t }
                        return mk{ ty, k = ir::ExprKind::variant{ index = 0, items = item_args{ &l, e, items, fields = fs, ptrs = false } } }
                    }
                    else => {}
                }
            }
            let fields = check::struct_fields{ c = l.c, t = types::prune{ s = l.c.ty, t } }
            let ty = tid{ &l, t }
            if has_spread{ items } { return spread_lit{ &l, e, items, fields, ty } }
            let args = item_args{ &l, e, items, fields, ptrs = false }
            return mk{ ty, k = ir::ExprKind::record{ items = default_args{ &l, e, t, fields, args } } }
        }
        if r is func{ decl, targs } {
            let ts = T_all{ &l, ts = targs }
            let x = check::get_decl{ c = l.c.*, d = decl }
            let fields = check::subst_fields{ c = l.c, fields = x.fields, decl, args = ts }
            let fid = fn_id{ &l, decl, targs = ts }
            let ty = tid{ &l, t }
            let args = item_args{ &l, e, items, fields, ptrs = true }
            if bind { return mk{ ty, k = ir::ExprKind::bind{ callee = fid, args } } }
            let at = epos{ &l, e }
            let lent = check::lent_fns{ c = l.c.*, d = decl }
            if lent.len > 0 { return mk{ ty, k = ir::ExprKind::call{ callee = fid, args = task_record{ &l, lent, args, at }, pos = at } } }
            return mk{ ty, k = ir::ExprKind::call{ callee = fid, args, pos = at } }
        }
        let ft = T{ &l, t = check::type_of_expr{ c = l.c.*, e = callee } }
        let mut fields: []types::Field = slice::empty(types::Field){}
        if get{ l, t = ft } is func{ fields = fs, external } { fields = if external { fs } else { sorted_fields{ l, fields = fs } } }
        let ty = tid{ &l, t }
        let c = ex{ &l, e = callee }
        let args = item_args{ &l, e, items, fields, ptrs = true }
        if bind { return mk{ ty, k = ir::ExprKind::dbind{ callee = box{ l, e = c }, args } } }
        return mk{ ty, k = ir::ExprKind::dcall{ callee = box{ l, e = c }, args, pos = epos{ &l, e } } }
    }

    // A struct literal's args, then those of the fields its `..` takes from their defaults (§7):
    // each its default's const.
    fn default_args { mut l: Lower, e: syntax::Expr, t: Id, fields: []types::Field, args: []ir::Arg } -> []ir::Arg {
        let filled = map::get{ m = l.c.filled, key = check::expr_key{ e } } ifnull { return args }
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < args.len {
            add_arg{ xs = &out, a = args[i] }
            i = i + 1
        }
        i = 0
        while i < filled.len {
            let fi = @as(usize, filled[i])
            let d = check::field_default{ c = l.c.*, t, i = fi }
            let x = const_ex{ &l, d, t = fields[fi].ty, at = check::expr_at{ e } }
            add_arg{ xs = &out, a = ir::Arg{ index = filled[i], value = x } }
            i = i + 1
        }
        return list::items{ list = out }
    }

    fn has_spread { items: []syntax::Item } -> bool {
        let mut i: usize = 0
        while i < items.len {
            if items[i].spread { return true }
            i = i + 1
        }
        return false
    }

    // A capability's literal with spreads (§15): each `..e` gives the fields of e's capability,
    // read from e, which a new local holds first unless it is a plain place. Those are set
    // before the literal's other items are evaluated.
    fn spread_lit { mut l: Lower, e: syntax::Expr, items: []syntax::Item, fields: []types::Field, ty: u32 } -> ir::Expr {
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        let mut slots = list::new(u32){ realloc = arena::alloc, heap = l.heap }
        let mut inits = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < items.len {
            if items[i].spread {
                let st = T{ &l, t = check::type_of_expr{ c = l.c.*, e = items[i].value } }
                let mut src = ex{ &l, e = items[i].value }
                if not plain{ x = src } {
                    let s = temp{ &l, ty = src.ty }
                    try! list::push{ list = &slots, item = s }
                    try! list::push{ list = &inits, item = src }
                    src = mk{ ty = src.ty, k = ir::ExprKind::local{ slot = s } }
                }
                cap_args{ &l, src, frm = st, names = check::cap_fields{ c = l.c.*, t = st }, into = fields, out = &out }
            }
            i = i + 1
        }
        let named = item_args{ &l, e, items, fields, ptrs = false }
        i = 0
        while i < named.len {
            add_arg{ xs = &out, a = named[i] }
            i = i + 1
        }
        let mut r = mk{ ty, k = ir::ExprKind::record{ items = list::items{ list = out } } }
        let ss = list::items{ list = slots }
        let xs = list::items{ list = inits }
        let mut k = ss.len
        while k > 0 {
            k = k - 1
            r = mk{ ty, k = ir::ExprKind::with{ slot = ss[k], init = box{ l, e = xs[k] }, body = box{ l, e = r } } }
        }
        return r
    }

    // The ARGs of a literal's or call's items but its spreads, then of what `..` supplies: each
    // converted to its field's type, a pointer to it for a call's `mut` field (ptrs).
    fn item_args { mut l: Lower, e: syntax::Expr, items: []syntax::Item, fields: []types::Field, ptrs: bool } -> []ir::Arg {
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < items.len {
            if not items[i].spread {
                let fi = field_pos{ fields, name = items[i].name.text }
                let x = conv{ &l, e = items[i].value, to = arg_type{ &l, f = fields[fi], ptrs } }
                add_arg{ xs = &out, a = ir::Arg{ index = @as(u32, fi), value = x } }
            }
            i = i + 1
        }
        let fw = map::get{ m = l.c.forwards, key = check::expr_key{ e } }
        if fw != null {
            let at = check::expr_at{ e }
            i = 0
            while i < fw.len {
                let f = fw[i]
                let fi = field_pos{ fields, name = f.name }
                let x = forwarded{ &l, f, at, to = arg_type{ &l, f = fields[fi], ptrs } }
                add_arg{ xs = &out, a = ir::Arg{ index = @as(u32, fi), value = x } }
                i = i + 1
            }
        }
        return list::items{ list = out }
    }

    fn arg_type { mut l: Lower, f: types::Field, ptrs: bool } -> Id {
        if ptrs and f.mutable { return types::ptr{ s = &l.c.ty, elem = f.ty, mutable = false } }
        return f.ty
    }

    fn field_pos { fields: []types::Field, name: []u8 } -> usize {
        return types::field_index{ fields, name } ifnull { @panic("lower: an argument for no field") }
    }

    // What `..` supplies: the local of the field's name, or its address for a `mut` field, as
    // ctxi's synthesized path or `&path`, converted to the field's type.
    fn forwarded { mut l: Lower, f: check::Forward, at: source::Span, to: Id } -> ir::Expr {
        let mut x = ir::Expr{ ty = 0, k = ir::ExprKind::nil }
        let mut xt = T{ &l, t = f.ty }
        if f.mutable {
            xt = T{ &l, t = f.arg }
            let ty = tid{ &l, t = xt }
            let v = var_ex{ &l, v = f.var, at }
            x = mk{ ty, k = ir::ExprKind::addr{ place = box{ l, e = v } } }
        } else {
            x = var_ex{ &l, v = f.var, at }
        }
        let conv = f.conv
        if conv != null {
            match conv {
                some{ to = st } => {
                    let t = T{ &l, t = st }
                    let inner = coerce{ &l, x, frm = xt, to = opt_elem{ l, t }, at }
                    x = mk{ ty = tid{ &l, t }, k = ir::ExprKind::some{ e = box{ l, e = inner } } }
                    xt = t
                }
                else => { @panic("lower: a forwarded slice") }
            }
        }
        return coerce{ &l, x, frm = xt, to = T{ &l, t = to }, at }
    }

    // ---- builtins

    fn builtin { mut l: Lower, e: syntax::Expr, name: []u8, targ: ?*syntax::TypeExpr, args: []syntax::Expr, t: Id } -> ir::Expr {
        if slice::eq_bytes{ a = name, b = "fmt" } { return fmt{ &l, e, args } }
        if slice::eq_bytes{ a = name, b = "expect" } { return expect{ &l, e, args, hard = false } }
        if slice::eq_bytes{ a = name, b = "require" } { return expect{ &l, e, args, hard = true } }
        if slice::eq_bytes{ a = name, b = "size_of" } or slice::eq_bytes{ a = name, b = "align_of" } {
            let tt = T{ &l, t = targ_type{ l, targ } }
            let lay = check::layout{ c = l.c, t = norm_layout{ &l, t = tt } }
            if lay == null { @panic("lower: @size_of a type without a layout") }
            let n = if slice::eq_bytes{ a = name, b = "size_of" } { lay.size } else { lay.align }
            return int_lit{ &l, t, n }
        }
        if slice::eq_bytes{ a = name, b = "offset_of" } {
            let off = check::offset_of{ c = l.c, t = T{ &l, t = targ_type{ l, targ } }, arg = args[0], report = false }
            if off == null { @panic("lower: @offset_of of no field") }
            return int_lit{ &l, t, n = off }
        }
        if slice::eq_bytes{ a = name, b = "record_size" } {
            let ty = tid{ &l, t }
            return mk{ ty, k = ir::ExprKind::rsize{ e = box{ l, e = ex{ &l, e = args[0] } } } }
        }
        if slice::eq_bytes{ a = name, b = "record_copy" } {
            // The copy, then the entry thunk for run's result type, as a `fn` value.
            let run = ex{ &l, e = args[0] }
            let rt = T{ &l, t = check::type_of_expr{ c = l.c.*, e = args[0] } }
            let func{ ret = r } = get{ l, t = rt } else { @panic("lower: @record_copy of a non-function") }
            let void_ty = tid{ &l, t = types::VOID }
            let copy = mk{ ty = void_ty, k = ir::ExprKind::rcopy{ e = box{ l, e = run }, into = box{ l, e = ex{ &l, e = args[1] } } } }
            let ty = tid{ &l, t }
            let thunk = mk{ ty, k = ir::ExprKind::fnref{ callee = entry_id{ &l, r } } }
            return mk{ ty, k = ir::ExprKind::seq{ first = box{ l, e = copy }, then = box{ l, e = thunk } } }
        }
        if slice::eq_bytes{ a = name, b = "addr" } {
            let ty = tid{ &l, t }
            return mk{ ty, k = ir::ExprKind::ptraddr{ e = box{ l, e = ex{ &l, e = args[0] } } } }
        }
        if slice::eq_bytes{ a = name, b = "cast" } {
            let ty = tid{ &l, t }
            return mk{ ty, k = ir::ExprKind::cast{ e = box{ l, e = ex{ &l, e = args[0] } } } }
        }
        if slice::eq_bytes{ a = name, b = "slice" } {
            let ty = tid{ &l, t }
            let p = ex{ &l, e = args[0] }
            let n = conv{ &l, e = args[1], to = types::USIZE }
            return mk{ ty, k = ir::ExprKind::record{ items = two_args{ l, a = p, b = n } } }
        }
        if slice::eq_bytes{ a = name, b = "as" } {
            let src = T{ &l, t = check::type_of_expr{ c = l.c.*, e = args[0] } }
            if get{ l, t } is enumeration{ decl } { return to_enum{ &l, e, arg = args[0], src, t, decl } }
            if get{ l, t = src } is enumeration{ decl } {
                let base = check::get_decl{ c = l.c.*, d = decl }.ty
                if norm{ &l, t = base } == norm{ &l, t } { return ex{ &l, e = args[0] } }
            }
            // Between a distinct type and its base, erased to one type: nothing to do.
            if norm{ &l, t = src } == norm{ &l, t } { return ex{ &l, e = args[0] } }
            let ty = tid{ &l, t }
            let x = ex{ &l, e = args[0] }
            return mk{ ty, k = ir::ExprKind::convert{ e = box{ l, e = x }, pos = epos{ &l, e }, trap = trap_of{ l, e } } }
        }
        if slice::eq_bytes{ a = name, b = "trunc" } {
            let ty = tid{ &l, t }
            return mk{ ty, k = ir::ExprKind::trunc{ e = box{ l, e = ex{ &l, e = args[0] } } } }
        }
        if check::atomic_name{ n = name } { return atomic{ &l, name, args, t } }
        if slice::eq_bytes{ a = name, b = "hash" } {
            // Folded into the starting value, then stirred so that every bit of the result
            // depends on every bit of the fold: s ^= s >> 32; s *= K; s ^= s >> 29.
            let u64_ty = tid{ &l, t }
            let vt = after{ &l, e = args[0] }
            let folded = hashed{ &l, t = vt, h = mk{ ty = u64_ty, k = ir::ExprKind::int{ negative = false, value = 14695981039346656037 } }, v = ex{ &l, e = args[0] } }
            let s0 = temp{ &l, ty = u64_ty }
            let s1 = temp{ &l, ty = u64_ty }
            let pos = epos{ &l, e }
            let a0 = slot_ex{ ty = u64_ty, slot = s0 }
            let a1 = slot_ex{ ty = u64_ty, slot = s1 }
            let k = mk{ ty = u64_ty, k = ir::ExprKind::int{ negative = false, value = 11400714819323198485 } }
            let x0 = xor_shift{ &l, v = a0, n = 32, pos }
            let stirred = mk{ ty = u64_ty, k = ir::ExprKind::wrap{ op = ir::ArithOp::mul, a = box{ l, e = x0 }, b = box{ l, e = k } } }
            return held{ l, slot = s0, init = folded, body = held{ l, slot = s1, init = stirred, body = xor_shift{ &l, v = a1, n = 29, pos } } }
        }
        if slice::eq_bytes{ a = name, b = "min" } { return min_max{ &l, least = true, a = args[0], b = args[1], t } }
        if slice::eq_bytes{ a = name, b = "max" } { return min_max{ &l, least = false, a = args[0], b = args[1], t } }
        if slice::eq_bytes{ a = name, b = "clamp" } { return clamp{ &l, e, args, t } }
        if check::to_int_name{ n = name } { return to_int{ &l, e, name, arg = args[0], t } }
        @panic("lower: a builtin the parser doesn't know")
    }

    // ---- derived `==` and `@hash` (spec §11, Expressions, rule 5; §13)

    // The site of an instance that is a type's derived `==` or `@hash` fn: its type is entry.
    const DERIVED_EQ: u32 = 0xFFFFFFFC
    const DERIVED_HASH: u32 = 0xFFFFFFFB

    // Whether the IR's `cmp` compares values of t: numbers, bool, enums and pointers. Any other
    // type with `==` is compared by its derived fn.
    fn compared_whole { mut l: Lower, t: Id } -> bool {
        let x = types::undistinct{ s = l.c.ty, t = T{ &l, t } }
        match get{ l, t = x } {
            prim | ptr | enumeration => { return true }
            opt{ elem } => { return get{ l, t = types::undistinct{ s = l.c.ty, t = elem } } is ptr }
            else => { return false }
        }
    }

    // `a == b` for two values of type t.
    fn same { mut l: Lower, t: Id, a: ir::Expr, b: ir::Expr } -> ir::Expr {
        let ty = tid{ &l, t = types::BOOL }
        if compared_whole{ &l, t } { return mk{ ty, k = ir::ExprKind::cmp{ op = ir::CmpOp::eq, a = box{ l, e = a }, b = box{ l, e = b } } } }
        let fid = derived_id{ &l, t, site = DERIVED_EQ }
        return mk{ ty, k = ir::ExprKind::call{ callee = fid, args = two_args{ l, a, b }, pos = nowhere{} } }
    }

    // h with v, a value of type t, folded in: a number, a bool, an enum or a pointer's address
    // as a u64 (`(h ^ n) * prime`, FNV-1a's step over words), and any other type by its
    // derived fn.
    fn hashed { mut l: Lower, t: Id, h: ir::Expr, v: ir::Expr } -> ir::Expr {
        let u64_id = types::prim{ p = types::Prim::u64 }
        let ty = tid{ &l, t = u64_id }
        if not compared_whole{ &l, t } {
            let fid = derived_id{ &l, t, site = DERIVED_HASH }
            return mk{ ty, k = ir::ExprKind::call{ callee = fid, args = two_args{ l, a = h, b = v }, pos = nowhere{} } }
        }
        let x = types::undistinct{ s = l.c.ty, t = T{ &l, t } }
        let mut n = v
        match get{ l, t = x } {
            prim{ p } => {
                if p is bool {
                    let one = mk{ ty, k = ir::ExprKind::int{ negative = false, value = 1 } }
                    n = either{ l, ty, c = v, then = one, els = mk{ ty, k = ir::ExprKind::int{ negative = false, value = 0 } } }
                } else if not (p is u64) {
                    n = mk{ ty, k = ir::ExprKind::trunc{ e = box{ l, e = v } } }
                }
            }
            enumeration => { n = mk{ ty, k = ir::ExprKind::trunc{ e = box{ l, e = v } } } }
            else => {
                let addr = mk{ ty = tid{ &l, t = types::USIZE }, k = ir::ExprKind::ptraddr{ e = box{ l, e = v } } }
                n = mk{ ty, k = ir::ExprKind::trunc{ e = box{ l, e = addr } } }
            }
        }
        return mixed{ &l, h, n }
    }

    // `(h ^ n) *% 1099511628211`, of two u64s.
    fn mixed { mut l: Lower, h: ir::Expr, n: ir::Expr } -> ir::Expr {
        let ty = h.ty
        let x = mk{ ty, k = ir::ExprKind::bits{ op = ir::BitOp::bit_xor, a = box{ l, e = h }, b = box{ l, e = n } } }
        let prime = mk{ ty, k = ir::ExprKind::int{ negative = false, value = 1099511628211 } }
        return mk{ ty, k = ir::ExprKind::wrap{ op = ir::ArithOp::mul, a = box{ l, e = x }, b = box{ l, e = prime } } }
    }

    // `v ^ (v >> n)`, of a u64 that is read twice.
    fn xor_shift { mut l: Lower, v: ir::Expr, n: u64, pos: ir::Pos } -> ir::Expr {
        let ty = v.ty
        let count = mk{ ty, k = ir::ExprKind::int{ negative = false, value = n } }
        let shifted = mk{ ty, k = ir::ExprKind::shift{ op = ir::ShiftOp::shr, a = box{ l, e = v }, b = box{ l, e = count }, pos } }
        return mk{ ty, k = ir::ExprKind::bits{ op = ir::BitOp::bit_xor, a = box{ l, e = v }, b = box{ l, e = shifted } } }
    }

    // The derived fn of type t, queued the first time it is needed: `==` or `@hash` by site.
    fn derived_id { mut l: Lower, t: Id, site: u32 } -> u32 {
        let x = T{ &l, t }
        let mut b = list::new(u8){ realloc = arena::alloc, heap = l.heap }
        put_u32{ xs = &b, n = NONE }         // no declaration's id
        put_u32{ xs = &b, n = site }
        put_u32{ xs = &b, n = norm{ &l, t = x } }
        let key = list::items{ list = b }
        let known = map::get{ m = l.fn_ids, key }
        if known != null { return known }
        let id = @as(u32, l.queue.len)
        try! map::put{ m = &l.fn_ids, key, value = id }
        try! list::push{ list = &l.queue, item = Inst{ decl = l.decl, targs = no_ids{}, site, widen = null, entry = x } }
        return id
    }

    // What a derived fn is being written with: its statements, and where it is, for the IR's
    // positions, which no check in it can fail at.
    struct Deriving { stmts: list::List(ir::Stmt, Heap), pos: ir::Pos, hash: bool }

    // Derived fn inst as a function. `==`: `fn{ a: T, b: T } -> bool`, which returns false at
    // the first part that differs. `@hash`: `fn{ h: u64, x: T } -> u64`, h with every part of x
    // folded in, in order. A struct goes field by field, an array and a slice element by
    // element (a slice's length first), an optional by whether it is null, and a union by its
    // variant, then that variant's fields; padding is never read.
    fn deriving { mut l: Lower, id: u32, inst: Inst } -> ir::Func {
        let d = check::get_decl{ c = l.c.*, d = inst.decl }
        l.decl = inst.decl
        l.targs = no_ids{}
        map::clear{ m = &l.slots }
        l.locals = list::new(ir::Local){ realloc = arena::alloc, heap = l.heap }
        let hash = inst.site == DERIVED_HASH
        let t = inst.entry
        let ty = tid{ &l, t }
        let bool_ty = tid{ &l, t = types::BOOL }
        let u64_ty = tid{ &l, t = types::prim{ p = types::Prim::u64 } }
        let ret = if hash { u64_ty } else { bool_ty }
        l.ret = if hash { types::prim{ p = types::Prim::u64 } } else { types::BOOL }
        let mut params = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &params, item = ir::Param{ name = if hash { "h" } else { "a" }, mutable = false, ty = if hash { u64_ty } else { ty } } }
        try! list::push{ list = &params, item = ir::Param{ name = if hash { "x" } else { "b" }, mutable = false, ty } }
        try! list::push{ list = &l.locals, item = ir::Local{ name = if hash { "h" } else { "a" }, ty = if hash { u64_ty } else { ty } } }
        try! list::push{ list = &l.locals, item = ir::Local{ name = if hash { "x" } else { "b" }, ty } }
        let p0 = slot_ex{ ty = if hash { u64_ty } else { ty }, slot = 0 }
        let p1 = slot_ex{ ty, slot = 1 }
        let mut g = Deriving{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, pos = ir::Pos{ line = 0, col = 0, file = 0 }, hash }
        // The hash so far is in a local of its own, which each part's fold replaces.
        let acc = if hash { temp{ &l, ty = u64_ty } } else { NONE }
        if hash { try! list::push{ list = &g.stmts, item = ir::Stmt::define{ slot = acc, init = p0 } } }
        derive_parts{ &l, &g, t, a = if hash { p1 } else { p0 }, b = p1, acc }
        let last = if hash { slot_ex{ ty = u64_ty, slot = acc } } else { mk{ ty = bool_ty, k = ir::ExprKind::boolean{ value = true } } }
        try! list::push{ list = &g.stmts, item = ir::Stmt::ret{ value = last } }
        let mut name = message{ l }
        try! @fmt(&name, "{} of {}", if hash { "@hash" } else { "==" }, str{ s = type_name{ l, t } })
        return ir::Func{
            id, name = utf8::view{ b = name }.bytes, symbol = "", params = list::items{ list = params }, ret,
            locals = list::items{ list = l.locals }, body = ir::Block{ stmts = list::items{ list = g.stmts }, result = null },
            unit = unit_of{ l, x = d }, at = d.syn.span.start, file = file_of{ &l, x = d }, shown = ir::Shown::hidden,
        }
    }

    // One part: for `==`, leave with false unless a's and b's are the same; for `@hash`, fold
    // a's into acc.
    fn derive_part { mut l: Lower, mut g: Deriving, t: Id, a: ir::Expr, b: ir::Expr, acc: u32 } {
        let u64_ty = tid{ &l, t = types::prim{ p = types::Prim::u64 } }
        if g.hash {
            let h = slot_ex{ ty = u64_ty, slot = acc }
            try! list::push{ list = &g.stmts, item = ir::Stmt::assign{ place = h, value = hashed{ &l, t, h, v = a } } }
            return
        }
        let bool_ty = tid{ &l, t = types::BOOL }
        let differ = mk{ ty = bool_ty, k = ir::ExprKind::lnot{ e = box{ l, e = same{ &l, t, a, b } } } }
        leave_if{ &l, &g, c = differ }
    }

    // `if c { return false }`, in a derived `==`.
    fn leave_if { mut l: Lower, mut g: Deriving, c: ir::Expr } {
        let bool_ty = tid{ &l, t = types::BOOL }
        let mut out = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &out, item = ir::Stmt::ret{ value = mk{ ty = bool_ty, k = ir::ExprKind::boolean{ value = false } } } }
        try! list::push{ list = &g.stmts, item = ir::Stmt::cond{ c, then = ir::Block{ stmts = list::items{ list = out }, result = null }, els = null } }
    }

    // A number folded into acc, in a derived `@hash`: a length, a variant's index.
    fn fold_number { mut l: Lower, mut g: Deriving, n: ir::Expr, acc: u32 } {
        let h = slot_ex{ ty = n.ty, slot = acc }
        try! list::push{ list = &g.stmts, item = ir::Stmt::assign{ place = h, value = mixed{ &l, h, n } } }
    }

    // The parts of a and b, values of type t that the derived fn of t was given: g's statements
    // for all of them.
    fn derive_parts { mut l: Lower, mut g: Deriving, t: Id, a: ir::Expr, b: ir::Expr, acc: u32 } {
        let x = types::undistinct{ s = l.c.ty, t = T{ &l, t } }
        let bool_ty = tid{ &l, t = types::BOOL }
        let usize_ty = tid{ &l, t = types::USIZE }
        let u64_ty = tid{ &l, t = types::prim{ p = types::Prim::u64 } }
        match get{ l, t = x } {
            record{ decl, args } => {
                let fields = check::subst_fields{ c = l.c, fields = check::get_decl{ c = l.c.*, d = decl }.fields, decl, args }
                for f at i in fields {
                    let ft = tid{ &l, t = f.ty }
                    let fa = mk{ ty = ft, k = ir::ExprKind::field{ base = box{ l, e = a }, index = @as(u32, i) } }
                    let fb = mk{ ty = ft, k = ir::ExprKind::field{ base = box{ l, e = b }, index = @as(u32, i) } }
                    derive_part{ &l, &g, t = f.ty, a = fa, b = fb, acc }
                }
            }
            array{ n, elem } => {
                let count = mk{ ty = usize_ty, k = ir::ExprKind::int{ negative = false, value = n } }
                derive_elems{ &l, &g, elem, a, b, count, sliced = false, acc }
            }
            slice{ elem } => { derive_slices{ &l, &g, elem, a, b, acc } }
            strlit => { derive_slices{ &l, &g, elem = types::U8, a, b, acc } }
            opt{ elem } => {
                let et = tid{ &l, t = elem }
                let none_a = mk{ ty = bool_ty, k = ir::ExprKind::isnull{ e = box{ l, e = a } } }
                let pa = mk{ ty = et, k = ir::ExprKind::payload{ base = box{ l, e = a }, variant = 1, field = 0 } }
                let pb = mk{ ty = et, k = ir::ExprKind::payload{ base = box{ l, e = b }, variant = 1, field = 0 } }
                let mut inner = Deriving{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, pos = g.pos, hash = g.hash }
                let mut null_case = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
                if g.hash {
                    // 0 for null; 1, then the value.
                    let mut zero = Deriving{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, pos = g.pos, hash = true }
                    fold_number{ &l, g = &zero, n = mk{ ty = u64_ty, k = ir::ExprKind::int{ negative = false, value = 0 } }, acc }
                    null_case = zero.stmts
                    fold_number{ &l, g = &inner, n = mk{ ty = u64_ty, k = ir::ExprKind::int{ negative = false, value = 1 } }, acc }
                } else {
                    // Both null are the same; one null differs.
                    let none_b = mk{ ty = bool_ty, k = ir::ExprKind::isnull{ e = box{ l, e = b } } }
                    try! list::push{ list = &null_case, item = ir::Stmt::ret{ value = none_b } }
                    leave_if{ &l, g = &inner, c = none_b }
                }
                derive_part{ &l, g = &inner, t = elem, a = pa, b = pb, acc }
                let then = ir::Block{ stmts = list::items{ list = null_case }, result = null }
                let els = ir::Block{ stmts = list::items{ list = inner.stmts }, result = null }
                try! list::push{ list = &g.stmts, item = ir::Stmt::cond{ c = none_a, then, els } }
            }
            sum => {
                let vs = check::variants_of{ c = l.c, t = x }
                let mut arms = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
                for v at i in vs {
                    let fields = v.fields ifnull { slice::empty(types::Field){} }
                    let mut binds_a = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
                    let mut binds_b = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
                    let mut inner = Deriving{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, pos = g.pos, hash = g.hash }
                    if g.hash { fold_number{ &l, g = &inner, n = mk{ ty = u64_ty, k = ir::ExprKind::int{ negative = false, value = i } }, acc } }
                    for f at k in fields {
                        let ft = tid{ &l, t = f.ty }
                        let sa = temp{ &l, ty = ft }
                        add_bind{ xs = &binds_a, b = ir::Bind{ slot = sa, field = @as(u32, k), by_ref = false } }
                        let mut sb = sa
                        if not g.hash {
                            sb = temp{ &l, ty = ft }
                            add_bind{ xs = &binds_b, b = ir::Bind{ slot = sb, field = @as(u32, k), by_ref = false } }
                        }
                        derive_part{ &l, g = &inner, t = f.ty, a = slot_ex{ ty = ft, slot = sa }, b = slot_ex{ ty = ft, slot = sb }, acc }
                    }
                    let mut body = inner.stmts
                    if not g.hash {
                        // b must hold the same variant: its fields are bound beside a's, and any
                        // other variant differs.
                        let mut same_variant = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
                        add_arm{ l, xs = &same_variant, pats = one_pat{ l, p = ir::Pat{ variant = @as(u32, i), binds = list::items{ list = binds_b } } }, body = ir::Block{ stmts = list::items{ list = inner.stmts }, result = null } }
                        let mut other = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
                        try! list::push{ list = &other, item = ir::Stmt::ret{ value = mk{ ty = bool_ty, k = ir::ExprKind::boolean{ value = false } } } }
                        add_arm{ l, xs = &same_variant, pats = slice::empty(ir::Pat){}, body = ir::Block{ stmts = list::items{ list = other }, result = null } }
                        body = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
                        try! list::push{ list = &body, item = ir::Stmt::choose{ scrut = b, through = false, arms = list::items{ list = same_variant } } }
                    }
                    add_arm{ l, xs = &arms, pats = one_pat{ l, p = ir::Pat{ variant = @as(u32, i), binds = list::items{ list = binds_a } } }, body = ir::Block{ stmts = list::items{ list = body }, result = null } }
                }
                try! list::push{ list = &g.stmts, item = ir::Stmt::choose{ scrut = a, through = false, arms = list::items{ list = arms } } }
            }
            else => { @panic("lower: a derived fn of a type the checker should have refused") }
        }
    }

    // Two slices of elem: their lengths, then their elements.
    fn derive_slices { mut l: Lower, mut g: Deriving, elem: Id, a: ir::Expr, b: ir::Expr, acc: u32 } {
        let bool_ty = tid{ &l, t = types::BOOL }
        let usize_ty = tid{ &l, t = types::USIZE }
        let u64_ty = tid{ &l, t = types::prim{ p = types::Prim::u64 } }
        let len_a = mk{ ty = usize_ty, k = ir::ExprKind::field{ base = box{ l, e = a }, index = 1 } }
        let len_b = mk{ ty = usize_ty, k = ir::ExprKind::field{ base = box{ l, e = b }, index = 1 } }
        if g.hash {
            fold_number{ &l, &g, n = mk{ ty = u64_ty, k = ir::ExprKind::trunc{ e = box{ l, e = len_a } } }, acc }
        } else {
            leave_if{ &l, &g, c = mk{ ty = bool_ty, k = ir::ExprKind::cmp{ op = ir::CmpOp::ne, a = box{ l, e = len_a }, b = box{ l, e = len_b } } } }
        }
        derive_elems{ &l, &g, elem, a, b, count = len_a, sliced = true, acc }
    }

    // `let i = 0; while i < count { part of a[i] and b[i]; i = i + 1 }`, over two arrays or two
    // slices (sliced) of elem.
    fn derive_elems { mut l: Lower, mut g: Deriving, elem: Id, a: ir::Expr, b: ir::Expr, count: ir::Expr, sliced: bool, acc: u32 } {
        let bool_ty = tid{ &l, t = types::BOOL }
        let usize_ty = tid{ &l, t = types::USIZE }
        let et = tid{ &l, t = elem }
        let si = temp{ &l, ty = usize_ty }
        let i = slot_ex{ ty = usize_ty, slot = si }
        try! list::push{ list = &g.stmts, item = ir::Stmt::define{ slot = si, init = mk{ ty = usize_ty, k = ir::ExprKind::int{ negative = false, value = 0 } } } }
        let ea = if sliced { mk{ ty = et, k = ir::ExprKind::sindex{ base = box{ l, e = a }, i = box{ l, e = i }, pos = g.pos } } } else { mk{ ty = et, k = ir::ExprKind::index{ base = box{ l, e = a }, i = box{ l, e = i }, pos = g.pos } } }
        let eb = if sliced { mk{ ty = et, k = ir::ExprKind::sindex{ base = box{ l, e = b }, i = box{ l, e = i }, pos = g.pos } } } else { mk{ ty = et, k = ir::ExprKind::index{ base = box{ l, e = b }, i = box{ l, e = i }, pos = g.pos } } }
        let mut inner = Deriving{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, pos = g.pos, hash = g.hash }
        derive_part{ &l, g = &inner, t = elem, a = ea, b = eb, acc }
        let one = mk{ ty = usize_ty, k = ir::ExprKind::int{ negative = false, value = 1 } }
        let next = mk{ ty = usize_ty, k = ir::ExprKind::arith{ op = ir::ArithOp::add, a = box{ l, e = i }, b = box{ l, e = one }, pos = g.pos, trap = ir::NO_TRAP } }
        try! list::push{ list = &inner.stmts, item = ir::Stmt::assign{ place = i, value = next } }
        let more = mk{ ty = bool_ty, k = ir::ExprKind::cmp{ op = ir::CmpOp::lt, a = box{ l, e = i }, b = box{ l, e = count } } }
        try! list::push{ list = &g.stmts, item = ir::Stmt::loop{ c = more, body = ir::Block{ stmts = list::items{ list = inner.stmts }, result = null }, label = null } }
    }

    // ---- @min, @max, @clamp, @round, @saturate and @round_saturate (spec §13): each is written
    // with the IR's compares, conditionals and float arithmetic, over temporaries that hold
    // the operands, so the C, the interpreter and a const's evaluation give one answer.

    fn held { l: Lower, slot: u32, init: ir::Expr, body: ir::Expr } -> ir::Expr {
        return mk{ ty = body.ty, k = ir::ExprKind::with{ slot, init = box{ l, e = init }, body = box{ l, e = body } } }
    }

    fn slot_ex { ty: u32, slot: u32 } -> ir::Expr {
        return mk{ ty, k = ir::ExprKind::local{ slot } }
    }

    fn compared { mut l: Lower, op: ir::CmpOp, a: ir::Expr, b: ir::Expr } -> ir::Expr {
        return mk{ ty = tid{ &l, t = types::BOOL }, k = ir::ExprKind::cmp{ op, a = box{ l, e = a }, b = box{ l, e = b } } }
    }

    // `if c { then } else { els }`, of type ty.
    fn either { l: Lower, ty: u32, c: ir::Expr, then: ir::Expr, els: ir::Expr } -> ir::Expr {
        let stmts = slice::empty(ir::Stmt){}
        return mk{ ty, k = ir::ExprKind::ifx{ c = box{ l, e = c }, then = ir::Block{ stmts, result = box{ l, e = then } }, els = ir::Block{ stmts, result = box{ l, e = els } } } }
    }

    fn float_of { mut l: Lower, value: f64 } -> ir::Expr {
        return mk{ ty = tid{ &l, t = types::prim{ p = types::Prim::f64 } }, k = ir::ExprKind::float{ value } }
    }

    // `@min(a, b)` or `@max(a, b)`, a's and b's values in temporaries, a's first:
    // `a <= b ? a : b`, and for floats `a <= b ? a : (a != a ? a : b)`, so that a NaN operand
    // gives a NaN and two equal ones give the first.
    fn min_max { mut l: Lower, least: bool, a: syntax::Expr, b: syntax::Expr, t: Id } -> ir::Expr {
        let ty = tid{ &l, t }
        let x = conv{ &l, e = a, to = t }
        let y = conv{ &l, e = b, to = t }
        let sa = temp{ &l, ty }
        let sb = temp{ &l, ty }
        let va = slot_ex{ ty, slot = sa }
        let vb = slot_ex{ ty, slot = sb }
        let first = compared{ &l, op = if least { ir::CmpOp::le } else { ir::CmpOp::ge }, a = va, b = vb }
        let mut other = vb
        if types::is_float{ s = l.c.ty, t = types::undistinct{ s = l.c.ty, t = T{ &l, t } } } {
            other = either{ l, ty, c = compared{ &l, op = ir::CmpOp::ne, a = va, b = va }, then = va, els = vb }
        }
        return held{ l, slot = sa, init = x, body = held{ l, slot = sb, init = y, body = either{ l, ty, c = first, then = va, els = other } } }
    }

    // `@clamp(x, lo, hi)`, the three in temporaries in that order: it panics unless
    // `lo <= hi`, which a NaN bound isn't, and is then `x < lo ? lo : (x > hi ? hi : x)`, so a
    // NaN x stays one.
    fn clamp { mut l: Lower, e: syntax::Expr, args: []syntax::Expr, t: Id } -> ir::Expr {
        let ty = tid{ &l, t }
        let x = conv{ &l, e = args[0], to = t }
        let lo = conv{ &l, e = args[1], to = t }
        let hi = conv{ &l, e = args[2], to = t }
        let sx = temp{ &l, ty }
        let slo = temp{ &l, ty }
        let shi = temp{ &l, ty }
        let vx = slot_ex{ ty, slot = sx }
        let vlo = slot_ex{ ty, slot = slo }
        let vhi = slot_ex{ ty, slot = shi }
        let float = types::is_float{ s = l.c.ty, t = types::undistinct{ s = l.c.ty, t = T{ &l, t } } }
        let msg = if float { "@clamp: the low bound is above the high bound, or one of them is NaN" } else { "@clamp: the low bound is above the high bound" }
        let mut ps = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &ps, item = ir::Stmt::panic{ pos = epos{ &l, e }, msg } }
        let bad = ir::Block{ stmts = list::items{ list = ps }, result = null }
        let over = either{ l, ty, c = compared{ &l, op = ir::CmpOp::gt, a = vx, b = vhi }, then = vhi, els = vx }
        let value = either{ l, ty, c = compared{ &l, op = ir::CmpOp::lt, a = vx, b = vlo }, then = vlo, els = over }
        let ordered = compared{ &l, op = ir::CmpOp::le, a = vlo, b = vhi }
        let good = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = box{ l, e = value } }
        let checked = mk{ ty, k = ir::ExprKind::ifx{ c = box{ l, e = ordered }, then = good, els = bad } }
        return held{ l, slot = sx, init = x, body = held{ l, slot = slo, init = lo, body = held{ l, slot = shi, init = hi, body = checked } } }
    }

    // v, an f64 in a local, rounded to the nearest integer, halfway cases to the even one, as
    // an f64: below 2^52 in size, adding and taking away 2^52 rounds it, as every float
    // operation rounds to nearest even; from there up, and for an infinity or NaN, v is its own
    // rounding. The sign goes back on after, so -0.4 gives -0.0.
    fn round_even { mut l: Lower, v: ir::Expr, pos: ir::Pos } -> ir::Expr {
        let ty = v.ty
        let big = float_of{ &l, value = 4503599627370496.0 }
        let negative = compared{ &l, op = ir::CmpOp::lt, a = v, b = float_of{ &l, value = 0.0 } }
        let sa = temp{ &l, ty }
        let sr = temp{ &l, ty }
        let va = slot_ex{ ty, slot = sa }
        let vr = slot_ex{ ty, slot = sr }
        let size = either{ l, ty, c = negative, then = mk{ ty, k = ir::ExprKind::neg{ e = box{ l, e = v }, pos, trap = ir::NO_TRAP } }, els = v }
        let sum = mk{ ty, k = ir::ExprKind::arith{ op = ir::ArithOp::add, a = box{ l, e = va }, b = box{ l, e = big }, pos, trap = ir::NO_TRAP } }
        let rounded = mk{ ty, k = ir::ExprKind::arith{ op = ir::ArithOp::sub, a = box{ l, e = sum }, b = box{ l, e = big }, pos, trap = ir::NO_TRAP } }
        let signed = either{ l, ty, c = negative, then = mk{ ty, k = ir::ExprKind::neg{ e = box{ l, e = vr }, pos, trap = ir::NO_TRAP } }, els = vr }
        let small = compared{ &l, op = ir::CmpOp::lt, a = va, b = big }
        return held{ l, slot = sa, init = size, body = either{ l, ty, c = small, then = held{ l, slot = sr, init = rounded, body = signed }, els = v } }
    }

    // `@round(T, x)`, `@saturate(T, x)` or `@round_saturate(T, x)`. A float is held as an f64,
    // which an f32 widens to exactly, and rounded to nearest even if the builtin rounds. Then
    // @round converts as `@as` does, panicking or leaving for its `ifoverflow`, and the
    // saturating ones give 0 for NaN, T's maximum from 2^bits up (2^(bits - 1) for a signed T),
    // its minimum from -2^(bits - 1) or 0 down, and convert what is between, which fits;
    // @round_saturate to a T of 32 bits or fewer clamps before it rounds, for the same values
    // (below). An integer's bounds are compared in its own type, and only those T's range
    // doesn't cover.
    fn to_int { mut l: Lower, e: syntax::Expr, name: []u8, arg: syntax::Expr, t: Id } -> ir::Expr {
        let ty = tid{ &l, t }
        let pos = epos{ &l, e }
        let src = types::undistinct{ s = l.c.ty, t = T{ &l, t = check::type_of_expr{ c = l.c.*, e = arg } } }
        let x = ex{ &l, e = arg }
        let tp = types::prim_of{ s = l.c.ty, t = types::undistinct{ s = l.c.ty, t = T{ &l, t } } } ifnull { @panic("lower: a rounding conversion to a non-integer") }
        let bits = types::bits{ p = tp }
        let signed = types::signed{ p = tp }
        let top: u64 = if signed { (@as(u64, 1) << (bits - 1)) - 1 } else { 18446744073709551615 >> (64 - bits) }
        let highest = mk{ ty, k = ir::ExprKind::int{ negative = false, value = top } }
        let lowest = mk{ ty, k = ir::ExprKind::int{ negative = signed, value = if signed { top + 1 } else { 0 } } }
        if types::is_float{ s = l.c.ty, t = src } {
            let f64_id = types::prim{ p = types::Prim::f64 }
            let fty = tid{ &l, t = f64_id }
            let wide = coerce{ &l, x, frm = src, to = f64_id, at = check::expr_at{ e = arg } }
            let sv = temp{ &l, ty = fty }
            let v = slot_ex{ ty = fty, slot = sv }
            let rounds = not slice::eq_bytes{ a = name, b = "saturate" }
            let whole = if rounds { round_even{ &l, v, pos } } else { v }
            if slice::eq_bytes{ a = name, b = "round" } {
                let out = mk{ ty, k = ir::ExprKind::convert{ e = box{ l, e = whole }, pos, trap = trap_of{ l, e } } }
                return held{ l, slot = sv, init = wide, body = out }
            }
            // 2^bits, or 2^(bits - 1) for a signed type: the first float above T's range.
            let mut above: f64 = 1.0
            for i in 0..(if signed { bits - 1 } else { bits }) { above = above * 2.0 }
            let below: f64 = if signed { -above } else { 0.0 }
            let zero = mk{ ty, k = ir::ExprKind::int{ negative = false, value = 0 } }
            if rounds and bits <= 32 {
                // T's bounds are f64s, so clamping can come first, and what is left is so far
                // below 2^51 that adding and taking away 1.5 * 2^52 rounds it, sign and all:
                // the audio loops' path, three compares and two additions.
                let magic = float_of{ &l, value = 6755399441055744.0 }
                let sum = mk{ ty = fty, k = ir::ExprKind::arith{ op = ir::ArithOp::add, a = box{ l, e = v }, b = box{ l, e = magic }, pos, trap = ir::NO_TRAP } }
                let near = mk{ ty = fty, k = ir::ExprKind::arith{ op = ir::ArithOp::sub, a = box{ l, e = sum }, b = box{ l, e = magic }, pos, trap = ir::NO_TRAP } }
                let fits = mk{ ty, k = ir::ExprKind::convert{ e = box{ l, e = near }, pos, trap = ir::NO_TRAP } }
                let low = either{ l, ty, c = compared{ &l, op = ir::CmpOp::le, a = v, b = float_of{ &l, value = below } }, then = lowest, els = fits }
                let high = either{ l, ty, c = compared{ &l, op = ir::CmpOp::ge, a = v, b = float_of{ &l, value = above - 1.0 } }, then = highest, els = low }
                let out = either{ l, ty, c = compared{ &l, op = ir::CmpOp::ne, a = v, b = v }, then = zero, els = high }
                return held{ l, slot = sv, init = wide, body = out }
            }
            let sw = temp{ &l, ty = fty }
            let w = slot_ex{ ty = fty, slot = sw }
            let fits = mk{ ty, k = ir::ExprKind::convert{ e = box{ l, e = w }, pos, trap = ir::NO_TRAP } }
            let low = either{ l, ty, c = compared{ &l, op = ir::CmpOp::le, a = w, b = float_of{ &l, value = below } }, then = lowest, els = fits }
            let high = either{ l, ty, c = compared{ &l, op = ir::CmpOp::ge, a = w, b = float_of{ &l, value = above } }, then = highest, els = low }
            let out = either{ l, ty, c = compared{ &l, op = ir::CmpOp::ne, a = w, b = w }, then = zero, els = high }
            return held{ l, slot = sv, init = wide, body = held{ l, slot = sw, init = whole, body = out } }
        }
        // @saturate of an integer.
        let sp = types::prim_of{ s = l.c.ty, t = src } ifnull { @panic("lower: @saturate of a non-number") }
        let sbits = types::bits{ p = sp }
        let ssigned = types::signed{ p = sp }
        let stop: u64 = if ssigned { (@as(u64, 1) << (sbits - 1)) - 1 } else { 18446744073709551615 >> (64 - sbits) }
        let sty = x.ty
        let ss = temp{ &l, ty = sty }
        let s = slot_ex{ ty = sty, slot = ss }
        let mut out = if norm{ &l, t = src } == norm{ &l, t } { s } else { mk{ ty, k = ir::ExprKind::convert{ e = box{ l, e = s }, pos, trap = ir::NO_TRAP } } }
        // Above T's maximum, where the source's is larger.
        if stop > top {
            let limit = mk{ ty = sty, k = ir::ExprKind::int{ negative = false, value = top } }
            out = either{ l, ty, c = compared{ &l, op = ir::CmpOp::gt, a = s, b = limit }, then = highest, els = out }
        }
        // Below T's minimum, where the source's is smaller: a signed source, and an unsigned T
        // or a narrower one.
        if ssigned and (not signed or sbits > bits) {
            let limit = mk{ ty = sty, k = ir::ExprKind::int{ negative = signed, value = if signed { top + 1 } else { 0 } } }
            out = either{ l, ty, c = compared{ &l, op = ir::CmpOp::lt, a = s, b = limit }, then = lowest, els = out }
        }
        return held{ l, slot = ss, init = x, body = out }
    }

    // An atomic (spec §13): the pointer, the values as the pointer's T, and the order its name
    // gives (check::atomic_parts). @atomic_compare_exchange gives null if it stored, else the value it found:
    // `(with p P (with e EXPECTED (with old (atomic compare_exchange [p e DESIRED]) (old == e ? null : some old))))`.
    fn atomic { mut l: Lower, name: []u8, args: []syntax::Expr, t: Id } -> ir::Expr {
        let parts = check::atomic_parts{ n = name } ifnull { @panic("lower: an atomic the checker doesn't know") }
        let k = check::atomic_arity{ op = parts.op }
        let o = parts.order
        let ty = tid{ &l, t }
        let none = slice::empty(ir::Expr){}
        if k == 0 { return mk{ ty, k = ir::ExprKind::atomic{ op = ir::AtomicOp::fence, order = o, args = none } } }
        let pt = after{ &l, e = args[0] }
        let elem = ptr_elem{ l, t = pt }
        let mut xs = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &xs, item = ex{ &l, e = args[0] } }
        let mut i: usize = 1
        while i < k {
            try! list::push{ list = &xs, item = conv{ &l, e = args[i], to = elem } }
            i = i + 1
        }
        let vs = list::items{ list = xs }
        let n = parts.op
        let op = if slice::eq_bytes{ a = n, b = "atomic_load" } {
            ir::AtomicOp::load
        } else if slice::eq_bytes{ a = n, b = "atomic_store" } {
            ir::AtomicOp::store
        } else if slice::eq_bytes{ a = n, b = "atomic_exchange" } {
            ir::AtomicOp::exchange
        } else if slice::eq_bytes{ a = n, b = "atomic_add" } {
            ir::AtomicOp::add
        } else if slice::eq_bytes{ a = n, b = "atomic_subtract" } {
            ir::AtomicOp::subtract
        } else {
            ir::AtomicOp::compare_exchange
        }
        if not (op is compare_exchange) { return mk{ ty, k = ir::ExprKind::atomic{ op, order = o, args = vs } } }
        let et = tid{ &l, t = elem }
        let sp = temp{ &l, ty = vs[0].ty }
        let se = temp{ &l, ty = et }
        let old = temp{ &l, ty = et }
        let mut cs = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &cs, item = mk{ ty = vs[0].ty, k = ir::ExprKind::local{ slot = sp } } }
        try! list::push{ list = &cs, item = mk{ ty = et, k = ir::ExprKind::local{ slot = se } } }
        try! list::push{ list = &cs, item = vs[2] }
        let cas = mk{ ty = et, k = ir::ExprKind::atomic{ op, order = o, args = list::items{ list = cs } } }
        let found = mk{ ty = et, k = ir::ExprKind::local{ slot = old } }
        let same = mk{ ty = tid{ &l, t = types::BOOL }, k = ir::ExprKind::cmp{ op = ir::CmpOp::eq, a = box{ l, e = found }, b = box{ l, e = mk{ ty = et, k = ir::ExprKind::local{ slot = se } } } } }
        let stmts = slice::empty(ir::Stmt){}
        let then = ir::Block{ stmts, result = box{ l, e = mk{ ty, k = ir::ExprKind::nil } } }
        let els = ir::Block{ stmts, result = box{ l, e = mk{ ty, k = ir::ExprKind::some{ e = box{ l, e = found } } } } }
        let pick = mk{ ty, k = ir::ExprKind::ifx{ c = box{ l, e = same }, then, els } }
        let inner = mk{ ty, k = ir::ExprKind::with{ slot = old, init = box{ l, e = cas }, body = box{ l, e = pick } } }
        let mid = mk{ ty, k = ir::ExprKind::with{ slot = se, init = box{ l, e = vs[1] }, body = box{ l, e = inner } } }
        return mk{ ty, k = ir::ExprKind::with{ slot = sp, init = box{ l, e = vs[0] }, body = box{ l, e = mid } } }
    }

    fn targ_type { l: Lower, targ: ?*syntax::TypeExpr } -> Id {
        if targ == null { @panic("lower: a builtin without its type") }
        let te = targ.*
        let t = nodes::get{ m = l.c.type_of, key = check::key{ file = te.span.file, id = te.id } }
        if t == null { @panic("lower: a type expression that wasn't resolved") }
        return t
    }

    // The type whose layout @size_of reads: an enum's is its base's.
    fn norm_layout { mut l: Lower, t: Id } -> Id {
        return types::prune{ s = l.c.ty, t }
    }

    // `@as(E, n)`: a case for each variant whose value n's type can hold, which gives that
    // value, and a panic for any other.
    fn to_enum { mut l: Lower, e: syntax::Expr, arg: syntax::Expr, src: Id, t: Id, decl: u32 } -> ir::Expr {
        let d = check::get_decl{ c = l.c.*, d = decl }
        let p = types::prim_of{ s = l.c.ty, t = types::prune{ s = l.c.ty, t = src } }
        let mut out = list::new(ir::Case){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < d.values.len {
            let v = d.values[i]
            if p != null and types::fits{ p, negative = v < 0, magnitude = check::magnitude{ v } } {
                let value = mk{ ty = tid{ &l, t }, k = ir::ExprKind::int{ negative = v < 0, value = check::magnitude{ v } } }
                let mut vals = list::new(ir::Int){ realloc = arena::alloc, heap = l.heap }
                try! list::push{ list = &vals, item = int_of{ v } }
                let body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = box{ l, e = value } }
                try! list::push{ list = &out, item = ir::Case{ values = list::items{ list = vals }, ranges = slice::empty(ir::Range){}, body } }
            }
            i = i + 1
        }
        let mut b = message{ l }
        try! @fmt(&b, "@as: no variant of {} has this value", str{ s = d.qual })
        let panic = ir::Stmt::panic{ pos = epos{ &l, e }, msg = utf8::view{ b }.bytes }
        let mut ps = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &ps, item = panic }
        let els = ir::Block{ stmts = list::items{ list = ps }, result = null }
        try! list::push{ list = &out, item = ir::Case{ values = slice::empty(ir::Int){}, ranges = slice::empty(ir::Range){}, body = els } }
        let ty = tid{ &l, t }
        let x = ex{ &l, e = arg }
        return mk{ ty, k = ir::ExprKind::switchx{ scrut = box{ l, e = x }, cases = list::items{ list = out } } }
    }

    // ---- @fmt: the writes it stands for, each in turn until one fails, whose error is the @fmt's

    // An @fmt's sink, of type ty, a pointer: its expression e, read again for each piece if it
    // is a name or a path of fields from one, which gives the same place, or else the value
    // slot holds. at is where it is.
    struct Sink { e: syntax::Expr, ty: Id, slot: u32, at: source::Span }

    // What an @fmt's pieces are written with: its sink, each hole's value and its type, site
    // si's, and rt, the @fmt's result.
    struct Writes { s: Sink, vals: []ir::Expr, tys: []Id, si: u32, rt: Id }

    // With a sink first, the sink and the holes are evaluated once, in order, into temporaries
    // (a hole that is a local or a literal is read where it is written, which is the same),
    // then each piece is written. Without one, the @fmt is a writer: a bind of the holes to a
    // hidden fn (hidden), which writes the pieces into the sink it is called with.
    fn fmt { mut l: Lower, e: syntax::Expr, args: []syntax::Expr } -> ir::Expr {
        let si = map::get{ m = l.c.site_of, key = check::expr_key{ e } } ifnull { @panic("lower: an @fmt that wasn't checked") }
        let st = list::items{ list = l.c.sites }[@as(usize, si)]
        if st.value { return writer{ &l, e, st, si } }
        let rt = types::prune{ s = l.c.ty, t = T{ &l, t = check::type_of_expr{ c = l.c.*, e } } }
        let b = args[0]
        let mut s = Sink{ e = b, ty = T{ &l, t = check::type_of_expr{ c = l.c.*, e = b } }, slot = NONE, at = check::expr_at{ e = b } }
        let mut slots = list::new(u32){ realloc = arena::alloc, heap = l.heap }
        let mut inits = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        let inner = match b.k { addr{ e = x } => { x.* } else => { b } }
        if not check::simple_place{ e = inner } {
            let init = ex{ &l, e = b }
            s.slot = temp{ &l, ty = init.ty }
            try! list::push{ list = &slots, item = s.slot }
            try! list::push{ list = &inits, item = init }
        }
        let mut vals = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        let mut tys = list::new(Id){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < st.holes.len {
            let h = st.holes[i]
            let t = after{ &l, e = h }
            let mut v = conv{ &l, e = h, to = t }
            if not (v.k is local | int | float | boolean | str | sbytes) {
                let slot = temp{ &l, ty = v.ty }
                try! list::push{ list = &slots, item = slot }
                try! list::push{ list = &inits, item = v }
                v = mk{ ty = v.ty, k = ir::ExprKind::local{ slot } }
            }
            try! list::push{ list = &vals, item = v }
            try! list::push{ list = &tys, item = t }
            i = i + 1
        }
        let w = Writes{ s, vals = list::items{ list = vals }, tys = list::items{ list = tys }, si, rt }
        let mut r = pieces{ &l, w, ps = st.pieces }
        let ss = list::items{ list = slots }
        let xs = list::items{ list = inits }
        let mut k = ss.len
        while k > 0 {
            k = k - 1
            r = mk{ ty = r.ty, k = ir::ExprKind::with{ slot = ss[k], init = box{ l, e = xs[k] }, body = box{ l, e = r } } }
        }
        return r
    }

    // The writes of pieces ps, each in turn until one fails, as a result of type w.rt.
    fn pieces { mut l: Lower, w: Writes, ps: []check::Piece } -> ir::Expr {
        let mut calls = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        let mut h: usize = 0
        let mut i: usize = 0
        while i < ps.len {
            try! list::push{ list = &calls, item = push_call{ &l, w, p = ps[i], h } }
            if ps[i].hole { h = h + 1 }
            i = i + 1
        }
        let mut r = ok_of{ &l, rt = w.rt }
        while i > 0 {
            i = i - 1
            r = then{ &l, a = list::items{ list = calls }[i], b = r, rt = w.rt }
        }
        return r
    }

    // A writer, an @fmt without a sink: a bind of its holes, evaluated now, to the hidden fn of
    // site si in this instance.
    fn writer { mut l: Lower, e: syntax::Expr, st: check::Site, si: u32 } -> ir::Expr {
        let fid = site_fn{ &l, site = si }
        let mut args = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < st.holes.len {
            let h = st.holes[i]
            add_arg{ xs = &args, a = ir::Arg{ index = @as(u32, i), value = conv{ &l, e = h, to = after{ &l, e = h } } } }
            i = i + 1
        }
        return mk{ ty = tid{ &l, t = T{ &l, t = st.ty } }, k = ir::ExprKind::bind{ callee = fid, args = list::items{ list = args } } }
    }

    // The hidden fn of an @fmt without a sink, under the declaration it is in, as one of its
    // instances: a param for each hole, which the writer binds, and the sink, a `mut` param
    // named as the writer's type names it. It writes the pieces and returns the result as the
    // writer's type has it, whose `!` holds any error.
    fn hidden { mut l: Lower, id: u32, inst: Inst } -> ir::Func {
        let x = check::get_decl{ c = l.c.*, d = inst.decl }
        let st = list::items{ list = l.c.sites }[@as(usize, inst.site)]
        l.decl = inst.decl
        l.targs = inst.targs
        map::clear{ m = &l.slots }
        l.locals = list::new(ir::Local){ realloc = arena::alloc, heap = l.heap }
        let func{ fields, ret } = get{ l, t = T{ &l, t = st.ty } } else { @panic("lower: a writer that isn't a function") }
        l.ret = ret
        let mut params = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
        let mut vals = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        let mut tys = list::new(Id){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < st.holes.len {
            let t = after{ &l, e = st.holes[i] }
            let ty = tid{ &l, t }
            let mut b = message{ l }
            try! @fmt(&b, "{{{}}}", i)
            let name = utf8::view{ b }.bytes
            try! list::push{ list = &params, item = ir::Param{ name, mutable = false, ty } }
            try! list::push{ list = &l.locals, item = ir::Local{ name, ty } }
            try! list::push{ list = &vals, item = mk{ ty, k = ir::ExprKind::local{ slot = @as(u32, i) } } }
            try! list::push{ list = &tys, item = t }
            i = i + 1
        }
        let f = fields[0]
        let bt = T{ &l, t = f.ty }
        let sink = types::ptr{ s = &l.c.ty, elem = bt, mutable = false }
        try! list::push{ list = &params, item = ir::Param{ name = f.name, mutable = true, ty = tid{ &l, t = bt } } }
        try! list::push{ list = &l.locals, item = ir::Local{ name = f.name, ty = tid{ &l, t = sink } } }
        let none = syntax::Expr{ id = 0, span = st.at, at = st.at.start, k = syntax::ExprKind::error }
        let s = Sink{ e = none, ty = sink, slot = @as(u32, st.holes.len), at = st.at }
        let rt = types::res{ s = &l.c.ty, ok = types::VOID, errs = types::errs{ s = &l.c.ty, owner = check::SITE + inst.site, one = NONE } }
        let w = Writes{ s, vals = list::items{ list = vals }, tys = list::items{ list = tys }, si = inst.site, rt }
        let r = lift{ &l, x = pieces{ &l, w, ps = st.pieces }, frm = rt, to = ret }
        let mut xs = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &xs, item = ir::Stmt::ret{ value = r } }
        // Named after its instance, so that the C backend can tell apart those of instances of
        // one generic fn.
        let mut name = message{ l }
        try! @fmt(&name, "{}@fmt", str{ s = inst_name{ l, x, targs = inst.targs } })
        return ir::Func{
            id, name = utf8::view{ b = name }.bytes, symbol = "", params = list::items{ list = params }, ret = tid{ &l, t = ret },
            locals = list::items{ list = l.locals }, body = ir::Block{ stmts = list::items{ list = xs }, result = null },
            unit = unit_of{ l, x }, at = x.syn.span.start, file = file_of{ &l, x }, shown = ir::Shown::hidden,
        }
    }

    fn sink_ex { mut l: Lower, s: Sink } -> ir::Expr {
        if s.slot == NONE { return ex{ &l, e = s.e } }
        return mk{ ty = tid{ &l, t = s.ty }, k = ir::ExprKind::local{ slot = s.slot } }
    }

    // Hole h's value as a `to`.
    fn hole_val { mut l: Lower, w: Writes, h: usize, to: Id } -> ir::Expr {
        return coerce{ &l, x = w.vals[h], frm = w.tys[h], to = T{ &l, t = to }, at = w.s.at }
    }

    // `ok` of a bare `!` of type rt.
    fn ok_of { mut l: Lower, rt: Id } -> ir::Expr {
        return mk{ ty = tid{ &l, t = rt }, k = ir::ExprKind::variant{ index = 0, items = slice::empty(ir::Arg){} } }
    }

    // b if a, a bare `!` of type rt, is `ok`, else a.
    fn then { mut l: Lower, a: ir::Expr, b: ir::Expr, rt: Id } -> ir::Expr {
        let ty = tid{ &l, t = rt }
        let res{ errs } = types::get{ s = l.c.ty, id = rt } else { @panic("lower: @fmt that isn't a result") }
        let et = tid{ &l, t = errs }
        let s = temp{ &l, ty = et }
        let none = slice::empty(ir::Stmt){}
        let mut bs = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        add_bind{ xs = &bs, b = ir::Bind{ slot = s, field = 0, by_ref = false } }
        let err = mk{ ty, k = ir::ExprKind::variant{ index = 1, items = one_arg{ l, v = mk{ ty = et, k = ir::ExprKind::local{ slot = s } } } } }
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 0, binds = slice::empty(ir::Bind){} } }, body = ir::Block{ stmts = none, result = box{ l, e = b } } }
        add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = list::items{ list = bs } } }, body = ir::Block{ stmts = none, result = box{ l, e = err } } }
        return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = a }, through = false, arms = list::items{ list = out } } }
    }

    // x, a result of type frm, as one of type `to`.
    fn lift { mut l: Lower, x: ir::Expr, frm: Id, to: Id } -> ir::Expr {
        if norm{ &l, t = frm } == norm{ &l, t = to } { return x }
        return res_remap{ &l, x, frm = types::prune{ s = l.c.ty, t = frm }, to }
    }

    // The call piece p becomes, as a result of type w.rt: its writer's with the sink and the
    // piece, an error's name and fields, or the hole's function with the sink. h is the hole's
    // index, if it is one.
    fn push_call { mut l: Lower, w: Writes, p: check::Piece, h: usize } -> ir::Expr {
        let s = w.s
        let rt = w.rt
        if slice::eq_bytes{ a = p.push, b = "error" } { return error_write{ &l, w, h, text = p.writer } }
        if slice::eq_bytes{ a = p.push, b = "shown" } { return shown{ &l, w, t = w.tys[h], v = w.vals[h], text = p.writer } }
        if slice::eq_bytes{ a = p.push, b = "spec" } { return write_call{ &l, s, w = p.writer, v = with_spec{ &l, p, v = w.vals[h], t = w.tys[h] }, rt, at = p.at } }
        if slice::eq_bytes{ a = p.push, b = "write" } {
            if not p.hole { return text_write{ &l, s, w = p.writer, bytes = p.text, rt } }
            let targs = T_all{ &l, ts = p.writer.targs }
            let vt = types::subst{ s = &l.c.ty, t = check::value_field{ c = l.c.*, d = p.writer.decl }.ty, decl = p.writer.decl, args = targs }
            return write_call{ &l, s, w = p.writer, v = hole_val{ &l, w, h, to = vt }, rt, at = p.at }
        }
        let ft = w.tys[h]
        let mut fields: []types::Field = slice::empty(types::Field){}
        let mut ret = types::VOID
        if get{ l, t = ft } is func{ fields = fs, ret = r } { fields = sorted_fields{ l, fields = fs }; ret = r }
        let ty = tid{ &l, t = ret }
        let bx = coerce{ &l, x = sink_ex{ &l, s }, frm = s.ty, to = types::ptr{ s = &l.c.ty, elem = fields[0].ty, mutable = false }, at = s.at }
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        add_arg{ xs = &out, a = ir::Arg{ index = 0, value = bx } }
        let call = mk{ ty, k = ir::ExprKind::dcall{ callee = box{ l, e = w.vals[h] }, args = list::items{ list = out }, pos = pos{ &l, at = p.at } } }
        return lift{ &l, x = call, frm = ret, to = rt }
    }

    // The value of a hole with a spec, as its writer takes it (§13, Formatting): one of std's
    // fmt::Int, Uint, F64, F32 or Text, a struct of the value and the spec, a fmt::Spec of
    // constants. v is the hole's value, of type t. A signed integer is an i64; an unsigned
    // one a u64, and so are a signed one's bits in another base, as its own width has them
    // (`{:x}` of an i8's -1 is ff); a string is its bytes.
    fn with_spec { mut l: Lower, p: check::Piece, v: ir::Expr, t: Id } -> ir::Expr {
        let wrap = types::prune{ s = l.c.ty, t = T{ &l, t = p.wrap } }
        let fields = check::get_decl{ c = l.c.*, d = check::record_decl{ c = l.c.*, t = wrap } }.fields
        let spec_t = fields[1].ty
        let sf = check::get_decl{ c = l.c.*, d = check::record_decl{ c = l.c.*, t = spec_t } }.fields
        let frm = types::undistinct{ s = l.c.ty, t = T{ &l, t } }
        let mut inner = v
        let at = p.at
        match get{ l, t = frm } {
            prim{ p = q } => {
                if not (q is f32 | f64) {
                    let mut x = v
                    let mut cur = frm
                    if types::signed{ p = q } and p.spec.base != 10 {
                        // The bits, in the unsigned type of the same width.
                        let u = match q { i8 => { types::Prim::u8 } i16 => { types::Prim::u16 } i32 => { types::Prim::u32 } else => { types::Prim::u64 } }
                        cur = types::prim{ p = u }
                        x = mk{ ty = tid{ &l, t = cur }, k = ir::ExprKind::trunc{ e = box{ l, e = v } } }
                    }
                    inner = coerce{ &l, x, frm = cur, to = fields[0].ty, at }
                }
            }
            record => { inner = mk{ ty = tid{ &l, t = fields[0].ty }, k = ir::ExprKind::field{ base = box{ l, e = v }, index = 0 } } }
            else => {}
        }
        let mut xs = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        let s = p.spec
        for f at i in sf {
            let ty = tid{ &l, t = f.ty }
            let mut k = ir::ExprKind::int{ negative = false, value = 0 }
            if slice::eq_bytes{ a = f.name, b = "width" } {
                k = ir::ExprKind::int{ negative = false, value = s.width }
            } else if slice::eq_bytes{ a = f.name, b = "precision" } {
                k = ir::ExprKind::int{ negative = s.precision < 0, value = check::magnitude{ v = s.precision } }
            } else if slice::eq_bytes{ a = f.name, b = "align" } {
                k = ir::ExprKind::int{ negative = false, value = s.align }
            } else if slice::eq_bytes{ a = f.name, b = "zero" } {
                k = ir::ExprKind::boolean{ value = s.zero }
            } else if slice::eq_bytes{ a = f.name, b = "base" } {
                k = ir::ExprKind::int{ negative = false, value = s.base }
            } else if slice::eq_bytes{ a = f.name, b = "upper" } {
                k = ir::ExprKind::boolean{ value = s.upper }
            } else {
                @panic("lower: a field of std's fmt::Spec that @fmt doesn't know")
            }
            add_arg{ xs = &xs, a = ir::Arg{ index = @as(u32, i), value = mk{ ty, k } } }
        }
        let spec = mk{ ty = tid{ &l, t = spec_t }, k = ir::ExprKind::record{ items = list::items{ list = xs } } }
        return mk{ ty = tid{ &l, t = wrap }, k = ir::ExprKind::record{ items = two_args{ l, a = inner, b = spec } } }
    }

    // A call of writer w with the sink and v, of the type its value field has, as a result of
    // type rt. A writer that returns nothing gives `ok` after it.
    fn write_call { mut l: Lower, s: Sink, w: check::Writer, v: ir::Expr, rt: Id, at: source::Span } -> ir::Expr {
        let targs = T_all{ &l, ts = w.targs }
        let x = check::get_decl{ c = l.c.*, d = w.decl }
        let fields = check::subst_fields{ c = l.c, fields = x.fields, decl = w.decl, args = targs }
        let fid = fn_id{ &l, decl = w.decl, targs }
        let bi: usize = if fields[0].mutable { 0 } else { 1 }
        let mut out = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        let bv = coerce{ &l, x = sink_ex{ &l, s }, frm = s.ty, to = arg_type{ &l, f = fields[bi], ptrs = true }, at }
        add_arg{ xs = &out, a = ir::Arg{ index = @as(u32, bi), value = bv } }
        add_arg{ xs = &out, a = ir::Arg{ index = @as(u32, 1 - bi), value = v } }
        let ret = types::subst{ s = &l.c.ty, t = x.ret, decl = w.decl, args = targs }
        let call = mk{ ty = tid{ &l, t = ret }, k = ir::ExprKind::call{ callee = fid, args = list::items{ list = out }, pos = pos{ &l, at } } }
        if types::prune{ s = l.c.ty, t = ret } == types::VOID {
            let ty = tid{ &l, t = rt }
            return mk{ ty, k = ir::ExprKind::seq{ first = box{ l, e = call }, then = box{ l, e = ok_of{ &l, rt } } } }
        }
        return lift{ &l, x = call, frm = ret, to = rt }
    }

    // Text as a strlit, written by w, the writer of a strlit to the sink.
    fn text_write { mut l: Lower, s: Sink, w: check::Writer, bytes: []u8, rt: Id } -> ir::Expr {
        let v = mk{ ty = tid{ &l, t = u8_slice{ &l } }, k = ir::ExprKind::sbytes{ bytes } }
        return write_call{ &l, s, w, v, rt, at = s.at }
    }

    // An error in hole h, with writers: its name, as `fs::os`, and its payload, as
    // `{ code = 5 }`, written by text, the writer of a strlit. Each field is written by the
    // writer the checker found for its type, or from its parts if there is none (shown).
    fn error_write { mut l: Lower, w: Writes, h: usize, text: check::Writer } -> ir::Expr {
        let s = w.s
        let rt = w.rt
        let set = check::set_of{ c = l.c.*, t = w.tys[h] }
        let ty = tid{ &l, t = rt }
        let mut out = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        let mut i: usize = 0
        while i < set.len {
            let d = check::get_decl{ c = l.c.*, d = set[i] }
            let fields = check::fault_fields{ c = l.c.*, d = set[i] } ifnull { slice::empty(types::Field){} }
            let ws = map::get{ m = l.c.fault_writers, key = check::fault_key{ si = w.si, d = set[i] } } ifnull { @panic("lower: an error hole's fields without writers") }
            let mut bs = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
            let mut r = text_write{ &l, s, w = text, bytes = d.qual, rt }
            let mut k: usize = 0
            while k < fields.len {
                let f = fields[k]
                let ft = tid{ &l, t = f.ty }
                let slot = temp{ &l, ty = ft }
                add_bind{ xs = &bs, b = ir::Bind{ slot, field = @as(u32, k), by_ref = false } }
                let mut tb = message{ l }
                try! @fmt(&tb, "{}{} = ", str{ s = if k == 0 { "{ " } else { ", " } }, str{ s = f.name })
                r = then{ &l, a = r, b = text_write{ &l, s, w = text, bytes = utf8::view{ b = tb }.bytes, rt }, rt }
                let v = mk{ ty = ft, k = ir::ExprKind::local{ slot } }
                let piece = if ws[k].decl == NONE { shown{ &l, w, t = f.ty, v, text } } else { write_call{ &l, s, w = ws[k], v, rt, at = s.at } }
                r = then{ &l, a = r, b = piece, rt }
                k = k + 1
            }
            if fields.len > 0 { r = then{ &l, a = r, b = text_write{ &l, s, w = text, bytes = " }", rt }, rt } }
            add_arm{ l, xs = &out, pats = one_pat{ l, p = ir::Pat{ variant = @as(u32, i), binds = list::items{ list = bs } } }, body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = box{ l, e = r } } }
            i = i + 1
        }
        return mk{ ty, k = ir::ExprKind::matchx{ scrut = box{ l, e = w.vals[h] }, through = false, arms = list::items{ list = out } } }
    }

    // ---- the exit code of a fn that returns `!` or `!i32` (spec §15, Entry point, rule 4)

    // The site of the instance that gives a fn's exit code (coding).
    const CODED: u32 = 0xFFFFFFFA

    // The id of the fn that runs fn d, whose result is a `!` or a `!i32`, and gives its exit
    // code (coding), queued the first time it is needed.
    fn coded_id { mut l: Lower, d: u32 } -> u32 {
        let mut b = list::new(u8){ realloc = arena::alloc, heap = l.heap }
        put_u32{ xs = &b, n = NONE }         // no declaration's id
        put_u32{ xs = &b, n = CODED }
        put_u32{ xs = &b, n = d }
        let key = list::items{ list = b }
        let known = map::get{ m = l.fn_ids, key }
        if known != null { return known }
        let id = @as(u32, l.queue.len)
        try! map::put{ m = &l.fn_ids, key, value = id }
        try! list::push{ list = &l.queue, item = Inst{ decl = d, targs = no_ids{}, site = CODED, widen = null, entry = NONE } }
        return id
    }

    // Fn d's exit code, as a function of d's own context: what d returns, or 0 for a bare `!`;
    // for an error 1, after d's site (check.ctx, exit_site) has written the error to standard
    // error: through an `io::Stderr` over an Io from nothing, as the runtime supplies main's.
    fn coding { mut l: Lower, id: u32, inst: Inst } -> ir::Func {
        let x = check::get_decl{ c = l.c.*, d = inst.decl }
        let si = map::get{ m = l.c.exit_sites, key = inst.decl } ifnull { @panic("lower: a fn's exit code without its site") }
        let st = list::items{ list = l.c.sites }[@as(usize, si)]
        l.decl = inst.decl
        l.targs = no_ids{}
        map::clear{ m = &l.slots }
        l.locals = list::new(ir::Local){ realloc = arena::alloc, heap = l.heap }
        l.ret = types::I32
        let i32t = tid{ &l, t = types::I32 }
        let mut params = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
        let mut args = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        for f at i in x.fields {
            let t = tid{ &l, t = f.ty }
            let held = if f.mutable { tid{ &l, t = types::ptr{ s = &l.c.ty, elem = f.ty, mutable = false } } } else { t }
            try! list::push{ list = &params, item = ir::Param{ name = f.name, mutable = f.mutable, ty = t } }
            try! list::push{ list = &l.locals, item = ir::Local{ name = f.name, ty = held } }
            add_arg{ xs = &args, a = ir::Arg{ index = @as(u32, i), value = slot_ex{ ty = held, slot = @as(u32, i) } } }
        }
        let ret = types::prune{ s = l.c.ty, t = x.ret }
        let res{ ok, errs } = types::get{ s = l.c.ty, id = ret } else { @panic("lower: an exit code of a fn that returns no `!`") }
        let rty = tid{ &l, t = ret }
        let r = temp{ &l, ty = rty }
        let mut out = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        let call = mk{ ty = rty, k = ir::ExprKind::call{ callee = fn_id{ &l, decl = inst.decl, targs = no_ids{} }, args = list::items{ list = args }, pos = nowhere{} } }
        try! list::push{ list = &out, item = ir::Stmt::define{ slot = r, init = call } }
        let mut arms = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }

        // ok: its value, or 0
        let mut fine = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        let mut ok_binds = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        if types::prune{ s = l.c.ty, t = ok } == types::VOID {
            try! list::push{ list = &fine, item = ir::Stmt::ret{ value = mk{ ty = i32t, k = ir::ExprKind::int{ negative = false, value = 0 } } } }
        } else {
            let v = temp{ &l, ty = i32t }
            add_bind{ xs = &ok_binds, b = ir::Bind{ slot = v, field = 0, by_ref = false } }
            try! list::push{ list = &fine, item = ir::Stmt::ret{ value = slot_ex{ ty = i32t, slot = v } } }
        }
        add_arm{ l, xs = &arms, pats = one_pat{ l, p = ir::Pat{ variant = 0, binds = list::items{ list = ok_binds } } }, body = ir::Block{ stmts = list::items{ list = fine }, result = null } }

        // err: the error, written by the site's pieces, then 1
        let et = tid{ &l, t = errs }
        let e = temp{ &l, ty = et }
        let mut err_binds = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
        add_bind{ xs = &err_binds, b = ir::Bind{ slot = e, field = 0, by_ref = false } }
        let mut failed = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        let sink = stderr_sink{ &l, out = &failed, st }
        let mut vals = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        let mut tys = list::new(Id){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &vals, item = slot_ex{ ty = et, slot = e } }
        try! list::push{ list = &tys, item = errs }
        let w = Writes{ s = sink, vals = list::items{ list = vals }, tys = list::items{ list = tys }, si, rt = site_result{ &l, si } }
        try! list::push{ list = &failed, item = ir::Stmt::eval{ e = pieces{ &l, w, ps = st.pieces } } }
        try! list::push{ list = &failed, item = ir::Stmt::ret{ value = mk{ ty = i32t, k = ir::ExprKind::int{ negative = false, value = 1 } } } }
        add_arm{ l, xs = &arms, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = list::items{ list = err_binds } } }, body = ir::Block{ stmts = list::items{ list = failed }, result = null } }

        try! list::push{ list = &out, item = ir::Stmt::choose{ scrut = slot_ex{ ty = rty, slot = r }, through = false, arms = list::items{ list = arms } } }
        let mut name = message{ l }
        try! @fmt(&name, "exit code of {}", str{ s = x.qual })
        return ir::Func{
            id, name = utf8::view{ b = name }.bytes, symbol = "", params = list::items{ list = params }, ret = i32t,
            locals = list::items{ list = l.locals }, body = ir::Block{ stmts = list::items{ list = out }, result = null },
            unit = unit_of{ l, x }, at = x.syn.span.start, file = file_of{ &l, x }, shown = ir::Shown::hidden,
        }
    }

    // The result of site si's writes: a bare `!` whose errors are the site's own set.
    fn site_result { mut l: Lower, si: u32 } -> Id {
        return types::res{ s = &l.c.ty, ok = types::VOID, errs = types::errs{ s = &l.c.ty, owner = check::SITE + si, one = NONE } }
    }

    // A sink for site st, which writes to std's `io::Stderr`: one made in a local, over an Io
    // from nothing, by statements added to out.
    fn stderr_sink { mut l: Lower, mut out: list::List(ir::Stmt, Heap), st: check::Site } -> Sink {
        let fields = check::get_decl{ c = l.c.*, d = check::record_decl{ c = l.c.*, t = st.sink } }.fields
        let st_ty = tid{ &l, t = st.sink }
        let io = mk{ ty = tid{ &l, t = fields[0].ty }, k = ir::ExprKind::capref }
        let held = temp{ &l, ty = st_ty }
        try! list::push{ list = &out, item = ir::Stmt::define{ slot = held, init = mk{ ty = st_ty, k = ir::ExprKind::record{ items = one_arg{ l, v = io } } } } }
        let pt = types::ptr{ s = &l.c.ty, elem = st.sink, mutable = false }
        let at = temp{ &l, ty = tid{ &l, t = pt } }
        try! list::push{ list = &out, item = ir::Stmt::define{ slot = at, init = mk{ ty = tid{ &l, t = pt }, k = ir::ExprKind::addr{ place = box{ l, e = slot_ex{ ty = st_ty, slot = held } } } } } }
        let none = syntax::Expr{ id = 0, span = st.at, at = st.at.start, k = syntax::ExprKind::error }
        return Sink{ e = none, ty = pt, slot = at, at = st.at }
    }

    // ---- @expect (spec §13, Checks)

    // An operand of an @expect's comparison that is held in a local: its slot and IR type.
    struct Kept { slot: u32, ty: u32 }

    // t in the function being lowered, with the distinct types as they are written, which
    // lowering otherwise sees through: what a writer is looked up for (shown_writer).
    fn written { mut l: Lower, t: Id } -> Id {
        l.c.ty.erased = false
        let x = T{ &l, t }
        l.c.ty.erased = true
        return x
    }

    // `@expect(t, c)`: c's value, after std's `test::check` has counted it and, for one that
    // didn't hold, started the failure's line, which the site's pieces then end
    // (check.ctx, expect_builtin). The sides of a comparison are evaluated once, the left
    // first, into locals that the comparison and the pieces both read. `@require(t, c)`, hard,
    // is the same with std's `test::require` for `test::check`, and after the pieces a call of
    // std's `test::stop`, with its `Test` from nothing, which ends the test's process;
    // whether it held is then dropped by the statement it is.
    fn expect { mut l: Lower, e: syntax::Expr, args: []syntax::Expr, hard: bool } -> ir::Expr {
        let si = map::get{ m = l.c.site_of, key = check::expr_key{ e } } ifnull { @panic("lower: an @expect that wasn't checked") }
        let st = list::items{ list = l.c.sites }[@as(usize, si)]
        let bool_ty = tid{ &l, t = types::BOOL }
        let mut slots = list::new(u32){ realloc = arena::alloc, heap = l.heap }
        let mut inits = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        let mut vals = list::new(ir::Expr){ realloc = arena::alloc, heap = l.heap }
        let mut tys = list::new(Id){ realloc = arena::alloc, heap = l.heap }
        for h in st.holes {
            let mut v = ex{ &l, e = h }
            if not (v.k is local | int | float | boolean | str | sbytes) {
                let slot = temp{ &l, ty = v.ty }
                try! list::push{ list = &slots, item = slot }
                try! list::push{ list = &inits, item = v }
                try! map::put{ m = &l.kept, key = check::expr_key{ e = h }, value = Kept{ slot, ty = v.ty } }
                v = slot_ex{ ty = v.ty, slot }
            }
            try! list::push{ list = &vals, item = v }
            try! list::push{ list = &tys, item = written{ &l, t = check::value_ty{ c = l.c.*, k = check::expr_key{ e = h } } } }
        }
        let held = ex{ &l, e = args[1] }
        for h in st.holes { _ = map::remove{ m = &l.kept, key = check::expr_key{ e = h } } }

        // test::check{ &t, held, file, line, text }
        let check = check::std_fn{ c = l.c.*, space = "test", name = if hard { "require" } else { "check" } }
        if check == NONE { @panic("lower: an @expect without std's test::check") }
        let x = check::get_decl{ c = l.c.*, d = check }
        let p = pos{ &l, at = st.at }
        let mut call = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        for f at k in x.fields {
            let to = arg_type{ &l, f, ptrs = true }
            let at = tid{ &l, t = to }
            let mut value = held
            if slice::eq_bytes{ a = f.name, b = "t" } {
                value = coerce{ &l, x = ex{ &l, e = args[0] }, frm = T{ &l, t = check::type_of_expr{ c = l.c.*, e = args[0] } }, to, at = st.at }
            } else if slice::eq_bytes{ a = f.name, b = "file" } {
                value = mk{ ty = at, k = ir::ExprKind::sbytes{ bytes = l.c.files[st.at.file].name } }
            } else if slice::eq_bytes{ a = f.name, b = "line" } {
                value = mk{ ty = at, k = ir::ExprKind::int{ negative = false, value = p.line } }
            } else if slice::eq_bytes{ a = f.name, b = "text" } {
                value = mk{ ty = at, k = ir::ExprKind::sbytes{ bytes = one_line{ l, s = check::source_text{ c = l.c.*, span = args[1].span } } } }
            } else if not slice::eq_bytes{ a = f.name, b = "held" } {
                @panic("lower: a field of std's test::check that @expect doesn't know")
            }
            add_arg{ xs = &call, a = ir::Arg{ index = @as(u32, k), value } }
        }
        let called = mk{ ty = bool_ty, k = ir::ExprKind::call{ callee = fn_id{ &l, decl = check, targs = no_ids{} }, args = list::items{ list = call }, pos = p } }

        // If it didn't hold: the rest of the failure's line.
        let k = temp{ &l, ty = bool_ty }
        let mut failed = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        let sink = stderr_sink{ &l, out = &failed, st }
        let w = Writes{ s = sink, vals = list::items{ list = vals }, tys = list::items{ list = tys }, si, rt = site_result{ &l, si } }
        try! list::push{ list = &failed, item = ir::Stmt::eval{ e = pieces{ &l, w, ps = st.pieces } } }
        // Under the line, the calls that led to this function: test::write_callers{ &t }.
        let callers = check::std_fn{ c = l.c.*, space = "test", name = "write_callers" }
        if callers != NONE {
            let mut caps = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
            for f at i in check::get_decl{ c = l.c.*, d = callers }.fields {
                add_arg{ xs = &caps, a = ir::Arg{ index = @as(u32, i), value = mk{ ty = tid{ &l, t = arg_type{ &l, f, ptrs = true } }, k = ir::ExprKind::capref } } }
            }
            try! list::push{ list = &failed, item = ir::Stmt::eval{ e = mk{ ty = tid{ &l, t = types::VOID }, k = ir::ExprKind::call{ callee = fn_id{ &l, decl = callers, targs = no_ids{} }, args = list::items{ list = caps }, pos = p } } } }
        }
        if hard {
            let stop = check::std_fn{ c = l.c.*, space = "test", name = "stop" }
            if stop == NONE { @panic("lower: a @require without std's test::stop") }
            let mut caps = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
            for f at i in check::get_decl{ c = l.c.*, d = stop }.fields {
                add_arg{ xs = &caps, a = ir::Arg{ index = @as(u32, i), value = mk{ ty = tid{ &l, t = arg_type{ &l, f, ptrs = true } }, k = ir::ExprKind::capref } } }
            }
            try! list::push{ list = &failed, item = ir::Stmt::eval{ e = mk{ ty = tid{ &l, t = types::VOID }, k = ir::ExprKind::call{ callee = fn_id{ &l, decl = stop, targs = no_ids{} }, args = list::items{ list = caps }, pos = p } } } }
        }
        let yes = mk{ ty = bool_ty, k = ir::ExprKind::boolean{ value = true } }
        let no = mk{ ty = bool_ty, k = ir::ExprKind::boolean{ value = false } }
        let then = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = box{ l, e = yes } }
        let els = ir::Block{ stmts = list::items{ list = failed }, result = box{ l, e = no } }
        let body = mk{ ty = bool_ty, k = ir::ExprKind::ifx{ c = box{ l, e = slot_ex{ ty = bool_ty, slot = k } }, then, els } }
        let mut r = mk{ ty = bool_ty, k = ir::ExprKind::with{ slot = k, init = box{ l, e = called }, body = box{ l, e = body } } }
        let ss = list::items{ list = slots }
        let xs = list::items{ list = inits }
        let mut n = ss.len
        while n > 0 {
            n = n - 1
            r = mk{ ty = r.ty, k = ir::ExprKind::with{ slot = ss[n], init = box{ l, e = xs[n] }, body = box{ l, e = r } } }
        }
        return r
    }

    // s on one line: each run of spaces, tabs and line breaks as one space.
    fn one_line { l: Lower, s: []u8 } -> []u8 {
        let mut out = list::new(u8){ realloc = arena::alloc, heap = l.heap }
        let mut gap = false
        for ch in s {
            if ch == ' ' or ch == '\t' or ch == '\r' or ch == '\n' {
                gap = true
            } else {
                if gap and out.len > 0 { try! list::push{ list = &out, item = ' ' } }
                gap = false
                try! list::push{ list = &out, item = ch }
            }
        }
        return list::items{ list = out }
    }

    // ---- a test build's entry (spec §20)

    // What the `#test_main` fn m is given besides `args`: `count`, how many tests the program
    // has; `case`, a fn that gives test `index`'s test::Case; and `run`, a fn that runs test
    // `index`, with its capabilities from nothing as main's are, and gives its exit code. Any
    // other index gives an empty Case, and 2.
    fn test_given { mut l: Lower, m: ir::Func } -> []Given {
        let mut out = list::new(Given){ realloc = arena::alloc, heap = l.heap }
        let tests = list::items{ list = l.c.tests }
        let ids = list::items{ list = l.test_ids }
        let i32t = tid{ &l, t = types::I32 }
        for q in m.params {
            if slice::eq_bytes{ a = q.name, b = "count" } {
                try! list::push{ list = &out, item = Given{ name = q.name, value = mk{ ty = q.ty, k = ir::ExprKind::int{ negative = false, value = tests.len } } } }
            }
            let cases = slice::eq_bytes{ a = q.name, b = "case" }
            if not cases and not slice::eq_bytes{ a = q.name, b = "run" } { continue }
            let func{ params, ret } = list::items{ list = l.types }[q.ty] else { continue }
            let mut a = adapter{ l }
            try! list::push{ list = &a.locals, item = ir::Local{ name = params[0].name, ty = params[0].ty } }
            let mut arms = list::new(ir::Case){ realloc = arena::alloc, heap = l.heap }
            for t at i in tests {
                let outer = a.stmts
                a.stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
                if cases {
                    try! list::push{ list = &a.stmts, item = ir::Stmt::ret{ value = case_of{ &l, ty = ret, t } } }
                } else {
                    returns_code{ &l, &a, call = supply_call{ &l, &a, f = list::items{ list = l.fns }[ids[i]], given = slice::empty(Given){} }, i32t }
                }
                let mut values = list::new(ir::Int){ realloc = arena::alloc, heap = l.heap }
                try! list::push{ list = &values, item = ir::Int{ negative = false, value = i } }
                try! list::push{ list = &arms, item = ir::Case{ values = list::items{ list = values }, ranges = slice::empty(ir::Range){}, body = ir::Block{ stmts = list::items{ list = a.stmts }, result = null } } }
                a.stmts = outer
            }
            try! list::push{ list = &a.stmts, item = ir::Stmt::switch{ scrut = slot_ex{ ty = params[0].ty, slot = 0 }, cases = list::items{ list = arms } } }
            let other = if cases { case_of{ &l, ty = ret, t = null } } else { mk{ ty = i32t, k = ir::ExprKind::int{ negative = false, value = 2 } } }
            try! list::push{ list = &a.stmts, item = ir::Stmt::ret{ value = other } }
            let id = add_adapter{ &l, a, name = if cases { "<test case>" } else { "<run test>" }, params, ret, near = m, shown = if cases { ir::Shown::hidden } else { ir::Shown::root } }
            try! list::push{ list = &out, item = Given{ name = q.name, value = mk{ ty = q.ty, k = ir::ExprKind::fnref{ callee = id } } } }
        }
        return list::items{ list = out }
    }

    // Test t as a value of std's test::Case, IR type ty: its fn's name with its namespaces, its
    // file as the compiler was given it, its line, that file's directory, for `#test{ panics = "text" }` that it
    // must panic, with the text, and for `#test{ skip = "why" }` that it isn't run, and why.
    // Without a test, a Case of nothing.
    fn case_of { mut l: Lower, ty: u32, t: ?check::TestFn } -> ir::Expr {
        let record{ fields } = list::items{ list = l.types }[ty] else { @panic("lower: a test::Case that isn't a struct") }
        let mut name = ""
        let mut file = ""
        let mut line: u64 = 0
        let mut dir = ""
        let mut panics = false
        let mut message = ""
        let mut skips = false
        let mut why = ""
        if let test = t {
            let x = check::get_decl{ c = l.c.*, d = test.decl }
            name = x.qual
            file = l.c.files[x.name.span.file].name
            dir = l.c.files[x.name.span.file].dir
            line = pos{ &l, at = x.name.span }.line
            if let text = test.panics {
                panics = true
                message = text
            }
            if let text = test.skip {
                skips = true
                why = text
            }
        }
        let mut items = list::new(ir::Arg){ realloc = arena::alloc, heap = l.heap }
        for f at i in fields {
            let mut k = ir::ExprKind::sbytes{ bytes = name }
            if slice::eq_bytes{ a = f.name, b = "file" } {
                k = ir::ExprKind::sbytes{ bytes = file }
            } else if slice::eq_bytes{ a = f.name, b = "line" } {
                k = ir::ExprKind::int{ negative = false, value = line }
            } else if slice::eq_bytes{ a = f.name, b = "dir" } {
                k = ir::ExprKind::sbytes{ bytes = dir }
            } else if slice::eq_bytes{ a = f.name, b = "panics" } {
                k = ir::ExprKind::boolean{ value = panics }
            } else if slice::eq_bytes{ a = f.name, b = "message" } {
                k = ir::ExprKind::sbytes{ bytes = message }
            } else if slice::eq_bytes{ a = f.name, b = "skips" } {
                k = ir::ExprKind::boolean{ value = skips }
            } else if slice::eq_bytes{ a = f.name, b = "why" } {
                k = ir::ExprKind::sbytes{ bytes = why }
            } else if not slice::eq_bytes{ a = f.name, b = "name" } {
                @panic("lower: a field of std's test::Case that the compiler doesn't know")
            }
            add_arg{ xs = &items, a = ir::Arg{ index = @as(u32, i), value = mk{ ty = f.ty, k } } }
        }
        return mk{ ty, k = ir::ExprKind::record{ items = list::items{ list = items } } }
    }

    // ---- a value's derived text (spec §13, Formatting, rule 10; check.ctx, shown_parts)

    // The writer of a t to site si's sink that the site sees, or one without a decl: looked up
    // with the distinct types as they are written, which lowering otherwise sees through.
    fn shown_writer { mut l: Lower, si: u32, t: Id } -> check::Writer {
        let st = list::items{ list = l.c.sites }[@as(usize, si)]
        l.c.ty.erased = false
        let found = check::writers_of{ c = l.c, b = T{ &l, t = st.sink }, t, ns = st.ns }
        l.c.ty.erased = true
        return found.one
    }

    // v, a value of type t, written to w's sink, as a result of type w.rt: by the writer its
    // site sees for a t, or without one from its parts, by t's derived text fn. A type with
    // neither, as a pointer or a function, is `_`. text is the site's writer of text.
    fn shown { mut l: Lower, w: Writes, t: Id, v: ir::Expr, text: check::Writer } -> ir::Expr {
        let found = shown_writer{ &l, si = w.si, t }
        if found.decl != NONE { return write_call{ &l, s = w.s, w = found, v, rt = w.rt, at = w.s.at } }
        match get{ l, t } {
            record | sum | enumeration | opt | array | slice => {}
            else => { return text_write{ &l, s = w.s, w = text, bytes = "_", rt = w.rt } }
        }
        let st = list::items{ list = l.c.sites }[@as(usize, w.si)]
        let to = types::ptr{ s = &l.c.ty, elem = T{ &l, t = st.sink }, mutable = false }
        let b = coerce{ &l, x = sink_ex{ &l, s = w.s }, frm = w.s.ty, to, at = w.s.at }
        let own = site_result{ &l, si = w.si }
        let call = mk{ ty = tid{ &l, t = own }, k = ir::ExprKind::call{ callee = shown_id{ &l, si = w.si, t }, args = two_args{ l, a = b, b = v }, pos = pos{ &l, at = w.s.at } } }
        return lift{ &l, x = call, frm = own, to = w.rt }
    }

    // The derived text fn of type t for site si, in the instance being lowered, queued the first
    // time it is needed.
    fn shown_id { mut l: Lower, si: u32, t: Id } -> u32 {
        let mut b = list::new(u8){ realloc = arena::alloc, heap = l.heap }
        let k = inst_key{ &l, decl = l.decl, targs = l.targs }
        for byte in k { try! list::push{ list = &b, item = byte } }
        put_u32{ xs = &b, n = NONE }         // no type's id, as a site's hidden fn has it
        put_u32{ xs = &b, n = si }
        put_u32{ xs = &b, n = norm{ &l, t } }
        let key = list::items{ list = b }
        let known = map::get{ m = l.fn_ids, key }
        if known != null { return known }
        let id = @as(u32, l.queue.len)
        try! map::put{ m = &l.fn_ids, key, value = id }
        try! list::push{ list = &l.queue, item = Inst{ decl = l.decl, targs = l.targs, site = si, widen = null, entry = t } }
        return id
    }

    // What a derived text fn is being written with: its statements, its sink and site, and the
    // site's writer of text.
    struct Showing { stmts: list::List(ir::Stmt, Heap), w: Writes, text: check::Writer }

    // The derived text fn of a type for a site: `fn{ mut b: B, v: T } -> !`, which writes v to
    // the sink part by part and returns the first write's error. A struct is `Name{ f = v, ... }`,
    // a union `Name::variant{ f = v, ... }`, an enum `Name::variant`, an optional its value or
    // `null`, an array and a slice `[v, ...]`.
    fn showing { mut l: Lower, id: u32, inst: Inst } -> ir::Func {
        let d = check::get_decl{ c = l.c.*, d = inst.decl }
        let st = list::items{ list = l.c.sites }[@as(usize, inst.site)]
        l.decl = inst.decl
        l.targs = inst.targs
        map::clear{ m = &l.slots }
        l.locals = list::new(ir::Local){ realloc = arena::alloc, heap = l.heap }
        let t = inst.entry
        let bt = T{ &l, t = st.sink }
        let sink = types::ptr{ s = &l.c.ty, elem = bt, mutable = false }
        let rt = site_result{ &l, si = inst.site }
        l.ret = rt
        let ty = tid{ &l, t }
        let mut params = list::new(ir::Param){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &params, item = ir::Param{ name = "b", mutable = true, ty = tid{ &l, t = bt } } }
        try! list::push{ list = &params, item = ir::Param{ name = "v", mutable = false, ty } }
        try! list::push{ list = &l.locals, item = ir::Local{ name = "b", ty = tid{ &l, t = sink } } }
        try! list::push{ list = &l.locals, item = ir::Local{ name = "v", ty } }
        let none = syntax::Expr{ id = 0, span = st.at, at = st.at.start, k = syntax::ExprKind::error }
        let w = Writes{ s = Sink{ e = none, ty = sink, slot = 0, at = st.at }, vals = slice::empty(ir::Expr){}, tys = no_ids{}, si = inst.site, rt }
        let text = shown_writer{ &l, si = inst.site, t = types::STRLIT }
        if text.decl == NONE { @panic("lower: derived text for a sink without a writer of text") }
        let mut g = Showing{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, w, text }
        show_parts{ &l, &g, t, v = slot_ex{ ty, slot = 1 } }
        try! list::push{ list = &g.stmts, item = ir::Stmt::ret{ value = ok_of{ &l, rt } } }
        let mut name = message{ l }
        try! @fmt(&name, "text of {}", str{ s = type_name{ l, t } })
        return ir::Func{
            id, name = utf8::view{ b = name }.bytes, symbol = "", params = list::items{ list = params }, ret = tid{ &l, t = rt },
            locals = list::items{ list = l.locals }, body = ir::Block{ stmts = list::items{ list = g.stmts }, result = null },
            unit = unit_of{ l, x = d }, at = d.syn.span.start, file = file_of{ &l, x = d }, shown = ir::Shown::hidden,
        }
    }

    // One write, x, a result of the fn's type: `let r = x`, and `return r` if it is an error.
    fn show_step { mut l: Lower, mut g: Showing, x: ir::Expr } {
        let r = temp{ &l, ty = x.ty }
        try! list::push{ list = &g.stmts, item = ir::Stmt::define{ slot = r, init = x } }
        let mut leave = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }
        try! list::push{ list = &leave, item = ir::Stmt::ret{ value = slot_ex{ ty = x.ty, slot = r } } }
        let mut arms = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
        add_arm{ l, xs = &arms, pats = one_pat{ l, p = ir::Pat{ variant = 1, binds = slice::empty(ir::Bind){} } }, body = ir::Block{ stmts = list::items{ list = leave }, result = null } }
        add_arm{ l, xs = &arms, pats = slice::empty(ir::Pat){}, body = ir::Block{ stmts = slice::empty(ir::Stmt){}, result = null } }
        try! list::push{ list = &g.stmts, item = ir::Stmt::choose{ scrut = slot_ex{ ty = x.ty, slot = r }, through = false, arms = list::items{ list = arms } } }
    }

    // Text, written as it is.
    fn show_text { mut l: Lower, mut g: Showing, bytes: []u8 } {
        show_step{ &l, &g, x = text_write{ &l, s = g.w.s, w = g.text, bytes, rt = g.w.rt } }
    }

    // `{ f = v, ... }` after `before`, a type's or a variant's name, for fields read from
    // base, a struct, or held in slots, a variant's. Without fields, `{}` if braces, as a
    // struct or a variant with an empty payload has them.
    fn show_fields { mut l: Lower, mut g: Showing, before: []u8, fields: []types::Field, base: ?ir::Expr, slots: []u32, braces: bool } {
        if fields.len == 0 {
            let mut b = message{ l }
            try! @fmt(&b, "{}{}", str{ s = before }, if braces { "{}" } else { "" })
            show_text{ &l, &g, bytes = utf8::view{ b }.bytes }
            return
        }
        for f at i in fields {
            let mut b = message{ l }
            if i == 0 { try! @fmt(&b, "{}{{ ", str{ s = before }) } else { try! utf8::push{ &b, s = ", " } }
            try! @fmt(&b, "{} = ", str{ s = f.name })
            show_text{ &l, &g, bytes = utf8::view{ b }.bytes }
            let ft = tid{ &l, t = f.ty }
            let v = if let whole = base { mk{ ty = ft, k = ir::ExprKind::field{ base = box{ l, e = whole }, index = @as(u32, i) } } } else { slot_ex{ ty = ft, slot = slots[i] } }
            show_step{ &l, &g, x = shown{ &l, w = g.w, t = f.ty, v, text = g.text } }
        }
        show_text{ &l, &g, bytes = " }" }
    }

    // The parts of v, a value of type t without a writer: g's statements for all of them.
    fn show_parts { mut l: Lower, mut g: Showing, t: Id, v: ir::Expr } {
        let x = types::undistinct{ s = l.c.ty, t }
        let bool_ty = tid{ &l, t = types::BOOL }
        let usize_ty = tid{ &l, t = types::USIZE }
        match get{ l, t = x } {
            record{ decl, args } => {
                let fields = check::subst_fields{ c = l.c, fields = check::get_decl{ c = l.c.*, d = decl }.fields, decl, args }
                show_fields{ &l, &g, before = check::get_decl{ c = l.c.*, d = decl }.qual, fields, base = v, slots = slice::empty(u32){}, braces = true }
            }
            sum{ decl } => {
                let vs = check::variants_of{ c = l.c, t = x }
                let mut arms = list::new(ir::Arm){ realloc = arena::alloc, heap = l.heap }
                for variant at i in vs {
                    let fields = variant.fields ifnull { slice::empty(types::Field){} }
                    let mut binds = list::new(ir::Bind){ realloc = arena::alloc, heap = l.heap }
                    let mut slots = list::new(u32){ realloc = arena::alloc, heap = l.heap }
                    for f at k in fields {
                        let s = temp{ &l, ty = tid{ &l, t = f.ty } }
                        add_bind{ xs = &binds, b = ir::Bind{ slot = s, field = @as(u32, k), by_ref = false } }
                        try! list::push{ list = &slots, item = s }
                    }
                    let mut name = message{ l }
                    try! @fmt(&name, "{}::{}", str{ s = check::get_decl{ c = l.c.*, d = decl }.qual }, str{ s = variant.name })
                    let mut inner = Showing{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, w = g.w, text = g.text }
                    show_fields{ &l, g = &inner, before = utf8::view{ b = name }.bytes, fields, base = null, slots = list::items{ list = slots }, braces = variant.fields != null }
                    add_arm{ l, xs = &arms, pats = one_pat{ l, p = ir::Pat{ variant = @as(u32, i), binds = list::items{ list = binds } } }, body = ir::Block{ stmts = list::items{ list = inner.stmts }, result = null } }
                }
                try! list::push{ list = &g.stmts, item = ir::Stmt::choose{ scrut = v, through = false, arms = list::items{ list = arms } } }
            }
            enumeration{ decl } => {
                let e = check::get_decl{ c = l.c.*, d = decl }
                let names = check::enum_names{ c = l.c.*, d = decl }
                let mut cases = list::new(ir::Case){ realloc = arena::alloc, heap = l.heap }
                // Each variant by its value, then any other value, which `@as` can't make.
                for i in 0..names.len + 1 {
                    let mut name = message{ l }
                    try! @fmt(&name, "{}::{}", str{ s = e.qual }, str{ s = if i < names.len { names[i] } else { "_" } })
                    let mut inner = Showing{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, w = g.w, text = g.text }
                    show_text{ &l, g = &inner, bytes = utf8::view{ b = name }.bytes }
                    let mut values = list::new(ir::Int){ realloc = arena::alloc, heap = l.heap }
                    if i < names.len { try! list::push{ list = &values, item = int_of{ v = e.values[i] } } }
                    try! list::push{ list = &cases, item = ir::Case{ values = list::items{ list = values }, ranges = slice::empty(ir::Range){}, body = ir::Block{ stmts = list::items{ list = inner.stmts }, result = null } } }
                }
                try! list::push{ list = &g.stmts, item = ir::Stmt::switch{ scrut = v, cases = list::items{ list = cases } } }
            }
            opt{ elem } => {
                let mut null_case = Showing{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, w = g.w, text = g.text }
                show_text{ &l, g = &null_case, bytes = "null" }
                let mut value = Showing{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, w = g.w, text = g.text }
                if get{ l, t = types::undistinct{ s = l.c.ty, t = elem } } is ptr {
                    show_text{ &l, g = &value, bytes = "_" }
                } else {
                    show_step{ &l, g = &value, x = shown{ &l, w = g.w, t = elem, v = payload_of{ &l, x = v, t = elem }, text = g.text } }
                }
                let c = mk{ ty = bool_ty, k = ir::ExprKind::isnull{ e = box{ l, e = v } } }
                let then = ir::Block{ stmts = list::items{ list = null_case.stmts }, result = null }
                let els = ir::Block{ stmts = list::items{ list = value.stmts }, result = null }
                try! list::push{ list = &g.stmts, item = ir::Stmt::cond{ c, then, els } }
            }
            array{ n, elem } => {
                show_elems{ &l, &g, elem, v, count = mk{ ty = usize_ty, k = ir::ExprKind::int{ negative = false, value = n } }, sliced = false }
            }
            slice{ elem } => {
                show_elems{ &l, &g, elem, v, count = mk{ ty = usize_ty, k = ir::ExprKind::field{ base = box{ l, e = v }, index = 1 } }, sliced = true }
            }
            else => { show_text{ &l, &g, bytes = "_" } }
        }
    }

    // `[v, ...]`: `let i = 0; while i < count { ", " unless i is 0; v[i]; i = i + 1 }`, over an
    // array or a slice (sliced) of elem.
    fn show_elems { mut l: Lower, mut g: Showing, elem: Id, v: ir::Expr, count: ir::Expr, sliced: bool } {
        let bool_ty = tid{ &l, t = types::BOOL }
        let usize_ty = tid{ &l, t = types::USIZE }
        let et = tid{ &l, t = elem }
        let none = ir::Pos{ line = 0, col = 0, file = 0 }
        show_text{ &l, &g, bytes = "[" }
        let si = temp{ &l, ty = usize_ty }
        let i = slot_ex{ ty = usize_ty, slot = si }
        let zero = mk{ ty = usize_ty, k = ir::ExprKind::int{ negative = false, value = 0 } }
        try! list::push{ list = &g.stmts, item = ir::Stmt::define{ slot = si, init = zero } }
        let mut inner = Showing{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, w = g.w, text = g.text }
        let mut comma = Showing{ stmts = list::new(ir::Stmt){ realloc = arena::alloc, heap = l.heap }, w = g.w, text = g.text }
        show_text{ &l, g = &comma, bytes = ", " }
        let later = mk{ ty = bool_ty, k = ir::ExprKind::cmp{ op = ir::CmpOp::gt, a = box{ l, e = i }, b = box{ l, e = zero } } }
        try! list::push{ list = &inner.stmts, item = ir::Stmt::cond{ c = later, then = ir::Block{ stmts = list::items{ list = comma.stmts }, result = null }, els = null } }
        let ev = if sliced { mk{ ty = et, k = ir::ExprKind::sindex{ base = box{ l, e = v }, i = box{ l, e = i }, pos = none } } } else { mk{ ty = et, k = ir::ExprKind::index{ base = box{ l, e = v }, i = box{ l, e = i }, pos = none } } }
        show_step{ &l, g = &inner, x = shown{ &l, w = g.w, t = elem, v = ev, text = g.text } }
        let one = mk{ ty = usize_ty, k = ir::ExprKind::int{ negative = false, value = 1 } }
        let next = mk{ ty = usize_ty, k = ir::ExprKind::arith{ op = ir::ArithOp::add, a = box{ l, e = i }, b = box{ l, e = one }, pos = none, trap = ir::NO_TRAP } }
        try! list::push{ list = &inner.stmts, item = ir::Stmt::assign{ place = i, value = next } }
        let more = mk{ ty = bool_ty, k = ir::ExprKind::cmp{ op = ir::CmpOp::lt, a = box{ l, e = i }, b = box{ l, e = count } } }
        try! list::push{ list = &g.stmts, item = ir::Stmt::loop{ c = more, body = ir::Block{ stmts = list::items{ list = inner.stmts }, result = null }, label = null } }
        show_text{ &l, &g, bytes = "]" }
    }

    // ---- text

    fn message { l: Lower } -> utf8::Builder(Heap) {
        return utf8::builder{ realloc = arena::alloc, heap = l.heap }
    }

    fn str { s: []u8 } -> utf8::String {
        return utf8::String{ bytes = s }
    }

}
