// The driver: `ctxc run` and `ctxc exe` turn a program into an executable, with nothing but ctxc
// and a C compiler, and `run` runs it.
//
//   ctxc run PATH [-- ARGS...]      builds the program at PATH and runs it with ARGS
//   ctxc exe PATH -o OUT            builds it into the executable OUT
//   ctxc interp PATH [-- ARGS...]   checks it, and runs it in the interpreter (eval.ctx)
//
// PATH is a .ctx file, or a directory: one program of all its .ctx files, or, if it has a
// build.ctx, the executables its build program describes (spec §19), of which `run` runs the
// first and `exe` writes the first to OUT. A build program is compiled and run first, with
// CTX_BUILD_OUT naming the file for its graph (std/build.ctx) and CTX_BUILD_DIR build.ctx's
// directory. It is build.ctx and the .ctx files under each directory a `#build::sources` on its
// `fn build` names, which the driver reads from build.ctx's syntax tree before compiling it. A
// build program, this one or any program whose entry is `fn build`, has std/build/'s files and
// ctxc's lexer and parser with std's (`build_extras`), for build::declarations. The program `run`
// runs has ctxc's environment, with CTX_CTXC naming ctxc's executable.
//
// ctxc finds std/ and ctxc/rt/ in its home: CTX_HOME if set, else the first directory holding
// both above its executable, else above the working directory. The C compiler is `cc`, or CTX_CC:
// the file it names, spaces and all, or else its words split at spaces, so `zig cc` works. It
// runs with the flags tools/toolchain.py uses, and its own directory first on PATH, as
// toolchain.py runs it.
//
// An executable's C is in units (emit::units, ctxc/emit_c.ctx): one for a small program, and for a
// big one units of about 256 KiB of C each (or CTX_UNIT_SIZE bytes), grouped by the files that
// declare their functions, and one with `int main`. The units are compiled at once, as many at a
// time as there are processors, and linked. A function no other unit names is static, and one of
// fewer than 32 statements and expressions (or CTX_COPY_SIZE; 0 for none) that another unit calls
// is copied into it, static, so that C can inline it there as in one file; at optimization level
// 0, which inlines nothing, it isn't.
//
// What a build writes goes under HOME/build/run. Each program has a directory of its own there,
// named after it and a hash of its absolute path, so ctxcs building different programs at once
// share no file but the runtime's objects:
//
//   ctxrt-HASH.o                 the runtime, compiled once for each runtime, compiler and flags,
//   ctxfloat-HASH.o              and floats as text (ctxc/rt/ctxfloat.c), for the programs
//                                that use them
//   PROGRAM-HASH/                a program's
//       EXE-HASH.c, EXE-HASH.o   a unit's C, to read, and its object, HASH being of its C, the
//                                runtime's sources, the C compiler and the flags
//       EXE-HASH                 the executable (EXE-HASH.exe on Windows), HASH being of its
//                                units' and the link flags; older files of EXE are removed
//       build/                   the build program's, the same way, and its graph
//       gen/EXE/NAME.ctx         the files build::gen_file gives executable EXE, for a person to
//                                open; EXE is compiled from the driver's copy of their text.
//                                Written again only when their text changes; other .ctx files
//                                there are removed
//
// So a unit whose C, runtime, compiler and flags haven't changed since it was built isn't
// compiled again, nor linked if no unit changed: the front end runs, and the C compiler doesn't.
// A unit's C depends only on its own functions, what they use and the copies it holds, so an edit
// recompiles the units of the files it touched, those that copy a small function it changed, and
// those with a function it starts or stops calling from another unit. A C compiler replaced in
// place by another version goes unnoticed; removing build/run starts afresh. Files are written
// under names no other ctxc writes to (`claim`) and renamed into place, so two ctxcs building the
// same program at once at worst do the work twice.

namespace drive {
    type Heap = arena::Arena
    type Strs = list::List([]u8, Heap)

    // An executable's optimization level (build::optimize) replaces -O1.
    const CFLAGS: [_][]u8 = ["-std=gnu11", "-O1", "-w", "-fwrapv", "-fno-optimize-sibling-calls", "-fno-strict-aliasing"]
    const LEVELS: [_][]u8 = ["-O0", "-O1", "-O2", "-O3"]

    // FNV-1a, 64 bits: what names a build's files.
    const FNV_BASIS: u64 = 14695981039346656037
    const FNV_PRIME: u64 = 1099511628211

    // About how many bytes of C a unit has, unless CTX_UNIT_SIZE says otherwise.
    const UNIT_SIZE: usize = 262144

    // A function of fewer statements and expressions than this, called from another unit, is
    // copied into it (emit::units), unless CTX_COPY_SIZE says otherwise.
    const COPY_SIZE: usize = 32

    // ctxc's lexer and parser, which a build program has with std's files (`build_extras`): what
    // parser.ctx needs, and nothing but std.
    const FRONT: [_][]u8 = ["ctxc/source.ctx", "ctxc/diag.ctx", "ctxc/lexer.ctx", "ctxc/syntax.ctx", "ctxc/parser.ctx"]

    // Where things are, and what the C compiler is and the environment entries it runs with: runs
    // is HOME/build/run, work the program's directory in it, program its name, and rt a hash of
    // the runtime's sources; extras are what a build program has with std's files. unit is
    // about how many bytes of C a unit has, copy how small a function another unit calls must be
    // to be copied into it, and jobs how many C compilers run at once.
    struct Driver { home: []u8, runs: []u8, work: []u8, program: []u8, std: [][]u8, extras: [][]u8, os: build::Os, cc: [][]u8, cc_env: [][]u8, rt: u64, unit: usize, copy: usize, jobs: u32 }

    // A C compiler compiling a unit, into o_tmp, from its C in c_tmp, to be renamed to o and c.
    struct Job { child: proc::Child, c_tmp: []u8, o_tmp: []u8, c: []u8, o: []u8 }

    // An executable to build: its root and the directories added to it, its optimization level,
    // the C compiler flags its build program gave, and the files it generates for it.
    struct Target { name: []u8, root: []u8, dirs: Strs, level: u8, paths: Strs, libs: Strs, gens: list::List(Gen, Heap) }

    // A file build::gen_file gives an executable: NAME.ctx, holding text, and once written, its
    // path, where errors in it point.
    struct Gen { name: []u8, text: []u8, path: []u8 }

    // Why describing or compiling a program failed, which `ctxc graph` tells its caller: errors
    // ctxc reported in the program (`errors`), its build program's exit code (`exited`), or
    // anything else, as a C compiler or a file that failed (`failed`).
    union Why { failed, errors, exited{ code: i32 } }

    // A directory `#build::sources` names, and where its literal is in build.ctx.
    struct Source { dir: []u8, at: u32 }

    // An executable's files, each by its path as a person would write it, and by a key that is
    // the same for every path to the file (`key_of`), to find one reached twice.
    struct Found { paths: Strs, keys: Strs }

    fn command { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, args: Args, run: bool } -> i32 {
        let ok = if run { args.len == 2 or (args.len >= 3 and slice::eq_bytes{ a = args[2], b = "--" }) } else {
            args.len == 4 and slice::eq_bytes{ a = args[2], b = "-o" }
        }
        if not ok {
            io::eprintln{ &io, s = "usage: ctxc run PATH [-- ARGS...] | ctxc exe PATH -o OUT" }
            return 2
        }
        let path = trim_slash{ path = args[1] }
        let pages = mem::reserve{ &mem, size = 16777216 } ifnull {
            io::eprintln{ &io, s = "out of memory" }
            return 1
        }
        let mut heap = arena::new{ buf = pages }
        let d = setup{ &io, &fs, &proc, &heap, path } ifnull { return 1 }
        let mut targets = list::new(Target){ realloc = arena::alloc, &heap }
        let mut why = Why::failed
        let code = describe{ &io, &fs, &mem, &proc, &heap, d, path, &targets, &why }
        if code != 0 { return code }

        let mut first = ""
        let mut i: usize = 0
        while i < targets.len {
            let t = list::items{ list = targets }[i]
            let files = program_files{ &io, &fs, &heap, d, path, t } ifnull { return 1 }
            let mut flags = list::new([]u8){ realloc = arena::alloc, &heap }
            add_all{ xs = &flags, ys = list::items{ list = t.paths } }
            add_all{ xs = &flags, ys = list::items{ list = t.libs } }
            let out: []u8 = if i == 0 and not run { args[3] } else { "" }
            let exe = compile{ &io, &fs, &mem, &proc, &heap, d, dir = d.work, name = t.name, files, gens = list::items{ list = t.gens }, level = t.level, flags = list::items{ list = flags }, out, &why } ifnull { return 1 }
            if i == 0 { first = exe }
            i = i + 1
        }
        if not run { return 0 }

        let mut argv = list::new([]u8){ realloc = arena::alloc, &heap }
        try! list::push{ list = &argv, item = first }
        if args.len > 3 { add_all{ xs = &argv, ys = args[3..] } }
        // CTX_CTXC: this ctxc, for a program that runs ctxc in turn (tools/fixpoint.ctx).
        let mut env = list::new([]u8){ realloc = arena::alloc, &heap }
        let own = proc::exe_path{ &proc }
        if own.len > 0 { try! list::push{ list = &env, item = cat{ &heap, a = "CTX_CTXC=", b = own } } }
        return started{ &io, r = proc::run{ &proc, argv = list::items{ list = argv }, env = list::items{ list = env } }, what = first }
    }

    // `ctxc graph DIR GEN LIST`: runs the build program of directory DIR as `run` does, generated
    // files and all, and writes what it describes for tools/toolchain.py, which builds the
    // executables itself. Each executable's generated files go to GEN/EXE/NAME-HASH.ctx, HASH
    // being of the text: two runs with different text never share a file, the same text keeps
    // its path, and so what the caller compiles, and its C, from run to run, and no file is
    // removed, so errors in one name a file a person can open. LIST has a record per line, its
    // fields separated by a tab:
    //
    //   status ok     the first record, or the only one when it failed: `status errors`, errors
    //                 ctxc reported in the program; `status exited N`, the build program's exit
    //                 code, 134 if it panicked; `status failed`, anything else, as a C compiler
    //   exe NAME      an executable, which the records after it describe
    //   level N       its optimization level, 0 to 3
    //   file PATH     one of its files, by its absolute path, generated ones in GEN
    //   flag FLAG     a flag that links it: -LDIR, with DIR absolute, -lLIB, or -framework
    //                 and then the framework's NAME
    //
    // The build program's output is ctxc's, and errors are reported as `run` reports them.
    fn graph { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, args: Args } -> i32 {
        if args.len != 4 {
            io::eprintln{ &io, s = "usage: ctxc graph DIR GEN LIST" }
            return 2
        }
        let path = trim_slash{ path = args[1] }
        let gen = trim_slash{ path = args[2] }
        let list_file = args[3]
        let pages = mem::reserve{ &mem, size = 16777216 } ifnull {
            io::eprintln{ &io, s = "out of memory" }
            return 1
        }
        let mut heap = arena::new{ buf = pages }
        let mut why = Why::failed
        let mut text = list::new(u8){ realloc = arena::alloc, &heap }
        let done = describe_all{ &io, &fs, &mem, &proc, &heap, path, gen, &text, &why }
        let all = if done { cat{ &heap, a = "status\tok\n", b = list::items{ list = text } } } else { status_line{ &heap, why } }
        match fs::write_all{ &fs, path = list_file, bytes = all } {
            ok => {}
            err => {
                cannot{ &io, path = list_file, what = "cannot write" }
                return 1
            }
        }
        return if done { 0 } else { 1 }
    }

    // LIST's status record for a graph that failed, why.
    fn status_line { mut heap: Heap, why: Why } -> []u8 {
        match why {
            errors => { return "status\terrors\n" }
            failed => { return "status\tfailed\n" }
            exited{ code } => {
                let mut digits: [20]u8
                return cat{ &heap, a = "status\texited\t", b = cat{ &heap, a = utf8::fmt_i64{ n = code, into = digits[..] }.bytes, b = "\n" } }
            }
        }
    }

    // For `graph`: describes the program at path into text, writing generated files to gen.
    // False after saying why it can't, and setting why.
    fn describe_all { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut heap: Heap, path: []u8, gen: []u8, mut text: list::List(u8, Heap), mut why: Why } -> bool {
        let d = setup{ &io, &fs, &proc, &heap, path } ifnull { return false }
        if kind_of{ &fs, path = join{ &heap, a = path, b = "build.ctx" } } != 1 {
            cannot{ &io, path, what = "has no build program" }
            why = Why::errors
            return false
        }
        let mut targets = list::new(Target){ realloc = arena::alloc, &heap }
        if describe{ &io, &fs, &mem, &proc, &heap, d, path, &targets, &why } != 0 { return false }
        let ts = list::items{ list = targets }
        let mut i: usize = 0
        while i < ts.len {
            let t = ts[i]
            let digit: [1]u8 = [t.level + '0']
            add_bytes{ xs = &text, s = cat{ &heap, a = cat{ &heap, a = "exe\t", b = t.name }, b = cat{ &heap, a = "\nlevel\t", b = digit[..] } } }
            let files = program_files{ &io, &fs, &heap, d, path, t } ifnull {
                why = Why::errors
                return false
            }
            let gens = list::items{ list = t.gens }
            let at = join{ &heap, a = gen, b = t.name }
            if gens.len > 0 and (not made{ &io, &fs, path = gen } or not made{ &io, &fs, path = at }) { return false }
            let mut copies = list::new([]u8){ realloc = arena::alloc, &heap }
            add_all{ xs = &copies, ys = files }
            let mut k: usize = 0
            while k < gens.len {
                let name = cat{ &heap, a = gens[k].name, b = cat{ &heap, a = "-", b = hex{ &heap, n = mix{ h = FNV_BASIS, bytes = gens[k].text } } } }
                let copy = join{ &heap, a = at, b = cat{ &heap, a = name, b = ".ctx" } }
                if not write_changed{ &io, &fs, &heap, path = copy, text = gens[k].text } { return false }
                try! list::push{ list = &copies, item = copy }
                k = k + 1
            }
            let xs = list::items{ list = copies }
            k = 0
            while k < xs.len {
                let full = absolute{ &io, &fs, &heap, path = xs[k] } ifnull { return false }
                add_bytes{ xs = &text, s = cat{ &heap, a = "\nfile\t", b = full } }
                k = k + 1
            }
            let ps = list::items{ list = t.paths }
            k = 0
            while k < ps.len {
                let full = absolute{ &io, &fs, &heap, path = ps[k][2..] } ifnull { return false }
                add_bytes{ xs = &text, s = cat{ &heap, a = "\nflag\t-L", b = full } }
                k = k + 1
            }
            let ls = list::items{ list = t.libs }
            k = 0
            while k < ls.len {
                add_bytes{ xs = &text, s = cat{ &heap, a = "\nflag\t", b = ls[k] } }
                k = k + 1
            }
            add_bytes{ xs = &text, s = "\n" }
            i = i + 1
        }
        return true
    }

    // The driver for the program at path: ctxc's home, the program's directory in HOME/build/run,
    // std's files, the runtime's hash and the C compiler. Null after saying why there is none.
    fn setup { mut io: Io, mut fs: Fs, mut proc: Proc, mut heap: Heap, path: []u8 } -> ?Driver {
        let home = find_home{ &fs, &proc, &heap } ifnull {
            io::eprintln{ &io, s = "ctxc: cannot find std/ and ctxc/rt/; set CTX_HOME to the directory that holds them" }
            return null
        }
        if kind_of{ &fs, path } == 0 {
            cannot{ &io, path, what = "cannot read" }
            return null
        }
        let os = proc::os{ &proc }
        let full = absolute{ &io, &fs, &heap, path } ifnull { return null }
        let program = stem{ path = base{ path = full } }
        let build_dir = join{ &heap, a = home, b = "build" }
        let runs = join{ &heap, a = build_dir, b = "run" }
        let work = join{ &heap, a = runs, b = tagged{ &heap, name = program, n = mix{ h = FNV_BASIS, bytes = fold{ &heap, s = full, os } } } }
        if not made{ &io, &fs, path = build_dir } or not made{ &io, &fs, path = runs } or not made{ &io, &fs, path = work } { return null }
        let std = std_files{ &io, &fs, &heap, home, os, interp = false } ifnull { return null }
        let extras = build_extras{ &io, &fs, &heap, home } ifnull { return null }
        let rt = runtime_hash{ &io, &fs, &heap, home } ifnull { return null }
        let cc = compiler{ &fs, &proc, &heap, os }
        return Driver{
            home, runs, work, program, std, extras, os, cc, cc_env = cc_env{ &proc, &heap, cc = cc[0], os }, rt,
            unit = unit_size{ &proc }, copy = copy_size{ &proc }, jobs = proc::processors{ &proc },
        }
    }

    // Adds the executables to build from the program at path to targets: those its build program
    // describes, their generated files written (`generate`), if it is a directory with a
    // build.ctx, or else the program itself. Returns 0, or an exit code after saying why not,
    // and setting why.
    fn describe { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut heap: Heap, d: Driver, path: []u8, mut targets: list::List(Target, Heap), mut why: Why } -> i32 {
        let kind = kind_of{ &fs, path }
        let build_file = normalize{ &heap, path = join{ &heap, a = path, b = "build.ctx" } }
        if kind != 2 or kind_of{ &fs, path = build_file } != 1 {
            let root: []u8 = if kind == 2 { "." } else { path }
            add_target{ &targets, &heap, name = d.program, root }
            return 0
        }
        let code = build_program{ &io, &fs, &mem, &proc, &heap, d, dir = path, build_file, &targets, &why }
        if code != 0 { return code }
        why = Why::errors
        if targets.len == 0 {
            cannot{ &io, path = build_file, what = "describes no executable" }
            return 1
        }
        // An executable's files are named after it, and Windows' names ignore case.
        let ts = list::items{ list = targets }
        let mut k: usize = 1
        while k < ts.len {
            let mut j: usize = 0
            while j < k {
                if slice::eq_bytes{ a = fold{ &heap, s = ts[j].name, os = d.os }, b = fold{ &heap, s = ts[k].name, os = d.os } } {
                    cannot{ &io, path = build_file, what = "describes two executables of the same name" }
                    return 1
                }
                j = j + 1
            }
            k = k + 1
        }
        // generate's errors are the program's, but for a file it can't write.
        if not generate{ &io, &fs, &heap, d, build_file, targets, &why } { return 1 }
        why = Why::failed
        return 0
    }

    // Target t's files, but for those it generates: path itself, a file, or those target_files
    // finds in the directory.
    fn program_files { mut io: Io, mut fs: Fs, mut heap: Heap, d: Driver, path: []u8, t: Target } -> ?[][]u8 {
        if kind_of{ &fs, path } != 2 { return one{ &heap, s = path } }
        return target_files{ &io, &fs, &heap, os = d.os, dir = path, t }
    }

    // `ctxc interp [--env NAME=VALUE | --env NAME]... PATH [-- ARGS...]`: finds std and PATH's
    // files as `run` does, then checks and lowers the program and runs it in the interpreter
    // instead of the C compiler. Its environment is ctxc's, but for each --env, which sets NAME
    // or, without a value, removes it: ctxc's own CTX_STACK and CTX_HOME needn't be the
    // program's. A directory with a build program is an error: interp doesn't run one.
    fn interp { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, args: Args } -> i32 {
        let mut at: usize = 1
        while at + 1 < args.len and slice::eq_bytes{ a = args[at], b = "--env" } { at = at + 2 }
        let edits = args[1..at]
        let shape = args.len == at + 1 or (args.len >= at + 2 and slice::eq_bytes{ a = args[at + 1], b = "--" })
        if not shape or slice::eq_bytes{ a = args[at], b = "--env" } {
            io::eprintln{ &io, s = "usage: ctxc interp [--env NAME=VALUE | --env NAME]... PATH [-- ARGS...]" }
            return 2
        }
        let path = trim_slash{ path = args[at] }
        let pages = mem::reserve{ &mem, size = 16777216 } ifnull {
            io::eprintln{ &io, s = "out of memory" }
            return 1
        }
        let mut heap = arena::new{ buf = pages }
        let home = find_home{ &fs, &proc, &heap } ifnull {
            io::eprintln{ &io, s = "ctxc: cannot find std/ and ctxc/rt/; set CTX_HOME to the directory that holds them" }
            return 1
        }
        let os = proc::os{ &proc }
        let std = std_files{ &io, &fs, &heap, home, os, interp = true } ifnull { return 1 }
        let extras = build_extras{ &io, &fs, &heap, home } ifnull { return 1 }
        let kind = kind_of{ &fs, path }
        if kind == 0 {
            cannot{ &io, path, what = "cannot read" }
            return 1
        }
        let mut files = one{ &heap, s = path }
        if kind == 2 {
            if kind_of{ &fs, path = join{ &heap, a = path, b = "build.ctx" } } == 1 {
                cannot{ &io, path, what = "has a build program, which interp doesn't run" }
                return 1
            }
            files = target_files{ &io, &fs, &heap, os, dir = path, t = new_target{ &heap, name = "", root = "." } } ifnull { return 1 }
        }
        let mut paths = list::new([]u8){ realloc = arena::alloc, &heap }
        add_all{ xs = &paths, ys = std }
        add_all{ xs = &paths, ys = files }
        let argv = if args.len >= at + 2 { args[at + 2..] } else { args[at + 1..] }
        let stack = host_stack{ &proc } / 4 * 3
        let mut units: [][]u8 = slice::empty([]u8){}
        // The program's environment: ctxc's, with the edits.
        let mut env = list::new([]u8){ realloc = arena::alloc, &heap }
        add_all{ xs = &env, ys = proc::environment{ &proc } }
        let mut k: usize = 1
        while k < edits.len {
            let e = edits[k]
            let mut n: usize = 0
            while n < e.len and e[n] != '=' { n = n + 1 }
            let mut kept = list::new([]u8){ realloc = arena::alloc, &heap }
            let xs = list::items{ list = env }
            let mut j: usize = 0
            while j < xs.len {
                if not proc::overridden{ entry = xs[j], env = one{ &heap, s = cat{ &heap, a = e[..n], b = "=" } } } { try! list::push{ list = &kept, item = xs[j] } }
                j = j + 1
            }
            if n < e.len { try! list::push{ list = &kept, item = e } }
            env = kept
            k = k + 2
        }
        return analyze{ &io, &fs, &mem, &proc, paths = list::items{ list = paths }, std_files = std.len, extras, mode = Mode::interp, out = stem{ path = base{ path } }, argv, env = list::items{ list = env }, stack, size = 0, copy = 0, made = &units, texts = slice::empty([]u8){} }
    }

    // About how many bytes of C a unit has: CTX_UNIT_SIZE, or UNIT_SIZE.
    fn unit_size { mut proc: Proc } -> usize {
        let set = proc::env{ &proc, name = "CTX_UNIT_SIZE" } ifnull { return UNIT_SIZE }
        let n = utf8::parse_u64{ s = utf8::String{ bytes = set } } ifnull { return UNIT_SIZE }
        if n == 0 { return UNIT_SIZE }
        return @as(usize, n)
    }

    // How small a function is copied into the units that call it: CTX_COPY_SIZE, 0 for none, or
    // COPY_SIZE.
    fn copy_size { mut proc: Proc } -> usize {
        let set = proc::env{ &proc, name = "CTX_COPY_SIZE" } ifnull { return COPY_SIZE }
        let n = utf8::parse_u64{ s = utf8::String{ bytes = set } } ifnull { return COPY_SIZE }
        return @as(usize, n)
    }

    // The stack std's rt lets this program use before it panics: CTX_STACK bytes, at most 200
    // MiB, or 16 MiB.
    fn host_stack { mut proc: Proc } -> u64 {
        let set = proc::env{ &proc, name = "CTX_STACK" } ifnull { return 16777216 }
        let n = utf8::parse_u64{ s = utf8::String{ bytes = set } } ifnull { return 16777216 }
        if n == 0 { return 16777216 }
        return if n > 209715200 { 209715200 } else { n }
    }

    // Compiles and runs dir's build program, and adds the executables its graph describes.
    fn build_program { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut heap: Heap, d: Driver, dir: []u8, build_file: []u8, mut targets: list::List(Target, Heap), mut why: Why } -> i32 {
        let work = join{ &heap, a = d.work, b = "build" }
        if not made{ &io, &fs, path = work } { return 1 }
        let files = gather_build_files{ &io, &fs, &heap, os = d.os, dir, build_file } ifnull {
            why = Why::errors
            return 1
        }
        let exe = compile{ &io, &fs, &mem, &proc, &heap, d, dir = work, name = "build", files, gens = slice::empty(Gen){}, level = 1, flags = slice::empty([]u8){}, out = "", &why } ifnull { return 1 }
        let graph = claim{ &io, &fs, &heap, base = join{ &heap, a = work, b = "graph" }, ext = ".txt" } ifnull { return 1 }
        defer _ = fs::remove{ &fs, path = graph }
        let mut env = list::new([]u8){ realloc = arena::alloc, &heap }
        try! list::push{ list = &env, item = cat{ &heap, a = "CTX_BUILD_OUT=", b = graph } }
        // build::declarations finds files from where build.ctx is, as the driver does.
        try! list::push{ list = &env, item = cat{ &heap, a = "CTX_BUILD_DIR=", b = escaped{ &heap, s = dir } } }
        let ran = started{ &io, r = proc::run{ &proc, argv = one{ &heap, s = exe }, env = list::items{ list = env } }, what = exe }
        if ran != 0 {
            why = Why::exited{ code = ran }
            return ran
        }
        let text = read_whole{ &io, &fs, &mem, path = graph } ifnull { return 1 }
        // One record per line, its fields separated by tabs: exe ID NAME ROOT, sources ID DIR,
        // optimize ID LEVEL, link ID LIB, framework ID NAME, libpath ID PATH, and gen ID NAME
        // SIZE, whose line SIZE bytes of text and a line break follow. Ids count from 0 in the
        // order of exe records. A graph whose last record has no line break was cut short.
        let mut i: usize = 0
        while i < text.len {
            let mut end = i
            while end < text.len and text[end] != '\n' { end = end + 1 }
            if end == text.len {
                cannot{ &io, path = graph, what = "is not a build graph" }
                why = Why::errors
                return 1
            }
            i = record{ &heap, &targets, dir, text, at = i, end } ifnull {
                cannot{ &io, path = graph, what = "is not a build graph" }
                why = Why::errors
                return 1
            }
        }
        return 0
    }

    // What a build program has with std's files (spec §19, rule 16): std/build's, which only
    // build programs have, and the files of ctxc's front end that build::declarations parses
    // with (FRONT). `analyze` adds them to a program whose entry is `fn build`, however ctxc was
    // asked to build it, as std's (main.ctx, `builds`), so std/build's `namespace build` joins
    // std's, and a namespace of the program's named like one of ctxc's shadows it rather than
    // clashing (spec §10, rule 4). Null after saying why there are none.
    fn build_extras { mut io: Io, mut fs: Fs, mut heap: Heap, home: []u8 } -> ?[][]u8 {
        let own = ctx_files{ &io, &fs, &heap, dir = join{ &heap, a = home, b = "std/build" } } ifnull { return null }
        let mut all = list::new([]u8){ realloc = arena::alloc, &heap }
        add_all{ xs = &all, ys = own }
        let mut i: usize = 0
        while i < FRONT.len {
            try! list::push{ list = &all, item = join{ &heap, a = home, b = FRONT[i] } }
            i = i + 1
        }
        return list::items{ list = all }
    }

    // s as ASCII, for CTX_BUILD_DIR: each byte that isn't printable ASCII, and each `%`, as `%`
    // and two hexadecimal digits. std's build reads it with C's getenv, which on Windows gives
    // the ANSI code page's bytes, so a path that isn't ASCII would come back as other bytes;
    // what std uses to read the environment as UTF-8 needs a Proc, which a build program
    // needn't hold (std/build/declarations.ctx, `build_dir`).
    fn escaped { mut heap: Heap, s: []u8 } -> []u8 {
        let digits = "0123456789ABCDEF"
        let mut out = list::new(u8){ realloc = arena::alloc, &heap }
        let mut i: usize = 0
        while i < s.len {
            let c = s[i]
            if c < ' ' or c > '~' or c == '%' {
                try! list::push{ list = &out, item = '%' }
                try! list::push{ list = &out, item = digits[@as(usize, c >> 4)] }
                try! list::push{ list = &out, item = digits[@as(usize, c & 15)] }
            } else {
                try! list::push{ list = &out, item = c }
            }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // The file at path, in memory from mem::pages of its size, which lasts as long as ctxc does:
    // the graph, which holds the text of every generated file, may be far larger than the
    // driver's heap. Null after saying why it can't be read.
    fn read_whole { mut io: Io, mut fs: Fs, mut mem: Mem, path: []u8 } -> ?[]u8 {
        let size = fs::size{ &fs, path } iferr {
            cannot{ &io, path, what = "cannot read" }
            return null
        }
        if size == 0 { return slice::empty(u8){} }
        let n = @as(usize, size)
        let buf = mem::pages{ &mem, size = n } ifnull {
            io::eprintln{ &io, s = "out of memory" }
            return null
        }
        let file = fs::open{ &fs, path, mode = fs::Mode::read } iferr {
            cannot{ &io, path, what = "cannot read" }
            return null
        }
        defer _ = fs::close{ &fs, file }
        let got = fs::read_at{ &fs, file, offset = 0, into = buf[..n] } iferr {
            cannot{ &io, path, what = "cannot read" }
            return null
        }
        return buf[..got]
    }

    // Adds the record text[at..end] to targets. Returns where the next record starts; null if it
    // isn't one.
    fn record { mut heap: Heap, mut targets: list::List(Target, Heap), dir: []u8, text: []u8, at: usize, end: usize } -> ?usize {
        let line = text[at..end]
        let mut fields = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut start: usize = 0
        let mut i: usize = 0
        while i <= line.len {
            if i == line.len or line[i] == '\t' {
                try! list::push{ list = &fields, item = line[start..i] }
                start = i + 1
            }
            i = i + 1
        }
        let f = list::items{ list = fields }
        if f.len < 3 { return null }
        let id = utf8::parse_u64{ s = utf8::String{ bytes = f[1] } }
        if id == null { return null }
        let kind = f[0]
        if slice::eq_bytes{ a = kind, b = "exe" } {
            if f.len != 4 or id != targets.len or not is_exe_name{ name = f[2] } { return null }
            add_target{ &targets, &heap, name = f[2], root = f[3] }
            return end + 1
        }
        if slice::eq_bytes{ a = kind, b = "gen" } {
            if f.len != 4 or id >= targets.len or not is_file_name{ name = f[2] } { return null }
            let size = utf8::parse_u64{ s = utf8::String{ bytes = f[3] } } ifnull { return null }
            if size >= text.len - end - 1 { return null }
            let from = end + 1
            let to = from + @as(usize, size)
            if text[to] != '\n' { return null }
            let t = list::at{ list = targets, i = @as(usize, id) }
            try! list::push{ list = &t.gens, item = Gen{ name = f[2], text = text[from..to], path = "" } }
            return to + 1
        }
        if f.len != 3 or id >= targets.len { return null }
        let t = list::at{ list = targets, i = @as(usize, id) }
        if slice::eq_bytes{ a = kind, b = "sources" } {
            try! list::push{ list = &t.dirs, item = f[2] }
        } else if slice::eq_bytes{ a = kind, b = "optimize" } {
            if f[2].len != 1 or f[2][0] < '0' or f[2][0] > '3' { return null }
            t.level = f[2][0] - '0'
        } else if slice::eq_bytes{ a = kind, b = "link" } {
            try! list::push{ list = &t.libs, item = cat{ &heap, a = "-l", b = f[2] } }
        } else if slice::eq_bytes{ a = kind, b = "framework" } {
            try! list::push{ list = &t.libs, item = "-framework" }
            try! list::push{ list = &t.libs, item = f[2] }
        } else if slice::eq_bytes{ a = kind, b = "libpath" } {
            try! list::push{ list = &t.paths, item = cat{ &heap, a = "-L", b = place{ &heap, dir, rel = f[2] } } }
        } else {
            return null
        }
        return end + 1
    }

    // Whether name can be an executable's, as build::exe checks: ASCII letters, digits, `_`, `-`
    // and `.`, so that folding ASCII's case finds every name Windows takes for the same, but not
    // ending in `.`, which Windows drops. The driver checks names where they leave the graph too,
    // since they name the directories it writes in.
    fn is_exe_name { name: []u8 } -> bool {
        if name.len == 0 or name[name.len - 1] == '.' { return false }
        let mut i: usize = 0
        while i < name.len {
            let c = name[i]
            if not (ascii::is_alnum{ c } or c == '_' or c == '-' or c == '.') { return false }
            i = i + 1
        }
        return true
    }

    // Whether name can be a generated file's, as build::gen_file checks: ASCII letters, digits,
    // `_` and `-`, so that it names a file in its directory on every platform, but not `build`
    // in any case, since a file named build.ctx is never an executable's.
    fn is_file_name { name: []u8 } -> bool {
        if name.len == 0 { return false }
        let word = "build"
        let mut build = name.len == word.len
        let mut i: usize = 0
        while i < name.len {
            let c = name[i]
            if not (ascii::is_alnum{ c } or c == '_' or c == '-') { return false }
            if build and ascii::to_lower{ c } != word[i] { build = false }
            i = i + 1
        }
        return not build
    }

    // ---- a build program's files

    // The build program's files: build.ctx, then those under each directory a
    // `#build::sources{ dir }` on its `fn build` names (std/build.ctx), found as add_sources's
    // are for an executable. The driver reads the attribute from build.ctx's syntax tree, before
    // there is a program to check, so `dir` must be a string literal; the checker checks the
    // attribute again when it compiles the build program, as any other. Null after reporting why
    // there are none.
    fn gather_build_files { mut io: Io, mut fs: Fs, mut heap: Heap, os: build::Os, dir: []u8, build_file: []u8 } -> ?[][]u8 {
        let mut found = Found{
            paths = list::new([]u8){ realloc = arena::alloc, &heap },
            keys = list::new([]u8){ realloc = arena::alloc, &heap },
        }
        let key = key_of{ &io, &fs, &heap, path = build_file, os } ifnull { return null }
        add_found{ &found, path = build_file, key }
        let text = fs::read_all{ &fs, &heap, realloc = arena::alloc, path = build_file } iferr {
            cannot{ &io, path = build_file, what = "cannot read" }
            return null
        }
        let mut diags = diag::new{ &heap }
        let lexed = lexer::lex{ text, file = 0, &heap, &diags }
        let tree = parser::parse{ text, file = 0, tokens = lexed.tokens, &heap, &diags }
        // What didn't parse, the compile reports.
        if diags.errors > 0 { return list::items{ list = found.paths } }
        let mut sources = list::new(Source){ realloc = arena::alloc, &heap }
        if not find_sources{ &io, &heap, path = build_file, text, decls = tree.decls, top = true, &sources } { return null }
        let xs = list::items{ list = sources }
        let mut i: usize = 0
        while i < xs.len {
            let at = place{ &heap, dir, rel = xs[i].dir }
            if kind_of{ &fs, path = at } != 2 {
                report_at{ &io, &heap, path = build_file, text, at = xs[i].at, msg = cat{ &heap, a = "no directory ", b = at } }
                return null
            }
            let n = add_files{ &io, &fs, &heap, os, &found, dir = at, deep = true } ifnull { return null }
            if n == 0 {
                report_at{ &io, &heap, path = build_file, text, at = xs[i].at, msg = cat{ &heap, a = cat{ &heap, a = "no .ctx files in ", b = at }, b = " or below" } }
                return null
            }
            i = i + 1
        }
        return list::items{ list = found.paths }
    }

    // Adds to sources the `dir` of each `#build::sources` on a top-level `fn build` among decls,
    // and looks for others in namespaces and on fields. False after reporting one elsewhere, or
    // one whose `dir` isn't a string literal that isn't empty.
    fn find_sources { mut io: Io, mut heap: Heap, path: []u8, text: []u8, decls: []syntax::Decl, top: bool, mut sources: list::List(Source, Heap) } -> bool {
        let misplaced = "`build::sources` applies only to the build program's `fn build`"
        let mut i: usize = 0
        while i < decls.len {
            let x = decls[i]
            let mut entry = false
            if x.k is func{ name, external } { entry = top and not external and slice::eq_bytes{ a = name.text, b = "build" } }
            let mut k: usize = 0
            while k < x.attrs.len {
                let a = x.attrs[k]
                if is_sources{ a } {
                    if not entry {
                        report_at{ &io, &heap, path, text, at = a.span.start, msg = misplaced }
                        return false
                    }
                    let s = sources_dir{ a }
                    if s.dir.len == 0 {
                        report_at{ &io, &heap, path, text, at = s.at, msg = "`build::sources` takes `dir`, a string literal that isn't empty" }
                        return false
                    }
                    try! list::push{ list = &sources, item = s }
                }
                k = k + 1
            }
            let mut on_field: ?u32 = null
            match x.k {
                space{ decls = inner } => {
                    if not find_sources{ &io, &heap, path, text, decls = inner, top = false, &sources } { return false }
                }
                cap{ fields } => { if fields != null { on_field = find_field_sources{ fields } } }
                record{ fields } => { on_field = find_field_sources{ fields } }
                fault{ fields } => { if fields != null { on_field = find_field_sources{ fields } } }
                sum{ variants } => {
                    let mut j: usize = 0
                    while j < variants.len and on_field == null {
                        if let value = variants[j].fields { on_field = find_field_sources{ fields = value } }
                        j = j + 1
                    }
                }
                func{ params } => {
                    let mut j: usize = 0
                    while j < params.len and on_field == null {
                        on_field = find_attr_sources{ xs = params[j].attrs }
                        j = j + 1
                    }
                }
                else => {}
            }
            if let value = on_field {
                report_at{ &io, &heap, path, text, at = value, msg = misplaced }
                return false
            }
            i = i + 1
        }
        return true
    }

    // Where the first `#build::sources` on one of fields is, if one has it.
    fn find_field_sources { fields: []syntax::Field } -> ?u32 {
        let mut i: usize = 0
        while i < fields.len {
            let at = find_attr_sources{ xs = fields[i].attrs }
            if at != null { return at }
            i = i + 1
        }
        return null
    }

    // Where the first `#build::sources` among xs is, if there is one.
    fn find_attr_sources { xs: []syntax::Attr } -> ?u32 {
        let mut i: usize = 0
        while i < xs.len {
            if is_sources{ a = xs[i] } { return xs[i].span.start }
            i = i + 1
        }
        return null
    }

    // Whether a is `#build::sources{ ... }`, as it is written.
    fn is_sources { a: syntax::Attr } -> bool {
        let braced{ callee } = a.value.k else { return false }
        let path{ segs } = callee.k else { return false }
        return segs.len == 2 and segs[0].targs == null and segs[1].targs == null
               and slice::eq_bytes{ a = segs[0].name.text, b = "build" } and slice::eq_bytes{ a = segs[1].name.text, b = "sources" }
    }

    // The `dir` of `#build::sources{ dir = "..." }`, and where it is; an empty dir, if it isn't
    // a string literal that isn't empty, where `dir` is or else where the attribute is.
    fn sources_dir { a: syntax::Attr } -> Source {
        let missing = Source{ dir = "", at = a.span.start }
        let braced{ items } = a.value.k else { return missing }
        let mut i: usize = 0
        while i < items.len {
            let it = items[i]
            if not it.spread and slice::eq_bytes{ a = it.name.text, b = "dir" } {
                let str{ bytes } = it.value.k else { return Source{ dir = "", at = it.value.at } }
                return Source{ dir = bytes, at = it.value.at }
            }
            i = i + 1
        }
        return missing
    }

    // "PATH:LINE:COL: error: MSG" for offset `at` in path's text, as the front end reports an
    // error (main.ctx, `error`).
    fn report_at { mut io: Io, mut heap: Heap, path: []u8, text: []u8, at: u32, msg: []u8 } {
        let p = source::position{ text, lines = source::line_starts{ text, &heap }, offset = at }
        let mut b = utf8::builder{ realloc = arena::alloc, &heap }
        _ = @fmt(&b, "{}:{}:{}: error: {}\n", path, p.line, p.col, msg)
        io::write{ &io, to = io::Stream::err, bytes = utf8::view{ b }.bytes }
    }

    // ---- generated files

    // Writes the files build::gen_file gives each executable to WORK/gen/EXE/NAME.ctx, for a
    // person to open where errors in them point, and sets their paths. An executable is
    // compiled from the text the driver holds, not from the file, so another ctxc building the
    // same program at once can't change what this one compiles. A file whose text hasn't
    // changed isn't written again. False after saying why it can't.
    fn generate { mut io: Io, mut fs: Fs, mut heap: Heap, d: Driver, build_file: []u8, targets: list::List(Target, Heap), mut why: Why } -> bool {
        let top = join{ &heap, a = d.work, b = "gen" }
        let ts = list::items{ list = targets }
        let mut i: usize = 0
        while i < ts.len {
            let t = ts[i]
            let gens = list::items{ list = t.gens }
            if gens.len > 0 {
                let at = join{ &heap, a = top, b = t.name }
                if not made{ &io, &fs, path = top } or not made{ &io, &fs, path = at } {
                    why = Why::failed
                    return false
                }
                let mut k: usize = 0
                while k < gens.len {
                    let file = cat{ &heap, a = gens[k].name, b = ".ctx" }
                    let mut j: usize = 0
                    while j < k {
                        if slice::eq_bytes{ a = fold{ &heap, s = gens[j].name, os = d.os }, b = fold{ &heap, s = gens[k].name, os = d.os } } {
                            let what = cat{ &heap, a = cat{ &heap, a = "gives executable ", b = t.name }, b = cat{ &heap, a = " two files named ", b = file } }
                            cannot{ &io, path = build_file, what = utf8::String{ bytes = what } }
                            return false
                        }
                        j = j + 1
                    }
                    // As a person would write it, as errors in it name it.
                    let path = normalize{ &heap, path = join{ &heap, a = at, b = file } }
                    if not write_changed{ &io, &fs, &heap, path, text = gens[k].text } {
                        why = Why::failed
                        return false
                    }
                    gens[k].path = path
                    k = k + 1
                }
            }
            i = i + 1
        }
        remove_stale{ &fs, &heap, os = d.os, top, ts }
        return true
    }

    // Removes what earlier builds generated that this one doesn't: from each directory in top
    // (WORK/gen), the .ctx files that aren't its executable's generated files now, looking no
    // deeper, and then the directory, if its executable generates none and it is empty; and top,
    // if nothing is generated. These are copies for a person (`generate`), and only ctxc writes
    // in its build directory, so a link planted there, which this would follow, is out of scope.
    fn remove_stale { mut fs: Fs, mut heap: Heap, os: build::Os, top: []u8, ts: []Target } {
        let dirs = fs::list{ &fs, &heap, realloc = arena::alloc, path = top } iferr { return }
        let mut any = false
        let mut i: usize = 0
        while i < dirs.len {
            let at = join{ &heap, a = top, b = dirs[i] }
            let mut gens: []Gen = slice::empty(Gen){}
            let mut k: usize = 0
            while k < ts.len {
                if slice::eq_bytes{ a = fold{ &heap, s = ts[k].name, os }, b = fold{ &heap, s = dirs[i], os } } { gens = list::items{ list = ts[k].gens } }
                k = k + 1
            }
            if gens.len > 0 { any = true }
            match fs::list{ &fs, &heap, realloc = arena::alloc, path = at } {
                ok{ value = names } => {
                    let mut j: usize = 0
                    while j < names.len {
                        let file = join{ &heap, a = at, b = names[j] }
                        if ends_with{ s = names[j], suffix = ".ctx" } and not generates{ &heap, gens, file = names[j], os } and kind_of{ &fs, path = file } == 1 {
                            _ = fs::remove{ &fs, path = file }
                        }
                        j = j + 1
                    }
                    if gens.len == 0 { _ = fs::remove_dir{ &fs, path = at } }
                }
                err => {}
            }
            i = i + 1
        }
        if not any { _ = fs::remove_dir{ &fs, path = top } }
    }

    // Whether file is NAME.ctx for one of gens.
    fn generates { mut heap: Heap, gens: []Gen, file: []u8, os: build::Os } -> bool {
        let name = fold{ &heap, s = stem{ path = file }, os }
        let mut i: usize = 0
        while i < gens.len {
            if slice::eq_bytes{ a = fold{ &heap, s = gens[i].name, os }, b = name } { return true }
            i = i + 1
        }
        return false
    }

    // Writes text to the file at path unless it holds that already: through a file of its own,
    // renamed into place. Unlike an object's, a generated file's name doesn't say what it holds,
    // so a rename that fails is a failure unless the file holds the text after all, as another
    // ctxc building the same program may have written it. False after saying why it can't.
    fn write_changed { mut io: Io, mut fs: Fs, mut heap: Heap, path: []u8, text: []u8 } -> bool {
        if holds{ &fs, path, text } { return true }
        let tmp = claim{ &io, &fs, &heap, base = path, ext = ".tmp" } ifnull { return false }
        match fs::write_all{ &fs, path = tmp, bytes = text } {
            ok => {}
            err => {
                cannot{ &io, path = tmp, what = "cannot write" }
                _ = fs::remove{ &fs, path = tmp }
                return false
            }
        }
        match fs::rename{ &fs, from = tmp, to = path } {
            ok => { return true }
            err => {}
        }
        _ = fs::remove{ &fs, path = tmp }
        if holds{ &fs, path, text } { return true }
        cannot{ &io, path, what = "cannot write" }
        return false
    }

    // Whether the file at path holds text, read a piece at a time, since text may be large.
    fn holds { mut fs: Fs, path: []u8, text: []u8 } -> bool {
        let size = fs::size{ &fs, path } iferr { return false }
        if size != text.len { return false }
        let file = fs::open{ &fs, path, mode = fs::Mode::read } iferr { return false }
        defer _ = fs::close{ &fs, file }
        let mut buf: [65536]u8
        let mut at: usize = 0
        while at < text.len {
            let n = fs::read{ &fs, file, into = buf[..] } iferr { return false }
            if n == 0 or n > text.len - at or not slice::eq_bytes{ a = buf[..n], b = text[at..at + n] } { return false }
            at = at + n
        }
        // and nothing after it, should the file have grown since its size was read
        let more = fs::read{ &fs, file, into = buf[..1] } iferr { return false }
        return more == 0
    }

    // ---- an executable's files

    // Target t's files, for the build program in dir: its root's .ctx files, then those under
    // each directory added to it, each file once, but for those it generates. Its root may have
    // none if it generates some. Null after saying why there are none.
    fn target_files { mut io: Io, mut fs: Fs, mut heap: Heap, os: build::Os, dir: []u8, t: Target } -> ?[][]u8 {
        let mut found = Found{
            paths = list::new([]u8){ realloc = arena::alloc, &heap },
            keys = list::new([]u8){ realloc = arena::alloc, &heap },
        }
        let root = place{ &heap, dir, rel = t.root }
        let n = add_files{ &io, &fs, &heap, os, &found, dir = root, deep = false } ifnull { return null }
        if n == 0 and t.gens.len == 0 {
            cannot{ &io, path = root, what = "no .ctx files in directory" }
            return null
        }
        let dirs = list::items{ list = t.dirs }
        let mut i: usize = 0
        while i < dirs.len {
            let at = place{ &heap, dir, rel = dirs[i] }
            let m = add_files{ &io, &fs, &heap, os, &found, dir = at, deep = true } ifnull { return null }
            if m == 0 {
                cannot{ &io, path = at, what = "no .ctx files in directory or below" }
                return null
            }
            i = i + 1
        }
        return list::items{ list = found.paths }
    }

    // Adds the .ctx files in dir to found, but none named build.ctx, and if deep those in its
    // subdirectories, at any depth. Returns how many it saw, including any found already; null
    // after saying why it can't.
    fn add_files { mut io: Io, mut fs: Fs, mut heap: Heap, os: build::Os, mut found: Found, dir: []u8, deep: bool } -> ?usize {
        let key = key_of{ &io, &fs, &heap, path = dir, os } ifnull { return null }
        return add_tree{ &io, &fs, &heap, os, &found, dir, key, deep }
    }

    fn add_tree { mut io: Io, mut fs: Fs, mut heap: Heap, os: build::Os, mut found: Found, dir: []u8, key: []u8, deep: bool } -> ?usize {
        let names = fs::list{ &fs, &heap, realloc = arena::alloc, path = dir } iferr {
            cannot{ &io, path = dir, what = "cannot list" }
            return null
        }
        let mut seen: usize = 0
        let mut below = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut i: usize = 0
        while i < names.len {
            let n = names[i]
            let p = join{ &heap, a = dir, b = n }
            if ends_with{ s = n, suffix = ".ctx" } {
                if not slice::eq_bytes{ a = n, b = "build.ctx" } {
                    seen = seen + 1
                    add_found{ &found, path = p, key = join{ &heap, a = key, b = fold{ &heap, s = n, os } } }
                }
            } else if deep and kind_of{ &fs, path = p } == 2 {
                try! list::push{ list = &below, item = n }
            }
            i = i + 1
        }
        let subs = list::items{ list = below }
        i = 0
        while i < subs.len {
            let sub = subs[i]
            let m = add_tree{ &io, &fs, &heap, os, &found, dir = join{ &heap, a = dir, b = sub }, key = join{ &heap, a = key, b = fold{ &heap, s = sub, os } }, deep } ifnull { return null }
            seen = seen + m
            i = i + 1
        }
        return seen
    }

    fn add_found { mut found: Found, path: []u8, key: []u8 } {
        let keys = list::items{ list = found.keys }
        let mut i: usize = 0
        while i < keys.len {
            if slice::eq_bytes{ a = keys[i], b = key } { return }
            i = i + 1
        }
        try! list::push{ list = &found.paths, item = path }
        try! list::push{ list = &found.keys, item = key }
    }

    // ---- compiling

    // Builds the program of files and gens, with std's, into an executable: `out`, or if out is
    // empty dir/NAME-HASH, which stays to be run again while HASH is the same. Each unit of its C
    // is compiled into dir/NAME-HASH.o unless that is there, its C going to dir/NAME-HASH.c.
    // Returns the executable; null after saying why there is none, and setting why to errors if
    // the program has errors.
    fn compile { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut heap: Heap, d: Driver, dir: []u8, name: []u8, files: [][]u8, gens: []Gen, level: u8, flags: [][]u8, out: []u8, mut why: Why } -> ?[]u8 {
        let base = join{ &heap, a = dir, b = name }
        let mut paths = list::new([]u8){ realloc = arena::alloc, &heap }
        add_all{ xs = &paths, ys = d.std }
        add_all{ xs = &paths, ys = files }
        // A generated file is compiled from the text the driver holds, under its path.
        let mut texts = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut k: usize = 0
        while k < gens.len {
            try! list::push{ list = &paths, item = gens[k].path }
            try! list::push{ list = &texts, item = gens[k].text }
            k = k + 1
        }
        let mut units: [][]u8 = slice::empty([]u8){}
        let code = analyze{ &io, &fs, &mem, &proc, paths = list::items{ list = paths }, std_files = d.std.len, extras = d.extras, mode = Mode::units, out = "", argv = slice::empty([]u8){}, env = slice::empty([]u8){}, stack = 0, size = d.unit, copy = if level == 0 { 0 } else { d.copy }, made = &units, texts = list::items{ list = texts } }
        if code != 0 {
            why = Why::errors
            return null
        }

        // A unit's HASH is of its C, the runtime, the compiler, the flags and the program's name;
        // the executable's, of its units' and the link flags.
        let cflags = c_flags{ &heap, level }
        let ldflags = link_flags{ &heap, os = d.os, flags }
        let mut h = mix_u64{ h = FNV_BASIS, n = d.rt }
        h = mix_all{ h, xs = d.cc }
        h = mix_all{ h, xs = cflags }
        h = mix_all{ h, xs = one{ &heap, s = name } }
        let mut keep = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut x = mix_all{ h, xs = ldflags }
        let mut i: usize = 0
        while i < units.len {
            let u = hex{ &heap, n = mix{ h, bytes = units[i] } }
            try! list::push{ list = &keep, item = u }
            x = mix{ h = x, bytes = u }
            i = i + 1
        }
        let hash = hex{ &heap, n = x }
        try! list::push{ list = &keep, item = hash }
        let suffix = if d.os == build::Os::windows { ".exe" } else { "" }
        let exe = if out.len > 0 { out } else { cat{ &heap, a = cat{ &heap, a = cat{ &heap, a = base, b = "-" }, b = hash }, b = suffix } }
        if out.len == 0 and kind_of{ &fs, path = exe } == 1 { return exe }

        // The units whose objects aren't there, d.jobs at a time.
        let rt = join{ &heap, a = d.home, b = "ctxc/rt" }
        let hashes = list::items{ list = keep }
        let mut objs = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut jobs = list::new(Job){ realloc = arena::alloc, &heap }
        let mut waited: usize = 0                   // jobs[..waited] are done
        let mut good = true
        i = 0
        while i < units.len {
            let unit = units[i]
            let tag = cat{ &heap, a = cat{ &heap, a = base, b = "-" }, b = hashes[i] }
            let obj = cat{ &heap, a = tag, b = ".o" }
            try! list::push{ list = &objs, item = obj }
            i = i + 1
            if not good or kind_of{ &fs, path = obj } == 1 { continue }
            if jobs.len - waited >= @as(usize, d.jobs) {
                if not finish{ &io, &fs, &proc, d, job = list::items{ list = jobs }[waited] } { good = false }
                waited = waited + 1
            }
            let c_tmp = claim{ &io, &fs, &heap, base = tag, ext = ".c" } ifnull {
                good = false
                continue
            }
            match fs::write_all{ &fs, path = c_tmp, bytes = unit } {
                ok => {}
                err => {
                    cannot{ &io, path = c_tmp, what = "cannot write" }
                    _ = fs::remove{ &fs, path = c_tmp }
                    good = false
                    continue
                }
            }
            let o_tmp = claim{ &io, &fs, &heap, base = tag, ext = ".o" } ifnull {
                _ = fs::remove{ &fs, path = c_tmp }
                good = false
                continue
            }
            let mut argv = list::new([]u8){ realloc = arena::alloc, &heap }
            add_all{ xs = &argv, ys = d.cc }
            add_all{ xs = &argv, ys = cflags }
            try! list::push{ list = &argv, item = "-I" }
            try! list::push{ list = &argv, item = rt }
            try! list::push{ list = &argv, item = cat{ &heap, a = cat{ &heap, a = "-DCTX_PROGRAM_NAME=\"", b = name }, b = "\"" } }
            try! list::push{ list = &argv, item = "-c" }
            try! list::push{ list = &argv, item = c_tmp }
            try! list::push{ list = &argv, item = "-o" }
            try! list::push{ list = &argv, item = o_tmp }
            match proc::spawn{ &proc, argv = list::items{ list = argv }, options = proc::Options{ env = d.cc_env, .. } } {
                ok{ value } => { try! list::push{ list = &jobs, item = Job{ child = value, c_tmp, o_tmp, c = cat{ &heap, a = tag, b = ".c" }, o = obj } } }
                err{ error } => {
                    _ = started{ &io, r = error, what = d.cc[0] }
                    _ = fs::remove{ &fs, path = c_tmp }
                    _ = fs::remove{ &fs, path = o_tmp }
                    good = false
                }
            }
        }
        while waited < jobs.len {
            if not finish{ &io, &fs, &proc, d, job = list::items{ list = jobs }[waited] } { good = false }
            waited = waited + 1
        }
        if not good { return null }
        let rt_obj = runtime_object{ &io, &fs, &proc, &heap, d, rt, cflags, name = "ctxrt" } ifnull { return null }
        let mut float_obj = ""
        if uses_float{ units } {
            float_obj = runtime_object{ &io, &fs, &proc, &heap, d, rt, cflags, name = "ctxfloat" } ifnull { return null }
        }
        let mut thread_obj = ""
        if uses_threads{ units } {
            thread_obj = runtime_object{ &io, &fs, &proc, &heap, d, rt, cflags, name = "ctxthread" } ifnull { return null }
        }

        let mut into = out
        if out.len == 0 {
            into = claim{ &io, &fs, &heap, base, ext = suffix } ifnull { return null }
        }
        let mut argv = list::new([]u8){ realloc = arena::alloc, &heap }
        add_all{ xs = &argv, ys = d.cc }
        try! list::push{ list = &argv, item = "-o" }
        try! list::push{ list = &argv, item = into }
        // Many objects go in a response file: Windows takes a command line of 32K characters.
        let mut rsp = ""
        if objs.len > 64 {
            rsp = claim{ &io, &fs, &heap, base, ext = ".rsp" } ifnull { return null }
            let ok = fs::write_all{ &fs, path = rsp, bytes = quoted{ &heap, xs = list::items{ list = objs } } } else {
                cannot{ &io, path = rsp, what = "cannot write" }
                _ = fs::remove{ &fs, path = rsp }
                return null
            }
            try! list::push{ list = &argv, item = cat{ &heap, a = "@", b = rsp } }
        } else {
            add_all{ xs = &argv, ys = list::items{ list = objs } }
        }
        try! list::push{ list = &argv, item = rt_obj }
        if float_obj.len > 0 { try! list::push{ list = &argv, item = float_obj } }
        if thread_obj.len > 0 { try! list::push{ list = &argv, item = thread_obj } }
        add_all{ xs = &argv, ys = ldflags }
        // glibc before 2.34 keeps threads in a library of their own
        if thread_obj.len > 0 and d.os == build::Os::linux { try! list::push{ list = &argv, item = "-lpthread" } }
        let linked = compiled{ &io, &proc, d, argv = list::items{ list = argv } }
        if rsp.len > 0 { _ = fs::remove{ &fs, path = rsp } }
        if not linked {
            if out.len == 0 { _ = fs::remove{ &fs, path = into } }
            return null
        }
        if out.len == 0 and not publish{ &io, &fs, tmp = into, file = exe } { return null }
        sweep{ &fs, &heap, dir, name, keep = hashes, suffix }
        return exe
    }

    // xs as a response file's lines, for gcc's and clang's `@FILE`: each in double quotes, with
    // `\` and `"` escaped.
    fn quoted { mut heap: Heap, xs: [][]u8 } -> []u8 {
        let mut out = list::new(u8){ realloc = arena::alloc, &heap }
        let mut i: usize = 0
        while i < xs.len {
            try! list::push{ list = &out, item = '"' }
            let x = xs[i]
            let mut k: usize = 0
            while k < x.len {
                if x[k] == '\\' or x[k] == '"' { try! list::push{ list = &out, item = '\\' } }
                try! list::push{ list = &out, item = x[k] }
                k = k + 1
            }
            try! list::push{ list = &out, item = '"' }
            try! list::push{ list = &out, item = '\n' }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // Waits for a unit's C compiler, and puts its object and C in place. False after saying it
    // failed.
    fn finish { mut io: Io, mut fs: Fs, mut proc: Proc, d: Driver, job: Job } -> bool {
        let mut child = job.child
        let code = started{ &io, r = proc::wait{ &proc, &child }, what = d.cc[0] }
        if code != 0 {
            io::eprintln{ &io, s = "ctxc: the C compiler failed" }
            _ = fs::remove{ &fs, path = job.c_tmp }
            _ = fs::remove{ &fs, path = job.o_tmp }
            return false
        }
        if not publish{ &io, &fs, tmp = job.o_tmp, file = job.o } {
            _ = fs::remove{ &fs, path = job.c_tmp }
            return false
        }
        match fs::rename{ &fs, from = job.c_tmp, to = job.c } {
            ok => {}
            err => { _ = fs::remove{ &fs, path = job.c_tmp } }
        }
        return true
    }

    // Whether a program's C uses ctxfloat.c, whose functions' names all start with ctx_float_
    // or ctx_f2i_: std's ascii natives and the float-to-integer @as (ctxrt.h).
    fn uses_float { units: [][]u8 } -> bool {
        let mut i: usize = 0
        while i < units.len {
            if contains{ s = units[i], part = "ctx_float_" } or contains{ s = units[i], part = "ctx_f2i_" } { return true }
            i = i + 1
        }
        return false
    }

    // Whether a program's C is threaded (spec §15, Entry point, rule 8) and needs ctxthread.c:
    // its functions' names start with ctx_thread_, and a threaded program's main calls one.
    fn uses_threads { units: [][]u8 } -> bool {
        let mut i: usize = 0
        while i < units.len {
            if contains{ s = units[i], part = "ctx_thread_" } { return true }
            i = i + 1
        }
        return false
    }

    fn contains { s: []u8, part: []u8 } -> bool {
        if part.len == 0 { return true }
        let mut i: usize = 0
        while i + part.len <= s.len {
            if s[i] == part[0] and slice::eq_bytes{ a = s[i..i + part.len], b = part } { return true }
            i = i + 1
        }
        return false
    }

    // Runtime file NAME.c compiled with cflags: HOME/build/run/NAME-HASH.o, which every program built
    // with the same runtime, compiler and flags shares. Null after saying why there is none.
    fn runtime_object { mut io: Io, mut fs: Fs, mut proc: Proc, mut heap: Heap, d: Driver, rt: []u8, cflags: [][]u8, name: []u8 } -> ?[]u8 {
        let mut h = mix_u64{ h = FNV_BASIS, n = d.rt }
        h = mix_all{ h, xs = d.cc }
        h = mix_all{ h, xs = cflags }
        let base = join{ &heap, a = d.runs, b = name }
        let obj = cat{ &heap, a = cat{ &heap, a = base, b = "-" }, b = cat{ &heap, a = hex{ &heap, n = h }, b = ".o" } }
        if kind_of{ &fs, path = obj } == 1 { return obj }
        let tmp = claim{ &io, &fs, &heap, base, ext = ".o" } ifnull { return null }
        let mut argv = list::new([]u8){ realloc = arena::alloc, &heap }
        add_all{ xs = &argv, ys = d.cc }
        add_all{ xs = &argv, ys = cflags }
        try! list::push{ list = &argv, item = "-I" }
        try! list::push{ list = &argv, item = rt }
        try! list::push{ list = &argv, item = "-c" }
        try! list::push{ list = &argv, item = join{ &heap, a = rt, b = cat{ &heap, a = name, b = ".c" } } }
        try! list::push{ list = &argv, item = "-o" }
        try! list::push{ list = &argv, item = tmp }
        if not compiled{ &io, &proc, d, argv = list::items{ list = argv } } {
            _ = fs::remove{ &fs, path = tmp }
            return null
        }
        if not publish{ &io, &fs, tmp, file = obj } { return null }
        return obj
    }

    // CFLAGS at optimization level `level`.
    fn c_flags { mut heap: Heap, level: u8 } -> [][]u8 {
        let mut xs = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut i: usize = 0
        while i < CFLAGS.len {
            let flag = if slice::eq_bytes{ a = CFLAGS[i], b = "-O1" } { LEVELS[@as(usize, level)] } else { CFLAGS[i] }
            try! list::push{ list = &xs, item = flag }
            i = i + 1
        }
        return list::items{ list = xs }
    }

    // What links an executable, after its objects: its build program's flags, the math library,
    // and the main thread's stack, which std's rt checks against 16 MiB (or CTX_STACK) and on
    // Linux raises itself.
    fn link_flags { mut heap: Heap, os: build::Os, flags: [][]u8 } -> [][]u8 {
        let mut xs = list::new([]u8){ realloc = arena::alloc, &heap }
        add_all{ xs = &xs, ys = flags }
        try! list::push{ list = &xs, item = "-lm" }
        match os {
            windows => { try! list::push{ list = &xs, item = "-Wl,--stack,268435456" } }
            macos => { try! list::push{ list = &xs, item = "-Wl,-stack_size,0x10000000" } }
            linux => {}
        }
        return list::items{ list = xs }
    }

    // Runs the C compiler; false after saying it failed.
    fn compiled { mut io: Io, mut proc: Proc, d: Driver, argv: [][]u8 } -> bool {
        if started{ &io, r = proc::run{ &proc, argv, env = d.cc_env }, what = d.cc[0] } != 0 {
            io::eprintln{ &io, s = "ctxc: the C compiler failed" }
            return false
        }
        return true
    }

    // A program's exit code, or 1 after saying why it didn't start.
    fn started { mut io: Io, r: !i32, what: []u8 } -> i32 {
        match r {
            ok{ value } => { return value }
            err{ error } => {
                match error {
                    proc::not_found => { cannot{ &io, path = what, what = "no such program (set CTX_CC for another C compiler)" } }
                    proc::permission_denied => { cannot{ &io, path = what, what = "permission denied" } }
                    else => { cannot{ &io, path = what, what = "cannot start" } }
                }
                return 1
            }
        }
    }

    // ---- the files a build writes

    // A new, empty file BASE.N EXT, for the first N from 0 that no file has: no other ctxc writes
    // to it, even one building the same program. Null after saying why there is none.
    fn claim { mut io: Io, mut fs: Fs, mut heap: Heap, base: []u8, ext: []u8 } -> ?[]u8 {
        let digits = try! alloc::make(u8, Heap){ realloc = arena::alloc, &heap, count = 20 }
        let mut n: u64 = 0
        while n < 1000 {
            let p = cat{ &heap, a = cat{ &heap, a = base, b = "." }, b = cat{ &heap, a = utf8::fmt_u64{ n, into = digits }.bytes, b = ext } }
            match fs::open{ &fs, path = p, mode = fs::Mode::create } {
                ok{ value } => {
                    _ = fs::close{ &fs, file = value }
                    return p
                }
                fs::exists => {}
                else => { break }
            }
            n = n + 1
        }
        cannot{ &io, path = cat{ &heap, a = base, b = ext }, what = "cannot create" }
        return null
    }

    // Renames tmp to file. If that fails because another ctxc made file first, as it would the
    // same file, keeps theirs. False after saying why there is no file.
    fn publish { mut io: Io, mut fs: Fs, tmp: []u8, file: []u8 } -> bool {
        match fs::rename{ &fs, from = tmp, to = file } {
            ok => { return true }
            err => {}
        }
        _ = fs::remove{ &fs, path = tmp }
        if kind_of{ &fs, path = file } == 1 { return true }
        cannot{ &io, path = file, what = "cannot create" }
        return false
    }

    // Removes dir's objects and executables of NAME for hashes other than `keep`: older builds'.
    // Windows won't remove one that is running; that one goes next time.
    fn sweep { mut fs: Fs, mut heap: Heap, dir: []u8, name: []u8, keep: [][]u8, suffix: []u8 } {
        let names = fs::list{ &fs, &heap, realloc = arena::alloc, path = dir } iferr { return }
        let mut i: usize = 0
        while i < names.len {
            if older{ file = names[i], name, keep, suffix } { _ = fs::remove{ &fs, path = join{ &heap, a = dir, b = names[i] } } }
            i = i + 1
        }
    }

    // Whether file is NAME-HASH.o, NAME-HASH.c or NAME-HASH SUFFIX for a HASH not in keep.
    fn older { file: []u8, name: []u8, keep: [][]u8, suffix: []u8 } -> bool {
        let at = name.len + 1
        if file.len < at + 16 or not slice::eq_bytes{ a = file[..name.len], b = name } or file[name.len] != '-' { return false }
        let hash = file[at..at + 16]
        let mut i: usize = 0
        while i < hash.len {
            let c = hash[i]
            if not ((c >= '0' and c <= '9') or (c >= 'a' and c <= 'f')) { return false }
            i = i + 1
        }
        let rest = file[at + 16..]
        if not (slice::eq_bytes{ a = rest, b = ".o" } or slice::eq_bytes{ a = rest, b = ".c" } or slice::eq_bytes{ a = rest, b = suffix }) { return false }
        i = 0
        while i < keep.len {
            if slice::eq_bytes{ a = hash, b = keep[i] } { return false }
            i = i + 1
        }
        return true
    }

    // A hash of the runtime's sources, which every executable is compiled with.
    fn runtime_hash { mut io: Io, mut fs: Fs, mut heap: Heap, home: []u8 } -> ?u64 {
        let mut h = FNV_BASIS
        let names = ["ctxc/rt/ctxrt.c", "ctxc/rt/ctxrt.h", "ctxc/rt/ctxfloat.c", "ctxc/rt/ctxthread.c"]
        let mut i: usize = 0
        while i < names.len {
            let p = join{ &heap, a = home, b = names[i] }
            h = hash_file{ &fs, h, path = p } ifnull {
                cannot{ &io, path = p, what = "cannot read" }
                return null
            }
            i = i + 1
        }
        return h
    }

    // h with the bytes of the file at path; null if it can't be read.
    fn hash_file { mut fs: Fs, h: u64, path: []u8 } -> ?u64 {
        let file = fs::open{ &fs, path, mode = fs::Mode::read } iferr { return null }
        defer _ = fs::close{ &fs, file }
        let mut buf: [65536]u8
        let mut x = h
        while true {
            let n = fs::read{ &fs, file, into = buf[..] } iferr { return null }
            if n == 0 { break }
            x = mix{ h = x, bytes = buf[..n] }
        }
        return x
    }

    fn mix { h: u64, bytes: []u8 } -> u64 {
        let mut x = h
        let mut i: usize = 0
        while i < bytes.len {
            x = (x ^ @as(u64, bytes[i])) *% FNV_PRIME
            i = i + 1
        }
        return x
    }

    // h with each of xs, and a zero byte after each, so that ["ab", "c"] and ["a", "bc"] differ.
    fn mix_all { h: u64, xs: [][]u8 } -> u64 {
        let mut x = h
        let mut i: usize = 0
        while i < xs.len {
            x = mix{ h = x, bytes = xs[i] } *% FNV_PRIME
            i = i + 1
        }
        return x
    }

    fn mix_u64 { h: u64, n: u64 } -> u64 {
        let mut x = h
        let mut v = n
        let mut i = 0
        while i < 8 {
            x = (x ^ (v & 255)) *% FNV_PRIME
            v = v >> 8
            i = i + 1
        }
        return x
    }

    // n as 16 hexadecimal digits.
    fn hex { mut heap: Heap, n: u64 } -> []u8 {
        let out = try! alloc::make(u8, Heap){ realloc = arena::alloc, &heap, count = 16 }
        let mut v = n
        let mut k: usize = 16
        while k > 0 {
            k = k - 1
            let digit = @trunc(u8, v & 15)
            out[k] = if digit < 10 { '0' + digit } else { 'a' + digit - 10 }
            v = v >> 4
        }
        return out
    }

    // "NAME-" and n in hexadecimal.
    fn tagged { mut heap: Heap, name: []u8, n: u64 } -> []u8 {
        return cat{ &heap, a = cat{ &heap, a = name, b = "-" }, b = hex{ &heap, n } }
    }

    // ---- finding things

    // HOME: CTX_HOME, or the first directory above the executable or the working directory that
    // holds std/ and ctxc/rt/.
    fn find_home { mut fs: Fs, mut proc: Proc, mut heap: Heap } -> ?[]u8 {
        let set = proc::env{ &proc, name = "CTX_HOME" }
        if set != null and set.len > 0 { return trim_slash{ path = set } }
        let mut dir = parent{ path = proc::exe_path{ &proc } }
        while dir.len > 0 {
            if is_home{ &fs, &heap, dir } { return dir }
            let up = parent{ path = dir }
            if up.len == dir.len { break }
            dir = up
        }
        let mut here = "."
        let mut i = 0
        while i < 16 {
            if is_home{ &fs, &heap, dir = here } { return here }
            here = join{ &heap, a = here, b = ".." }
            i = i + 1
        }
        return null
    }

    fn is_home { mut fs: Fs, mut heap: Heap, dir: []u8 } -> bool {
        return kind_of{ &fs, path = join{ &heap, a = dir, b = "std/io.ctx" } } == 1
               and kind_of{ &fs, path = join{ &heap, a = dir, b = "ctxc/rt/ctxrt.c" } } == 1
    }

    // The C compiler's command: CTX_CC as it is, if it names a file, so a path may hold spaces;
    // else CTX_CC split at spaces (`zig cc`), or `cc`. A bare name found on PATH becomes the path
    // it is found at.
    fn compiler { mut fs: Fs, mut proc: Proc, mut heap: Heap, os: build::Os } -> [][]u8 {
        let mut words = list::new([]u8){ realloc = arena::alloc, &heap }
        let set = proc::env{ &proc, name = "CTX_CC" }
        if set != null and set.len > 0 and kind_of{ &fs, path = set } == 1 {
            try! list::push{ list = &words, item = set }
        } else if set != null {
            let mut start: usize = 0
            let mut i: usize = 0
            while i <= set.len {
                if i == set.len or set[i] == ' ' {
                    if i > start { try! list::push{ list = &words, item = set[start..i] } }
                    start = i + 1
                }
                i = i + 1
            }
        }
        if words.len == 0 { try! list::push{ list = &words, item = "cc" } }
        let xs = list::items{ list = words }
        let found = on_path{ &fs, &proc, &heap, name = xs[0], os } ifnull { return xs }
        let mut out = list::new([]u8){ realloc = arena::alloc, &heap }
        try! list::push{ list = &out, item = found }
        add_all{ xs = &out, ys = xs[1..] }
        return list::items{ list = out }
    }

    // Where the program `name` is on PATH, if it is a bare name: DIR/name, or DIR/name.exe on
    // Windows.
    fn on_path { mut fs: Fs, mut proc: Proc, mut heap: Heap, name: []u8, os: build::Os } -> ?[]u8 {
        if base{ path = name }.len != name.len { return null }
        let path = proc::env{ &proc, name = "PATH" } ifnull { return null }
        let windows = os == build::Os::windows
        let file = if windows and not ends_with{ s = name, suffix = ".exe" } { cat{ &heap, a = name, b = ".exe" } } else { name }
        let sep: u8 = if windows { ';' } else { ':' }
        let mut start: usize = 0
        let mut i: usize = 0
        while i <= path.len {
            if i == path.len or path[i] == sep {
                if i > start {
                    let at = join{ &heap, a = path[start..i], b = file }
                    if kind_of{ &fs, path = at } == 1 { return at }
                }
                start = i + 1
            }
            i = i + 1
        }
        return null
    }

    // The C compiler's environment entries: PATH with the compiler's own directory first, so that
    // MinGW's cc1 loads its own DLLs, not those of another MinGW earlier on PATH (Git Bash's),
    // which fail it without a word. None if cc is a bare name.
    fn cc_env { mut proc: Proc, mut heap: Heap, cc: []u8, os: build::Os } -> [][]u8 {
        let dir = parent{ path = cc }
        if dir.len == 0 { return slice::empty([]u8){} }
        let entry = cat{ &heap, a = "PATH=", b = dir }
        let rest = proc::env{ &proc, name = "PATH" } ifnull { return one{ &heap, s = entry } }
        let sep = if os == build::Os::windows { ";" } else { ":" }
        return one{ &heap, s = cat{ &heap, a = cat{ &heap, a = entry, b = sep }, b = rest } }
    }

    // std's files, then those of its layer for os (spec §17): std/os/windows, or for Linux and
    // macOS std/os/posix, which they share, and std/os/linux or std/os/macos. For the
    // interpreter, its own layer, std/os/interp, and os's target.ctx.
    fn std_files { mut io: Io, mut fs: Fs, mut heap: Heap, home: []u8, os: build::Os, interp: bool } -> ?[][]u8 {
        let std_dir = join{ &heap, a = home, b = "std" }
        let layer = match os { windows => { "os/windows" } macos => { "os/macos" } linux => { "os/linux" } }
        let top = ctx_files{ &io, &fs, &heap, dir = std_dir } ifnull { return null }
        let mut all = list::new([]u8){ realloc = arena::alloc, &heap }
        add_all{ xs = &all, ys = top }
        if interp {
            let own = ctx_files{ &io, &fs, &heap, dir = join{ &heap, a = std_dir, b = "os/interp" } } ifnull { return null }
            add_all{ xs = &all, ys = own }
            try! list::push{ list = &all, item = join{ &heap, a = join{ &heap, a = std_dir, b = layer }, b = "target.ctx" } }
            return list::items{ list = all }
        }
        if os != build::Os::windows {
            let shared = ctx_files{ &io, &fs, &heap, dir = join{ &heap, a = std_dir, b = "os/posix" } } ifnull { return null }
            add_all{ xs = &all, ys = shared }
        }
        let own = ctx_files{ &io, &fs, &heap, dir = join{ &heap, a = std_dir, b = layer } } ifnull { return null }
        add_all{ xs = &all, ys = own }
        return list::items{ list = all }
    }

    // The .ctx files in dir, as paths under it, sorted.
    fn ctx_files { mut io: Io, mut fs: Fs, mut heap: Heap, dir: []u8 } -> ?[][]u8 {
        let names = fs::list{ &fs, &heap, realloc = arena::alloc, path = dir } iferr {
            cannot{ &io, path = dir, what = "cannot list" }
            return null
        }
        let mut out = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut i: usize = 0
        while i < names.len {
            if ends_with{ s = names[i], suffix = ".ctx" } {
                try! list::push{ list = &out, item = join{ &heap, a = dir, b = names[i] } }
            }
            i = i + 1
        }
        return list::items{ list = out }
    }

    // 0 if nothing is at path, 1 a file, 2 a directory.
    fn kind_of { mut fs: Fs, path: []u8 } -> u8 {
        match fs::size{ &fs, path } {
            ok => { return 1 }
            fs::is_directory => { return 2 }
            else => { return 0 }
        }
    }

    // Creates directory path unless it is there; false after saying why it can't.
    fn made { mut io: Io, mut fs: Fs, path: []u8 } -> bool {
        match fs::make_dir{ &fs, path } {
            ok => { return true }
            fs::exists => { return true }
            else => {}
        }
        cannot{ &io, path, what = "cannot create directory" }
        return false
    }

    fn add_target { mut targets: list::List(Target, Heap), mut heap: Heap, name: []u8, root: []u8 } {
        try! list::push{ list = &targets, item = new_target{ &heap, name, root } }
    }

    fn new_target { mut heap: Heap, name: []u8, root: []u8 } -> Target {
        return Target{
            name, root, level = 1,
            dirs = list::new([]u8){ realloc = arena::alloc, &heap },
            paths = list::new([]u8){ realloc = arena::alloc, &heap },
            libs = list::new([]u8){ realloc = arena::alloc, &heap },
            gens = list::new(Gen){ realloc = arena::alloc, &heap },
        }
    }

    // ---- paths and byte strings

    // Where rel, relative to directory dir unless it is absolute, is, as a person would write it.
    fn place { mut heap: Heap, dir: []u8, rel: []u8 } -> []u8 {
        if fs::is_absolute{ path = rel } { return normalize{ &heap, path = rel } }
        return normalize{ &heap, path = join{ &heap, a = dir, b = rel } }
    }

    // path as an absolute path, normalized; null after saying why it can't be had.
    fn absolute { mut io: Io, mut fs: Fs, mut heap: Heap, path: []u8 } -> ?[]u8 {
        let full = fs::make_absolute{ &fs, &heap, realloc = arena::alloc, path } iferr {
            cannot{ &io, path, what = "cannot find the working directory for" }
            return null
        }
        return normalize{ &heap, path = full }
    }

    // A key for the file at path: the same for every path to it, as long as no link is in the
    // way. Its absolute path, normalized, and in lower case on Windows, whose names ignore case.
    fn key_of { mut io: Io, mut fs: Fs, mut heap: Heap, path: []u8, os: build::Os } -> ?[]u8 {
        let full = absolute{ &io, &fs, &heap, path } ifnull { return null }
        return fold{ &heap, s = full, os }
    }

    // s in lower case on Windows, whose file names ignore case; s elsewhere.
    fn fold { mut heap: Heap, s: []u8, os: build::Os } -> []u8 {
        if os != build::Os::windows { return s }
        let out = try! alloc::make(u8, Heap){ realloc = arena::alloc, &heap, count = s.len }
        let mut i: usize = 0
        while i < s.len {
            out[i] = ascii::to_lower{ c = s[i] }
            i = i + 1
        }
        return out
    }

    // path as a person would write it: components joined by `/`, none of them empty or `.`, and
    // each `..` taking away the one before it where there is one. A root stays: `/`, a drive
    // (`C:`, `C:/`), or the `//` of a Windows share. It doesn't look at the file system, so after
    // a link, `..` names another directory than the system would.
    fn normalize { mut heap: Heap, path: []u8 } -> []u8 {
        let mut out = list::new(u8){ realloc = arena::alloc, &heap }
        let mut i: usize = 0
        if path.len >= 2 and path[1] == ':' and ascii::is_alpha{ c = path[0] } {
            try! list::push{ list = &out, item = path[0] }
            try! list::push{ list = &out, item = ':' }
            i = 2
        }
        let rooted = i < path.len and separator{ c = path[i] }
        if rooted {
            try! list::push{ list = &out, item = '/' }
            if i == 0 and path.len >= 2 and separator{ c = path[1] } { try! list::push{ list = &out, item = '/' } }
        }
        let mut parts = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut ups: usize = 0          // leading `..`s, which no later one takes away
        while i < path.len {
            if separator{ c = path[i] } {
                i = i + 1
                continue
            }
            let start = i
            while i < path.len and not separator{ c = path[i] } { i = i + 1 }
            let part = path[start..i]
            if slice::eq_bytes{ a = part, b = "." } { continue }
            if slice::eq_bytes{ a = part, b = ".." } {
                if parts.len > ups {
                    _ = list::pop{ list = &parts }
                    continue
                }
                if rooted { continue }
                ups = ups + 1
            }
            try! list::push{ list = &parts, item = part }
        }
        let xs = list::items{ list = parts }
        let mut k: usize = 0
        while k < xs.len {
            if k > 0 { try! list::push{ list = &out, item = '/' } }
            let mut j: usize = 0
            while j < xs[k].len {
                try! list::push{ list = &out, item = xs[k][j] }
                j = j + 1
            }
            k = k + 1
        }
        if out.len == 0 { return "." }
        return list::items{ list = out }
    }

    fn separator { c: u8 } -> bool {
        return c == '/' or c == '\\'
    }

    fn join { mut heap: Heap, a: []u8, b: []u8 } -> []u8 {
        if a.len == 0 { return b }
        if a[a.len - 1] == '/' { return cat{ &heap, a, b } }
        return cat{ &heap, a = cat{ &heap, a, b = "/" }, b }
    }

    fn cat { mut heap: Heap, a: []u8, b: []u8 } -> []u8 {
        let out = try! alloc::make(u8, Heap){ realloc = arena::alloc, &heap, count = a.len + b.len }
        slice::copy{ dst = out[..a.len], src = a }
        slice::copy{ dst = out[a.len..], src = b }
        return out
    }

    // path without its last component; "/" for one at the root, "" for a bare name.
    fn parent { path: []u8 } -> []u8 {
        let mut k = path.len
        while k > 0 {
            k = k - 1
            if path[k] == '/' or path[k] == '\\' { return if k == 0 { path[..1] } else { path[..k] } }
        }
        return path[..0]
    }

    // The last component of path.
    fn base { path: []u8 } -> []u8 {
        let mut k = path.len
        while k > 0 {
            if path[k - 1] == '/' or path[k - 1] == '\\' { return path[k..] }
            k = k - 1
        }
        return path
    }

    fn stem { path: []u8 } -> []u8 {
        if ends_with{ s = path, suffix = ".ctx" } and path.len > 4 { return path[..path.len - 4] }
        return path
    }

    fn trim_slash { path: []u8 } -> []u8 {
        let mut n = path.len
        while n > 1 and (path[n - 1] == '/' or path[n - 1] == '\\') { n = n - 1 }
        return path[..n]
    }

    fn ends_with { s: []u8, suffix: []u8 } -> bool {
        return s.len >= suffix.len and slice::eq_bytes{ a = s[s.len - suffix.len..], b = suffix }
    }

    fn one { mut heap: Heap, s: []u8 } -> [][]u8 {
        let mut xs = list::new([]u8){ realloc = arena::alloc, &heap }
        try! list::push{ list = &xs, item = s }
        return list::items{ list = xs }
    }

    fn add_bytes { mut xs: list::List(u8, Heap), s: []u8 } {
        let mut i: usize = 0
        while i < s.len {
            try! list::push{ list = &xs, item = s[i] }
            i = i + 1
        }
    }

    fn add_all { mut xs: Strs, ys: [][]u8 } {
        let mut i: usize = 0
        while i < ys.len {
            try! list::push{ list = &xs, item = ys[i] }
            i = i + 1
        }
    }
}
