// SHA-256 (FIPS 180-4), for the cache's keys: a wrong hit would pass a case without running
// it, so the keys are a real hash's.

namespace sha256 {
    const K: [64]u32 = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]

    // A hash in progress: the state, the bytes of a block not yet full, and the bytes taken.
    struct Hash { h: [8]u32, block: [64]u8, held: usize, total: u64 }

    fn new {} -> Hash {
        let mut s: Hash
        s.h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
        return s
    }

    fn rotr { x: u32, n: u32 } -> u32 { return (x >> n) | (x <<% (32 - n)) }

    fn compress { mut s: Hash } {
        let mut w: [64]u32
        for i in 0..16 {
            let b = s.block[i * 4..i * 4 + 4]
            w[i] = (@as(u32, b[0]) <<% 24) | (@as(u32, b[1]) <<% 16) | (@as(u32, b[2]) <<% 8) | @as(u32, b[3])
        }
        for i in 16..64 {
            let x = w[i - 15]
            let y = w[i - 2]
            let s0 = rotr{ x, n = 7 } ^ rotr{ x, n = 18 } ^ (x >> 3)
            let s1 = rotr{ x = y, n = 17 } ^ rotr{ x = y, n = 19 } ^ (y >> 10)
            w[i] = w[i - 16] +% s0 +% w[i - 7] +% s1
        }
        let mut v = s.h
        for i in 0..64 {
            let e = v[4]
            let a = v[0]
            let s1 = rotr{ x = e, n = 6 } ^ rotr{ x = e, n = 11 } ^ rotr{ x = e, n = 25 }
            let ch = (e & v[5]) ^ (~e & v[6])
            let t1 = v[7] +% s1 +% ch +% K[i] +% w[i]
            let s0 = rotr{ x = a, n = 2 } ^ rotr{ x = a, n = 13 } ^ rotr{ x = a, n = 22 }
            let maj = (a & v[1]) ^ (a & v[2]) ^ (v[1] & v[2])
            let t2 = s0 +% maj
            v[7] = v[6]
            v[6] = v[5]
            v[5] = e
            v[4] = v[3] +% t1
            v[3] = v[2]
            v[2] = v[1]
            v[1] = a
            v[0] = t1 +% t2
        }
        for i in 0..8 { s.h[i] = s.h[i] +% v[i] }
    }

    // Takes more bytes.
    fn add { mut s: Hash, bytes: []u8 } {
        s.total = s.total + bytes.len
        for b in bytes {
            s.block[s.held] = b
            s.held = s.held + 1
            if s.held == 64 {
                compress{ &s }
                s.held = 0
            }
        }
    }

    // Takes bytes and then a zero byte, so that two fields in a row can't run together.
    fn add_field { mut s: Hash, bytes: []u8 } {
        add{ &s, bytes }
        let zero: [1]u8 = [0]
        add{ &s, bytes = zero[..] }
    }

    // The hash of what was taken, as 64 hexadecimal digits written to `into`.
    fn finish { s: Hash, into: []mut u8 } -> []u8 {
        let mut t = s
        let bits = t.total * 8
        t.block[t.held] = 0x80
        t.held = t.held + 1
        if t.held > 56 {
            while t.held < 64 {
                t.block[t.held] = 0
                t.held = t.held + 1
            }
            compress{ s = &t }
            t.held = 0
        }
        while t.held < 56 {
            t.block[t.held] = 0
            t.held = t.held + 1
        }
        for i in 0..8 { t.block[56 + i] = @trunc(u8, bits >> (56 - 8 * @as(u64, i))) }
        compress{ s = &t }
        let digits = "0123456789abcdef"
        for i in 0..32 {
            let byte = @trunc(u8, t.h[i / 4] >> (24 - 8 * @as(u32, i % 4)))
            into[i * 2] = digits[byte >> 4]
            into[i * 2 + 1] = digits[byte & 15]
        }
        return into[..64]
    }
}
