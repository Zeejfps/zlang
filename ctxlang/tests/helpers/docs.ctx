// Checks the code blocks of the docs with ctxc (cases/Docs/code_blocks): every block of a doc it
// is given compiles, or has exactly the errors its comments state.
//
//   docs CTXC WORK DOC...
//
// A block opens with a fence and a mark: ```ctx is ctxlang, which is checked; ```text is
// anything else (a grammar, a program's output, a shell session), which isn't. A block without
// a mark is a failure.
//
// A ctx block is checked as a program of its own. Most blocks are parts of one: the code they
// need around them is in an HTML comment just before them, which a rendered doc doesn't show:
//
//   <!-- context:
//   fn hex_digit { c: u8 } -> ?u32 { return null }
//   fn value { s: []u8 } -> ?u32 {
//       ...
//   }
//   -->
//
// The block goes where a line of the context is `...` alone, or after the context if none is.
// A context of several files starts each with a line `// file: PATH`, and the block goes into
// the one with the `...`; then the directory of that file is what is checked (one with a
// build.ctx, if the block is a build program). Without a context, the block is the program.
//
// A line of the block with `// error: MESSAGE` states an error that ctxc reports at that line,
// with that message, whole, or starting with it if MESSAGE ends with `...`. The block must have
// those errors and no others (notes aren't compared). A block without one compiles.
//
// It prints a line for each failure, `DOC:LINE: fail: WHAT`, then `blocks: N checked, M text`,
// and ends with exit code 1 if anything failed, 64 for arguments it doesn't know, 65 for a doc
// it can't read.

type Heap = arena::Arena

struct Expected { line: usize, message: []u8 }

struct Block {
    doc: []u8,
    fence: usize,               // the fence's line in the doc, from 1
    dir: []u8,                  // where its program is written
    target: []u8,               // what `ctxc check` is given: a directory of its program
    file: []u8,                 // the file that holds the block, as ctxc names it
    first: usize,               // the block's first line in that file, from 1
    count: usize,               // its lines
    files: []Source,
    expected: []Expected,
    out: []u8,                  // where ctxc's output goes
}

struct Source { path: []u8, text: []u8 }

struct Tally { checked: usize, text: usize, failed: usize }

fn main { mut io: Io, mut fs: Fs, mut proc: Proc, mut mem: Mem, args: Args } -> i32 {
    let mut heap = arena::new{ buf = mem::reserve{ &mem, size = 1073741824 } ifnull { return 70 } }
    if args.len < 3 { return 64 }
    let ctxc = args[0]
    let work = args[1]
    _ = fs::make_dir{ &fs, path = work } iferr {}
    let mut blocks = list::new(Block, Heap){ realloc = arena::alloc, &heap }
    let mut tally = Tally{ checked = 0, text = 0, failed = 0 }
    for doc in args[2..] {
        let bytes = fs::read_all(Heap){ &fs, &heap, realloc = arena::alloc, path = doc } iferr { return 65 }
        read_doc{ &io, &heap, &blocks, &tally, doc, text = bytes, work }
    }
    let all = list::items{ list = blocks }
    let width = @max(proc::processors{ &proc }, 1)
    let mut at: usize = 0
    while at < all.len {
        let end = @min(at + width, all.len)
        let mut children = list::new(?proc::Child, Heap){ realloc = arena::alloc, &heap }
        for b in all[at..end] {
            let child = start{ &fs, &proc, &heap, ctxc, b } iferr { null }
            try! list::push{ list = &children, item = child }
        }
        for c at i in list::items{ list = children } {
            let b = all[at + i]
            if c == null {
                fail{ &io, &heap, &tally, doc = b.doc, line = b.fence, what = @fmt("ctxc couldn't be started") }
                continue
            }
            let mut child = c
            let code = proc::wait{ &proc, &child } iferr { -1 }
            compare{ &io, &fs, &heap, &tally, b, code }
        }
        at = end
    }
    _ = @fmt(&io, "blocks: {} checked, {} text\n", tally.checked, tally.text)
    return if tally.failed > 0 { 1 } else { 0 }
}

// Prints a failure at a line of a doc.
fn fail { mut io: Io, mut heap: Heap, mut tally: Tally, doc: []u8, line: usize, what: utf8::Fmt(Heap) } {
    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
    try! what{ &b }
    _ = @fmt(&io, "{}:{}: fail: {}\n", doc, line, utf8::view{ b }.bytes)
    tally.failed = tally.failed + 1
}

// Finds a doc's blocks: the text ones are counted, the ctx ones written out and listed.
fn read_doc { mut io: Io, mut heap: Heap, mut blocks: list::List(Block, Heap), mut tally: Tally, doc: []u8, text: []u8, work: []u8 } {
    let lines = split_lines{ &heap, text }
    let mut context: ?usize = null          // the line after the end of the context comment just read
    let mut context_lines: [][]u8 = []
    let mut i: usize = 0
    while i < lines.len {
        let line = lines[i]
        let t = trim{ s = line }
        if eq{ a = t, b = "<!-- context:" } {
            let from = i + 1
            let mut j = from
            while j < lines.len and not eq{ a = trim{ s = lines[j] }, b = "-->" } { j = j + 1 }
            context_lines = lines[from..j]
            context = j + 1
            i = j + 1
            continue
        }
        if starts_with{ s = t, prefix = "```" } {
            let mark = trim{ s = t[3..] }
            let indent = line.len - trim_start{ s = line }.len
            let mut j = i + 1
            while j < lines.len and not eq{ a = trim{ s = lines[j] }, b = "```" } { j = j + 1 }
            let body = lines[i + 1..j]
            let fence = i + 1
            let has_context = context != null and blank_between{ lines, from = context ifnull 0, to = i }
            if eq{ a = mark, b = "text" } {
                tally.text = tally.text + 1
            } else if eq{ a = mark, b = "ctx" } {
                let ctx: [][]u8 = if has_context { context_lines } else { [] }
                let b = make_block{ &heap, doc, fence, work, body = unindent{ &heap, lines = body, indent }, context = ctx }
                try! list::push{ list = &blocks, item = b }
                tally.checked = tally.checked + 1
            } else {
                fail{ &io, &heap, &tally, doc, line = fence, what = @fmt("a block needs its mark after the fence: ```ctx for ctxlang, ```text for anything else (found `{}`)", mark) }
            }
            if has_context { context = null }
            i = j + 1
            continue
        }
        i = i + 1
    }
}

// Whether lines from..to are all blank.
fn blank_between { lines: [][]u8, from: usize, to: usize } -> bool {
    for k in from..to { if trim{ s = lines[k] }.len > 0 { return false } }
    return true
}

// Takes `indent` spaces off each line that starts with them (a block inside a list item).
fn unindent { mut heap: Heap, lines: [][]u8, indent: usize } -> [][]u8 {
    let out = try! alloc::make([]u8, Heap){ realloc = arena::alloc, &heap, count = lines.len }
    for l at i in lines {
        let mut k: usize = 0
        while k < indent and k < l.len and l[k] == ' ' { k = k + 1 }
        out[i] = l[k..]
    }
    return out
}

// The block's program: its files, the one that holds it, and the errors it states.
fn make_block { mut heap: Heap, doc: []u8, fence: usize, work: []u8, body: [][]u8, context: [][]u8 } -> Block {
    let stem = base_name{ path = doc }
    let mut dirb = utf8::builder{ realloc = arena::alloc, &heap }
    try! @fmt(&dirb, "{}/{}-{}", work, stem, fence)
    let dir = utf8::view{ b = dirb }.bytes
    // Split the context into files.
    let mut paths = list::new([]u8, Heap){ realloc = arena::alloc, &heap }
    let mut starts = list::new(usize, Heap){ realloc = arena::alloc, &heap }
    let mut k: usize = 0
    for l at n in context {
        let t = trim{ s = l }
        if starts_with{ s = t, prefix = "// file: " } {
            try! list::push{ list = &paths, item = trim{ s = t[9..] } }
            try! list::push{ list = &starts, item = n + 1 }
        }
    }
    if list::items{ list = paths }.len == 0 {
        try! list::push{ list = &paths, item = "main.ctx" }
        try! list::push{ list = &starts, item = 0 }
    }
    let ps = list::items{ list = paths }
    let ss = list::items{ list = starts }
    let files = try! alloc::make(Source, Heap){ realloc = arena::alloc, &heap, count = ps.len }
    let mut holder: usize = 0
    let mut first: usize = 0
    let mut placed = false
    for p at f in ps {
        let from = ss[f]
        let to = if f + 1 < ps.len { ss[f + 1] - 1 } else { context.len }
        let mut b = utf8::builder{ realloc = arena::alloc, &heap }
        let mut written: usize = 0
        for l in context[from..to] {
            if not placed and eq{ a = trim{ s = l }, b = "..." } {
                holder = f
                first = written + 1
                placed = true
                for x in body { try! @fmt(&b, "{}\n", x) }
                written = written + body.len
            } else {
                try! @fmt(&b, "{}\n", l)
                written = written + 1
            }
        }
        if f == 0 and not placed and ps.len == 1 {
            first = written + 1
            placed = true
            for x in body { try! @fmt(&b, "{}\n", x) }
        }
        files[f] = Source{ path = p, text = utf8::view{ b }.bytes }
    }
    let rel = ps[holder]
    let mut tb = utf8::builder{ realloc = arena::alloc, &heap }
    let parent = parent_of{ path = rel }
    if parent.len == 0 { try! @fmt(&tb, "{}", dir) } else { try! @fmt(&tb, "{}/{}", dir, parent) }
    let target = utf8::view{ b = tb }.bytes
    let mut fb = utf8::builder{ realloc = arena::alloc, &heap }
    try! @fmt(&fb, "{}/{}", dir, rel)
    let mut ob = utf8::builder{ realloc = arena::alloc, &heap }
    try! @fmt(&ob, "{}.out", dir)
    let mut expected = list::new(Expected, Heap){ realloc = arena::alloc, &heap }
    for l at n in body {
        let at = find{ s = l, part = "// error: " } ifnull { continue }
        try! list::push{ list = &expected, item = Expected{ line = n, message = trim{ s = l[at + 10..] } } }
    }
    return Block{
        doc, fence, dir, target, file = utf8::view{ b = fb }.bytes, first, count = body.len, files,
        expected = list::items{ list = expected }, out = utf8::view{ b = ob }.bytes,
    }
}

// Writes the block's files and starts `ctxc check --json` on them, its output to b.out.
fn start { mut fs: Fs, mut proc: Proc, mut heap: Heap, ctxc: []u8, b: Block } -> !proc::Child {
    for s in b.files {
        let mut pb = utf8::builder{ realloc = arena::alloc, &heap }
        try @fmt(&pb, "{}/{}", b.dir, s.path)
        let path = utf8::view{ b = pb }.bytes
        make_dirs{ &fs, path = parent_of{ path } }
        _ = try fs::write_all{ &fs, path, bytes = s.text }
    }
    let file = try fs::open{ &fs, path = b.out, mode = fs::Mode::write }
    let argv: [4][]u8 = [ctxc, "check", "--json", b.target]
    let child = proc::spawn{ &proc, argv = argv[..], options = proc::Options{ stdout = proc::Stdio::file{ file }, stderr = proc::Stdio::file{ file }, .. } } iferr err{ error } {
        _ = fs::close{ &fs, file }
        return error
    }
    _ = fs::close{ &fs, file }
    return child
}

// Makes a directory and those above it, as needed.
fn make_dirs { mut fs: Fs, path: []u8 } {
    for i in 1..path.len + 1 {
        if i == path.len or path[i] == '/' {
            _ = fs::make_dir{ &fs, path = path[0..i] } iferr {}
        }
    }
}

// Compares what ctxc reported with what the block states.
fn compare { mut io: Io, mut fs: Fs, mut heap: Heap, mut tally: Tally, b: Block, code: i32 } {
    let out: []u8 = fs::read_all(Heap){ &fs, &heap, realloc = arena::alloc, path = b.out } iferr {
        fail{ &io, &heap, &tally, doc = b.doc, line = b.fence, what = @fmt("ctxc's output couldn't be read") }
        return
    }
    let found = try! alloc::make(bool, Heap){ realloc = arena::alloc, &heap, count = b.expected.len }
    let mut summary = false
    for line in split_lines{ &heap, text = out } {
        if starts_with{ s = line, prefix = "{\"type\":\"summary\"" } { summary = true }
        if not starts_with{ s = line, prefix = "{\"type\":\"diagnostic\"" } { continue }
        let file = json_string{ &heap, s = line, key = "file" } ifnull { continue }
        let at = json_number{ s = line, key = "line" } ifnull { continue }
        let message = json_string{ &heap, s = line, key = "message" } ifnull { continue }
        let n = @as(usize, at)
        if not eq{ a = file, b = b.file } or n < b.first or n >= b.first + b.count {
            fail{ &io, &heap, &tally, doc = b.doc, line = b.fence, what = @fmt("an error outside the block, at {}:{}: {}", file, at, message) }
            continue
        }
        let k = n - b.first
        let mut matched = false
        for e at x in b.expected {
            if e.line == k and not found[x] and states{ expected = e.message, message } {
                found[x] = true
                matched = true
                break
            }
        }
        if not matched { fail{ &io, &heap, &tally, doc = b.doc, line = b.fence + 1 + k, what = @fmt("an error the block doesn't state: {}", message) } }
    }
    for e at x in b.expected {
        if not found[x] { fail{ &io, &heap, &tally, doc = b.doc, line = b.fence + 1 + e.line, what = @fmt("ctxc reports no error `{}` here", e.message) } }
    }
    if not summary or (code != 0 and code != 1) {
        fail{ &io, &heap, &tally, doc = b.doc, line = b.fence, what = @fmt("ctxc check ended with exit code {} and no summary:\n{}", code, out) }
    }
}

// Whether a stated message is the message: whole, or its start if it ends with `...`.
fn states { expected: []u8, message: []u8 } -> bool {
    if ends_with{ s = expected, suffix = "..." } {
        return starts_with{ s = message, prefix = expected[0..expected.len - 3] }
    }
    return eq{ a = expected, b = message }
}

// The string of a JSON object's first `"key":"..."`, unescaped.
fn json_string { mut heap: Heap, s: []u8, key: []u8 } -> ?[]u8 {
    let mut kb = utf8::builder{ realloc = arena::alloc, &heap }
    try! @fmt(&kb, "\"{}\":\"", key)
    let at = find{ s, part = utf8::view{ b = kb }.bytes } ifnull { return null }
    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
    let mut i = at + key.len + 4
    while i < s.len and s[i] != '"' {
        let c = s[i]
        if c == '\\' and i + 1 < s.len {
            let d = s[i + 1]
            i = i + 2
            match d {
                'n' => { try! utf8::push_char{ &b, c = '\n' } }
                't' => { try! utf8::push_char{ &b, c = '\t' } }
                'r' => { try! utf8::push_char{ &b, c = '\r' } }
                'u' => {
                    if i + 4 > s.len { return null }
                    let mut v: u32 = 0
                    for h in s[i..i + 4] { v = v * 16 + @as(u32, hex_value{ c = h } ifnull { return null }) }
                    try! utf8::push_char{ &b, c = v }
                    i = i + 4
                }
                else => { try! utf8::push_char{ &b, c = d } }
            }
            continue
        }
        try! utf8::push_bytes{ &b, s = s[i..i + 1] }
        i = i + 1
    }
    return utf8::view{ b }.bytes
}

fn hex_value { c: u8 } -> ?u8 {
    return match c {
        '0'..='9' => c - '0',
        'a'..='f' => c - 'a' + 10,
        'A'..='F' => c - 'A' + 10,
        else => null,
    }
}

// The number of a JSON object's first `"key":N`.
fn json_number { s: []u8, key: []u8 } -> ?u64 {
    let mut i: usize = 0
    while i + key.len + 3 <= s.len {
        if s[i] == '"' and eq{ a = s[i + 1..i + 1 + key.len], b = key } and s[i + 1 + key.len] == '"' and s[i + 2 + key.len] == ':' {
            let mut j = i + 3 + key.len
            let mut n: u64 = 0
            let from = j
            while j < s.len and s[j] >= '0' and s[j] <= '9' {
                n = n * 10 + @as(u64, s[j] - '0')
                j = j + 1
            }
            return if j > from { n } else { null }
        }
        i = i + 1
    }
    return null
}

// The lines of a text, without their ends (a `\r` before a `\n` goes too).
fn split_lines { mut heap: Heap, text: []u8 } -> [][]u8 {
    let mut out = list::new([]u8, Heap){ realloc = arena::alloc, &heap }
    let mut from: usize = 0
    for c at i in text {
        if c == '\n' {
            let end = if i > from and text[i - 1] == '\r' { i - 1 } else { i }
            try! list::push{ list = &out, item = text[from..end] }
            from = i + 1
        }
    }
    if from < text.len { try! list::push{ list = &out, item = text[from..] } }
    return list::items{ list = out }
}

fn eq { a: []u8, b: []u8 } -> bool { return a == b }

fn starts_with { s: []u8, prefix: []u8 } -> bool { return s.len >= prefix.len and s[0..prefix.len] == prefix }

fn ends_with { s: []u8, suffix: []u8 } -> bool { return s.len >= suffix.len and s[s.len - suffix.len..] == suffix }

fn find { s: []u8, part: []u8 } -> ?usize {
    if part.len > s.len { return null }
    for at in 0..s.len - part.len + 1 { if s[at..at + part.len] == part { return at } }
    return null
}

fn trim_start { s: []u8 } -> []u8 {
    let mut i: usize = 0
    while i < s.len and (s[i] == ' ' or s[i] == '\t') { i = i + 1 }
    return s[i..]
}

fn trim { s: []u8 } -> []u8 {
    let t = trim_start{ s }
    let mut n = t.len
    while n > 0 and (t[n - 1] == ' ' or t[n - 1] == '\t' or t[n - 1] == '\r') { n = n - 1 }
    return t[0..n]
}

// A path's last part, without `.md`.
fn base_name { path: []u8 } -> []u8 {
    let mut from: usize = 0
    for c at i in path { if c == '/' or c == '\\' { from = i + 1 } }
    let name = path[from..]
    return if ends_with{ s = name, suffix = ".md" } { name[0..name.len - 3] } else { name }
}

// A path without its last part, and without the `/` before it: "" for a name alone.
fn parent_of { path: []u8 } -> []u8 {
    let mut end: usize = 0
    for c at i in path { if c == '/' { end = i } }
    return path[0..end]
}
