
fn main { mut io: Io } {
    let a = [10, 20, 30]
    let s = a[..]
    let i8v: i8 = 1
    let i16v: i16 = 2
    let i32v: i32 = 0
    let i64v: i64 = 1
    let u8v: u8 = 2
    let u16v: u16 = 0
    let u32v: u32 = 1
    let u64v: u64 = 2
    let z: usize = 0
    _ = @fmt(&io, "{} {} {} {} {} {} {} {} {}\n", a[i8v], a[i16v], a[i32v], a[i64v], s[u8v], s[u16v], s[u32v], s[u64v], s[z])
    let lo: i32 = 1
    let hi: u8 = 3
    let t = s[lo..hi]                   // each bound its own type
    let u = a[i64v..]
    let v = s[..i16v]
    _ = @fmt(&io, "{} {} {} {}\n", t.len, t[0], u.len, v.len)
    let mut m = [1, 2, 3]
    m[i32v + 1] = 5                     // a place
    let p = &m
    p[i8v] = p[i8v] + 1                 // through a pointer to an array
    let k = 2                           // a literal's local: an i32 here
    _ = @fmt(&io, "{} {} {}\n", m[1], m[k], m[k - 1])
}

//# stdout:
//| 20 30 10 20 30 10 20 30 10
//| 2 20 2 2
//| 6 3 6
