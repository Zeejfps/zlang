
fn main { mut io: Io } {
    let mut buf: [8]u8
    let mut total: i64 = 0
    let mut more = true
    while more {
        let line = io::read_line{ &io, into = buf[..] }
        if line == null {
            more = false
        } else {
            let n = utf8::parse_i64{ s = utf8::trim{ s = line } }
            if n != null { total = total + n }
            io::println{ &io, s = line }
        }
    }
    io::println_i64{ &io, n = total }
}

