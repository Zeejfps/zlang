// `P{ x: 1, y: 2 }` gives its fields with `=`: `P{ x = 1, y = 2 }`, in a call too.

struct P { x: i32, y: i32 }
fn add { a: i32, b: i32 } -> i32 { return a + b }
fn main {} -> i32 {
    let p = P{ x: 1, y: 2 }  //~ error at 17: a field is given with `=` in ctxlang: write `x = 1`, not `x: 1`  //~ error at 23: a field is given with `=` in ctxlang: write `x = 1`, not `x: 1`
    return add{ a: p.x, b = p.y }  //~ error at 18: a field is given with `=` in ctxlang: write `x = 1`, not `x: 1`
}
