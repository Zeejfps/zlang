// Borrowing summaries and callback records (provenance and callback lifetimes):
// callback capture store effect: rejected. It is never run: it would use a dangling pointer.

struct Holder { s: []u8 }
fn put { mut h: Holder, s: []u8 } { h.s = s }
fn invoke { f: &fn{}, h: *Holder } -> []u8 { f{}; return h.s }
fn load { h: *mut Holder } -> []u8 {
    let buf: [3]u8 = [1,2,3]
    let callback = put{ h, s = buf[..], _ }
    return invoke{ f = callback, h }  //~ error at 5: returned value holds the address of local `buf` //~ note at -2:5: `buf` is declared here
}
fn main {} { let mut h: Holder; _ = load{ h = &h } }
