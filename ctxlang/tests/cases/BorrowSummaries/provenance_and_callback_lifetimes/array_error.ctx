// Borrowing summaries and callback records (provenance and callback lifetimes):
// array error: rejected. It is never run: it would use a dangling pointer.

error bad{ p: *i32 }
fn wrap { p: *i32 } -> [1]!*i32 { return [bad{ p }] }
fn relay { p: *i32 } -> !*i32 { return wrap{ p }[0] }
fn leak {} -> ! { let x: i32 = 1; _ = try relay{ p=&x } }  //~ error at 39: `try` would return an error that may hold the address of local `x` //~ note at 19: `x` is declared here
fn main {} { _ = leak{} }
