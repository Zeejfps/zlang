// Borrowing summaries and callback records (provenance and callback lifetimes):
// nested try preserves inner error: rejected. It is never run: it would use a dangling pointer.

error bad{ p: *i32 }
fn wrap(T) { x: T } -> !T { return x }
fn relay { p: *i32 } -> ! { let r: !*i32 = bad{ p }; _ = try try wrap{ x = r } }
fn leak {} -> ! { let x: i32 = 1; try relay{ p = &x } }  //~ error at 35: `try` would return an error that may hold the address of local `x` //~ note at 19: `x` is declared here
fn main {} { _ = leak{} }
