// Borrowing summaries and callback records (provenance and callback lifetimes):
// generic pointer store effect: rejected. It is never run: it would use a dangling pointer.

struct Box(T) { x: T }
fn stash(T) { mut h: Box(T), x: T } { h.x = x }
fn stored(T) { mut h: Box(T), x: T } -> T { stash{ &h, x }; return h.x }
fn leak { mut h: Box([]u8) } -> []u8 {
    let buf: [3]u8 = [1,2,3]
    return stored{ &h, x = buf[..] }  //~ error at 24: `stored` keeps `x` in `h`, which belongs to the caller and outlives local `buf` whose address it holds //~ note at -1:5: `buf` is declared here //~ note at -2:11: `h` is a context field, declared here //~ error at 5: returned value holds the address of local `buf` //~ note at -1:5: `buf` is declared here
}
fn main {} { let mut h: Box([]u8); _ = leak{ &h } }
