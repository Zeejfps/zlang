// Borrowing summaries and callback records (provenance and callback lifetimes):
// address of slice element borrows input: rejected. It is never run: it would use a dangling pointer.

fn first { s: []u8 } -> *u8 { return &s[0] }
fn load {} -> *u8 { let buf: [3]u8 = [1,2,3]; return first{ s = buf[..] } }  //~ error at 47: returned value holds the address of local `buf` //~ note at 21: `buf` is declared here
fn main {} { _ = load{} }
