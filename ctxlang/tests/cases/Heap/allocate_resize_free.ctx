// std's heap (std/heap.ctx): a block is allocated zeroed, keeps its bytes through a resize that
// grows and one that shrinks, holds zeros past what a resize keeps, and is freed, as
// alloc::Fn(Heap) promises.

struct Point { x: i32, y: i32 }

fn main { mut io: Io, mut mem: Mem } -> i32 {
    let mut h = heap::new{ &mem }
    let mut a = alloc::make(u32, heap::Heap){ realloc = heap::alloc, heap = &h, count = 4 } iferr { return 1 }
    _ = @fmt(&io, "{} {} {}\n", a.len, a[0], a[3])
    for i in 0..4 { a[i] = @as(u32, i + 1) * 10 }
    a = alloc::resize(u32, heap::Heap){ realloc = heap::alloc, heap = &h, mem = a, count = 1000 } iferr { return 2 }
    _ = @fmt(&io, "{} {} {} {} {}\n", a.len, a[0], a[3], a[4], a[999])
    for i in 0..1000 { a[i] = 7 }
    a = alloc::resize(u32, heap::Heap){ realloc = heap::alloc, heap = &h, mem = a, count = 2 } iferr { return 3 }
    a = alloc::resize(u32, heap::Heap){ realloc = heap::alloc, heap = &h, mem = a, count = 600 } iferr { return 4 }
    _ = @fmt(&io, "{} {} {} {} {}\n", a.len, a[0], a[1], a[2], a[599])
    a = alloc::resize(u32, heap::Heap){ realloc = heap::alloc, heap = &h, mem = a, count = 0 } iferr { return 5 }
    _ = @fmt(&io, "{}\n", a.len)

    // One T, and a free of it; an empty allocation is no block, and freeing it is nothing.
    let p = alloc::new(Point, heap::Heap){ realloc = heap::alloc, heap = &h, value = Point{ x = 3, y = 4 } } iferr { return 6 }
    _ = @fmt(&io, "{} {}\n", p.x, p.y)
    alloc::free(Point, heap::Heap){ realloc = heap::alloc, heap = &h, p }
    let none = alloc::make(u64, heap::Heap){ realloc = heap::alloc, heap = &h, count = 0 } iferr { return 7 }
    _ = alloc::resize(u64, heap::Heap){ realloc = heap::alloc, heap = &h, mem = none, count = 0 } iferr { return 8 }
    _ = @fmt(&io, "{}\n", none.len)
    return 0
}

//# stdout:
//| 4 0 0
//| 1000 10 40 0 0
//| 600 7 7 0 0
//| 0
//| 3 4
//| 0
