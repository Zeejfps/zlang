// The platform's heap returns null where it has no room, for 2^62 bytes, which std's heap
// passes on as alloc::out_of_memory, at an alignment of the platform's or one it adds room for,
// and a resize that fails leaves the block as it was. The interpreter gives no block of more
// than 64 MiB, so it refuses the program.

fn main { mut io: Io, mut mem: Mem } -> i32 {
    let mut h = heap::new{ &mem }
    match alloc::make(u8, heap::Heap){ realloc = heap::alloc, heap = &h, count = 4611686018427387904 } {
        ok                    => { io::println{ &io, s = "ok" } }
        alloc::out_of_memory  => { io::println{ &io, s = "out of memory" } }
    }
    let r = heap::alloc{ heap = &h, mem = slice::empty(u8){}, new = 4611686018427387904, align = 4096 }
    _ = @fmt(&io, "{}\n", r == null)
    let mut a = alloc::make(u8, heap::Heap){ realloc = heap::alloc, heap = &h, count = 3 } iferr { return 1 }
    a[2] = 5
    match alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = &h, mem = a, count = 4611686018427387904 } {
        ok                    => { io::println{ &io, s = "ok" } }
        alloc::out_of_memory  => { io::println{ &io, s = "out of memory" } }
    }
    _ = @fmt(&io, "{} {}\n", a.len, a[2])
    a = alloc::resize(u8, heap::Heap){ realloc = heap::alloc, heap = &h, mem = a, count = 0 } iferr { return 2 }
    return 0
}

//# interp: cannot run
//# stdout:
//| out of memory
//| true
//| out of memory
//| 3 5
