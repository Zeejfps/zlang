// `~` never overflows, but ifoverflow covers what its operand covers.

fn main {} {
    let a: u8 = 250
    _ = ~a ifoverflow 0  //~ error at 12: nothing before `ifoverflow` can overflow: it covers the integer `+`, `-`, `*` and `/`, unary `-`, and `@as` and `@round` to an integer written before it, and the operands of those in turn
}
