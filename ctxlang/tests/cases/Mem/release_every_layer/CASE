// mem::release over each platform's layer (std/os/PLATFORM, spec §17). A build checks and
// lowers only its own layer's functions, so main.ctx, which reaches pages, reserve and
// release_pages, is built here for each layer from any machine, and the C written for Linux and
// macOS is compiled as far as C's syntax and types go, without their system headers: the
// generated C declares each C function itself.

// linux and macos: a mapping of its own for each region, mmap's, which munmap gives back.
//# $ ctxc build linux.c {std:linux} -- main.ctx
//# exit: 0
//# file linux.c has:
//| CTX_SYMBOL("mmap")
//# file linux.c has:
//| CTX_SYMBOL("munmap")
//# file linux.c lacks:
//| CTX_SYMBOL("aligned_alloc")
//# $ cc {cflags} -fsyntax-only -I {home}/ctxc/rt linux.c
//# exit: 0

//# $ ctxc build macos.c {std:macos} -- main.ctx
//# exit: 0
//# file macos.c has:
//| CTX_SYMBOL("mmap")
//# file macos.c has:
//| CTX_SYMBOL("munmap")
//# $ cc {cflags} -fsyntax-only -I {home}/ctxc/rt macos.c
//# exit: 0

// windows: VirtualAlloc's reservations, which VirtualFree gives back whole.
//# $ ctxc build windows.c {std:windows} -- main.ctx
//# exit: 0
//# file windows.c has:
//| CTX_SYMBOL("VirtualAlloc")
//# file windows.c has:
//| CTX_SYMBOL("VirtualFree")

// interp: the interpreter's own memory, which a run never gives back.
//# $ ctxc build interp.c {std:interp} -- main.ctx
//# exit: 0
//# file interp.c has:
//| CTX_SYMBOL("ctx_interp_pages")
//# file interp.c lacks:
//| CTX_SYMBOL("munmap")

// And it runs, here and in the interpreter.
//# program: main.ctx
//# stdout:
//| ok
