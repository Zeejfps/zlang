// A slice whose length isn't a multiple of mem::PAGE is no region mem::pages or mem::reserve
// returned, though it starts where one does.

fn main { mut io: Io, mut mem: Mem } -> i32 {
    let some{ value = p } = mem::reserve{ &mem, size = 8192 } else { return 1 }
    mem::release{ &mem, pages = p[..100] }
    return 0
}

//# panic: std/mem.ctx:71:36: panic: mem::release: the memory's length isn't a multiple of mem::PAGE, as a region's from mem::pages or mem::reserve is
//# path:
//|   at mem::release (std/mem.ctx:71:36)
//|   at main (release_bad_length.ctx:6:17)
