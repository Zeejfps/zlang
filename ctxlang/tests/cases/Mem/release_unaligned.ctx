// A slice that doesn't start at a page is no region mem::pages or mem::reserve returned.

fn main { mut io: Io, mut mem: Mem } -> i32 {
    let some{ value = p } = mem::pages{ &mem, size = 8192 } else { return 1 }
    mem::release{ &mem, pages = p[1..4097] }
    return 0
}

