namespace m {
    capability L
    #c_symbol{ name = "llabs" }
    #pure
    extern fn abs { n: i64 } -> i64
    #c_symbol{ name = "strlen" }
    #pure
    extern fn len { s: cstr } -> usize
    #c_symbol{ name = "atoi" }
    #pure
    extern fn int { s: cstr } -> i32
    capability A { abs: extern fn{ n: i64 } -> i64 }
    capability B { ..A, len: extern fn{ s: cstr } -> usize }
    capability C { int: extern fn{ s: cstr } -> i32, ..B }
    fn load_a { mut l: L } -> A { return A{ abs } }
    fn load_b { mut l: L } -> B { return B{ ..load_a{ &l }, len } }
    fn load_c { mut l: L } -> C { return C{ int, ..load_b{ &l } } }
}
fn main { mut l: m::L } { let a = m::load_a{ &l }
    let b: m::B = a }  //~ error at 19: expected B, got A
