namespace m {
    capability L
    capability M { f: extern fn{ n: i64 } -> i64 }
    #c_symbol{ name = "llabs" }
    #pure
    extern fn abs { n: i64 } -> i64
    fn load { mut l: L } -> M { return M{ f = abs } }
}
fn g { f: extern fn{ n: i64 } -> i64 } {}
fn main { mut l: m::L } { let mut x = m::load{ &l }
    g{ f = x.f } }  //~ error at 13: `f` is a field of capability M: it can only be called, as `x.f{ ... }`
