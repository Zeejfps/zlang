namespace m {
    capability L
    capability M { f: extern fn{ n: i64 } -> i64 }
    #c_symbol{ name = "llabs" }
    #pure
    extern fn abs { n: i64 } -> i64
    fn load { mut l: L } -> M { return M{ f = abs } }
}
#c_callback
fn cb { mut x: m::M, n: i32 } {}  //~ error at 1: callback `cb` can't take `x`: capability M has fields, and nothing can supply one when C calls the callback
fn main {} {}
