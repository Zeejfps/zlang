namespace m {
    capability L
    capability M { f: extern fn{ n: i64 } -> i64 }
    #c::symbol{ name = "llabs" }
    #pure
    extern fn abs { n: i64 } -> i64
    fn load { mut l: L } -> M { return M{ f = abs } }
}
fn main { mut l: m::L } { let mut x = m::load{ &l }
    let f = x.f }  //~ error at 14: `f` is a field of capability M: it can only be called, as `x.f{ ... }`
