namespace m {
    capability L
    capability M { f: extern fn{ n: i64 } -> i64 }
    #c::symbol{ name = "llabs" }
    #pure
    extern fn abs { n: i64 } -> i64
    fn load { mut l: L } -> M { return M{ f = abs } }
}
fn main { mut l: m::L } -> i32 { let mut x = m::load{ &l }
    return @trunc(i32, x.f{ n = -2 }) }