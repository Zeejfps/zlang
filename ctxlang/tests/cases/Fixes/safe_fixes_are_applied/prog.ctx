// A program whose every error says what to write.

struct Movie { n: i32 }
struct Opts { depth: i32 = 3, wide: bool = false, name: []u8 }
enum Kind: u8 { small, big }
union Shape { dot, box{ w: i32 } }
struct Pair {
    a: i32
    b: i32
}
capability Clock {}
error bad
const LIMIT: i64 = far{}

fn far {} -> i64 { return 4000000000 }
fn next { mut m: Movie } { m.n = m.n + 1 }
fn count {} -> i32 { return 3 }
fn add { n: i32, k: i32 } -> i32 { return n + k }
fn take { mut heap: Movie } { heap.n = heap.n + 1 }
fn via { heap: *mut Movie, q: *i32, i: i32 } -> i32 {
    take{ &heap }
    return q[i]
}
fn pick { kp: *Kind } -> i32 {
    match kp {
        small => { return 1 }
        big => { return 2 }
    }
}
fn bump { mut seen: ?i32 } {
    if let &v = seen { v = v + 1 }
}
fn none { return }
fn risky { n: i32 } -> !i32 { return if n > 0 { n } else { bad } }
fn fails {} -> !i32 { return bad{} }
fn main { mut io: Io } {
    let mut movie = Movie{ n = 1 }
    next{ &movie }
    count{}
    let n: i32 = 2
    let k: i32 = 5
    let s = add{ n }
    let o = Opts{ name = "x" }
    let c = @clamp(s, 10, 0)
    let kd = Kind::small{}
    let sh = Shape::dot{}
    let wide: u64 = LIMIT
    let mut total: i32 = 0
    for i in range(3) { total = total + i }
    for j in 0..=n { total = total + j }
    for t in n { total = total + t }
    for &u in 0..2 { total = total + u }
    for r in range(1, 3) { total = total + r }
    risky{ n = 1 } iferr { 0 }
    total = total + (fails{} iferr { 100 })
    if sh is Shape::dot { total = total + c }
    let nums: [3]i32 = [10, 20, 30]
    let mut seen: ?i32 = 6
    bump{ &seen }
    none{}
    _ = @fmt(&io, "{} {} {} {} {}\n", movie.n, o.depth, pick{ kp = &kd }, via{ heap = &movie, q = &nums[0], i = 2 }, total)
    _ = @fmt(&io, "{} {} {}\n", wide, movie.n, seen ifnull 0)
}
