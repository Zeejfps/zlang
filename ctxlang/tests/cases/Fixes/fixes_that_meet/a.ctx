// Two fixes whose edits meet: the element of a pointer, at an index that is the element of
// another. One is made, and the other by the next check, which reads the file as the first
// left it.

fn pick { q: *i32, r: *usize, j: usize } -> i32 {
    return q[r[j]]
}
fn main { mut io: Io } {
    let xs: [3]i32 = [10, 20, 30]
    let at: [2]usize = [2, 1]
    io::println_i64{ &io, n = pick{ q = &xs[0], r = &at[0], j = 1 } }
}
