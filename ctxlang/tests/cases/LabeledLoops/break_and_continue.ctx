
fn main { mut io: Io } {
    let mut i = 0
    outer:
    while i < 4 {
        i = i + 1
        let mut j = 0
        while j < 4 {
            j = j + 1
            if j == 2 { continue outer }
            if i == 3 { break outer }
            io::println_i64{ &io, n = i * 10 + j }
        }
    }
    io::println_i64{ &io, n = i }
}

//# stdout:
//| 11
//| 21
//| 3
