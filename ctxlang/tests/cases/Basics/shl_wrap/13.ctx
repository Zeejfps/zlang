// §11, Expressions, rule 4: `a <<% n` is `a << n` with the bits shifted out dropped. It
// has `<<`'s operands, result type and precedence, and its count is checked the same.

fn main {} {
    let a: u8 = 1
    let x = a <<% 1 ifoverflow 0  //~ error at 21: nothing before `ifoverflow` can overflow: it covers the integer `+`, `-`, `*` and `/`, unary `-`, and `@as` and `@round` to an integer written before it, and the operands of those in turn
}
