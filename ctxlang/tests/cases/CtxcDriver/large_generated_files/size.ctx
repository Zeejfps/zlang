// Says whether the file args[0] is of more than args[1] bytes.
fn main { mut io: Io, mut fs: Fs, args: Args } -> i32 {
    if args.len != 2 { return 64 }
    let least = utf8::parse_u64{ s = utf8::of{ chars = args[1] } } ifnull { return 64 }
    let size = fs::size{ &fs, path = args[0] } iferr {
        io::println{ &io, s = "no such file" }
        return 1
    }
    if size > least { _ = @fmt(&io, "more than {} bytes\n", least) } else { _ = @fmt(&io, "{} bytes\n", size) }
    return 0
}
