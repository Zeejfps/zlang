// Says how C functions are defined in the units ctxc wrote: for the directory args[0] and each
// pair UNIT FN after it, a line
//
//   UNIT FN: defined static | defined extern | not defined | not defined, declared extern
//
// UNIT is the one .c file there whose first line says it is generated from a file whose name
// ends in UNIT (`// Generated by ctxc from PATH/UNIT.`), and FN the function `f_a__FN`: a line
// `[static ]TYPE f_a__FN(...) {` defines it, and a line `TYPE f_a__FN(...);` declares it extern,
// which is said of a unit that doesn't define it: it uses another's.

type Heap = arena::Arena

fn main { mut io: Io, mut fs: Fs, mut mem: Mem, args: Args } -> i32 {
    if args.len < 3 or args.len % 2 != 1 { return 64 }
    let mut heap = arena::new{ buf = mem::reserve{ &mem, size = 268435456 } ifnull { return 70 } }
    let dir = args[0]
    let names = fs::list(Heap){ &fs, &heap, realloc = arena::alloc, path = dir } iferr {
        io::println{ &io, s = "no such directory" }
        return 1
    }
    let mut k: usize = 1
    while k < args.len {
        let unit = args[k]
        let name = args[k + 1]
        k = k + 2
        // The unit's text: of the one file that says it is that unit.
        let mut text: []u8 = ""
        let mut found: u32 = 0
        for n in names {
            if n.len < 2 or not same{ a = n[n.len - 2..], b = ".c" } { continue }
            let mut path = utf8::builder{ realloc = arena::alloc, &heap }
            try! @fmt(&path, "{}/{}", dir, n)
            let bytes = fs::read_all(Heap){ &fs, &heap, realloc = arena::alloc, path = utf8::view{ b = path }.bytes } iferr { continue }
            if is_unit{ text = bytes, unit } {
                text = bytes
                found = found + 1
            }
        }
        if found != 1 {
            _ = @fmt(&io, "{} {}: {} units of that name\n", unit, name, found)
            continue
        }
        let mut symbol = utf8::builder{ realloc = arena::alloc, &heap }
        try! @fmt(&symbol, " f_a__{}(", name)
        let mut defined: []u8 = ""
        let mut declared = false
        let mut start: usize = 0
        while start < text.len {
            let mut end = start
            while end < text.len and text[end] != '\n' { end = end + 1 }
            let line = text[start..end]
            start = end + 1
            let is_static = line.len > 7 and same{ a = line[..7], b = "static " }
            let rest = if is_static { line[7..] } else { line }
            // TYPE, a word, then ` f_a__FN(`.
            let mut w: usize = 0
            while w < rest.len and (ascii::is_alnum{ c = rest[w] } or rest[w] == '_') { w = w + 1 }
            let s = utf8::view{ b = symbol }.bytes
            if w == 0 or rest.len < w + s.len or not same{ a = rest[w..w + s.len], b = s } { continue }
            if rest.len >= 3 and same{ a = rest[rest.len - 3..], b = ") {" } {
                defined = if is_static { "defined static" } else { "defined extern" }
            } else if not is_static and same{ a = rest[rest.len - 2..], b = ");" } {
                declared = true
            }
        }
        if defined.len == 0 { defined = if declared { "not defined, declared extern" } else { "not defined" } }
        _ = @fmt(&io, "{} {}: {}\n", unit, name, defined)
    }
    return 0
}

fn same { a: []u8, b: []u8 } -> bool {
    return slice::eq_bytes{ a, b }
}

// Whether a C file's first line is `// Generated by ctxc from PATH.`, with PATH ending in
// `unit` and holding no comma.
fn is_unit { text: []u8, unit: []u8 } -> bool {
    let head = "// Generated by ctxc from "
    if text.len < head.len or not same{ a = text[..head.len], b = head } { return false }
    let mut i = head.len
    while i < text.len and text[i] != ',' and text[i] != '\n' {
        if i + unit.len < text.len and same{ a = text[i..i + unit.len], b = unit } and text[i + unit.len] == '.' { return true }
        i = i + 1
    }
    return false
}
