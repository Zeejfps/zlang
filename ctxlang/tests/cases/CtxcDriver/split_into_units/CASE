// CTX_UNIT_SIZE=1 puts each function in a unit of its own: callbacks, function values,
// binds, consts, extern fns and panic positions across units.
//
// logcc is the C compiler, and logs its command lines in the directory each command names
// (tests/helpers/logcc.ctx).
//# build logcc: {home}/tests/helpers/logcc.ctx

//# $ ctxc run {dir}
//# env: CTX_CC={logcc}
//# env: LOGCC_CC={cc}
//# env: LOGCC_DIR={dir}/log1
//# env: CTX_UNIT_SIZE=1
//# exit: 5
//# stdout:
//| 9 7 4 2
//| same callback: true
//| 7 and 42
// More than ten units of the program were compiled.
//# $ {logcc} --logcc-more 10 lines {dir}/log1 has " -c " has "CTX_PROGRAM_NAME=\x22split\x22"
//# stdout:
//| more than 10

//# $ ctxc run {dir} -- deep
//# env: CTX_CC={logcc}
//# env: LOGCC_CC={cc}
//# env: LOGCC_DIR={dir}/log2
//# env: CTX_UNIT_SIZE=1
//# stdout:
//| 9 7 4 2
//| same callback: true
//| 7 and 42
//# panic: {dir}/lib/b.ctx:15:22: panic: division by zero
//# path:
//|   at b::run ({dir}/lib/b.ctx:15:22)
//|   at main ({dir}/main.ctx:14:27)
// Nothing was compiled for it.
//# $ {logcc} --logcc-count lines {dir}/log2
//# stdout:
//| 0

// An edit to one function recompiles its unit alone: `inc` adds 2, not 1.
//# write lib/a.ctx:
//|
//| const ORIGIN: a::Point = a::Point{ x = 3, y = 4 }
//|
//| namespace a {
//|     struct Point { x: i64, y: i64 }
//|
//|     #pure
//|     extern fn labs { n: i64 } -> i64
//|     #pure
//|     extern fn qsort { base: *mut u8, n: usize, size: usize, cmp: extern fn{ x: *u8, y: *u8 } -> i32 }
//|
//|     #c_callback
//|     fn descending { x: *u8, y: *u8 } -> i32 {
//|         let p = @cast(*i32, x).*
//|         let q = @cast(*i32, y).*
//|         return if p < q { 1 } else if p > q { -1 } else { 0 }
//|     }
//|
//|     fn sort { mut xs: [4]i32 } { qsort{ base = @cast(*mut u8, &xs), n = 4, size = 4, cmp = descending } }
//|
//|     // descending's address as C sees it, from this file's unit.
//|     fn here {} -> usize {
//|         let f: extern fn{ x: *u8, y: *u8 } -> i32 = descending
//|         return @addr(@cast(*u8, f))
//|     }
//|
//|     fn inc { x: i64 } -> i64 { return x + labs{ n = -2 } }
//|
//|     fn norm { p: Point } -> i64 { return labs{ n = p.x } + labs{ n = p.y } }
//| }
//# $ ctxc run {dir}
//# env: CTX_CC={logcc}
//# env: LOGCC_CC={cc}
//# env: LOGCC_DIR={dir}/log3
//# env: CTX_UNIT_SIZE=1
//# exit: 5
//# stdout:
//| 9 7 4 2
//| same callback: true
//| 7 and 44
//# $ {logcc} --logcc-count lines {dir}/log3 has " -c "
//# stdout:
//| 1
// The program's objects in ctxc's directory are as many as the units compiled at first.
//# $ {logcc} --logcc-equal lines {dir}/log1 has " -c " has "CTX_PROGRAM_NAME=\x22split\x22" / files {work:.} split- .o
//# stdout:
//| equal

// Without CTX_UNIT_SIZE, so small a program is one unit.
