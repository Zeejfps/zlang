// build::gen_file's files join the executable, from the program's build directory. One
// whose text is the same isn't written again, so its C isn't compiled again; those this
// build doesn't generate are removed.
//
// logcc is the C compiler, and logs its command lines in the directory each command names
// (tests/helpers/logcc.ctx); stamp says whether a file was written since (stamp.ctx).
//# build logcc: {home}/tests/helpers/logcc.ctx
//# build stamp: {home}/tests/helpers/stamp.ctx

//# $ ctxc run {dir}
//# env: CTX_CC={logcc}
//# env: LOGCC_CC={cc}
//# env: LOGCC_DIR={dir}/log1
//# stdout:
//| 3
//# list {work:.}/gen/t:
//| one.ctx
//| two.ctx
//# file {work:.}/gen/t/one.ctx:
//| namespace one { fn n {} -> i64 { return 1 } }
//# $ {stamp} save {work:.}/gen/t/one.ctx {dir}/one.stamp
//# stdout:
//| saved

// The same again: no C is compiled, and one.ctx isn't written.
//# $ ctxc run {dir}
//# env: CTX_CC={logcc}
//# env: LOGCC_CC={cc}
//# env: LOGCC_DIR={dir}/log2
//# stdout:
//| 3
//# $ {logcc} --logcc-count lines {dir}/log2
//# stdout:
//| 0
//# $ {stamp} same {work:.}/gen/t/one.ctx {dir}/one.stamp
//# stdout:
//| not written since

