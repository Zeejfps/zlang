// names differ only in case.
//# write build.ctx:
//| fn build { mut b: Build } {
//|     let exe = build::exe{ &b, name = "t", root = "src" }
//|     build::gen_file{ &b, exe, name = "x", text = "" }
//|     build::gen_file{ &b, exe, name = "y", text = "" }
//|     build::gen_file{ &b, exe, name = "x", text = "" }
//| }
//# $ ctxc run .
//# exit: 1
//# stderr:
//| build.ctx: gives executable t two files named x.ctx
//# project
