// The driver checks the graph where names leave it, and rejects one cut short before it
// writes or removes anything. Each build is run by `ctxc run .` and by `ctxc graph`, for the
// `project` step. The first generates keep.ctx, which is still there after each bad graph.
//# $ ctxc run .
//# stdout:
//| 5
//# project
//# $ {t}
//# stdout:
//| 5
//# exists {work:.}/gen/t/keep.ctx

// cut short
//# write build.ctx:
//| fn build { mut fs: Fs, mut proc: Proc } {
//|     let path = proc::env{ &proc, name = "CTX_BUILD_OUT" } ifnull { return }
//|     _ = fs::write_all{ &fs, path, bytes = "exe\t0\tt\tsrc" }
//| }
//# $ ctxc run .
//# exit: 1
//# stderr:
//| {any}: is not a build graph
//# project
//# errors:
//| {any}: is not a build graph
//# exists {work:.}/gen/t/keep.ctx

