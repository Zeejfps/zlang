// Every extern fn says what C does (spec §18, Extern functions, rule 8): a capability
// field for what it touches, or `#pure`.

extern fn labs { n: i64 } -> i64  //~ error at 11: extern fn `labs` takes no capability: add a capability field for what it touches, or `#pure` if it touches only its arguments and the memory they point to
fn main {} {}
