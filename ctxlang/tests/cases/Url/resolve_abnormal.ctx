// RFC 3986 §5.4.2's abnormal examples, all of them, against "http://a/b/c/d;p?q": more `..`
// than the path has, dots that aren't whole segments, dot segments in a query or a fragment,
// which stay, and "http:g", which a strict parser reads as a scheme and a path. After them,
// what isn't in §5.4: a base with an empty path, a reference with an empty query, and a path
// that would begin with "//" without an authority, which begins "/.//" instead.

fn show { mut io: Io, base: url::Url, reference: []u8 } {
    let mut buf: [128]u8
    let mut mem: [512]u8
    let mut heap = arena::new{ buf = mem[..] }
    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
    let u = url::resolve{ base, reference, into = buf[..] } iferr err{ error } {
        _ = @fmt(&io, "\"{}\" -> {}\n", reference, error)
        return
    }
    try! @fmt(&b, "{}", u)
    _ = @fmt(&io, "\"{}\" = \"{}\" (path \"{}\")\n", reference, utf8::view{ b }, u.path)
}

fn main { mut io: Io } {
    let base = try! url::parse{ text = "http://a/b/c/d;p?q" }
    show{ &io, base, reference = "../../../g" }
    show{ &io, base, reference = "../../../../g" }
    show{ &io, base, reference = "/./g" }
    show{ &io, base, reference = "/../g" }
    show{ &io, base, reference = "g." }
    show{ &io, base, reference = ".g" }
    show{ &io, base, reference = "g.." }
    show{ &io, base, reference = "..g" }
    show{ &io, base, reference = "./../g" }
    show{ &io, base, reference = "./g/." }
    show{ &io, base, reference = "g/./h" }
    show{ &io, base, reference = "g/../h" }
    show{ &io, base, reference = "g;x=1/./y" }
    show{ &io, base, reference = "g;x=1/../y" }
    show{ &io, base, reference = "g?y/./x" }
    show{ &io, base, reference = "g?y/../x" }
    show{ &io, base, reference = "g#s/./x" }
    show{ &io, base, reference = "g#s/../x" }
    show{ &io, base, reference = "http:g" }

    show{ &io, base, reference = "?" }                    // a query, empty, replaces the base's
    show{ &io, base, reference = "#" }
    show{ &io, base, reference = "HTTPS://A/./x/../y" }   // a scheme's path loses its dots too
    show{ &io, base, reference = "//user@h:81/a/../b" }
    show{ &io, base, reference = "g h" }                  // a reference that isn't one
    let bare = try! url::parse{ text = "http://h" }
    show{ &io, base = bare, reference = "g" }             // §5.2.3: "/" and the reference
    show{ &io, base = bare, reference = "?x" }
    let opaque = try! url::parse{ text = "a:/b" }
    show{ &io, base = opaque, reference = "..//c" }       // not "a://c", whose authority is c
    show{ &io, base = opaque, reference = "./x" }
}

//# stdout:
//| "../../../g" = "http://a/g" (path "/g")
//| "../../../../g" = "http://a/g" (path "/g")
//| "/./g" = "http://a/g" (path "/g")
//| "/../g" = "http://a/g" (path "/g")
//| "g." = "http://a/b/c/g." (path "/b/c/g.")
//| ".g" = "http://a/b/c/.g" (path "/b/c/.g")
//| "g.." = "http://a/b/c/g.." (path "/b/c/g..")
//| "..g" = "http://a/b/c/..g" (path "/b/c/..g")
//| "./../g" = "http://a/b/g" (path "/b/g")
//| "./g/." = "http://a/b/c/g/" (path "/b/c/g/")
//| "g/./h" = "http://a/b/c/g/h" (path "/b/c/g/h")
//| "g/../h" = "http://a/b/c/h" (path "/b/c/h")
//| "g;x=1/./y" = "http://a/b/c/g;x=1/y" (path "/b/c/g;x=1/y")
//| "g;x=1/../y" = "http://a/b/c/y" (path "/b/c/y")
//| "g?y/./x" = "http://a/b/c/g?y/./x" (path "/b/c/g")
//| "g?y/../x" = "http://a/b/c/g?y/../x" (path "/b/c/g")
//| "g#s/./x" = "http://a/b/c/g#s/./x" (path "/b/c/g")
//| "g#s/../x" = "http://a/b/c/g#s/../x" (path "/b/c/g")
//| "http:g" = "http:g" (path "g")
//| "?" = "http://a/b/c/d;p?" (path "/b/c/d;p")
//| "#" = "http://a/b/c/d;p?q#" (path "/b/c/d;p")
//| "HTTPS://A/./x/../y" = "HTTPS://A/y" (path "/y")
//| "//user@h:81/a/../b" = "http://user@h:81/b" (path "/b")
//| "g h" -> url::bad_url{ at = 1 }
//| "g" = "http://h/g" (path "/g")
//| "?x" = "http://h?x" (path "")
//| "..//c" = "a:/.//c" (path "/.//c")
//| "./x" = "a:/x" (path "/x")
