    let n = 3
    let mut i = 0
    if num{ n }
       - 1 > 0 { io::println{ &io, s = "a" } }  //~ error at 8: a condition can't go on with a line that starts with `-`, which may begin a statement: end the line before with the `-`, or put the condition in parentheses
