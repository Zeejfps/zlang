
struct W { open: bool, n: i32 }
union K { a, b }
fn ok { n: i32 } -> bool { return n > 0 }
fn num { n: i32 } -> i32 { return n }
fn opt { n: i32 } -> ?i32 { if n == 0 { return null }; return n }
fn flag { n: i32 } -> ?bool { if n == 0 { return null }; return n > 0 }
fn w { n: i32 } -> W { return W{ open = n > 0, n } }
fn main { mut io: Io } {
    let n = 3
    let mut i = 0
    while num{ n = i }
          - 1 < 2 { i = i + 1 }  //~ error at 11: a condition can't go on with a line that starts with `-`, which may begin a statement: end the line before with the `-`, or put the condition in parentheses; if this line is a value of its own, put that in parentheses
}
