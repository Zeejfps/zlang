
enum Kind: u8 {
    ident,
    number,
    lbrace = 40,
    rbrace,
}

enum Sign: i8 { minus = -1, zero, plus }

fn main { mut io: Io } {
    let k = Kind::lbrace
    io::print_bool{ &io, n = k == Kind::lbrace }
    io::print_bool{ &io, n = k != Kind::lbrace }
    io::println_bool{ &io, n = Kind::ident == Kind::number }
}

//# stdout:
//| truefalsefalse
