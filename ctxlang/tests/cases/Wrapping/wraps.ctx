
fn main { mut io: Io } {
    let a: u8 = 250
    let b: u8 = 10
    let c: i32 = -2147483648
    let n: i64 = 1
    _ = @fmt(&io, "{} {} {}\n", a +% b, b -% a, a *% b)
    _ = @fmt(&io, "{} {} {} {}\n", c -% 1, c *% -1, 2 + 3 *% 4, c +% n)
}

//# stdout:
//| 4 16 196
//| 2147483647 -2147483648 14 -2147483647
