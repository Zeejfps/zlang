// §11, Literals, rule 2: a float literal that would round to an infinity in its type is
// an error, however it takes the type; `@as` gives the infinity.

namespace math { const PI: f32 = 3.0 }
fn main {} { let y: f32 = -1e39 }  //~ error at 27: -1e39 doesn't fit f32 (its largest value is about 3.4e38): write `@as(f32, -1e39)` if infinity is meant
