// §11, Literals, rule 2: a float literal that would round to an infinity in its type is
// an error, however it takes the type; `@as` gives the infinity.

fn main {} { let a: f32 = 2.0; let b = a * 1e39 }  //~ error at 44: 1e39 doesn't fit f32 (its largest value is about 3.4e38): write `math::INF_F32` if infinity is meant
