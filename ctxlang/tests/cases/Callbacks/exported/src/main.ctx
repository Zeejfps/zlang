// The C library calls these by name while ctxtest_hooks runs, on this thread.
#c_export{ name = "game_add" }
fn add { a: i32, b: i32 } -> i32 { return a + b }

// A capability isn't C's: the export supplies it.
#c_export{ name = "game_tick" }
fn tick { mut io: Io, frame: u64 } {
    _ = @fmt(&io, "tick {}\n", frame)
}

struct P { x: i32, y: i32 }
#c_export{ name = "game_swap" }
fn swap { p: P } -> P { return P{ x = p.y, y = p.x } }

// A `mut` field is C's pointer.
#c_export{ name = "game_count" }
fn count { mut total: i64, by: i32 } { total = total + @as(i64, by) }

#c_export{ name = "game_any", any_thread = true }
fn any { n: i32 } -> i32 { return n + 1 }

#c_export{ name = "game_check" }
fn check { n: i32 } -> i32 {
    if n > 2 { @panic("too many") }
    return n
}

extern fn ctxtest_hooks { mut io: Io, add: extern fn{ a: i32, b: i32 } -> i32 } -> i32
#pure
extern fn ctxtest_checks { count: i32 } -> i32

fn main { mut io: Io, args: Args } {
    io::println_i64{ &io, n = ctxtest_hooks{ &io, add } }
    // Still an ordinary fn to ctxlang.
    io::println_i64{ &io, n = add{ a = 1, b = 2 } }
    io::println_i64{ &io, n = ctxtest_checks{ count = 3 } }
    if args.len > 0 { io::println_i64{ &io, n = ctxtest_checks{ count = 4 } } }
}
