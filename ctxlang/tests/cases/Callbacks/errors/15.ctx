// An exported fn is a callback already, in either order.
#c_callback
#c_export{ name = "one" }  //~ error at 1: a fn has `c_callback` or `c_export`, not both: an exported fn is a callback already
fn f {} {}
#c_export{ name = "two" }
#c_callback  //~ error at 1: a fn has `c_callback` or `c_export`, not both: an exported fn is a callback already
fn g {} {}
fn main {} {}
