
fn f { c: bool } -> i32 {
    let x = if c { if c { return 1 } else { return 2 } } else { 3 }
    return x
}
fn main { mut io: Io } {
    io::println_i64{ &io, n = f{ c = true } }
    io::println_i64{ &io, n = f{ c = false } }
    let o: ?i32 = 4
    let y = if true {
        match o {
            null => { 0 }
            some{ value } => { if value > 3 { 30 } else { 3 } }
        }
    } else {
        1
    }
    io::println_i64{ &io, n = y }
}

//# stdout:
//| 1
//| 3
//| 30
