// Becomes the program args[1] with the arguments after it, with the descriptors that args[0]
// names closed (`0`, `012`): what a shell's `exec PROGRAM ARGS... <&- >&- 2>&-` does.

extern fn close { mut proc: Proc, fd: i32 } -> i32

#c::symbol{ name = "execv" }
extern fn become { mut proc: Proc, path: *u8, argv: *?*u8 } -> i32

fn main { mut proc: Proc, args: Args } -> i32 {
    if args.len < 2 or args.len > 16 { return 64 }
    // The words as C's strings, and pointers to them with a null after the last.
    let mut text: [16384]u8
    let mut words: [16]?*u8
    let mut at: usize = 0
    let mut i: usize = 1
    while i < args.len {
        let word = args[i]
        if at + word.len + 1 > text.len { return 64 }
        words[i - 1] = text[at..].ptr
        let mut k: usize = 0
        while k < word.len {
            text[at + k] = word[k]
            k = k + 1
        }
        text[at + word.len] = 0
        at = at + word.len + 1
        i = i + 1
    }
    words[args.len - 1] = null
    for c in args[0] { _ = close{ &proc, fd = @as(i32, c - '0') } }
    let path = words[0] ifnull { return 64 }
    _ = become{ &proc, path, argv = words[..].ptr }
    return 127
}
