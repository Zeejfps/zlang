// A literal where an Address is expected is parsed while compiling, so one that isn't an
// address is a compile error at the literal, with bad_address's offset.

fn take { address: net::Address } -> u16 { return address.port }
fn main {} {
    let a: net::Address = "127.0.0.1"  //~ error at 27: string literal: net::bad_address{ at = 9 }
    _ = take{ address = "[::1]:65536" }  //~ error at 25: string literal: net::bad_address{ at = 6 }
}
