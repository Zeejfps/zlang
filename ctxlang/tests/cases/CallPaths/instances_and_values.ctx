// A generic fn's instance is named with its arguments, and a bound fn or a fn value by the
// fn it calls: the code between them is the compiler's, and no frame. Here a fn value, bound
// and called through `apply`'s `f`, reaches `pick`.

fn third(T) { xs: []T } -> T { return xs[2] }

fn apply(T) { f: &fn{ n: usize } -> T, n: usize } -> T { return f{ n } }

fn pick { xs: []i64, n: usize } -> i64 { return third(i64){ xs = xs[..n] } }

fn main { mut io: Io } {
    let xs: [3]i64 = [1, 2, 3]
    _ = @fmt(&io, "{}\n", apply(i64){ f = pick{ xs = xs[..], _ }, n = 3 })
    let g: fn{ xs: []i64, n: usize } -> i64 = pick
    _ = @fmt(&io, "{}\n", g{ xs = xs[..], n = 3 })
    _ = @fmt(&io, "{}\n", apply(i64){ f = g{ xs = xs[..], _ }, n = 2 })
}

//# stdout:
//| 3
//| 3
//# panic: instances_and_values.ctx:5:41: panic: index 2 out of bounds for length 2
//# path:
//|   at third(i64) (instances_and_values.ctx:5:41)
//|   at pick (instances_and_values.ctx:9:59)
//|   at apply(i64) (instances_and_values.ctx:7:66)
//|   at main (instances_and_values.ctx:16:37)
