
struct Tlk { n: i32 }
struct World { tlk: ?Tlk, count: i32 }
fn bump { mut t: Tlk } { t.n = t.n + 1 }
fn find { n: i32 } -> ?i32 {
    if n > 0 { return n * 10 }
    return null
}
fn tick { mut w: World } {
    if let t = w.tlk { bump{ &t } }  //~ error at 31: `t` is not a mutable place //~ error at 30: expected *mut Tlk, got *Tlk
}
fn main {} {}
