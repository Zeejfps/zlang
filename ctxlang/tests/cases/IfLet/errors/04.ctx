
struct Tlk { n: i32 }
struct World { tlk: ?Tlk, count: i32 }
fn bump { mut t: Tlk } { t.n = t.n + 1 }
fn find { n: i32 } -> ?i32 {
    if n > 0 { return n * 10 }
    return null
}
fn tick { mut w: World } {
    let n = if let t = w.tlk { t.n }  //~ error at 13: an `if` expression needs an `else` //~ error at 37: this branch must end in a value, or leave with `return`, `break`, `continue` or `@panic()`
}
fn main {} {}
