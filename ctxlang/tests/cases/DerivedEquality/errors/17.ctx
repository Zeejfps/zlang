struct Node { v: i32, next: ?*Node }
struct F { f: fn{} -> i32 }
struct V { x: f32, y: f32 }
extern union U { a: u32, b: f32 }
struct W { u: U }
struct P { x: i32 }
struct Q { ps: []*P }
union Sh { a, b{ p: *u8 } }
fn one {} -> i32 { return 1 }
fn fails {} -> ! { return }
fn index_of(T) { xs: []T, x: T } -> ?usize {
    for v at i in xs {
        if v == x { return i }
    }
    return null
}
fn has(T) { xs: []T, x: T } -> bool { return index_of{ xs, x } != null }
fn main { mut io: Io, mut mem: Mem } {
    let pages = mem::pages{ &mem, size = 65536 } ifnull { return }
    let mut heap = arena::new{ buf = pages }
    let n = Node{ v = 1, next = null }
    let ns: [1]Node = [n]
    let m = map::make(V, i32){ realloc = arena::alloc, &heap }  //~ error at 18: `map::make` uses `@hash` on its `K`, and V has no `@hash`: its `x` is an f32, a float, and a NaN equals nothing, itself included, so a key that holds one could never be found again: hash its bits, as `math::f64_to_bits` gives them
}
