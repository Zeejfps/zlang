
error boom{ n: i32 }
#start
fn begin { mut io: Io, main: &fn{ args: Args } -> i32 } -> i32 {
    let code = main{ args = slice::empty([]u8){} }
    io::flush{ &io }
    return code + 40
}
fn main { mut io: Io } -> ! {
    io::println{ &io, s = "in main" }
    return boom{ n = 7 }
}

// A program with a start fn of its own writes through C's stdio, which ends a line with
// `\r\n` on Windows.
//# exit: 41
//# [windows] stdout escaped:
//| in main\r
//# [posix] stdout:
//| in main
//# [windows] stderr escaped:
//| error: boom{ n = 7 }\r
//# [posix] stderr:
//| error: boom{ n = 7 }
