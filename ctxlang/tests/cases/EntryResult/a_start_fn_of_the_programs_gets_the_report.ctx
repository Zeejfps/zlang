
error boom{ n: i32 }
#start
fn begin { mut io: Io, main: &fn{ args: Args } -> i32 } -> i32 {
    let code = main{ args = slice::empty([]u8){} }
    io::flush{ &io }
    return code + 40
}
fn main { mut io: Io } -> ! {
    io::println{ &io, s = "in main" }
    return boom{ n = 7 }
}

//# exit: 41
//# stdout escaped:
