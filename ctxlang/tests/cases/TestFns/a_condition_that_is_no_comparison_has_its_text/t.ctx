
fn small { n: i32 } -> bool { return n < 3 }
#test
fn conditions { mut t: Test } {
    @expect(&t, small{ n = 5 })
    @expect(&t, small{ n = 1 } and small{ n = 9 })
    @expect(&t, not small{ n = 1 })
    let o: ?i32 = null
    @expect(&t, o is some)
    @expect(&t, small{ n = 7 }
                or small{   n = 8 })
    @expect(&t, (1 + 1 == 3) == true)
}
