fn at { xs: []i32, i: usize } -> i32 { return xs[i] }
const XS: [2]i32 = [1, 2]

// A fn that skips for a test, with the test's Test.
fn needs_rows { mut t: Test, n: usize } {
    if n == 0 { test::skip{ &t, why = "no rows" } }
}

#test
fn passes { mut t: Test } { @expect(&t, XS.len == 2) }
#test{ skip = "the parser is being rewritten" }
fn is_not_run { mut t: Test, mut io: Io } {
    io::println{ &io, s = "written by a test that isn't run" }
    @expect(&t, XS.len == 3)
}
#test
fn ends_at_its_skip { mut t: Test, mut io: Io } {
    defer io::println{ &io, s = "a defer, which doesn't run" }
    io::println{ &io, s = "written before, and dropped" }
    @expect(&t, XS.len == 2)
    test::skip{ &t, why = "no game install" }
    @expect(&t, XS.len == 3)
}
#test
fn skips_without_a_check { mut t: Test } { test::skip{ &t, why = "nothing to check here" } }
#test
fn fails_and_then_skips { mut t: Test } {
    @expect(&t, XS.len == 3)
    test::skip{ &t, why = "a failed test stays failed" }
    @expect(&t, XS.len == 4)
}
#test
fn in_a_fn_the_test_calls { mut t: Test } {
    needs_rows{ &t, n = 1 }
    needs_rows{ &t, n = 0 }
    @expect(&t, false)
}
#test{ skip = "it would not panic", panics = "out of bounds" }
fn must_panic_and_is_not_run {} {}
#test{ panics = "out of bounds" }
fn must_panic_and_skips { mut t: Test } {
    test::skip{ &t, why = "before its panic" }
    _ = at{ xs = XS[..], i = 2 }
}
#test
fn leaves_with_the_code_of_a_skip { mut t: Test, mut proc: Proc } {
    @expect(&t, XS.len == 2)
    os::exit{ &proc, code = 77 }
}
