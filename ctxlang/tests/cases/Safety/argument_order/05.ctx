struct S { n: i32, m: i32 }
fn bump { mut s: S } -> i32 {
    s.n = s.n + 1
    return s.n
}
fn show { n: i32, z: i32 } { let t = n + z }
fn inc { mut x: i32 } { x = x + 1 }
fn call_it { f: &fn{} } -> i32 {
    f{}
    return 0
}
fn f {} {
    let mut x = 0
    show{ n = x, z = call_it{ f = inc{ &x, _ } } }  //~ error at 18: `n` reads `x`, which `z` changes, in one call: the order of the fields would decide what it reads; compute one of them in a `let` before the call
}
fn main {} {}
