struct S { n: i32, m: i32 }
fn bump { mut s: S } -> i32 {
    s.n = s.n + 1
    return s.n
}
fn show { n: i32, z: i32 } { let t = n + z }
union U { a{ x: i32 }, b }
struct W { u: U, k: i32 }
fn peek { mut w: W } -> i32 {
    match &w.u {
        a{ x } => { return x }
        b => { return 0 }
    }
}
fn set_b { mut w: W } -> i32 {
    w.u = U::b
    return 1
}
