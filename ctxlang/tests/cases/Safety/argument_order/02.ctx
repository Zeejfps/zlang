struct S { n: i32, m: i32 }
fn bump { mut s: S } -> i32 {
    s.n = s.n + 1
    return s.n
}
fn show { n: i32, z: i32 } { let t = n + z }
fn get_n { s: S } -> i32 { return s.n }
fn twice { mut s: S } -> i32 { return bump{ &s } + bump{ &s } }
