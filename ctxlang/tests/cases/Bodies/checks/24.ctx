fn total { s: []i32 } -> i32 {
    let mut t = 0
    let mut i: usize = 0
    while i < s.len {
        t = t + s[i]
        i = i + 1
    }
    return t
}
fn main {} {
    let a: [4]i32 = [1, 2, 3, 4]
    let s = a[1..3]
    let p = &a
    _ = total{ s = s[..1] }
    _ = total{ s = p[2..] }
    _ = total{ s = a[..] }
}

//# exit: 0
