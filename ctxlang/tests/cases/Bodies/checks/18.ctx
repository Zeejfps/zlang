fn f {} -> i32 {
    let mut n = 0
    let mut i = 0
    outer: while i < 5 {
        i = i + 1
        let mut j = 0
        while j < 5 {
            j = j + 1
            if j == 2 { continue outer }
            if i == 4 { break outer }
            n = n + 1
        }
    }
    return n
}
fn main {} {
    _ = f{}
}

