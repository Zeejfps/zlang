struct D { y: u32 }
fn w_d { mut b: utf8::Builder(arena::Arena), d: D } -> ! {
    return @fmt(&b, "{}", utf8::push_uint{ n = d.y, width = 4, zero = true, _ })
}
fn main {} {
    let mut mem: [256]u8
