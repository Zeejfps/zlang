    let d = D{ y = 7 }
    let name: utf8::String = "ab"
    _ = @fmt(&b, "[{}] {} {} {} {} {} {} {{}}", utf8::push_int{ n = 42, width = 5, zero = false, _ }, utf8::write_hex{ n = 255, _ }, utf8::push_hex{ n = 48879, width = 8, zero = true, _ }, utf8::write_char{ c = 65, _ }, utf8::push_padded{ s = name, width = 6, zero = false, _ }, true, w_d{ d, _ })
}

