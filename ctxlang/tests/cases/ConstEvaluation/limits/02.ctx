// Too deep a recursion in a const: how deep it got depends on the machine's stack (`N nested
// calls`, or `the N MiB stack is full`), so that part of the message is `{any}`.

fn down { n: u64 } -> u64 { return down{ n = n + 1 } + 1 }
const A: u64 = down{ n = 0 }  //~ error at 20: const `A` recursed too deeply while compiling: {any}, at down
fn main {} {}
