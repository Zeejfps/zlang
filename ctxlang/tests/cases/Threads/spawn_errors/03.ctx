fn take { mut threads: Threads, mut h: thread::Handle(u64) } -> u64 {
    return thread::join{ &threads, handle = &h }
}

fn main { mut threads: Threads } {
    let mut h: thread::Handle(u64)
    _ = take{ &threads, &h }
}

