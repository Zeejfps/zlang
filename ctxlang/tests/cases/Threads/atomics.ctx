
enum State: u8 { idle, busy, done }

fn main { mut io: Io, mut mem: Mem } {
    let mut n: u32 = 5
    _ = @atomic_add_relaxed(&n, 3)
    let before = @atomic_subtract_acquire_release(&n, 1)
    io::println_u64{ &io, n = @as(u64, before) }
    @atomic_store_release(&n, 40)
    io::println_u64{ &io, n = @as(u64, @atomic_load_acquire(&n)) }
    let old = @atomic_exchange(&n, 41)
    io::println_u64{ &io, n = @as(u64, old) }
    match @atomic_compare_exchange_acquire_release(&n, 41, 42) {
        null => { io::println{ &io, s = "stored" } }
        some{ value } => { io::println_u64{ &io, n = @as(u64, value) } }
    }
    match @atomic_compare_exchange_relaxed(&n, 41, 43) {
        null => { io::println{ &io, s = "stored" } }
        some{ value } => { io::println_u64{ &io, n = @as(u64, value) } }
    }
    let mut i: i8 = -100
    _ = @atomic_subtract_relaxed(&i, 100)
    io::println_i64{ &io, n = @as(i64, i) }
    let mut flag = false
    io::println_bool{ &io, n = @atomic_exchange(&flag, true) }
    io::println_bool{ &io, n = @atomic_load_relaxed(&flag) }
    let mut s = State::idle
    _ = @atomic_compare_exchange(&s, State::idle, State::done)
    io::println_u64{ &io, n = @as(u64, @as(u8, s)) }
    // pointers to memory that isn't a local's, which an atomic may store (§14, Escape check)
    let words = mem::pages{ &mem, size = 16 } ifnull { return }
    let x = @cast(*mut u64, words.ptr)
    let y = x + 1
    x.* = 1
    y.* = 2
    let mut p: *mut u64 = x
    let q: *mut u64 = @atomic_exchange_acquire_release(&p, y)
    io::println_u64{ &io, n = q.* + @atomic_load_acquire(&p).* }
    let mut np: ?*mut u64 = null
    io::println_bool{ &io, n = @atomic_compare_exchange(&np, null, x) == null }
    @fence()
}

//# stdout:
//| 8
//| 40
//| 40
//| stored
//| 42
//| 56
//| false
//| true
//| 2
//| 3
//| true
