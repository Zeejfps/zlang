// Borrowing contracts (spec §14, Escape check, rules 5 and 6): what `from` and `into` may name,
// and a written contract is held to exactly.

struct Box { name: []u8 }
fn first { xs: []u32 } -> *u32 from xs { return &xs[0] }
fn keep { mut b: Box, name: []u8 into b } { b.name = name }
fn mut_from { mut b: Box } -> []u8 from b { return b.name }  //~ error at 41: `from b`: `b` is a `mut` field, whose argument is a place of the caller's; `from` names the read-only fields whose arguments the result may point into, or a fn's `mut` loan holder field whose tasks' results it returns
fn mut_into { mut b: Box into c, mut c: Box } {}  //~ error at 31: `b into c`: `b` is a `mut` field, a place of the caller's, which the function can't keep; `into` follows a read-only field whose argument it keeps
fn unknown { xs: []u8 } -> []u8 from ys { return xs }  //~ error at 38: `from ys`: the function has no field `ys`
fn itself { p: *mut []u8 into p } {}  //~ error at 31: `p into p`: a field isn't kept in itself
fn nowhere { s: []u8 into t, t: []u8 } {}  //~ error at 27: `into t`: `t` is read-only, of type []u8, which reaches no `*mut` or `[]mut` that can hold a pointer, so nothing can be kept in it
fn says_less { xs: []u32 } -> *u32 { return &xs[0] }
fn says_more { xs: []u32, ys: []u32 } -> *u32 from xs and ys { return &xs[0] }  //~ error at 4: `says_more`: by its body its result may point into `xs`, and its contract says `from xs and ys`: a contract says exactly what the body keeps, so that callers can go by it; write `from xs`
fn says_less_written { xs: []u32, ys: []u32 } -> *u32 from ys { return &xs[0] }  //~ error at 4: `says_less_written`: by its body its result may point into `xs`, and its contract says `from ys`: a contract says exactly what the body keeps, so that callers can go by it; write `from xs`
fn main {} {}
