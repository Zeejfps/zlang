// A ctxlang HTTP server for tests/helpers/http_peer.py: two listeners, each with its accept
// loop in a task and a task per connection, the second with a short head deadline and two
// requests a connection. Each connection's task notes how it ended, and /ending/PORT says it
// for the connection from that client port. The program starts the peer with both ports,
// prints what it printed once it has ended, and stops the servers.

error failed_here

const SHORT_HEAD_NS: u64 = 500000000

fn is_path { target: []u8, path: []u8 } -> bool {
    return slice::eq_bytes{ a = target, b = path }
}

// Answers by the request's path.
fn answer { mut net: Net, exchange: http::Exchange } -> ! {
    let target = exchange.request.target
    if is_path{ target, path = "/hello" } {
        return http::respond{ &net, exchange, status = 200, headers = [], body = "hello\n" }
    }
    // /echo3 reads the body 3 bytes at a time, so a chunk is given in parts.
    let small = is_path{ target, path = "/echo3" }
    if small or is_path{ target, path = "/echo" } {
        let mut body: [65536]u8
        let mut n: usize = 0
        while true {
            let end = if small { @min(n + 3, body.len) } else { body.len }
            let got = try http::read_body{ &net, conn = exchange.conn, into = body[n..end] }
            if got == 0 { break }
            n = n + got
        }
        // The request's slices still point at its head, whatever reading the body moved.
        if not (is_path{ target = exchange.request.target, path = "/echo" } or is_path{ target = exchange.request.target, path = "/echo3" }) {
            return http::respond{ &net, exchange, status = 500, headers = [], body = "the head moved\n" }
        }
        return http::respond{ &net, exchange, status = 200, headers = [], body = body[..n] }
    }
    if is_path{ target, path = "/stream" } {
        try http::send_response{ &net, conn = exchange.conn, status = 200, headers = [], body = http::Body::chunked, close = false }
        try http::write_body{ &net, conn = exchange.conn, bytes = "one," }
        try http::write_body{ &net, conn = exchange.conn, bytes = "two," }
        try http::write_body{ &net, conn = exchange.conn, bytes = "three" }
        return http::finish_body{ &net, conn = exchange.conn }
    }
    // /sized writes its body only for GET: a response to HEAD is finished without it.
    if is_path{ target, path = "/sized" } {
        try http::send_response{ &net, conn = exchange.conn, status = 200, headers = [], body = http::Body::length{ n = 6 }, close = false }
        if slice::eq_bytes{ a = exchange.request.method, b = "GET" } { try http::write_body{ &net, conn = exchange.conn, bytes = "sized\n" } }
        return http::finish_body{ &net, conn = exchange.conn }
    }
    if is_path{ target, path = "/close" } {
        return http::send_response{ &net, conn = exchange.conn, status = 200, headers = [], body = http::Body::bytes{ bytes = "bye\n" }, close = true }
    }
    if is_path{ target, path = "/nothing" } { return }
    if is_path{ target, path = "/fail" } { return failed_here }
    return http::respond{ &net, exchange, status = 404, headers = [], body = "not found\n" }
}

// How each connection ended, by the client's port, for /ending/PORT: what serve_connection
// returned, its Ending or its error.
struct Ending { port: u16, len: usize, text: [120]u8 }
struct Endings { lock: mutex::Mutex, count: usize, all: [256]Ending }

// Notes how the connection from `port` ended. Past the 256 it holds, it notes nothing.
fn note_ending { endings: *mut Endings, port: u16, text: []u8 } {
    mutex::lock{ mutex = &endings.lock }
    if endings.count < endings.all.len {
        let n = @min(text.len, 120)
        let e = &endings.all[endings.count]
        e.port = port
        e.len = n
        slice::copy(u8){ dst = e.text[..n], src = text[..n] }
        endings.count = endings.count + 1
    }
    mutex::unlock{ mutex = &endings.lock }
}

// How the connection from `port` ended, into `into`: its length, or null if it hasn't ended.
// The latest of that port's, should the system have given it twice.
fn find_ending { endings: *mut Endings, port: u16, into: []mut u8 } -> ?usize {
    mutex::lock{ mutex = &endings.lock }
    defer mutex::unlock{ mutex = &endings.lock }
    let mut i = endings.count
    while i > 0 {
        i = i - 1
        let e = &endings.all[i]
        if e.port == port {
            slice::copy(u8){ dst = into[..e.len], src = e.text[..e.len] }
            return e.len
        }
    }
    return null
}

// /ending/PORT: how the connection from PORT ended, once it has, waiting up to 10 seconds.
fn answer_ending { mut threads: Threads, endings: *mut Endings, mut net: Net, exchange: http::Exchange } -> ! {
    let target = exchange.request.target
    let port = utf8::parse_u64{ s = utf8::of{ chars = target[8..] } } ifnull {
        return http::respond{ &net, exchange, status = 400, headers = [], body = "no port\n" }
    }
    let mut text: [120]u8
    for _ in 0..1000 {
        if let n = find_ending{ endings, port = @as(u16, port), into = text[..] } {
            return http::respond{ &net, exchange, status = 200, headers = [], body = text[..n] }
        }
        thread::sleep{ &threads, nanoseconds = 10000000 }
    }
    return http::respond{ &net, exchange, status = 200, headers = [], body = "not ended" }
}

fn answer_any { mut threads: Threads, endings: *mut Endings, mut net: Net, exchange: http::Exchange } -> ! {
    let target = exchange.request.target
    if target.len > 8 and slice::eq_bytes{ a = target[..8], b = "/ending/" } {
        return answer_ending{ &threads, endings, &net, exchange }
    }
    return answer{ &net, exchange }
}

// A connection's task. It notes how the connection ended, an Ending or an error; its error (a
// reset, a head that stalled, the handler's failed_here) fails it alone: the group keeps it,
// unread, since the peer asks how each connection ended, and drops it when the server is
// cancelled.
fn connection { mut net: Net, mut threads: Threads, socket: net::Socket, limits: http::Limits, endings: *mut Endings } -> ! {
    defer net::close{ &net, socket }
    let port = (net::peer_address{ &net, socket } iferr { net::Address{ ip = net::ANY_V4, port = 0 } }).port
    let mut buffer: [16384]u8
    let mut fields: [100]http::Header
    let mut headers = fields[..]
    let mut conn = http::open{ stream = http::Stream::plain{ socket }, buffer = buffer[..] }
    let mut said: [256]u8
    let mut heap = arena::new{ buf = said[..] }
    let mut b = utf8::builder(arena::Arena){ realloc = arena::alloc, &heap }
    let ending = http::serve_connection{ &net, &conn, &headers, limits, handle = answer_any{ &threads, endings, _ } } iferr err{ error } {
        _ = @fmt(&b, "failed: {}", error)
        note_ending{ endings, port, text = utf8::view{ b }.bytes }
        return error
    }
    match ending {
        peer_finished => { _ = @fmt(&b, "peer_finished") }
        idle => { _ = @fmt(&b, "idle") }
        closed => { _ = @fmt(&b, "closed") }
        refused{ status, why } => { _ = @fmt(&b, "refused {}: {}", status, why) }
    }
    note_ending{ endings, port, text = utf8::view{ b }.bytes }
}

fn serve { mut net: Net, mut threads: Threads, listener: net::Listener, limits: http::Limits, endings: *mut Endings } -> ! {
    let mut connections = task::Group{ failures = task::Failures::keep, .. }
    while true {
        let socket = try net::accept{ &net, listener }
        task::start_concurrent_in{ &threads, group = &connections, run = connection{ &net, &threads, socket, limits, endings, _ } } iferr {
            net::close{ &net, socket }
        }
    }
}

fn main { mut io: Io, mut net: Net, mut proc: Proc, mut threads: Threads, args: Args } -> i32 {
    let listener = net::listen{ &net, address = "127.0.0.1:0", backlog = 0 } iferr { return 1 }
    defer net::close_listener{ &net, listener }
    let short = net::listen{ &net, address = "127.0.0.1:0", backlog = 0 } iferr { return 1 }
    defer net::close_listener{ &net, listener = short }
    let at = net::listener_address{ &net, listener } iferr { return 1 }
    let short_at = net::listener_address{ &net, listener = short } iferr { return 1 }

    let mut endings: Endings
    endings.lock = mutex::make{}
    let mut plain: task::Task(!)
    task::start_concurrent{ &threads, task = &plain, run = serve{ &net, &threads, listener, limits = http::Limits{ .. }, endings = &endings, _ } } iferr { return 2 }
    let mut limited: task::Task(!)
    task::start_concurrent{ &threads, task = &limited, run = serve{ &net, &threads, listener = short, limits = http::Limits{ head_ns = SHORT_HEAD_NS, requests = 2 }, endings = &endings, _ } } iferr { return 2 }

    let mut text: [20]u8
    let port = utf8::fmt_u64{ n = at.port, into = text[..] }
    let mut short_text: [20]u8
    let short_port = utf8::fmt_u64{ n = short_at.port, into = short_text[..] }
    let options = proc::Options{ stdout = proc::Stdio::pipe, .. }
    let mut child = proc::spawn{ &proc, argv = ["python", args[0], port.bytes, short_port.bytes], options } iferr { return 3 }
    let out = child.stdout ifnull { return 3 }
    let mut said: [8192]u8
    let mut n: usize = 0
    while n < said.len {
        let got = proc::read{ &proc, pipe = out, into = said[n..] } iferr { return 4 }
        if got == 0 { break }
        n = n + got
    }
    let code = proc::wait{ &proc, &child } iferr { -1 }
    _ = task::cancel{ &threads, task = &plain }
    _ = task::cancel{ &threads, task = &limited }
    _ = @fmt(&io, "{}", said[..n])
    _ = @fmt(&io, "python ended: {}\n", code)
    return 0
}
