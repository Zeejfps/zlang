//| GET 11 100 "Continue", 25 of 25 bytes: none
//| GET 11 101 "Switching Protocols", 56 of 56 bytes: none
//| GET 11 199 "Odd", 39 of 39 bytes: none
//| GET 11 204 "No Content", 46 of 46 bytes: none
//| GET 11 304 "Not Modified", 48 of 48 bytes: none
//| GET 11 205 "Reset Content", 49 of 49 bytes: length 0
//| POST 11 404 "Not Found", 26 of 26 bytes: until close
//| CONNECT 11 200 "Connection established", 39 of 39 bytes: none
//| CONNECT 11 407 "Proxy Authentication Required", 65 of 65 bytes: length 0
