// send_response panics for a body on a 204, which has none (RFC 9110 §15.3.5).

fn main { mut net: Net } {
    let mut buf: [64]u8
    let mut conn = http::open{ stream = http::Stream::plain{ socket = net::Socket{ id = 0 } }, buffer = buf[..] }
    _ = http::send_response{ &net, &conn, status = 204, headers = [], body = http::Body::bytes{ bytes = "x" }, close = false }
}

//# panic: std/http.ctx:657:46: panic: http::send_response: a 1xx, 204 or 304 response has no body
//# path:
//|   at http::send_response (std/http.ctx:657:46)
//|   at main (bodiless.ctx:6:28)
