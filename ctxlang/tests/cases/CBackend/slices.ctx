
fn sum { xs: []i32 } -> i32 {
    let mut t = 0
    let mut i: usize = 0
    while i < xs.len { t = t + xs[i]; i = i + 1 }
    return t
}
fn bump { xs: []mut i32 } {
    let mut i: usize = 0
    while i < xs.len { xs[i] = xs[i] + 1; i = i + 1 }
}
fn main { mut io: Io, args: Args } -> i32 {
    let mut a = [1, 2, 3, 4]
    bump{ xs = a[1..3] }
    io::println_i64{ &io, n = sum{ xs = &a } }
    let s = @slice(&a[0], 2)
    io::println_i64{ &io, n = (s.ptr + 1).* + s[..1][0] }
    let mut e: []i32
    io::println_u64{ &io, n = e.len + args.len + args[0].len }
    return a[2]
}

