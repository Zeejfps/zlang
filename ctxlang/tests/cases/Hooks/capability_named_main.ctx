// A capability may be any of a start fn's fields, `main` among them.

#start
fn boot { mut main: Io, other: Io } -> i32 {
    io::println_u64{ io = &main, n = 5 }
    io::flush{ io = &main }
    return 3
}
fn main {} {}

//# exit: 3
// A program with a start fn of its own writes through C's stdio, which ends a line with
// `\r\n` on Windows.
//# [windows] stdout escaped:
//| 5\r
//# [posix] stdout:
//| 5
