// `ctxc build --place` takes.
//# project
//# $ {game}
//# stdout:
//| 3 41
//# $ ctxc test {dir}
//# stdout:
//| tests: 1 run, 1 passed, 0 failed, 0 skipped, 0 not selected, 2 checks
