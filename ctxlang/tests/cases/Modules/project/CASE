//| {dir}/lib/gff/api.ctx:5:32: fixed: write the errors its definition fails with
//| -     fn read { bytes: []u8 } -> !Gff
//| +     fn read { bytes: []u8 } -> error(bad_magic, truncated)!Gff
//| check: no errors
//# file lib/gff/api.ctx:
//| namespace gff {
//|     type Gff
//|     error bad_magic
