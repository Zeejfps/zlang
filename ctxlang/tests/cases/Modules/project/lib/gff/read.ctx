namespace gff {
    struct Gff { size: usize }
    fn read { bytes: []u8 } -> !Gff {
        try check{ bytes }
        return Gff{ size = bytes.len }
    }
    fn size { g: Gff } -> usize { return g.size }
    fn check { bytes: []u8 } -> ! {
        if bytes.len < 2 { return truncated{ at = bytes.len } }
        if bytes[0] != 'G' { return bad_magic }
    }
}
