
error bad
fn f { n: i32 } -> !?i32 {
    if n == 0 { return null }
    if n < 0 { return bad }
    return n
}
fn g { n: i32 } -> ?i32 { if n == 0 { return null }; return n }
fn r { n: i32 } -> !i32 { if n == 0 { return bad }; return n }
fn h { n: i32 } -> ?!i32 {
    if n == 0 { return null }
    let x: !i32 = if n < 0 { bad } else { n }
    return x
}
fn t { n: i32 } -> ?bool { if n == 0 { return null }; return n > 0 }
fn main { mut io: Io } {
    let n = 1
    let x = n == g{ n } ifnull { return }  //~ error at 25: `ifnull` beside `==` needs parentheses: write `n == (g{ n } ifnull { return })` or `(n == g{ n }) ifnull { return }`
}
