// A value whose inferred type holds a `&fn` is an error, as the written type is.

fn read { n: i32 } -> i32 { return n }
fn f {} {
    let g = read{ n = 1, _ }
    let mut a = [g]  //~ error at 17: `&fn` can only be the type of a local or a read-only context field
    a[0] = read{ n = 2, _ }  //~ error at 5: `&fn` can only be the type of a local or a read-only context field
}
fn main {} {}
