// Using std's growable list (std/list.ctx), generic over the element type T and the
// allocator state S, with an arena allocator (std/arena.ctx) over a stack buffer.

union Event {
    push{ value: i32 },
    pop,
    clear,
}

// Applies one event to the list. Fails with alloc::out_of_memory: `try` passes push's error up.
fn apply(S) { mut nums: list::List(i32, S), ev: Event } -> ! {
    match ev {
        push{ value } => { try list::push{ list = &nums, item = value, .. } }
        pop           => { _ = list::pop{ list = &nums } }
        clear         => { list::clear{ list = &nums } }
    }
}

// Mutates payloads in place by matching through a pointer.
fn scale_pushes(S) { mut events: list::List(Event, S), by: i32 } {
    let mut i = 0
    while i < events.len {
        match list::at{ list = events, i } {          // *Event
            push{ &value } => { value = value * by }
            else           => { }
        }
        i = i + 1
    }
}

fn print_item { mut io: Io, item: i32 } {
    io::println_i64{ &io, n = item }
}

fn add_to { mut total: i32, item: i32 } {
    total = total + item
}

fn move_first(S) { mut from: list::List(i32, S), mut to: list::List(i32, S), mut heap: S } { to = from }

fn main { mut io: Io } {
    let mut mem: [4096]u8
    let mut heap = arena::Arena{ buf = @slice(&mem[0], mem.len), used = 0, handed = 0 }
    let mut nums = list::new(i32){ realloc = arena::alloc, &heap }
    let mut total = 0
    move_first{ from = &nums, to = &nums, .. }  //~ error at 15: two mut references to `nums` in one call: `move_first` reads `nums` through its field `from` at 39:99, and changes `nums` through its field `to` at 39:94; pass one of them, or change `move_first` to use `nums` through one of them only
}
