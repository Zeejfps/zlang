
namespace game {
    #pure
    extern fn labs { n: i64 } -> i64
    extern union Bits { f: f32, u: u32 }
    capability Lib { extern ctxtest_count: i32 }
    #c_callback
    fn on_key { key: i32 } {}
    fn sum { s: []u8 } -> u64 {
        let p = s.ptr
        let q = @cast(*u32, p)
        let v = @slice(p, 2)
        let cs: cstr = "x"
        let first = cs.*
        let wide: *u8 = cs
        let made = @cast(cstr, p)
        return (p + 1).* + v.len
    }
    #c_export{ name = "game_tick" }
    fn tick {} {}
}
