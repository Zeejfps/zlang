// A loan holder of the program's own (spec §15, Tasks, rules 4, 6 and 7): it lends a task into a
// struct that holds a Task, ends it with its own fns, and its scope end is one of them.
#loan_holder
struct Job { t: task::Task(u64) }

#task
fn count { mut n: u64 } -> u64 {
    n = n + 1
    return n
}

// Lends its task into the job: the job holds what the task borrows.
fn submit { mut threads: Threads, mut job: Job, run: &fn{} -> u64 into job } {
    task::start{ &threads, task = &job.t, run }
}

#scope_end
fn finish { mut threads: Threads, mut job: Job ends } { task::end{ &threads, task = &job.t } }

fn collect { mut threads: Threads, mut job: Job ends } -> u64 { return task::wait{ &threads, task = &job.t } }

fn main { mut io: Io, mut threads: Threads } {
    let mut n: u64 = 41
    let mut job: Job
    submit{ &threads, &job, run = count{ &n, _ } }
    io::println_u64{ &io, n = collect{ &threads, &job } }
    io::println_u64{ &io, n }
}
//# stdout:
//| 42
//| 42
