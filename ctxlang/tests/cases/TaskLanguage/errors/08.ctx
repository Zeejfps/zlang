
fn fill { mut buf: [8]u8, n: u8 } -> ! { buf[0] = n }

fn look { s: []u8 } -> !u64 { return @as(u64, s.len) }

fn sq { n: u64 } -> !u64 { return n * n }

fn ret {} -> task::Task(!) { let mut t: task::Task(!)  //~ error at 4: fn `ret` returns a task handle: a task's handle is only a local, a local array's element, or a `mut` field, and is never copied
    return t }
fn main {} {}
