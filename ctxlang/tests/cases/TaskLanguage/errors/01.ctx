#thread_bound
capability Video
capability Win { ..Video }
fn draw { mut w: Win } -> ! {}
fn main { mut threads: Threads, mut w: Win } {
    let mut t: task::Task(!)
    task::start{ &threads, task = &t, run = draw{ &w, _ } }  //~ error at 49: this bind may run on another thread, a `&thread fn`, and its `w` is `Win`, a thread-bound capability
}
