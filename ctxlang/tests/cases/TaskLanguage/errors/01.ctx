
#task
fn fill { mut buf: [8]u8, n: u8 } -> ! { buf[0] = n }

#task
fn look { s: []u8 } -> !u64 { return @as(u64, s.len) }

#task
fn sq { n: u64 } -> !u64 { return n * n }

#thread_bound
capability Video
capability Win { ..Video }
#task
fn draw { mut w: Win } -> ! {}  //~ error at 4: task fn `draw` takes `w`, a thread-bound capability (`Win`): a task may run on another thread
fn main {} {}
