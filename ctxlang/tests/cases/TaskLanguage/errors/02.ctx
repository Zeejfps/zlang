
#task
fn fill { mut buf: [8]u8, n: u8 } -> ! { buf[0] = n }

#task
fn look { s: []u8 } -> !u64 { return @as(u64, s.len) }

#task
fn sq { n: u64 } -> !u64 { return n * n }

#task
fn b { mut b: Build } -> ! {}  //~ error at 4: task fn `b` takes `b`, a thread-bound capability (`Build`): a task may run on another thread
