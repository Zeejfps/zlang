#thread_bound
capability Video
capability Win { ..Video }
fn peek { w: *Win } -> ! {}
fn main { mut threads: Threads, mut w: Win } {
    let mut t: task::Task(!)
    task::start{ &threads, task = &t, run = peek{ w = &w, _ } }  //~ error at 49: this bind may run on another thread, a `&thread fn`, and its `w`, a *Win, reaches `Win`, a thread-bound capability
}
