
#task
fn fill { mut buf: [8]u8, n: u8 } -> ! { buf[0] = n }

#task
fn look { s: []u8 } -> !u64 { return @as(u64, s.len) }

#task
fn sq { n: u64 } -> !u64 { return n * n }

fn main {} { let mut p: ?task::Task(!) = null }  //~ error at 14: ?task::Task(!) holds a task handle, which is never copied: declare it without a value, and start a task into it
