
fn fill { mut buf: [8]u8, n: u8 } -> ! { buf[0] = n }

fn look { s: []u8 } -> !u64 { return @as(u64, s.len) }

fn sq { n: u64 } -> !u64 { return n * n }

fn main { mut threads: Threads } {
    let f = sq{ n = 1, _ }
    let mut t: task::Task(!u64)
    task::start{ &threads, task = &t, run = f }  //~ error at 45: expected &thread fn{} -> !u64, got &fn{} -> !u64: only a bind written where a `&thread fn` is expected becomes one, since what a `&fn` value holds can't be seen here
}
