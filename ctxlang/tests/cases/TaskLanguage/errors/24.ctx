#thread_bound
capability Video
capability Win { ..Video }
fn keep(T) { x: T } -> ! {}
fn main { mut threads: Threads, mut w: Win } {
    let mut t: task::Task(!)
    task::start{ &threads, task = &t, run = keep{ x = &w, _ } }  //~ error at 49: this bind may run on another thread, a `&thread fn`, and its `x`, a *mut Win, reaches `Win`, a thread-bound capability
}
