// A handle's literal (spec §15, Tasks, rule 4): only a `let mut`'s value, ending in `..`,
// giving only settings.
namespace jobs {
    #loan_holder
    struct Job {
        #setting
        bonus: u64,
        t: task::Task(u64),
    }

    #scope_end
    fn finish { mut threads: Threads, mut job: Job ends } { task::end{ &threads, task = &job.t } }
}

fn pick { yes: bool } {
    let mut a = jobs::Job{ bonus = 1 }  //~ error at 26: struct `Job`'s literal ends in `..`, which leaves the fields it doesn't give zero
    let mut b = jobs::Job{ bonus = 1, t = 0, .. }  //~ error at 39: `t` isn't a setting of struct `Job`: a handle's literal gives only the fields with `#setting`, and the rest start zero //~ error at 43: expected task::Task(u64), got {integer}
    let c = jobs::Job{ .. }  //~ error at 5: `c` is a handle, declared with `let mut`: its tasks write into it
    let mut d = if yes { jobs::Job{ .. } } else { jobs::Job{ bonus = 2, .. } }  //~ error at 35: struct `Job` is a loan holder, whose literal is only the value of the `let mut` that declares a handle: it is built there and never moves //~ error at 60: struct `Job` is a loan holder, whose literal is only the value of the `let mut` that declares a handle: it is built there and never moves
    let mut e: [2]jobs::Job = [jobs::Job{ .. }, jobs::Job{ .. }]  //~ error at 41: struct `Job` is a loan holder, whose literal is only the value of the `let mut` that declares a handle: it is built there and never moves //~ error at 58: struct `Job` is a loan holder, whose literal is only the value of the `let mut` that declares a handle: it is built there and never moves
    let mut f = jobs::Job{ .. }
    f = jobs::Job{ .. }  //~ error at 18: struct `Job` is a loan holder, whose literal is only the value of the `let mut` that declares a handle: it is built there and never moves
    let mut g = f  //~ error at 5: jobs::Job holds a task handle, which is never copied: declare it without a value, or a handle with its literal, and start a task into it
    _ = jobs::Job{ .. }  //~ error at 18: struct `Job` is a loan holder, whose literal is only the value of the `let mut` that declares a handle: it is built there and never moves
}

fn main {} { pick{ yes = true } }
