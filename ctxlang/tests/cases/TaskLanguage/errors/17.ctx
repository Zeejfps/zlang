
fn fill { mut buf: [8]u8, n: u8 } -> ! { buf[0] = n }

fn look { s: []u8 } -> !u64 { return @as(u64, s.len) }

fn sq { n: u64 } -> !u64 { return n * n }

fn main { mut threads: Threads } {
    let mut buf: [8]u8
    let mut u: task::Task(!)
    let mut i = 0
    while i < 6 {
        buf[3] = 1  //~ error at 12: `buf[_]` is lent into `u` at 14:20, and held until `u` is ended
        task::start{ &threads, task = &u, run = fill{ &buf, n = 1, _ } }  //~ error at 56: `buf` is lent into `u` at 14:20, and held until `u` is ended
        i = i + 1
    }
}
