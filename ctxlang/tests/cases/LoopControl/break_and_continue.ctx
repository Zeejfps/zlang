
fn first_even { a: [5]i32 } -> ?usize {
    let mut i: usize = 0
    let mut found: ?usize = null
    while i < a.len {
        if a[i] % 2 == 0 { found = i; break }
        i = i + 1
    }
    return found
}
fn main { mut io: Io } {
    let r = first_even{ a = [1, 3, 8, 5, 6] }
    if r != null { io::println_u64{ &io, n = r } }
    let mut sum = 0
    let mut i = 0
    while i < 10 {
        i = i + 1
        if i % 2 == 1 { continue }
        sum = sum + i
    }
    io::println_i64{ &io, n = sum }
}

//# stdout:
//| 2
//| 30
