// §3, rule 10: a fn that changes an array through a `for &x` changes it; `for x` reads it.

struct S { a: [3]i32, n: i32 }
fn zero { mut s: S } -> i32 {
    for &x in s.a { x = 0 }
    return 0
}
fn sum { mut s: S } -> i32 {
    let mut t = 0
    for x in s.a { t = t + x }
    s.n = t
    return t
}
fn show { n: i32, z: i32 } -> i32 { return n + z }
fn main {} { let mut s = S{ a = [1, 2, 3], n = 1 }; _ = show{ n = s.a[0], z = zero{ &s } } }  //~ error at 75: `n` reads `s.a[_]`, and `z` changes `s.a`, in one call: the order of the fields would decide what it reads; compute one of them in a `let` before the call
