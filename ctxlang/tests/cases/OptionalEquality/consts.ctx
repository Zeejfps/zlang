
const A: ?i32 = 3
const N: ?i32 = null
const B: bool = A == 3
const C: bool = A != 4
const D: bool = N == 3
const E: bool = N == N
const F: bool = A == N
fn main { mut io: Io } {
    io::println_bool{ &io, n = B }
    io::println_bool{ &io, n = C }
    io::println_bool{ &io, n = D }
    io::println_bool{ &io, n = E }
    io::println_bool{ &io, n = F }
}

//# stdout:
//| true
//| true
//| false
//| true
//| false
