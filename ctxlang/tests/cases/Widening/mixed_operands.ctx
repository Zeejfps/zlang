
fn main { mut io: Io } {
    let a: u8 = 250
    let b: u32 = 10
    let s = a + b                   // u32: no u8 overflow
    io::println_u64{ &io, n = s }
    let i: i32 = -1
    let big: i64 = 5000000000
    io::println_i64{ &io, n = big + i }
    io::println_bool{ &io, n = a < b }
    let len: usize = 4
    let k: u8 = 3
    io::println_bool{ &io, n = k < len }
    let f: f32 = 1.5
    io::println_f64{ &io, n = f * 2.0 }
}

//# stdout:
//| 260
//| 4999999999
//| false
//| true
//| 3.0
