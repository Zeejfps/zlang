fn build { mut b: Build } {
    let exe = build::exe{ &b, name = "three", root = "src" }
    build::add_sources{ &b, exe, dir = "shared" }
    build::lib_path{ &b, exe, path = "lib" }
    let other = build::exe{ &b, name = "other", root = "other" }
    build::add_sources{ &b, exe = other, dir = "shared" }
}
