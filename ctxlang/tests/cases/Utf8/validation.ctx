
fn check { mut io: Io, bytes: []u8 } {
    match utf8::from{ bytes } {
        ok                  => { io::println_i64{ &io, n = -1 } }
        utf8::invalid{ at } => { io::println_u64{ &io, n = at } }
    }
}
fn main { mut io: Io } {
    let b0 = "\x80"
    check{ &io, bytes = b0[..] }
    let b1 = "a\xc0\xaf"
    check{ &io, bytes = b1[..] }
    let b2 = "\xe0\x80\xaf"
    check{ &io, bytes = b2[..] }
    let b3 = "\xed\xa0\x80"
    check{ &io, bytes = b3[..] }
    let b4 = "\xf4\x90\x80\x80"
    check{ &io, bytes = b4[..] }
    let b5 = "ab\xe2\x82"
    check{ &io, bytes = b5[..] }
    let b6 = "\xf5\x80\x80\x80"
    check{ &io, bytes = b6[..] }
    let b7 = "\xc3\x28"
    check{ &io, bytes = b7[..] }
    let b8 = "\xc2\x80"
    check{ &io, bytes = b8[..] }
    let b9 = "\xed\x9f\xbf"
    check{ &io, bytes = b9[..] }
    let b10 = "\xee\x80\x80"
    check{ &io, bytes = b10[..] }
    let b11 = "\xf0\x90\x80\x80"
    check{ &io, bytes = b11[..] }
    let b12 = "\xf4\x8f\xbf\xbf"
    check{ &io, bytes = b12[..] }
    let b13 = ""
    check{ &io, bytes = b13[..] }
}

//# stdout:
//| 0
//| 1
//| 0
//| 0
//| 0
//| 2
//| 0
//| 0
//| -1
//| -1
//| -1
//| -1
