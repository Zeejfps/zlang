fn w { mut b: utf8::Builder(arena::Arena) } -> ! {}

fn main { mut io: Io } {
    let mut mem: [4096]u8
    let mut heap = arena::new{ buf = mem[..] }
    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
let mut n: i32 = 1
    _ = @fmt(&n, "x")  //~ error at 14: @fmt has no writer to i32: no `#write` fn it sees has a sink of that type
    io::println{ &io, s = utf8::view{ b } }
}
