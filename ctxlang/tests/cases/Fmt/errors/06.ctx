fn w { mut b: utf8::Builder(arena::Arena) } -> ! {}

fn main { mut io: Io } {
    let mut mem: [4096]u8
    let mut heap = arena::new{ buf = mem[..] }
    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
_ = @fmt(&b, "{y}", 1)  //~ error at 14: bad hole `{y}` in the format: a hole is `{}`, or with a spec after a colon `{:>8}`, `{:08x}` or `{:.3}`, and a function writes a value another way, as `utf8::write_char{ c, _ }`
    io::println{ &io, s = utf8::view{ b } }
}
