// Using std's growable list (std/list.ctx), generic over the element type T and the
// allocator state S, with an arena allocator (std/arena.ctx) over a stack buffer.

union Event {
    push{ value: i32 },
    pop,
    clear,
}

// Applies one event to the list. Returns false on allocation failure.
fn apply(S) { mut nums: list::List(i32, S), mut heap: S, ev: Event } -> bool {
    match (ev) {
        push{ value } => { return list::push{ list = &nums, item = value, .. } }
        pop           => { list::pop{ list = &nums } }
        clear         => { list::clear{ list = &nums } }
    }
    return true
}

// Mutates payloads in place by matching through a pointer.
fn scale_pushes(S) { mut events: list::List(Event, S), by: i32 } {
    let mut i = 0
    while (i < events.len) {
        match (list::at{ list = events, i }) {          // *Event
            push{ &value } => { value = value * by }
            else           => { }
        }
        i = i + 1
    }
}

fn print_item { mut io: Io, item: i32 } {
    io::println_i32{ &io, n = item }
}

fn add_to { mut total: i32, item: i32 } {
    total = total + item
}

fn main { mut io: Io } {
    let mut mem: [4096]u8                                          // zeroed, on the stack
    let mut heap = arena::new{ buf = slice::of(u8){ a = &mem } }

    let mut events = list::new(Event){ realloc = arena::alloc }    // S = arena::Arena is inferred
    let mut i = 1
    while (i <= 5) {
        list::push{ list = &events, item = Event::push{ value = i }, .. }   // `..` supplies &heap
        i = i + 1
    }
    list::push{ list = &events, item = Event::pop, .. }
    scale_pushes{ &events, by = 10 }

    let mut nums = list::new(i32){ realloc = arena::alloc }
    let mut j = 0
    while (j < events.len) {
        let ev = slice::get{ s = events.items, i = j }
        if (not apply{ &nums, ev, .. }) { return }
        j = j + 1
    }

    // Binding io gives &fn{ item: i32 }, which matches each's slot. Passed down: OK.
    list::each{ list = nums, f = print_item{ &io, _ } }

    let mut total = 0
    list::each{ list = nums, f = add_to{ &total, _ } }
    io::println_i32{ &io, n = total }

    // Event has no zero value, so `last` must be assigned on every path before it is read.
    let last: Event
    if (total > 100) { last = Event::clear } else { last = Event::pop }
    apply{ &nums, ev = last, .. }

    let first = list::get{ list = nums, i = 0 }
    if (first != null) { io::println_i32{ &io, n = first } }        // first is i32 here

    list::free{ list = &nums, .. }
    list::free{ list = &events, .. }

    let h = &heap                  // raw *arena::Arena
    arena::reset{ heap = h }       // a mut field given a raw pointer: exclusivity not checked
}

// ---- Compile errors ----
//
// let mut m = malloc::Heap{}
// list::push{ list = &nums, heap = &m, item = 1 }
//     error: nums is List(i32, arena::Arena), heap is malloc::Heap
//
// list::each{ list = nums, f = print_item }
//     error: print_item needs `mut io`, which slot &fn{ item: i32 } doesn't provide
//
// struct Handler { f: fn{ item: i32 } }
// let h = Handler{ f = print_item{ &io, _ } }
//     error: expected fn{ item: i32 }, got &fn{ item: i32 }
//
// struct Handler2 { f: &fn{ item: i32 } }
//     error: &fn can't be a struct field type
//
// fn log_to { mut log: Io, mut heap: arena::Arena, mem: alloc::Bytes, new: usize, align: usize } -> ?alloc::Bytes { ... }
// list::new(i32){ realloc = log_to{ &io, _ } }
//     error: expected alloc::Fn(S), got &fn{ ... }
//
// match (ev) { push{ value } => { } }
//     error: match isn't exhaustive: missing pop, clear
//
// io::println_i32{ &io, n = list::get{ list = nums, i = 0 } }
//     error: expected i32, got ?i32
//
// fn move_first(S) { mut from: list::List(i32, S), mut to: list::List(i32, S), mut heap: S } { ... }
// move_first{ from = &nums, to = &nums, .. }
//     error: two mut references to nums in one call
//
// let mut ev = Event::push{ value = 1 }
// match (&ev) {
//     push{ &value } => { ev = Event::pop; value = 2 }
//     else           => { }
// }
//     error: ev overlaps the match scrutinee; access it only through `value`
//
// let ev: Event
// if (total > 100) { ev = Event::clear }
// apply{ &nums, ev, .. }
//     error: ev may be read before it is assigned
//
// fn sum_into { mut total: i32, f: &fn{ item: i32 } } { ... }
// let f = add_to{ &total, _ }
// sum_into{ &total, f }
//     error: total overlaps a place held by f
//
// fn make_arena {} -> arena::Arena {
//     let mut mem: [64]u8
//     return arena::Arena{ buf = slice::from{ ptr = &mem[0], len = mem.len }, used = 0 }
// }
//     error: returned value holds the address of local `mem`
//
// let mut maybe = list::get{ list = nums, i = 0 }
// if (maybe != null) { io::println_i32{ &io, n = maybe } }
//     error: maybe is mutable and can't be narrowed; copy it to a `let` first
//
// ---- Not caught ----
//
// let mut other = arena::Arena{ buf = slice::from{ ptr = &mem2[0], len = mem2.len }, used = 0 }
// list::push{ list = &nums, heap = &other, item = 1 }
//     compiles: same type S, wrong instance
//
// fn addr_of { mut s: slice::Slice(i32) } -> *slice::Slice(i32) { return &s }   // s is a mut field: fine
// fn bad {} -> *slice::Slice(i32) {
//     let mut local = slice::empty(i32){}
//     return addr_of{ &local }
// }
//     compiles: a pointer returned through a `mut` argument isn't tracked (§14)
//
// let p = &mem[0]
// p[5000] = 1
//     compiles: pointer indexing isn't bounds-checked
