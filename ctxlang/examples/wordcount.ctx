// Counts the words in a file:
//
//   python -m ctxi examples/wordcount.ctx notes.txt
//
// Uses command-line arguments and files (std/fs.ctx), main's exit code, a hash map
// (std/map.ctx), ascii::Cursor for scanning, Result, and defer.

struct Top { word: ascii::String, count: i64 }

fn main { mut io: Io, mut fs: Fs, args: Args } -> i32 {
    if (args.len != 1) {
        let usage = "usage: wordcount FILE"
        io::eprintln{ &io, s = ascii::of{ chars = &usage } }
        return 2
    }
    let path = slice::get{ s = args, i = 0 }

    let mut mem: [1048576]u8                                  // the heap: 1 MiB on the stack
    let mut heap = arena::new{ buf = slice::of(u8){ a = &mem } }

    // `match` gives the file's bytes, or leaves main with an exit code.
    let bytes = match (fs::read_all{ &fs, &heap, realloc = arena::alloc, path }) {
        ok{ value }  => { value }
        err{ error } => {
            report{ &io, path, error }
            return 1
        }
    }
    defer alloc::resize{ realloc = arena::alloc, &heap, mem = bytes, count = 0 }

    if (not lowercase{ bytes }) {
        let msg = "not an ASCII text file"
        io::eprintln{ &io, s = ascii::of{ chars = &msg } }
        return 1
    }
    let text = ascii::from{ bytes }

    // Keys are views into `bytes`, which outlives the map: defers run in reverse order.
    let mut counts = map::new(ascii::String, i64){
        realloc = arena::alloc, hash = map::hash_string, eq = ascii::eq,
    }
    defer map::free{ m = &counts, &heap }

    let mut words: u64 = 0
    let mut cur = ascii::cursor{ s = text }
    while (not ascii::done{ cur }) {
        ascii::take_while{ &cur, f = not_letter }
        let word = ascii::take_while{ &cur, f = ascii::is_alpha }
        if (ascii::len{ s = word } == 0) { continue }
        words = words + 1
        let seen = map::at{ m = counts, key = word }            // ?*i64
        if (seen != null) {
            seen.* = seen.* + 1
        } else if (not map::put{ m = &counts, &heap, key = word, value = 1 }) {
            let msg = "out of memory"
            io::eprintln{ &io, s = ascii::of{ chars = &msg } }
            return 1
        }
    }

    let lines = "lines: "
    io::print{ &io, s = ascii::of{ chars = &lines } }
    io::println_u64{ &io, n = count_lines{ text } }
    let w = "words: "
    io::print{ &io, s = ascii::of{ chars = &w } }
    io::println_u64{ &io, n = words }
    let d = "distinct: "
    io::print{ &io, s = ascii::of{ chars = &d } }
    io::println_u64{ &io, n = map::len{ m = counts } }

    let top = most_common{ counts }
    if (top != null) {
        let label = "most common: "
        io::print{ &io, s = ascii::of{ chars = &label } }
        io::print{ &io, s = top.word }
        io::put_char{ &io, c = ' ' }
        io::println_i64{ &io, n = top.count }
    }
    return 0
}

// Lowercases the text in place. False if it isn't all ASCII.
fn lowercase { bytes: alloc::Bytes } -> bool {
    let mut i: usize = 0
    while (i < bytes.len) {
        let c = slice::get{ s = bytes, i }
        if (c > 127) { return false }
        slice::set{ s = bytes, i, v = ascii::to_lower{ c } }
        i = i + 1
    }
    return true
}

fn not_letter { c: u8 } -> bool {
    return not ascii::is_alpha{ c }
}

fn count_lines { text: ascii::String } -> u64 {
    let mut n: u64 = 0
    let mut i: usize = 0
    while (i < ascii::len{ s = text }) {
        if (ascii::at{ s = text, i } == '\n') { n = n + 1 }
        i = i + 1
    }
    let len = ascii::len{ s = text }
    let ends_open = len > 0 and ascii::at{ s = text, i = len - 1 } != '\n'
    return if (ends_open) { n + 1 } else { n }       // a last line without '\n' still counts
}

// The most frequent word; ties go to the alphabetically first. Null if there are no words.
fn most_common(S) { counts: map::Map(ascii::String, i64, S) } -> ?Top {
    let mut best: ?Top = null
    let mut cursor: usize = 0
    while (true) {
        let e = match (map::next{ m = counts, &cursor }) {
            null          => { break }
            some{ value } => { value }
        }
        let better = match (best) {
            null          => { true }
            some{ value } => {
                e.value > value.count or (e.value == value.count and before{ a = e.key, b = value.word })
            }
        }
        if (better) { best = Top{ word = e.key, count = e.value } }
    }
    return best
}

// Whether a sorts before b, byte by byte.
fn before { a: ascii::String, b: ascii::String } -> bool {
    let mut i: usize = 0
    while (i < ascii::len{ s = a } and i < ascii::len{ s = b }) {
        let x = ascii::at{ s = a, i }
        let y = ascii::at{ s = b, i }
        if (x != y) { return x < y }
        i = i + 1
    }
    return ascii::len{ s = a } < ascii::len{ s = b }
}

fn report { mut io: Io, path: slice::Slice(u8), error: fs::Error } {
    io::eprint{ &io, s = ascii::from{ bytes = path } }
    let not_found = ": no such file"
    let denied = ": permission denied"
    let dir = ": is a directory"
    let oom = ": too large for the heap"
    let other = ": cannot read"
    let why = match (error) {
        not_found         => { ascii::of{ chars = &not_found } }
        permission_denied => { ascii::of{ chars = &denied } }
        is_directory      => { ascii::of{ chars = &dir } }
        out_of_memory     => { ascii::of{ chars = &oom } }
        else              => { ascii::of{ chars = &other } }
    }
    io::eprintln{ &io, s = why }
}
