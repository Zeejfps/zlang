// Counts the words in a file:
//
//   python tools/ctxc.py examples/wordcount.ctx --run notes.txt
//
// Uses command-line arguments and files (std/fs.ctx), main's exit code, a hash map
// (std/map.ctx), UTF-8 text and utf8::Cursor for scanning, errors (`!T`), and defer.
//
// A word is a run of letters. std recognizes only ASCII letters (it has no Unicode tables), so
// every non-ASCII character counts as a letter here: "café" is one word.

struct Top { word: utf8::String, count: i64 }

fn main { mut io: Io, mut fs: Fs, args: Args } -> i32 {
    if args.len != 1 {
        io::eprintln{ &io, s = "usage: wordcount FILE" }
        return 2
    }
    let path = args[0]

    let mut mem: [1048576]u8                                  // the heap: 1 MiB on the stack
    let mut heap = arena::new{ buf = mem[..] }

    // `iferr` gives the file's bytes, or leaves main with an exit code.
    let bytes = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr err{ error } {
        report{ &io, path, error }
        return 1
    }
    defer _ = alloc::resize{ realloc = arena::alloc, &heap, mem = bytes, count = 0 }

    lowercase{ bytes }
    let text = utf8::from{ bytes } iferr {
        io::eprintln{ &io, s = "not a UTF-8 text file" }
        return 1
    }

    // Keys are views into `bytes`, which outlives the map: defers run in reverse order.
    let mut counts = map::new(utf8::String, i64){
        realloc = arena::alloc, &heap, hash = map::hash_string, eq = utf8::eq,
    }
    defer map::free{ m = &counts}

    let mut words: u64 = 0
    let mut cur = utf8::cursor{ s = text }
    while not utf8::done{ cur } {
        _ = utf8::take_while{ &cur, f = not_letter }
        let word = utf8::take_while{ &cur, f = is_letter }
        if utf8::len{ s = word } == 0 { continue }
        words = words + 1
        let seen = map::at{ m = counts, key = word }            // ?*i64
        if seen != null {
            seen.* = seen.* + 1
        } else {
            map::put{ m = &counts, key = word, value = 1 } iferr {
                io::eprintln{ &io, s = "out of memory" }
                return 1
            }
        }
    }

    io::print{ &io, s = "lines: " }
    io::println_u64{ &io, n = count_lines{ text } }
    io::print{ &io, s = "words: " }
    io::println_u64{ &io, n = words }
    io::print{ &io, s = "distinct: " }
    io::println_u64{ &io, n = map::len{ m = counts } }

    let top = most_common{ counts }
    if top != null {
        io::print{ &io, s = "most common: " }
        io::print{ &io, s = top.word }
        io::put_char{ &io, c = ' ' }
        io::println_i64{ &io, n = top.count }
    }
    return 0
}

// Lowercases the ASCII letters in place. Any bytes stay as valid or invalid UTF-8 as they were:
// every byte of a non-ASCII character is above 127, so none of them changes.
fn lowercase { bytes: alloc::Bytes } {
    let mut i: usize = 0
    while i < bytes.len {
        bytes[i] = ascii::to_lower{ c = bytes[i] }
        i = i + 1
    }
}

fn is_letter { c: u32 } -> bool {
    return utf8::is_alpha{ c } or not utf8::is_ascii{ c }
}

fn not_letter { c: u32 } -> bool {
    return not is_letter{ c }
}

// Counts '\n' bytes. In UTF-8 a byte below 128 is always a whole character.
fn count_lines { text: utf8::String } -> u64 {
    let bytes = text.bytes
    let mut n: u64 = 0
    let mut i: usize = 0
    while i < bytes.len {
        if bytes[i] == '\n' { n = n + 1 }
        i = i + 1
    }
    let ends_open = bytes.len > 0 and bytes[bytes.len - 1] != '\n'
    return if ends_open { n + 1 } else { n }       // a last line without '\n' still counts
}

// The most frequent word; ties go to the alphabetically first. Null if there are no words.
fn most_common(S) { counts: map::Map(utf8::String, i64, S) } -> ?Top {
    let mut best: ?Top = null
    let mut cursor: usize = 0
    while true {
        let e = map::next{ m = counts, &cursor } ifnull { break }
        let better = match best {
            null          => { true }
            some{ value } => {
                e.value > value.count or (e.value == value.count and before{ a = e.key, b = value.word })
            }
        }
        if better { best = Top{ word = e.key, count = e.value } }
    }
    return best
}

// Whether a sorts before b, byte by byte. For UTF-8 that is code point order.
fn before { a: utf8::String, b: utf8::String } -> bool {
    let mut i: usize = 0
    while i < a.bytes.len and i < b.bytes.len {
        let x = a.bytes[i]
        let y = b.bytes[i]
        if x != y { return x < y }
        i = i + 1
    }
    return a.bytes.len < b.bytes.len
}

fn report { mut io: Io, path: []u8, error: error } {          // `error`: any error
    io::write{ &io, to = io::Stream::err, bytes = path }       // a path is bytes, not always text
    let why: utf8::String = match error {
        fs::not_found         => { ": no such file" }
        fs::permission_denied => { ": permission denied" }
        fs::is_directory      => { ": is a directory" }
        alloc::out_of_memory  => { ": too large for the heap" }
        else                  => { ": cannot read" }
    }
    io::eprintln{ &io, s = why }
}
