// Opens a window for two seconds, or until it is closed or Escape is pressed, through the GLFW
// binding in glfw.ctx, and fills it with a colour that fades, through the GL functions gl.ctx
// looks up into its `Gl` capability.

// What the key callback records, for main to report.
struct App { keys: i64 }

// GLFW calls this from poll_events. It finds the App through the window's user pointer.
#c::callback
fn on_key { mut glfw: glfw::Glfw, window: *mut glfw::Window, key: i32, action: i32 } {
    if action != glfw::PRESS { return }
    let p = glfw::user_pointer{ &glfw, window } ifnull { return }
    let app = @cast(*mut App, p)
    app.*.keys = app.*.keys + 1
    if key == glfw::KEY_ESCAPE { glfw::set_should_close{ &glfw, window } }
}

fn main { mut io: Io, mut glfw: glfw::Glfw } -> i32 {
    if not glfw::init{ &glfw } {
        io::eprintln{ &io, s = "glfw: init failed" }
        return 1
    }
    defer glfw::terminate{ &glfw }

    let mut major: i32 = 0
    let mut minor: i32 = 0
    let mut rev: i32 = 0
    glfw::glfwGetVersion{ &glfw, major = &major, minor = &minor, rev = &rev }
    io::print{ &io, s = "GLFW " }
    io::print_i64{ &io, n = major }
    io::print{ &io, s = "." }
    io::print_i64{ &io, n = minor }
    io::print{ &io, s = "." }
    io::println_i64{ &io, n = rev }

    let window = glfw::create_window{ &glfw, width = 640, height = 480, title = "ctxlang" } ifnull {
        io::eprintln{ &io, s = "glfw: no window" }
        return 1
    }
    defer glfw::destroy_window{ &glfw, window }
    glfw::make_current{ &glfw, window }
    let loaded = gl::load{ get_proc = glfw::proc_address{ &glfw, _ } } ifnull {
        io::eprintln{ &io, s = "gl: functions missing" }
        return 1
    }
    let mut gl = loaded
    let mut app = App{ keys = 0 }
    glfw::set_user_pointer{ &glfw, window, pointer = @cast(*mut u8, &app) }
    glfw::set_key_callback{ &glfw, window, callback = on_key }
    io::println{ &io, s = "window open" }
    while not glfw::should_close{ &glfw, window } and glfw::time{ &glfw } < 2.0 {
        let t = @trunc(i32, @as(i64, glfw::time{ &glfw } * 1000.0))
        let fade = @as(f32, t) / 2000.0
        gl.clear_color{ r = 0.1, g = 0.3 + 0.5 * fade, b = 0.6, a = 1.0 }
        gl.clear{ mask = gl::COLOR_BUFFER_BIT }
        glfw::swap_buffers{ &glfw, window }
        glfw::poll_events{ &glfw }
    }
    io::print{ &io, s = "window closed after " }
    io::print_i64{ &io, n = app.keys }
    io::println{ &io, s = " key presses" }
    return 0
}
