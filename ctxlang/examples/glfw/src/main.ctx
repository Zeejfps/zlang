// Opens a window for two seconds, or until it is closed, through the GLFW binding in glfw.ctx,
// and fills it with a colour that fades, through the GL functions gl.ctx looks up.
fn main { mut io: Io, mut glfw: glfw::Glfw, mut gl: gl::Gl } -> i32 {
    if not glfw::init{ &glfw } {
        io::eprintln{ &io, s = "glfw: init failed" }
        return 1
    }
    defer glfw::terminate{ &glfw }

    let mut major: i32 = 0
    let mut minor: i32 = 0
    let mut rev: i32 = 0
    glfw::glfwGetVersion{ &glfw, major = &major, minor = &minor, rev = &rev }
    io::print{ &io, s = "GLFW " }
    io::print_i64{ &io, n = major }
    io::print{ &io, s = "." }
    io::print_i64{ &io, n = minor }
    io::print{ &io, s = "." }
    io::println_i64{ &io, n = rev }

    let some{ value = window } = glfw::create_window{ &glfw, width = 640, height = 480, title = "ctxlang" } else {
        io::eprintln{ &io, s = "glfw: no window" }
        return 1
    }
    defer glfw::destroy_window{ &glfw, window }
    glfw::make_current{ &glfw, window }
    let some{ value = procs } = gl::load{ &glfw } else {
        io::eprintln{ &io, s = "gl: functions missing" }
        return 1
    }
    io::println{ &io, s = "window open" }
    while not glfw::should_close{ &glfw, window } and glfw::time{ &glfw } < 2.0 {
        let t = @trunc(i32, @as(i64, glfw::time{ &glfw } * 1000.0))
        let fade = @as(f32, t) / 2000.0
        procs.clear_color{ &gl, r = 0.1, g = 0.3 + 0.5 * fade, b = 0.6, a = 1.0 }
        procs.clear{ &gl, mask = gl::COLOR_BUFFER_BIT }
        glfw::swap_buffers{ &glfw, window }
        glfw::poll_events{ &glfw }
    }
    io::println{ &io, s = "window closed" }
    return 0
}
