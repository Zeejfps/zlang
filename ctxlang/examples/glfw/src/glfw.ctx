// A small binding of GLFW 3 (https://www.glfw.org): what main.ctx uses.
//
// GLFW's handles are opaque: a window is only ever a *mut Window, and C's NULL is null, since a
// ?*T is a C pointer (spec §8). A title is a []u8 that ends in a zero byte.
namespace glfw {
    // Permission to call GLFW.
    capability Glfw

    struct Window {}
    struct Monitor {}

    extern fn glfwInit { mut glfw: Glfw } -> i32
    extern fn glfwTerminate { mut glfw: Glfw }
    extern fn glfwGetVersion { mut glfw: Glfw, mut major: i32, mut minor: i32, mut rev: i32 }
    extern fn glfwCreateWindow { mut glfw: Glfw, width: i32, height: i32, title: *u8, monitor: ?*mut Monitor, share: ?*mut Window } -> ?*mut Window
    extern fn glfwDestroyWindow { mut glfw: Glfw, window: *mut Window }
    extern fn glfwWindowShouldClose { mut glfw: Glfw, window: *mut Window } -> i32
    extern fn glfwPollEvents { mut glfw: Glfw }
    extern fn glfwGetTime { mut glfw: Glfw } -> f64
    extern fn glfwMakeContextCurrent { mut glfw: Glfw, window: *mut Window }
    extern fn glfwSwapBuffers { mut glfw: Glfw, window: *mut Window }
    // GLFWglproc: the address of a GL function, as a C function pointer of no particular type.
    extern fn glfwGetProcAddress { mut glfw: Glfw, name: *u8 } -> ?extern fn{}

    fn init { mut glfw: Glfw } -> bool { return glfwInit{ &glfw } != 0 }

    fn terminate { mut glfw: Glfw } { glfwTerminate{ &glfw } }

    // A window, or null if GLFW couldn't make one.
    fn create_window { mut glfw: Glfw, width: i32, height: i32, title: []u8 } -> ?*mut Window {
        if title.len == 0 or title[title.len - 1] != 0 { @panic("glfw: a title must end in a zero byte") }
        return glfwCreateWindow{ &glfw, width, height, title = title.ptr, monitor = null, share = null }
    }

    fn destroy_window { mut glfw: Glfw, window: *mut Window } { glfwDestroyWindow{ &glfw, window } }

    fn should_close { mut glfw: Glfw, window: *mut Window } -> bool {
        return glfwWindowShouldClose{ &glfw, window } != 0
    }

    fn poll_events { mut glfw: Glfw } { glfwPollEvents{ &glfw } }

    // Seconds since init.
    fn time { mut glfw: Glfw } -> f64 { return glfwGetTime{ &glfw } }

    // Makes the window's GL context the current one, which GL calls and proc_address need.
    fn make_current { mut glfw: Glfw, window: *mut Window } { glfwMakeContextCurrent{ &glfw, window } }

    fn swap_buffers { mut glfw: Glfw, window: *mut Window } { glfwSwapBuffers{ &glfw, window } }

    // The GL function `name` (ending in a zero byte) of the current context, or null.
    fn proc_address { mut glfw: Glfw, name: []u8 } -> ?extern fn{} {
        if name.len == 0 or name[name.len - 1] != 0 { @panic("glfw: a name must end in a zero byte") }
        return glfwGetProcAddress{ &glfw, name = name.ptr }
    }
}
