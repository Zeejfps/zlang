// A JSON parser (RFC 8259), by recursive descent.
//
//   let v = parser::parse{ &heap, realloc = arena::alloc, text = bytes } iferr err{ error } {
//       ...                                    // parser::invalid{ problem, at }: at is a byte offset into text
//   }
//
// The input must be UTF-8. Strings without escapes are views of it, so it must outlive the tree.
// Everything else, and every string with an escape, is allocated from heap and never freed:
// parse into an arena.

namespace parser {
    union Problem {
        not_utf8,
        unexpected_end,
        expected_value,
        expected_comma_or_bracket,      // inside an array
        expected_comma_or_brace,        // inside an object
        expected_key,
        expected_colon,
        bad_number,
        bad_escape,
        control_char,                   // an unescaped byte below 0x20 inside a string
        too_deep,
        trailing_text,
        out_of_memory,
    }

    // The input isn't JSON: what is wrong, at a byte offset into it.
    error invalid{ problem: Problem, at: usize }

    // Deeper nesting is rejected rather than risk the stack.
    const MAX_DEPTH: u32 = 256

    struct Parser(S) {
        text:    []u8,
        pos:     usize,
        depth:   u32,
        realloc: alloc::Fn(S),
    }

    fn parse(S) { mut heap: S, realloc: alloc::Fn(S), text: []u8 } -> !json::Value {
        match utf8::from{ bytes = text } {
            ok => {}
            utf8::invalid{ at } => { return fail{ at, problem = Problem::not_utf8 } }
        }
        let mut p = Parser{ text, pos = 0, depth = 0, realloc }
        let value = try parse_value{ &p, &heap }
        skip_space{ &p }
        if p.pos < text.len { return fail{ at = p.pos, problem = Problem::trailing_text } }
        return value
    }

    fn parse_value(S) { mut p: Parser(S), mut heap: S } -> !json::Value {
        skip_space{ &p }
        let c = peek{ p }
        if c == null { return fail{ at = p.pos, problem = Problem::unexpected_end } }
        if c == '{' { return parse_object{ .. } }
        if c == '[' { return parse_array{ .. } }
        if c == '"' {
            let value = try parse_string{ .. }
            return json::Value::string{ value }
        }
        if c == '-' or ascii::is_digit{ c } { return parse_number{ &p } }
        if eat_word{ &p, w = "true" } { return json::Value::boolean{ value = true } }
        if eat_word{ &p, w = "false" } { return json::Value::boolean{ value = false } }
        if eat_word{ &p, w = "null" } { return json::Value::nil }
        return fail{ at = p.pos, problem = Problem::expected_value }
    }

    // At '['.
    fn parse_array(S) { mut p: Parser(S), mut heap: S } -> !json::Value {
        if not enter{ &p } { return fail{ at = p.pos, problem = Problem::too_deep } }
        defer p.depth = p.depth - 1
        let mut items = list::new(json::Value){ realloc = p.realloc, &heap }
        skip_space{ &p }
        if not eat{ &p, c = ']' } {
            while true {
                let value = try parse_value{ .. }
                list::push{ list = &items, item = value } iferr {
                    return fail{ at = p.pos, problem = Problem::out_of_memory }
                }
                skip_space{ &p }
                if eat{ &p, c = ']' } { break }
                if not eat{ &p, c = ',' } { return fail{ at = p.pos, problem = Problem::expected_comma_or_bracket } }
            }
        }
        return json::Value::array{ items = list::items{ list = items } }
    }

    // At '{'.
    fn parse_object(S) { mut p: Parser(S), mut heap: S } -> !json::Value {
        if not enter{ &p } { return fail{ at = p.pos, problem = Problem::too_deep } }
        defer p.depth = p.depth - 1
        let mut members = list::new(json::Member){ realloc = p.realloc, &heap }
        skip_space{ &p }
        if not eat{ &p, c = '}' } {
            while true {
                skip_space{ &p }
                if not next_is{ p, c = '"' } { return fail{ at = p.pos, problem = Problem::expected_key } }
                let key = try parse_string{ .. }
                skip_space{ &p }
                if not eat{ &p, c = ':' } { return fail{ at = p.pos, problem = Problem::expected_colon } }
                let value = try parse_value{ .. }
                list::push{ list = &members, item = json::Member{ key, value } } iferr {
                    return fail{ at = p.pos, problem = Problem::out_of_memory }
                }
                skip_space{ &p }
                if eat{ &p, c = '}' } { break }
                if not eat{ &p, c = ',' } { return fail{ at = p.pos, problem = Problem::expected_comma_or_brace } }
            }
        }
        return json::Value::object{ members = list::items{ list = members } }
    }

    // At '"'. A string without escapes is a view of the input; one with escapes is decoded into
    // a copy, built from the runs of plain text between them.
    fn parse_string(S) { mut p: Parser(S), mut heap: S } -> !utf8::String {
        p.pos = p.pos + 1
        let mut b = utf8::builder{ realloc = p.realloc, &heap }
        let mut copied = false
        while true {
            // The run ends at an ASCII byte, so both ends are character boundaries.
            let lo = p.pos
            while p.pos < p.text.len and plain{ c = p.text[p.pos] } { p.pos = p.pos + 1 }
            let run = utf8::String{ bytes = p.text[lo..p.pos] }

            let c = peek{ p }
            if c == null { return fail{ at = p.pos, problem = Problem::unexpected_end } }
            if c < 32 { return fail{ at = p.pos, problem = Problem::control_char } }
            if c == '"' and not copied {
                p.pos = p.pos + 1
                return run
            }
            utf8::push{ &b, s = run } iferr { return fail{ at = p.pos, problem = Problem::out_of_memory } }
            if c == '"' {
                p.pos = p.pos + 1
                return utf8::view{ b }
            }
            // c is '\\'
            let ch = try parse_escape{ &p }
            utf8::push_char{ &b, c = ch } iferr { return fail{ at = p.pos, problem = Problem::out_of_memory } }
            copied = true
        }
    }

    // A byte that stands for itself inside a string.
    fn plain { c: u8 } -> bool {
        return c != '"' and c != '\\' and c >= 32
    }

    // At '\\'. Returns the character the escape stands for. A \u escape for a UTF-16 high
    // surrogate must be followed by one for a low surrogate; together they are one character.
    fn parse_escape(S) { mut p: Parser(S) } -> !u32 {
        let at = p.pos
        p.pos = p.pos + 1
        let c = bump{ &p }
        if c == null { return fail{ at = p.pos, problem = Problem::unexpected_end } }
        if c == '"' or c == '\\' or c == '/' { return c }
        if c == 'b' { return 8 }
        if c == 'f' { return 12 }
        if c == 'n' { return '\n' }
        if c == 'r' { return '\r' }
        if c == 't' { return '\t' }
        if c != 'u' { return fail{ at, problem = Problem::bad_escape } }

        let hi = hex4{ &p }
        if hi == null { return fail{ at, problem = Problem::bad_escape } }
        if hi < 55296 or hi > 57343 { return hi }      // not U+D800..U+DFFF
        if hi > 56319 { return fail{ at, problem = Problem::bad_escape } }  // a lone low surrogate
        if not eat{ &p, c = '\\' } or not eat{ &p, c = 'u' } { return fail{ at, problem = Problem::bad_escape } }
        let lo = hex4{ &p }
        if lo == null { return fail{ at, problem = Problem::bad_escape } }
        if lo < 56320 or lo > 57343 { return fail{ at, problem = Problem::bad_escape } }
        return 65536 + (hi - 55296) * 1024 + (lo - 56320)
    }

    // Four hex digits, or null.
    fn hex4(S) { mut p: Parser(S) } -> ?u32 {
        let mut v: u32 = 0
        let mut k = 0
        while k < 4 {
            let c = bump{ &p }
            if c == null { return null }
            let d = hex_digit{ c }
            if d == null { return null }
            v = v * 16 + d
            k = k + 1
        }
        return v
    }

    fn hex_digit { c: u8 } -> ?u32 {
        if ascii::is_digit{ c } { return c - '0' }
        if c >= 'a' and c <= 'f' { return c - 'a' + 10 }
        if c >= 'A' and c <= 'F' { return c - 'A' + 10 }
        return null
    }

    // At '-' or a digit:  -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
    fn parse_number(S) { mut p: Parser(S) } -> !json::Value {
        let start = p.pos
        _ = eat{ &p, c = '-' }
        if eat{ &p, c = '0' } {
            let next = peek{ p }
            if next != null {
                if ascii::is_digit{ c = next } { return fail{ at = start, problem = Problem::bad_number } }   // leading zero
            }
        } else if digits{ &p } == 0 {
            return fail{ at = start, problem = Problem::bad_number }
        }
        if eat{ &p, c = '.' } {
            if digits{ &p } == 0 { return fail{ at = start, problem = Problem::bad_number } }
        }
        if eat{ &p, c = 'e' } or eat{ &p, c = 'E' } {
            if not eat{ &p, c = '+' } { _ = eat{ &p, c = '-' } }
            if digits{ &p } == 0 { return fail{ at = start, problem = Problem::bad_number } }
        }
        // Everything consumed is ASCII, and valid syntax for parse_f64.
        let text = utf8::String{ bytes = p.text[start..p.pos] }
        return match utf8::parse_f64{ s = text } {
            null          => { fail{ at = start, problem = Problem::bad_number } }      // beyond f64
            some{ value } => { json::Value::number{ value } }
        }
    }

    // ---- scanning

    fn fail(T) { at: usize, problem: Problem } -> !T {
        return invalid{ problem, at }
    }

    // Counts a level of nesting. False if that is too deep.
    fn enter(S) { mut p: Parser(S) } -> bool {
        if p.depth >= MAX_DEPTH { return false }
        p.depth = p.depth + 1
        p.pos = p.pos + 1                                   // the '[' or '{'
        return true
    }

    fn peek(S) { p: Parser(S) } -> ?u8 {
        if p.pos >= p.text.len { return null }
        return p.text[p.pos]
    }

    fn bump(S) { mut p: Parser(S) } -> ?u8 {
        let c = peek{ p }
        if c != null { p.pos = p.pos + 1 }
        return c
    }

    fn next_is(S) { p: Parser(S), c: u8 } -> bool {
        return p.pos < p.text.len and p.text[p.pos] == c
    }

    fn eat(S) { mut p: Parser(S), c: u8 } -> bool {
        if not next_is{ p, c } { return false }
        p.pos = p.pos + 1
        return true
    }

    // Consumes w if the text continues with it.
    fn eat_word(S) { mut p: Parser(S), w: utf8::String } -> bool {
        let n = utf8::len{ s = w }
        if p.pos + n > p.text.len { return false }
        if not slice::eq_bytes{ a = p.text[p.pos..p.pos + n], b = w.bytes } { return false }
        p.pos = p.pos + n
        return true
    }

    // Consumes decimal digits and returns how many.
    fn digits(S) { mut p: Parser(S) } -> usize {
        let lo = p.pos
        while p.pos < p.text.len and ascii::is_digit{ c = p.text[p.pos] } { p.pos = p.pos + 1 }
        return p.pos - lo
    }

    // JSON whitespace: space, tab, newline and carriage return, the same set as ascii::is_space.
    fn skip_space(S) { mut p: Parser(S) } {
        while p.pos < p.text.len and ascii::is_space{ c = p.text[p.pos] } { p.pos = p.pos + 1 }
    }
}
