// Pretty-prints a JSON file, or the part of it at a dotted path:
//
//   python tools/ctxc.py examples/json --run examples/json/sample.json
//   python tools/ctxc.py examples/json --run examples/json/sample.json users.0.name
//
// A directory is one program: this file holds main, value.ctx the data model (namespace json),
// parser.ctx the parser, and printer.ctx the writer.

fn main { mut io: Io, mut fs: Fs, args: Args } -> i32 {
    if args.len < 1 or args.len > 2 {
        io::eprintln{ &io, s = "usage: json FILE [PATH]" }
        return 2
    }
    let path = args[0]

    let mut mem: [4194304]u8                                    // the heap: 4 MiB on the stack
    let mut heap = arena::new{ buf = mem[..] }

    let ok{ value = bytes } = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } else {
        io::write{ &io, to = io::Stream::err, bytes = path }
        io::eprintln{ &io, s = ": cannot read" }
        return 1
    }

    let doc = parser::parse{ &heap, realloc = arena::alloc, text = bytes } iferr err{ error } {
        match error { parser::invalid{ problem, at } => { report{ &io, path, text = bytes, problem, at } } }
        return 1
    }

    let mut v = doc
    if args.len == 2 {
        let query = args[1]
        let found = match utf8::from{ bytes = query } {
            ok{ value } => { json::lookup{ v = doc, path = value } }
            err         => { null }
        }
        if found == null {
            io::eprint{ &io, s = "no value at " }
            io::write{ &io, to = io::Stream::err, bytes = query }
            io::eprintln{ &io, s = utf8::empty{} }
            return 1
        }
        v = found
    }

    let out = printer::format{ &heap, realloc = arena::alloc, v, indent = 2 }
    if out == null {
        io::eprintln{ &io, s = "out of memory" }
        return 1
    }
    io::println{ &io, s = out }
    return 0
}

// Prints "FILE:LINE:COLUMN: message" to standard error. The column counts characters.
fn report { mut io: Io, path: []u8, text: []u8, problem: parser::Problem, at: usize } {
    let mut line: u64 = 1
    let mut col: u64 = 1
    let mut i: usize = 0
    while i < at {
        let c = text[i]
        if c == '\n' {
            line = line + 1
            col = 1
        } else if c < 128 or c >= 192 {                   // not a UTF-8 continuation byte
            col = col + 1
        }
        i = i + 1
    }
    io::write{ &io, to = io::Stream::err, bytes = path }
    let mut buf: [48]u8
    let mut heap = arena::new{ buf = buf[..] }
    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
    _ = utf8::push_char{ &b, c = ':' }
    _ = utf8::push_u64{ &b, n = line }
    _ = utf8::push_char{ &b, c = ':' }
    _ = utf8::push_u64{ &b, n = col }
    _ = utf8::push{ &b, s = ": " }
    io::eprint{ &io, s = utf8::view{ b } }
    describe{ &io, problem }
}

fn describe { mut io: Io, problem: parser::Problem } {
    let msg: utf8::String = match problem {
        not_utf8                  => { "not UTF-8 text" }
        unexpected_end            => { "unexpected end of input" }
        expected_value            => { "expected a value" }
        expected_comma_or_bracket => { "expected ',' or ']'" }
        expected_comma_or_brace   => { "expected ',' or '}'" }
        expected_key              => { "expected a string key" }
        expected_colon            => { "expected ':'" }
        bad_number                => { "invalid number" }
        bad_escape                => { "invalid escape" }
        control_char              => { "control character in string" }
        too_deep                  => { "nested too deeply" }
        trailing_text             => { "unexpected text after the value" }
        out_of_memory             => { "out of memory" }
    }
    io::eprintln{ &io, s = msg }
}
