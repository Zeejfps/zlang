// Enums as generated ctxlang source, for build programs: what a derive would write.
namespace enums {
    // `enum NAME: u32 { V, ... }`, and in namespace `space` its variants (`ALL`) and functions
    // between a variant and its name (`name`, `parse`).
    fn generate { mut heap: arena::Arena, space: []u8, name: []u8, variants: [][]u8 } -> []u8 {
        let mut b = utf8::builder{ realloc = arena::alloc, &heap }
        _ = @fmt(&b, "// Generated by examples/gen/tools/enums.ctx.\n\nenum {}: u32 {{", name)
        let mut i: usize = 0
        while i < variants.len {
            _ = @fmt(&b, " {},", variants[i])
            i = i + 1
        }
        _ = @fmt(&b, " }}\n\nnamespace {} {{\n    const ALL: [{}]{} = [", space, variants.len, name)
        i = 0
        while i < variants.len {
            _ = @fmt(&b, "{}::{}, ", name, variants[i])
            i = i + 1
        }
        _ = @fmt(&b, "]\n\n    fn name {{ v: {} }} -> []u8 {{\n        match v {{\n", name)
        i = 0
        while i < variants.len {
            _ = @fmt(&b, "            {} => {{ return \"{}\" }}\n", variants[i], variants[i])
            i = i + 1
        }
        _ = @fmt(&b, "        }}\n    }}\n\n    fn parse {{ s: []u8 }} -> ?{} {{\n", name)
        i = 0
        while i < variants.len {
            _ = @fmt(&b, "        if slice::eq_bytes{{ a = s, b = \"{}\" }} {{ return {}::{} }}\n", variants[i], name, variants[i])
            i = i + 1
        }
        _ = @fmt(&b, "        return null\n    }}\n}}\n")
        return utf8::view{ b }.bytes
    }
}
