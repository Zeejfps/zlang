// Field lists as generated ctxlang source, from declarations a build program reads
// (build::declarations): what a derive of Debug would write.
namespace describe {
    // For each struct among decls marked `#describe`, `fields::NAME`, a fn that prints its
    // fields' names and types.
    fn generate { mut heap: arena::Arena, decls: []build::Decl } -> []u8 {
        let mut b = utf8::builder{ realloc = arena::alloc, &heap }
        _ = @fmt(&b, "// Generated by examples/gen/tools/describe.ctx.\n\nnamespace fields {{\n")
        let mut i: usize = 0
        while i < decls.len {
            let d = decls[i]
            if d.kind == build::Kind::structure and marked{ d } {
                _ = @fmt(&b, "    fn {} {{ mut io: Io }} {{\n        io::println{{ &io, s = \"{} {{", d.name, d.name)
                let mut k: usize = 0
                while k < d.fields.len {
                    let sep = if k == 0 { " " } else { ", " }
                    _ = @fmt(&b, "{}{}: {}", sep, d.fields[k].name, d.fields[k].ty)
                    k = k + 1
                }
                _ = @fmt(&b, " }}\" }}\n    }}\n")
            }
            i = i + 1
        }
        _ = @fmt(&b, "}}\n")
        return utf8::view{ b }.bytes
    }

    fn marked { d: build::Decl } -> bool {
        let mut i: usize = 0
        while i < d.attrs.len {
            if slice::eq_bytes{ a = d.attrs[i].name, b = "describe" } { return true }
            i = i + 1
        }
        return false
    }
}
