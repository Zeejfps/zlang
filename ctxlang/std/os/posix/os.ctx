// std: os on Linux and macOS. The platform's layer (spec §17): what io, mem, proc, fs, net and
// rt need from the operating system, over the C library and its environ. Every layer declares the
// same functions; std/os/windows is Windows', and a build compiles one. What differs between
// Linux and macOS is in namespace sys, std/os/linux or std/os/macos, which a build compiles
// beside it.

namespace os {
    // What std's Proc holds on this platform: C's `char **environ`, the "KEY=VALUE" strings of
    // this program's environment, ending with null.
    capability Proc {
        extern environ: ?*?cstr,
    }

    // The operating system this layer is for, and whether its environment's keys are
    // case-sensitive (std/os/linux/target.ctx or std/os/macos/target.ctx).
    const OS: build::Os = target::OS
    const ENV_CASE: bool = target::ENV_CASE

    #c_symbol{ name = "write" }
    extern fn c_write { mut io: Io, fd: i32, buf: *u8, count: usize } -> i64

    #c_symbol{ name = "read" }
    extern fn c_read { mut io: Io, fd: i32, buf: *mut u8, count: usize } -> i64

    extern fn aligned_alloc { mut mem: Mem, alignment: usize, size: usize } -> ?*mut u8
    extern fn memset { mut mem: Mem, dst: *mut u8, byte: i32, count: usize } -> *mut u8

    // Writes some of `bytes`, which isn't empty, to the stream. Returns how many; 0 after an error.
    fn write { mut io: Io, to: io::Stream, bytes: []u8 } -> usize {
        let fd: i32 = match to { out => { 1 } err => { 2 } }
        let w = c_write{ &io, fd, buf = bytes.ptr, count = bytes.len }
        return if w > 0 { @as(usize, w) } else { 0 }
    }

    // Reads some of standard input into `into`, which isn't empty. Returns how many; 0 at the end
    // or after an error.
    // In a task, or under a deadline, it first waits until standard input is readable, the task
    // is asked to stop or the deadline passes (std/task.ctx), and then returns 0 as at the end.
    // Descriptor 0 stays blocking: other programs share it.
    fn read { mut io: Io, into: []mut u8 } -> usize {
        if task::can_stop{ cancel = &io } {
            if task::check{ cancel = &io } is err { return 0 }
            let object = task::get_cancel_object{ cancel = &io }
            let mut fds: [2]PollFd = [PollFd{ fd = 0, events = POLLIN, revents = 0 }, PollFd{ fd = if object != 0 { @as(i32, object) } else { -1 }, events = POLLIN, revents = 0 }]
            while true {
                let r = poll_io{ &io, fds = &fds[0], count = 2, ms = deadline_poll_millis{ cancel = &io } }
                if r > 0 {
                    if fds[1].revents != 0 { return 0 }
                    break
                }
                if r == 0 and task::check{ cancel = &io } is err { return 0 }
            }
        }
        let r = c_read{ &io, fd = 0, buf = into.ptr, count = into.len }
        return if r > 0 { @as(usize, r) } else { 0 }
    }

    // poll's struct pollfd, the same on Linux and macOS, and its events: readable, writable. A
    // descriptor below 0 is skipped.
    struct PollFd { fd: i32, events: i16, revents: i16 }
    const POLLIN: i16 = 1
    const POLLOUT: i16 = 4

    #c_symbol{ name = "poll" }
    extern fn poll_io { mut io: Io, fds: *mut PollFd, count: u64, ms: i32 } -> i32
    #c_symbol{ name = "poll" }
    extern fn poll_proc { mut proc: Proc, fds: *mut PollFd, count: u64, ms: i32 } -> i32
    #c_symbol{ name = "poll" }
    extern fn poll_threads { mut threads: Threads, fds: *mut PollFd, count: u64, ms: i32 } -> i32

    // Waits until descriptor fd has `events`; in a task, until its cancel object is signalled,
    // and then fails with task::cancelled; and until the calling thread's deadline, if it has
    // one, and then fails with task::deadline_passed.
    fn ready { mut proc: Proc, mut cancel: task::Cancel, fd: i32, events: i16 } -> proc::Error! {
        let object = task::get_cancel_object{ &cancel }
        let mut fds: [2]PollFd = [PollFd{ fd, events, revents = 0 }, PollFd{ fd = if object != 0 { @as(i32, object) } else { -1 }, events = POLLIN, revents = 0 }]
        while true {
            let r = poll_proc{ &proc, fds = &fds[0], count = 2, ms = deadline_poll_millis{ &cancel } }
            if r > 0 {
                if fds[1].revents != 0 { return task::cancelled }
                return
            }
            if r == 0 { try task::check{ &cancel } }
            if r < 0 {
                let e = sys::proc_errno{ &proc }.*
                if e != EINTR { return proc_failed{ code = e } }
            }
        }
    }

    #c_symbol{ name = "clock_gettime" }
    extern fn deadline_clock_gettime { mut cancel: task::Cancel, clock: i32, mut now: Timespec } -> i32

    // The deadlines' clock (task::run_within): CLOCK_MONOTONIC in nanoseconds, as std's clock
    // reads it, which a Cancel reads without a Clock. Never 0, which is no deadline: the
    // clock counts from the system's start.
    fn read_deadline_clock { mut cancel: task::Cancel } -> u64 {
        let mut t = Timespec{ sec = 0, nsec = 0 }
        _ = deadline_clock_gettime{ &cancel, clock = sys::CLOCK_MONOTONIC, now = &t }
        return @as(u64, t.sec) * 1000000000 + @as(u64, t.nsec) + 1
    }

    // How long a poll may wait before the calling thread's deadline, as poll's timeout takes
    // it: -1 without one. Every blocking call of this layer that a cancel stops polls with it,
    // and asks task::check when a poll ends with nothing.
    fn deadline_poll_millis { mut cancel: task::Cancel } -> i32 {
        let left = task::get_time_left{ &cancel }
        if left == task::FOREVER { return -1 }
        return poll_millis{ nanoseconds = left }
    }

    // What sys::await_exit found: the time ran out, the process ended, or the calling task was
    // asked to stop.
    const TIMED_OUT: u8 = 0
    const EXITED: u8 = 1
    const STOPPED: u8 = 2

    // `size` bytes, a multiple of mem::PAGE, zeroed and page-aligned. Null if there isn't enough
    // memory.
    fn pages { mut mem: Mem, size: usize } -> ?*mut u8 {
        let p = aligned_alloc{ &mem, alignment = mem::PAGE, size } ifnull { return null }
        _ = memset{ &mem, dst = p, byte = 0, count = size }
        return p
    }

    // The value of environment variable `name`, or null if it isn't set: a view of environ's
    // own text, which lives until the program ends.
    fn env { mut proc: Proc, name: []u8 } -> ?[]u8 {
        let entries = proc.environ ifnull { return null }
        let mut i: usize = 0
        while true {
            let entry = c::bytes{ s = (entries + i).* ifnull { return null } }
            if entry.len > name.len and entry[name.len] == '=' and slice::eq_bytes{ a = entry[..name.len], b = name } {
                return entry[name.len + 1..]
            }
            i = i + 1
        }
        return null
    }

    // The environment's "KEY=VALUE" entries: views of environ's own text, which live until the
    // program ends, listed in memory from malloc, for good.
    fn environment { mut proc: Proc } -> [][]u8 {
        let entries = proc.environ ifnull { return slice::empty([]u8){} }
        let mut n: usize = 0
        while (entries + n).* != null { n = n + 1 }
        if n == 0 { return slice::empty([]u8){} }
        let p = c_malloc{ &proc, size = n * @size_of([]u8) } ifnull { return slice::empty([]u8){} }
        let items = @slice(@cast(*mut []u8, p), n)
        let mut i: usize = 0
        while i < n {
            items[i] = c::bytes{ s = (entries + i).* ifnull { return items[..i] } }
            i = i + 1
        }
        return items
    }

    // ---- files, for std's fs: a File's id is its file descriptor. Paths aren't empty: fs
    // reports those as not_found itself.

    #c_symbol{ name = "read" }
    extern fn fd_read { mut fs: Fs, fd: i32, buf: *mut u8, count: usize } -> i64
    #c_symbol{ name = "write" }
    extern fn fd_write { mut fs: Fs, fd: i32, buf: *u8, count: usize } -> i64
    #c_symbol{ name = "close" }
    extern fn fd_close { mut fs: Fs, fd: i32 } -> i32
    extern fn lseek { mut fs: Fs, fd: i32, offset: i64, whence: i32 } -> i64
    extern fn unlink { mut fs: Fs, path: *u8 } -> i32
    extern fn mkdir { mut fs: Fs, path: *u8, mode: u32 } -> i32
    extern fn rmdir { mut fs: Fs, path: *u8 } -> i32
    #c_symbol{ name = "rename" }
    extern fn c_rename { mut fs: Fs, from: *u8, to: *u8 } -> i32
    extern fn getcwd { mut fs: Fs, buf: *mut u8, size: usize } -> ?*u8
    // A DIR * is opaque, so it is a number here, 0 for null: as a pointer, the escape check
    // would take it to hold the path opendir was given.
    extern fn opendir { mut fs: Fs, path: *u8 } -> u64
    extern fn readdir { mut fs: Fs, dir: u64 } -> ?*u8
    extern fn closedir { mut fs: Fs, dir: u64 } -> i32

    const O_RDONLY: i32 = 0
    const O_WRONLY: i32 = 1
    const SEEK_SET: i32 = 0
    const SEEK_END: i32 = 2
    const PATH_MAX: usize = 4096

    // A directory being read, for fs::list: the C library's DIR.
    struct Dir { handle: u64 }

    fn file_open { mut fs: Fs, path: []u8, mode: fs::Mode } -> fs::Error!u64 {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if is_dir{ &fs, path = p } { return fs::is_directory }
        let flags = match mode {
            read   => { O_RDONLY }
            write  => { O_WRONLY | sys::O_CREAT | sys::O_TRUNC }
            append => { O_WRONLY | sys::O_CREAT | sys::O_APPEND }
            create => { O_WRONLY | sys::O_CREAT | sys::O_EXCL }
        }
        let fd = sys::open{ &fs, path = p, flags, mode = 438 }      // 0666, less the umask
        if fd < 0 { return failed{ code = sys::errno{ &fs }.* } }
        return @as(u64, fd)
    }

    // Reads at most into.len bytes, which aren't none. Returns how many; 0 at the end.
    fn file_read { mut fs: Fs, file: u64, into: []mut u8 } -> fs::Error!usize {
        let fd = descriptor{ file } ifnull { return fs::bad_file }
        let n = fd_read{ &fs, fd, buf = into.ptr, count = into.len }
        if n < 0 { return failed{ code = sys::errno{ &fs }.* } }
        return @as(usize, n)
    }

    // Reads at most into.len bytes, which aren't none, from `offset` bytes into the file, without
    // its position (pread). Returns how many; 0 at or past the end.
    fn file_read_at { mut fs: Fs, file: u64, offset: u64, into: []mut u8 } -> fs::Error!usize {
        let fd = descriptor{ file } ifnull { return fs::bad_file }
        while true {
            let n = pread{ &fs, fd, buf = into.ptr, count = into.len, offset = @as(i64, offset) }
            if n >= 0 { return @as(usize, n) }
            let e = sys::errno{ &fs }.*
            if e != EINTR { return failed{ code = e } }
        }
    }

    extern fn pread { mut fs: Fs, fd: i32, buf: *mut u8, count: usize, offset: i64 } -> i64

    // Writes some of `bytes`, which aren't none. Returns how many.
    fn file_write { mut fs: Fs, file: u64, bytes: []u8 } -> fs::Error!usize {
        let fd = descriptor{ file } ifnull { return fs::bad_file }
        let n = fd_write{ &fs, fd, buf = bytes.ptr, count = bytes.len }
        if n < 0 { return failed{ code = sys::errno{ &fs }.* } }
        return @as(usize, n)
    }

    fn file_close { mut fs: Fs, file: u64 } -> fs::Error! {
        let fd = descriptor{ file } ifnull { return fs::bad_file }
        if fd_close{ &fs, fd } < 0 { return failed{ code = sys::errno{ &fs }.* } }
    }

    // Moves the position to `offset` from the start (SEEK_SET).
    fn file_seek { mut fs: Fs, file: u64, offset: u64 } -> fs::Error! {
        let fd = descriptor{ file } ifnull { return fs::bad_file }
        if offset > 9223372036854775807 { return failed{ code = 22 } }       // EINVAL
        if lseek{ &fs, fd, offset = @as(i64, offset), whence = SEEK_SET } < 0 { return failed{ code = sys::errno{ &fs }.* } }
    }

    // The size of the file at `path`: where its end is, which needs no layout of struct stat.
    fn file_size { mut fs: Fs, path: []u8 } -> fs::Error!u64 {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if is_dir{ &fs, path = p } { return fs::is_directory }
        let fd = sys::open{ &fs, path = p, flags = O_RDONLY, mode = 0 }
        if fd < 0 { return failed{ code = sys::errno{ &fs }.* } }
        let end = lseek{ &fs, fd, offset = 0, whence = SEEK_END }
        let code = sys::errno{ &fs }.*
        _ = fd_close{ &fs, fd }
        if end < 0 { return failed{ code } }
        return @as(u64, end)
    }

    fn remove { mut fs: Fs, path: []u8 } -> fs::Error! {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if is_dir{ &fs, path = p } { return fs::is_directory }
        if unlink{ &fs, path = p } < 0 { return failed{ code = sys::errno{ &fs }.* } }
    }

    fn make_dir { mut fs: Fs, path: []u8 } -> fs::Error! {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if mkdir{ &fs, path = p, mode = 511 } < 0 { return failed{ code = sys::errno{ &fs }.* } }     // 0777, less the umask
    }

    fn remove_dir { mut fs: Fs, path: []u8 } -> fs::Error! {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if rmdir{ &fs, path = p } < 0 { return failed{ code = sys::errno{ &fs }.* } }
    }

    fn rename { mut fs: Fs, from: []u8, to: []u8 } -> fs::Error! {
        let mut a: [4096]u8
        let mut b: [4096]u8
        let p = c_path{ path = from, buf = a[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        let q = c_path{ path = to, buf = b[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if c_rename{ &fs, from = p, to = q } < 0 { return failed{ code = sys::errno{ &fs }.* } }
    }

    // The working directory's path into `into`. Returns its length.
    fn working_dir { mut fs: Fs, into: []mut u8 } -> fs::Error!usize {
        if getcwd{ &fs, buf = into.ptr, size = into.len } == null { return failed{ code = sys::errno{ &fs }.* } }
        let mut n: usize = 0
        while n < into.len and into[n] != 0 { n = n + 1 }
        return n
    }

    fn is_absolute { path: []u8 } -> bool {
        return target::is_absolute{ path }
    }

    fn dir_open { mut fs: Fs, path: []u8 } -> fs::Error!Dir {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        let d = opendir{ &fs, path = p }
        if d == 0 { return failed{ code = sys::errno{ &fs }.* } }
        return Dir{ handle = d }
    }

    // The next entry's name, "." and ".." included, or null at the end. It lives until the next
    // call.
    fn dir_next { mut fs: Fs, mut dir: Dir } -> ?[]u8 {
        let e = readdir{ &fs, dir = dir.handle } ifnull { return null }
        return c::bytes{ s = @cast(cstr, e + sys::DIRENT_NAME) }
    }

    fn dir_close { mut fs: Fs, mut dir: Dir } {
        _ = closedir{ &fs, dir = dir.handle }
    }

    // ---- for std's rt: starting the program, and ending it

    #c_symbol{ name = "exit" }
    extern fn c_exit { mut proc: Proc, code: i32 }

    // Ends the program with exit code `code`, as C's exit does.
    fn exit { mut proc: Proc, code: i32 } {
        c_exit{ &proc, code }
    }

    // What the platform needs before main runs (sys::start).
    fn start { mut io: Io, mut proc: Proc, argv: *?*u8 } {
        sys::start{ &proc, argv }
    }

    // The command line's arguments after the program's name: views of C's argv (rt::c_args).
    fn args { mut mem: Mem, argc: i32, argv: *?*u8 } -> [][]u8 {
        return rt::c_args{ &mem, argc, argv }
    }

    // ---- memory for arenas (mem::reserve, arena::alloc)

    #c_symbol{ name = "calloc" }
    extern fn c_calloc { mut mem: Mem, count: usize, size: usize } -> ?*mut u8

    // `size` bytes, a multiple of mem::PAGE, for an arena: zeroed and page-aligned. calloc gives
    // zeroed memory that the OS supplies on first use: it takes a big block from mmap without
    // clearing it. Null if there isn't enough memory.
    fn reserve { mut mem: Mem, size: usize } -> ?*mut u8 {
        if size > 18446744073709551615 - mem::PAGE { return null }
        let p = c_calloc{ &mem, count = 1, size = size + mem::PAGE } ifnull { return null }
        return p + (mem::PAGE - @addr(p) % mem::PAGE) % mem::PAGE
    }

    // Makes an arena's memory from first to last usable, which memory from `reserve` is here
    // from the start.
    fn commit { first: *u8, last: *u8 } -> bool {
        return true
    }

    // ---- for std's proc: programs, started by sys::spawn, with fork and exec on Linux and
    // posix_spawnp on macOS, and waited for with waitpid. A child's id is its process id, and
    // its group's, the process group's id, is the same; a pipe's id is its file descriptor.

    extern fn waitpid { mut proc: Proc, pid: i32, mut status: i32, options: i32 } -> i32
    extern fn sysconf { mut proc: Proc, name: i32 } -> i64
    extern fn getpid { mut proc: Proc } -> i32
    #c_symbol{ name = "kill" }
    extern fn c_kill { mut proc: Proc, pid: i32, signal: i32 } -> i32
    #c_symbol{ name = "read" }
    extern fn read_fd { mut proc: Proc, fd: i32, buf: *mut u8, count: usize } -> i64
    #c_symbol{ name = "write" }
    extern fn write_fd { mut proc: Proc, fd: i32, buf: *u8, count: usize } -> i64
    #c_symbol{ name = "close" }
    extern fn close_fd { mut proc: Proc, fd: i32 } -> i32
    #c_symbol{ name = "malloc" }
    extern fn c_malloc { mut proc: Proc, size: usize } -> ?*mut u8
    #c_symbol{ name = "free" }
    extern fn c_free { mut proc: Proc, p: *mut u8 }

    // The numbers Linux and macOS share: waitpid's option not to wait, SIGKILL, errno's, and
    // fcntl's command that sets a descriptor's flags, with its one flag.
    const WNOHANG: i32 = 1
    const SIGKILL: i32 = 9
    const EPERM: i32 = 1
    const ENOENT: i32 = 2
    const ESRCH: i32 = 3
    const EINTR: i32 = 4
    const EBADF: i32 = 9
    const F_SETFL: i32 = 4                                          // fcntl's: a descriptor's status flags, the same on Linux and macOS
    const EACCES: i32 = 13
    const EPIPE: i32 = 32
    const F_GETFD: i32 = 1
    const F_SETFD: i32 = 2
    const FD_CLOEXEC: i64 = 1
    const O_RDWR: i32 = 2

    // What sys::spawn's fds say of a stream that isn't put in place: the child's is this
    // program's own, or this program hasn't one open, and then the child hasn't either.
    const INHERITED: i32 = -1
    const CLOSED: i32 = -2

    // sys::await_exit's `nanoseconds` for waiting as long as it takes.
    const FOREVER: u64 = 18446744073709551615

    // What the C library searches for a program without PATH in the environment.
    const DEFAULT_PATH: []u8 = "/bin:/usr/bin"

    // Starts argv[0] as proc::spawn says, with this program's environment, less the entries
    // options.env replaces, and options.env's own. argv and options.env aren't empty and are
    // checked (proc::spawn). What the child needs is made first, since on Linux it can't
    // allocate (sys::spawn): in one block from malloc, the arrays of C strings, the directory,
    // and PATH, this program's, which execvp and posix_spawnp search for a program without a
    // '/' in its name, with room for each path tried; and the descriptors its standard streams
    // become.
    fn spawn { mut proc: Proc, argv: [][]u8, options: proc::Options } -> proc::Error!proc::Child {
        let extra = options.env
        let inherited = proc.environ
        let mut n: usize = 0
        if inherited != null {
            while (inherited + n).* != null { n = n + 1 }
        }
        let program = argv[0]
        let mut searched = true
        let mut i: usize = 0
        while i < program.len {
            if program[i] == '/' { searched = false }
            i = i + 1
        }
        let search = if searched { env{ &proc, name = "PATH" } ifnull DEFAULT_PATH } else { "" }
        let words = argv.len + 1 + n + extra.len + 1
        let mut size = words * 8 + options.dir.len + 1 + search.len + 1 + search.len + program.len + 2
        i = 0
        while i < argv.len { size = size + argv[i].len + 1; i = i + 1 }
        i = 0
        while i < extra.len { size = size + extra[i].len + 1; i = i + 1 }
        let block = c_malloc{ &proc, size } ifnull {
            rt::fail{ msg = "out of memory" }
            return proc::other{ code = 12 }
        }
        defer c_free{ &proc, p = block }
        let ptrs = @slice(@cast(*mut ?*u8, block), words)
        let mut text = block + words * 8
        i = 0
        while i < argv.len {
            ptrs[i] = text
            text = c_copy{ into = text, bytes = argv[i] }
            i = i + 1
        }
        ptrs[argv.len] = null
        let envp = argv.len + 1
        let mut k = envp
        i = 0
        while inherited != null and i < n {
            let entry = (inherited + i).* ifnull { break }
            if not proc::overridden{ entry = c::bytes{ s = entry }, env = extra } {
                ptrs[k] = entry
                k = k + 1
            }
            i = i + 1
        }
        i = 0
        while i < extra.len {
            ptrs[k] = text
            text = c_copy{ into = text, bytes = extra[i] }
            k = k + 1
            i = i + 1
        }
        ptrs[k] = null
        let file = ptrs[0] ifnull { return proc::not_found }
        let mut dir: ?*u8 = null
        if options.dir.len > 0 {
            dir = text
            text = c_copy{ into = text, bytes = options.dir }
        }
        let mut path: ?*u8 = null
        if searched {
            path = text
            text = c_copy{ into = text, bytes = search }
        }
        let scratch = text

        // What the child's descriptors 0, 1 and 2 become: INHERITED for this program's own, or
        // CLOSED for one that this program hasn't open, which the child hasn't either; this
        // program's ends of pipes, the Child's; and the descriptors made for the child, closed
        // once it has started, or hasn't: three for the streams, and three for those moved.
        //
        // Which of 0, 1 and 2 this program has open is asked first, before anything here takes
        // one that is free. Every descriptor made here goes above 2 (above), so that none sits
        // where the child's stream is this program's own, or is replaced when the child puts
        // its streams in place.
        let mut fds: [3]i32 = [INHERITED, INHERITED, INHERITED]
        let mut ours: [3]i32 = [-1, -1, -1]
        let mut made: [6]i32 = [-1, -1, -1, -1, -1, -1]
        let mut started = false
        defer close_all{ &proc, fds = made[..] }
        defer {
            if not started { close_all{ &proc, fds = ours[..] } }
        }
        let mut s: usize = 0
        while s < 3 {
            if sys::fcntl{ &proc, fd = @as(i32, s), cmd = F_GETFD, arg = 0 } < 0 { fds[s] = CLOSED }
            s = s + 1
        }
        s = 0
        while s < 3 {
            let stdio = if s == 0 { options.stdin } else if s == 1 { options.stdout } else { options.stderr }
            match stdio {
                inherit => {}
                ignore => {
                    let fd = above{ &proc, fd = sys::open_null{ &proc } }
                    if fd < 0 { return proc_failed{ code = sys::proc_errno{ &proc }.* } }
                    made[s] = fd
                    fds[s] = fd
                }
                pipe => {
                    let mut ends: [2]i32 = [-1, -1]
                    if sys::make_pipe{ &proc, fds = &ends[0] } != 0 { return proc_failed{ code = sys::proc_errno{ &proc }.* } }
                    let reads = above{ &proc, fd = ends[0] }
                    if reads < 0 {
                        let e = sys::proc_errno{ &proc }.*
                        _ = close_fd{ &proc, fd = ends[1] }
                        return proc_failed{ code = e }
                    }
                    let writes = above{ &proc, fd = ends[1] }
                    if writes < 0 {
                        let e = sys::proc_errno{ &proc }.*
                        _ = close_fd{ &proc, fd = reads }
                        return proc_failed{ code = e }
                    }
                    // The child reads its standard input, and writes its output and error.
                    let theirs = if s == 0 { reads } else { writes }
                    made[s] = theirs
                    ours[s] = if s == 0 { writes } else { reads }
                    // This program's end doesn't block: pipe_read and pipe_write poll it, with a
                    // task's cancel object (std/task.ctx).
                    if sys::fcntl{ &proc, fd = ours[s], cmd = F_SETFL, arg = sys::O_NONBLOCK } < 0 { return proc_failed{ code = sys::proc_errno{ &proc }.* } }
                    fds[s] = theirs
                }
                file{ file } => {
                    fds[s] = descriptor{ file = file.id } ifnull { return proc_failed{ code = EBADF } }
                }
            }
            s = s + 1
        }
        // A file's descriptor below 3 that is to become another stream is copied above them,
        // so that putting one in place can't replace another still to be put.
        s = 0
        while s < 3 {
            let fd = fds[s]
            if fd >= 0 and fd < 3 and fd != @as(i32, s) {
                let moved = sys::fcntl{ &proc, fd, cmd = sys::F_DUPFD_CLOEXEC, arg = 3 }
                if moved < 0 { return proc_failed{ code = sys::proc_errno{ &proc }.* } }
                made[3 + s] = moved
                fds[s] = moved
            }
            s = s + 1
        }

        let pid = try sys::spawn{ &proc, file, argv = ptrs.ptr, envp = ptrs.ptr + envp, path, scratch, fds = &fds[0], dir, group = options.group, die_with_parent = options.die_with_parent }
        started = true
        let id = @as(u64, pid)
        return proc::Child{
            id,
            group = if options.group { id } else { 0 },
            cleanup = if options.group and options.leftovers is kill { id } else { 0 },
            stdin = pipe_of{ fd = ours[0] },
            stdout = pipe_of{ fd = ours[1] },
            stderr = pipe_of{ fd = ours[2] },
        }
    }

    // bytes and a zero at into; returns where they end.
    fn c_copy { into: *mut u8, bytes: []u8 } -> *mut u8 {
        let mut i: usize = 0
        while i < bytes.len {
            (into + i).* = bytes[i]
            i = i + 1
        }
        (into + bytes.len).* = 0
        return into + (bytes.len + 1)
    }

    // fd, or a copy of it above 2 that exec closes, if it is 0, 1 or 2, which it then closes:
    // so that a descriptor proc makes is never one of a child's standard streams. -1, and
    // errno, if fd is, or if it can't be copied.
    fn above { mut proc: Proc, fd: i32 } -> i32 {
        if fd < 0 or fd > 2 { return fd }
        let moved = sys::fcntl{ &proc, fd, cmd = sys::F_DUPFD_CLOEXEC, arg = 3 }
        let e = sys::proc_errno{ &proc }.*
        _ = close_fd{ &proc, fd }
        sys::proc_errno{ &proc }.* = e
        return moved
    }

    // Closes each of fds that is a descriptor, not -1.
    fn close_all { mut proc: Proc, fds: []i32 } {
        let mut i: usize = 0
        while i < fds.len {
            if fds[i] >= 0 { _ = close_fd{ &proc, fd = fds[i] } }
            i = i + 1
        }
    }

    // A pipe of descriptor fd, or null for -1.
    fn pipe_of { fd: i32 } -> ?proc::Pipe {
        if fd < 0 { return null }
        return proc::Pipe{ id = @as(u64, fd) }
    }

    // Waits for a child to end: its exit code, or 128 + N if signal N killed it. A child whose
    // `cleanup` is its process group has the group ended first (end_leftovers).
    //
    // An interruptible wait in a task waits on the child and the task's cancel object, and fails
    // with task::cancelled when the task is asked to stop; under a deadline it waits until then,
    // and fails with task::deadline_passed. Either leaves the child as it was.
    fn wait { mut proc: Proc, mut cancel: task::Cancel, child: proc::Child, interruptible: bool } -> proc::Error!i32 {
        let pid = @as(i32, child.id)
        let stoppable = interruptible and task::can_stop{ &cancel }
        if stoppable {
            try task::check{ &cancel }
            let object = task::get_cancel_object{ &cancel }
            while true {
                let r = try sys::await_exit{ &proc, pid, nanoseconds = task::get_time_left{ &cancel }, cancel = object }
                if r == STOPPED { return task::cancelled }
                if r == EXITED { break }
                try task::check{ &cancel }
            }
        }
        if child.cleanup != 0 {
            if not stoppable { _ = try sys::await_exit{ &proc, pid, nanoseconds = FOREVER, cancel = 0 } }
            try end_leftovers{ &proc, group = child.cleanup }
        }
        let code = try reap{ &proc, pid, options = 0 }
        return code ifnull 255
    }

    // Waits for a child to end, for at most `nanoseconds`: its exit code, or null if it is still
    // running. It looks without waiting first, and then waits for the child itself, as
    // sys::await_exit does, rather than looking again and again. Once that says the child has
    // ended, waitpid waits: macOS may say so a moment before waitpid can reap it, and waitpid
    // never waits long for a child that has ended. A child whose `cleanup` is its group is
    // looked at without reaping it, as wait does.
    fn wait_for { mut proc: Proc, mut cancel: task::Cancel, child: proc::Child, nanoseconds: u64 } -> proc::Error!?i32 {
        try task::check{ &cancel }
        let pid = @as(i32, child.id)
        if child.cleanup != 0 {
            if not try await_exit_within{ &proc, &cancel, pid, nanoseconds } { return null }
            try end_leftovers{ &proc, group = child.cleanup }
            return try reap{ &proc, pid, options = 0 }
        }
        let code = try reap{ &proc, pid, options = WNOHANG }
        if code != null or nanoseconds == 0 { return code }
        if not try await_exit_within{ &proc, &cancel, pid, nanoseconds } { return null }
        return try reap{ &proc, pid, options = 0 }
    }

    // Waits for child pid to end (sys::await_exit), for at most `nanoseconds`, in a task with
    // its cancel object, and until the calling thread's deadline: whether it ended, or
    // task::cancelled or task::deadline_passed.
    fn await_exit_within { mut proc: Proc, mut cancel: task::Cancel, pid: i32, nanoseconds: u64 } -> proc::Error!bool {
        let object = task::get_cancel_object{ &cancel }
        let until = deadline{ &proc, nanoseconds }
        while true {
            let r = try sys::await_exit{ &proc, pid, nanoseconds = @min(remaining{ &proc, deadline = until }, task::get_time_left{ &cancel }), cancel = object }
            if r == STOPPED { return task::cancelled }
            if r == EXITED { return true }
            try task::check{ &cancel }
            if remaining{ &proc, deadline = until } == 0 { return false }
        }
        return false
    }

    // waitpid for child pid, with `options`: its exit code once it has ended, which reaps it;
    // null with WNOHANG while it hasn't.
    fn reap { mut proc: Proc, pid: i32, options: i32 } -> proc::Error!?i32 {
        let mut status: i32 = 0
        while true {
            let r = waitpid{ &proc, pid, status = &status, options }
            if r > 0 { break }
            if r == 0 { return null }
            let e = sys::proc_errno{ &proc }.*
            if e != EINTR { return proc_failed{ code = e } }       // EINTR: wait again
        }
        return exit_code{ status }
    }

    // waitpid's status as an exit code: the child's own, or 128 + N if signal N killed it. It is
    // decoded as WIFEXITED and the rest are, the same on Linux and macOS.
    fn exit_code { status: i32 } -> i32 {
        let signal = status & 127
        if signal == 0 { return (status >> 8) & 255 }
        if signal != 127 { return 128 + signal }
        return 255
    }

    // SIGKILL to a child, or to its whole process group: a pid below 0 names a group. A child
    // that has ended still has its id until it is waited for; ESRCH, that it has none, is a
    // child that is gone already.
    fn kill { mut proc: Proc, child: proc::Child } -> proc::Error! {
        let target = if child.group != 0 { 0 - @as(i32, child.group) } else { @as(i32, child.id) }
        if c_kill{ &proc, pid = target, signal = SIGKILL } != 0 {
            let e = sys::proc_errno{ &proc }.*
            if e != ESRCH { return proc_failed{ code = e } }
        }
    }

    // SIGKILL to what is left of a child's process group, once the child, its leader, has ended
    // but before it is reaped: until then its pid, which is the group's id, can't be another
    // process's, so the signal can't reach a group that has taken the number since. ESRCH is a
    // group with nothing left in it.
    fn end_leftovers { mut proc: Proc, group: u64 } -> proc::Error! {
        if c_kill{ &proc, pid = 0 - @as(i32, group), signal = SIGKILL } != 0 {
            let e = sys::proc_errno{ &proc }.*
            if e != ESRCH { return proc_failed{ code = e } }
        }
    }

    // Reads at most into.len bytes, which aren't none. Returns how many; 0 at the end.
    // This program's end of the pipe doesn't block (spawn): when it has nothing, ready waits,
    // in a task with its cancel object too.
    fn pipe_read { mut proc: Proc, mut cancel: task::Cancel, pipe: u64, into: []mut u8 } -> proc::Error!usize {
        try task::check{ &cancel }
        let fd = descriptor{ file = pipe } ifnull { return proc_failed{ code = EBADF } }
        while true {
            let n = read_fd{ &proc, fd, buf = into.ptr, count = into.len }
            if n >= 0 { return @as(usize, n) }
            let e = sys::proc_errno{ &proc }.*
            if e == sys::EAGAIN {
                try ready{ &proc, &cancel, fd, events = POLLIN }
            } else if e != EINTR {
                return proc_failed{ code = e }
            }
        }
    }

    // Writes some of `bytes`, which aren't none. Returns how many; EPIPE, broken_pipe, once the
    // reader has closed its end.
    fn pipe_write { mut proc: Proc, mut cancel: task::Cancel, pipe: u64, bytes: []u8 } -> proc::Error!usize {
        try task::check{ &cancel }
        let fd = descriptor{ file = pipe } ifnull { return proc_failed{ code = EBADF } }
        while true {
            let n = write_fd{ &proc, fd, buf = bytes.ptr, count = bytes.len }
            if n >= 0 { return @as(usize, n) }
            let e = sys::proc_errno{ &proc }.*
            if e == sys::EAGAIN {
                try ready{ &proc, &cancel, fd, events = POLLOUT }
            } else if e != EINTR {
                return proc_failed{ code = e }
            }
        }
    }

    fn pipe_close { mut proc: Proc, pipe: u64 } {
        let fd = descriptor{ file = pipe } ifnull { return }
        _ = close_fd{ &proc, fd }
    }

    // How many processors this program may run on: at least 1.
    fn processors { mut proc: Proc } -> u32 {
        let n = sysconf{ &proc, name = sys::SC_NPROCESSORS_ONLN }
        return if n > 0 and n < 4294967296 { @as(u32, n) } else { 1 }
    }

    fn exe_path { mut proc: Proc } -> []u8 {
        return sys::exe_path{ &proc }
    }

    // The error for errno `code` from starting a program, waiting for it, ending it, or using
    // its pipes.
    fn proc_failed(T) { code: i32 } -> !T {
        if code == ENOENT { return proc::not_found }
        if code == EPERM or code == EACCES { return proc::permission_denied }
        if code == EPIPE { return proc::broken_pipe }
        return proc::other{ code = @as(i64, code) }
    }

    // A time on the monotonic clock, in nanoseconds: `nanoseconds` from now, or the furthest
    // there is.
    fn deadline { mut proc: Proc, nanoseconds: u64 } -> u64 {
        let now = monotonic{ &proc }
        let max: u64 = 18446744073709551615
        return if nanoseconds > max - now { max } else { now + nanoseconds }
    }

    // The nanoseconds from now until `deadline`; 0 once it has passed.
    fn remaining { mut proc: Proc, deadline: u64 } -> u64 {
        let now = monotonic{ &proc }
        return if deadline > now { deadline - now } else { 0 }
    }

    // Now, on the monotonic clock, in nanoseconds. Reading the clock takes a capability: a wait
    // for a child holds Proc.
    fn monotonic { mut proc: Proc } -> u64 {
        let mut now = Timespec{ sec = 0, nsec = 0 }
        _ = proc_clock_gettime{ &proc, clock = sys::CLOCK_MONOTONIC, &now }
        return @as(u64, now.sec) * 1000000000 + @as(u64, now.nsec)
    }

    #c_symbol{ name = "clock_gettime" }
    extern fn proc_clock_gettime { mut proc: Proc, clock: i32, mut now: Timespec } -> i32

    // nanoseconds in milliseconds, rounded up, as a poll's timeout takes them: at most
    // 2147483647, about 24 days, after which it is called again.
    fn poll_millis { nanoseconds: u64 } -> i32 {
        let ms = nanoseconds / 1000000 + (if nanoseconds % 1000000 > 0 { 1 } else { 0 })
        return if ms > 2147483647 { 2147483647 } else { @as(i32, ms) }
    }

    // `path` with a zero after it, as C takes it, in buf; null if it doesn't fit.
    fn c_path { path: []u8, buf: []mut u8 } -> ?*u8 {
        if path.len >= buf.len { return null }
        slice::copy(u8){ dst = buf[..path.len], src = path }
        buf[path.len] = 0
        return buf.ptr
    }

    // Whether there is a directory at `path`: opendir needs no layout of struct stat.
    fn is_dir { mut fs: Fs, path: *u8 } -> bool {
        let d = opendir{ &fs, path }
        if d == 0 { return false }
        _ = closedir{ &fs, dir = d }
        return true
    }

    // A File's id as a descriptor; null if it can't be one.
    fn descriptor { file: u64 } -> ?i32 {
        if file > 2147483647 { return null }
        return @as(i32, file)
    }

    // The error for errno `code`: their numbers are the same on Linux and macOS.
    fn failed(T) { code: i32 } -> !T {
        if code == 2 { return fs::not_found }                       // ENOENT
        if code == 1 or code == 13 { return fs::permission_denied } // EPERM, EACCES
        if code == 21 { return fs::is_directory }                   // EISDIR
        if code == 17 { return fs::exists }                         // EEXIST
        if code == 20 { return fs::not_directory }                  // ENOTDIR
        if code == sys::ENOTEMPTY { return fs::not_empty }
        if code == 9 { return fs::bad_file }                        // EBADF
        return fs::other{ code = @as(i64, code) }
    }

    // ---- sockets, for std's net: a Socket's or a Listener's id is its file descriptor.
    //
    // Every socket is made non-blocking, and exec closes it: SOCK_NONBLOCK and SOCK_CLOEXEC on
    // Linux, fcntl on macOS (sys::make_socket, sys::accept_socket). A call that would wait polls
    // the descriptor with the calling task's cancel object, until the calling thread's deadline,
    // instead (net_ready), so a task asked to stop fails with task::cancelled, and a call past
    // its deadline with task::deadline_passed, having done nothing. A send never raises SIGPIPE:
    // Linux sends with MSG_NOSIGNAL, and macOS sets SO_NOSIGPIPE on each socket.

    // What std's Net holds on Linux and macOS: nothing, since sockets are the C library's.
    capability Net

    #c_symbol{ name = "socket" }
    extern fn c_socket { mut net: Net, domain: i32, kind: i32, protocol: i32 } -> i32
    #c_symbol{ name = "connect" }
    extern fn c_connect { mut net: Net, fd: i32, addr: *SockAddr, size: u32 } -> i32
    #c_symbol{ name = "bind" }
    extern fn c_bind { mut net: Net, fd: i32, addr: *SockAddr, size: u32 } -> i32
    #c_symbol{ name = "listen" }
    extern fn c_listen { mut net: Net, fd: i32, backlog: i32 } -> i32
    #c_symbol{ name = "recv" }
    extern fn c_recv { mut net: Net, fd: i32, buf: *mut u8, count: usize, flags: i32 } -> i64
    #c_symbol{ name = "send" }
    extern fn c_send { mut net: Net, fd: i32, buf: *u8, count: usize, flags: i32 } -> i64
    #c_symbol{ name = "shutdown" }
    extern fn c_shutdown { mut net: Net, fd: i32, how: i32 } -> i32
    #c_symbol{ name = "close" }
    extern fn net_close_fd { mut net: Net, fd: i32 } -> i32
    extern fn getsockname { mut net: Net, fd: i32, mut addr: SockAddr, mut size: u32 } -> i32
    extern fn getpeername { mut net: Net, fd: i32, mut addr: SockAddr, mut size: u32 } -> i32
    extern fn setsockopt { mut net: Net, fd: i32, level: i32, name: i32, value: *i32, size: u32 } -> i32
    extern fn getsockopt { mut net: Net, fd: i32, level: i32, name: i32, mut value: i32, mut size: u32 } -> i32
    #c_symbol{ name = "poll" }
    extern fn poll_net { mut net: Net, fds: *mut PollFd, count: u64, ms: i32 } -> i32

    // A struct sockaddr_storage: room for any socket address, aligned as C's. sockaddr_in and
    // sockaddr_in6 are written into its bytes: a family (sys::put_family, where Linux and macOS
    // differ), then the port in network order at 2, and an IPv4 address at 4, or an IPv6 one's
    // flow label at 4, its address at 8 and its scope at 24, in the host's order.
    struct SockAddr { words: [16]u64 }

    // An address as a sockaddr, its length, and its family (AF_INET, AF_INET6).
    struct Endpoint { sa: SockAddr, size: u32, family: i32 }

    // The numbers Linux and macOS share for sockets: IPv4, a stream socket and TCP; IPv6's level
    // for setsockopt; TCP_NODELAY; shutdown's directions; errno's for too many descriptors.
    const AF_INET: i32 = 2
    const SOCK_STREAM: i32 = 1
    const IPPROTO_TCP: i32 = 6
    const IPPROTO_IPV6: i32 = 41
    const TCP_NODELAY: i32 = 1
    const SHUT_RD: i32 = 0
    const SHUT_WR: i32 = 1
    const SHUT_RDWR: i32 = 2
    const ENFILE: i32 = 23
    const EMFILE: i32 = 24

    // listen's backlog for the system's most: Linux and macOS cut a larger one to their limit
    // (net.core.somaxconn, kern.ipc.somaxconn), which C's SOMAXCONN only guesses at.
    const BACKLOG_MOST: i32 = 2147483647

    fn tcp_connect { mut net: Net, mut cancel: task::Cancel, address: net::Address } -> net::Error!u64 {
        try task::check{ &cancel }
        let to = endpoint_of{ address }
        let fd = sys::make_socket{ &net, family = to.family }
        if fd < 0 { return net_failed{ code = sys::net_errno{ &net }.* } }
        let mut connected = false
        defer {
            if not connected { _ = net_close_fd{ &net, fd } }
        }
        if c_connect{ &net, fd, addr = &to.sa, size = to.size } != 0 {
            // A connect that EINTR interrupted goes on without the call, as one in progress does.
            let e = sys::net_errno{ &net }.*
            if e != sys::EINPROGRESS and e != EINTR { return net_failed{ code = e } }
            try net_ready{ &net, &cancel, fd, events = POLLOUT }
            let mut failure: i32 = 0
            let mut size: u32 = 4
            if getsockopt{ &net, fd, level = sys::SOL_SOCKET, name = sys::SO_ERROR, value = &failure, &size } != 0 { return net_failed{ code = sys::net_errno{ &net }.* } }
            if failure != 0 { return net_failed{ code = failure } }
        }
        connected = true
        return @as(u64, fd)
    }

    fn tcp_listen { mut net: Net, address: net::Address, backlog: u32 } -> net::Error!u64 {
        let at = endpoint_of{ address }
        let fd = sys::make_socket{ &net, family = at.family }
        if fd < 0 { return net_failed{ code = sys::net_errno{ &net }.* } }
        let mut listening = false
        defer {
            if not listening { _ = net_close_fd{ &net, fd } }
        }
        try set_option{ &net, fd, level = sys::SOL_SOCKET, name = sys::SO_REUSEADDR, value = 1 }
        if address.ip is v6 { try set_option{ &net, fd, level = IPPROTO_IPV6, name = sys::IPV6_V6ONLY, value = 1 } }
        if c_bind{ &net, fd, addr = &at.sa, size = at.size } != 0 { return net_failed{ code = sys::net_errno{ &net }.* } }
        let most = if backlog == 0 or backlog > 2147483647 { BACKLOG_MOST } else { @as(i32, backlog) }
        if c_listen{ &net, fd, backlog = most } != 0 { return net_failed{ code = sys::net_errno{ &net }.* } }
        listening = true
        return @as(u64, fd)
    }

    // Waits for a connection on `listener`, polling it while it has none. `family` is Windows'.
    fn tcp_accept { mut net: Net, mut cancel: task::Cancel, listener: u64, family: u8 } -> net::Error!u64 {
        try task::check{ &cancel }
        let fd = descriptor{ file = listener } ifnull { return net_failed{ code = EBADF } }
        while true {
            let s = sys::accept_socket{ &net, fd }
            if s >= 0 { return @as(u64, s) }
            let e = sys::net_errno{ &net }.*
            if e == sys::EAGAIN {
                try net_ready{ &net, &cancel, fd, events = POLLIN }
            } else if e != EINTR and not sys::accept_again{ code = e } {
                return net_failed{ code = e }
            }
        }
    }

    // Receives at most into.len bytes, which aren't none. Returns how many; 0 once the peer
    // has finished sending.
    fn tcp_receive { mut net: Net, mut cancel: task::Cancel, socket: u64, into: []mut u8 } -> net::Error!usize {
        try task::check{ &cancel }
        let fd = descriptor{ file = socket } ifnull { return net_failed{ code = EBADF } }
        while true {
            let n = c_recv{ &net, fd, buf = into.ptr, count = into.len, flags = 0 }
            if n >= 0 { return @as(usize, n) }
            let e = sys::net_errno{ &net }.*
            if e == sys::EAGAIN {
                try net_ready{ &net, &cancel, fd, events = POLLIN }
            } else if e != EINTR {
                return net_failed{ code = e }
            }
        }
    }

    // Sends some of `bytes`, which aren't none. Returns how many.
    fn tcp_send { mut net: Net, mut cancel: task::Cancel, socket: u64, bytes: []u8 } -> net::Error!usize {
        try task::check{ &cancel }
        let fd = descriptor{ file = socket } ifnull { return net_failed{ code = EBADF } }
        while true {
            let n = c_send{ &net, fd, buf = bytes.ptr, count = bytes.len, flags = sys::MSG_NOSIGNAL }
            if n >= 0 { return @as(usize, n) }
            let e = sys::net_errno{ &net }.*
            if e == sys::EAGAIN {
                try net_ready{ &net, &cancel, fd, events = POLLOUT }
            } else if e != EINTR {
                return net_failed{ code = e }
            }
        }
    }

    fn tcp_shutdown { mut net: Net, socket: u64, how: net::Shutdown } -> net::Error! {
        let fd = descriptor{ file = socket } ifnull { return net_failed{ code = EBADF } }
        let h = match how { send => { SHUT_WR } receive => { SHUT_RD } both => { SHUT_RDWR } }
        if c_shutdown{ &net, fd, how = h } != 0 { return net_failed{ code = sys::net_errno{ &net }.* } }
    }

    // Closes a socket or a listener. close's EINTR isn't tried again: the descriptor is gone
    // whatever close says, on Linux and macOS.
    fn tcp_close { mut net: Net, socket: u64 } {
        let fd = descriptor{ file = socket } ifnull { return }
        _ = net_close_fd{ &net, fd }
    }

    // The socket's own address, or with `peer` the other end's.
    fn tcp_get_address { mut net: Net, socket: u64, peer: bool } -> net::Error!net::Address {
        let fd = descriptor{ file = socket } ifnull { return net_failed{ code = EBADF } }
        let mut sa = SockAddr{ words = [0; 16] }
        let mut size: u32 = 128                     // sockaddr_storage's
        let r = if peer { getpeername{ &net, fd, addr = &sa, &size } } else { getsockname{ &net, fd, addr = &sa, &size } }
        if r != 0 { return net_failed{ code = sys::net_errno{ &net }.* } }
        return address_of{ sa }
    }

    fn tcp_set_no_delay { mut net: Net, socket: u64, on: bool } -> net::Error! {
        let fd = descriptor{ file = socket } ifnull { return net_failed{ code = EBADF } }
        try set_option{ &net, fd, level = IPPROTO_TCP, name = TCP_NODELAY, value = if on { 1 } else { 0 } }
    }

    fn tcp_set_keep_alive { mut net: Net, socket: u64, idle_seconds: u32 } -> net::Error! {
        let fd = descriptor{ file = socket } ifnull { return net_failed{ code = EBADF } }
        if idle_seconds == 0 {
            try set_option{ &net, fd, level = sys::SOL_SOCKET, name = sys::SO_KEEPALIVE, value = 0 }
            return
        }
        let idle = if idle_seconds > 2147483647 { 2147483647 } else { @as(i32, idle_seconds) }
        try set_option{ &net, fd, level = IPPROTO_TCP, name = sys::KEEPALIVE_IDLE, value = idle }
        try set_option{ &net, fd, level = sys::SOL_SOCKET, name = sys::SO_KEEPALIVE, value = 1 }
    }

    // setsockopt of an int option.
    fn set_option { mut net: Net, fd: i32, level: i32, name: i32, value: i32 } -> net::Error! {
        if setsockopt{ &net, fd, level, name, value = &value, size = 4 } != 0 { return net_failed{ code = sys::net_errno{ &net }.* } }
    }

    // Waits until socket fd has `events`; in a task, until its cancel object is signalled, and
    // then fails with task::cancelled; and until the calling thread's deadline, if it has one,
    // and then fails with task::deadline_passed. A socket with an error is ready too, and the
    // call that tries it again gets the error. Evented's loop replaces this.
    fn net_ready { mut net: Net, mut cancel: task::Cancel, fd: i32, events: i16 } -> net::Error! {
        let object = task::get_cancel_object{ &cancel }
        let mut fds: [2]PollFd = [PollFd{ fd, events, revents = 0 }, PollFd{ fd = if object != 0 { @as(i32, object) } else { -1 }, events = POLLIN, revents = 0 }]
        while true {
            let r = poll_net{ &net, fds = &fds[0], count = 2, ms = deadline_poll_millis{ &cancel } }
            if r > 0 {
                if fds[1].revents != 0 { return task::cancelled }
                return
            }
            if r == 0 { try task::check{ &cancel } }
            if r < 0 {
                let e = sys::net_errno{ &net }.*
                if e != EINTR { return net_failed{ code = e } }
            }
        }
    }

    // `address` as a sockaddr_in or sockaddr_in6.
    fn endpoint_of { address: net::Address } -> Endpoint {
        let mut sa = SockAddr{ words = [0; 16] }
        let b = @slice(@cast(*mut u8, &sa), @size_of(SockAddr))
        b[2] = @trunc(u8, address.port >> 8)
        b[3] = @trunc(u8, address.port)
        match address.ip {
            v4{ octets } => {
                sys::put_family{ b, family = AF_INET, size = 16 }
                slice::copy(u8){ dst = b[4..8], src = octets[..] }
                return Endpoint{ sa, size = 16, family = AF_INET }
            }
            v6{ octets, scope } => {
                sys::put_family{ b, family = sys::AF_INET6, size = 28 }
                slice::copy(u8){ dst = b[8..24], src = octets[..] }
                @cast(*mut u32, b.ptr + 24).* = scope
                return Endpoint{ sa, size = 28, family = sys::AF_INET6 }
            }
        }
    }

    // The address in a sockaddr the system wrote.
    fn address_of { sa: SockAddr } -> net::Error!net::Address {
        let b = @slice(@cast(*u8, &sa), @size_of(SockAddr))
        let port = (@as(u16, b[2]) << 8) | @as(u16, b[3])
        let family = sys::family_of{ b }
        if family == AF_INET {
            return net::Address{ ip = net::Ip::v4{ octets = [b[4], b[5], b[6], b[7]] }, port }
        }
        if family == sys::AF_INET6 {
            let mut octets: [16]u8
            slice::copy(u8){ dst = octets[..], src = b[8..24] }
            return net::Address{ ip = net::Ip::v6{ octets, scope = @cast(*u32, b.ptr + 24).* }, port }
        }
        return net::unsupported_address
    }

    // The error for errno `code` from a socket call. Linux's and macOS's numbers for sockets
    // differ, so most are sys's.
    fn net_failed(T) { code: i32 } -> !T {
        if code == sys::ECONNREFUSED { return net::refused }
        if code == sys::ECONNRESET { return net::reset }
        if code == sys::ECONNABORTED { return net::aborted }
        if code == EPIPE or code == sys::ENOTCONN { return net::closed }
        if code == sys::ENETUNREACH or code == sys::EHOSTUNREACH or code == sys::ENETDOWN or code == sys::EHOSTDOWN { return net::unreachable }
        if code == sys::ETIMEDOUT { return net::timed_out }
        if code == sys::EADDRINUSE { return net::address_in_use }
        if code == sys::EADDRNOTAVAIL { return net::address_unavailable }
        if code == sys::EAFNOSUPPORT { return net::unsupported_address }
        if code == EACCES or code == EPERM { return net::permission_denied }
        if code == EMFILE or code == ENFILE or code == sys::ENOBUFS { return net::too_many_open }
        if code == sys::EMSGSIZE { return net::message_too_large }
        return net::other{ code = @as(i64, code) }
    }

    // ---- the console's and the system's requests to stop, for std's stop: SIGINT and SIGTERM,
    // caught with sigaction the first time a program waits or asks, unless they were ignored.
    //
    // A signal handler may run on any thread of the program, between any two instructions, so
    // it does only what is async-signal-safe: it keeps the first request with a compare and
    // exchange, puts both signals back to their default action with sigaction, and signals an
    // object the waits poll, as a task's cancel object is (sys::stop_make: an eventfd on Linux,
    // a pipe on macOS), with write; errno is kept around it. The object is never read, so once
    // signalled it stays readable, and every later wait returns at once. A request after the
    // first gets the default action, which ends the program at once: one that reaches the
    // handler while the first is being kept puts the defaults back itself and raises its signal
    // again, which the handler's mask holds until it returns. SA_RESTART lets the program's
    // other calls go on through a handler that interrupted them; poll, which never restarts,
    // is called again after EINTR. Linux and macOS give both signals the same numbers.

    // What std's Stop holds on Linux and macOS: whether the handler is installed (0, 1 while it
    // is being, 2), what the program was asked (stop::INTERRUPT or TERMINATE, 0 until then), the
    // object signalled once it has been, and the signals the handler was installed for, as bits
    // (1 << SIGINT, 1 << SIGTERM), which a request puts back to their default action.
    capability Stop {
        static ready: u32,
        static asked: u32,
        static object: u64,
        static caught: u32,
    }

    #c_symbol{ name = "poll" }
    extern fn poll_stop { mut stop: Stop, fds: *mut PollFd, count: u64, ms: i32 } -> i32
    #c_symbol{ name = "clock_gettime" }
    extern fn stop_clock_gettime { mut stop: Stop, clock: i32, mut now: Timespec } -> i32
    #c_symbol{ name = "raise" }
    extern fn stop_raise { mut stop: Stop, signal: i32 } -> i32

    const SIGINT: i32 = 2
    const SIGTERM: i32 = 15

    // sigaction's handler for a signal that is ignored, SIG_IGN, as the bits sys::OldAction reads.
    const SIG_IGN: u64 = 1

    // Waits until the program is asked to stop, for at most `nanoseconds` (stop::FOREVER for as
    // long as it takes): what it was asked, or 0 if it wasn't by then. In a task, the task's
    // cancel object is polled too, and a deadline bounds the wait (deadline_poll_millis).
    fn stop_wait { mut stop: Stop, mut cancel: task::Cancel, nanoseconds: u64 } -> stop::Error!u32 {
        try begin_stop{ &stop }
        try task::check{ &cancel }
        let object = task::get_cancel_object{ &cancel }
        let mine = @as(i32, event_waitable{ event = @atomic_load_acquire(&stop.object) })
        let mut fds: [2]PollFd = [PollFd{ fd = mine, events = POLLIN, revents = 0 }, PollFd{ fd = if object != 0 { @as(i32, object) } else { -1 }, events = POLLIN, revents = 0 }]
        let start = stop_now{ &stop }
        while true {
            let mut own: i32 = -1
            if nanoseconds != stop::FOREVER {
                let spent = stop_now{ &stop } - start
                own = if spent >= nanoseconds { 0 } else { poll_millis{ nanoseconds = nanoseconds - spent } }
            }
            let until = deadline_poll_millis{ &cancel }
            let ms = if own < 0 { until } else if until < 0 { own } else { @min(own, until) }
            let r = poll_stop{ &stop, fds = &fds[0], count = 2, ms }
            if r > 0 {
                if fds[0].revents != 0 { return @atomic_load_acquire(&stop.asked) }
                return task::cancelled
            }
            if r == 0 {
                try task::check{ &cancel }
                if own == 0 { return 0 }
            }
            if r < 0 {
                let e = sys::stop_errno{ &stop }.*
                if e != EINTR { return stop::other{ code = @as(i64, e) } }
            }
        }
    }

    // Asks the program to stop, as the handler does for a signal: the first request is kept.
    fn stop_ask { mut stop: Stop, code: u32 } -> stop::Error! {
        try begin_stop{ &stop }
        _ = record_stop{ &stop, code }
    }

    // Makes the object and installs the handler, once in the program's life: the first caller
    // does it while the others wait, and one that fails leaves it to the next.
    fn begin_stop { mut stop: Stop } -> stop::Error! {
        while true {
            let state = @atomic_load_acquire(&stop.ready)
            if state == 2 { return }
            if state == 0 and @atomic_compare_exchange_acquire_release(&stop.ready, 0, 1) == null {
                let code = install_stop{ &stop }
                if code != 0 {
                    @atomic_store_release(&stop.ready, 0)
                    return stop::other{ code = @as(i64, code) }
                }
                @atomic_store_release(&stop.ready, 2)
                return
            }
        }
    }

    // The object, then the handler for each signal that isn't ignored: 0, or errno. A signal's
    // bit in `caught` is set before its handler is, so that a request that comes at once puts
    // it back too. After a failure, the next try keeps what this one made and installed.
    fn install_stop { mut stop: Stop } -> i32 {
        if @atomic_load_acquire(&stop.object) == 0 {
            let object = sys::stop_make{ &stop }
            if object == 0 { return sys::stop_errno{ &stop }.* }
            @atomic_store_release(&stop.object, object)
        }
        let signals: [2]i32 = [SIGINT, SIGTERM]
        let mut caught = @atomic_load_acquire(&stop.caught)
        let mut i: usize = 0
        while i < 2 {
            let s = signals[i]
            let mut old: sys::OldAction
            if sys::read_action{ &stop, signal = s, old = &old } != 0 { return sys::stop_errno{ &stop }.* }
            if old.handler != SIG_IGN {
                @atomic_store_release(&stop.caught, caught | (@as(u32, 1) << @as(u32, s)))
                let action = sys::make_action{ handler = on_signal }
                if sys::set_action{ &stop, signal = s, action = &action, old = null } != 0 {
                    let e = sys::stop_errno{ &stop }.*
                    @atomic_store_release(&stop.caught, caught)
                    return e
                }
                caught = @atomic_load_acquire(&stop.caught)
            }
            i = i + 1
        }
        return 0
    }

    // Keeps `code` as what the program was asked, if it hasn't been asked yet, puts the signals
    // the handler catches back to their default action, and signals the object: whether it was
    // the first request. Async-signal-safe, for the handler.
    fn record_stop { mut stop: Stop, code: u32 } -> bool {
        if @atomic_compare_exchange_acquire_release(&stop.asked, 0, code) != null { return false }
        release_signals{ &stop }
        sys::stop_signal{ &stop, object = @atomic_load_acquire(&stop.object) }
        return true
    }

    // Puts each signal the handler catches back to its default action.
    fn release_signals { mut stop: Stop } {
        let caught = @atomic_load_acquire(&stop.caught)
        let none = sys::make_action{ handler = null }
        if caught & (@as(u32, 1) << @as(u32, SIGINT)) != 0 { _ = sys::set_action{ &stop, signal = SIGINT, action = &none, old = null } }
        if caught & (@as(u32, 1) << @as(u32, SIGTERM)) != 0 { _ = sys::set_action{ &stop, signal = SIGTERM, action = &none, old = null } }
    }

    // The signal handler (above). C passes no capability to a callback that any thread calls
    // (spec §18, Callbacks, rule 6), but this one is the layer's own, which only install_stop,
    // holding a Stop, hands to the system: so it makes one, as task::begin does, since a
    // capability without fields is no bytes (spec §15, rule 4).
    #c_callback{ any_thread = true }
    fn on_signal { signal: i32 } {
        let none: u8 = 0
        let mut stop = @cast(*Stop, &none).*
        let saved = sys::stop_errno{ &stop }.*
        let code = if signal == SIGINT { stop::INTERRUPT } else { stop::TERMINATE }
        if not record_stop{ &stop, code } {
            release_signals{ &stop }
            _ = stop_raise{ &stop, signal }
        }
        sys::stop_errno{ &stop }.* = saved
    }

    // Now, on the monotonic clock, in nanoseconds.
    fn stop_now { mut stop: Stop } -> u64 {
        let mut t = Timespec{ sec = 0, nsec = 0 }
        _ = stop_clock_gettime{ &stop, clock = sys::CLOCK_MONOTONIC, now = &t }
        return @as(u64, t.sec) * 1000000000 + @as(u64, t.nsec)
    }

    // ---- for std's clock: clock_gettime

    // What std's Clock holds on Linux and macOS: nothing.
    capability Clock

    #c_symbol{ name = "clock_gettime" }
    extern fn clock_read { mut clock: Clock, clock_id: i32, mut now: Timespec } -> i32

    fn clock_monotonic { mut clock: Clock } -> u64 {
        let mut t = Timespec{ sec = 0, nsec = 0 }
        _ = clock_read{ &clock, clock_id = sys::CLOCK_MONOTONIC, now = &t }
        return @as(u64, t.sec) * 1000000000 + @as(u64, t.nsec)
    }

    // CLOCK_REALTIME, 0 on Linux and macOS alike.
    fn clock_wall { mut clock: Clock } -> i64 {
        let mut t = Timespec{ sec = 0, nsec = 0 }
        _ = clock_read{ &clock, clock_id = sys::CLOCK_REALTIME, now = &t }
        return t.sec * 1000000000 + t.nsec
    }

    // ---- threads (std/task.ctx, std/thread.ctx): pthreads

    // Permission to start threads, which std's Threads includes.
    capability Threads

    // Whether tasks may run concurrently: not only in the interpreter.
    const CONCURRENT: bool = true

    // What only the interpreter can't do.
    fn concurrency_unsupported { what: []u8 } { rt::fail{ msg = what } }

    // A task's cancel object (std/task.ctx): an eventfd on Linux, a pipe on macOS, not
    // signalled; 0 if the system won't make one (sys::event_make).
    fn event_make { mut threads: Threads } -> u64 { return sys::event_make{ &threads } }
    fn event_signal { mut threads: Threads, event: u64 } { sys::event_signal{ &threads, event } }
    fn event_reset { mut threads: Threads, event: u64 } { sys::event_reset{ &threads, event } }

    // What poll waits on for it: a descriptor that is readable once it is signalled.
    fn event_waitable { event: u64 } -> u64 { return (event & 0xFFFFFFFF) - 1 }

    // Now on the monotonic clock, in nanoseconds.
    fn now { mut threads: Threads } -> u64 {
        let mut t = Timespec{ sec = 0, nsec = 0 }
        _ = clock_gettime{ &threads, clock = sys::CLOCK_MONOTONIC, now = &t }
        return @as(u64, t.sec) * 1000000000 + @as(u64, t.nsec)
    }

    // Waits on a task's cancel object for at most `nanoseconds` (thread::sleep in a task).
    fn event_wait { mut threads: Threads, waitable: u64, nanoseconds: u64 } {
        let start = now{ &threads }
        let until = if nanoseconds > FOREVER - start { FOREVER } else { start + nanoseconds }
        let mut fds: [1]PollFd = [PollFd{ fd = @as(i32, waitable), events = POLLIN, revents = 0 }]
        while true {
            let at = now{ &threads }
            if at >= until { return }
            if poll_threads{ &threads, fds = &fds[0], count = 1, ms = poll_millis{ nanoseconds = until - at } } > 0 { return }
        }
    }

    // Only Windows has synchronous calls that another thread interrupts.
    fn thread_handle { mut threads: Threads } -> u64 { return 0 }
    fn cancel_synchronous { mut threads: Threads, thread: u64 } {}

    // A pthread_attr_t: 56 bytes on Linux, 64 on macOS.
    struct Attr { bytes: [8]u64 }
    struct Timespec { sec: i64, nsec: i64 }

    extern fn pthread_attr_init { mut threads: Threads, mut attr: Attr } -> i32
    extern fn pthread_attr_setstacksize { mut threads: Threads, mut attr: Attr, size: usize } -> i32
    extern fn pthread_attr_destroy { mut threads: Threads, mut attr: Attr } -> i32
    extern fn pthread_create { mut threads: Threads, mut thread: u64, attr: *Attr, entry: extern fn{ start: *mut u8 } -> ?*mut u8, start: *mut u8 } -> i32
    extern fn pthread_detach { mut threads: Threads, thread: u64 } -> i32
    extern fn pthread_join { mut threads: Threads, thread: u64, result: ?*mut ?*mut u8 } -> i32
    extern fn pthread_self { mut threads: Threads } -> u64
    extern fn nanosleep { mut threads: Threads, request: *Timespec, remaining: ?*mut Timespec } -> i32
    extern fn sched_yield { mut threads: Threads } -> i32
    extern fn clock_gettime { mut threads: Threads, clock: i32, mut now: Timespec } -> i32

    const CLOCK_REALTIME: i32 = 0

    // Where a new thread starts: a C function that pthreads call on it, which holds no
    // capability. It runs what start's first field says it is (thread::entry).
    #c_callback{ any_thread = true }
    fn thread_entry { start: *mut u8 } -> ?*mut u8 {
        thread::entry{ start }
        return null
    }

    // Starts a thread that runs thread::entry{ start }, with a stack of stack_size bytes, rounded
    // up to 64 KiB as macOS wants a multiple of its pages: its pthread_t, or null.
    fn thread_create { mut threads: Threads, start: *mut u8, stack_size: usize } -> ?u64 {
        let mut attr = Attr{ bytes = [0; 8] }
        if pthread_attr_init{ &threads, &attr } != 0 { return null }
        defer _ = pthread_attr_destroy{ &threads, &attr }
        let size = (stack_size + 65535) / 65536 * 65536
        if pthread_attr_setstacksize{ &threads, &attr, size } != 0 { return null }
        let mut t: u64 = 0
        if pthread_create{ &threads, thread = &t, attr = &attr, entry = thread_entry, start } != 0 { return null }
        return t
    }


    fn thread_detach { mut threads: Threads, handle: u64 } {
        _ = pthread_detach{ &threads, thread = handle }
    }

    // Waits for the thread to end, and lets its pthread_t go.
    fn thread_join { mut threads: Threads, handle: u64 } {
        _ = pthread_join{ &threads, thread = handle, result = null }
    }

    fn thread_sleep { mut threads: Threads, nanoseconds: u64 } {
        let t = Timespec{ sec = @as(i64, nanoseconds / 1000000000), nsec = @as(i64, nanoseconds % 1000000000) }
        _ = nanosleep{ &threads, request = &t, remaining = null }
    }

    fn thread_yield { mut threads: Threads } {
        _ = sched_yield{ &threads }
    }

    fn thread_id { mut threads: Threads } -> u64 {
        return pthread_self{ &threads }
    }

    // The calling thread's name for debuggers, cut to what the system takes.
    fn thread_name { mut threads: Threads, name: []u8 } {
        if name.len == 0 { return }
        let mut buf: [64]u8 = [0; 64]
        let n = if name.len > sys::THREAD_NAME_MAX { sys::THREAD_NAME_MAX } else { name.len }
        slice::copy(u8){ dst = buf[..n], src = name[..n] }
        sys::set_thread_name{ &threads, name = &buf[0] }
    }

    // ---- mutexes and conditions (std/thread.ctx): a pthread_mutex_t, 40 or 48 bytes on Linux
    // and 64 on macOS, and a pthread_cond_t, 48, as their static initializers make them.

    struct Mutex { sig: i64, rest: [7]u64 }
    struct Condition { sig: i64, rest: [7]u64 }

    #pure
    extern fn pthread_mutex_lock { mutex: *mut Mutex } -> i32
    #pure
    extern fn pthread_mutex_trylock { mutex: *mut Mutex } -> i32
    #pure
    extern fn pthread_mutex_unlock { mutex: *mut Mutex } -> i32
    #pure
    extern fn pthread_mutex_destroy { mutex: *mut Mutex } -> i32
    #pure
    extern fn pthread_cond_wait { cond: *mut Condition, mutex: *mut Mutex } -> i32
    extern fn pthread_cond_timedwait { mut threads: Threads, cond: *mut Condition, mutex: *mut Mutex, until: *Timespec } -> i32
    #pure
    extern fn pthread_cond_signal { cond: *mut Condition } -> i32
    #pure
    extern fn pthread_cond_broadcast { cond: *mut Condition } -> i32
    #pure
    extern fn pthread_cond_destroy { cond: *mut Condition } -> i32

    fn mutex_make {} -> Mutex { return Mutex{ sig = sys::MUTEX_SIG, rest = [0; 7] } }
    fn mutex_lock { mut mutex: Mutex } { _ = pthread_mutex_lock{ mutex = &mutex } }
    fn mutex_try_lock { mut mutex: Mutex } -> bool { return pthread_mutex_trylock{ mutex = &mutex } == 0 }
    fn mutex_unlock { mut mutex: Mutex } { _ = pthread_mutex_unlock{ mutex = &mutex } }
    fn mutex_free { mut mutex: Mutex } { _ = pthread_mutex_destroy{ mutex = &mutex } }

    fn condition_make {} -> Condition { return Condition{ sig = sys::COND_SIG, rest = [0; 7] } }

    fn condition_wait { mut condition: Condition, mut mutex: Mutex } {
        _ = pthread_cond_wait{ cond = &condition, mutex = &mutex }
    }

    // pthread_cond_timedwait waits until a time of the realtime clock, which reading takes Threads.
    fn condition_wait_for { mut threads: Threads, mut condition: Condition, mut mutex: Mutex, nanoseconds: u64 } -> bool {
        let mut now = Timespec{ sec = 0, nsec = 0 }
        _ = clock_gettime{ &threads, clock = CLOCK_REALTIME, &now }
        let ns = @as(u64, now.nsec) + nanoseconds % 1000000000
        let secs = nanoseconds / 1000000000 + ns / 1000000000
        let max: u64 = 9223372036854775807
        let sec = if secs > max - @as(u64, now.sec) { max } else { @as(u64, now.sec) + secs }
        let until = Timespec{ sec = @as(i64, sec), nsec = @as(i64, ns % 1000000000) }
        return pthread_cond_timedwait{ &threads, cond = &condition, mutex = &mutex, until = &until } == 0
    }

    fn condition_signal { mut condition: Condition } { _ = pthread_cond_signal{ cond = &condition } }
    fn condition_broadcast { mut condition: Condition } { _ = pthread_cond_broadcast{ cond = &condition } }
    fn condition_free { mut condition: Condition } { _ = pthread_cond_destroy{ cond = &condition } }
}
