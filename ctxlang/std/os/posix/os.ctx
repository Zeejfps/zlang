// std: os on Linux and macOS. The platform's layer (spec §17): what io, mem, proc, fs and rt
// need from the operating system, over the C library and its environ. Every layer declares the
// same functions; std/os/windows is Windows', and a build compiles one. What differs between
// Linux and macOS is in namespace sys, std/os/linux or std/os/macos, which a build compiles
// beside it.

namespace os {
    // What std's Proc holds on this platform: C's `char **environ`, the "KEY=VALUE" strings of
    // this program's environment, ending with null.
    capability Proc {
        extern environ: ?*?c::String,
    }

    // The operating system this layer is for, and whether its environment's keys are
    // case-sensitive (std/os/linux/target.ctx or std/os/macos/target.ctx).
    const OS: build::Os = target::OS
    const ENV_CASE: bool = target::ENV_CASE

    #c::symbol{ name = "write" }
    extern fn c_write { mut io: Io, fd: i32, buf: *u8, count: usize } -> i64

    #c::symbol{ name = "read" }
    extern fn c_read { mut io: Io, fd: i32, buf: *mut u8, count: usize } -> i64

    extern fn aligned_alloc { mut mem: Mem, alignment: usize, size: usize } -> ?*mut u8
    extern fn memset { mut mem: Mem, dst: *mut u8, byte: i32, count: usize } -> *mut u8

    // Writes some of `bytes`, which isn't empty, to the stream. Returns how many; 0 after an error.
    fn write { mut io: Io, to: io::Stream, bytes: []u8 } -> usize {
        let fd: i32 = match to { out => { 1 } err => { 2 } }
        let w = c_write{ &io, fd, buf = bytes.ptr, count = bytes.len }
        return if w > 0 { @as(usize, w) } else { 0 }
    }

    // Reads some of standard input into `into`, which isn't empty. Returns how many; 0 at the end
    // or after an error.
    fn read { mut io: Io, into: []mut u8 } -> usize {
        let r = c_read{ &io, fd = 0, buf = into.ptr, count = into.len }
        return if r > 0 { @as(usize, r) } else { 0 }
    }

    // `size` bytes, a multiple of mem::PAGE, zeroed and page-aligned. Null if there isn't enough
    // memory.
    fn pages { mut mem: Mem, size: usize } -> ?*mut u8 {
        let p = aligned_alloc{ &mem, alignment = mem::PAGE, size } ifnull { return null }
        _ = memset{ &mem, dst = p, byte = 0, count = size }
        return p
    }

    // The value of environment variable `name`, or null if it isn't set: a view of environ's
    // own text, which lives until the program ends.
    fn env { mut proc: Proc, name: []u8 } -> ?[]u8 {
        let entries = proc.environ ifnull { return null }
        let mut i: usize = 0
        while true {
            let entry = c::bytes{ s = entries[i] ifnull { return null } }
            if entry.len > name.len and entry[name.len] == '=' and slice::eq_bytes{ a = entry[..name.len], b = name } {
                return entry[name.len + 1..]
            }
            i = i + 1
        }
        return null
    }

    // The environment's "KEY=VALUE" entries: views of environ's own text, which live until the
    // program ends, listed in memory from malloc, for good.
    fn environment { mut proc: Proc } -> [][]u8 {
        let entries = proc.environ ifnull { return slice::empty([]u8){} }
        let mut n: usize = 0
        while entries[n] != null { n = n + 1 }
        if n == 0 { return slice::empty([]u8){} }
        let p = c_malloc{ &proc, size = n * @size_of([]u8) } ifnull { return slice::empty([]u8){} }
        let items = @slice(@cast(*mut []u8, p), n)
        let mut i: usize = 0
        while i < n {
            items[i] = c::bytes{ s = entries[i] ifnull { return items[..i] } }
            i = i + 1
        }
        return items
    }

    // ---- files, for std's fs: a File's id is its file descriptor. Paths aren't empty: fs
    // reports those as not_found itself.

    #c::symbol{ name = "read" }
    extern fn fd_read { mut fs: Fs, fd: i32, buf: *mut u8, count: usize } -> i64
    #c::symbol{ name = "write" }
    extern fn fd_write { mut fs: Fs, fd: i32, buf: *u8, count: usize } -> i64
    #c::symbol{ name = "close" }
    extern fn fd_close { mut fs: Fs, fd: i32 } -> i32
    extern fn lseek { mut fs: Fs, fd: i32, offset: i64, whence: i32 } -> i64
    extern fn unlink { mut fs: Fs, path: *u8 } -> i32
    extern fn mkdir { mut fs: Fs, path: *u8, mode: u32 } -> i32
    #c::symbol{ name = "rename" }
    extern fn c_rename { mut fs: Fs, from: *u8, to: *u8 } -> i32
    extern fn getcwd { mut fs: Fs, buf: *mut u8, size: usize } -> ?*u8
    // A DIR * is opaque, so it is a number here, 0 for null: as a pointer, the escape check
    // would take it to hold the path opendir was given.
    extern fn opendir { mut fs: Fs, path: *u8 } -> u64
    extern fn readdir { mut fs: Fs, dir: u64 } -> ?*u8
    extern fn closedir { mut fs: Fs, dir: u64 } -> i32

    const O_RDONLY: i32 = 0
    const O_WRONLY: i32 = 1
    const SEEK_SET: i32 = 0
    const SEEK_END: i32 = 2
    const PATH_MAX: usize = 4096

    // A directory being read, for fs::list: the C library's DIR.
    struct Dir { handle: u64 }

    fn file_open { mut fs: Fs, path: []u8, mode: fs::Mode } -> fs::Error!u64 {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if is_dir{ &fs, path = p } { return fs::is_directory }
        let flags = match mode {
            read   => { O_RDONLY }
            write  => { O_WRONLY | sys::O_CREAT | sys::O_TRUNC }
            append => { O_WRONLY | sys::O_CREAT | sys::O_APPEND }
            create => { O_WRONLY | sys::O_CREAT | sys::O_EXCL }
        }
        let fd = sys::open{ &fs, path = p, flags, mode = 438 }      // 0666, less the umask
        if fd < 0 { return failed{ code = sys::errno{ &fs }.* } }
        return @as(u64, fd)
    }

    // Reads at most into.len bytes, which aren't none. Returns how many; 0 at the end.
    fn file_read { mut fs: Fs, file: u64, into: []mut u8 } -> fs::Error!usize {
        let fd = descriptor{ file } ifnull { return fs::bad_file }
        let n = fd_read{ &fs, fd, buf = into.ptr, count = into.len }
        if n < 0 { return failed{ code = sys::errno{ &fs }.* } }
        return @as(usize, n)
    }

    // Writes some of `bytes`, which aren't none. Returns how many.
    fn file_write { mut fs: Fs, file: u64, bytes: []u8 } -> fs::Error!usize {
        let fd = descriptor{ file } ifnull { return fs::bad_file }
        let n = fd_write{ &fs, fd, buf = bytes.ptr, count = bytes.len }
        if n < 0 { return failed{ code = sys::errno{ &fs }.* } }
        return @as(usize, n)
    }

    fn file_close { mut fs: Fs, file: u64 } -> fs::Error! {
        let fd = descriptor{ file } ifnull { return fs::bad_file }
        if fd_close{ &fs, fd } < 0 { return failed{ code = sys::errno{ &fs }.* } }
    }

    // Moves the position to `offset` from the start (SEEK_SET).
    fn file_seek { mut fs: Fs, file: u64, offset: u64 } -> fs::Error! {
        let fd = descriptor{ file } ifnull { return fs::bad_file }
        if offset > 9223372036854775807 { return failed{ code = 22 } }       // EINVAL
        if lseek{ &fs, fd, offset = @as(i64, offset), whence = SEEK_SET } < 0 { return failed{ code = sys::errno{ &fs }.* } }
    }

    // The size of the file at `path`: where its end is, which needs no layout of struct stat.
    fn file_size { mut fs: Fs, path: []u8 } -> fs::Error!u64 {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if is_dir{ &fs, path = p } { return fs::is_directory }
        let fd = sys::open{ &fs, path = p, flags = O_RDONLY, mode = 0 }
        if fd < 0 { return failed{ code = sys::errno{ &fs }.* } }
        let end = lseek{ &fs, fd, offset = 0, whence = SEEK_END }
        let code = sys::errno{ &fs }.*
        _ = fd_close{ &fs, fd }
        if end < 0 { return failed{ code } }
        return @as(u64, end)
    }

    fn remove { mut fs: Fs, path: []u8 } -> fs::Error! {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if is_dir{ &fs, path = p } { return fs::is_directory }
        if unlink{ &fs, path = p } < 0 { return failed{ code = sys::errno{ &fs }.* } }
    }

    fn make_dir { mut fs: Fs, path: []u8 } -> fs::Error! {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if mkdir{ &fs, path = p, mode = 511 } < 0 { return failed{ code = sys::errno{ &fs }.* } }     // 0777, less the umask
    }

    fn rename { mut fs: Fs, from: []u8, to: []u8 } -> fs::Error! {
        let mut a: [4096]u8
        let mut b: [4096]u8
        let p = c_path{ path = from, buf = a[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        let q = c_path{ path = to, buf = b[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        if c_rename{ &fs, from = p, to = q } < 0 { return failed{ code = sys::errno{ &fs }.* } }
    }

    // The working directory's path into `into`. Returns its length.
    fn working_dir { mut fs: Fs, into: []mut u8 } -> fs::Error!usize {
        if getcwd{ &fs, buf = into.ptr, size = into.len } == null { return failed{ code = sys::errno{ &fs }.* } }
        let mut n: usize = 0
        while n < into.len and into[n] != 0 { n = n + 1 }
        return n
    }

    fn is_absolute { path: []u8 } -> bool {
        return target::is_absolute{ path }
    }

    fn dir_open { mut fs: Fs, path: []u8 } -> fs::Error!Dir {
        let mut buf: [4096]u8
        let p = c_path{ path, buf = buf[..] } ifnull { return failed{ code = sys::ENAMETOOLONG } }
        let d = opendir{ &fs, path = p }
        if d == 0 { return failed{ code = sys::errno{ &fs }.* } }
        return Dir{ handle = d }
    }

    // The next entry's name, "." and ".." included, or null at the end. It lives until the next
    // call.
    fn dir_next { mut fs: Fs, mut dir: Dir } -> ?[]u8 {
        let e = readdir{ &fs, dir = dir.handle } ifnull { return null }
        return c::bytes{ s = c::String{ ptr = e + sys::DIRENT_NAME } }
    }

    fn dir_close { mut fs: Fs, mut dir: Dir } {
        _ = closedir{ &fs, dir = dir.handle }
    }

    // ---- for std's rt: starting the program, and ending it

    #c::symbol{ name = "exit" }
    extern fn c_exit { mut proc: Proc, code: i32 }

    // Ends the program with exit code `code`, as C's exit does.
    fn exit { mut proc: Proc, code: i32 } {
        c_exit{ &proc, code }
    }

    // What the platform needs before main runs (sys::start).
    fn start { mut io: Io, mut proc: Proc, argv: *?*u8 } {
        sys::start{ &proc, argv }
    }

    // The command line's arguments after the program's name: views of C's argv (rt::c_args).
    fn args { mut mem: Mem, argc: i32, argv: *?*u8 } -> [][]u8 {
        return rt::c_args{ &mem, argc, argv }
    }

    // ---- memory for arenas (mem::reserve, arena::alloc)

    #c::symbol{ name = "calloc" }
    extern fn c_calloc { mut mem: Mem, count: usize, size: usize } -> ?*mut u8

    // `size` bytes, a multiple of mem::PAGE, for an arena: zeroed and page-aligned. calloc gives
    // zeroed memory that the OS supplies on first use: it takes a big block from mmap without
    // clearing it. Null if there isn't enough memory.
    fn reserve { mut mem: Mem, size: usize } -> ?*mut u8 {
        if size > 18446744073709551615 - mem::PAGE { return null }
        let p = c_calloc{ &mem, count = 1, size = size + mem::PAGE } ifnull { return null }
        return p + (mem::PAGE - @addr(p) % mem::PAGE) % mem::PAGE
    }

    // Makes an arena's memory from first to last usable, which memory from `reserve` is here
    // from the start.
    fn commit { first: *u8, last: *u8 } -> bool {
        return true
    }

    // ---- for std's proc: programs, started with posix_spawnp and waited for with waitpid. A
    // child's id is its process id.

    extern fn posix_spawnp { mut proc: Proc, mut pid: i32, file: *u8, actions: ?*u8, attrs: ?*u8, argv: *?*u8, envp: *?*u8 } -> i32
    extern fn waitpid { mut proc: Proc, pid: i32, mut status: i32, options: i32 } -> i32
    extern fn sysconf { mut proc: Proc, name: i32 } -> i64
    #c::symbol{ name = "malloc" }
    extern fn c_malloc { mut proc: Proc, size: usize } -> ?*mut u8
    #c::symbol{ name = "free" }
    extern fn c_free { mut proc: Proc, p: *mut u8 }

    // Starts argv[0] with this program's environment, less the entries env replaces, and env's
    // own. argv and env aren't empty and are checked (proc::spawn). Its arrays of C strings are
    // in one block from malloc, while posix_spawnp copies them.
    fn spawn { mut proc: Proc, argv: [][]u8, env: [][]u8 } -> proc::Error!u64 {
        let inherited = proc.environ
        let mut n: usize = 0
        if inherited != null {
            while inherited[n] != null { n = n + 1 }
        }
        let words = argv.len + 1 + n + env.len + 1
        let mut size = words * 8
        let mut i: usize = 0
        while i < argv.len { size = size + argv[i].len + 1; i = i + 1 }
        i = 0
        while i < env.len { size = size + env[i].len + 1; i = i + 1 }
        let block = c_malloc{ &proc, size } ifnull {
            rt::fail{ msg = "out of memory" }
            return proc::other{ code = 12 }
        }
        defer c_free{ &proc, p = block }
        let ptrs = @slice(@cast(*mut ?*u8, block), words)
        let mut text = block + words * 8
        i = 0
        while i < argv.len {
            ptrs[i] = text
            text = c_copy{ into = text, bytes = argv[i] }
            i = i + 1
        }
        ptrs[argv.len] = null
        let envp = argv.len + 1
        let mut k = envp
        i = 0
        while inherited != null and i < n {
            let entry = inherited[i] ifnull { break }
            if not proc::overridden{ entry = c::bytes{ s = entry }, env } {
                ptrs[k] = entry.ptr
                k = k + 1
            }
            i = i + 1
        }
        i = 0
        while i < env.len {
            ptrs[k] = text
            text = c_copy{ into = text, bytes = env[i] }
            k = k + 1
            i = i + 1
        }
        ptrs[k] = null
        let file = ptrs[0] ifnull { return proc::not_found }
        let mut pid: i32 = 0
        let r = posix_spawnp{ &proc, pid = &pid, file, actions = null, attrs = null, argv = ptrs.ptr, envp = ptrs.ptr + envp }
        if r != 0 { return proc_failed{ code = r } }
        return @as(u64, pid)
    }

    // bytes and a zero at into; returns where they end.
    fn c_copy { into: *mut u8, bytes: []u8 } -> *mut u8 {
        let mut i: usize = 0
        while i < bytes.len {
            into[i] = bytes[i]
            i = i + 1
        }
        into[bytes.len] = 0
        return into + (bytes.len + 1)
    }

    // Waits for child `id` to end: its exit code, or 128 + N if signal N killed it. waitpid's
    // status is decoded as WIFEXITED and the rest are, the same on Linux and macOS.
    fn wait { mut proc: Proc, id: u64 } -> proc::Error!i32 {
        let mut status: i32 = 0
        while waitpid{ &proc, pid = @as(i32, id), status = &status, options = 0 } < 0 {
            let e = sys::proc_errno{ &proc }.*
            if e != 4 { return proc_failed{ code = e } }              // EINTR: wait again
        }
        let signal = status & 127
        if signal == 0 { return (status >> 8) & 255 }
        if signal != 127 { return 128 + signal }
        return 255
    }

    // How many processors this program may run on: at least 1.
    fn processors { mut proc: Proc } -> u32 {
        let n = sysconf{ &proc, name = sys::SC_NPROCESSORS_ONLN }
        return if n > 0 and n < 4294967296 { @as(u32, n) } else { 1 }
    }

    fn exe_path { mut proc: Proc } -> []u8 {
        return sys::exe_path{ &proc }
    }

    // The error for errno `code` from starting or waiting for a program.
    fn proc_failed(T) { code: i32 } -> !T {
        if code == 2 { return proc::not_found }                         // ENOENT
        if code == 1 or code == 13 { return proc::permission_denied }   // EPERM, EACCES
        return proc::other{ code = @as(i64, code) }
    }

    // `path` with a zero after it, as C takes it, in buf; null if it doesn't fit.
    fn c_path { path: []u8, buf: []mut u8 } -> ?*u8 {
        if path.len >= buf.len { return null }
        slice::copy(u8){ dst = buf[..path.len], src = path }
        buf[path.len] = 0
        return buf.ptr
    }

    // Whether there is a directory at `path`: opendir needs no layout of struct stat.
    fn is_dir { mut fs: Fs, path: *u8 } -> bool {
        let d = opendir{ &fs, path }
        if d == 0 { return false }
        _ = closedir{ &fs, dir = d }
        return true
    }

    // A File's id as a descriptor; null if it can't be one.
    fn descriptor { file: u64 } -> ?i32 {
        if file > 2147483647 { return null }
        return @as(i32, file)
    }

    // The error for errno `code`: their numbers are the same on Linux and macOS.
    fn failed(T) { code: i32 } -> !T {
        if code == 2 { return fs::not_found }                       // ENOENT
        if code == 1 or code == 13 { return fs::permission_denied } // EPERM, EACCES
        if code == 21 { return fs::is_directory }                   // EISDIR
        if code == 17 { return fs::exists }                         // EEXIST
        if code == 20 { return fs::not_directory }                  // ENOTDIR
        if code == 9 { return fs::bad_file }                        // EBADF
        return fs::other{ code = @as(i64, code) }
    }
}
