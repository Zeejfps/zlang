// std: os in ctxc's interpreter (`ctxc interp`, ctxc/eval.ctx). The platform's layer (spec §17)
// for a program that runs in the interpreter rather than as C: what io, mem, proc, fs, net and rt
// need, over a few externs that only the interpreter provides, `ctx_interp_*`. What it can't do,
// standard input, files, other programs and the network among it, stops the run as not
// supported by interp.
// The platform is the one ctxc runs on: its target.ctx, beside this one in the build.
//
// Where it differs from the platform's own layer, beyond what it can't do:
//   - Its argv, for a program's own `#start`, is UTF-8, where Windows' C gives the ANSI code
//     page's bytes.
//   - Its environment's keys match as std's proc::overridden does, folding ASCII's case where
//     the platform's aren't case-sensitive, where Windows folds all of Unicode's.
//   - Its environment is ctxc's, but for what `ctxc interp --env` sets or removes, as the
//     comparison with the compiled run does for CTX_STACK and CTX_HOME (tools/suite).

namespace os {
    // What std's Proc holds here: nothing. The environment is the interpreter's.
    capability Proc

    // The operating system and its environment's keys, as the platform ctxc runs on has them.
    const OS: build::Os = target::OS
    const ENV_CASE: bool = target::ENV_CASE

    // The interpreter's: it keeps what the program writes to standard output (fd 1) and error
    // (2), in order, for `ctxc interp` to write.
    #c_symbol{ name = "ctx_interp_write" }
    extern fn host_write { mut io: Io, fd: i32, bytes: []u8 } -> usize

    // Standard input, output and error in binary mode, as std/os/windows sets them: until then,
    // on Windows, the interpreter writes "\n" as "\r\n", as C does.
    #c_symbol{ name = "ctx_interp_binary" }
    extern fn host_binary { mut io: Io }

    // Zeroed, page-aligned memory of `size` bytes, a multiple of mem::PAGE; null if the
    // interpreter can't give it.
    #c_symbol{ name = "ctx_interp_pages" }
    extern fn host_pages { mut mem: Mem, size: usize } -> ?*mut u8

    // The environment `ctxc interp` was given: its "KEY=VALUE" entries.
    #c_symbol{ name = "ctx_interp_environment" }
    extern fn host_environment { mut proc: Proc } -> [][]u8

    // Ends the run with exit code `code`.
    #c_symbol{ name = "ctx_interp_exit" }
    extern fn host_exit { mut proc: Proc, code: i32 }

    // Stops the run: the interpreter can't do `what`. It doesn't return.
    #c_symbol{ name = "ctx_interp_unsupported" }
    #pure
    extern fn unsupported { what: []u8 } -> u32

    fn write { mut io: Io, to: io::Stream, bytes: []u8 } -> usize {
        return host_write{ &io, fd = if to == io::Stream::out { 1 } else { 2 }, bytes }
    }

    fn read { mut io: Io, into: []mut u8 } -> usize {
        _ = unsupported{ what = "standard input" }
        return 0
    }

    fn pages { mut mem: Mem, size: usize } -> ?*mut u8 {
        return host_pages{ &mem, size }
    }

    // The value of environment variable `name`, or null if it isn't set.
    fn env { mut proc: Proc, name: []u8 } -> ?[]u8 {
        let entries = host_environment{ &proc }
        let mut i: usize = 0
        while i < entries.len {
            let e = entries[i]
            if e.len > name.len and e[name.len] == '=' and same_key{ a = e[..name.len], b = name } { return e[name.len + 1..] }
            i = i + 1
        }
        return null
    }

    fn same_key { a: []u8, b: []u8 } -> bool {
        if ENV_CASE { return slice::eq_bytes{ a, b } }
        let mut i: usize = 0
        while i < a.len {
            if ascii::to_lower{ c = a[i] } != ascii::to_lower{ c = b[i] } { return false }
            i = i + 1
        }
        return true
    }

    fn environment { mut proc: Proc } -> [][]u8 {
        return host_environment{ &proc }
    }

    // ---- files, for std's fs: not supported by interp

    struct Dir { handle: u64 }

    // Stops the run. Its callers declare the errors every layer may fail with (fs::Error), so
    // that a program is checked as the platform's layer would check it.
    fn no_files(T) {} -> fs::Error!T {
        _ = unsupported{ what = "files" }
        return fs::other{ code = 0 }
    }

    fn file_open { mut fs: Fs, path: []u8, mode: fs::Mode } -> fs::Error!u64 { return try no_files(u64){} }
    fn file_read { mut fs: Fs, file: u64, into: []mut u8 } -> fs::Error!usize { return try no_files(usize){} }
    fn file_write { mut fs: Fs, file: u64, bytes: []u8 } -> fs::Error!usize { return try no_files(usize){} }
    fn file_close { mut fs: Fs, file: u64 } -> fs::Error! { _ = try no_files(bool){} }
    fn file_seek { mut fs: Fs, file: u64, offset: u64 } -> fs::Error! { _ = try no_files(bool){} }
    fn file_read_at { mut fs: Fs, file: u64, offset: u64, into: []mut u8 } -> fs::Error!usize { return try no_files(usize){} }
    fn file_size { mut fs: Fs, path: []u8 } -> fs::Error!u64 { return try no_files(u64){} }
    fn remove { mut fs: Fs, path: []u8 } -> fs::Error! { _ = try no_files(bool){} }
    fn make_dir { mut fs: Fs, path: []u8 } -> fs::Error! { _ = try no_files(bool){} }
    fn remove_dir { mut fs: Fs, path: []u8 } -> fs::Error! { _ = try no_files(bool){} }
    fn rename { mut fs: Fs, from: []u8, to: []u8 } -> fs::Error! { _ = try no_files(bool){} }
    fn working_dir { mut fs: Fs, into: []mut u8 } -> fs::Error!usize { return try no_files(usize){} }
    fn dir_open { mut fs: Fs, path: []u8 } -> fs::Error!Dir { return try no_files(Dir){} }
    fn dir_next { mut fs: Fs, mut dir: Dir } -> ?[]u8 {
        _ = unsupported{ what = "files" }
        return null
    }
    fn dir_close { mut fs: Fs, mut dir: Dir } { _ = unsupported{ what = "files" } }

    fn is_absolute { path: []u8 } -> bool {
        return target::is_absolute{ path }
    }

    // ---- for std's rt: starting the program, and ending it

    fn exit { mut proc: Proc, code: i32 } {
        host_exit{ &proc, code }
    }

    fn start { mut io: Io, mut proc: Proc, argv: *?*u8 } {
        host_binary{ &io }
    }

    fn args { mut mem: Mem, argc: i32, argv: *?*u8 } -> [][]u8 {
        return rt::c_args{ &mem, argc, argv }
    }

    // ---- memory for arenas (mem::reserve, arena::alloc): pages, usable from the start; and
    // pages given back (mem::release)

    fn reserve { mut mem: Mem, size: usize } -> ?*mut u8 {
        return host_pages{ &mem, size }
    }

    fn commit { first: *u8, last: *u8 } -> bool {
        return true
    }

    // Gives back the region at p, of `size` bytes, that `pages` or `reserve` made: nothing, as
    // for the heap's blocks below. The interpreter's memory is a run's until it ends, and a run
    // is short; a program sees release's contract either way, since what it releases it
    // doesn't use again.
    fn release_pages { mut mem: Mem, p: *mut u8, size: usize } -> bool {
        return true
    }

    // ---- the heap (std/heap.ctx): blocks of the interpreter's own memory, which a run never
    // gives back, as it never gives back pages: a run is short, its steps bounded, and what it
    // takes goes back when it ends. So freeing a block does nothing, and a resize that grows
    // takes a new block and copies; one that shrinks keeps the block, whose bytes past the new
    // size no resize hands out again, since growing always takes a new one. A program sees the
    // heap's contract either way: what it frees it doesn't use again.

    // Zeroed memory of `size` bytes, which isn't 0, aligned to 16; null if the interpreter
    // can't give it.
    #c_symbol{ name = "ctx_interp_heap" }
    extern fn host_heap { mut mem: Mem, size: usize } -> ?*mut u8

    fn heap_allocate { mut mem: Mem, size: usize } -> ?*mut u8 {
        return host_heap{ &mem, size }
    }

    fn heap_resize { mut mem: Mem, p: *mut u8, old: usize, size: usize } -> ?*mut u8 {
        if size <= old { return p }
        let q = host_heap{ &mem, size } ifnull { return null }
        slice::copy(u8){ dst = @slice(q, old), src = @slice(p, old) }
        return q
    }

    fn heap_free { mut mem: Mem, p: *mut u8 } {}

    // ---- for std's proc: not supported by interp

    // Stops the run, as no_files does, for proc's errors.
    fn no_programs(T) {} -> proc::Error!T {
        _ = unsupported{ what = "other programs" }
        return proc::other{ code = 0 }
    }

    fn spawn { mut proc: Proc, argv: [][]u8, options: proc::Options } -> proc::Error!proc::Child { return try no_programs(proc::Child){} }
    fn wait { mut proc: Proc, mut cancel: task::Cancel, child: proc::Child, interruptible: bool } -> proc::Error!i32 { return try no_programs(i32){} }
    fn wait_for { mut proc: Proc, mut cancel: task::Cancel, child: proc::Child, nanoseconds: u64 } -> proc::Error!?i32 { return try no_programs(?i32){} }
    fn kill { mut proc: Proc, child: proc::Child } -> proc::Error! { _ = try no_programs(bool){} }
    fn pipe_read { mut proc: Proc, mut cancel: task::Cancel, pipe: u64, into: []mut u8 } -> proc::Error!usize { return try no_programs(usize){} }
    fn pipe_write { mut proc: Proc, mut cancel: task::Cancel, pipe: u64, bytes: []u8 } -> proc::Error!usize { return try no_programs(usize){} }
    fn pipe_close { mut proc: Proc, pipe: u64 } { _ = unsupported{ what = "other programs" } }

    // ---- for std's net: not supported by interp. Addresses are pure, and run here.

    // What std's Net holds here: nothing.
    capability Net

    // Stops the run, as no_files does, for net's errors.
    fn no_network(T) {} -> net::Error!T {
        _ = unsupported{ what = "the network" }
        return net::other{ code = 0 }
    }

    fn tcp_connect { mut net: Net, mut cancel: task::Cancel, address: net::Address } -> net::Error!u64 { return try no_network(u64){} }
    fn tcp_listen { mut net: Net, address: net::Address, backlog: u32 } -> net::Error!u64 { return try no_network(u64){} }
    fn tcp_accept { mut net: Net, mut cancel: task::Cancel, listener: u64, family: u8 } -> net::Error!u64 { return try no_network(u64){} }
    fn tcp_receive { mut net: Net, mut cancel: task::Cancel, socket: u64, into: []mut u8 } -> net::Error!usize { return try no_network(usize){} }
    fn tcp_send { mut net: Net, mut cancel: task::Cancel, socket: u64, bytes: []u8 } -> net::Error!usize { return try no_network(usize){} }
    fn tcp_shutdown { mut net: Net, socket: u64, how: net::Shutdown } -> net::Error! { _ = try no_network(bool){} }
    fn tcp_close { mut net: Net, socket: u64 } { _ = unsupported{ what = "the network" } }
    fn tcp_get_address { mut net: Net, socket: u64, peer: bool } -> net::Error!net::Address { return try no_network(net::Address){} }
    fn tcp_set_no_delay { mut net: Net, socket: u64, on: bool } -> net::Error! { _ = try no_network(bool){} }
    fn tcp_set_keep_alive { mut net: Net, socket: u64, idle_seconds: u32 } -> net::Error! { _ = try no_network(bool){} }

    fn processors { mut proc: Proc } -> u32 {
        _ = unsupported{ what = "the number of processors" }
        return 1
    }

    fn exe_path { mut proc: Proc } -> []u8 {
        _ = unsupported{ what = "the executable's path" }
        return ""
    }

    // ---- for std's stop: no handler. The console's requests reach ctxc, which Ctrl-C ends,
    // and the run with it, as it ends a program without stop; only `ask` asks the program. So a
    // wait returns what `ask` asked, and a wait for as long as it takes that nothing asked yet
    // would wait for nothing that can come: it stops the run, as not supported by interp. A
    // wait with a time returns at once, as thread::sleep does here.

    // What std's Stop holds here: what `ask` asked (stop::INTERRUPT or TERMINATE), 0 until then.
    capability Stop {
        static asked: u32,
    }

    fn stop_wait { mut stop: Stop, mut cancel: task::Cancel, nanoseconds: u64 } -> stop::Error!u32 {
        try task::check{ &cancel }
        if stop.asked == 0 and nanoseconds == stop::FOREVER {
            _ = unsupported{ what = "waiting until the console asks the program to stop" }
        }
        return stop.asked
    }

    fn stop_ask { mut stop: Stop, code: u32 } -> stop::Error! {
        if stop.asked == 0 { stop.asked = code }
    }

    // ---- for std's clock: not supported by interp. A run here is the same each time, which a
    // reading of a clock would make it not be; to_utc is pure, and runs here.

    // What std's Clock holds here: nothing.
    capability Clock

    fn clock_monotonic { mut clock: Clock } -> u64 { return @as(u64, unsupported{ what = "the clock" }) }
    fn clock_wall { mut clock: Clock } -> i64 { return @as(i64, unsupported{ what = "the clock" }) }

    // ---- threads (std/thread.ctx): one at a time
    //
    // A thread runs to its end inside os::thread_create, before its starter goes on, with its own
    // `#thread_local` statics (ctx_interp_thread_enter and _leave): one schedule a program's
    // threads may have, and the same each run. What would wait for another thread instead (a
    // mutex another holds, a condition) stops the run, as not supported by interp.

    // Permission to start threads, which std's Threads includes.
    capability Threads

    // Tasks run at once: one thread can't keep a promise to run them concurrently.
    const CONCURRENT: bool = false

    fn concurrency_unsupported { what: []u8 } { _ = unsupported{ what } }

    fn event_make { mut threads: Threads } -> u64 { return 1 }
    fn event_signal { mut threads: Threads, event: u64 } {}
    fn event_reset { mut threads: Threads, event: u64 } {}
    fn event_waitable { event: u64 } -> u64 { return 0 }
    fn event_wait { mut threads: Threads, waitable: u64, nanoseconds: u64 } {}
    fn now { mut threads: Threads } -> u64 { return 0 }

    // The deadlines' clock (task::run_within) stands still here, as thread::sleep returns at
    // once: a deadline of 0 has passed, and any other never passes. It reads 1, not 0, since a
    // deadline of 0 is none.
    fn read_deadline_clock { mut cancel: task::Cancel } -> u64 { return 1 }
    fn thread_handle { mut threads: Threads } -> u64 { return 0 }
    fn cancel_synchronous { mut threads: Threads, thread: u64 } {}

    #c_symbol{ name = "ctx_interp_thread_enter" }
    extern fn host_thread_enter { mut threads: Threads }
    #c_symbol{ name = "ctx_interp_thread_leave" }
    extern fn host_thread_leave { mut threads: Threads }
    #c_symbol{ name = "ctx_interp_thread_id" }
    extern fn host_thread_id { mut threads: Threads } -> u64

    // One thread at a time: the new one runs to its end here, before the call returns.
    fn thread_create { mut threads: Threads, start: *mut u8, stack_size: usize } -> ?u64 {
        host_thread_enter{ &threads }
        thread::entry{ start }
        host_thread_leave{ &threads }
        return 1
    }

    fn thread_detach { mut threads: Threads, handle: u64 } {}
    fn thread_join { mut threads: Threads, handle: u64 } {}
    fn thread_sleep { mut threads: Threads, nanoseconds: u64 } {}
    fn thread_yield { mut threads: Threads } {}
    fn thread_id { mut threads: Threads } -> u64 { return host_thread_id{ &threads } }
    fn thread_name { mut threads: Threads, name: []u8 } {}

    struct Mutex { locked: u32 }
    struct Condition { signals: u32 }

    fn mutex_make {} -> Mutex { return Mutex{ locked = 0 } }

    fn mutex_lock { mut mutex: Mutex } {
        if mutex.locked != 0 { _ = unsupported{ what = "waiting for a mutex that another thread holds" } }
        mutex.locked = 1
    }

    fn mutex_try_lock { mut mutex: Mutex } -> bool {
        if mutex.locked != 0 { return false }
        mutex.locked = 1
        return true
    }

    fn mutex_unlock { mut mutex: Mutex } { mutex.locked = 0 }
    fn mutex_free { mut mutex: Mutex } {}

    fn condition_make {} -> Condition { return Condition{ signals = 0 } }

    fn condition_wait { mut condition: Condition, mut mutex: Mutex } {
        _ = unsupported{ what = "waiting on a condition" }
    }

    // No other thread can signal it meanwhile: it gives up at once.
    fn condition_wait_for { mut threads: Threads, mut condition: Condition, mut mutex: Mutex, nanoseconds: u64 } -> bool {
        return false
    }

    fn condition_signal { mut condition: Condition } {}
    fn condition_broadcast { mut condition: Condition } {}
    fn condition_free { mut condition: Condition } {}
}
