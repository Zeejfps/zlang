// std: fs. Files.
//
// Every function takes `mut fs: Fs`. Only `main` receives an `Fs`, from the runtime, so a
// function can touch the filesystem only if its caller passes it down.
//
//   fn main { mut io: Io, mut fs: Fs, args: Args } -> i32 {
//       let mut mem: [65536]u8
//       let mut heap = arena::new{ buf = mem[..] }
//       let path = args[0]
//       let text = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr { return 1 }
//       io::println{ &io, s = utf8::of{ chars = text } }
//       return 0
//   }
//
// Paths are bytes, relative to the working directory the program was started in. A function
// fails with the errors below that its body can produce (spec §8, Errors), and read_all and list
// with alloc::out_of_memory when their allocator fails.
//
// Permission to use the filesystem.
capability Fs

namespace fs {
    error not_found
    error permission_denied
    error is_directory
    error exists                // open with Mode::create, and the file is already there
    error not_directory         // a directory in the path is a file
    error bad_file              // the file is closed
    error other{ code: i64 }    // the OS's error number

    // What the platform's layer (std/os) may fail with, on every platform: each of its file
    // functions declares this set (spec §8, Errors, rule 14), whichever of it the OS can give.
    type Error = error(not_found, permission_denied, is_directory, exists, not_directory, bad_file, other)

    union Mode {
        read,       // an existing file
        write,      // creates the file, or empties an existing one
        append,     // creates the file, or writes after its end
        create,     // creates the file; fails with `exists` if it is already there
    }

    // An open file: the OS's handle for it, a file descriptor or a Windows HANDLE.
    struct File { id: u64 }

    // The platform's layer (std/os) does the work, and reports its errors as these.
    fn open { mut fs: Fs, path: []u8, mode: Mode } -> !File {
        if path.len == 0 { return not_found }
        return File{ id = try os::file_open{ &fs, path, mode } }
    }

    // Reads at most into.len bytes into `into`. Returns how many; 0 at the end of the file.
    fn read { mut fs: Fs, file: File, into: []mut u8 } -> !usize {
        if into.len == 0 { return 0 }
        return try os::file_read{ &fs, file = file.id, into }
    }

    // Writes all of `bytes`.
    fn write { mut fs: Fs, file: File, bytes: []u8 } -> !usize {
        let mut done: usize = 0
        while done < bytes.len {
            done = done + try os::file_write{ &fs, file = file.id, bytes = bytes[done..bytes.len] }
        }
        return done
    }

    // Moves the file's position to `offset` bytes from its start: the next read or write starts
    // there. An offset past the end is allowed; reading there reads nothing.
    fn seek { mut fs: Fs, file: File, offset: u64 } -> ! {
        try os::file_seek{ &fs, file = file.id, offset }
    }

    // Reads into `into` from `offset` bytes into the file: all of it, or as much as there is
    // before the end of the file. Returns how many bytes it read. Leaves the file's position after
    // them. For archives, whose members are read by offset without loading the whole file.
    fn read_at { mut fs: Fs, file: File, offset: u64, into: []mut u8 } -> !usize {
        try seek{ &fs, file, offset }
        let mut n: usize = 0
        while n < into.len {
            let got = try read{ &fs, file, into = into[n..] }
            if got == 0 { break }
            n = n + got
        }
        return n
    }

    // Files still open when the program ends are closed then.
    fn close { mut fs: Fs, file: File } -> ! {
        try os::file_close{ &fs, file = file.id }
    }

    // The size of the file at `path`, in bytes.
    fn size { mut fs: Fs, path: []u8 } -> !u64 {
        if path.len == 0 { return not_found }
        return try os::file_size{ &fs, path }
    }

    // Deletes the file at `path`.
    fn remove { mut fs: Fs, path: []u8 } -> ! {
        if path.len == 0 { return not_found }
        try os::remove{ &fs, path }
    }

    // Creates directory `path`; fails with `exists` if something is there already.
    fn make_dir { mut fs: Fs, path: []u8 } -> ! {
        if path.len == 0 { return not_found }
        try os::make_dir{ &fs, path }
    }

    // Renames the file at `from` to `to`, replacing any file at `to`. Where both are in one
    // directory, no one sees `to` half written: the way to publish a file another program may
    // be reading.
    fn rename { mut fs: Fs, from: []u8, to: []u8 } -> ! {
        if from.len == 0 or to.len == 0 { return not_found }
        try os::rename{ &fs, from, to }
    }

    // Whether `path` is absolute: it starts with `/`, or on Windows with `\` or a drive (`C:`).
    fn is_absolute { path: []u8 } -> bool {
        return os::is_absolute{ path }
    }

    // `path` as an absolute path, in memory from `realloc`: a copy if it is one, or else the
    // working directory and `path` joined by a `/`. It neither removes `.` and `..` nor looks at
    // whether `path` exists.
    fn make_absolute(S) { mut fs: Fs, mut heap: S, realloc: alloc::Fn(S), path: []u8 } -> !alloc::Bytes {
        let mut dir: [32768]u8
        let n = if os::is_absolute{ path } { 0 } else { try os::working_dir{ &fs, into = dir[..] } }
        let sep: usize = if n > 0 and path.len > 0 and dir[n - 1] != '/' and dir[n - 1] != '\\' { 1 } else { 0 }
        let out = try alloc::resize(u8, S){ realloc, &heap, mem = slice::empty(u8){}, count = n + sep + path.len }
        slice::copy(u8){ dst = out[..n], src = dir[..n] }
        if sep == 1 { out[n] = '/' }
        slice::copy(u8){ dst = out[n + sep..], src = path }
        return out
    }

    // The names of directory `path`'s entries, without "." and "..", sorted by their bytes. They
    // are in memory from `realloc`, in two allocations: the names' bytes, and the slice of them.
    fn list(S) { mut fs: Fs, mut heap: S, realloc: alloc::Fn(S), path: []u8 } -> ![][]u8 {
        if path.len == 0 { return not_found }
        let mut dir = try os::dir_open{ &fs, path }
        defer os::dir_close{ &fs, &dir }
        // Each name, followed by a zero byte.
        let mut buf = slice::empty(u8){}
        let mut n: usize = 0
        while true {
            let name = os::dir_next{ &fs, &dir } ifnull { break }
            if slice::eq_bytes{ a = name, b = "." } or slice::eq_bytes{ a = name, b = ".." } { continue }
            if n + name.len + 1 > buf.len {
                let want = n + name.len + 1
                let cap: usize = if buf.len * 2 > want { buf.len * 2 } else if want > 256 { want } else { 256 }
                buf = match realloc{ &heap, mem = buf, new = cap, align = 1 } {
                    null => {
                        _ = realloc{ &heap, mem = buf, new = 0, align = 1 }
                        return alloc::out_of_memory
                    }
                    some{ value } => { value }
                }
            }
            slice::copy(u8){ dst = buf[n..n + name.len], src = name }
            buf[n + name.len] = 0
            n = n + name.len + 1
        }
        buf = buf[..n]
        let mut count: usize = 0
        let mut i: usize = 0
        while i < buf.len {
            if buf[i] == 0 { count = count + 1 }
            i = i + 1
        }
        let names = alloc::resize([]u8, S){ realloc, &heap, mem = slice::empty([]u8){}, count } iferr err{ error } {
            _ = realloc{ &heap, mem = buf, new = 0, align = 1 }
            return error
        }
        let mut start: usize = 0
        let mut k: usize = 0
        i = 0
        while i < buf.len {
            if buf[i] == 0 {
                names[k] = buf[start..i]
                k = k + 1
                start = i + 1
            }
            i = i + 1
        }
        sort{ names }
        return names
    }

    // Reads the whole file at `path` into memory from `realloc`. The caller owns the result:
    // free it with `alloc::resize(u8, S){ realloc, &heap, mem = bytes, count = 0 }`.
    fn read_all(S) { mut fs: Fs, mut heap: S, realloc: alloc::Fn(S), path: []u8 } -> !alloc::Bytes {
        let file = try open{ &fs, path, mode = Mode::read }
        defer _ = close{ &fs, file }

        let mut buf = slice::empty(u8){}
        let mut n: usize = 0
        while true {
            if n == buf.len {
                let cap: usize = if buf.len == 0 { 4096 } else { buf.len * 2 }
                buf = match realloc{ &heap, mem = buf, new = cap, align = 1 } {
                    null => {
                        _ = realloc{ &heap, mem = buf, new = 0, align = 1 }
                        return alloc::out_of_memory
                    }
                    some{ value } => { value }
                }
            }
            let got = read{ &fs, file, into = buf[n..buf.len] } iferr err{ error } {
                _ = realloc{ &heap, mem = buf, new = 0, align = 1 }
                return error
            }
            if got == 0 { break }
            n = n + got
        }
        // Shrink to the contents, so that freeing the result frees the whole allocation.
        let exact = realloc{ &heap, mem = buf, new = n, align = 1 }
        if exact != null { return exact }
        return buf[..n]
    }

    // Creates or empties the file at `path` and writes `bytes` to it.
    fn write_all { mut fs: Fs, path: []u8, bytes: []u8 } -> !usize {
        let file = try open{ &fs, path, mode = Mode::write }
        defer _ = close{ &fs, file }
        return write{ &fs, file, bytes }
    }

    // Sorts names by their bytes, as unsigned numbers: insertion sort, since a directory's
    // entries are few.
    fn sort { names: []mut []u8 } {
        let mut i: usize = 1
        while i < names.len {
            let x = names[i]
            let mut j = i
            while j > 0 and before{ a = x, b = names[j - 1] } {
                names[j] = names[j - 1]
                j = j - 1
            }
            names[j] = x
            i = i + 1
        }
    }

    // Whether a comes before b: at the first byte they differ in, or as a prefix of it.
    fn before { a: []u8, b: []u8 } -> bool {
        let mut i: usize = 0
        while i < a.len and i < b.len {
            if a[i] != b[i] { return a[i] < b[i] }
            i = i + 1
        }
        return a.len < b.len
    }
}
