// std: fs. Files.
//
// Every function takes `mut fs: Fs`. Only `main` receives an `Fs`, from the runtime, so a
// function can touch the filesystem only if its caller passes it down.
//
//   fn main { mut io: Io, mut fs: Fs, args: Args } -> i32 {
//       let mut mem: [65536]u8
//       let mut heap = arena::new{ buf = mem[..] }
//       let path = args[0]
//       let text = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr { return 1 }
//       io::println{ &io, s = utf8::of{ chars = text } }
//       return 0
//   }
//
// Paths are bytes, relative to the working directory the program was started in. A function
// fails with the errors below that its body can produce (spec §8, Errors).
//
// Permission to use the filesystem.
capability Fs

namespace fs {
    // ---- the runtime's (ctxrt.c). Each returns a status: >= 0 is the result, < 0 an error
    // code that `failed` decodes.

    #c::symbol{ name = "ctx_fs_sys_open" }
    extern fn sys_open { mut fs: Fs, path: []u8, mode: u8 } -> i64             // a file id
    #c::symbol{ name = "ctx_fs_sys_read" }
    extern fn sys_read { mut fs: Fs, file: u32, into: []mut u8 } -> i64        // bytes read, 0 at the end
    #c::symbol{ name = "ctx_fs_sys_write" }
    extern fn sys_write { mut fs: Fs, file: u32, bytes: []u8 } -> i64          // bytes written
    #c::symbol{ name = "ctx_fs_sys_close" }
    extern fn sys_close { mut fs: Fs, file: u32 } -> i64
    #c::symbol{ name = "ctx_fs_sys_size" }
    extern fn sys_size { mut fs: Fs, path: []u8 } -> i64                       // size in bytes
    #c::symbol{ name = "ctx_fs_sys_remove" }
    extern fn sys_remove { mut fs: Fs, path: []u8 } -> i64
    // Directory `path`'s entry names, each followed by a zero byte, into `into` if they fit.
    // Returns the bytes they take.
    #c::symbol{ name = "ctx_fs_sys_list" }
    extern fn sys_list { mut fs: Fs, path: []u8, into: []mut u8 } -> i64
    #c::symbol{ name = "ctx_fs_sys_make_dir" }
    extern fn sys_make_dir { mut fs: Fs, path: []u8 } -> i64

    error not_found
    error permission_denied
    error is_directory
    error exists                // open with Mode::create, and the file is already there
    error not_directory         // a directory in the path is a file
    error bad_file              // the file is closed
    error out_of_memory         // read_all's or list's allocator failed
    error other{ code: i64 }    // the OS's error number

    union Mode {
        read,       // an existing file
        write,      // creates the file, or empties an existing one
        append,     // creates the file, or writes after its end
        create,     // creates the file; fails with `exists` if it is already there
    }

    struct File { id: u32 }

    fn open { mut fs: Fs, path: []u8, mode: Mode } -> !File {
        let m: u8 = match mode { read => { 0 } write => { 1 } append => { 2 } create => { 3 } }
        let r = sys_open{ &fs, path, mode = m }
        if r < 0 { return failed{ code = r } }
        return File{ id = @as(u32, r) }
    }

    // Reads at most into.len bytes into `into`. Returns how many; 0 at the end of the file.
    fn read { mut fs: Fs, file: File, into: []mut u8 } -> !usize {
        let r = sys_read{ &fs, file = file.id, into }
        if r < 0 { return failed{ code = r } }
        return @as(usize, r)
    }

    // Writes all of `bytes`.
    fn write { mut fs: Fs, file: File, bytes: []u8 } -> !usize {
        let mut done: usize = 0
        while done < bytes.len {
            let r = sys_write{ &fs, file = file.id, bytes = bytes[done..bytes.len] }
            if r < 0 { return failed{ code = r } }
            done = done + @as(usize, r)
        }
        return done
    }

    // Files still open when the program ends are closed then.
    fn close { mut fs: Fs, file: File } -> ! {
        let r = sys_close{ &fs, file = file.id }
        if r < 0 { return failed{ code = r } }
    }

    // The size of the file at `path`, in bytes.
    fn size { mut fs: Fs, path: []u8 } -> !u64 {
        let r = sys_size{ &fs, path }
        if r < 0 { return failed{ code = r } }
        return @as(u64, r)
    }

    // Deletes the file at `path`.
    fn remove { mut fs: Fs, path: []u8 } -> ! {
        let r = sys_remove{ &fs, path }
        if r < 0 { return failed{ code = r } }
    }

    // Creates directory `path`; fails with `exists` if something is there already.
    fn make_dir { mut fs: Fs, path: []u8 } -> ! {
        let r = sys_make_dir{ &fs, path }
        if r < 0 { return failed{ code = r } }
    }

    // The names of directory `path`'s entries, without "." and "..", sorted by their bytes. They
    // are in memory from `realloc`, in two allocations: the names' bytes, and the slice of them.
    fn list(S) { mut fs: Fs, mut heap: S, realloc: alloc::Fn(S), path: []u8 } -> ![][]u8 {
        let mut buf = slice::empty(u8){}
        while true {
            let r = sys_list{ &fs, path, into = buf }
            if r < 0 {
                _ = realloc{ &heap, mem = buf, new = 0, align = 1 }
                return failed{ code = r }
            }
            let n = @as(usize, r)
            if n <= buf.len {
                buf = buf[..n]
                break
            }
            // The entries didn't fit, or the directory grew since: try again with room for them.
            buf = match realloc{ &heap, mem = buf, new = n, align = 1 } {
                null => {
                    _ = realloc{ &heap, mem = buf, new = 0, align = 1 }
                    return out_of_memory
                }
                some{ value } => { value }
            }
        }
        let mut count: usize = 0
        let mut i: usize = 0
        while i < buf.len {
            if buf[i] == 0 { count = count + 1 }
            i = i + 1
        }
        let names = alloc::resize([]u8, S){ realloc, &heap, mem = slice::empty([]u8){}, count } ifnull {
            _ = realloc{ &heap, mem = buf, new = 0, align = 1 }
            return out_of_memory
        }
        let mut start: usize = 0
        let mut k: usize = 0
        i = 0
        while i < buf.len {
            if buf[i] == 0 {
                names[k] = buf[start..i]
                k = k + 1
                start = i + 1
            }
            i = i + 1
        }
        return names
    }

    // Reads the whole file at `path` into memory from `realloc`. The caller owns the result:
    // free it with `alloc::resize(u8, S){ realloc, &heap, mem = bytes, count = 0 }`.
    fn read_all(S) { mut fs: Fs, mut heap: S, realloc: alloc::Fn(S), path: []u8 } -> !alloc::Bytes {
        let file = try open{ &fs, path, mode = Mode::read }
        defer _ = close{ &fs, file }

        let mut buf = slice::empty(u8){}
        let mut n: usize = 0
        while true {
            if n == buf.len {
                let cap: usize = if buf.len == 0 { 4096 } else { buf.len * 2 }
                buf = match realloc{ &heap, mem = buf, new = cap, align = 1 } {
                    null => {
                        _ = realloc{ &heap, mem = buf, new = 0, align = 1 }
                        return out_of_memory
                    }
                    some{ value } => { value }
                }
            }
            let got = read{ &fs, file, into = buf[n..buf.len] } iferr err{ error } {
                _ = realloc{ &heap, mem = buf, new = 0, align = 1 }
                return error
            }
            if got == 0 { break }
            n = n + got
        }
        // Shrink to the contents, so that freeing the result frees the whole allocation.
        let exact = realloc{ &heap, mem = buf, new = n, align = 1 }
        if exact != null { return exact }
        return buf[..n]
    }

    // Creates or empties the file at `path` and writes `bytes` to it.
    fn write_all { mut fs: Fs, path: []u8, bytes: []u8 } -> !usize {
        let file = try open{ &fs, path, mode = Mode::write }
        defer _ = close{ &fs, file }
        return write{ &fs, file, bytes }
    }

    // The error for a native's negative status, as a failed result of any type.
    fn failed(T) { code: i64 } -> !T {
        if code == -1 { return not_found }
        if code == -2 { return permission_denied }
        if code == -3 { return is_directory }
        if code == -4 { return exists }
        if code == -5 { return not_directory }
        if code == -6 { return bad_file }
        return other{ code = -1000 - code }
    }
}
