// std: list. A growable list, generic over the element type T and the allocator state S.
//
//   let mut xs = list::new(i32){ realloc = arena::alloc, &heap }
//   if not list::push{ list = &xs, item = 42 } { @panic("out of memory") }
//
// A list keeps a pointer to its allocator's state, so it always allocates from the same state,
// and it must not outlive it.

namespace list {
    struct List(T, S) {
        items:   []mut T,           // capacity is items.len
        len:     usize,
        realloc: alloc::Fn(S),      // `fn`, not `&fn`: a bound function can't be stored here
        heap:    *mut S,            // the allocator's state
    }

    fn new(T, S) { realloc: alloc::Fn(S), heap: *mut S } -> List(T, S) {
        return List{ items = slice::empty(T){}, len = 0, realloc, heap }
    }

    // Ensures room for `extra` more items. Returns false on allocation failure.
    fn reserve(T, S) { mut list: List(T, S), extra: usize } -> bool {
        let need = list.len + extra
        if need <= list.items.len { return true }

        let mut cap = list.items.len
        if cap == 0 { cap = 4 }
        while cap < need { cap = cap * 2 }

        let items = alloc::resize{ realloc = list.realloc, heap = list.heap, mem = list.items, count = cap }
        match items {
            null          => { return false }
            some{ value } => { list.items = value }
        }
        return true
    }

    // Returns false on allocation failure.
    fn push(T, S) { mut list: List(T, S), item: T } -> bool {
        if not reserve{ extra = 1, .. } { return false }   // `..` forwards &list
        list.items[list.len] = item
        list.len = list.len + 1
        return true
    }

    fn pop(T, S) { mut list: List(T, S) } -> ?T {
        if list.len == 0 { return null }
        list.len = list.len - 1
        return list.items[list.len]    // T converts to ?T
    }

    fn get(T, S) { list: List(T, S), i: usize } -> ?T {
        if i >= list.len { return null }
        return list.items[i]
    }

    fn set(T, S) { mut list: List(T, S), i: usize, item: T } -> bool {
        if i >= list.len { return false }
        list.items[i] = item
        return true
    }

    // Bounds-checked against len, not capacity.
    fn at(T, S) { list: List(T, S), i: usize } -> *mut T {
        if i >= list.len { @panic("list::at: index out of bounds") }
        return &list.items[i]
    }

    // The first `len` items. Invalidated by the next call that may reallocate.
    fn items(T, S) { list: List(T, S) } -> []mut T {
        return list.items[..list.len]
    }

    fn clear(T, S) { mut list: List(T, S) } {
        list.len = 0
    }

    // `&fn` accepts both bound and unbound functions.
    fn each(T, S) { list: List(T, S), f: &fn{ item: T } } {
        let mut i: usize = 0
        while i < list.len {
            f{ item = list.items[i] }
            i = i + 1
        }
    }

    fn free(T, S) { mut list: List(T, S) } {
        _ = alloc::resize{ realloc = list.realloc, heap = list.heap, mem = list.items, count = 0 }
        list.items = slice::empty(T){}
        list.len = 0
    }
}
