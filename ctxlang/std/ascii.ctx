// std: ascii. ASCII text.
//
// `String` is a view of bytes that are all below 128. Like a slice, it doesn't own its memory:
// build one over a string literal, a buffer, or a `Builder`.
//
//   let hi = "hello"                        // a [5]u8 value
//   let s = ascii::of{ chars = &hi }        // an ascii::String viewing it
//
// Natives (provided by the runtime):
//   f64_digits { n: f64, into: slice::Slice(u8) } -> usize   writes the shortest round-trip text
//   f32_digits { n: f32, into: slice::Slice(u8) } -> usize   of n into `into`; panics if it doesn't fit
//   f64_parse  { text: slice::Slice(u8) } -> f64    the nearest value to `text`, which must already
//   f32_parse  { text: slice::Slice(u8) } -> f32    be valid float syntax (see parse_f64)

namespace ascii {
    struct String { bytes: slice::Slice(u8) }

    // Panics if any byte isn't ASCII.
    fn from { bytes: slice::Slice(u8) } -> String {
        let mut i: usize = 0
        while (i < bytes.len) {
            if (slice::get{ s = bytes, i } > 127) { @panic("ascii::from: byte is not ASCII") }
            i = i + 1
        }
        return String{ bytes }
    }

    // Views the byte array `chars` points to, typically a string literal.
    fn of(A) { chars: *A } -> String {
        return from{ bytes = slice::of(u8){ a = chars } }
    }

    fn empty {} -> String {
        return String{ bytes = slice::empty(u8){} }
    }

    fn len { s: String } -> usize {
        return s.bytes.len
    }

    // Bounds-checked.
    fn at { s: String, i: usize } -> u8 {
        return slice::get{ s = s.bytes, i }
    }

    // Characters lo up to but not including hi.
    fn sub { s: String, lo: usize, hi: usize } -> String {
        return String{ bytes = slice::sub{ s = s.bytes, lo, hi } }
    }

    fn eq { a: String, b: String } -> bool {
        if (a.bytes.len != b.bytes.len) { return false }
        let mut i: usize = 0
        while (i < a.bytes.len) {
            if (at{ s = a, i } != at{ s = b, i }) { return false }
            i = i + 1
        }
        return true
    }

    fn starts_with { s: String, prefix: String } -> bool {
        if (prefix.bytes.len > s.bytes.len) { return false }
        return eq{ a = sub{ s, lo = 0, hi = prefix.bytes.len }, b = prefix }
    }

    fn ends_with { s: String, suffix: String } -> bool {
        let n = s.bytes.len
        if (suffix.bytes.len > n) { return false }
        return eq{ a = sub{ s, lo = n - suffix.bytes.len, hi = n }, b = suffix }
    }

    // Index of the first `c`, or null.
    fn find { s: String, c: u8 } -> ?usize {
        let mut i: usize = 0
        while (i < s.bytes.len) {
            if (at{ s, i } == c) { return i }
            i = i + 1
        }
        return null
    }

    // Index of the first occurrence of `needle`, or null. An empty needle is found at 0.
    fn find_str { s: String, needle: String } -> ?usize {
        let n = needle.bytes.len
        if (n > s.bytes.len) { return null }
        let mut i: usize = 0
        while (i + n <= s.bytes.len) {
            if (eq{ a = sub{ s, lo = i, hi = i + n }, b = needle }) { return i }
            i = i + 1
        }
        return null
    }

    // The text before and after the first `c`, or null if there is none.
    //   split_once{ s = "key=value", c = '=' }  ->  head "key", tail "value"
    struct Split { head: String, tail: String }

    fn split_once { s: String, c: u8 } -> ?Split {
        let i = find{ s, c }
        if (i != null) {
            return Split{ head = sub{ s, lo = 0, hi = i }, tail = sub{ s, lo = i + 1, hi = s.bytes.len } }
        }
        return null
    }

    // Without leading and trailing whitespace.
    fn trim { s: String } -> String {
        return trim_end{ s = trim_start{ s } }
    }

    fn trim_start { s: String } -> String {
        let mut lo: usize = 0
        while (lo < s.bytes.len and is_space{ c = at{ s, i = lo } }) { lo = lo + 1 }
        return sub{ s, lo, hi = s.bytes.len }
    }

    fn trim_end { s: String } -> String {
        let mut hi = s.bytes.len
        while (hi > 0 and is_space{ c = at{ s, i = hi - 1 } }) { hi = hi - 1 }
        return sub{ s, lo = 0, hi }
    }

    // ---- characters

    fn is_digit { c: u8 } -> bool { return c >= '0' and c <= '9' }
    fn is_upper { c: u8 } -> bool { return c >= 'A' and c <= 'Z' }
    fn is_lower { c: u8 } -> bool { return c >= 'a' and c <= 'z' }
    fn is_alpha { c: u8 } -> bool { return is_upper{ c } or is_lower{ c } }
    fn is_alnum { c: u8 } -> bool { return is_alpha{ c } or is_digit{ c } }
    fn is_space { c: u8 } -> bool { return c == ' ' or c == '\t' or c == '\n' or c == '\r' }

    fn to_upper { c: u8 } -> u8 {
        if (is_lower{ c }) { return c - 32 }
        return c
    }

    fn to_lower { c: u8 } -> u8 {
        if (is_upper{ c }) { return c + 32 }
        return c
    }

    // ---- numbers

    // Parses an optional '-' followed by decimal digits. Null if malformed or out of range.
    fn parse_i64 { s: String } -> ?i64 {
        let n = s.bytes.len
        if (n == 0) { return null }
        let mut i: usize = 0
        let neg = at{ s, i = 0 } == '-'
        if (neg) {
            if (n == 1) { return null }
            i = 1
        }
        // Accumulate negatively so that i64's minimum is reachable.
        let min: i64 = -9223372036854775808
        let mut v: i64 = 0
        while (i < n) {
            let c = at{ s, i }
            if (not is_digit{ c }) { return null }
            let d = @as(i64, c - '0')
            if (v < (min + d) / 10) { return null }
            v = v * 10 - d
            i = i + 1
        }
        if (neg) { return v }
        if (v == min) { return null }
        return -v
    }

    // Parses decimal digits. Null if malformed or out of range.
    fn parse_u64 { s: String } -> ?u64 {
        let n = s.bytes.len
        if (n == 0) { return null }
        let max: u64 = 18446744073709551615
        let mut v: u64 = 0
        let mut i: usize = 0
        while (i < n) {
            let c = at{ s, i }
            if (not is_digit{ c }) { return null }
            let d = @as(u64, c - '0')
            if (v > (max - d) / 10) { return null }
            v = v * 10 + d
            i = i + 1
        }
        return v
    }

    const F64_MAX: f64 = 1.7976931348623157e308
    const F32_MAX: f32 = 3.4028234663852886e38

    // Parses decimal text such as "3", "-0.25", "1e+100" or "6.02E23", and "inf", "-inf" and
    // "nan", so that it reads back everything fmt_f64 writes. Rounds to the nearest f64. Null if
    // malformed, or if a number is too large for f64.
    fn parse_f64 { s: String } -> ?f64 {
        if (is_float_word{ s }) { return f64_parse{ text = s.bytes } }
        if (not is_float_number{ s }) { return null }
        let v = f64_parse{ text = s.bytes }
        if (v > F64_MAX or v < -F64_MAX) { return null }
        return v
    }

    // Like parse_f64, rounding once, directly to the nearest f32.
    fn parse_f32 { s: String } -> ?f32 {
        if (is_float_word{ s }) { return f32_parse{ text = s.bytes } }
        if (not is_float_number{ s }) { return null }
        let v = f32_parse{ text = s.bytes }
        if (v > F32_MAX or v < -F32_MAX) { return null }
        return v
    }

    // "inf", "-inf" or "nan".
    fn is_float_word { s: String } -> bool {
        let inf = "inf"
        let minus_inf = "-inf"
        let nan = "nan"
        if (eq{ a = s, b = of{ chars = &inf } } or eq{ a = s, b = of{ chars = &nan } }) { return true }
        return eq{ a = s, b = of{ chars = &minus_inf } }
    }

    // An optional '-', digits, optionally '.' and digits, optionally 'e' or 'E', an optional sign
    // and digits.
    fn is_float_number { s: String } -> bool {
        let mut cur = cursor{ s }
        eat{ &cur, ch = '-' }
        if (take_while{ &cur, f = is_digit }.bytes.len == 0) { return false }
        if (eat{ &cur, ch = '.' }) {
            if (take_while{ &cur, f = is_digit }.bytes.len == 0) { return false }
        }
        if (eat{ &cur, ch = 'e' } or eat{ &cur, ch = 'E' }) {
            if (not eat{ &cur, ch = '+' }) { eat{ &cur, ch = '-' } }
            if (take_while{ &cur, f = is_digit }.bytes.len == 0) { return false }
        }
        return done{ cur }
    }

    // Writes n in decimal to the start of `into` and returns that text. Panics if it doesn't fit;
    // 20 bytes always do.
    fn fmt_i64 { n: i64, into: slice::Slice(u8) } -> String {
        let mut digits: [20]u8
        let mut k: usize = 0
        let mut v = n
        if (v > 0) { v = -v }                     // work in negatives so i64's minimum fits
        while (true) {
            digits[k] = '0' + @as(u8, -(v % 10))
            k = k + 1
            v = v / 10
            if (v == 0) { break }
        }
        let mut out: usize = 0
        if (n < 0) {
            slice::set{ s = into, i = 0, v = '-' }
            out = 1
        }
        let total = out + k
        if (total > into.len) { @panic("ascii::fmt_i64: buffer too small") }
        while (k > 0) {
            k = k - 1
            slice::set{ s = into, i = out, v = digits[k] }
            out = out + 1
        }
        return String{ bytes = slice::sub{ s = into, lo = 0, hi = total } }
    }

    // Like fmt_i64, for unsigned values.
    fn fmt_u64 { n: u64, into: slice::Slice(u8) } -> String {
        let mut digits: [20]u8
        let mut k: usize = 0
        let mut v = n
        while (true) {
            digits[k] = '0' + @trunc(u8, v % 10)
            k = k + 1
            v = v / 10
            if (v == 0) { break }
        }
        if (k > into.len) { @panic("ascii::fmt_u64: buffer too small") }
        let total = k
        let mut out: usize = 0
        while (k > 0) {
            k = k - 1
            slice::set{ s = into, i = out, v = digits[k] }
            out = out + 1
        }
        return String{ bytes = slice::sub{ s = into, lo = 0, hi = total } }
    }

    // Shortest text that reads back as n, e.g. "0.1", "3.0", "1e+100", "inf", "nan".
    // 32 bytes always fit.
    fn fmt_f64 { n: f64, into: slice::Slice(u8) } -> String {
        return String{ bytes = slice::sub{ s = into, lo = 0, hi = f64_digits{ n, into } } }
    }

    fn fmt_f32 { n: f32, into: slice::Slice(u8) } -> String {
        return String{ bytes = slice::sub{ s = into, lo = 0, hi = f32_digits{ n, into } } }
    }

    // ---- scanning

    // A read position in a String, for hand-written lexers and parsers.
    //
    //   let mut cur = ascii::cursor{ s = line }
    //   ascii::skip_space{ &cur }
    //   let name = ascii::take_while{ &cur, f = ascii::is_alpha }
    //   if (ascii::eat{ &cur, ch = '=' }) { ... }
    struct Cursor { s: String, pos: usize }

    fn cursor { s: String } -> Cursor {
        return Cursor{ s, pos = 0 }
    }

    fn done { cur: Cursor } -> bool {
        return cur.pos >= cur.s.bytes.len
    }

    // The unread text.
    fn rest { cur: Cursor } -> String {
        return sub{ s = cur.s, lo = cur.pos, hi = cur.s.bytes.len }
    }

    // The next character without consuming it, or null at the end.
    fn peek { cur: Cursor } -> ?u8 {
        return peek_at{ cur, ahead = 0 }
    }

    // The character `ahead` places past the next one, or null past the end.
    fn peek_at { cur: Cursor, ahead: usize } -> ?u8 {
        let i = cur.pos + ahead
        if (i >= cur.s.bytes.len) { return null }
        return at{ s = cur.s, i }
    }

    // Consumes and returns the next character, or null at the end.
    fn bump { mut cur: Cursor } -> ?u8 {
        if (done{ cur }) { return null }
        cur.pos = cur.pos + 1
        return at{ s = cur.s, i = cur.pos - 1 }
    }

    // Consumes `ch` if it is next.
    fn eat { mut cur: Cursor, ch: u8 } -> bool {
        if (done{ cur } or at{ s = cur.s, i = cur.pos } != ch) { return false }
        cur.pos = cur.pos + 1
        return true
    }

    // Consumes `s` if the unread text starts with it.
    fn eat_str { mut cur: Cursor, s: String } -> bool {
        if (not starts_with{ s = rest{ cur }, prefix = s }) { return false }
        cur.pos = cur.pos + s.bytes.len
        return true
    }

    // Consumes characters while `f` accepts them and returns them. `f` may be a character test
    // such as `ascii::is_digit`.
    fn take_while { mut cur: Cursor, f: &fn{ c: u8 } -> bool } -> String {
        let lo = cur.pos
        while (not done{ cur } and f{ c = at{ s = cur.s, i = cur.pos } }) { cur.pos = cur.pos + 1 }
        return sub{ s = cur.s, lo, hi = cur.pos }
    }

    fn skip_space { mut cur: Cursor } {
        take_while{ &cur, f = is_space }
    }

    // ---- building strings

    // A growable string that owns its bytes, allocated like a list. Free it with `free`.
    //
    //   let mut b = ascii::builder{ realloc = arena::alloc }
    //   ascii::push{ &b, &heap, s = name }
    //   ascii::push_i64{ &b, &heap, n = 42 }
    //   io::println{ &io, s = ascii::view{ b } }
    struct Builder(S) { chars: list::List(u8, S) }

    fn builder(S) { realloc: alloc::Fn(S) } -> Builder(S) {
        return Builder{ chars = list::new(u8){ realloc } }
    }

    // The text so far. Invalidated by the next push.
    fn view(S) { b: Builder(S) } -> String {
        return String{ bytes = list::items{ list = b.chars } }
    }

    // Each push returns false on allocation failure.
    fn push(S) { mut b: Builder(S), mut heap: S, s: String } -> bool {
        if (not list::reserve{ list = &b.chars, &heap, extra = s.bytes.len }) { return false }
        let mut i: usize = 0
        while (i < s.bytes.len) {
            list::push{ list = &b.chars, &heap, item = at{ s, i } }
            i = i + 1
        }
        return true
    }

    // Panics if c isn't ASCII.
    fn push_char(S) { mut b: Builder(S), mut heap: S, c: u8 } -> bool {
        if (c > 127) { @panic("ascii::push_char: character is not ASCII") }
        return list::push{ list = &b.chars, &heap, item = c }
    }

    fn push_i64(S) { mut b: Builder(S), mut heap: S, n: i64 } -> bool {
        let mut buf: [20]u8
        return push{ &b, &heap, s = fmt_i64{ n, into = slice::of(u8){ a = &buf } } }
    }

    fn push_u64(S) { mut b: Builder(S), mut heap: S, n: u64 } -> bool {
        let mut buf: [20]u8
        return push{ &b, &heap, s = fmt_u64{ n, into = slice::of(u8){ a = &buf } } }
    }

    fn push_f64(S) { mut b: Builder(S), mut heap: S, n: f64 } -> bool {
        let mut buf: [32]u8
        return push{ &b, &heap, s = fmt_f64{ n, into = slice::of(u8){ a = &buf } } }
    }

    fn push_f32(S) { mut b: Builder(S), mut heap: S, n: f32 } -> bool {
        let mut buf: [32]u8
        return push{ &b, &heap, s = fmt_f32{ n, into = slice::of(u8){ a = &buf } } }
    }

    fn clear(S) { mut b: Builder(S) } {
        list::clear{ list = &b.chars }
    }

    fn free(S) { mut b: Builder(S), mut heap: S } {
        list::free{ list = &b.chars, &heap }
    }
}
