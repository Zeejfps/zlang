// std: ascii. Byte-level character tests.
//
// Text is `utf8::String`. These functions look at single bytes, for code that scans `[]u8`
// directly; `utf8` has the same tests for a `u32` character.

namespace ascii {
    // ---- C's (ctxc/rt/ctxfloat.c), used by `utf8`'s number formatting and parsing, which a
    // program links only if it uses them. They are pure, so they take no capability.

    // Write the shortest round-trip text of n into `into`; panic if it doesn't fit.
    #c::symbol{ name = "ctx_float_f64_digits" }
    extern fn f64_digits { n: f64, into: []mut u8 } -> usize
    #c::symbol{ name = "ctx_float_f32_digits" }
    extern fn f32_digits { n: f32, into: []mut u8 } -> usize

    // The nearest value to `text`, which must already be valid float syntax (see
    // utf8::parse_f64).
    #c::symbol{ name = "ctx_float_f64_parse" }
    extern fn f64_parse { text: []u8 } -> f64
    #c::symbol{ name = "ctx_float_f32_parse" }
    extern fn f32_parse { text: []u8 } -> f32

    fn is_digit { c: u8 } -> bool { return c >= '0' and c <= '9' }
    fn is_upper { c: u8 } -> bool { return c >= 'A' and c <= 'Z' }
    fn is_lower { c: u8 } -> bool { return c >= 'a' and c <= 'z' }
    fn is_alpha { c: u8 } -> bool { return is_upper{ c } or is_lower{ c } }
    fn is_alnum { c: u8 } -> bool { return is_alpha{ c } or is_digit{ c } }
    fn is_space { c: u8 } -> bool { return c == ' ' or c == '\t' or c == '\n' or c == '\r' }

    fn to_upper { c: u8 } -> u8 {
        if is_lower{ c } { return c - 32 }
        return c
    }

    fn to_lower { c: u8 } -> u8 {
        if is_upper{ c } { return c + 32 }
        return c
    }
}
