// std: io. Console input and output.
//
// Every function takes `mut io: Io`. Only `main` receives an `Io`, from the runtime, so a
// function can do IO only if its caller passes it down.
//
//   fn main { mut io: Io } {
//       io::println{ &io, s = "hello, world" }
//       io::println_i64{ &io, n = 42 }
//   }
//
// print* functions write their value only. println* functions add a newline.

// Permission to use the console.
capability Io

namespace io {
    enum Stream: u32 { out, err }

    // Standard output's buffer, in std's state for the whole program (rt::State), since a panic
    // and the program's end flush it too: the bytes in buf[..len] are waiting to be written.
    struct Out { buf: []mut u8, len: usize }

    fn out_buffer { mut io: Io } -> *mut Out {
        let s = rt::state{ &io }
        if s.out.buf.len == 0 { s.out.buf = s.out_bytes[..] }
        return &s.out
    }

    // Writes bytes to standard output or standard error. Standard output is buffered, and written
    // out before anything goes to standard error or is read from standard input.
    fn write { mut io: Io, to: Stream, bytes: []u8 } {
        if bytes.len == 0 { return }
        if to == Stream::err {
            flush{ &io }
            put{ &io, to, bytes }
            return
        }
        let b = out_buffer{ &io }
        if b.len + bytes.len > b.buf.len { flush{ &io } }
        if bytes.len > b.buf.len {
            put{ &io, to, bytes }
            return
        }
        slice::copy(u8){ dst = b.buf[b.len..b.len + bytes.len], src = bytes }
        b.len = b.len + bytes.len
    }

    // Reads at most into.len bytes of standard input into `into`. Returns how many; 0 at the end.
    fn read { mut io: Io, into: []mut u8 } -> usize {
        if into.len == 0 { return 0 }
        flush{ &io }
        return os::read{ &io, into }
    }

    // Writes standard output's buffer out.
    fn flush { mut io: Io } {
        let b = out_buffer{ &io }
        let n = b.len
        b.len = 0
        put{ &io, to = Stream::out, bytes = b.buf[..n] }
    }

    // Writes all of `bytes` through the platform's layer (std/os), or as much as it takes before
    // an error.
    fn put { mut io: Io, to: Stream, bytes: []u8 } {
        let mut done: usize = 0
        while done < bytes.len {
            let n = os::write{ &io, to, bytes = bytes[done..bytes.len] }
            if n == 0 { return }
            done = done + n
        }
    }

    // ---- text

    fn print { mut io: Io, s: utf8::String } {
        write{ &io, to = Stream::out, bytes = s.bytes }
    }

    fn println { mut io: Io, s: utf8::String } {
        print{ &io, s }
        newline{ &io }
    }

    // To standard error.
    fn eprint { mut io: Io, s: utf8::String } {
        write{ &io, to = Stream::err, bytes = s.bytes }
    }

    fn eprintln { mut io: Io, s: utf8::String } {
        eprint{ &io, s }
        write{ &io, to = Stream::err, bytes = "\n" }
    }

    fn newline { mut io: Io } {
        write{ &io, to = Stream::out, bytes = "\n" }
    }

    // Writes one character. Panics if c isn't a Unicode scalar value.
    fn put_char { mut io: Io, c: u32 } {
        let mut buf: [4]u8
        print{ &io, s = utf8::encode{ c, into = buf[..] } }
    }

    // ---- numbers
    //
    // Smaller types widen implicitly: print_i64 takes any signed integer or u8..u32, print_u64
    // any unsigned integer, print_f64 an f32 too. print_f32 prints an f32's own shortest text.

    fn print_i64 { mut io: Io, n: i64 } {
        let mut buf: [20]u8
        print{ &io, s = utf8::fmt_i64{ n, into = buf[..] } }
    }

    fn print_u64 { mut io: Io, n: u64 } {
        let mut buf: [20]u8
        print{ &io, s = utf8::fmt_u64{ n, into = buf[..] } }
    }

    fn print_f64 { mut io: Io, n: f64 } {
        let mut buf: [32]u8
        print{ &io, s = utf8::fmt_f64{ n, into = buf[..] } }
    }

    fn print_f32 { mut io: Io, n: f32 } {
        let mut buf: [32]u8
        print{ &io, s = utf8::fmt_f32{ n, into = buf[..] } }
    }

    fn print_bool { mut io: Io, n: bool } {
        if n {
            print{ &io, s = "true" }
        } else {
            print{ &io, s = "false" }
        }
    }

    fn println_i64  { mut io: Io, n: i64 }  { print_i64{ &io, n };  newline{ &io } }
    fn println_u64  { mut io: Io, n: u64 }  { print_u64{ &io, n };  newline{ &io } }
    fn println_f64  { mut io: Io, n: f64 }  { print_f64{ &io, n };  newline{ &io } }
    fn println_f32  { mut io: Io, n: f32 }  { print_f32{ &io, n };  newline{ &io } }
    fn println_bool { mut io: Io, n: bool } { print_bool{ &io, n }; newline{ &io } }

    // ---- @fmt onto the console (spec §13)
    //
    //   _ = @fmt(&io, "{} files, {} bytes\n", n, size)        // standard output
    //   let mut err = io::to_stderr{ &io }
    //   _ = @fmt(&err, "{}: {}\n", path, e)                    // standard error
    //
    // A writer for each type a hole may have: every integer type, f32, f64, bool, utf8::String,
    // []u8 (bytes, as they are), c::String and strlit; a []mut u8 takes the []u8 one. They don't
    // fail, but an @fmt's result is still a `!` to discard. A program's own writer of a type to
    // an Io replaces std's (§13).

    // Standard error, as an @fmt sink.
    struct Stderr { io: *mut Io }

    fn to_stderr { mut io: Io } -> Stderr {
        return Stderr{ io = &io }
    }

    #write
    fn write_text { mut io: Io, s: strlit } { write{ &io, to = Stream::out, bytes = s.bytes } }
    #write
    fn write_string { mut io: Io, s: utf8::String } { write{ &io, to = Stream::out, bytes = s.bytes } }
    #write
    fn write_bytes { mut io: Io, b: []u8 } { write{ &io, to = Stream::out, bytes = b } }
    #write
    fn write_cstring { mut io: Io, s: c::String } { write{ &io, to = Stream::out, bytes = c::bytes{ s } } }
    #write
    fn write_bool { mut io: Io, v: bool } { emit_bool{ &io, to = Stream::out, v } }
    #write
    fn write_i8 { mut io: Io, n: i8 } { emit_i64{ &io, to = Stream::out, n } }
    #write
    fn write_i16 { mut io: Io, n: i16 } { emit_i64{ &io, to = Stream::out, n } }
    #write
    fn write_i32 { mut io: Io, n: i32 } { emit_i64{ &io, to = Stream::out, n } }
    #write
    fn write_i64 { mut io: Io, n: i64 } { emit_i64{ &io, to = Stream::out, n } }
    #write
    fn write_u8 { mut io: Io, n: u8 } { emit_u64{ &io, to = Stream::out, n } }
    #write
    fn write_u16 { mut io: Io, n: u16 } { emit_u64{ &io, to = Stream::out, n } }
    #write
    fn write_u32 { mut io: Io, n: u32 } { emit_u64{ &io, to = Stream::out, n } }
    #write
    fn write_u64 { mut io: Io, n: u64 } { emit_u64{ &io, to = Stream::out, n } }
    #write
    fn write_usize { mut io: Io, n: usize } { emit_u64{ &io, to = Stream::out, n } }
    #write
    fn write_f32 { mut io: Io, n: f32 } { emit_f32{ &io, to = Stream::out, n } }
    #write
    fn write_f64 { mut io: Io, n: f64 } { emit_f64{ &io, to = Stream::out, n } }

    #write
    fn ewrite_text { mut e: Stderr, s: strlit } { write{ io = e.io, to = Stream::err, bytes = s.bytes } }
    #write
    fn ewrite_string { mut e: Stderr, s: utf8::String } { write{ io = e.io, to = Stream::err, bytes = s.bytes } }
    #write
    fn ewrite_bytes { mut e: Stderr, b: []u8 } { write{ io = e.io, to = Stream::err, bytes = b } }
    #write
    fn ewrite_cstring { mut e: Stderr, s: c::String } { write{ io = e.io, to = Stream::err, bytes = c::bytes{ s } } }
    #write
    fn ewrite_bool { mut e: Stderr, v: bool } { emit_bool{ io = e.io, to = Stream::err, v } }
    #write
    fn ewrite_i8 { mut e: Stderr, n: i8 } { emit_i64{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_i16 { mut e: Stderr, n: i16 } { emit_i64{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_i32 { mut e: Stderr, n: i32 } { emit_i64{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_i64 { mut e: Stderr, n: i64 } { emit_i64{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_u8 { mut e: Stderr, n: u8 } { emit_u64{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_u16 { mut e: Stderr, n: u16 } { emit_u64{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_u32 { mut e: Stderr, n: u32 } { emit_u64{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_u64 { mut e: Stderr, n: u64 } { emit_u64{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_usize { mut e: Stderr, n: usize } { emit_u64{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_f32 { mut e: Stderr, n: f32 } { emit_f32{ io = e.io, to = Stream::err, n } }
    #write
    fn ewrite_f64 { mut e: Stderr, n: f64 } { emit_f64{ io = e.io, to = Stream::err, n } }

    fn emit_i64 { mut io: Io, to: Stream, n: i64 } {
        let mut buf: [20]u8
        write{ &io, to, bytes = utf8::fmt_i64{ n, into = buf[..] }.bytes }
    }

    fn emit_u64 { mut io: Io, to: Stream, n: u64 } {
        let mut buf: [20]u8
        write{ &io, to, bytes = utf8::fmt_u64{ n, into = buf[..] }.bytes }
    }

    fn emit_f64 { mut io: Io, to: Stream, n: f64 } {
        let mut buf: [32]u8
        write{ &io, to, bytes = utf8::fmt_f64{ n, into = buf[..] }.bytes }
    }

    fn emit_f32 { mut io: Io, to: Stream, n: f32 } {
        let mut buf: [32]u8
        write{ &io, to, bytes = utf8::fmt_f32{ n, into = buf[..] }.bytes }
    }

    fn emit_bool { mut io: Io, to: Stream, v: bool } {
        let s: []u8 = if v { "true" } else { "false" }
        write{ &io, to, bytes = s }
    }

    // ---- input

    // Reads one line into `into` and returns it without its line ending. Null at the end of input.
    // A line longer than `into` comes back in pieces. Bytes that aren't valid UTF-8, including a
    // character cut in two by a piece boundary, become '?'.
    fn read_line { mut io: Io, into: []mut u8 } -> ?utf8::String {
        let mut n: usize = 0
        while n < into.len {
            let one = into[n..n + 1]
            if read{ &io, into = one } == 0 {
                if n == 0 { return null }
                break
            }
            if one[0] == '\n' {
                if n > 0 and into[n - 1] == '\r' { n = n - 1 }
                break
            }
            n = n + 1
        }
        let mut i: usize = 0
        while i < n {
            let k = utf8::seq_len{ bytes = into[..n], i }
            if k == 0 {
                into[i] = '?'
                i = i + 1
            } else {
                i = i + k
            }
        }
        return utf8::String{ bytes = into[..n] }
    }
}
