// std: task. Tasks: calls that may run concurrently with the code that started them (spec §15,
// Tasks; ctxlang/docs/internals.md, Tasks). A task is a call of a `#task` fn, made by a bind written in the
// start's call that supplies every field, so the call shows everything the task receives. Its
// handle is a local of the starter's, and the task never outlives the handle's scope: leaving it
// without waiting cancels the task and waits for it there.
//
//   fn load { mut fs: Fs, path: []u8, into: *mut Buffer } -> !usize { ... }
//
//   fn load_two { mut fs: Fs, mut threads: Threads, a: *mut Buffer, b: *mut Buffer } -> !usize {
//       let mut ta: task::Task(!usize)
//       let mut tb: task::Task(!usize)
//       task::start{ &threads, task = &ta, run = load{ &fs, path = "a.txt", into = a, _ } }
//       task::start{ &threads, task = &tb, run = load{ &fs, path = "b.txt", into = b, _ } }
//       let na = try task::wait{ &threads, task = &ta }
//       let nb = try task::wait{ &threads, task = &tb }
//       return na + nb
//   }
//
// The backend is Threaded: each running task has a worker, an operating-system thread, and a
// blocking call blocks it. Workers wait for their next task for 10 seconds, then end. Nothing
// waits for a free worker: `start` runs a task at once when it can't run it concurrently.
//
// A deadline is cancellation at a time, for the calls a function makes (run_within): every
// blocking call that a cancel stops fails with deadline_passed once it has passed, in a task or
// not, without a second task.
//
//   fn read_line { mut net: Net, socket: net::Socket, into: []mut u8 } -> !usize { ... }
//
//   let n = try task::run_within{ cancel = &net, nanoseconds = 5000000000, run = read_line{ &net, socket, into, _ } }

namespace task {
    // Whether the calling thread runs a task, and which: its slot, null outside a task. What
    // std's blocking calls check (check, get_cancel_object); only namespace task reads it. A
    // task run at once runs as part of its starter, with the starter's.
    //
    // And the calling thread's deadline (run_within), on the clock os::read_deadline_clock
    // reads; 0 for none. A thread's own, so that main's calls have one as a task's do; a
    // worker's is 0 when it begins a task, and a task run at once runs under its starter's.
    capability Cancel {
        #thread_local
        static current: ?*mut Slot,
        #thread_local
        static deadline: u64,
    }

    // The backend's state: the table of tasks (Table), made the first time it is needed.
    capability State {
        static table: Table
    }

    // A task's handle and, once it has ended, its result. Zero is no task, as `Task(R){ .. }` is:
    // no field is a setting (spec §15, Tasks, rule 4). Only a local, a local array's element, or
    // a `mut` field: never copied, so it never moves while its task writes its result into it.
    #loan_holder
    struct Task(R) {
        slot: u32,                  // the task's slot in the table, from 1, while RUNNING
        generation: u32,            // the slot's, when the task started in it
        state: u32,                 // NONE, RUNNING or ENDED (it ran at once: result holds its result)
        result: R,                  // the task's result, once it has ended
    }

    // Tasks that end together. Zero is an empty group whose first failure cancels the others, as
    // `Group{ .. }` is; `Group{ failures = Failures::keep, .. }` keeps its tasks' failures instead,
    // and `kept` bounds how many it holds at once (spec §15, Tasks, rule 4: these two are its
    // settings). The same places as a Task.
    #loan_holder
    struct Group {
        #setting
        failures: Failures,         // what a failing task does to the others
        #setting
        kept: u32,                  // keep: the most failures held at once; 0 means KEPT
        tasks: u32,                 // tasks of the group that haven't ended
        first: u32,                 // the slot of one of them, the head of their list; 0 if none
        failed: bool,               // stop: whether `error` holds the first error of its tasks
        cancelling: bool,           // whether it is being cancelled: new tasks start cancelled
        error: !,                   // stop: the first error of its tasks
        held: []mut error,          // keep: the failures held, a ring on std's heap; empty before the first
        oldest: u32,                // keep: the index in `held` of the oldest failure held
        count: u32,                 // keep: how many failures `held` holds
        dropped: u64,               // keep: failures not held, past the most or for want of memory
    }

    // What a group's failing task does to the others.
    enum Failures: u8 {
        stop,                       // the first failure is the group's: it cancels the others, and wait_all returns it
        keep,                       // a failure cancels nothing, and is held for wait_failure and wait_all_failures
    }

    const NONE: u32 = 0
    const RUNNING: u32 = 1
    const ENDED: u32 = 2

    error cancelled             // what a blocking call fails with, in a task that is cancelled
    error deadline_passed       // what a blocking call fails with once the deadline it runs under has passed (run_within)
    error out_of_resources      // no thread, or no room in the table

    // What a blocking call fails with when it stops before its operation is done: its task
    // was asked to stop, or its deadline passed. A cancel wins when both are so.
    type Stopped = error(cancelled, deadline_passed)

    // ---- the API

    // Runs `run`, maybe concurrently with the caller, maybe at once. Returns no error: when the
    // backend can't run it concurrently (no worker, the limit, or the table can't grow), it runs
    // it here, and `task` holds its result when start returns. `task` must be zero.
    fn start(R) { mut threads: Threads, mut task: Task(R), run: &thread fn{} -> R into task } {
        if task.state != NONE { rt::fail{ msg = "task::start into a handle that holds a task" } }
        if os::CONCURRENT {
            let t = table{ state = &threads }
            mutex::lock{ mutex = &t.lock }
            let limit = if t.limit_set { t.limit } else { LIMIT }
            if t.busy < limit {
                if let s = new_slot{ &threads, t } {
                    if let rec = new_record{ &threads, t, size = @record_size(run) } {
                        let entry = @record_copy(run, rec)
                        if begin_task{ &threads, t, s, entry, rec, result = @cast(*mut u8, &task.result), group = null } {
                            task.slot = s.id
                            task.generation = s.generation
                            task.state = RUNNING
                            mutex::unlock{ mutex = &t.lock }
                            return
                        }
                        free_record{ t, rec }
                    }
                    free_slot{ &threads, t, s }
                }
            }
            mutex::unlock{ mutex = &t.lock }
        }
        task.result = run{}
        task.state = ENDED
    }

    // Runs `run` concurrently with the caller, or fails, and `task` stays zero.
    fn start_concurrent(R) { mut threads: Threads, mut task: Task(R), run: &thread fn{} -> R into task } -> ! {
        if task.state != NONE { rt::fail{ msg = "task::start_concurrent into a handle that holds a task" } }
        if not os::CONCURRENT { os::concurrency_unsupported{ what = "task::start_concurrent and task::start_blocking" } }
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        defer mutex::unlock{ mutex = &t.lock }
        let s = new_slot{ &threads, t } ifnull { return out_of_resources }
        let rec = new_record{ &threads, t, size = @record_size(run) } ifnull {
            free_slot{ &threads, t, s }
            return out_of_resources
        }
        let entry = @record_copy(run, rec)
        if not begin_task{ &threads, t, s, entry, rec, result = @cast(*mut u8, &task.result), group = null } {
            free_record{ t, rec }
            free_slot{ &threads, t, s }
            return out_of_resources
        }
        task.slot = s.id
        task.generation = s.generation
        task.state = RUNNING
    }

    // Runs `run` on an operating-system thread of its own, in every backend: for work that
    // blocks outside std (a C call that waits, a lock held across IO) or computes for long. In
    // Threaded it is start_concurrent.
    fn start_blocking(R) { mut threads: Threads, mut task: Task(R), run: &thread fn{} -> R into task } -> ! {
        return start_concurrent(R){ &threads, &task, run }
    }

    // Waits for the task to end and gives its result; `task` is zero again.
    fn wait(R) { mut threads: Threads, mut task: Task(R) ends } -> R {
        if task.state == NONE { rt::fail{ msg = "task::wait on a handle that holds no task" } }
        if task.state == RUNNING {
            let t = table{ state = &threads }
            mutex::lock{ mutex = &t.lock }
            let s = slot_of{ t, id = task.slot, generation = task.generation }
            _ = await{ &threads, t, s, nanoseconds = FOREVER }
            free_slot{ &threads, t, s }
            mutex::unlock{ mutex = &t.lock }
        }
        task.state = NONE
        return task.result
    }

    // As `wait` without giving the result: true once the task has ended (then `wait` returns at
    // once), false when `nanoseconds` passed first. 0 looks without waiting.
    fn wait_for(R) { mut threads: Threads, mut task: Task(R), nanoseconds: u64 } -> bool {
        if task.state == NONE { rt::fail{ msg = "task::wait_for on a handle that holds no task" } }
        if task.state == ENDED { return true }
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        defer mutex::unlock{ mutex = &t.lock }
        let s = slot_of{ t, id = task.slot, generation = task.generation }
        return await{ &threads, t, s, nanoseconds }
    }

    // Asks the task to stop (Cancellation), waits for it to end, and gives its result, which is
    // usually `cancelled`; `task` is zero again.
    fn cancel(R) { mut threads: Threads, mut task: Task(R) ends } -> R {
        if task.state == NONE { rt::fail{ msg = "task::cancel on a handle that holds no task" } }
        if task.state == RUNNING {
            let t = table{ state = &threads }
            mutex::lock{ mutex = &t.lock }
            let s = slot_of{ t, id = task.slot, generation = task.generation }
            ask_stop{ &threads, s }
            _ = await{ &threads, t, s, nanoseconds = FOREVER }
            free_slot{ &threads, t, s }
            mutex::unlock{ mutex = &t.lock }
        }
        task.state = NONE
        return task.result
    }

    // What ends a handle's scope (spec §15, Tasks, rule 6): its task, if it has one, cancelled
    // and waited for, its result dropped.
    #scope_end
    fn end(R) { mut threads: Threads, mut task: Task(R) ends } {
        if task.state == NONE { return }
        _ = cancel(R){ &threads, &task }
    }

    // As start, start_concurrent and start_blocking, the task belonging to `group`. A group's
    // task returns `!`. In a `Failures::stop` group, the first of its tasks to fail cancels the
    // others, and `wait_all` returns that error. In a `Failures::keep` group a failure cancels
    // nothing: the group holds a copy of its error, in order of failure, for wait_failure and
    // wait_all_failures, at most `kept` at once (KEPT for 0), on std's heap; a failure past that,
    // or one there is no memory for, is counted (count_dropped) and dropped. The oldest are kept,
    // so what the group holds is its first failures. A task run at once fails into its group the
    // same way. A group being cancelled starts its new tasks cancelled.
    fn start_in { mut threads: Threads, mut group: Group, run: &thread fn{} -> ! into group } {
        if os::CONCURRENT {
            let t = table{ state = &threads }
            mutex::lock{ mutex = &t.lock }
            let limit = if t.limit_set { t.limit } else { LIMIT }
            if t.busy < limit {
                if let s = new_slot{ &threads, t } {
                    if let rec = new_record{ &threads, t, size = @record_size(run) } {
                        let entry = @record_copy(run, rec)
                        if begin_task{ &threads, t, s, entry, rec, result = @cast(*mut u8, &s.gresult), group = &group } {
                            mutex::unlock{ mutex = &t.lock }
                            return
                        }
                        free_record{ t, rec }
                    }
                    free_slot{ &threads, t, s }
                }
            }
            mutex::unlock{ mutex = &t.lock }
        }
        // At once, as part of the caller: its first error is the group's.
        let r = run{}
        if r is err {
            let t = table{ state = &threads }
            mutex::lock{ mutex = &t.lock }
            failed{ &threads, t, g = &group, r }
            mutex::unlock{ mutex = &t.lock }
        }
    }

    fn start_concurrent_in { mut threads: Threads, mut group: Group, run: &thread fn{} -> ! into group } -> ! {
        if not os::CONCURRENT { os::concurrency_unsupported{ what = "task::start_concurrent_in and task::start_blocking_in" } }
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        defer mutex::unlock{ mutex = &t.lock }
        let s = new_slot{ &threads, t } ifnull { return out_of_resources }
        let rec = new_record{ &threads, t, size = @record_size(run) } ifnull {
            free_slot{ &threads, t, s }
            return out_of_resources
        }
        let entry = @record_copy(run, rec)
        if not begin_task{ &threads, t, s, entry, rec, result = @cast(*mut u8, &s.gresult), group = &group } {
            free_record{ t, rec }
            free_slot{ &threads, t, s }
            return out_of_resources
        }
    }

    fn start_blocking_in { mut threads: Threads, mut group: Group, run: &thread fn{} -> ! into group } -> ! {
        return start_concurrent_in{ &threads, &group, run }
    }

    // Waits until the group has no task, those started meanwhile included: the first error of
    // its tasks, or success. The group is empty again. A keep group's is success: the failures
    // it holds stay for wait_failure and wait_all_failures until its scope ends.
    fn wait_all { mut threads: Threads, mut group: Group ends } -> ! {
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        defer mutex::unlock{ mutex = &t.lock }
        _ = await_group{ &threads, t, g = &group, nanoseconds = FOREVER }
        let failed = group.failed
        let r = group.error
        group.failed = false
        group.cancelling = false
        if failed { return r }
    }

    // As `wait_all` without its result: true once the group has no task (`wait_all` then returns
    // at once), false when `nanoseconds` passed first, the group untouched. 0 looks without
    // waiting. A waiter asked to stop stops the group and waits until it has none, then returns
    // true, as `wait_all` does.
    fn wait_all_for { mut threads: Threads, mut group: Group, nanoseconds: u64 } -> bool {
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        defer mutex::unlock{ mutex = &t.lock }
        return await_group{ &threads, t, g = &group, nanoseconds }
    }

    // Asks every task of the group to stop, then waits until it has none. The group is empty
    // again, its error dropped; a keep group's held failures, those its cancelled tasks fail
    // with included, are dropped unread and their memory freed, and its count of dropped ones
    // starts again at 0.
    #scope_end
    fn cancel_all { mut threads: Threads, mut group: Group ends } {
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        defer mutex::unlock{ mutex = &t.lock }
        stop_group{ &threads, t, g = &group }
        _ = await_group{ &threads, t, g = &group, nanoseconds = FOREVER }
        group.failed = false
        group.cancelling = false
        free_held{ &threads, g = &group }
        group.dropped = 0
    }

    // A keep group's oldest held failure, taken from it: at once if it holds one, and otherwise
    // once one of its tasks fails; null once it has no task and holds none. Failures come in
    // the order they happened. It leaves the group running, as a read leaves its stream: a
    // waiter asked to stop fails with `cancelled`, and one whose deadline passes (run_within)
    // with `deadline_passed`, the group untouched, as std's blocking reads do; a failure held
    // already is returned first. So a deadline of 0 looks without waiting. A stop group panics:
    // it holds no failure but its first, which is wait_all's.
    fn wait_failure { mut threads: Threads, mut group: Group } -> Stopped!?error {
        if group.failures != Failures::keep { rt::fail{ msg = "task::wait_failure on a group whose failures stop it: only a `Failures::keep` group holds them" } }
        let t = table{ state = &threads }
        let mine = me{ &threads }
        if let m = mine { if m.group == &group { rt::fail{ msg = "task: a task of a group waits for its own group" } } }
        mutex::lock{ mutex = &t.lock }
        defer mutex::unlock{ mutex = &t.lock }
        while true {
            if group.count > 0 {
                let e: ?error = take_failure{ g = &group }
                return e
            }
            if group.tasks == 0 { return null }
            try check{ cancel = &threads }
            // Its slot says what it waits on, so that a stop broadcasts it (ask_stop).
            if let m = mine { m.waiting = &t.groups }
            let left = get_time_left{ cancel = &threads }
            if left == FOREVER {
                condition::wait{ condition = &t.groups, mutex = &t.lock }
            } else {
                _ = condition::wait_for{ &threads, condition = &t.groups, mutex = &t.lock, nanoseconds = left }
            }
            if let m = mine { m.waiting = null }
        }
        return null
    }

    // Waits until a keep group has no task, as wait_all does, a waiter asked to stop stopping
    // the group first, then gives every failure it holds, oldest first, in a slice from
    // `realloc` and `heap`, which the caller frees (alloc::resize to 0); empty without one, and
    // then nothing is allocated. The group holds none after, and its memory for them is freed.
    // Fails with alloc::out_of_memory if `realloc` has no room, and the group keeps them, for
    // wait_failure or another try. A stop group panics, as in wait_failure.
    fn wait_all_failures(S) { mut threads: Threads, mut group: Group ends, realloc: alloc::Fn(S), mut heap: S } -> ![]mut error {
        if group.failures != Failures::keep { rt::fail{ msg = "task::wait_all_failures on a group whose failures stop it: only a `Failures::keep` group holds them" } }
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        _ = await_group{ &threads, t, g = &group, nanoseconds = FOREVER }
        group.cancelling = false
        let n = group.count
        mutex::unlock{ mutex = &t.lock }
        if n == 0 { return slice::empty(error){} }
        // The caller's allocator runs outside the table's mutex: it is the caller's code. The
        // group has no task to fail meanwhile, and only its holder starts one.
        let out = try alloc::make(error, S){ realloc, &heap, count = @as(usize, n) }
        mutex::lock{ mutex = &t.lock }
        defer mutex::unlock{ mutex = &t.lock }
        let mut i: usize = 0
        while i < out.len {
            out[i] = take_failure{ g = &group }
            i = i + 1
        }
        free_held{ &threads, g = &group }
        return out
    }

    // How many of a keep group's failures were dropped, not held: past its most (`kept`), or
    // for want of memory. It counts from the group's start, and from 0 again after cancel_all;
    // reading takes none. A u64: a server's group lives as long as the server. 0 for a stop group.
    fn count_dropped { mut threads: Threads, mut group: Group } -> u64 {
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        defer mutex::unlock{ mutex = &t.lock }
        return group.dropped
    }

    // Fails with `cancelled` if the calling task has been asked to stop, and with
    // `deadline_passed` once the deadline it runs under has passed (run_within): for code that
    // computes for long between blocking calls.
    fn check_cancelled { mut threads: Threads } -> Stopped! {
        return check{ cancel = &threads }
    }

    // Runs `run` with a deadline `nanoseconds` from now on the calling thread's blocking calls,
    // and gives what it returns. A call still waiting when the deadline passes stops and fails
    // with deadline_passed, and so does every call made after it, before it blocks, until `run`
    // returns; then the deadline is gone. A call that completes as it passes returns its
    // result. Inside another, the earlier of the two deadlines holds, and the outer one is back
    // once `run` returns. It holds outside a task too, on main's thread. A task `run` starts
    // concurrently doesn't run under it, but a wait under it that is still waiting when it
    // passes cancels what it waits for, as a waiter asked to stop does; a task run at once is
    // part of its starter, and runs under it. A cancel wins over a deadline: in a task asked to
    // stop, calls fail with `cancelled`.
    fn run_within(T, E: error) { mut cancel: Cancel, nanoseconds: u64, run: &fn{} -> E!T } -> E!T {
        let outer = cancel.deadline
        let now = os::read_deadline_clock{ &cancel }
        let mine = if nanoseconds > FOREVER - now { FOREVER } else { now + nanoseconds }
        cancel.deadline = if outer != 0 and outer < mine { outer } else { mine }
        defer { cancel.deadline = outer }
        return run{}
    }

    // Busy workers past which `start` runs a task at once; 0 makes it always run at once. It
    // applies to the next `start`, and stops no worker.
    fn set_limit { mut threads: Threads, workers: u32 } {
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        t.limit = workers
        t.limit_set = true
        mutex::unlock{ mutex = &t.lock }
    }

    // Stack for workers started after it; 0 for the default, 8 MiB. An idle worker whose stack
    // is smaller ends instead of taking a task.
    fn set_stack { mut threads: Threads, bytes: usize } {
        let t = table{ state = &threads }
        mutex::lock{ mutex = &t.lock }
        t.stack = bytes
        mutex::unlock{ mutex = &t.lock }
    }

    // ---- what std's blocking calls use (internals.md, Tasks, Capabilities)

    // Fails with `cancelled` if the calling task has been asked to stop, and otherwise with
    // `deadline_passed` if the calling thread's deadline has passed. A thread with no deadline
    // reads no clock.
    fn check { mut cancel: Cancel } -> Stopped! {
        if let me = cancel.current {
            if @atomic_load_acquire(&me.flag) != 0 { return cancelled }
        }
        if cancel.deadline != 0 and os::read_deadline_clock{ &cancel } >= cancel.deadline { return deadline_passed }
    }

    // What a blocking call fails with once its wait ended for its task's cancel object or its
    // deadline: `cancelled` if the calling task has been asked to stop, and otherwise
    // `deadline_passed`.
    fn get_stop_error { mut cancel: Cancel } -> Stopped {
        if let me = cancel.current {
            if @atomic_load_acquire(&me.flag) != 0 { return cancelled }
        }
        return deadline_passed
    }

    // Whether a blocking call of the calling thread's can be stopped while it waits: in a task,
    // whose cancel object it waits on, or under a deadline, which bounds its wait. A call
    // waits plainly when neither is so.
    fn can_stop { mut cancel: Cancel } -> bool {
        return cancel.current != null or cancel.deadline != 0
    }

    // The nanoseconds until the calling thread's deadline, which bound a blocking call's wait:
    // 0 once it has passed, FOREVER without one. A wait that ends for it then calls check,
    // which says whether it has passed, since a system's wait may end a little early.
    fn get_time_left { mut cancel: Cancel } -> u64 {
        if cancel.deadline == 0 { return FOREVER }
        let now = os::read_deadline_clock{ &cancel }
        return if cancel.deadline > now { cancel.deadline - now } else { 0 }
    }

    // The calling task's cancel object, which is signalled when it is asked to stop: a Windows
    // event, a Linux eventfd, or the read end of a macOS pipe. 0 outside a task.
    fn get_cancel_object { mut cancel: Cancel } -> u64 {
        let me = cancel.current ifnull { return 0 }
        return os::event_waitable{ event = me.object }
    }

    // Around a synchronous call that only CancelSynchronousIo can interrupt (Windows' reads of
    // an inherited anonymous pipe): fails with `cancelled` if the calling task has been asked
    // to stop, and otherwise marks it in one, so that a stop interrupts the call (ask_stop),
    // until end_synchronous. Under the slot's lock, so a late stop can't reach a later call.
    fn begin_synchronous { mut cancel: Cancel } -> ! {
        let me = cancel.current ifnull { return }
        lock_sync{ s = me }
        if @atomic_load_acquire(&me.flag) != 0 {
            unlock_sync{ s = me }
            return cancelled
        }
        me.sync = true
        unlock_sync{ s = me }
    }

    fn end_synchronous { mut cancel: Cancel } {
        let me = cancel.current ifnull { return }
        lock_sync{ s = me }
        me.sync = false
        unlock_sync{ s = me }
    }

    fn lock_sync { s: *mut Slot } {
        while @atomic_compare_exchange_acquire(&s.sync_lock, 0, 1) != null {}
    }

    fn unlock_sync { s: *mut Slot } {
        @atomic_store_release(&s.sync_lock, 0)
    }

    // Interrupts slot s's synchronous call, if it is in one: whether it is.
    fn interrupt { mut threads: Threads, s: *mut Slot } -> bool {
        lock_sync{ s }
        let sync = s.sync
        if sync { os::cancel_synchronous{ &threads, thread = s.thread } }
        unlock_sync{ s }
        return sync
    }

    // ---- the Threaded backend

    // Busy workers past which `start` runs a task at once, until set_limit: tasks that do IO
    // spend their time blocked, so the processors' count would be too few.
    const LIMIT: u32 = 64

    // The most failures a keep group holds at once when its `kept` is 0: enough for a reader
    // that falls behind for a moment, and a bound on what a flood of failures takes.
    const KEPT: u32 = 64

    // How long an idle worker waits for a task before it ends: 10 seconds.
    const IDLE: u64 = 10000000000

    // A wait's time that has no end: get_time_left's without a deadline, and await's.
    const FOREVER: u64 = 18446744073709551615

    // Slots per page of the table, and pages at most: 65536 tasks at once.
    const PER_PAGE: u32 = 64
    const PAGES: u32 = 1024

    // Records' sizes: 64 << class bytes, for classes 0 to 20 (64 MiB).
    const CLASSES: u32 = 21

    // Workers' stacks: 8 MiB unless set_stack says otherwise.
    const DEFAULT_STACK: usize = 8388608

    // The table: under one mutex, the slots, the idle workers, and the free records.
    struct Table {
        ready: u32,                         // 0, then 1 while it is made, then 2 (table)
        lock: mutex::Mutex,
        groups: condition::Condition,       // broadcast when any group's task ends
        pages: [1024]?*mut Slot,
        made: u32,                          // slots made, numbered from 1
        free: u32,                          // the first free slot, 0 if none
        idle: ?*mut Worker,                 // workers waiting for a task
        spare: ?*mut Worker,                // records of workers that ended
        busy: u32,                          // workers running one
        limit: u32,
        limit_set: bool,
        stack: usize,
        records: [21]?*mut FreeRecord,
    }

    // A task, while it runs or until it is waited for, and after that a free slot.
    struct Slot {
        id: u32,
        generation: u32,                    // grows each time the slot is freed
        state: u32,                         // NONE (free), RUNNING, ENDED
        flag: u32,                          // asked to stop: read with atomics
        object: u64,                        // its cancel object (os::event_make)
        entry: fn{ record: *mut u8, result: *mut u8 },
        record: []mut u8,                   // the copy of its bind's record (new_record)
        result: *mut u8,                    // where its result goes: its Task's, or gresult
        group: ?*mut Group,
        next: u32,                          // the next and previous of its group's tasks
        prev: u32,
        done: condition::Condition,         // broadcast when it ends, and when its waiter is asked to stop
        waiting: ?*mut condition::Condition, // the condition its task waits on, while it waits
        thread: u64,                        // its worker's thread, for interrupting a synchronous call
        sync: bool,                         // in a call only CancelSynchronousIo interrupts
        sync_lock: u32,                     // held while sync changes, and while it is acted on
        next_free: u32,
        gresult: !,                         // a group's task's result
    }

    // A worker: a thread that runs one task at a time, on its own stack.
    struct Worker {
        wake: condition::Condition,
        slot: ?*mut Slot,                   // the task to run next
        next: ?*mut Worker,                 // in the idle list
        stack: usize,                       // what it may use
        leave: bool,                        // its stack is too small: it ends
        listed: bool,                       // in the idle list
    }

    struct FreeRecord { next: ?*mut FreeRecord }

    // The table, made the first time: its mutex and condition need making on some platforms.
    fn table { mut state: State } -> *mut Table {
        let t = &state.table
        if @atomic_load_acquire(&t.ready) == 2 { return t }
        if @atomic_compare_exchange_acquire_release(&t.ready, 0, 1) == null {
            t.lock = mutex::make{}
            t.groups = condition::make{}
            @atomic_store_release(&t.ready, 2)
            return t
        }
        while @atomic_load_acquire(&t.ready) != 2 {}
        return t
    }

    // Slot `id`, which has been made.
    fn slot_ptr { t: *mut Table, id: u32 } -> *mut Slot {
        let page = t.pages[(id - 1) / PER_PAGE] ifnull { @panic("task: a slot of no page") }
        return page + (id - 1) % PER_PAGE
    }

    // The slot of a handle's task, which must still be its.
    fn slot_of { t: *mut Table, id: u32, generation: u32 } -> *mut Slot {
        let s = slot_ptr{ t, id }
        if s.generation != generation { rt::fail{ msg = "task: a handle whose task was waited for already" } }
        return s
    }

    // A free slot, under the table's mutex, or null if the table can't grow.
    fn new_slot { mut threads: Threads, t: *mut Table } -> ?*mut Slot {
        let mut s: ?*mut Slot = null
        if t.free != 0 {
            let f = slot_ptr{ t, id = t.free }
            t.free = f.next_free
            os::event_reset{ &threads, event = f.object }
            s = f
        } else {
            if t.made == PER_PAGE * PAGES { return null }
            let p = t.made / PER_PAGE
            if t.pages[p] == null {
                let bytes = mem::pages{ mem = &threads, size = @as(usize, PER_PAGE) * @size_of(Slot) } ifnull { return null }
                t.pages[p] = @cast(*mut Slot, &bytes[0])
            }
            let page = t.pages[p] ifnull { return null }
            let object = os::event_make{ &threads }
            if object == 0 { return null }
            let f = page + t.made % PER_PAGE
            t.made = t.made + 1
            f.id = t.made
            f.object = object
            f.done = condition::make{}
            s = f
        }
        let f = s ifnull { return null }
        f.state = RUNNING
        @atomic_store_relaxed(&f.flag, 0)
        f.group = null
        f.waiting = null
        f.sync = false
        f.next = 0
        f.prev = 0
        return f
    }

    // Frees slot s, whose task has ended and been waited for, under the table's mutex.
    fn free_slot { mut threads: Threads, t: *mut Table, s: *mut Slot } {
        s.state = NONE
        s.generation = s.generation + 1
        s.next_free = t.free
        t.free = s.id
    }

    fn class_of { size: usize } -> u32 {
        let mut k: u32 = 0
        while k < CLASSES and (@as(usize, 64) << k) < size { k = k + 1 }
        return k
    }

    // Memory for a record of `size` bytes, from the free list of its class or new pages, under
    // the table's mutex; null if there is none.
    fn new_record { mut threads: Threads, t: *mut Table, size: usize } -> ?[]mut u8 {
        let k = class_of{ size }
        if k == CLASSES { return null }
        let n = @as(usize, 64) << k
        if let f = t.records[k] {
            t.records[k] = f.next
            return @slice(@cast(*mut u8, f), n)
        }
        // A page of small ones at a time.
        let take = if n < mem::PAGE { mem::PAGE } else { n }
        let bytes = mem::pages{ mem = &threads, size = take } ifnull { return null }
        let mut at = n
        while at + n <= take {
            let f = @cast(*mut FreeRecord, &bytes[at])
            f.next = t.records[k]
            t.records[k] = f
            at = at + n
        }
        return bytes[..n]
    }

    fn free_record { t: *mut Table, rec: []mut u8 } {
        let k = class_of{ size = rec.len }
        let f = @cast(*mut FreeRecord, &rec[0])
        f.next = t.records[k]
        t.records[k] = f
    }

    // Gives slot s its task and a worker, under the table's mutex: an idle one, or a new
    // thread. False if the operating system refuses a thread.
    fn begin_task { mut threads: Threads, t: *mut Table, s: *mut Slot, entry: fn{ record: *mut u8, result: *mut u8 }, rec: []mut u8, result: *mut u8, group: ?*mut Group } -> bool {
        s.entry = entry
        s.record = rec
        s.result = result
        let want = if t.stack == 0 { DEFAULT_STACK } else { t.stack }
        let mut given = false
        while not given {
            let w = t.idle ifnull { break }
            t.idle = w.next
            w.next = null
            w.listed = false
            if w.stack < want {
                w.leave = true
                condition::signal{ condition = &w.wake }
            } else {
                w.slot = s
                condition::signal{ condition = &w.wake }
                given = true
            }
        }
        if not given and not new_worker{ &threads, s, usable = want } { return false }
        if let g = group {
            s.group = g
            s.next = g.first
            if g.first != 0 { slot_ptr{ t, id = g.first }.prev = s.id }
            g.first = s.id
            g.tasks = g.tasks + 1
            if g.cancelling { @atomic_store_release(&s.flag, 1) }
        }
        t.busy = t.busy + 1
        return true
    }

    // Starts a worker whose first task is slot s's: false if the operating system refuses.
    fn new_worker { mut threads: Threads, s: *mut Slot, usable: usize } -> bool {
        // The stack is larger than what the worker may use, so a frame that crosses the limit
        // still reaches the check, and the panic can be reported.
        let room: usize = if usable / 4 > 1048576 { usable / 4 } else { 1048576 }
        let mut start = Start{ kind = thread::WORKER, slot = s, usable, started = 0 }
        let handle = os::thread_create{ &threads, start = @cast(*mut u8, &start), stack_size = usable + room } ifnull { return false }
        // start is this frame's: the worker copies it before it says it has started.
        while @atomic_load_acquire(&start.started) == 0 { os::thread_yield{ &threads } }
        os::thread_detach{ &threads, handle }
        return true
    }

    // What a new worker starts with, in its starter's frame until it has copied it.
    // kind first, which says to the platform layer's thread entry that it is a worker's
    // (thread::entry).
    struct Start { kind: u32, slot: *mut Slot, usable: usize, started: u32 }

    // A worker's first fn, which the platform's layer calls on the new thread (os::thread_create):
    // its stack limit and its label for a panic's report, then its first task. When the thread
    // ends, the runtime writes out its standard output (rt::thread_ends). C passes no capability
    // to a thread's first fn (spec §18, Callbacks, rule 6), but this one holds those its starter
    // does, which waits in new_worker until `started` says it is past them: only a threaded
    // program starts a task, and a capability without fields is no bytes (spec §15, rule 4).
    fn begin { start: *mut u8 } {
        let mut threads = @cast(*Threads, start).*
        let mut io = @cast(*Io, start).*
        let s = @cast(*mut Start, start)
        let first = s.slot
        rt::thread_begin{ &threads, usable = s.usable, name = "task worker" }
        os::thread_name{ &threads, name = "task worker" }
        @atomic_store_release(&s.started, 1)
        worker{ &threads, &io, first }
    }

    // Runs tasks until none comes for IDLE.
    fn worker { mut threads: Threads, mut io: Io, first: *mut Slot } {
        let t = table{ state = &threads }
        let me = os::thread_handle{ &threads }
        mutex::lock{ mutex = &t.lock }
        let w = new_worker_record{ &threads, t } ifnull {
            // No memory for its record: it runs its first task, and ends.
            mutex::unlock{ mutex = &t.lock }
            run{ &threads, &io, s = first }
            mutex::lock{ mutex = &t.lock }
            ended{ &threads, t, s = first }
            mutex::unlock{ mutex = &t.lock }
            return
        }
        w.wake = condition::make{}
        w.slot = first
        w.next = null
        w.leave = false
        w.listed = false
        w.stack = if t.stack == 0 { DEFAULT_STACK } else { t.stack }
        while true {
            let s = w.slot ifnull {
                if w.leave { break }
                // Idle: wait for a task, or end.
                if not w.listed {
                    w.next = t.idle
                    t.idle = w
                    w.listed = true
                }
                let woke = condition::wait_for{ &threads, condition = &w.wake, mutex = &t.lock, nanoseconds = IDLE }
                if w.slot == null and not w.leave and not woke {
                    unlink_idle{ t, w }
                    break
                }
                continue
            }
            s.thread = me
            mutex::unlock{ mutex = &t.lock }
            run{ &threads, &io, s }
            mutex::lock{ mutex = &t.lock }
            ended{ &threads, t, s }
            w.slot = null
        }
        condition::free{ condition = &w.wake }
        w.next = t.spare
        t.spare = w
        mutex::unlock{ mutex = &t.lock }
    }

    // A worker's record, from the spare ones or new pages, under the table's mutex.
    fn new_worker_record { mut threads: Threads, t: *mut Table } -> ?*mut Worker {
        if let w = t.spare {
            t.spare = w.next
            return w
        }
        let bytes = mem::pages{ mem = &threads, size = mem::PAGE } ifnull { return null }
        let n = mem::PAGE / @size_of(Worker)
        let mut i: usize = 1
        while i < n {
            let w = @cast(*mut Worker, &bytes[i * @size_of(Worker)])
            w.next = t.spare
            t.spare = w
            i = i + 1
        }
        return @cast(*mut Worker, &bytes[0])
    }

    fn unlink_idle { t: *mut Table, w: *mut Worker } {
        let mut at = &t.idle
        while true {
            let x = at.* ifnull { return }
            if x == w {
                at.* = w.next
                return
            }
            at = &x.next
        }
    }

    // Runs slot s's task on this worker: its name and its record for a panic's report, its cancel slot, and
    // its standard output written out before its end is published, whatever its flag.
    fn run { mut threads: Threads, mut io: Io, s: *mut Slot } {
        let mut label: [80]u8
        let name = rt::task_name{ record = @cast(*u8, &s.record[0]) }
        let n = rt::put{ into = label[..], n = rt::put{ into = label[..], n = 0, s = "task " }, s = name }
        rt::thread_rename{ &threads, name = label[..n] }
        rt::thread_runs{ &threads, record = @cast(*u8, &s.record[0]) }
        threads.current = s
        threads.deadline = 0
        s.entry{ record = @cast(*mut u8, &s.record[0]), result = s.result }
        threads.current = null
        io::flush{ &io }
        rt::thread_runs{ &threads, record = null }
        rt::thread_rename{ &threads, name = "task worker" }
    }

    // Slot s's task has ended, under the table's mutex: its record goes back, its group learns
    // of it, and whoever waits for it is woken. A group's slot is freed at once: nothing waits
    // for one task of a group.
    fn ended { mut threads: Threads, t: *mut Table, s: *mut Slot } {
        free_record{ t, rec = s.record }
        s.state = ENDED
        t.busy = t.busy - 1
        if let g = s.group {
            if s.prev != 0 { slot_ptr{ t, id = s.prev }.next = s.next } else { g.first = s.next }
            if s.next != 0 { slot_ptr{ t, id = s.next }.prev = s.prev }
            g.tasks = g.tasks - 1
            let r = s.gresult
            if r is err { failed{ &threads, t, g, r } }
            free_slot{ &threads, t, s }
            condition::broadcast{ condition = &t.groups }
            return
        }
        condition::broadcast{ condition = &s.done }
    }

    // A task of group g failed with r, under the table's mutex. In a stop group the first
    // failure is the group's, and cancels the rest; a keep group holds it, and wakes whoever
    // waits for one (wait_failure), since a task run at once ends without `ended`.
    fn failed { mut threads: Threads, t: *mut Table, g: *mut Group, r: ! } {
        if g.failures == Failures::keep {
            if r is err{ error } { hold{ &threads, g, e = error } }
            condition::broadcast{ condition = &t.groups }
            return
        }
        if g.failed { return }
        g.failed = true
        g.error = r
        stop_group{ &threads, t, g }
    }

    // Adds e to the failures keep group g holds, after the others, under the table's mutex; it
    // is counted as dropped when g holds its most already, or std's heap has no room for it.
    // The error is copied as any value is: a payload's pointers point where the task's did.
    fn hold { mut threads: Threads, g: *mut Group, e: error } {
        let most = if g.kept == 0 { KEPT } else { g.kept }
        if g.count >= most or (g.count == g.held.len and not grow_held{ &threads, g, most }) {
            g.dropped = g.dropped + 1
            return
        }
        g.held[@as(usize, g.oldest + g.count) % g.held.len] = e
        g.count = g.count + 1
    }

    // Makes the ring of keep group g, which is full, larger: twice, from 4, up to `most`.
    // False if std's heap has no room, the ring as it was. The failures from the oldest to the
    // ring's old end move to the new end, so the ring stays in order.
    fn grow_held { mut threads: Threads, g: *mut Group, most: u32 } -> bool {
        let old = g.held.len
        let want: usize = if old == 0 { 4 } else { old * 2 }
        let n = @min(want, @as(usize, most))
        let mut h = heap::new{ mem = &threads }
        g.held = alloc::resize(error, heap::Heap){ realloc = heap::alloc, heap = &h, mem = g.held, count = n } iferr { return false }
        if g.count > 0 and g.oldest > 0 {
            let tail = old - @as(usize, g.oldest)
            let mut i: usize = 0
            while i < tail {
                g.held[n - 1 - i] = g.held[old - 1 - i]
                i = i + 1
            }
            g.oldest = @as(u32, n - tail)
        }
        return true
    }

    // The oldest failure keep group g holds, taken from it, under the table's mutex; it holds one.
    fn take_failure { g: *mut Group } -> error {
        let e = g.held[@as(usize, g.oldest)]
        g.oldest = if g.count == 1 { 0 } else { (g.oldest + 1) % @as(u32, g.held.len) }
        g.count = g.count - 1
        return e
    }

    // Drops the failures keep group g holds and frees their ring, under the table's mutex.
    fn free_held { mut threads: Threads, g: *mut Group } {
        if g.held.len > 0 {
            let mut h = heap::new{ mem = &threads }
            g.held = alloc::resize(error, heap::Heap){ realloc = heap::alloc, heap = &h, mem = g.held, count = 0 } iferr { return }
        }
        g.oldest = 0
        g.count = 0
    }

    // Asks every task of group g to stop, under the table's mutex; its new ones start asked.
    fn stop_group { mut threads: Threads, t: *mut Table, g: *mut Group } {
        g.cancelling = true
        let mut id = g.first
        while id != 0 {
            let s = slot_ptr{ t, id }
            ask_stop{ &threads, s }
            id = s.next
        }
    }

    // Asks slot s's task to stop, under the table's mutex: its flag, its cancel object, and
    // the condition it waits on, if it waits, so that it notices.
    fn ask_stop { mut threads: Threads, s: *mut Slot } {
        if s.state != RUNNING { return }
        @atomic_store_release(&s.flag, 1)
        os::event_signal{ &threads, event = s.object }
        if let c = s.waiting { condition::broadcast{ condition = c } }
        _ = interrupt{ &threads, s }
    }

    // The calling task's slot, or null outside a task.
    fn me { mut threads: Threads } -> ?*mut Slot {
        return threads.current
    }

    // Waits under the table's mutex for slot s's task to end, at most `nanoseconds`: whether it
    // has. A waiter that is asked to stop, or whose deadline passes (run_within), asks s to
    // stop, then waits to the end.
    fn await { mut threads: Threads, t: *mut Table, s: *mut Slot, nanoseconds: u64 } -> bool {
        if s.state == ENDED { return true }
        if nanoseconds == 0 and not stopping{ &threads } { return false }
        let mine = me{ &threads }
        let mut left = nanoseconds
        let mut asked = false
        let mut began = os::now{ &threads }
        while s.state != ENDED {
            if stopping{ &threads } {
                ask_stop{ &threads, s }
                left = FOREVER
                asked = true
            }
            if let m = mine { m.waiting = &s.done }
            if @atomic_load_acquire(&s.flag) != 0 and interrupt{ &threads, s } {
                // A call not yet entered isn't reached: again each millisecond, until it leaves.
                _ = condition::wait_for{ &threads, condition = &s.done, mutex = &t.lock, nanoseconds = 1000000 }
                continue
            }
            // Until the deadline too, if there is one and s hasn't been asked to stop yet.
            let until = if asked { FOREVER } else { get_time_left{ cancel = &threads } }
            if left == FOREVER and until == FOREVER {
                condition::wait{ condition = &s.done, mutex = &t.lock }
            } else if left == FOREVER {
                _ = condition::wait_for{ &threads, condition = &s.done, mutex = &t.lock, nanoseconds = until }
            } else {
                _ = condition::wait_for{ &threads, condition = &s.done, mutex = &t.lock, nanoseconds = @min(left, until) }
                let now = os::now{ &threads }
                let spent = now - began
                began = now
                if s.state != ENDED and spent >= left and not stopping{ &threads } {
                    if let m = mine { m.waiting = null }
                    return false
                }
                left = if spent >= left { 0 } else { left - spent }
                if left == 0 and not stopping{ &threads } {
                    if let m = mine { m.waiting = null }
                    return s.state == ENDED
                }
            }
        }
        if let m = mine { m.waiting = null }
        return true
    }

    // Waits under the table's mutex until group g has no task, at most `nanoseconds`: whether it
    // has none. A task of the group panics: it would wait for itself. A waiter asked to stop, or
    // whose deadline passes, stops the group, then waits until it has none.
    fn await_group { mut threads: Threads, t: *mut Table, g: *mut Group, nanoseconds: u64 } -> bool {
        let mine = me{ &threads }
        if let m = mine { if m.group == g { rt::fail{ msg = "task: a task of a group waits for its own group" } } }
        if g.tasks == 0 { return true }
        if nanoseconds == 0 and not stopping{ &threads } { return false }
        let mut left = nanoseconds
        let mut asked = false
        let mut began = os::now{ &threads }
        while g.tasks > 0 {
            if stopping{ &threads } {
                stop_group{ &threads, t, g }
                left = FOREVER
                asked = true
            }
            if let m = mine { m.waiting = &t.groups }
            let until = if asked { FOREVER } else { get_time_left{ cancel = &threads } }
            if left == FOREVER and until == FOREVER {
                condition::wait{ condition = &t.groups, mutex = &t.lock }
            } else if left == FOREVER {
                _ = condition::wait_for{ &threads, condition = &t.groups, mutex = &t.lock, nanoseconds = until }
            } else {
                _ = condition::wait_for{ &threads, condition = &t.groups, mutex = &t.lock, nanoseconds = @min(left, until) }
                let now = os::now{ &threads }
                let spent = now - began
                began = now
                left = if spent >= left { 0 } else { left - spent }
                if left == 0 and g.tasks > 0 and not stopping{ &threads } {
                    if let m = mine { m.waiting = null }
                    return false
                }
            }
        }
        if let m = mine { m.waiting = null }
        return true
    }

    // Whether the calling task has been asked to stop, or the calling thread's deadline has
    // passed.
    fn stopping { mut threads: Threads } -> bool {
        return check{ cancel = &threads } is err
    }
}
