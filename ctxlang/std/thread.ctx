// std: thread, atomic, mutex and condition. Threads of the operating system (spec §15, rule 14;
// ctxlang/threads.md, layer 1). Nothing keeps two threads from sharing memory: what they share,
// and when it is freed, is the program's to manage, as in C, with the atomics (spec §13), a
// mutex or a condition.
//
//   struct Counter { lock: mutex::Mutex, n: u64 }
//
//   fn count { data: *mut Counter } {
//       mutex::lock{ mutex = &data.lock }
//       data.n = data.n + 1
//       mutex::unlock{ mutex = &data.lock }
//   }
//
//   fn main { mut io: Io, mut threads: Threads } -> i32 {
//       let mut c = Counter{ lock = mutex::make{}, n = 0 }
//       let t = thread::create{ &threads, run = count, data = &c, options = thread::default_options{} } iferr { return 1 }
//       thread::join{ &threads, thread = t }
//       io::println_u64{ &io, n = c.n }
//       return 0
//   }

// Permission to start threads, and to wait for them. Only `main` receives it, and a program
// whose `main` (or start fn) takes it is threaded (spec §15, Entry point, rule 8).
capability Threads

namespace thread {
    // A running thread, as the operating system knows it: a Windows HANDLE, or a pthread_t.
    struct Thread { handle: u64 }

    struct Options {
        stack_size: usize,          // bytes the thread may use; 0 for DEFAULT_STACK
        name: []u8,                 // for debuggers and a panic's report, cut to 63 bytes; may be empty
    }

    // The operating system refused another thread.
    error out_of_resources

    // The stack a thread may use when its options say 0: 8 MiB.
    const DEFAULT_STACK: usize = 8388608

    fn default_options {} -> Options {
        return Options{ stack_size = 0, name = "" }
    }

    // Starts a thread that runs `run{ data }`, and ends when that returns. `run` may take
    // capabilities besides `data`, which the caller must hold as a direct call would need them,
    // and the thread receives (spec §15, rule 14). Nothing copies `*data` or keeps it alive: it
    // must outlive the thread. Each thread is joined or detached once.
    #spawn
    fn create(T) { mut threads: Threads, run: fn{ data: *mut T }, data: *mut T, options: Options } -> !Thread {
        let usable = if options.stack_size == 0 { DEFAULT_STACK } else { options.stack_size }
        // The stack is larger than what the thread may use (rt's limit for it, begin), so a
        // frame that crosses the limit still reaches the check, and the panic can be reported.
        let room: usize = if usable / 4 > 1048576 { usable / 4 } else { 1048576 }
        let erased = @cast(*fn{ data: *mut u8 }, &run).*
        let mut start = Start{ run = erased, data = @cast(*mut u8, data), usable, name = options.name, started = 0 }
        let handle = os::thread_create{ &threads, start = @cast(*mut u8, &start), stack_size = usable + room } ifnull {
            return out_of_resources
        }
        // start is this frame's: the new thread copies it before it says it has started.
        while @atomic_load(&start.started, atomic::Order::acquire) == 0 { os::thread_yield{ &threads } }
        return Thread{ handle }
    }

    // What a new thread starts with, in its creator's frame until it has copied it.
    struct Start { run: fn{ data: *mut u8 }, data: *mut u8, usable: usize, name: []u8, started: u32 }

    // A new thread's first fn, which the platform's layer calls (os::thread_create): its stack
    // limit and name, then `run`. When the thread ends, the runtime writes out its standard
    // output (std's start gives it the fn that does, rt::thread_ends).
    fn begin { start: *mut u8 } {
        let s = @cast(*mut Start, start)
        let run = s.run
        let data = s.data
        // A panic's report names a thread without a name by its id.
        let mut digits: [20]u8
        let name = if s.name.len > 0 { s.name } else { utf8::fmt_u64{ n = os::thread_id{}, into = digits[..] }.bytes }
        rt::thread_begin{ usable = s.usable, name }
        os::thread_name{ name = s.name }
        @atomic_store(&s.started, 1, atomic::Order::release)
        run{ data }
    }

    // Waits for the thread to end.
    fn join { mut threads: Threads, thread: Thread } {
        os::thread_join{ &threads, handle = thread.handle }
    }

    // Lets the thread end on its own: its handle is no longer valid.
    fn detach { mut threads: Threads, thread: Thread } {
        os::thread_detach{ &threads, handle = thread.handle }
    }

    // The calling thread waits at least this long.
    fn sleep { mut threads: Threads, nanoseconds: u64 } {
        os::thread_sleep{ &threads, nanoseconds }
    }

    // Gives the rest of the calling thread's time slice to another thread.
    fn yield_now { mut threads: Threads } {
        os::thread_yield{ &threads }
    }

    // A number unique to the calling thread while it runs: the operating system's.
    fn current_id {} -> u64 {
        return os::thread_id{}
    }
}

namespace atomic {
    // How an atomic (spec §13) orders the memory accesses around it, as C11's memory_order: a
    // load may acquire, a store release, and a read-modify-write either or both.
    enum Order: u8 { relaxed, acquire, release, acquire_release, sequentially_consistent }
}

// A lock that one thread at a time holds: Windows' slim reader/writer lock, or a
// pthread_mutex_t. It lives in the memory the threads share, and doesn't move while one is
// locked or waited on. Not recursive: locking one the calling thread holds never returns.
namespace mutex {
    type Mutex = os::Mutex

    fn make {} -> Mutex {
        return os::mutex_make{}
    }

    fn lock { mut mutex: Mutex } {
        os::mutex_lock{ &mutex }
    }

    // Locks it if no thread holds it, without waiting: whether it did.
    fn try_lock { mut mutex: Mutex } -> bool {
        return os::mutex_try_lock{ &mutex }
    }

    fn unlock { mut mutex: Mutex } {
        os::mutex_unlock{ &mutex }
    }

    // Once no thread holds it or will: nothing on Windows, pthread_mutex_destroy elsewhere.
    fn free { mut mutex: Mutex } {
        os::mutex_free{ &mutex }
    }
}

// A condition that threads wait on, with a mutex: Windows' condition variable, or a
// pthread_cond_t. It lives in the memory the threads share, as a mutex does.
//
//   mutex::lock{ mutex = &q.lock }
//   defer mutex::unlock{ mutex = &q.lock }
//   while q.count == 0 { condition::wait{ condition = &q.not_empty, mutex = &q.lock } }
namespace condition {
    type Condition = os::Condition

    fn make {} -> Condition {
        return os::condition_make{}
    }

    // Unlocks `mutex`, which the calling thread holds, waits for a signal, and locks it again.
    // It may wake without one: check what it waits for again.
    fn wait { mut condition: Condition, mut mutex: mutex::Mutex } {
        os::condition_wait{ &condition, &mutex }
    }

    // As `wait`, giving up after `nanoseconds`: false when it gave up.
    fn wait_for { mut condition: Condition, mut mutex: mutex::Mutex, nanoseconds: u64 } -> bool {
        return os::condition_wait_for{ &condition, &mutex, nanoseconds }
    }

    // Wakes one thread that waits on it, if any.
    fn signal { mut condition: Condition } {
        os::condition_signal{ &condition }
    }

    // Wakes every thread that waits on it.
    fn broadcast { mut condition: Condition } {
        os::condition_broadcast{ &condition }
    }

    // Once no thread waits on it or will: nothing on Windows, pthread_cond_destroy elsewhere.
    fn free { mut condition: Condition } {
        os::condition_free{ &condition }
    }
}
