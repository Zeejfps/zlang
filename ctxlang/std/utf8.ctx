// std: utf8. Text.
//
// `String` is a view of bytes that are valid UTF-8, and the one text type. Like a slice, it
// doesn't own its memory. Input that might not be valid, such as a file, goes through `from`,
// which checks it once:
//
//   let text = utf8::from{ bytes } iferr err{ error } {
//       return 1                                  // utf8::invalid{ at }: the offset of the bad byte
//   }
//
// A string literal where a String is expected is one, checked at compile time by
// `from_literal`:
//
//   let s: utf8::String = "hello"
//   io::println{ &io, s = "hi" }
//
// Offsets are in bytes. `len` is the length in bytes and `count` the number of characters. A
// character is a Unicode code point, held in a u32. Functions that take an offset panic if it
// falls inside a character.
//
// In valid UTF-8, one character's bytes never appear inside another's, so searching and
// comparing work byte by byte. Character tests and case conversion recognize ASCII only; std has
// no Unicode tables. `ascii` has the same tests for a single byte.

namespace utf8 {
    struct String { bytes: []u8 }

    // Where the first invalid byte sequence starts.
    error invalid{ at: usize }

    fn from { bytes: []u8 } -> !String {
        let mut i: usize = 0
        while i < bytes.len {
            let n = seq_len{ bytes, i }
            if n == 0 { return invalid{ at = i } }
            i = i + n
        }
        return String{ bytes }
    }

    // A string literal where a String is expected: its bytes, checked while compiling, so bytes
    // that aren't valid UTF-8 are a compile error at the literal.
    #convert
    fn from_literal { s: strlit } -> !String {
        return from{ bytes = s.bytes }
    }

    // Views bytes as text. Panics if they aren't valid.
    fn of { chars: []u8 } -> String {
        return from{ bytes = chars } iferr { @panic("utf8::of: the bytes aren't valid UTF-8") }
    }

    fn empty {} -> String {
        return String{ bytes = slice::empty(u8){} }
    }

    // In bytes.
    fn len { s: String } -> usize {
        return s.bytes.len
    }

    // In characters. Walks the whole string.
    fn count { s: String } -> usize {
        let mut n: usize = 0
        let mut i: usize = 0
        while i < s.bytes.len {
            if not is_cont{ b = s.bytes[i] } { n = n + 1 }
            i = i + 1
        }
        return n
    }

    // Whether byte offset i is at the start of a character or at the end of s.
    fn is_boundary { s: String, i: usize } -> bool {
        if i >= s.bytes.len { return i == s.bytes.len }
        return not is_cont{ b = s.bytes[i] }
    }

    // The character starting at byte offset i. Panics if i isn't the start of a character.
    fn at { s: String, i: usize } -> u32 {
        return decode{ s, i }.c
    }

    // Bytes lo up to but not including hi. Panics if either isn't a boundary.
    fn sub { s: String, lo: usize, hi: usize } -> String {
        if not is_boundary{ s, i = lo } or not is_boundary{ s, i = hi } { @panic("utf8::sub: offset is inside a character") }
        return String{ bytes = s.bytes[lo..hi] }
    }

    fn eq { a: String, b: String } -> bool {
        return slice::eq_bytes{ a = a.bytes, b = b.bytes }
    }

    fn starts_with { s: String, prefix: String } -> bool {
        let n = prefix.bytes.len
        if n > s.bytes.len { return false }
        return slice::eq_bytes{ a = s.bytes[..n], b = prefix.bytes }
    }

    fn ends_with { s: String, suffix: String } -> bool {
        let n = s.bytes.len
        if suffix.bytes.len > n { return false }
        return slice::eq_bytes{ a = s.bytes[n - suffix.bytes.len..], b = suffix.bytes }
    }

    // Byte offset of the first `c`, or null.
    fn find { s: String, c: u32 } -> ?usize {
        if c < 128 {
            let mut i: usize = 0
            while i < s.bytes.len {
                if s.bytes[i] == c { return i }
                i = i + 1
            }
            return null
        }
        let mut buf: [4]u8
        return find_str{ s, needle = encode{ c, into = buf[..] } }
    }

    // Byte offset of the first occurrence of `needle`, or null. An empty needle is found at 0.
    fn find_str { s: String, needle: String } -> ?usize {
        let n = needle.bytes.len
        if n > s.bytes.len { return null }
        let mut i: usize = 0
        while i + n <= s.bytes.len {
            if slice::eq_bytes{ a = s.bytes[i..i + n], b = needle.bytes } { return i }
            i = i + 1
        }
        return null
    }

    // The text before and after the first `c`, or null if there is none.
    //   split_once{ s = "key=value", c = '=' }  ->  head "key", tail "value"
    struct Split { head: String, tail: String }

    fn split_once { s: String, c: u32 } -> ?Split {
        let mut buf: [4]u8
        let sep = encode{ c, into = buf[..] }
        let i = find_str{ s, needle = sep }
        if i != null {
            return Split{ head = sub{ s, lo = 0, hi = i }, tail = sub{ s, lo = i + sep.bytes.len, hi = s.bytes.len } }
        }
        return null
    }

    // Without leading and trailing ASCII whitespace.
    fn trim { s: String } -> String {
        return trim_end{ s = trim_start{ s } }
    }

    fn trim_start { s: String } -> String {
        let mut lo: usize = 0
        while lo < s.bytes.len and ascii::is_space{ c = s.bytes[lo] } { lo = lo + 1 }
        return String{ bytes = s.bytes[lo..] }
    }

    fn trim_end { s: String } -> String {
        let mut hi = s.bytes.len
        while hi > 0 and ascii::is_space{ c = s.bytes[hi - 1] } { hi = hi - 1 }
        return String{ bytes = s.bytes[..hi] }
    }

    // ---- characters

    // Whether c is a Unicode scalar value: a code point that UTF-8 can encode.
    fn is_scalar { c: u32 } -> bool {
        return c <= 1114111 and (c < 55296 or c > 57343)      // U+10FFFF, not U+D800..U+DFFF
    }

    fn is_ascii { c: u32 } -> bool { return c < 128 }

    // ASCII-only.
    fn is_digit { c: u32 } -> bool { return c < 128 and ascii::is_digit{ c = @trunc(u8, c) } }
    fn is_upper { c: u32 } -> bool { return c < 128 and ascii::is_upper{ c = @trunc(u8, c) } }
    fn is_lower { c: u32 } -> bool { return c < 128 and ascii::is_lower{ c = @trunc(u8, c) } }
    fn is_alpha { c: u32 } -> bool { return c < 128 and ascii::is_alpha{ c = @trunc(u8, c) } }
    fn is_alnum { c: u32 } -> bool { return c < 128 and ascii::is_alnum{ c = @trunc(u8, c) } }
    fn is_space { c: u32 } -> bool { return c < 128 and ascii::is_space{ c = @trunc(u8, c) } }

    // Changes ASCII letters only.
    fn to_upper { c: u32 } -> u32 {
        if c < 128 { return ascii::to_upper{ c = @trunc(u8, c) } }
        return c
    }

    fn to_lower { c: u32 } -> u32 {
        if c < 128 { return ascii::to_lower{ c = @trunc(u8, c) } }
        return c
    }

    // Writes c's bytes to the start of `into` and returns them. Panics if c isn't a scalar value or
    // doesn't fit; 4 bytes always do.
    fn encode { c: u32, into: []mut u8 } -> String {
        if not is_scalar{ c } { @panic("utf8::encode: not a Unicode scalar value") }
        let mut n: usize = 4
        let mut lead: u32 = 240
        if c < 128 {
            n = 1
            lead = 0
        } else if c < 2048 {
            n = 2
            lead = 192
        } else if c < 65536 {
            n = 3
            lead = 224
        }
        if n > into.len { @panic("utf8::encode: buffer too small") }
        let mut v = c
        let mut k = n - 1
        while k > 0 {                                   // continuation bytes carry 6 bits each
            into[k] = @trunc(u8, 128 + v % 64)
            v = v / 64
            k = k - 1
        }
        into[0] = @trunc(u8, lead + v)
        return String{ bytes = into[..n] }
    }

    // ---- numbers

    // Parses an optional '-' followed by decimal digits. Null if malformed or out of range.
    fn parse_i64 { s: String } -> ?i64 {
        let n = s.bytes.len
        if n == 0 { return null }
        let mut i: usize = 0
        let neg = s.bytes[0] == '-'
        if neg {
            if n == 1 { return null }
            i = 1
        }
        // Accumulate negatively so that i64's minimum is reachable.
        let min: i64 = -9223372036854775808
        let mut v: i64 = 0
        while i < n {
            let c = s.bytes[i]
            if not ascii::is_digit{ c } { return null }
            let d = @as(i64, c - '0')
            if v < (min + d) / 10 { return null }
            v = v * 10 - d
            i = i + 1
        }
        if neg { return v }
        if v == min { return null }
        return -v
    }

    // Parses decimal digits. Null if malformed or out of range.
    fn parse_u64 { s: String } -> ?u64 {
        let n = s.bytes.len
        if n == 0 { return null }
        let max: u64 = 18446744073709551615
        let mut v: u64 = 0
        let mut i: usize = 0
        while i < n {
            let c = s.bytes[i]
            if not ascii::is_digit{ c } { return null }
            let d = @as(u64, c - '0')
            if v > (max - d) / 10 { return null }
            v = v * 10 + d
            i = i + 1
        }
        return v
    }

    const F64_MAX: f64 = 1.7976931348623157e308
    const F32_MAX: f32 = 3.4028234663852886e38

    // Parses decimal text such as "3", "-0.25", "1e+100" or "6.02E23", and "inf", "-inf" and
    // "nan", so that it reads back everything fmt_f64 writes. Rounds to the nearest f64. Null if
    // malformed, or if a number is too large for f64.
    fn parse_f64 { s: String } -> ?f64 {
        if is_float_word{ s } { return ascii::f64_parse{ text = s.bytes } }
        if not is_float_number{ s } { return null }
        let v = ascii::f64_parse{ text = s.bytes }
        if v > F64_MAX or v < -F64_MAX { return null }
        return v
    }

    // Like parse_f64, rounding once, directly to the nearest f32.
    fn parse_f32 { s: String } -> ?f32 {
        if is_float_word{ s } { return ascii::f32_parse{ text = s.bytes } }
        if not is_float_number{ s } { return null }
        let v = ascii::f32_parse{ text = s.bytes }
        if v > F32_MAX or v < -F32_MAX { return null }
        return v
    }

    // Writes n in decimal to the start of `into` and returns that text. Panics if it doesn't fit;
    // 20 bytes always do.
    fn fmt_i64 { n: i64, into: []mut u8 } -> String {
        let mut digits: [20]u8
        let mut k: usize = 0
        let mut v = n
        if v > 0 { v = -v }                     // work in negatives so i64's minimum fits
        while true {
            digits[k] = '0' + @as(u8, -(v % 10))
            k = k + 1
            v = v / 10
            if v == 0 { break }
        }
        let mut out: usize = 0
        if n < 0 {
            into[0] = '-'
            out = 1
        }
        let total = out + k
        if total > into.len { @panic("utf8::fmt_i64: buffer too small") }
        while k > 0 {
            k = k - 1
            into[out] = digits[k]
            out = out + 1
        }
        return String{ bytes = into[..total] }
    }

    // Like fmt_i64, for unsigned values.
    fn fmt_u64 { n: u64, into: []mut u8 } -> String {
        let mut digits: [20]u8
        let mut k: usize = 0
        let mut v = n
        while true {
            digits[k] = '0' + @trunc(u8, v % 10)
            k = k + 1
            v = v / 10
            if v == 0 { break }
        }
        if k > into.len { @panic("utf8::fmt_u64: buffer too small") }
        let total = k
        let mut out: usize = 0
        while k > 0 {
            k = k - 1
            into[out] = digits[k]
            out = out + 1
        }
        return String{ bytes = into[..total] }
    }

    // n in lowercase hexadecimal, without a prefix. 16 bytes always fit.
    fn fmt_hex { n: u64, into: []mut u8 } -> String {
        let mut digits: [16]u8
        let mut k: usize = 0
        let mut v = n
        while true {
            let d = @trunc(u8, v % 16)
            digits[k] = if d < 10 { '0' + d } else { 'a' + d - 10 }
            k = k + 1
            v = v / 16
            if v == 0 { break }
        }
        if k > into.len { @panic("utf8::fmt_hex: buffer too small") }
        let total = k
        let mut out: usize = 0
        while k > 0 {
            k = k - 1
            into[out] = digits[k]
            out = out + 1
        }
        return String{ bytes = into[..total] }
    }

    // Shortest text that reads back as n, e.g. "0.1", "3.0", "1e+100", "inf", "nan".
    // 32 bytes always fit.
    fn fmt_f64 { n: f64, into: []mut u8 } -> String {
        return String{ bytes = into[..ascii::f64_digits{ n, into }] }
    }

    fn fmt_f32 { n: f32, into: []mut u8 } -> String {
        return String{ bytes = into[..ascii::f32_digits{ n, into }] }
    }

    // ---- scanning

    // A read position in a String, for hand-written lexers and parsers. `pos` is a byte offset
    // and always a boundary.
    //
    //   let mut cur = utf8::cursor{ s = line }
    //   utf8::skip_space{ &cur }
    //   let name = utf8::take_while{ &cur, f = utf8::is_alpha }
    //   if utf8::eat{ &cur, ch = '=' } { ... }
    struct Cursor { s: String, pos: usize }

    fn cursor { s: String } -> Cursor {
        return Cursor{ s, pos = 0 }
    }

    fn done { cur: Cursor } -> bool {
        return cur.pos >= cur.s.bytes.len
    }

    // The unread text.
    fn rest { cur: Cursor } -> String {
        return sub{ s = cur.s, lo = cur.pos, hi = cur.s.bytes.len }
    }

    // The next character without consuming it, or null at the end.
    fn peek { cur: Cursor } -> ?u32 {
        if done{ cur } { return null }
        return at{ s = cur.s, i = cur.pos }
    }

    // The character `ahead` characters past the next one, or null past the end.
    fn peek_at { cur: Cursor, ahead: usize } -> ?u32 {
        let mut i = cur.pos
        let mut k: usize = 0
        while k < ahead {
            if i >= cur.s.bytes.len { return null }
            i = i + decode{ s = cur.s, i }.size
            k = k + 1
        }
        if i >= cur.s.bytes.len { return null }
        return at{ s = cur.s, i }
    }

    // Consumes and returns the next character, or null at the end.
    fn bump { mut cur: Cursor } -> ?u32 {
        if done{ cur } { return null }
        let d = decode{ s = cur.s, i = cur.pos }
        cur.pos = cur.pos + d.size
        return d.c
    }

    // Consumes `ch` if it is next.
    fn eat { mut cur: Cursor, ch: u32 } -> bool {
        if done{ cur } { return false }
        let d = decode{ s = cur.s, i = cur.pos }
        if d.c != ch { return false }
        cur.pos = cur.pos + d.size
        return true
    }

    // Consumes `s` if the unread text starts with it.
    fn eat_str { mut cur: Cursor, s: String } -> bool {
        if not starts_with{ s = rest{ cur }, prefix = s } { return false }
        cur.pos = cur.pos + s.bytes.len
        return true
    }

    // Consumes characters while `f` accepts them and returns them. `f` may be a character test
    // such as `utf8::is_digit`.
    fn take_while { mut cur: Cursor, f: &fn{ c: u32 } -> bool } -> String {
        let lo = cur.pos
        while not done{ cur } {
            let d = decode{ s = cur.s, i = cur.pos }
            if not f{ c = d.c } { break }
            cur.pos = cur.pos + d.size
        }
        return sub{ s = cur.s, lo, hi = cur.pos }
    }

    fn skip_space { mut cur: Cursor } {
        _ = take_while{ &cur, f = is_space }
    }

    // ---- building strings

    // A growable string that owns its bytes, allocated like a list. Free it with `free`.
    //
    //   let mut b = utf8::builder{ realloc = arena::alloc, &heap }
    //   try utf8::push{ &b, s = name }
    //   try utf8::push_i64{ &b, n = 42 }
    //   try utf8::push_char{ &b, c = 233 }        // U+00E9, e with an acute accent
    //   io::println{ &io, s = utf8::view{ b } }
    struct Builder(S) { bytes: list::List(u8, S) }

    fn builder(S) { realloc: alloc::Fn(S), heap: *mut S } -> Builder(S) {
        return Builder{ bytes = list::new(u8){ realloc, heap } }
    }

    // The text so far. Invalidated by the next push.
    fn view(S) { b: Builder(S) } -> String {
        return String{ bytes = list::items{ list = b.bytes } }
    }

    // Each push fails with alloc::out_of_memory. `push` then leaves b as it was; the padded ones
    // may have pushed some of the padding. The `#write` ones are @fmt's writers (§13), one for
    // each type a hole may have: every integer type, f32, f64, bool, String and strlit.
    #write
    fn push(S) { mut b: Builder(S), s: String } -> ! {
        try list::reserve{ list = &b.bytes, extra = s.bytes.len }
        let mut i: usize = 0
        while i < s.bytes.len {
            _ = list::push{ list = &b.bytes, item = s.bytes[i] }     // reserved: can't fail
            i = i + 1
        }
    }

    // A literal's bytes, which @fmt has checked are valid UTF-8 where it writes one.
    #write
    fn push_literal(S) { mut b: Builder(S), s: strlit } -> ! {
        try push{ &b, s = String{ bytes = s.bytes } }
    }

    // Panics if c isn't a scalar value. Not a writer: a u32 hole is written as a number.
    fn push_char(S) { mut b: Builder(S), c: u32 } -> ! {
        let mut buf: [4]u8
        try push{ &b, s = encode{ c, into = buf[..] } }
    }

    #write
    fn push_i64(S) { mut b: Builder(S), n: i64 } -> ! {
        let mut buf: [20]u8
        try push{ &b, s = fmt_i64{ n, into = buf[..] } }
    }

    #write
    fn push_u64(S) { mut b: Builder(S), n: u64 } -> ! {
        let mut buf: [20]u8
        try push{ &b, s = fmt_u64{ n, into = buf[..] } }
    }

    // The other integer types, each its own writer: a hole is written by the writer of its
    // exact type.
    #write
    fn push_i8(S) { mut b: Builder(S), n: i8 } -> ! { return push_i64{ &b, n } }
    #write
    fn push_i16(S) { mut b: Builder(S), n: i16 } -> ! { return push_i64{ &b, n } }
    #write
    fn push_i32(S) { mut b: Builder(S), n: i32 } -> ! { return push_i64{ &b, n } }
    #write
    fn push_u8(S) { mut b: Builder(S), n: u8 } -> ! { return push_u64{ &b, n } }
    #write
    fn push_u16(S) { mut b: Builder(S), n: u16 } -> ! { return push_u64{ &b, n } }
    #write
    fn push_u32(S) { mut b: Builder(S), n: u32 } -> ! { return push_u64{ &b, n } }
    #write
    fn push_usize(S) { mut b: Builder(S), n: usize } -> ! { return push_u64{ &b, n } }

    #write
    fn push_f64(S) { mut b: Builder(S), n: f64 } -> ! {
        let mut buf: [32]u8
        try push{ &b, s = fmt_f64{ n, into = buf[..] } }
    }

    #write
    fn push_f32(S) { mut b: Builder(S), n: f32 } -> ! {
        let mut buf: [32]u8
        try push{ &b, s = fmt_f32{ n, into = buf[..] } }
    }

    #write
    fn push_bool(S) { mut b: Builder(S), v: bool } -> ! {
        try push{ &b, s = if v { "true" } else { "false" } }
    }

    // Writers to name in an @fmt hole, as `utf8::write_hex{ n, _ }`: n in lowercase hex, and
    // character c. The padded ones below take a width.
    fn write_hex(S) { mut b: Builder(S), n: u64 } -> ! {
        let mut buf: [16]u8
        try push{ &b, s = fmt_hex{ n, into = buf[..] } }
    }

    fn write_char(S) { mut b: Builder(S), c: u32 } -> ! {
        return push_char{ &b, c }
    }


    // s right-aligned in `width` characters: padded with spaces, or with zeros after any `-` if
    // `zero`. Wider text is pushed whole.
    fn push_padded(S) { mut b: Builder(S), s: String, width: usize, zero: bool } -> ! {
        let n = count{ s }
        if n >= width { return push{ &b, s } }
        let mut rest = s
        if zero and s.bytes.len > 0 and s.bytes[0] == '-' {
            try push_char{ &b, c = '-' }
            rest = sub{ s, lo = 1, hi = s.bytes.len }
        }
        let mut k = n
        while k < width {
            try push_char{ &b, c = if zero { '0' } else { ' ' } }
            k = k + 1
        }
        try push{ &b, s = rest }
    }

    // Integers padded as by push_padded, for `@fmt` holes with a width.
    fn push_int(S) { mut b: Builder(S), n: i64, width: usize, zero: bool } -> ! {
        let mut buf: [20]u8
        try push_padded{ &b, s = fmt_i64{ n, into = buf[..] }, width, zero }
    }

    fn push_uint(S) { mut b: Builder(S), n: u64, width: usize, zero: bool } -> ! {
        let mut buf: [20]u8
        try push_padded{ &b, s = fmt_u64{ n, into = buf[..] }, width, zero }
    }

    fn push_hex(S) { mut b: Builder(S), n: u64, width: usize, zero: bool } -> ! {
        let mut buf: [16]u8
        try push_padded{ &b, s = fmt_hex{ n, into = buf[..] }, width, zero }
    }

    fn clear(S) { mut b: Builder(S) } {
        list::clear{ list = &b.bytes }
    }

    fn free(S) { mut b: Builder(S) } {
        list::free{ list = &b.bytes }
    }

    // ---- internals

    // "inf", "-inf" or "nan".
    fn is_float_word { s: String } -> bool {
        return slice::eq_bytes{ a = s.bytes, b = "inf" } or slice::eq_bytes{ a = s.bytes, b = "nan" } or slice::eq_bytes{ a = s.bytes, b = "-inf" }
    }

    // An optional '-', digits, optionally '.' and digits, optionally 'e' or 'E', an optional sign
    // and digits.
    fn is_float_number { s: String } -> bool {
        let mut cur = cursor{ s }
        _ = eat{ &cur, ch = '-' }
        if take_while{ &cur, f = is_digit }.bytes.len == 0 { return false }
        if eat{ &cur, ch = '.' } {
            if take_while{ &cur, f = is_digit }.bytes.len == 0 { return false }
        }
        if eat{ &cur, ch = 'e' } or eat{ &cur, ch = 'E' } {
            if not eat{ &cur, ch = '+' } { _ = eat{ &cur, ch = '-' } }
            if take_while{ &cur, f = is_digit }.bytes.len == 0 { return false }
        }
        return done{ cur }
    }

    fn is_cont { b: u8 } -> bool {
        return b >= 128 and b < 192
    }

    // Length of the valid sequence starting at bytes[i], or 0 if there is none. Rejects overlong
    // forms, surrogates and values above U+10FFFF.
    fn seq_len { bytes: []u8, i: usize } -> usize {
        let b = bytes[i]
        if b < 128 { return 1 }
        let mut n: usize = 0
        let mut lo: u8 = 128                              // the second byte's range
        let mut hi: u8 = 191
        if b >= 194 and b <= 223 {
            n = 2
        } else if b == 224 {                            // E0: no overlong 3-byte forms
            n = 3
            lo = 160
        } else if b == 237 {                            // ED: no surrogates
            n = 3
            hi = 159
        } else if b >= 225 and b <= 239 {
            n = 3
        } else if b == 240 {                            // F0: no overlong 4-byte forms
            n = 4
            lo = 144
        } else if b >= 241 and b <= 243 {
            n = 4
        } else if b == 244 {                            // F4: nothing above U+10FFFF
            n = 4
            hi = 143
        } else {
            return 0
        }
        if i + n > bytes.len { return 0 }
        let b1 = bytes[i + 1]
        if b1 < lo or b1 > hi { return 0 }
        let mut k: usize = 2
        while k < n {
            if not is_cont{ b = bytes[i + k] } { return 0 }
            k = k + 1
        }
        return n
    }

    struct Decoded { c: u32, size: usize }

    // The character starting at byte offset i and its length in bytes. s is valid, so the lead
    // byte gives the length. Panics if i isn't the start of a character.
    fn decode { s: String, i: usize } -> Decoded {
        if i >= s.bytes.len or not is_boundary{ s, i } { @panic("utf8: offset is not the start of a character") }
        let b0: u32 = s.bytes[i]
        if b0 < 128 { return Decoded{ c = b0, size = 1 } }
        let mut c: u32 = 0
        let mut size: usize = 4
        if b0 < 224 {
            c = b0 - 192
            size = 2
        } else if b0 < 240 {
            c = b0 - 224
            size = 3
        } else {
            c = b0 - 240
        }
        let mut k: usize = 1
        while k < size {
            c = c * 64 + (s.bytes[i + k] - 128)
            k = k + 1
        }
        return Decoded{ c, size }
    }
}
