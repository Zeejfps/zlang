// std: mem. Memory beyond the stack.
//
// `pages` takes `mut mem: Mem`. Only `main` receives a `Mem`, from the runtime, so a function
// can get memory this way only if its caller passes it down. Everything else allocates from
// buffers it is given (§14), usually an arena over pages:
//
//   fn main { mut io: Io, mut mem: Mem } -> i32 {
//       let buf = mem::pages{ &mem, size = 67108864 } ifnull { return 1 }   // 64 MiB
//       let mut heap = arena::new{ buf }
//       let mut xs = list::new(i32){ realloc = arena::alloc, &heap }
//       ...
//   }

// Permission to take memory from the system.
capability Mem

namespace mem {
    const PAGE: usize = 4096

    // At least `size` bytes of zeroed, page-aligned memory: `size` rounded up to a multiple of
    // PAGE. They stay valid until the program ends. Null if there isn't enough memory. Asking for
    // 0 bytes gives an empty slice.
    fn pages { mut mem: Mem, size: usize } -> ?alloc::Bytes {
        if size == 0 { return slice::empty(u8){} }
        if size > 18446744073709551615 - (PAGE - 1) { return null }     // rounding up would overflow
        let n = (size + PAGE - 1) / PAGE * PAGE
        let p = os::pages{ &mem, size = n } ifnull { return null }
        return @slice(p, n)
    }
}
