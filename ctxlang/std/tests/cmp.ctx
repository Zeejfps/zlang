// Tests of std's cmp (spec §17) and of the builtins that order numbers, `@min`, `@max` and
// `@clamp` (§13). Run with the rest of std's tests: `ctxc test std/tests`.

namespace cmp_tests {
    #test
    fn min_and_max_of_integers { mut t: Test } {
        @expect(&t, @min(3, 5) == 3)
        @expect(&t, @max(3, 5) == 5)
        @expect(&t, @min(-1, -7) == -7)
        let small: u8 = 200
        @expect(&t, @max(small, 9) == 200)
        // The operands widen either way.
        let wide: i64 = 1099511627776
        let narrow: i32 = 7
        @expect(&t, @min(wide, narrow) == 7)
        @expect(&t, @max(narrow, wide) == wide)
    }

    #test
    fn equal_operands_give_the_first { mut t: Test } {
        // -0.0 and 0.0 are equal, and differ in their bits.
        @expect(&t, math::f64_to_bits{ x = @min(-0.0, 0.0) } == math::f64_to_bits{ x = -0.0 })
        @expect(&t, math::f64_to_bits{ x = @max(-0.0, 0.0) } == math::f64_to_bits{ x = -0.0 })
    }

    #test
    fn a_nan_is_kept { mut t: Test } {
        @expect(&t, math::is_nan{ x = @min(math::NAN, 1.0) })
        @expect(&t, math::is_nan{ x = @max(1.0, math::NAN) })
        @expect(&t, math::is_nan{ x = @clamp(math::NAN, 0.0, 1.0) })
    }

    #test
    fn clamp_gives_the_nearest_bound { mut t: Test } {
        @expect(&t, @clamp(5, 0, 3) == 3)
        @expect(&t, @clamp(-5, 0, 3) == 0)
        @expect(&t, @clamp(2, 0, 3) == 2)
        @expect(&t, @clamp(2.5, 0.0, 1.0) == 1.0)
    }

    #test{ panics = "@clamp: the low bound is above the high bound" }
    fn clamp_panics_on_bounds_out_of_order {} {
        let lo = 4
        _ = @clamp(1, lo, 3)
    }

    fn shorter { a: []u8, b: []u8 } -> bool { return a.len < b.len }

    #test
    fn min_by_and_max_by_take_the_order { mut t: Test } {
        let long: []u8 = "three"
        let short: []u8 = "two"
        @expect(&t, cmp::min_by{ a = long, b = short, less = shorter } == "two")
        @expect(&t, cmp::max_by{ a = long, b = short, less = shorter } == "three")
        // Neither comes before the other: the first.
        let other: []u8 = "six"
        @expect(&t, cmp::min_by{ a = short, b = other, less = shorter } == "two")
    }
}
