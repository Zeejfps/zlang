// Tests of std's cmp (spec §17). Run with the rest of std's tests: `ctxc test std/tests`.

namespace cmp_tests {
    #test
    fn min_and_max_of_integers { mut t: Test } {
        @expect(&t, cmp::min{ a = 3, b = 5 } == 3)
        @expect(&t, cmp::max{ a = 3, b = 5 } == 5)
        @expect(&t, cmp::min{ a = -1, b = -7 } == -7)
        let small: u8 = 200
        @expect(&t, cmp::max{ a = small, b = 9 } == 200)
        let wide: i64 = 1099511627776
        let narrow: i32 = 7
        @expect(&t, cmp::min{ a = wide, b = narrow } == 7)
    }

    #test
    fn equal_operands_give_the_first { mut t: Test } {
        // -0.0 and 0.0 are equal, and differ in their bits.
        @expect(&t, math::f64_to_bits{ x = cmp::min{ a = -0.0, b = 0.0 } } == math::f64_to_bits{ x = -0.0 })
        @expect(&t, math::f64_to_bits{ x = cmp::max{ a = -0.0, b = 0.0 } } == math::f64_to_bits{ x = -0.0 })
    }

    #test
    fn a_nan_is_kept { mut t: Test } {
        @expect(&t, math::is_nan{ x = cmp::min{ a = math::NAN, b = 1.0 } })
        @expect(&t, math::is_nan{ x = cmp::max{ a = 1.0, b = math::NAN } })
        @expect(&t, math::is_nan{ x = cmp::clamp{ x = math::NAN, lo = 0.0, hi = 1.0 } })
    }

    #test
    fn clamp_gives_the_nearest_bound { mut t: Test } {
        @expect(&t, cmp::clamp{ x = 5, lo = 0, hi = 3 } == 3)
        @expect(&t, cmp::clamp{ x = -5, lo = 0, hi = 3 } == 0)
        @expect(&t, cmp::clamp{ x = 2, lo = 0, hi = 3 } == 2)
        @expect(&t, cmp::clamp{ x = 2.5, lo = 0.0, hi = 1.0 } == 1.0)
    }

    #test{ panics = "cmp::clamp: the low bound is above the high bound" }
    fn clamp_panics_on_bounds_out_of_order {} {
        let lo = 4
        _ = cmp::clamp{ x = 1, lo, hi = 3 }
    }

    fn shorter { a: []u8, b: []u8 } -> bool { return a.len < b.len }

    #test
    fn min_by_and_max_by_take_the_order { mut t: Test } {
        let long: []u8 = "three"
        let short: []u8 = "two"
        @expect(&t, cmp::min_by{ a = long, b = short, less = shorter } == "two")
        @expect(&t, cmp::max_by{ a = long, b = short, less = shorter } == "three")
        // Neither comes before the other: the first.
        let other: []u8 = "six"
        @expect(&t, cmp::min_by{ a = short, b = other, less = shorter } == "two")
    }
}
