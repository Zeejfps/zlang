// std: slice. Helpers for the built-in slices `[]T` and `[]mut T` (spec §12, Slices).
// Indexing, `.len`, `.ptr` and `s[lo..hi]` are part of the language.

namespace slice {
    // An empty slice: the zero value of []T.
    fn empty(T) {} -> []mut T {
        let mut s: []mut T
        return s
    }

    // Reinterprets the elements. Panics if the byte length doesn't divide evenly. Alignment is unchecked.
    fn cast(T, U) { s: []mut T } -> []mut U {
        let bytes = s.len * @size_of(T)
        if bytes % @size_of(U) != 0 { @panic("slice::cast: byte length does not divide evenly") }
        return @slice(@cast(*mut U, s.ptr), bytes / @size_of(U))
    }

    // Copies all of src into the start of dst. Panics if dst is shorter.
    fn copy(T) { dst: []mut T, src: []T } {
        if dst.len < src.len { @panic("slice::copy: destination is shorter than source") }
        // The check above covers every index, so the loop indexes the pointers directly.
        let mut i: usize = 0
        while i < src.len {
            dst.ptr[i] = src.ptr[i]
            i = i + 1
        }
    }

    // Whether a and b hold the same bytes. Also the equality for a map with []u8 keys.
    fn eq_bytes { a: []u8, b: []u8 } -> bool {
        if a.len != b.len { return false }
        let mut i: usize = 0
        while i < a.len {
            if a[i] != b[i] { return false }
            i = i + 1
        }
        return true
    }

    // Sets every element to v.
    fn fill(T) { s: []mut T, v: T } {
        let mut i: usize = 0
        while i < s.len {
            s.ptr[i] = v
            i = i + 1
        }
    }
}
