// std: test. What runs a program's tests (spec §20). `ctxc test PATH` builds the program with
// `test::main` as its entry point, in place of the program's own `main`, and the compiler gives
// it the program's `#test` fns: how many there are, each one's name and position (`case`), and a
// fn that runs one and gives its exit code (`run`).
//
// Each test runs in a process of its own: this program, started again with `--run INDEX` and
// the arguments for the tests (`-- ARGS...`). So a test's panic, or anything else that ends its
// process, fails that test alone; no test sees what another left in a static; and tests run
// several at once. A test's output, standard output and
// standard error together, goes to a file beside the executable, which the runner reads once the
// test has ended, prints if the test failed, and removes. Its last line is the test's report of
// how many checks it made, which the runner takes off and adds up.
//
// A program replaces the runner with a `#test_main` fn of its own, as it replaces `rt::start`.

// What a test reports to: `@expect(&t, c)` and `@require(&t, c)` note their checks and write
// their failures through it (spec §13). Only a `#test` fn and the `#test_main` fn receive one,
// and pass it down. It includes an Io, where the failures go as they happen.
capability Test { ..Io, ..test::State }

namespace test {
    // The running test's name and where its fn is, for its lines, the directory of its file
    // (`dir`), the arguments the run gives its tests (`args`), and what it has checked so far:
    // how many checks it has made, and whether one didn't hold, 0 or 1, each changed
    // atomically, since a test's tasks may check at once. `reports` is set in a process that
    // std's runner started for one test, which ends by reporting its checks (`end`).
    capability State {
        static name: [512]u8,
        static name_len: usize,
        static file: []u8,
        static line: u32,
        static dir: []u8,
        static args: [][]u8,
        static checks: u64,
        static failed: u32,
        static reports: bool,
    }

    // A test, as the compiler lists it: its fn's name with its namespaces, its file as the
    // compiler was given it, and its line; the directory of that file, as an absolute path
    // (`dir`); for `#test{ panics = "text" }`, that it passes by
    // panicking, with a message that contains the text; and for `#test{ skip = "why" }`, that
    // it isn't run, and why.
    struct Case { name: []u8, file: []u8, line: u32, dir: []u8, panics: bool, message: []u8, skips: bool, why: []u8 }

    // The directory of the running test's own source file, the one its `#test` fn is in
    // (spec §20, rule 12): where a test finds a file kept beside it, wherever `ctxc test` was
    // run from, and whichever fn asks. An absolute path with `/` between its parts and none at
    // its end, as it was when the test build was made. A file in it is `DIR/NAME`:
    //
    //   let mut path = utf8::builder{ realloc = arena::alloc, &heap }
    //   try @fmt(&path, "{}/rows.2da", test::dir{ &t })
    //   let data = try fs::read_all{ &fs, &heap, realloc = arena::alloc, path = utf8::view{ b = path }.bytes }
    fn dir { mut t: Test } -> []u8 {
        return t.dir
    }

    // The arguments this run gives its tests (spec §20, rule 13): what follows `--` in
    // `ctxc test PATH [FILTER...] -- ARGS...`, the same for every test, as `main`'s `args`
    // are a program's. Empty without a `--`. They live until the program ends.
    fn args { mut t: Test } -> [][]u8 {
        return t.args
    }

    // Gives the tests their arguments, out of a `#test_main` fn's own `args`: those after the
    // first `--`, or none without one. std's `main` calls it, and a program's `#test_main` fn
    // does if its tests read `args`.
    fn pass_args { mut t: Test, args: [][]u8 } {
        t.args = args[own_args{ args }.len..]
        if t.args.len > 0 { t.args = t.args[1..] }
    }

    // A `#test_main` fn's arguments that are the runner's own: those before the first `--`.
    fn own_args { args: [][]u8 } -> [][]u8 {
        for a at k in args {
            if slice::eq_bytes{ a, b = "--" } { return args[..k] }
        }
        return args
    }

    // The exit code of a test that was skipped: what `skip` ends its process with, and what
    // `run_here` gives for a `#test{ skip = "why" }`. It is the code other test runners
    // (automake, meson) read as skipped.
    const SKIPPED: i32 = 77

    // What `@expect(&t, c)` calls with the condition's value (spec §13, Checks): it counts the
    // check, and for one that didn't hold that it has failed, and starts
    // the failure's line on standard error, `FILE:LINE: fail: NAME: TEXT`. The `@expect` ends
    // the line, after both sides of a comparison. Returns held.
    fn check { mut t: Test, held: bool, file: []u8, line: u32, text: []u8 } -> bool {
        return note{ &t, held, file, line, word = "", text }
    }

    // What `@require(&t, c)` calls, as `@expect` calls `check`: the same, with `required: `
    // before the text, `FILE:LINE: fail: NAME: required: TEXT`. The `@require` ends the line
    // and then calls `stop`.
    fn require { mut t: Test, held: bool, file: []u8, line: u32, text: []u8 } -> bool {
        return note{ &t, held, file, line, word = "required: ", text }
    }

    // A check, of either kind: counted, and if it didn't hold its line started, with `word`
    // before the condition's text.
    fn note { mut t: Test, held: bool, file: []u8, line: u32, word: []u8, text: []u8 } -> bool {
        _ = @atomic_add(&t.checks, 1, atomic::Order::relaxed)
        if held { return true }
        @atomic_store(&t.failed, 1, atomic::Order::relaxed)
        start_line{ &t, file, line, word = ": fail: " }
        io::write{ io = &t, to = io::Stream::err, bytes = word }
        io::write{ io = &t, to = io::Stream::err, bytes = text }
        return false
    }

    // What a `@require` that didn't hold calls once its line is written (spec §13, Checks):
    // ends the test, failed, by ending its process with exit code 1 (`end`). It never returns,
    // from whatever fn the `@require` is in, and no `defer` runs. The compiler supplies the
    // `Test`, as it does a panic fn's capabilities.
    fn stop { mut t: Test } {
        end{ &t, code = 1 }
    }

    // Ends the running test as skipped (spec §20, rule 5): `why` says what it lacked, as a
    // game install or a tool. Its line goes to standard error, `FILE:LINE: skip: NAME: WHY`,
    // at the test fn's name, and the test ends there by its process ending, with exit code
    // SKIPPED, as a `@require` that didn't hold ends it: it never returns, from whatever fn
    // it is called in, and no `defer` runs. The checker doesn't know that: where a path must
    // end, as in an `ifnull` block, a `return` follows the call. A test of which a check has
    // failed stays failed: no line is written, and the exit code is 1. The checks that held
    // before a skip change nothing: the test is skipped, not passed.
    fn skip { mut t: Test, why: []u8 } {
        if @atomic_load(&t.failed, atomic::Order::relaxed) != 0 { end{ &t, code = 1 } }
        io::flush{ io = &t }            // so that the skip's line is the last the test writes
        start_line{ &t, file = t.file, line = t.line, word = ": skip: " }
        io::write{ io = &t, to = io::Stream::err, bytes = why }
        io::write{ io = &t, to = io::Stream::err, bytes = "\n" }
        end{ &t, code = SKIPPED }
    }

    // Ends the running test by ending its process with exit code `code`, after writing out
    // what the thread has for standard output. This is all a `Test` may end: std declares C's
    // `exit` for it here, and `stop`, `skip` and std's `main` are its only callers. In std's
    // runner the process is the test's own, and its last line, on standard error, reports
    // the checks it made to the runner, `FILE:LINE: checks: NAME: N` at the test fn's name;
    // in a `#test_main` fn that runs its tests in one process, the process is the run's, and
    // nothing is added.
    fn end { mut t: Test, code: i32 } {
        io::flush{ io = &t }
        if t.reports {
            let mut digits: [20]u8
            start_line{ &t, file = t.file, line = t.line, word = ": checks: " }
            io::write{ io = &t, to = io::Stream::err, bytes = utf8::fmt_u64{ n = checks{ &t }, into = digits[..] }.bytes }
            io::write{ io = &t, to = io::Stream::err, bytes = "\n" }
        }
        c_exit{ &t, code }
    }

    // How many checks the running test has made so far, `@expect`s and `@require`s, held or
    // not: after `run_here`, those of the test it ran.
    fn checks { mut t: Test } -> u64 {
        return @atomic_load(&t.checks, atomic::Order::relaxed)
    }

    #c::symbol{ name = "exit" }
    extern fn c_exit { mut t: Test, code: i32 }

    // `FILE:LINE` and `word` (`: fail: `, `: skip: ` or `: checks: `), then `NAME: `, on
    // standard error.
    fn start_line { mut t: Test, file: []u8, line: u32, word: []u8 } {
        let mut digits: [20]u8
        io::write{ io = &t, to = io::Stream::err, bytes = file }
        io::write{ io = &t, to = io::Stream::err, bytes = ":" }
        io::write{ io = &t, to = io::Stream::err, bytes = utf8::fmt_u64{ n = line, into = digits[..] }.bytes }
        io::write{ io = &t, to = io::Stream::err, bytes = word }
        io::write{ io = &t, to = io::Stream::err, bytes = t.name[..t.name_len] }
        io::write{ io = &t, to = io::Stream::err, bytes = ": " }
    }

    const USAGE: []u8 = "usage: ctxc test PATH [--list] [-v] [--no-skips] [--jobs N] [--timeout SECONDS] [FILTER...] [-- ARG...]: runs the tests whose names contain a FILTER, or all of them, and gives them the ARGs\n"

    // How long the runner waits for a test before it looks at the others again, in nanoseconds:
    // long enough that a wait takes about as long as it says on every platform, since the
    // waits are the runner's clock.
    const SLICE: u64 = 20000000

    // The most tests the runner has running at once, whatever `--jobs` says.
    const MOST: usize = 64

    struct Options { list: bool, verbose: bool, no_skips: bool, jobs: usize, timeout: u64, filters: [][]u8 }

    // A test that is running: which of the picked tests it is, its process, the file its output
    // goes to, and the runner's clock when it started.
    struct Running { slot: usize, child: proc::Child, path: []u8, began: u64 }

    // What became of a picked test: nothing yet, passed, failed with the lines to print, or
    // skipped with its line; and how many checks it reported, 0 for one that ended without
    // its report.
    union Outcome { pending, passed{ checks: u64 }, failed{ lines: []u8, checks: u64 }, skipped{ line: []u8, checks: u64 } }

    // How many of the picked tests failed, how many were skipped, and how many checks the
    // tests reported together.
    struct Tally { failed: usize, skipped: usize, checks: u64 }

    type Heap = arena::Arena

    // The program's entry point in a test build (spec §20): with `--run INDEX`, test INDEX,
    // in this process; otherwise the runner, which starts a process for each test it picks and
    // prints the failures, the skipped tests and a summary. Exits with 0 if no picked test
    // failed, 1 if one failed or none was picked, or with `--no-skips` if one was skipped, and
    // 2 for arguments it doesn't know.
    #test_main
    fn main { mut io: Io, mut fs: Fs, mut mem: Mem, mut proc: Proc, mut t: Test, args: Args, count: usize, case: &fn{ index: usize } -> Case, run: &fn{ index: usize } -> i32 } -> i32 {
        // What follows `--` is the tests', in the runner and in a test's process.
        pass_args{ &t, args }
        let own = own_args{ args }
        if own.len == 2 and slice::eq_bytes{ a = own[0], b = "--run" } {
            let n = utf8::parse_u64{ s = utf8::String{ bytes = own[1] } } ifnull { return 2 }
            if n >= count { return 2 }
            let index = @as(usize, n)
            t.reports = true
            end{ &t, code = run_here{ &t, c = case{ index }, index, run } }
        }
        let pages = mem::reserve{ &mem, size = 1073741824 } ifnull {
            io::eprintln{ &io, s = "tests: out of memory" }
            return 1
        }
        let mut heap = arena::new{ buf = pages }
        let mut filters = list::new([]u8){ realloc = arena::alloc, &heap }
        let mut o = Options{ list = false, verbose = false, no_skips = false, jobs = @as(usize, proc::processors{ &proc }), timeout = 60, filters = slice::empty([]u8){} }
        let mut i: usize = 0
        while i < own.len {
            let a = own[i]
            if slice::eq_bytes{ a, b = "--list" } {
                o.list = true
            } else if slice::eq_bytes{ a, b = "-v" } {
                o.verbose = true
            } else if slice::eq_bytes{ a, b = "--no-skips" } {
                o.no_skips = true
            } else if (slice::eq_bytes{ a, b = "--jobs" } or slice::eq_bytes{ a, b = "--timeout" }) and i + 1 < own.len {
                let n = utf8::parse_u64{ s = utf8::String{ bytes = own[i + 1] } } ifnull {
                    io::write{ &io, to = io::Stream::err, bytes = USAGE }
                    return 2
                }
                if slice::eq_bytes{ a, b = "--jobs" } { o.jobs = @as(usize, @clamp(n, 1, MOST)) } else { o.timeout = n }
                i = i + 1
            } else if a.len > 0 and a[0] == '-' {
                io::write{ &io, to = io::Stream::err, bytes = USAGE }
                return 2
            } else {
                try! list::push{ list = &filters, item = a }
            }
            i = i + 1
        }
        o.filters = list::items{ list = filters }
        o.jobs = @clamp(o.jobs, 1, MOST)

        let mut picked = list::new(usize){ realloc = arena::alloc, &heap }
        for k in 0..count {
            if picks{ name = case{ index = k }.name, filters = o.filters } { try! list::push{ list = &picked, item = k } }
        }
        let tests = list::items{ list = picked }
        if o.list {
            for k in tests {
                let c = case{ index = k }
                _ = @fmt(&io, "{}:{}: {}\n", c.file, c.line, c.name)
            }
            return 0
        }
        if count == 0 {
            io::println{ &io, s = "tests: 0 run: the program has no `#test` fn" }
            return 1
        }
        if tests.len == 0 {
            io::print{ &io, s = "tests: 0 run: no test's name contains" }
            for f at k in o.filters { _ = @fmt(&io, "{} `{}`", if k == 0 { "" } else { " or" }, f) }
            _ = @fmt(&io, ", of {}\n", count)
            return 1
        }
        let n = run_all{ &io, &fs, &proc, &heap, o, tests, case, passed = t.args }
        _ = @fmt(&io, "tests: {} run, {} passed, {} failed, {} skipped, {} not selected, {} checks\n", tests.len, tests.len - n.failed - n.skipped, n.failed, n.skipped, count - tests.len, n.checks)
        return if n.failed == 0 and (n.skipped == 0 or not o.no_skips) { 0 } else { 1 }
    }

    // Whether a test of this name is picked: with no filter, or if its name contains one.
    fn picks { name: []u8, filters: [][]u8 } -> bool {
        if filters.len == 0 { return true }
        for f in filters {
            if find{ s = name, part = f } != null { return true }
        }
        return false
    }

    // ---- a test, in a process

    // Runs test `index`, c, in this process, and gives whether it passed: 0, or 1 if it returned
    // an error or a check of its didn't hold, each written to standard error by then, with its
    // name, or if it made no check, which this says. `run` is the compiler's, which only calls
    // the test. A test that must panic and returned is 0: its runner sees that it didn't. A
    // `#test{ skip = "why" }` isn't run: its line is written, `FILE:LINE: skip: NAME: WHY`,
    // and the result is SKIPPED. A test that calls `skip` ends this process with that code,
    // as one whose `@require` didn't hold ends it with 1. For a `#test_main` fn: std's calls
    // it in the test's own process, and one that runs its tests in one process calls it for
    // each.
    fn run_here { mut t: Test, c: Case, index: usize, run: &fn{ index: usize } -> i32 } -> i32 {
        let n = @min(c.name.len, t.name.len)
        slice::copy(u8){ dst = t.name[..n], src = c.name[..n] }
        t.name_len = n
        t.file = c.file
        t.line = c.line
        t.dir = c.dir
        t.checks = 0
        t.failed = 0
        if c.skips {
            start_line{ &t, file = c.file, line = c.line, word = ": skip: " }
            io::write{ io = &t, to = io::Stream::err, bytes = c.why }
            io::write{ io = &t, to = io::Stream::err, bytes = "\n" }
            return SKIPPED
        }
        let code = run{ index }
        if code != 0 or t.failed != 0 { return 1 }
        if t.checks == 0 and not c.panics {
            start_line{ &t, file = c.file, line = c.line, word = ": fail: " }
            io::write{ io = &t, to = io::Stream::err, bytes = "no check ran: a test passes by the `@expect`s it makes\n" }
            return 1
        }
        return 0
    }

    // ---- the runner

    // Runs the picked tests, at most o.jobs at once, each in a process of its own, and prints
    // each failed one's lines and each skipped one's line, in the tests' order. A
    // `#test{ skip = "why" }` gets no process. Returns how many failed and how many were
    // skipped.
    fn run_all { mut io: Io, mut fs: Fs, mut proc: Proc, mut heap: Heap, o: Options, tests: []usize, case: &fn{ index: usize } -> Case, passed: [][]u8 } -> Tally {
        let exe = proc::exe_path{ &proc }
        let outcomes = try! alloc::make(Outcome, Heap){ realloc = arena::alloc, &heap, count = tests.len }
        let mut active = list::new(Running){ realloc = arena::alloc, &heap }
        let mut clock: u64 = 0          // nanoseconds spent waiting: what a test's time is counted in
        let mut next: usize = 0
        let mut printed: usize = 0
        let mut n = Tally{ failed = 0, skipped = 0, checks = 0 }
        while printed < tests.len {
            while active.len < o.jobs and next < tests.len {
                let c = case{ index = tests[next] }
                if c.skips {
                    let mut b = utf8::builder{ realloc = arena::alloc, &heap }
                    _ = @fmt(&b, "{}:{}: skip: {}: {}\n", c.file, c.line, c.name, c.why)
                    outcomes[next] = Outcome::skipped{ line = utf8::view{ b }.bytes, checks = 0 }
                    next = next + 1
                    continue
                }
                match start{ &fs, &proc, &heap, exe, index = tests[next], passed } {
                    ok{ value } => { try! list::push{ list = &active, item = Running{ slot = next, child = value.child, path = value.path, began = clock } } }
                    err{ error } => {
                        let mut b = utf8::builder{ realloc = arena::alloc, &heap }
                        _ = @fmt(&b, "{}:{}: fail: {}: its process didn't start: {}\n", c.file, c.line, c.name, error)
                        outcomes[next] = Outcome::failed{ lines = utf8::view{ b }.bytes, checks = 0 }
                    }
                }
                next = next + 1
            }
            // Each running test: ended, over its time, or still running. The first is waited
            // for a slice, so that the loop doesn't spin; the others are only looked at.
            let mut k: usize = 0
            let mut waited = false
            while k < active.len {
                let a = list::at{ list = active, i = k }
                let c = case{ index = tests[a.slot] }
                let wait: u64 = if k == 0 { SLICE } else { 0 }
                let mut code: ?i32 = proc::wait_for{ &proc, child = &a.child, nanoseconds = wait } iferr { 1 }
                if code == null and k == 0 { waited = true }
                let late = code == null and o.timeout != 0 and (clock - a.began) / 1000000000 >= o.timeout
                if late {
                    _ = proc::kill{ &proc, child = a.child } iferr {}
                    code = proc::wait{ &proc, child = &a.child } iferr { proc::KILLED }
                }
                if let ended = code {
                    outcomes[a.slot] = finish{ &fs, &heap, c, code = ended, late, timeout = o.timeout, path = a.path }
                    let last = list::pop{ list = &active } ifnull { break }
                    if k < active.len { _ = list::set{ list = &active, i = k, item = last } }
                } else {
                    k = k + 1
                }
            }
            if waited { clock = clock + SLICE }
            while printed < tests.len and not (outcomes[printed] is pending) {
                let c = case{ index = tests[printed] }
                match outcomes[printed] {
                    failed{ lines, checks } => {
                        n.failed = n.failed + 1
                        n.checks = n.checks + checks
                        io::write{ &io, to = io::Stream::out, bytes = lines }
                    }
                    skipped{ line, checks } => {
                        n.skipped = n.skipped + 1
                        n.checks = n.checks + checks
                        io::write{ &io, to = io::Stream::out, bytes = line }
                    }
                    passed{ checks } => {
                        n.checks = n.checks + checks
                        if o.verbose { _ = @fmt(&io, "{}:{}: pass: {}\n", c.file, c.line, c.name) }
                    }
                    pending => {}
                }
                io::flush{ &io }
                printed = printed + 1
            }
        }
        return n
    }

    struct Started { child: proc::Child, path: []u8 }

    // Starts test `index` in a process of its own, a group that ends with this program, whose
    // output goes to a new file beside the executable: EXE.INDEX.out, or with a number more
    // if another run of the tests has that one. Its arguments are `--run INDEX -- ` and
    // `passed`, the tests' own.
    fn start { mut fs: Fs, mut proc: Proc, mut heap: Heap, exe: []u8, index: usize, passed: [][]u8 } -> !Started {
        let mut digits: [20]u8
        let number = utf8::fmt_u64{ n = index, into = digits[..] }.bytes
        let mut again: u64 = 0
        while true {
            let mut b = utf8::builder{ realloc = arena::alloc, &heap }
            try! @fmt(&b, "{}.{}", exe, number)
            if again > 0 { try! @fmt(&b, ".{}", again) }
            try! utf8::push{ &b, s = ".out" }
            let path = utf8::view{ b }.bytes
            let file = match fs::open{ &fs, path, mode = fs::Mode::create } {
                ok{ value } => { value }
                fs::exists => {
                    again = again + 1
                    continue
                }
                err{ error } => { return error }
            }
            let mut argv = list::new([]u8){ realloc = arena::alloc, &heap }
            try list::push{ list = &argv, item = exe }
            try list::push{ list = &argv, item = "--run" }
            try list::push{ list = &argv, item = number }
            try list::push{ list = &argv, item = "--" }
            for a in passed { try list::push{ list = &argv, item = a } }
            let options = proc::Options{ stdin = proc::Stdio::ignore, stdout = proc::Stdio::file{ file }, stderr = proc::Stdio::file{ file }, group = true, die_with_parent = true, .. }
            let child = proc::spawn{ &proc, argv = list::items{ list = argv }, options }
            _ = fs::close{ &fs, file } iferr {}
            return Started{ child = try child, path }
        }
        return fs::bad_file
    }

    // What became of a test whose process ended with `code`, or was ended as late: its output
    // is read and its file removed, and its last line, the report of its checks (`end`), is
    // taken off it: a test that ended in another way than `end`, as by a panic, by being
    // ended as late or by exiting itself, has none, and counts no checks. One that passed is
    // `passed`: it reported, with exit code 0. One that ended with SKIPPED
    // after its skip's line is `skipped`, with that line. One that failed has its
    // output for lines, with the test's name in its panic's line, and a line of the runner's
    // if nothing in the output says why it failed. A test that must panic passes if it did,
    // with a message that contains its text.
    fn finish { mut fs: Fs, mut heap: Heap, c: Case, code: i32, late: bool, timeout: u64, path: []u8 } -> Outcome {
        let mut out: []u8 = fs::read_all{ &fs, &heap, realloc = arena::alloc, path } iferr { "" }
        _ = fs::remove{ &fs, path } iferr {}
        let mut checks: u64 = 0
        let mut reported = false
        if not late {
            let mut report = utf8::builder{ realloc = arena::alloc, &heap }
            try! @fmt(&report, "{}:{}: checks: {}: ", c.file, c.line, c.name)
            let head = utf8::view{ b = report }.bytes
            let at = last_line{ s = out }
            if out.len > 0 and out[out.len - 1] == '\n' and out.len - at > head.len and slice::eq_bytes{ a = out[at..at + head.len], b = head } {
                if let n = utf8::parse_u64{ s = utf8::String{ bytes = out[at + head.len..out.len - 1] } } {
                    checks = n
                    reported = true
                    out = out[..at]
                }
            }
        }
        if code == 0 and reported and not c.panics { return Outcome::passed{ checks } }
        let mut b = utf8::builder{ realloc = arena::alloc, &heap }
        let mut mark = utf8::builder{ realloc = arena::alloc, &heap }
        try! @fmt(&mark, ": fail: {}: ", c.name)
        let named = utf8::view{ b = mark }.bytes
        // A skip's line is the last the test wrote: `skip` ends the process after it.
        if code == SKIPPED and not late {
            let mut skip = utf8::builder{ realloc = arena::alloc, &heap }
            try! @fmt(&skip, "{}:{}: skip: {}: ", c.file, c.line, c.name)
            let head = utf8::view{ b = skip }.bytes
            let at = last_line{ s = out }
            if out.len > 0 and out[out.len - 1] == '\n' and out.len - at >= head.len and slice::eq_bytes{ a = out[at..at + head.len], b = head } {
                return Outcome::skipped{ line = out[at..], checks }
            }
        }
        // The last line that reports a panic, if the test panicked: std's report is
        // `FILE:LINE:COL: panic: MESSAGE`, or `: panic in task NAME: MESSAGE`.
        let mut panic_at: ?usize = null
        let mut from: usize = 0
        while code == 134 and not late and from < out.len {
            let end = line_end{ s = out, from }
            if find{ s = out[from..end], part = ": panic" } != null { panic_at = from }
            from = end + 1
        }
        if c.panics and panic_at != null {
            let at = panic_at ifnull { 0 }
            if find{ s = out[at..line_end{ s = out, from = at }], part = c.message } != null { return Outcome::passed{ checks } }
        }
        let mut says = false
        from = 0
        while from < out.len {
            let end = line_end{ s = out, from }
            let line = out[from..end]
            if panic_at != null and panic_at == from {
                let at = find{ s = line, part = ": panic" } ifnull { 0 }
                try! @fmt(&b, "{}{}{}\n", line[..at], named, line[at + 2..])
                says = true
            } else {
                try! @fmt(&b, "{}\n", line)
                if find{ s = line, part = named } != null { says = true }
            }
            from = end + 1
        }
        if late {
            try! @fmt(&b, "{}:{}{}timed out after {} s\n", c.file, c.line, named, timeout)
        } else if c.panics and panic_at != null {
            try! @fmt(&b, "{}:{}{}its panic's message doesn't contain `{}`\n", c.file, c.line, named, c.message)
        } else if c.panics and code == 0 {
            try! @fmt(&b, "{}:{}{}it didn't panic: a panic with `{}` was expected\n", c.file, c.line, named, c.message)
        } else if not says {
            try! @fmt(&b, "{}:{}{}its process ended with exit code {}\n", c.file, c.line, named, code)
        }
        return Outcome::failed{ lines = utf8::view{ b }.bytes, checks }
    }

    // Where the last line of s starts, the one before its last line break if it ends in one;
    // 0 for an s of one line or none.
    fn last_line { s: []u8 } -> usize {
        let mut at: usize = 0
        let mut from: usize = 0
        while from < s.len {
            at = from
            from = line_end{ s, from } + 1
        }
        return at
    }

    // The end of the line of s that starts at `from`: its line break's offset, or s's end.
    fn line_end { s: []u8, from: usize } -> usize {
        let mut i = from
        while i < s.len and s[i] != '\n' { i = i + 1 }
        return i
    }

    // Where `part` first is in s, or null.
    fn find { s: []u8, part: []u8 } -> ?usize {
        if part.len > s.len { return null }
        for i in 0..s.len - part.len + 1 {
            if slice::eq_bytes{ a = s[i..i + part.len], b = part } { return i }
        }
        return null
    }
}
