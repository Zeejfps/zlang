// std: cmp. The first or the last of two values by an order the program gives.
//
//   let first = cmp::min_by{ a = ann, b = bob, less = younger }    // a type of the program's own
//   let last = cmp::max_by{ a = ann, b = bob, less = younger }
//
// For a type without an order of its own (§11, Expressions, rule 1): a struct, a slice, or a
// number ordered another way. The smaller and the larger of two numbers and a number between
// two bounds are the builtins `@min`, `@max` and `@clamp` (§13).

namespace cmp {
    // Whether a comes before b: the order `min_by` and `max_by` take.
    type Less(T) = &fn{ a: T, b: T } -> bool

    // The one of a and b that comes first by `less`; a, where neither comes before the other.
    fn min_by(T) { a: T, b: T, less: Less(T) } -> T {
        if less{ a = b, b = a } { return b }
        return a
    }

    // The one of a and b that comes last by `less`; a, where neither comes before the other.
    fn max_by(T) { a: T, b: T, less: Less(T) } -> T {
        if less{ a, b } { return b }
        return a
    }
}
