// std: c. What calling C needs (spec §18): attributes, and C's strings.
//
// An extern fn is a function that C provides. Its context fields are C's parameters in the order
// they are declared, and capability fields aren't passed: they only say who may call it.
//
//   #c::symbol{ name = "labs" }
//   extern fn long_abs { n: i64 } -> i64      // C's labs; without the attribute, `long_abs`
//
//   extern fn puts { s: c::String } -> i32
//   _ = puts{ s = "hello" }                   // a literal gets its NUL from the compiler

namespace c {
    // The C symbol an extern fn calls, when it isn't the fn's own name.
    struct symbol { name: []u8 }

    // On a fn: C may call it. Where an extern fn type is expected, the fn is a C function that
    // calls it, so a C library can take it as a callback. Its fields need only be among the
    // type's, and the capabilities among them are supplied without C passing them. C must call
    // it on the thread that called into C.
    //
    //   #c::callback
    //   fn on_key { window: *mut Window, key: i32 } { ... }
    //   glfwSetKeyCallback{ &glfw, window, cb = on_key }
    struct callback {}

    // A NUL-terminated string, as C's `const char *`: read-only, and not owned by its holder. A
    // string literal where one is expected is static bytes with a NUL after them (§11). C takes
    // and returns it as a plain pointer, and `?String` as one that may be NULL.
    struct String { ptr: *u8 }

    // The bytes before the NUL.
    fn len { s: String } -> usize {
        let mut n: usize = 0
        while s.ptr[n] != 0 { n = n + 1 }
        return n
    }

    // A view of the bytes before the NUL, for utf8::from and the rest of std.
    fn bytes { s: String } -> []u8 {
        return @slice(s.ptr, len{ s })
    }

    error has_nul{ at: usize }      // C would end the string at this byte
    error out_of_memory

    // A String holding a copy of `bytes` and a NUL, from the allocator: for text built at run
    // time. It lives as long as the allocator's memory, as with an arena; a String is read-only,
    // so it can't be given back on its own.
    fn copy(S) { realloc: alloc::Fn(S), mut heap: S, bytes: []u8 } -> !String {
        let mut i: usize = 0
        while i < bytes.len {
            if bytes[i] == 0 { return has_nul{ at = i } }
            i = i + 1
        }
        let mem = alloc::resize(u8, S){ realloc, &heap, mem = slice::empty(u8){}, count = bytes.len + 1 } ifnull {
            return out_of_memory
        }
        slice::copy(u8){ dst = mem[..bytes.len], src = bytes }
        mem[bytes.len] = 0
        return String{ ptr = mem.ptr }
    }
}
