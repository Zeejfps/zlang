// std: proc. Other programs, and this program's environment.
//
// Every function takes `mut proc: Proc`. Only `main` receives a `Proc`, from the runtime, so a
// function can start programs or read the environment only if its caller passes it down.
//
//   fn main { mut io: Io, mut proc: Proc, mut mem: Mem } -> i32 {
//       let mut buf: [4096]u8
//       let mut heap = arena::new{ buf = buf[..] }
//       let mut argv = list::new([]u8){ realloc = arena::alloc, &heap }
//       list::push{ list = &argv, item = "cc" } iferr { return 1 }
//       list::push{ list = &argv, item = "--version" } iferr { return 1 }
//       return proc::run{ &proc, argv = list::items{ list = argv }, env = slice::empty([]u8){} } iferr { 127 }
//   }
//
// `spawn` starts a program without waiting for it, so that several run at once, and `wait` waits
// for one.

// Permission to start programs and to read this program's environment. It includes what its
// platform's layer needs for that, os::Proc (std/os), such as C's environ, the console, which
// the programs it starts share (`run` writes standard output's buffer out first), and proc's
// state.
capability Proc { ..os::Proc, ..Io, ..proc::State }

namespace proc {
    // proc's state for the whole program (spec §15, rule 13): the executable's path, once
    // asked for.
    capability State { static exe_path: []u8 }

    error not_found             // no such program, on PATH or at the path given
    error permission_denied
    error other{ code: i64 }    // the OS's error number

    // How many processors this program may run on: at least 1.
    fn processors { mut proc: Proc } -> u32 {
        return os::processors{ &proc }
    }

    // The absolute path of this program's executable; empty if the OS won't say. It lives until
    // the program ends.
    fn exe_path { mut proc: Proc } -> []u8 {
        if proc.exe_path.len == 0 { proc.exe_path = os::exe_path{ &proc } }
        return proc.exe_path
    }

    // The operating system this program runs on.
    fn os { mut proc: Proc } -> build::Os {
        return os::OS
    }

    // Runs program argv[0] with the arguments argv[1..] and waits for it to end. argv[0] is
    // looked for on PATH unless it holds a path separator. The program gets this one's
    // environment plus `env`'s "KEY=VALUE" entries, each replacing an entry of the same key, and
    // shares its standard input, output and error. Returns the program's exit code; one that a
    // signal N killed has 128 + N, as a shell says.
    fn run { mut proc: Proc, argv: [][]u8, env: [][]u8 } -> !i32 {
        let child = try spawn{ &proc, argv, env }
        return try wait{ &proc, child }
    }

    // A program that `spawn` started, to `wait` for once: its process handle on Windows, its
    // process id elsewhere.
    struct Child { id: u64 }

    // Starts a program as `run` does, without waiting for it: several may run at once. Every
    // child must be waited for, once.
    fn spawn { mut proc: Proc, argv: [][]u8, env: [][]u8 } -> !Child {
        if argv.len == 0 { rt::fail{ msg = "proc: run needs a program to run" } }
        let mut i: usize = 0
        while i < env.len {
            let e = env[i]
            if e.len == 0 or e[0] == '=' or key_len{ entry = e } == e.len { rt::fail{ msg = "proc: an environment entry is KEY=VALUE" } }
            i = i + 1
        }
        io::flush{ io = &proc }
        return Child{ id = try os::spawn{ &proc, argv, env } }
    }

    // Waits for a child to end, and returns its exit code as `run` does.
    fn wait { mut proc: Proc, child: Child } -> !i32 {
        return try os::wait{ &proc, id = child.id }
    }

    // The value of environment variable `name`, or null if it isn't set. It lives until the
    // program ends.
    fn env { mut proc: Proc, name: []u8 } -> ?[]u8 {
        return os::env{ &proc, name }
    }

    // ---- for the platform's layer (std/os)

    // Whether environment entry `entry` ("KEY=VALUE") has the key of one of env's entries, in
    // the case the platform's keys are in (os::ENV_CASE): an entry of env replaces it.
    fn overridden { entry: []u8, env: [][]u8 } -> bool {
        let key = key_len{ entry }
        let mut i: usize = 0
        while i < env.len {
            let e = env[i]
            if e.len > key and e[key] == '=' and same_key{ a = e[..key], b = entry[..key] } { return true }
            i = i + 1
        }
        return false
    }

    // Where entry's key ends: at its first '=' but one at the start, as Windows' "=C:=C:\..."
    // entries have; entry.len without one.
    fn key_len { entry: []u8 } -> usize {
        let mut i: usize = if entry.len > 0 and entry[0] == '=' { 1 } else { 0 }
        while i < entry.len and entry[i] != '=' { i = i + 1 }
        return i
    }

    fn same_key { a: []u8, b: []u8 } -> bool {
        if os::ENV_CASE { return slice::eq_bytes{ a, b } }
        let mut i: usize = 0
        while i < a.len {
            if ascii::to_lower{ c = a[i] } != ascii::to_lower{ c = b[i] } { return false }
            i = i + 1
        }
        return true
    }
}
