// std: rt. What starts a program and reports its panics (spec §15, Entry point), over the
// platform's layer, and the stack check's limit. The runtime (ctxc/rt/ctxrt.c) keeps only what
// ctxlang can't: C's main calls `start`, and each panic calls `report`.
//
// A program replaces either with a fn of its own that has the attribute, as one for a target
// without an OS might:
//
//   #panic
//   fn halt { msg: []u8 } { while true {} }

namespace rt {
    // The stack check's limit (spec §15, rule 13): every function's frame below it panics with
    // "stack overflow". `start` sets it; until then, and while a panic is reported, it is 0,
    // which checks nothing.
    capability Stack {
        #stack_limit
        static limit: usize
    }

    // Panics with a message that needn't be a literal, as `@panic` does, but without a
    // position: for std's checks of what a caller passed.
    #c_symbol{ name = "ctx_panic_msg" }
    #pure
    extern fn fail { msg: []u8 }

    // A panic message of pieces, for `fail`: what doesn't fit is cut.
    struct Message { bytes: [256]u8, len: usize }

    fn message { s: []u8 } -> Message {
        let mut m = Message{ bytes = [0; 256], len = 0 }
        add{ &m, s }
        return m
    }

    fn add { mut m: Message, s: []u8 } {
        let n = if s.len > m.bytes.len - m.len { m.bytes.len - m.len } else { s.len }
        slice::copy(u8){ dst = m.bytes[m.len..m.len + n], src = s[..n] }
        m.len = m.len + n
    }

    fn add_u64 { mut m: Message, n: u64 } {
        let mut buf: [20]u8
        add{ &m, s = utf8::fmt_u64{ n, into = buf[..] }.bytes }
    }

    fn fail_with { m: Message } {
        fail{ msg = m.bytes[..m.len] }
    }

    // The command line's arguments after the program's name, as bytes: views of C's argv, listed
    // in memory from `mem::pages`. For a layer whose arguments are C's (std/os/posix,
    // std/os/interp).
    fn c_args { mut mem: Mem, argc: i32, argv: *?*u8 } -> [][]u8 {
        if argc <= 1 { return slice::empty([]u8){} }
        let n = @as(usize, argc) - 1
        let bytes = mem::pages{ &mem, size = n * @size_of([]u8) } ifnull {
            rt::fail{ msg = "out of memory" }
            return slice::empty([]u8){}
        }
        let items = slice::cast(u8, []u8){ s = bytes[..n * @size_of([]u8)] }
        let mut i: usize = 0
        while i < n {
            let p = (argv + (i + 1)).* ifnull { break }
            items[i] = c::bytes{ s = @cast(cstr, p) }
            i = i + 1
        }
        return items[..i]
    }

    // ---- the entry point and panics

    // Runs the program: memory for function values' records, the platform's setup (os::start),
    // the stack check's limit, main with the command line's arguments, and standard output
    // written out. Returns main's exit code.
    #start
    fn start { mut io: Io, mut mem: Mem, mut proc: Proc, mut stack: Stack, argc: i32, argv: *?*u8, main: &fn{ args: Args } -> i32 } -> i32 {
        pages_set{ &mem, pages = record_pages }
        ends_set{ &io, ends = thread_ends }
        os::start{ &io, &proc, argv }
        let here: u8 = 0
        let at = @addr(&here)
        let size = stack_size{ &proc }
        stack.limit = if at > size { at - size } else { 0 }
        let code = main{ args = os::args{ &mem, argc, argv } }
        io::flush{ &io }
        return code
    }

    // Memory for function values' records (ctxrt.h), once the runtime's own is used up. The
    // runtime calls it only within `start`, which holds the `Mem`. It may make no record.
    #c_callback
    fn record_pages { mut mem: Mem, size: usize } -> ?*mut u8 {
        return os::pages{ &mem, size }
    }

    type Pages = extern fn{ mut mem: Mem, size: usize } -> ?*mut u8

    #c_symbol{ name = "ctx_pages_set" }
    extern fn pages_set { mut mem: Mem, pages: Pages }

    // ---- threads (std/thread.ctx)

    // What the runtime calls when a task's worker, or a thread that called a
    // callback, ends: its standard output, written out. The runtime calls it only within
    // `start`, which holds the `Io`.
    #c_callback
    fn thread_ends { mut io: Io } {
        io::flush{ &io }
    }

    type Ends = extern fn{ mut io: Io }

    #c_symbol{ name = "ctx_ends_set" }
    extern fn ends_set { mut io: Io, ends: Ends }

    // A new thread's stack limit, `usable` bytes below the caller's frame, and its name for a
    // panic's report (ctxc/rt/ctxthread.c): for task::begin.
    #c_symbol{ name = "ctx_thread_begin" }
    extern fn thread_begin { mut threads: Threads, usable: usize, name: []u8 }

    // The calling thread's label for a panic's report, which task::begin gave its worker ("task
    // worker") and a task's run renames ("task NAME"): empty on the main thread.
    #c_symbol{ name = "ctx_here_name" }
    extern fn thread_name { mut proc: Proc } -> []u8

    // Gives the calling thread, which task::begin started, another label.
    #c_symbol{ name = "ctx_thread_rename" }
    extern fn thread_rename { mut threads: Threads, name: []u8 }

    // The task the calling thread, which task::begin started, runs from here on: its record
    // (std/task.ctx, a copy of one), or null for none. A panic's call path on the thread then
    // ends with where the task was started.
    #c_symbol{ name = "ctx_thread_task" }
    extern fn thread_runs { mut threads: Threads, record: ?*u8 }

    // The name of the task fn whose record `record` is (std/task.ctx, a copy of one).
    #c_symbol{ name = "ctx_task_name" }
    #pure
    extern fn task_name { record: *u8 } -> []u8

    // The stack the check lets a program use: CTX_STACK bytes, at most 200 MiB, or 16 MiB. The
    // executable reserves more (ctxc/drive.ctx, link_flags), so a frame that crosses the limit
    // still has room to reach the check, and `report` to say so.
    fn stack_size { mut proc: Proc } -> usize {
        let set = os::env{ &proc, name = "CTX_STACK" } ifnull { return 16777216 }
        let n = utf8::parse_u64{ s = utf8::String{ bytes = set } } ifnull { return 16777216 }
        if n == 0 { return 16777216 }
        return if n > 209715200 { 209715200 } else { @as(usize, n) }
    }

    // ---- call paths (spec §15, Call paths)

    // What an entry of a call path is: a call; C code that called a callback, of which nothing
    // more is known; or where the thread's task was started, a path's last entry.
    enum FrameKind: u32 { call, c_code, start }

    // An entry of a call path: the function's name with its namespaces and generic arguments,
    // its file as a compile error names it ("" if it has none), and the position in it of the
    // panic or of the call it made, with line 0 if that isn't known.
    struct Frame { name: []u8, file: []u8, line: u32, col: u32, kind: FrameKind }

    // How many entries the calling thread's call path has: while a panic is reported, the
    // panic's, whose entry 0 is the function it is in; otherwise the caller's own, whose entry
    // 0 is the function that asks, at this call. A function the compiler wrote isn't an
    // entry, and the path ends at `main`, at a test or at a task's fn. A program built without
    // call paths has the panic's own entry, and none otherwise.
    #c_symbol{ name = "ctx_path_count" }
    extern fn count_frames { mut stack: Stack } -> usize

    // Entry `index` of that path, innermost first.
    #c_symbol{ name = "ctx_path_frame" }
    extern fn get_frame { mut stack: Stack, index: usize } -> Frame

    // A path longer than FIRST + LAST entries is written as its first FIRST and its last LAST,
    // with a line between them that says how many it leaves out.
    const FIRST: usize = 16
    const LAST: usize = 8

    // Writes a panic's call path to standard error, a line for each entry, innermost first:
    // "  at NAME (FILE:LINE:COL)". What `report` writes after the panic's line, for a `#panic`
    // fn of a program's own to call.
    fn write_path { mut io: Io, mut stack: Stack } {
        write_frames{ &io, &stack, first = 0, word = "at", started = "started at" }
    }

    // The calling thread's path from entry `first` on, a line each: "  WORD NAME
    // (FILE:LINE:COL)"; without the position where it isn't known, "  WORD NAME (FILE)"; "  WORD
    // C code (no position)" for C code that called a callback; and for where a task was started
    // "  STARTED NAME (FILE:LINE:COL)". Outside a panic, entry 0 is this function.
    fn write_frames { mut io: Io, mut stack: Stack, first: usize, word: []u8, started: []u8 } {
        let count = count_frames{ &stack }
        if first >= count { return }
        let n = count - first
        let mut i: usize = 0
        while i < n {
            if n > FIRST + LAST and i == FIRST {
                let mut line: [64]u8
                let mut digits: [20]u8
                let mut k = put{ into = line[..], n = 0, s = "  ... " }
                k = put{ into = line[..], n = k, s = utf8::fmt_u64{ n = n - FIRST - LAST, into = digits[..] }.bytes }
                k = put{ into = line[..], n = k, s = " more frames\n" }
                io::write{ &io, to = io::Stream::err, bytes = line[..k] }
                i = n - LAST
            }
            write_frame{ &io, f = get_frame{ &stack, index = first + i }, word, started }
            i = i + 1
        }
    }

    fn write_frame { mut io: Io, f: Frame, word: []u8, started: []u8 } {
        let mut buf: [1024]u8
        let into = buf[..buf.len - 1]
        let mut digits: [20]u8
        let mut n = put{ into, n = 0, s = "  " }
        n = put{ into, n, s = if f.kind == FrameKind::start { started } else { word } }
        n = put{ into, n, s = " " }
        if f.kind == FrameKind::c_code {
            n = put{ into, n, s = "C code (no position)" }
        } else {
            n = put{ into, n, s = f.name }
            if f.file.len > 0 {
                n = put{ into, n, s = " (" }
                n = put{ into, n, s = f.file }
                if f.line > 0 {
                    n = put{ into, n, s = ":" }
                    n = put{ into, n, s = utf8::fmt_u64{ n = f.line, into = digits[..] }.bytes }
                    n = put{ into, n, s = ":" }
                    n = put{ into, n, s = utf8::fmt_u64{ n = f.col, into = digits[..] }.bytes }
                }
                n = put{ into, n, s = ")" }
            }
        }
        buf[n] = '\n'
        io::write{ &io, to = io::Stream::err, bytes = buf[..n + 1] }
    }

    // Reports a panic on standard error, after what standard output holds, and ends the program
    // with exit code 134: "FILE:LINE:COL: panic: MSG", or "PROGRAM: panic: MSG" for a panic
    // without a position (line 0); on a thread but the main one, "panic in thread NAME:", NAME
    // being its name or its id, and in a task "panic in task NAME:", NAME being its task fn's.
    // Then its call path, a line for each function (write_path). One thread reports: a panic
    // on another meanwhile waits for the end (ctxc/rt/ctxrt.c).
    #panic
    fn report { mut io: Io, mut proc: Proc, mut stack: Stack, msg: []u8, file: []u8, line: u32, col: u32 } {
        let mut buf: [4096]u8
        let mut n = put{ into = buf[..buf.len - 1], n = 0, s = file }
        if line > 0 {
            let mut digits: [20]u8
            n = put{ into = buf[..buf.len - 1], n, s = ":" }
            n = put{ into = buf[..buf.len - 1], n, s = utf8::fmt_u64{ n = line, into = digits[..] }.bytes }
            n = put{ into = buf[..buf.len - 1], n, s = ":" }
            n = put{ into = buf[..buf.len - 1], n, s = utf8::fmt_u64{ n = col, into = digits[..] }.bytes }
        }
        let thread = thread_name{ &proc }
        if thread.len > 0 {
            n = put{ into = buf[..buf.len - 1], n, s = ": panic in " }
            n = put{ into = buf[..buf.len - 1], n, s = thread }
            n = put{ into = buf[..buf.len - 1], n, s = ": " }
        } else {
            n = put{ into = buf[..buf.len - 1], n, s = ": panic: " }
        }
        n = put{ into = buf[..buf.len - 1], n, s = msg }
        buf[n] = '\n'
        io::write{ &io, to = io::Stream::err, bytes = buf[..n + 1] }
        write_path{ &io, &stack }
        os::exit{ &proc, code = 134 }
    }

    // s after into[..n], or as much of it as fits. Returns the new length.
    fn put { into: []mut u8, n: usize, s: []u8 } -> usize {
        let k = if s.len > into.len - n { into.len - n } else { s.len }
        slice::copy(u8){ dst = into[n..n + k], src = s[..k] }
        return n + k
    }
}
